language = ru
surface = ru
color = auto
page = ru

version = 0.7.24
name = @digitable-lol/flang
license = BSD-2-Clause
repository = https://github.com/digitable-lol/flang
issues = https://github.com/digitable-lol/flang/issues

unproven = refuse

max-line-length = 120
max-conditional-depth = 2
lint = refuse

script.build = sh scripts/bootstrap-reprint.sh --telo && make -C bootstrap -j"$(getconf _NPROCESSORS_ONLN)" && bootstrap/flang io flang/proof/binary-fingerprint.fscript
script.scripts:check = bootstrap/flang io scripts/shortcut-collector.fscript --plan Целость && bootstrap/flang io scripts/shortcut-collector.fscript --plan Сбор --max-orders 20000
script.licenses:check = bootstrap/flang io scripts/guards/license-guard.fscript
script.claims:check = bootstrap/flang io flang/scripts/claim-guard.fscript --plan 'Утверждения о недостаче сверены с лексером' --max-steps 2000000000 --max-orders 100000 --на-веру
script.counts:check = node flang/scripts/count-guard.mjs
script.codes:check = bootstrap/flang io flang/scripts/code-guard.fscript --max-steps 200000000
script.codes:forgery = bootstrap/flang io flang/scripts/code-forgery.fscript --timeout 600000 --на-веру
script.cyrillic:check = bootstrap/flang io scripts/guards/cyrillic-file-names-guard.fscript --plan Проверка
script.transliteration:check = bootstrap/flang io scripts/guards/translit-file-names-guard.fscript --plan Проверка
script.transliteration:forgery = bootstrap/flang io scripts/guards/translit-file-names-guard.fscript --plan Подлог
script.emit-promises:check = bootstrap/flang io scripts/guards/emit-promises-guard.fscript
script.target-drift:check = bootstrap/flang io scripts/guards/target-function-drift.fscript --plan 'Расхождение целей стережётся'
script.target-drift:forgery = bootstrap/flang io scripts/guards/target-function-drift.fscript --plan 'Подлог краснит сторожа расхождения'
script.bad-octet:check = bash scripts/guards/bad-octet-guard.sh
script.bad-octet:corrupt = bash scripts/guards/bad-octet-guard.sh --порча
script.cpp-face:check = bootstrap/flang io scripts/targets/cpp-target-face.flang --plan 'Лицо цели cpp достижимо' --timeout 300000
script.cpp-face:forgery = bootstrap/flang io scripts/targets/cpp-target-face.flang --plan 'Подлог' --timeout 300000
script.kernel-abilities:check = bootstrap/flang run-script seed:freshness --what kernel-abilities:check >&2 && bootstrap/flang io scripts/guards/kernel-abilities-guard.fscript --на-веру
script.kernel-abilities:evidence = bootstrap/flang run-script seed:freshness --what kernel-abilities:evidence >&2 && bootstrap/flang check --proof flang/proof/map/abilities.flang
script.emit-law:check = bootstrap/flang io scripts/targets/emit-law.fscript --на-веру
script.names:check = node flang/scripts/name-guard.mjs
script.module-names:check = bootstrap/flang io scripts/guards/module-name-guard.fscript
script.module-origin:check = sh scripts/guards/module-origin-guard.sh
script.module-origin:forgery = sh scripts/guards/module-origin-guard.sh --подлог
script.jargon:check = bootstrap/flang io scripts/guards/jargon-guard.fscript --plan 'Внутреннее слово не стоит в тексте для читателя' --max-steps 4000000000 --на-веру
script.jargon:list = bootstrap/flang io scripts/guards/jargon-guard.fscript --plan 'Каждое место названо' --max-steps 4000000000 --на-веру
script.jargon:debt = bootstrap/flang io scripts/guards/jargon-guard.fscript --plan 'Долг переписан' --max-steps 4000000000 --на-веру
script.memory:check = bootstrap/flang io flang/scripts/memory-guard.fscript --max-steps 80000000 --на-веру
script.binary-rules:check = bootstrap/flang io flang/scripts/binary-rules-guard.fscript --timeout 600000
script.cli-keys:check = bootstrap/flang io flang/scripts/cli-keys-guard.fscript --max-steps 200000000 --timeout 600000
script.node:targets = bootstrap/flang io flang/scripts/node-across-targets.fscript --timeout 1800000
script.tempdir:check = bootstrap/flang io flang/scripts/tempdir-guard.fscript --plan 'Временных каталогов не осталось' --timeout 1800000 --max-steps 4000000000
script.stray-temporaries:check = bootstrap/flang io scripts/guards/stray-temporaries-guard.fscript --plan Проверка
script.stray-temporaries:forgery = bootstrap/flang io scripts/guards/stray-temporaries-guard.fscript --plan Подлог
script.occupied-names:check = bootstrap/flang io scripts/guards/occupied-names-guard.fscript --max-steps 100000000 --на-веру
script.target-words:check = bootstrap/flang io flang/scripts/target-words.fscript --max-steps 2000000000 --timeout 600000 --на-веру
script.file-extensions:check = bootstrap/flang io scripts/guards/file-extensions.fscript --на-веру
script.kernel-forgeries:check = bootstrap/flang run-script seed:freshness --what kernel-forgeries:check >&2 && bootstrap/flang io flang/scripts/kernel-forgeries.fscript --plan 'Подделки остаются недоказанными' --на-веру
script.axioms:check = bootstrap/flang io flang/scripts/kernel-forgeries.fscript --plan 'Аксиом ноль' --на-веру
script.proof-record:check = bootstrap/flang run-script seed:freshness --what proof-record:check >&2 && bootstrap/flang io flang/proof/forgeries/run.fscript --max-steps 4000000000 --timeout 14400000
script.record-source:check = bootstrap/flang io scripts/guards/record-follows-its-source.fscript --plan Проверка
script.record-source:forgery = bootstrap/flang io scripts/guards/record-follows-its-source.fscript --plan Подлог
script.checker:check = bootstrap/flang io flang/proof/checker/tests/run.fscript --max-steps 4000000000 --timeout 600000
script.plan-rules:probe = bootstrap/flang io flang/proof/probes/plan-rules-asked/run.fscript --plan Binary
script.translation:check = sh flang/translation/run.sh
script.proved-share:check = bootstrap/flang io flang/proof/share-measure.fscript --max-steps 4000000000 --timeout 900000 -- --set corpus
script.proved-share:forgery = bootstrap/flang io flang/proof/share-ledger-forgery.fscript --max-steps 4000000000 --timeout 900000
script.kernel-verdict:check = bootstrap/flang io flang/proof/kernel-verdict.fscript --max-steps 4000000000 --timeout 900000
script.kernel-verdict:forgery = bootstrap/flang io flang/proof/kernel-verdict-forgery.fscript --max-steps 4000000000 --timeout 900000
script.proof-records:freshness = bootstrap/flang io flang/proof/records-nesting.fscript --max-steps 4000000000 --timeout 900000
script.provability = bootstrap/flang io scripts/provability.fscript --plan Verdict --timeout 900000
script.share:replay = bootstrap/flang io flang/proof/replay-share.fscript --max-steps 4000000000 --timeout 900000
script.share:forgery = bootstrap/flang io flang/proof/replay-share.fscript --max-steps 4000000000 --timeout 900000 -- --forgery
script.child-timeout:check = bootstrap/flang io scripts/guards/child-timeout.fscript --timeout 120000
script.conc-link:emit = bootstrap/flang io scripts/targets/conc-link-emit.fscript --на-веру
script.release:check = bootstrap/flang io scripts/guards/release-guard.fscript --на-веру
script.binary:acceptance = bootstrap/flang io scripts/seed/new-binary-acceptance.fscript --plan Accept --timeout 3600000 --
script.link-collisions:check = node flang/scripts/link-collision-guard.mjs --дерево
script.link-collisions:corrupt = node flang/scripts/link-collision-guard.mjs --порча
script.seed:freshness = bootstrap/flang io scripts/seed/seed-freshness.fscript --plan Check --timeout 300000 --
script.seed:fast = sh scripts/bootstrap-reprint.sh --bystro
script.seed:refresh = bootstrap/flang io scripts/seed/seed-refresh.fscript --plan Reseed --timeout 900000
script.seed:can-refresh = bootstrap/flang io scripts/seed/seed-refresh.fscript --plan Check
script.seed:type-words = bootstrap/flang io scripts/guards/seed-knows-type-words-guard.fscript --plan Check --max-steps 4000000000
script.seed:type-words:forgery = bootstrap/flang io scripts/guards/seed-knows-type-words-guard.fscript --plan Forgery
script.name-collisions:recount = bootstrap/flang io scripts/guards/name-collision-guard.fscript --на-веру
script.name-splicing:check = bootstrap/flang io scripts/guards/name-splicing-guard.fscript --max-orders 2000 --на-веру
script.search:discriminating = bootstrap/flang run-script seed:freshness --what search:discriminating >&2 && bootstrap/flang io flang/scripts/discriminating-search.fscript --plan 'Различительный поиск' --max-steps 2000000000 --max-orders 100000
script.trust:ceiling = bootstrap/flang run-script seed:freshness --what trust:ceiling >&2 && bootstrap/flang io flang/scripts/kernel-lines-to-trust.fscript --plan 'Сколько верим по всему пути' --max-steps 2000000000
script.specs:check = bootstrap/flang run-script seed:freshness --what specs:check >&2 && bootstrap/flang io fspec/guard.flang --на-веру
script.specs:forgery = bootstrap/flang run-script seed:freshness --what specs:forgery >&2 && bootstrap/flang io fspec/forgery.flang --timeout 600000
script.proofs:report = bootstrap/flang run-script seed:freshness --what proofs:report >&2 && bootstrap/flang io flang/scripts/proof-ledger.fscript --plan 'Свод корпуса' --timeout 3600000 --max-steps 400000000000 --max-orders 100000 --на-веру
script.proofs:summary = bootstrap/flang run-script seed:freshness --what proofs:summary >&2 && bootstrap/flang io flang/scripts/ledger-summary.fscript --plan 'Свод' --timeout 900000
script.word:check = bootstrap/flang run-script seed:freshness --what word:check >&2 && bootstrap/flang io flang/scripts/word-guard.fscript --plan 'Сторож слов' --max-steps 2000000000 --на-веру
script.word:forgery = bootstrap/flang run-script seed:freshness --what word:forgery >&2 && bootstrap/flang io flang/scripts/word-guard.fscript --plan 'Подлог слов' --max-steps 2000000000 --на-веру
script.guard-calls:check = bootstrap/flang io scripts/guards/who-calls-the-guards.fscript --plan Check
script.uncalled-checks:check = bootstrap/flang io scripts/guards/checks-nobody-calls.fscript --plan Проверка --max-steps 4000000000
script.closed-length:check = bootstrap/flang io flang/scripts/closed-length-guard.fscript --max-steps 4000000000
script.emptiness:check = bootstrap/flang run-script seed:freshness --what emptiness:check >&2 && bootstrap/flang io flang/scripts/emptiness-guard.fscript --plan 'Пустоты в доказанном нет' --timeout 900000 --max-steps 2000000000
script.emptiness:census = bootstrap/flang run-script seed:freshness --what emptiness:census >&2 && bootstrap/flang io flang/scripts/emptiness-guard.fscript --plan 'Перепись куч' --timeout 900000
script.emptiness:corrupt = bootstrap/flang run-script seed:freshness --what emptiness:corrupt >&2 && bootstrap/flang io flang/scripts/emptiness-guard.fscript --plan 'Порча' --timeout 900000
script.proven:check = bootstrap/flang run-script seed:freshness --what proven:check >&2 && bootstrap/flang io flang/scripts/proven-guard.fscript --plan 'Доказанного не убыло' --timeout 900000
script.proven:corrupt = bootstrap/flang run-script seed:freshness --what proven:corrupt >&2 && bootstrap/flang io flang/scripts/proven-guard.fscript --plan 'Порча' --timeout 900000
script.proofs:count-20 = bootstrap/flang run-script seed:freshness --what proofs:count-20 >&2 && bootstrap/flang io docs/benchmarks/proof-cost/count-20.flang
script.word:occupancy = bootstrap/flang io flang/scripts/word-occupancy.fscript --plan 'Занятость слова' --timeout 1200000
script.word:occupancy:check = bootstrap/flang io scripts/guards/occupancy-check.fscript --timeout 600000
script.links:check = bootstrap/flang io scripts/guards/link-guard.fscript --на-веру
script.tasks:check = bootstrap/flang io flang/scripts/tasks.fscript --plan 'Задачник цел' --max-steps 200000000 --на-веру
script.inventory:languages = bootstrap/flang io scripts/guards/tree-inventory.fscript --plan 'Опись дерева по языкам' --max-steps 50000000 --на-веру
script.inventory:check = bootstrap/flang io scripts/guards/tree-inventory.fscript --plan 'Опись сходится с документом' --max-steps 50000000 --на-веру
script.adr:numbers = bootstrap/flang io scripts/guards/adr-numbers-guard.fscript --plan 'Номера решений' --на-веру
script.adr:forgery = bootstrap/flang io scripts/guards/adr-numbers-guard.fscript --plan 'Подлог' --на-веру
script.traceability:check = bootstrap/flang io scripts/guards/traceability-guard.fscript --plan 'Разрывы' --max-steps 4000000000 --на-веру
script.traceability:forgery = bootstrap/flang io scripts/guards/traceability-guard.fscript --plan 'Подлог' --max-steps 4000000000 --на-веру
script.traceability:requirement = bootstrap/flang io scripts/guards/traceability-guard.fscript --plan 'От требования' --max-steps 4000000000 --на-веру
script.traceability:line = bootstrap/flang io scripts/guards/traceability-guard.fscript --plan 'От строки' --max-steps 4000000000 --на-веру
script.lint = bootstrap/flang lint
script.lint:growth = bootstrap/flang io .githooks/lint-growth.fscript --plan Range --max-orders 100000 --
script.settings = bootstrap/flang io scripts/flangrc.fscript -- --sources
script.settings:check = bootstrap/flang io scripts/guards/flangrc-guard.fscript --plan Check
script.settings:forgery = bootstrap/flang io scripts/guards/flangrc-guard.fscript --plan Forgery
script.tasks:numbers = bootstrap/flang io scripts/guards/task-numbers-guard.fscript --plan Check
script.tasks:numbers:forgery = bootstrap/flang io scripts/guards/task-numbers-guard.fscript --plan Forgery
script.tasks:board = bootstrap/flang io flang/scripts/tasks.fscript --plan 'Доска' --max-steps 200000000 --на-веру
script.tasks:number = bootstrap/flang io flang/scripts/tasks.fscript --plan 'Номер' --max-steps 200000000 --на-веру
script.zettel-index:build = bootstrap/flang io docs/zettel/zettel-index.flang --max-orders 4000 --timeout 900000
script.install-path:check = bootstrap/flang io scripts/release/path-without-node.fscript --на-веру
script.dictionary:coverage = bootstrap/flang io scripts/guards/dictionary-guard.fscript --на-веру
script.tab-host:check = bootstrap/flang io scripts/guards/tab-host-guard.fscript --на-веру
script.dictionary-copies:check = bootstrap/flang io scripts/guards/io-dictionary-copies-guard.fscript --plan 'Копии словаря сходятся с первоисточником' --на-веру
script.dictionary-copies:forgery = bootstrap/flang io scripts/guards/io-dictionary-copies-guard.fscript --plan 'Подлог копий словаря' --на-веру
script.browser:build = sh docs/examples/web/build.sh
script.browser:stand = bootstrap/flang io docs/examples/web/stand.flang --max-orders 1000000 --на-веру
script.browser:probe = sh docs/examples/web/browser-probe.sh
script.manpage:check = bootstrap/flang io scripts/guards/manpage-guard.fscript --на-веру
script.cli-commands:check = bootstrap/flang io scripts/guards/cli-commands-guard.fscript --на-веру
script.darwin:check = bootstrap/flang io scripts/guards/darwin-guard.fscript --на-веру
script.homebrew-formula:check = bootstrap/flang io scripts/guards/homebrew-formula-guard.fscript --на-веру
script.asdf-plugin:check = bootstrap/flang io scripts/guards/asdf-plugin-guard.fscript --plan 'Плагин asdf не отстал от дерева'
script.asdf-plugin:forgery = bootstrap/flang io scripts/guards/asdf-plugin-guard.fscript --plan 'Подлог'
script.delivery:check = bootstrap/flang io scripts/guards/delivery-guard.flang --plan 'Состав поставки сходится с деревом'
script.version:check = bootstrap/flang io scripts/guards/version-guard.fscript --на-веру
script.version-derivations:check = bootstrap/flang io scripts/guards/version-derivations-guard.fscript --plan Проверка
script.version-derivations:forgery = bootstrap/flang io scripts/guards/version-derivations-guard.fscript --plan Подлог --timeout 600000
script.version = bootstrap/flang io scripts/release/bump-version.fscript --
script.no-package-json:check = bootstrap/flang io scripts/guards/no-package-json-guard.fscript --plan Проверка
script.site:build = node docs/site/build.mjs
script.site:check = node docs/site/build.mjs --check
script.contrast:check = bootstrap/flang io docs/site/contrast-guard.flang
script.dictionary:build = bootstrap/flang io scripts/site/emit-dictionary.fscript --plan 'Напечатать словарь' --на-веру
script.dictionary:check = bootstrap/flang io scripts/site/emit-dictionary.fscript --plan 'Словарь сходится' --на-веру
script.surfaces:run = node docs/site/surfaces-run.mjs
script.surfaces:check = node docs/site/surfaces-run.mjs --check
script.surfaces:forgery = bootstrap/flang io scripts/site/surfaces-page.fscript --timeout 300000
script.numbers:build = node docs/site/site-numbers.mjs --write
script.numbers:check = node docs/site/site-numbers.mjs --check
script.pages:stale = bootstrap/flang io scripts/guards/stale-pages-guard.fscript --plan 'Страницы не отстали' --timeout 900000 --на-веру
script.published:check = sh scripts/guards/published-vs-tree.sh
script.changelog:build = bootstrap/flang io scripts/site/build-changelog.fscript --plan 'Напечатать журнал изменений' --max-steps 2000000000
script.changelog:check = bootstrap/flang test scripts/site/changelog.flang && bootstrap/flang io scripts/site/build-changelog.fscript --plan 'Журнал не отстал' --max-steps 2000000000
script.changelog:page = node scripts/site/build-changelog-page.mjs
script.changelog:page:check = node scripts/site/build-changelog-page.mjs --check
script.releases:page = bootstrap/flang io scripts/site/releases-page.fscript --max-steps 80000000 --на-веру
script.releases:page:check = bootstrap/flang io scripts/site/releases-page-verify.fscript --max-steps 80000000 --на-веру
script.registry:page = bootstrap/flang io scripts/site/registry-page.fscript --plan 'Напечатать страницу реестра'
script.registry:publish = bootstrap/flang io scripts/site/registry-page.fscript --plan 'Выложить ведомость'
script.reprint = sh scripts/bootstrap-reprint.sh
script.reprint:check = sh scripts/bootstrap-reprint.sh --check
script.bootstrap-point:check = bootstrap/flang io scripts/seed/bootstrap-point-by-binary.fscript --timeout 2400000 --на-веру
script.seed-lines:check = sh scripts/bootstrap-reprint.sh --stroki
script.guards:check = bootstrap/flang io flang/scripts/guards-start.fscript --на-веру
script.hand-written-lists:census = sh scripts/guards/hand-written-lists.sh
script.hand-written-lists:check = sh scripts/guards/hand-written-lists.sh --check
script.what-blocks:check = bootstrap/flang io scripts/guards/what-blocks-inventory-guard.fscript --plan Проверка
script.what-blocks:forgery = bootstrap/flang io scripts/guards/what-blocks-inventory-guard.fscript --plan Подлог
script.criterion:score = bootstrap/flang io scripts/guards/criterion-score-guard.fscript --
script.tests = node --test --test-timeout=1800000 flang/test/*.test.mjs
script.tests:remote = bootstrap/flang io scripts/test-remote.fscript --plan Run --timeout 3600000
