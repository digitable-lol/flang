# Настройки flang для этого проекта.
#
# Строка — «ключ = значение». Пробелы вокруг знака не важны. Строка,
# начинающаяся с «#», — примечание. Незнакомый ключ и негодное значение
# пропускаются молча: файл, написанный для нового flang, обязан работать на
# старом.
#
# Где ищется: этот файл (подъём от рабочего каталога до корня проекта), потом
# ~/.flangrc. Что старше чего и как проверить — docs/guide/settings.ru.md.
#
# Прочитать, что вышло:   sh scripts/flangrc.sh --откуда

# язык, которым flang отвечает человеку: ru | en | eo | zh
# Сегодня работает только ru — остальные названы, но не написаны;
# сколько это стоит, посчитано в docs/adr/0022-*.md.
язык = ru

# поверхность, которой пишутся заготовки (`flang new`): ru | en | eo | zh
поверхность = ru

# цвет в терминале: да | нет | авто
цвет = авто

# язык страницы `man flang`: ru | en
страница = ru

# ── Кто этот проект: имя, версия, лицензия и два адреса ─────────────────────
# Эти пять ключей — НЕ настройка вкуса, как четыре выше, а ПРОИЗВОДНЫЕ места:
# значения сюда РАЗНОСИТ `./ярлык версия <N>` из одного источника — функций
# «Имя пакета», «Версия», «Лицензия», «Адрес склада» и «Адрес бед» в
# scripts/release/emit-package.flang. Правка руками здесь бессмысленна: её
# снесёт следующий подъём версии, а до него расхождение назовёт
# `sh scripts/guards/version-derivations-guard.sh`.
#
# Зачем они тут вообще: до 17 сентября 2026 всё это лежало в `package.json`
# (задача 3570 его выбросила), и каждый читатель разбирал JSON. Теперь спросить
# версию проекта можно, не разбирая JSON и не заводя Node, —
# `sh scripts/flangrc.sh версия`; тем же путём читаются лицензия и оба адреса.
версия = 0.7.19
имя = @digitable-lol/flang
лицензия = BSD-2-Clause
склад = https://github.com/digitable-lol/flang
беды = https://github.com/digitable-lol/flang/issues
