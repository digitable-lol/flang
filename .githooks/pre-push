#!/bin/sh
# ХУК ПЕРЕД ПУШЕМ: гоняет ДЕШЁВЫХ сторожей, чтобы в GitHub уезжало зелёное.
#
# ЗАЧЕМ. Полный набор проверок стоит около 134 минут раннера на один пуш, и
# красное всё равно приезжает: на `main` CI был красен с 4 сентября, а на
# `dev` он до 5 сентября не ходил вовсе — 74 пуша без надзора, и за это
# время незамеченным прошёл регресс гейта Г3.
#
# ПОЧЕМУ НЕ ВЕСЬ НАБОР. Хук на 134 минуты обойдут через `--no-verify`, и он
# станет хуже, чем никакого: будет создавать чувство проверенности, не
# проверяя. Поэтому здесь только те проверки, что укладываются в секунды, а
# долгие остаются CI. Что именно НЕ проверено — печатается ниже словами, и
# это не вежливость: молчащий о своих границах хук врёт самим фактом
# зелёного вывода.
#
# ЧТО СЮДА НЕ ВЗЯТО И ПОЧЕМУ (перемерено 5 сентября 2026 своим прогоном,
# предел 200 с на сторожа, машина под чужой перепечаткой):
#   ./ярлык тесты                       дольше 2 минут
#   набор проб чекера (run.sh)       минуты
#   ./ярлык сколько-верим (потолок Г3)  минуты, нужен --max-steps 2e9
#   сборка bootstrap                    5–6 минут
#   ещё десять сторожей дороже 200 с    см. scripts/guards/who-calls-the-guards.sh
#                                       (было семь: запись, сведение и
#                                       пустота переехали из «красных по
#                                       делу» сюда — вырос бюджет сверщика,
#                                       а не корпус; задача 5612)
#   scripts/seed/what-lags-the-seed.sh   краснеть НЕ УМЕЕТ (только exit 2,
#                                       если семени нет) — это отчёт, не
#                                       сторож, и в хуке был бы украшением
#
# КОГДА ОБХОД `--no-verify` ЗАКОНЕН:
#   · пушите ветку работника, которую всё равно не сливают напрямую в dev;
#   · чините сам хук;
#   · дерево заведомо красно по названному долгу, и вы это знаете.
# Во всех прочих случаях обход значит «пусть CI жжёт минуты за меня».
#
# СТАВИТСЯ ОДНОЙ КОМАНДОЙ:  git config core.hooksPath .githooks
set -u

KOREN=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$KOREN" || exit 0

RAB=${FLANG_TMP:-/srv/tmp}/pre-push.$$
mkdir -p "$RAB" || exit 0
trap 'rm -rf "$RAB"' EXIT INT TERM

# Проверки, которым НУЖЕН собранный двоичный. Без него `./ярлык` полез бы
# собирать (5–6 минут) — этого хук не делает и говорит об этом вслух.
S_DVOICHNYM="версия:проверка лицензии:проверка задачник:проверка опись:сверка"
# Проверки, которым двоичный не нужен.
BEZ_DVOICHNOGO="prose-numbers-guard.sh seed-runtime-is-source.sh version-derivations-guard.sh seed-refresh.sh"

zapusk() { # имя, команда…
  imya=$1; shift
  ( "$@" >"$RAB/$imya.out" 2>&1; echo $? >"$RAB/$imya.kod" ) &
}

echo "хук перед пушем: дешёвые сторожа, долгие оставлены CI"
echo

NACHALO=$(date +%s)

zapusk proza          sh scripts/guards/prose-numbers-guard.sh
zapusk semya          sh scripts/seed/seed-runtime-is-source.sh
# semya-osvezhit --check: годен ли быстрый пересев (задача 3388). Краснеет
# только на подлоге происхождения — рантайм догнал источник (как после
# быстрого пересева), а замыкание flang/self ушло вперёд отпечатка: тогда
# compiler_flang.c старый, а семя подано свежим. Обычное отставание середины
# работы (отстают и рантайм, и замыкание) — зелёное, это не его предмет.
zapusk semyaosv       sh scripts/seed/seed-refresh.sh --check
zapusk versii-vezde   sh scripts/guards/version-derivations-guard.sh
zapusk zov            sh scripts/guards/who-calls-the-guards.sh --check
zapusk podlog         sh scripts/guards/guards-without-forgery-probe.sh --check
zapusk opis           sh scripts/guards/proved-share-vs-tree.sh
# Форма записи, на которой стояла беда 8455: `А или Б и притом В` без внешних
# скобок читается `А или (Б и притом В)` — первая ветка отвечает за всё
# выражение, а разбор и типы на это не краснеют. 0,3 с, без двоичного; дорогая
# половина того же сторожа (прогон `--proof` по библиотеке) — по расписанию,
# .github/workflows/stdlib-proof.yml.
zapusk skobki         sh scripts/guards/stdlib-proof-guard.sh --скобки

DVOICHNYY=да
if [ ! -x bootstrap/flang ]; then
  DVOICHNYY=нет
else
  # Кириллица, транслит и отсутствие package.json переехали с оболочки на flang
  # (задача 5821): сторож — план `.fscript`, и без двоичного его не позвать.
  # На дереве без bootstrap/flang они не идут, и об этом сказано ниже вслух.
  # package.json выброшен 17 сентября 2026 (задача 3570); вернувшийся файл —
  # второе место версии и чужой «type» для каждого .js.
  zapusk kirillica  bootstrap/flang io scripts/guards/cyrillic-file-names-guard.fscript --plan Проверка
  zapusk translit   bootstrap/flang io scripts/guards/translit-file-names-guard.fscript --plan Проверка
  zapusk bez-paketa bootstrap/flang io scripts/guards/no-package-json-guard.fscript --plan Проверка
  # «Сбор»: объявление ярлыка в скрипте против строки таблицы ярлыки.flang
  # (задача 1416). Второй экземпляр объявлений завели 15 сентября, а звать
  # прибор не стал никто — ни ярлык, ни этот хук, ни CI. За восемь дней
  # молчания из 147 целей таблицы сошлось знак в знак 53, разошлось 77,
  # и 17 не были объявлены вовсе. Проверка, которую никто не зовёт, ничего
  # не проверяет — ровно тот же довод, по которому заведён сам хук.
  # Замер на этой машине: сам «Сбор» 14,8 с (два прогона, 14,84 и 14,74).
  # Хук от него не подорожал вовсе: проверки идут разом, и 14,8 с прячутся
  # под самой долгой (opis-sverka). Три пары прогонов подряд, 24 сентября:
  # без «Сбора» 41, 43, 44 с — с ним 44, 40, 42 с. Разницы нет, она меньше
  # разброса машины. Вторая половина ярлыка «ярлыки» — план
  # «Целость», 23,3 с — сюда НЕ взята: бюджет хука она удваивает, а её
  # предмет (мёртвые пути в таблице) на этом дереве зелен с 15 сентября.
  zapusk sbor  bootstrap/flang io scripts/shortcut-collector.fscript --plan Сбор --max-orders 20000 --на-веру
  zapusk versiya  ./ярлык версия:проверка
  zapusk licenzii ./ярлык лицензии:проверка
  zapusk zadachnik ./ярлык задачник:проверка
  # Таблица docs/tree-inventory.md против того, что опись насчитала: гейт в
  # `build` (binary.yml), и дважды за 11 сентября 2026 он краснел уже на dev —
  # строки в *.sh прибавились, столбец долга остался. Замер: 32 с на этой
  # машине, идёт параллельно с остальными.
  zapusk opis-sverka  ./ярлык опись:сверка
fi

wait

BEDA=0
for f in "$RAB"/*.kod; do
  [ -f "$f" ] || continue
  imya=$(basename "$f" .kod)
  kod=$(cat "$f")
  if [ "$kod" = 0 ]; then
    printf '  зелен   %s\n' "$imya"
  else
    printf '  КРАСЕН  %s (код %s)\n' "$imya" "$kod"
    BEDA=$((BEDA+1))
  fi
done

KONEC=$(date +%s)
echo
printf 'проверено за %s с\n' "$((KONEC-NACHALO))"

echo
echo "ЧЕГО ХУК НЕ ПРОВЕРИЛ (это делает CI):"
echo "  · тесты, набор проб чекера, потолок доверия Г3 — минуты каждый"
echo "  · сборку двоичного и всё, что её требует"
echo "  · десять сторожей дороже 200 с и двенадцать, красных по долгу дерева"
echo "  · целость перечня ярлыков (план «Целость», 23 с) — вторая половина"
echo "    ./ярлык ярлыки; первая половина, «Сбор», здесь есть"
if [ "$DVOICHNYY" = нет ]; then
  echo "  · кириллицу и транслит в именах, отсутствие package.json,"
  echo "    версию, лицензии, задачник и сверку описи — НЕТ bootstrap/flang,"
  echo "    а собирать его хук не станет (5–6 минут). Соберите: make -C bootstrap"
fi

if [ "$BEDA" -gt 0 ]; then
  echo
  printf 'ПУШ ОСТАНОВЛЕН: красных проверок %s. Разбор — в выводе ниже.\n' "$BEDA" >&2
  echo >&2
  for f in "$RAB"/*.kod; do
    [ -f "$f" ] || continue
    imya=$(basename "$f" .kod)
    [ "$(cat "$f")" = 0 ] && continue
    printf '───── %s ─────\n' "$imya" >&2
    tail -20 "$RAB/$imya.out" >&2
    echo >&2
  done
  echo "Обойти можно: git push --no-verify (когда это законно — см. шапку хука)" >&2
  exit 1
fi

echo
echo "всё дешёвое зелено — можно пушить"
exit 0
