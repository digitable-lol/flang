# Без косой черты — намеренно. Со слэшем шаблон ловит только КАТАЛОГ, а в
# рабочих копиях агентов dist и node_modules бывают симлинками на общее дерево,
# и тогда `git add -A` затягивал их в коммит как ссылки. Один раз затянул.
node_modules
dist
generated/
coverage/
tmp/
# Каталог сборки релиза: там напечатанный C и архивы, всё это создаётся
# scripts/release-in-c.flang и в истории не нужно.
output/

# Временные каталоги проверок: их заводит `flang io` под своим прогоном и
# оставляет за собой, когда прогон снимают. Правило то же, что у node_modules
# строкой выше, и оно тоже написано ПО ФАКТУ: 29 августа 2026 `git add -A`
# затянул `flang/self/bootstrap/.flang-storozh-ypvg0t/проба.flang` — 12 415
# байт чужой пробы — в коммит `03f0359a`, и оттуда в ствол. Заметить это можно
# было только по имени каталога: файл лежал среди исходников компилятора и от
# них ничем не отличался.
.flang-storozh-*

# Продукты сборки точки раскрутки. Сам каталог bootstrap/ — часть дерева: это
# напечатанный C, из которого компилятор собирается без Node. Но `make -C
# bootstrap` кладёт объектные файлы, библиотеку и бинарник РЯДОМ с исходниками —
# напечатанный Makefile про отдельный каталог сборки не знает. Тот же список
# повторён в НЕ_ТОЧКА (scripts/bootstrap-c.mjs): сторож точки раскрутки обязан
# отличать продукт сборки от печати и там, где .git недоступен.
bootstrap/*.o
bootstrap/*.a
# Имя выхода — `flang`, именем языка: у компилятора и у поставленного из brew
# файла обязано быть ОДНО имя. `flang_cli` остаётся здесь ради деревьев, где он
# лежит с прежних сборок, — иначе он всплыл бы в git status как новый файл.
bootstrap/flang
bootstrap/flang_cli

# Каталоги, куда README велит печатать код: «flang emit … --out ./out-c»,
# и то же с out-js, out-python, out-go. Читатель, который выполнил команду со
# страницы, получал их непомеченными в `git status`. Со слэшем — потому что это
# всегда каталог, который создаёт сама команда.
out-*/

__pycache__/
*.tgz
.DS_Store

# Исследовательские материалы держим вне публичного репозитория.
# Препринт и патентное раскрытие лежали здесь и были доступны всем
# по raw.githubusercontent.com, хотя их собственная шапка запрещает
# публикацию до подачи заявки.
research/
*.log

# Аварийный дамп BEAM: остаётся после упавшего прогона тестов Elixir.
erl_crash.dump

# Собранный сайт документации: создаётся `node docs/site/build.mjs`,
# в истории не нужен — источник лежит в docs/.
docs/site/out/

# Производная сборки web/wasm/build.sh, а не исходник: четверть мегабайта
# двоичного файла, который печатается из web/wasm/descent.flang за секунду.
web/wasm/demo/*.wasm

# Копии дерева, которые заводит себе оснастка агента под параллельную работу.
# Каждая — полный git worktree; в дереве исходников им места нет.
.claude/worktrees/

# Двоичный компилятор, собранный при установке пакета (packaging/postinstall.mjs).
# В node_modules он и живёт; в дереве репозитория появляется, только если кто-то
# позвал сборку руками. Продукт, а не исходник: исходник — bootstrap/*.c.
dvoichnyy/

# Временные файлы счёта двадцати (benchmarks/proof-cost/count-20.flang): тот
# же файл замера без примеров и он же с телом-заглушкой. Пишутся при каждом
# прогоне и переписываются поверх; убрать их за собой план не может — поручения
# «Удалить файл» в словаре ввода-вывода нет. Имена с точки и без «.flang»
# намеренно: так их не подберёт ни один обход корпуса.
benchmarks/proof-cost/.proba-golyy
benchmarks/proof-cost/.proba-zaglushka

# Напечатанные браузерные модули: производная от .flang рядом со страницей.
# Печатает их `sh web/sobrat.sh`; в истории им делать нечего — исходник это
# `web/app/hailstone.flang` и `web/shortener/client.flang`.
web/app/*.js
web/shortener/*.js
web/*.png

# Копия двоичного, которую пишет пример «Двоичный файл туда и обратно»
# (examples/io/binary-file-round-trip.flang). Продукт прогона, а не
# исходник: убрать её за собой план не может — поручения «Удалить файл» в
# словаре ввода-вывода нет.
examples/io/.kopiya-dvoichnogo

# Каталог замера скорости и памяти: восемь сборок одной программы плюс эталон
# на C, всё создаётся benchmarks/speed/assemble.sh. Имя с точки, потому
# что оно названо числом в memory.flang — у плана доводов нет.
benchmarks/speed/.sborka

# Личные списки долей агентов: у каждого свой, в стволе бессмысленны и
# конфликтуют при каждом своде.
МОЯ-ДОЛЯ.txt
bootstrap-*/

# рабочие каталоги замеров — заводятся прогонами, в дереве им не место
schet/
schet2/

# Путь к временному каталогу прогона: у каждой машины свой, в дерево не кладётся.
.tmpdir

# Двоичный независимого чекера. Собирается одним `cc` из одного файла за
# секунду, поэтому в дереве ему делать нечего: готовый двоичный судьи, который
# никто не пересобрал, — это доверие к чужой сборке, ровно то, ради снятия чего
# чекер и написан.
flang/proof/чекер/сверщик
flang/proof/чекер/сверщик-san
flang/self/bootstrap/proba-stolknoveniy.flang
