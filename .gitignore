# Без косой черты — намеренно. Со слэшем шаблон ловит только КАТАЛОГ, а в
# рабочих копиях агентов dist и node_modules бывают симлинками на общее дерево,
# и тогда `git add -A` затягивал их в коммит как ссылки. Один раз затянул.
node_modules
dist
generated/
coverage/
tmp/
# Каталог сборки релиза: там напечатанный C и архивы, всё это создаётся
# scripts/build-release-c.mjs и в истории не нужно.
output/
__pycache__/
*.tgz
.DS_Store

# Исследовательские материалы держим вне публичного репозитория.
# Препринт и патентное раскрытие лежали здесь и были доступны всем
# по raw.githubusercontent.com, хотя их собственная шапка запрещает
# публикацию до подачи заявки.
research/
*.log
