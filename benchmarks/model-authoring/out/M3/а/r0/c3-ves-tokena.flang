type Токен = Слово(текст: string) | Число(значение: number) | Конец

function Вес_токена(токен: Токен): number {
  switch (токен) {
    case Слово(текст): return текст.length;
    case Число(значение): return значение;
    case Конец: return 0;
  }
}

// Примеры
let пример1 = Вес_токена(Слово("привет"));
let пример2 = Вес_токена(Число(42));
let пример3 = Вес_токена(Конец);
