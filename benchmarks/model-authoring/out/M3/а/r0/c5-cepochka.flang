module Цепочка
  type Цепочка = Конец | Звено(значение: число, дальше: Цепочка)

  function Цепочка_из_списка(элементы: list число): Цепочка
    match элементы
      | [] => Конец
      | [x, ...xs] => Звено(x, Цепочка_из_списка(xs))
    end
  end

  function Сумма_цепочки(цепь: Цепочка): число
    match цепь
      | Конец => 0
      | Звено(значение, дальше) => значение + Сумма_цепочки(дальше)
    end
  end

  function Сумма_из_списка(элементы: list число): число
    Сумма_цепочки(Цепочка_из_списка(элементы))
  end

  test Сумма_из_списка([1, 2, 3]) == 6
  test Сумма_из_списка([]) == 0
end
