object Смена {
    number часы;
    boolean ночная;
}

function Рассчитать_надбавку(Смена смена) returns number {
    number надбавка = 0;

    if (смена.часы > 8) {
        надбавка += 300;
    }

    if (смена.ночная) {
        надбавка += 500;
    }

    if (надбавка > 800) {
        надбавка = 800;
    }

    return надбавка;
}
