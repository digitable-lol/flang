object Продажа
    поле сумма: деньги
    поле новый клиент: логический
end

утилита Рассчитать премию(продажа: Продажа): деньги
    премия := 0
    если продажа.сумма >= 1000
        премия += продажа.сумма * 0.05
    конец
    если продажа.новый клиент
        премия += 100
    конец
    возврат премия
end
