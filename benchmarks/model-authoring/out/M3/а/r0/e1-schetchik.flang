module Счётчик
  object Счёт
    field всего: число
  end

  function нулевой счёт: Счёт
    return Счёт(всего: 0)
  end

  message Команда
    variant прибавить
      field сколько: число
    end
  end

  function шаг счёта(состояние: Счёт, сообщение: Команда): Отклик
    match сообщение
      case прибавить(сколько)
        let новое_состояние = Счёт(всего: состояние.всего + сколько)
        return Отклик(состояние: новое_состояние, действия: [])
      end
    end
  end

  example
    let начальное_состояние = нулевой счёт
    let сообщение1 = Команда(прибавить(2))
    let сообщение2 = Команда(прибавить(3))
    let отклик1 = шаг счёта(начальное_состояние, сообщение1)
    let отклик2 = шаг счёта(отклик1.состояние, сообщение2)
    assert отклик2.состояние.всего == 5
  end

  run with seed 1
    let начальное_состояние = нулевой счёт
    let сообщение1 = Команда(прибавить(2))
    let сообщение2 = Команда(прибавить(3))
    let отклик1 = шаг счёта(начальное_состояние, сообщение1)
    let отклик2 = шаг счёта(отклик1.состояние, сообщение2)
    assert отклик2.состояние.всего == 5
  end
end
