module Цех
  object Счёт = { всего: number }
  function нулевойСчёт = { всего: 0 }

  message Задача = прибавить(сколько: number) | подавиться(почему: string)

  function шагРаботника(счёт: Счёт, сообщение: Задача): Отклик
    match сообщение
      case прибавить(сколько) => { состояние: { всего: счёт.всего + сколько }, действия: [] }
      case подавиться(почему) => { состояние: счёт, действия: [остановить(почему)] }
    end
  end

  process Работник = process(нулевойСчёт, шагРаботника)

  supervisor Цех = supervisor(
    process = Работник,
    strategy = перезапустить(порог: 2, интервал: 5000, иначе: остановить)
  )

  example
    let
      с1 = Цех
      с2 = send(с1, прибавить(4))
      с3 = send(с2, подавиться("Ошибка"))
    in
      с3
    end
  end

  run(1)
    let
      с1 = Цех
      с2 = send(с1, прибавить(4))
      с3 = send(с2, подавиться("Ошибка"))
    in
      с3
    end
  end
end
