function Сколько_раз_символ(текст, знак) {
    var count = 0;
    for (var i = 0; i < length(текст); i++) {
        if (текст[i] == знак) {
            count++;
        }
    }
    return count;
}

// Пример 1
var текст1 = "абракадабра";
var знак1 = "а";
var результат1 = Сколько_раз_символ(текст1, знак1);
print(результат1); // Должно вывести 5

// Пример 2
var текст2 = "";
var знак2 = "x";
var результат2 = Сколько_раз_символ(текст2, знак2);
print(результат2); // Должно вывести 0
