module ПлощадьФигуры

type Фигура = Круг(радиус: число) | Прямоугольник(ширина: число, высота: число)

function Площадь(фигура: Фигура): число
    case фигура
        Круг(радиус) -> 3.14 * радиус * радиус
        Прямоугольник(ширина, высота) -> ширина * высота
    end
end

example
    Площадь(Прямоугольник(2, 3)) = 6
    Площадь(Круг(1)) = 3.14
end

end
