type Токен = Слово(текст: string) | Число(значение: number) | Конец

func Вес токена(токен: Токен): number =
    match токен
    | Слово(текст) => length(текст)
    | Число(значение) => значение
    | Конец => 0

example1 = Вес токена(Слово("привет"))
example2 = Вес токена(Число(42))
example3 = Вес токена(Конец)
