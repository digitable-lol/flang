mod Цепочка
  type Цепочка = Конец | Звено(значение: число, дальше: Цепочка)

  func Цепочка_из_списка(элементы: список чисел): Цепочка =
    match элементы
      | пустой => Конец
      | (первый :: остальные) => Звено(первый, Цепочка_из_списка(остальные))

  func Сумма_цепочки(цепь: Цепочка): число =
    match цепь
      | Конец => 0
      | Звено(значение, дальше) => значение + Сумма_цепочки(дальше)

  func Сумма_из_списка(элементы: список чисел): число =
    Сумма_цепочки(Цепочка_из_списка(элементы))

  test Сумма_из_списка([1, 2, 3]) = 6
  test Сумма_из_списка(пустой) = 0
