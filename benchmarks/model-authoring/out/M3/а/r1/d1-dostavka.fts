class Отправление
    поле вес: число
    поле срочная: логическое
end

утилита СтоимостьДоставки(отправление: Отправление): число
    var стоимость = 100
    if отправление.вес >= 10 then
        стоимость += 50
    end
    if отправление.срочная then
        стоимость += 200
    end
    return стоимость
end
