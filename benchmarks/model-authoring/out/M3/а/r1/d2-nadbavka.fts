object Смена {
    hours: number
    night: boolean
}

function РассчитатьНадбавку(смена: Смена): number {
    var надбавка = 0

    if (смена.hours > 8) {
        надбавка += 300
    }

    if (смена.night) {
        надбавка += 500
    }

    if (надбавка > 800) {
        надбавка = 800
    }

    return надбавка
}
