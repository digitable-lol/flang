class Продажа
    сумма: Деньги
    новый клиент: Признак
end

class Рассчитать премию
    input: Продажа
    output: Деньги
    begin
        result := 0
        if input.сумма >= 1000 then
            result += input.сумма * 0.05
        end
        if input.новый клиент = да then
            result += 100
        end
        return result
    end
end
