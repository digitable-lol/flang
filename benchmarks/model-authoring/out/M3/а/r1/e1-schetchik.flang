module Счётчик
  type Счёт = object
    всего: number
  end

  function нулевой счёт: Счёт
    return {всего: 0}
  end

  type Команда = variant
    прибавить: {сколько: number}
  end

  type Отклик = object
    состояние: Счёт
    действия: list Действие
  end

  type Действие = object
  end

  function шаг счёта(состояние: Счёт, сообщение: Команда): Отклик
    match сообщение
      case прибавить(сколько) =>
        let новое_состояние = {всего: состояние.всего + сколько}
        return {состояние: новое_состояние, действия: []}
    end
  end

  example
    let начальное_состояние = нулевой счёт
    let сообщение1 = прибавить(2)
    let сообщение2 = прибавить(3)
    let отклик1 = шаг счёта(начальное_состояние, сообщение1)
    let отклик2 = шаг счёта(отклик1.состояние, сообщение2)
    assert отклик2.состояние.всего == 5
  end

  run with seed 1
    let начальное_состояние = нулевой счёт
    let сообщение1 = прибавить(2)
    let сообщение2 = прибавить(3)
    let отклик1 = шаг счёта(начальное_состояние, сообщение1)
    let отклик2 = шаг счёта(отклик1.состояние, сообщение2)
    assert отклик2.состояние.всего == 5
  end
end
