module Цех
  type Счёт = object
    всего: number
  end

  function нулевой_счёт: Счёт
    return {всего: 0}
  end

  type Задача = union
    прибавить: {сколько: number}
    подавиться: {почему: string}
  end

  function шаг_работника(состояние: Счёт, сообщение: Задача): Отклик
    match сообщение
      case прибавить: {сколько}
        return {
          состояние: {всего: состояние.всего + количества},
          действия: []
        }
      case подавиться: {почему}
        return {
          состояние: состояние,
          действия: [{тип: "остановить", причин: почему}]
        }
    end
  end

  process Работник
    state: Счёт
    handler: шаг_работника
    initial: нулевой_счёт
  end

  supervisor Цех
    process: Работник
    strategy: перезапустить
    threshold: 2
    timeout: 5000
    else: остановить
  end

  example
    let счёт = Цех.запустить()
    счёт.отправить(прибавить: {сколько: 4})
    счёт.отправить(подавиться: {почему: "Ошибка"})
    счёт.ождать()
    let счёт2 = Цех.запустить()
    счёт2.отправить(прибавить: {сколько: 4})
    счёт2.отправить(подавиться: {почему: "Ошибка"})
    счёт2.ождать()
    assert счёт2.состояние.всего == 0
  end
end
