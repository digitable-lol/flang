module Лента
  object Полка
    field штук: number
  end

  function пустая_полка: Полка
    return { штук = 0 }
  end

  message Событие
    variant положить: {сколько: number}
    variant закончить
  end

  function шаг_ленты(состояние: Полка, сообщение: Событие): Отклик
    if сообщение is положить
      return {
        состояние = { штук = состояние.штук + сообщение.сколько },
        действия = []
      }
    else if сообщение is закончить
      return {
        состояние = состояние,
        действия = [остановиться с причиной "норма"]
      }
    else
      error "Неизвестное сообщение"
    end
  end

  process Лента
    state: Полка
    handler: шаг_ленты
    initial: пустая_полка
  end

  надзор Склад
    process Лента
    strategy перезапустить
    threshold 2 отказов за 5000 миллисекунд
    else остановить
  end

  example
    let l = запустить Склад
    отправить l, положить с количеством 7
    отправить l, закончить
    assert l.состояние.штук = 7
    assert l.отказы = 0
  end
end
