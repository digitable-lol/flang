модуль «Пиковая память»

тотальная функция «Каталог сборки»
  возвращает строка
  пример «сборка лежит рядом с планом»
    ожидается ".sborka"
  ".sborka"

тотальная функция «Каталог программ»
  возвращает строка
  пример «соперники лежат в programs»
    ожидается "programs"
  "programs"

объект «Задача»
  «имя»: строка
  «размер»: число
  «фн»: строка

тотальная функция «Задачи»
  возвращает список «Задача»
  [ (запись «Задача» с «имя» равным "коллатц" и «размер» равным 50000 и «фн» равным "Коллатц"),
    (запись «Задача» с «имя» равным "нод" и «размер» равным 300000 и «фн» равным "НОД обычный счёт"),
    (запись «Задача» с «имя» равным "сортировка" и «размер» равным 100000 и «фн» равным "Сортировка обычная"),
    (запись «Задача» с «имя» равным "дерево" и «размер» равным 100000 и «фн» равным "Обход дерева"),
    (запись «Задача» с «имя» равным "строки" и «размер» равным 18 и «фн» равным "Разбор строк") ]

объект «Замер»
  «строка»: строка
  «столбец»: строка
  «команда»: строка

тотальная функция «Запрос»
  принимает з: «Задача»
  возвращает строка
  пример «запрос — обычный машинный вид, без кавычек оболочки»
    дано з равно (запись «Задача» с «имя» равным "коллатц" и «размер» равным 50000 и «фн» равным "Коллатц")
    ожидается "{\"fn\":\"Коллатц\",\"args\":[{\"n\":\"50000\"}]}"
  соединить ["{\"fn\":\"", (з.«фн»), "\",\"args\":[{\"n\":\"", (к строке (з.«размер»)), "\"}]}"] по ""

тотальная функция «Под замером»
  принимает окончание: строка
  возвращает строка
  пример «замерщик и env стоят у всех одинаково»
    дано окончание равно "python3 prog"
    ожидается "/usr/bin/time -f %M env python3 prog"
  соединить ["/usr/bin/time -f %M env ", окончание] по ""

тотальная функция «Команда flang»
  принимает з: «Задача»
  возвращает строка
  пример «запрос подаётся трубой, потому что поручения с вводом хозяин не знает»
    дано з равно (запись «Задача» с «имя» равным "строки" и «размер» равным 18 и «фн» равным "Разбор строк")
    ожидается "printf '%s\n' '{\"fn\":\"Разбор строк\",\"args\":[{\"n\":\"18\"}]}' | /usr/bin/time -f %M env .sborka/base/flang_cli --json"
  соединить ["printf '%s\n' '", («Запрос» от з), "' | ",
    («Под замером» от (соединить [(«Каталог сборки»), "/base/flang_cli --json"] по ""))] по ""

тотальная функция «Команда с доводами»
  принимает программа: строка, з: «Задача»
  возвращает строка
  пример «соперник берёт имя задачи и размер обычными доводами»
    дано программа равно "python3 programs/tasks.py"
    дано з равно (запись «Задача» с «имя» равным "дерево" и «размер» равным 100000 и «фн» равным "Обход дерева")
    ожидается "/usr/bin/time -f %M env python3 programs/tasks.py дерево 100000"
  «Под замером» от (соединить [программа, " ", (з.«имя»), " ", (к строке (з.«размер»))] по "")

тотальная функция «Имя строки»
  принимает з: «Задача»
  возвращает строка
  пример «строка отчёта называет задачу и её размер»
    дано з равно (запись «Задача» с «имя» равным "коллатц" и «размер» равным 50000 и «фн» равным "Коллатц")
    ожидается "коллатц (50000)"
  соединить [(з.«имя»), " (", (к строке (з.«размер»)), ")"] по ""

тотальная функция «Замеры задачи»
  принимает з: «Задача»
  возвращает список «Замер»
  [ (запись «Замер» с «строка» равным («Имя строки» от з) и «столбец» равным "flang, МиБ" и «команда» равным («Команда flang» от з)),
    (запись «Замер» с «строка» равным («Имя строки» от з) и «столбец» равным "эталон-c, МиБ" и «команда» равным («Команда с доводами» от (соединить [(«Каталог сборки»), "/etalon"] по "") и з)),
    (запись «Замер» с «строка» равным («Имя строки» от з) и «столбец» равным "python, МиБ" и «команда» равным («Команда с доводами» от (соединить ["python3 ", («Каталог программ»), "/tasks.py"] по "") и з)),
    (запись «Замер» с «строка» равным («Имя строки» от з) и «столбец» равным "node, МиБ" и «команда» равным («Команда с доводами» от (соединить ["node ", («Каталог программ»), "/tasks.mjs"] по "") и з)) ]

тотальная функция «Все замеры»
  возвращает список «Замер»
  свёртка («Задачи») начиная с (пустой список) как собрано и з → (свёртка («Замеры задачи» от з) начиная с собрано как внутрь и один → (добавить один к внутрь))

тотальная функция «Сколько запусков»
  возвращает число
  пример «пять задач по четыре участника — двадцать запусков»
    ожидается 20
  длина («Все замеры»)

тотальная функция «Последняя строка»
  принимает текст: строка
  возвращает строка
  пример «число стоит последним, всё прежнее отбрасывается»
    дано текст равно "предупреждение\n13840\n"
    ожидается "13840"
  свёртка (разделить текст по "\n") начиная с "" как последняя и строчка → (если строчка равен "" то последняя
    иначе строчка)

тотальная функция «Цифра числом»
  принимает знак: строка
  возвращает число
  пример «цифра даёт своё значение»
    дано знак равно "7"
    ожидается 7
  пример «не цифра — минус единица»
    дано знак равно "к"
    ожидается -1
  если (не (знак равен "")) и притом ("0123456789" содержит знак)
    то (код символа знак) минус 48
    иначе 0 минус 1

тотальная функция «Кибибайты»
  принимает текст: строка
  возвращает число
  пример «обычное число»
    дано текст равно "13840"
    ожидается 13840
  пример «пусто — не число»
    дано текст равно ""
    ожидается -1
  пример «буквы — не число»
    дано текст равно "Command exited"
    ожидается -1
  если текст равен ""
    то 0 минус 1
    иначе свёртка (разложить текст на символы) начиная с 0 как накоплено и знак → (если накоплено меньше 0 то (0 минус 1) иначе (если («Цифра числом» от знак) меньше 0 то (0 минус 1) иначе ((накоплено умножить на 10) плюс («Цифра числом» от знак))))

тотальная функция «Мебибайты»
  принимает кибибайт: число
  возвращает число
  пример «мебибайт с одним знаком»
    дано кибибайт равно 13840
    ожидается 13.5
  пример «половина округляется вверх»
    дано кибибайт равно 1600
    ожидается 1.6
  пример «а меньшая половина — вниз»
    дано кибибайт равно 1587
    ожидается 1.5
  пусть десятые равно ((кибибайт умножить на 10) делить на 1024) плюс 0.5
  (десятые минус (десятые остаток от 1)) делить на 10

тотальная функция «Строка отчёта»
  принимает замер: «Замер», мебибайт: число
  возвращает строка
  пример «строка называет задачу, участника и число»
    дано замер равно (запись «Замер» с «строка» равным "коллатц (50000)" и «столбец» равным "flang, МиБ" и «команда» равным "")
    дано мебибайт равно 13.5
    ожидается "коллатц (50000) | flang, МиБ | 13.5"
  соединить [(замер.«строка»), " | ", (замер.«столбец»), " | ", (к строке мебибайт)] по ""

тотальная функция «Отчёт»
  принимает сделано: список строки
  возвращает строка
  пример «строки отчёта идут по одной на запуск»
    дано сделано равно ["а", "б"]
    ожидается "а\nб"
  соединить сделано по "\n"

тип «Ход»
  вариант «Начать»
  вариант «Ждём замер» содержит текущий: «Замер», осталось: список «Замер», сделано: список строки

тотальная функция «Начало»
  возвращает «Ход»
  пример «план начинается с начала»
    ожидается вариант «Начать»
  вариант «Начать»

тотальная функция «Пойти по замерам»
  принимает осталось: список «Замер», сделано: список строки
  возвращает «Продолжение»
  пример «замеров не осталось — план кончился отчётом»
    дано осталось равно []
    дано сделано равно ["а"]
    ожидается вариант «Конец работы» с значение равным "а"
  разбор осталось
    случай пусто
      то вариант «Конец работы» с значение равным («Отчёт» от сделано)
    случай голова первый и хвост прочие
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (первый.«команда»)]) и потом равным (вариант «Ждём замер» с текущий равным первый и осталось равным прочие и сделано равным сделано)

тотальная функция «Взять число»
  принимает текущий: «Замер», осталось: список «Замер», сделано: список строки, ошибки: строка
  возвращает «Продолжение»
  если («Кибибайты» от («Последняя строка» от ошибки)) меньше 0
    то вариант «Провал» с код равным "ЗАМЕР_НЕ_ЧИСЛО" и сообщение равным (соединить [(текущий.«строка»), " | ",
      (текущий.«столбец»), ": замерщик не назвал числа — ", ошибки] по "")
    иначе «Пойти по замерам» от осталось и (добавить («Строка отчёта» от текущий и («Мебибайты» от («Кибибайты» от («Последняя строка» от ошибки)))) к сделано)

тотальная функция «После замера»
  принимает текущий: «Замер», осталось: список «Замер», сделано: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  пример «убитый участник отличим от вернувшего ноль своим кодом»
    дано текущий равно (запись «Замер» с «строка» равным "с" и «столбец» равным "ст" и «команда» равным "к")
    дано осталось равно []
    дано сделано равно []
    дано отклик равно вариант «Процесс убит» с сигнал равным "SIGKILL" и вывод равным "" и ошибки равным ""
    ожидается вариант «Провал» с код равным "ЗАМЕР_УБИТ" и сообщение равным "с | ст: SIGKILL"
  пример «сбой хозяина доезжает до плана своим кодом»
    дано текущий равно (запись «Замер» с «строка» равным "с" и «столбец» равным "ст" и «команда» равным "к")
    дано осталось равно []
    дано сделано равно []
    дано отклик равно вариант «Сбой» с код равным "FLANG_IO_TIMEOUT" и сообщение равным "не уложилась"
    ожидается вариант «Провал» с код равным "FLANG_IO_TIMEOUT" и сообщение равным "с | ст: не уложилась"
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то (если код равен 0 то («Взять число» от текущий и осталось и сделано и ошибки)
        иначе (вариант «Провал» с код равным "ЗАМЕР_ОТКАЗАЛ" и сообщение равным (соединить [(текущий.«строка»), " | ",
        (текущий.«столбец»), ": код ", (к строке код), ", ", ошибки] по "")))
    случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
      то вариант «Провал» с код равным "ЗАМЕР_УБИТ" и сообщение равным (соединить [(текущий.«строка»), " | ",
        (текущий.«столбец»), ": ", сигнал] по "")
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным (соединить [(текущий.«строка»), " | ",
        (текущий.«столбец»), ": ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали конца замера"

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Начать»
      то «Пойти по замерам» от («Все замеры») и (пустой список)
    случай вариант «Ждём замер» с текущий как текущий и осталось как осталось и сделано как сделано
      то «После замера» от текущий и осталось и сделано и отклик

план «Пиковая память»
  состояние «Ход»
  начинает с «Начало»
  обрабатывает «Дальше»
