модуль «SQLite read»
  использует «SQLite» из "../../../flang/stdlib/sqlite.flang"

тип «Ход»
  вариант «Начало»
  вариант «Ждём октеты»

тотальная функция «Откуда»
  возвращает строка
  пример «читается образец, сделанный сторонней sqlite3»
    ожидается "obrazec.db"
  "obrazec.db"

тотальная функция «Какая таблица»
  возвращает строка
  пример «таблица названа по-русски»
    ожидается "люди"
  "люди"

тотальная функция «Начало хода»
  возвращает «Ход»
  пример «план начинается с чтения файла»
    ожидается вариант «Начало»
  вариант «Начало»

тотальная функция «Отчёт о заголовке»
  принимает октеты: список числа
  возвращает строка
  обеспечивает «отчёт непуст» (длина результат) больше 0
  соединить [
      "магия SQLite: ", (если («Это база SQLite» от октеты) то "да" иначе "нет"),
      "\nразмер страницы: ", (к строке («Размер страницы» от октеты)),
      "\nстраниц: ", (к строке («Страниц в базе» от октеты)),
      "\nоктетов в файле: ", (к строке (длина октеты))
    ] по ""

тотальная функция «Отчёт о схеме»
  принимает октеты: список числа
  возвращает строка
  обеспечивает «отчёт непуст» (длина результат) больше 0
  соединить [
      "таблицы: ", (соединить («Имена таблиц» от октеты) по ", "),
      "\nкорень таблицы ", («Какая таблица»), ": ", (к строке («Корень таблицы» от октеты и («Какая таблица»))),
      "\nSQL: ", (соединить (отобразить («Таблицы схемы» от октеты) как таблица → таблица.определение) по " ; ")
    ] по ""

тотальная функция «Отчёт о строках»
  принимает октеты: список числа
  возвращает строка
  обеспечивает «отчёт непуст» (длина результат) больше 0
  пусть ряды равно «Строки таблицы» от октеты и («Какая таблица»)
  соединить [
      "строк: ", (к строке (длина ряды)),
      "\n", (соединить (отобразить ряды как ряд → «Строка текстом» от ряд) по "\n")
    ] по ""

тотальная функция «Отчёт»
  принимает октеты: список числа
  возвращает строка
  обеспечивает «отчёт непуст» (длина результат) больше 0
  соединить [(«Отчёт о заголовке» от октеты), («Отчёт о схеме» от октеты), («Отчёт о строках» от октеты)] по "\n"

тотальная функция «После чтения»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пример «не прочиталось — план сдаётся кодом хозяина»
    дано отклик равно вариант «Сбой» с код равным "FLANG_IO_READ" и сообщение равным "файл не прочитан"
    ожидается вариант «Провал» с код равным "FLANG_IO_READ" и сообщение равным "файл не прочитан"
  разбор отклик
    случай вариант «Октеты» с октеты как октеты
      то вариант «Конец работы» с значение равным («Отчёт» от октеты)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали октетов"

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  пример «первым делом файл базы читается октетами»
    дано ход равно вариант «Начало»
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать октеты из файла» с путь равным "obrazec.db") и потом равным (вариант «Ждём октеты»)
  разбор ход
    случай вариант «Начало»
      то вариант «Сделать» с поручение равным (вариант «Прочитать октеты из файла» с путь равным («Откуда»)) и потом равным (вариант «Ждём октеты»)
    случай вариант «Ждём октеты»
      то «После чтения» от отклик

план «Прочитать базу SQLite»
  состояние «Ход»
  начинает с «Начало хода»
  обрабатывает «Дальше»
