модуль «Markup guard»

объект «Обход»
  «номер»: число
  «беды»: список строки

объект «Снятие»
  «внутри»: признак
  «собрано»: строка

тип «Ход»
  вариант «Ждём список»
  вариант «Ждём файл» содержит файл: строка, осталось: список строки, беды: список строки, строк: число, файлов: число

тотальная функция «Приметы логики»
  возвращает список строки
  обеспечивает «примет больше тридцати» (длина результат) больше 30
  пример «первая примета — сложение»
    ожидается [" + ", " - ", " * ", " / ", " % ", "===", "!==", "==", "!=", " < ", " > ", "<=", ">=", "&&", "||", "??", " ? ", " !", "(!", "{!", "if (", "if(", "switch", "while", "for (", ".filter(", ".reduce(", ".sort(", ".find(", ".some(", ".every(", "Math.", "Number(", "String(", "parseInt", "parseFloat", "toFixed", "toLocaleString", "let ", "var ", "new ", ".length", "throw", "try ", "=> {", "useEffect", "useMemo", "useCallback", "useRef"]
  [" + ", " - ", " * ", " / ", " % ", "===", "!==", "==", "!=", " < ", " > ", "<=", ">=", "&&", "||", "??", " ? ", " !", "(!", "{!", "if (", "if(", "switch", "while", "for (", ".filter(", ".reduce(", ".sort(", ".find(", ".some(", ".every(", "Math.", "Number(", "String(", "parseInt", "parseFloat", "toFixed", "toLocaleString", "let ", "var ", "new ", ".length", "throw", "try ", "=> {", "useEffect", "useMemo", "useCallback", "useRef"]

тотальная функция «Вне кавычек»
  принимает текст: строка, кавычка: строка
  возвращает строка
  пример «то, что в кавычках, снято»
    дано текст равно "a('x') + b('y')"
    дано кавычка равно "'"
    ожидается "a() + b()"
  пример «без кавычек — как было»
    дано текст равно "a + b"
    дано кавычка равно "'"
    ожидается "a + b"
  пусть снятие равно свёртка (разделить текст по кавычка) начиная с (запись «Снятие» с «внутри» равным нет и «собрано» равным "") как снятое и часть → (если снятое.«внутри» то (запись «Снятие» с «внутри» равным нет и «собрано» равным снятое.«собрано») иначе (запись «Снятие» с «внутри» равным да и «собрано» равным (соединить снятое.«собрано» с часть)))
  снятие.«собрано»

тотальная функция «Без замечания»
  принимает строка: строка
  возвращает строка
  пример «хвост после двух косых снят»
    дано строка равно "const a = f() // зовём ядро"
    ожидается "const a = f() "
  пример «без замечания — как было»
    дано строка равно "const a = f()"
    ожидается "const a = f()"
  голова (разделить строка по "//")

тотальная функция «Голая строка»
  принимает строка: строка
  возвращает строка
  пример «сняты кавычки трёх видов и замечание»
    дано строка равно "x('a', \"b\", `c`) // + 1"
    ожидается "x(, , ) "
  «Вне кавычек» от («Вне кавычек» от («Вне кавычек» от («Без замечания» от строка) и "'") и "\"") и "`"

тотальная функция «Строка кода»
  принимает голая: строка
  возвращает признак
  пример «вызов — код»
    дано голая равно "  {strokiVitriny(korzina).map((s) => ("
    ожидается да
  пример «текст разметки — не код»
    дано голая равно "        Данные, суммы и скидку считает"
    ожидается нет
  ((голая содержит "{") или (голая содержит "(")) или (голая содержит "=")

тотальная функция «Найденная примета»
  принимает голая: строка
  возвращает строка
  обеспечивает «пустая строка примет не несёт» (не (голая равен "")) или (результат равен "")
  пример «сложение найдено»
    дано голая равно "const s = a + b"
    ожидается " + "
  пример «стрелка в обработчике — не примета»
    дано голая равно "onClick={() => dispatch(Sbrosit())}"
    ожидается ""
  пример «условие найдено»
    дано голая равно "if (x) {"
    ожидается "if ("
  свёртка («Приметы логики») начиная с "" как найдено и примета → если (найдено равен "") и притом (голая содержит примета) то примета иначе найдено

тотальная функция «Логика в строке»
  принимает строка: строка
  возвращает строка
  пример «разметка — чисто»
    дано строка равно "      <td>{stroka['цена']}</td>"
    ожидается ""
  пример «арифметика — примета»
    дано строка равно "  const итог = (копейки / 100).toFixed(2)"
    ожидается " / "
  пример «данные без вызова — примета»
    дано строка равно "const tovary = ["
    ожидается "const без вызова"
  пример «связывание результата вызова — чисто»
    дано строка равно "  const [korzina, dispatch] = useReducer(shag, nachalnayaKorzina())"
    ожидается ""
  пример «текст со знаком плюс внутри кавычек — чисто»
    дано строка равно "  <h1>{'flang + React'}</h1>"
    ожидается ""
  пусть голая равно «Голая строка» от строка
  пусть примета равно «Найденная примета» от голая
  если не («Строка кода» от голая)
    то ""
    иначе (если не (примета равен "") то примета иначе (если ((голая содержит "const ") и притом (не (голая содержит "const ["))) и притом (не (голая содержит "(")) то "const без вызова" иначе ""))

тотальная функция «Строк кода»
  принимает текст: строка
  возвращает число
  пример «две строки кода из трёх»
    дано текст равно "const a = f()\nтекст\n<b>{x}</b>"
    ожидается 2
  свёртка (разделить текст по "\n") начиная с 0 как счёт и строка → если «Строка кода» от («Голая строка» от строка) то счёт плюс 1 иначе счёт

тотальная функция «Беды файла»
  принимает файл: строка, текст: строка, прежние: список строки
  возвращает список строки
  для всех текст обеспечивает «прежние беды не теряются» (длина результат) не меньше (длина прежние)
  пример «чистый файл — бед не прибавилось»
    дано файл равно "App.tsx"
    дано текст равно "import { x } from './a.js'\n<td>{x}</td>\n"
    дано прежние равно []
    ожидается []
  пример «арифметика названа файлом и строкой, прежняя беда впереди»
    дано файл равно "App.tsx"
    дано текст равно "import { x } from './a.js'\nconst y = x + 1\n"
    дано прежние равно ["main.tsx:3: примета «let »: let z = f()"]
    ожидается ["main.tsx:3: примета «let »: let z = f()", "App.tsx:2: примета « + »: const y = x + 1"]
  пусть обход равно свёртка (разделить текст по "\n") начиная с (запись «Обход» с «номер» равным 1 и «беды» равным прежние) как пройдено и строка → (запись «Обход» с «номер» равным (пройдено.«номер» плюс 1) и «беды» равным (если («Логика в строке» от строка) равен "" то пройдено.«беды» иначе добавить (соединить [файл, ":", (к строке пройдено.«номер»), ": примета «", («Логика в строке» от строка), "»: ", строка] по "") к пройдено.«беды»))
  обход.«беды»

тотальная функция «Только tsx»
  принимает имена: список строки
  возвращает список строки
  пример «прочие имена отброшены»
    дано имена равно ["App.tsx", "main.tsx", "styles.css"]
    ожидается ["App.tsx", "main.tsx"]
  отфильтровать имена где имя → ((длина имя) больше 4) и притом ((подстрока имя с ((длина имя) минус 3) по (длина имя)) равен ".tsx")

тотальная функция «Итог»
  принимает беды: список строки, строк: число, файлов: число
  возвращает «Продолжение»
  пример «бед нет — конец работы с числом строк»
    дано беды равно []
    дано строк равно 40
    дано файлов равно 4
    ожидается вариант «Конец работы» с значение равным "логики 0 строк: файлов .tsx 4, строк кода 40"
  пример «беда есть — провал с перечнем»
    дано беды равно ["App.tsx:2: примета « + »: const y = x + 1"]
    дано строк равно 2
    дано файлов равно 1
    ожидается вариант «Провал» с код равным "FLANG_TSX_LOGIKA" и сообщение равным "строк логики 1 из 2 строк кода:\nApp.tsx:2: примета « + »: const y = x + 1"
  если (длина беды) равен 0
    то вариант «Конец работы» с значение равным (соединить ["логики 0 строк: файлов .tsx ", (к строке файлов), ", строк кода ", (к строке строк)] по "")
    иначе вариант «Провал» с код равным "FLANG_TSX_LOGIKA" и сообщение равным (соединить ["строк логики ", (к строке (длина беды)), " из ", (к строке строк), " строк кода:\n", (соединить беды по "\n")] по "")

тотальная функция «Пойти по файлам»
  принимает осталось: список строки, беды: список строки, строк: число, файлов: число
  возвращает «Продолжение»
  пример «файлов не осталось — итог»
    дано осталось равно []
    дано беды равно []
    дано строк равно 3
    дано файлов равно 1
    ожидается вариант «Конец работы» с значение равным "логики 0 строк: файлов .tsx 1, строк кода 3"
  пример «следующий файл читается из ../src»
    дано осталось равно ["App.tsx"]
    дано беды равно []
    дано строк равно 0
    дано файлов равно 0
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "../src/App.tsx") и потом равным (вариант «Ждём файл» с файл равным "App.tsx" и осталось равным [] и беды равным [] и строк равным 0 и файлов равным 0)
  разбор осталось
    случай пусто
      то «Итог» от беды и строк и файлов
    случай голова первый и хвост прочие
      то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным (соединить "../src/" с первый)) и потом равным (вариант «Ждём файл» с файл равным первый и осталось равным прочие и беды равным беды и строк равным строк и файлов равным файлов)

тотальная функция «После списка»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пример «в каталоге нет .tsx — нечего судить»
    дано отклик равно вариант «Перечислено» с имена равным ["styles.css"]
    ожидается вариант «Провал» с код равным "FLANG_TSX_NET" и сообщение равным "в ../src нет ни одного .tsx — судить нечего"
  пример «отказ хозяина — отказ плана»
    дано отклик равно вариант «Сбой» с код равным "FLANG_IO_READ" и сообщение равным "нет каталога"
    ожидается вариант «Провал» с код равным "FLANG_IO_READ" и сообщение равным "нет каталога"
  разбор отклик
    случай вариант «Пока ничего»
      то вариант «Сделать» с поручение равным (вариант «Перечислить каталог» с путь равным "../src") и потом равным (вариант «Ждём список»)
    случай вариант «Перечислено» с имена как имена
      то (если (длина («Только tsx» от имена)) равен 0 то (вариант «Провал» с код равным "FLANG_TSX_NET" и сообщение равным "в ../src нет ни одного .tsx — судить нечего") иначе «Пойти по файлам» от («Только tsx» от имена) и [] и 0 и 0)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали список каталога"

тотальная функция «После файла»
  принимает файл: строка, осталось: список строки, беды: список строки, строк: число, файлов: число, отклик: «Отклик»
  возвращает «Продолжение»
  пример «последний файл чист — итог»
    дано файл равно "App.tsx"
    дано осталось равно []
    дано беды равно []
    дано строк равно 0
    дано файлов равно 0
    дано отклик равно вариант «Прочитано» с содержимое равным "import { x } from './a.js'\n<td>{x}</td>\n"
    ожидается вариант «Конец работы» с значение равным "логики 0 строк: файлов .tsx 1, строк кода 2"
  пример «отказ чтения — отказ плана с именем файла»
    дано файл равно "App.tsx"
    дано осталось равно []
    дано беды равно []
    дано строк равно 0
    дано файлов равно 0
    дано отклик равно вариант «Сбой» с код равным "FLANG_IO_READ" и сообщение равным "нет файла"
    ожидается вариант «Провал» с код равным "FLANG_IO_READ" и сообщение равным "App.tsx: нет файла"
  разбор отклик
    случай вариант «Прочитано» с содержимое как текст
      то «Пойти по файлам» от осталось и («Беды файла» от файл и текст и беды) и (строк плюс («Строк кода» от текст)) и (файлов плюс 1)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным (соединить [файл, ": ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным (соединить [файл, ": ждали текст файла"] по "")

тотальная функция «Начать»
  возвращает «Ход»
  пример «первым делом — список каталога»
    ожидается вариант «Ждём список»
  вариант «Ждём список»

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  пример «сначала перечисляется ../src»
    дано ход равно вариант «Ждём список»
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Перечислить каталог» с путь равным "../src") и потом равным (вариант «Ждём список»)
  разбор ход
    случай вариант «Ждём список»
      то «После списка» от отклик
    случай вариант «Ждём файл» с файл как файл и осталось как осталось и беды как беды и строк как строк и файлов как файлов
      то «После файла» от файл и осталось и беды и строк и файлов и отклик

план «Логики в разметке нет»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
