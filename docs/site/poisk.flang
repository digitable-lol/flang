тотальная функция «Язык страницы»
  принимает страница: «Страница»
  возвращает строка
  пример «Пустой язык — по умолчанию ru»
    дано страница равно запись «Страница» с «адрес» равным "a" и «имя» равным "" и «раздел» равным "" и «язык» равным "" и «оглавление» равным пустой список и «исходник» равным "" и «заметка» равным нет
    ожидается "ru"
  пример «Названный язык остаётся»
    дано страница равно запись «Страница» с «адрес» равным "a" и «имя» равным "" и «раздел» равным "" и «язык» равным "en" и «оглавление» равным пустой список и «исходник» равным "" и «заметка» равным нет
    ожидается "en"
  если (страница.«язык») равен ""
    то "ru"
    иначе страница.«язык»

тотальная функция «Обработать страницу»
  принимает страница: «Страница», предел: число
  возвращает «Обработанная страница»
  пусть текст равно («Голый текст» от (страница.«исходник»))
  пусть полная равно (длина текст)
  пусть кусок равно (если полная больше предел то (подстрока текст с 1 по предел) иначе текст)
  пусть строкаУказателя равно (запись «Запись указателя» с «адрес» равным (страница.«адрес») и «имя» равным (страница.«имя») и «раздел» равным (страница.«раздел») и «язык» равным («Язык страницы» от страница) и «заголовки» равным («Заголовки страницы» от страница) и «текст» равным кусок и «заметка» равным (если (страница.«заметка») то 1 иначе 0))
  запись «Обработанная страница» с «запись» равным строкаУказателя и «полнаяДлина» равным полная и «положеннаяДлина» равным (длина кусок)

тотальная функция «Собрать указатель»
  принимает страницы: список «Страница», предел: число
  возвращает «Указатель и меры»
  пусть обработанные равно (отобразить страницы как страница → («Обработать страницу» от страница и предел))
  пусть записи равно (отобразить обработанные как о → (о.«запись»))
  пусть полныйТекст равно (свёртка обработанные начиная с 0 как акк и о → (акк плюс (о.«полнаяДлина»)))
  пусть положенныйТекст равно (свёртка обработанные начиная с 0 как акк и о → (акк плюс (о.«положеннаяДлина»)))
  запись «Указатель и меры» с «указатель» равным (запись «Указатель» с «предел» равным предел и «страницы» равным записи) и «меры» равным (запись «Меры указателя» с «страниц» равным (длина страницы) и «полныйТекст» равным полныйТекст и «положенныйТекст» равным положенныйТекст)

тотальная функция «Экранировать знак JSON»
  принимает знак: строка
  возвращает строка
  пример «Кавычка»
    дано знак равно "\""
    ожидается "\\\""
  пример «Обратная косая»
    дано знак равно "\\"
    ожидается "\\\\"
  пример «Обычный знак — как есть»
    дано знак равно "а"
    ожидается "а"
  если знак равен "\""
    то "\\\""
    иначе если знак равен "\\"
      то "\\\\"
      иначе если знак равен "\n"
        то "\\n"
        иначе если знак равен "\t"
          то "\\t"
          иначе если знак равен "\r"
            то "\\r"
            иначе знак

тотальная функция «Экранировать строку JSON»
  принимает текст: строка
  возвращает строка
  пример «Кавычка внутри строки»
    дано текст равно "а\"б"
    ожидается "а\\\"б"
  разбор текст
    случай пусто
      то ""
    случай голова и хвост
      то соединить («Экранировать знак JSON» от голова) с («Экранировать строку JSON» от хвост)

тотальная функция «Строка JSON»
  принимает текст: строка
  возвращает строка
  пример «Обёрнута в кавычки»
    дано текст равно "аб"
    ожидается "\"аб\""
  соединить ["\"", («Экранировать строку JSON» от текст), "\""] по ""

тотальная функция «Запись JSON строкой»
  принимает з: «Запись указателя»
  возвращает строка
  пример «Семь полей массивом, заметка — голым числом»
    дано з равно запись «Запись указателя» с «адрес» равным "a.html" и «имя» равным "А" и «раздел» равным "р" и «язык» равным "ru" и «заголовки» равным "" и «текст» равным "текст" и «заметка» равным 1
    ожидается "[\"a.html\",\"А\",\"р\",\"ru\",\"\",\"текст\",1]"
  соединить [
    "[",
    («Строка JSON» от (з.«адрес»)), ",",
    («Строка JSON» от (з.«имя»)), ",",
    («Строка JSON» от (з.«раздел»)), ",",
    («Строка JSON» от (з.«язык»)), ",",
    («Строка JSON» от (з.«заголовки»)), ",",
    («Строка JSON» от (з.«текст»)), ",",
    (к строке (з.«заметка»)),
    "]"
  ] по ""

тотальная функция «Поля указателя JSON строкой»
  возвращает строка
  пример «Те же семь имён, что и у списка полей, строкой JSON»
    ожидается "[\"адрес\",\"имя\",\"раздел\",\"язык\",\"заголовки\",\"текст\",\"заметка\"]"
  соединить ["[", (соединить (отобразить («Поля указателя») как имя → («Строка JSON» от имя)) по ","), "]"] по ""

тотальная функция «Печать указателя»
  принимает указатель: «Указатель»
  возвращает строка
  пусть страницыJSON равно (соединить (отобразить (указатель.«страницы») как з → («Запись JSON строкой» от з)) по ",")
  соединить [
    "window.ФЛАНГ_УКАЗАТЕЛЬ={\"поля\":",
    («Поля указателя JSON строкой»),
    ",\"предел\":",
    (к строке (указатель.«предел»)),
    ",\"страницы\":[",
    страницыJSON,
    "]};\n"
  ] по ""
