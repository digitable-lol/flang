  (запись «Переезд» с «старый» равным "nachalo.html" и «новый» равным "getting-started.html"),
  (запись «Переезд» с «старый» равным "izmeneniya.html" и «новый» равным "releases.html"),
  (запись «Переезд» с «старый» равным "zhurnal.html" и «новый» равным "journal.html"),
  (запись «Переезд» с «старый» равным "dokazatelstva.html" и «новый» равным "proofs.html"),
  (запись «Переезд» с «старый» равным "obzor.html" и «новый» равным "overview.html"),
