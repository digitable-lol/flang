<lexer>
  <config>
    <name>FTS</name>
    <alias>fts</alias>
    <filename>*.fts</filename>
    <mime_type>text/x-fts</mime_type>
    <not_multiline>false</not_multiline>
    <dot_all>false</dot_all>
    <case_insensitive>false</case_insensitive>
  </config>
  <rules>
    <!--
      FTS has three surfaces that appear in real .fts files (see
      docs/rukovodstvo/language.ru.md and tools/ftsc/src/parse-module.mjs in the fts-upstream
      repo): the natural RU/EN indentation surface, the legacy brace/JSON-like
      surface, and the ftsc module/functor-mapping headers layered on top.

      Chroma tokenizes each state's rules top-to-bottom and (like Pygments)
      takes the first rule whose pattern matches at the current position, so -
      exactly like the TextMate grammar in ../vscode-fts/ - multi-word phrases
      that share a prefix with a shorter keyword (e.g. "is at least" vs a bare
      "is") must be listed before that shorter keyword. Go's regexp engine
      (RE2) has no lookahead/lookbehind/backreferences, so this lexer is kept
      to a single flat root state plus small string/comment sub-states.
    -->
    <state name="root">
      <rule pattern="\n">
        <token type="Text"/>
      </rule>
      <rule pattern="[ \t\r]+">
        <token type="Text"/>
      </rule>

      <rule pattern="//.*$">
        <token type="CommentSingle"/>
      </rule>
      <rule pattern="/\*">
        <token type="CommentMultiline"/>
        <push state="comment"/>
      </rule>

      <!-- quoted names / strings -->
      <rule pattern="«[^»]*»">
        <token type="LiteralString"/>
      </rule>
      <rule pattern="&#34;">
        <token type="LiteralStringDouble"/>
        <push state="dqs"/>
      </rule>
      <rule pattern="&#39;">
        <token type="LiteralStringSingle"/>
        <push state="sqs"/>
      </rule>

      <!-- module / functor-mapping headers (ftsc) -->
      <rule pattern="\b(модуль|module|использует|uses|экспортирует|exports)\b">
        <token type="KeywordNamespace"/>
      </rule>
      <rule pattern="\b(отображается в поле|maps to field|отображается в морфизм|maps to morphism|отображается в|maps to)\b">
        <token type="Operator"/>
      </rule>

      <!-- declaration headers (both surfaces, including the legacy structure/functor/proposition/category) -->
      <rule pattern="\b(вложен объект|вложена структура|nested object|nested structure|категория|category|объект|структура|object|structure|морфизм|morphism|теорема|theorem|утилита|utility|правило|rule|свойство|property|пример|example|функтор|functor|proposition|утверждение)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="\b(witness|свидетельство|apply|применить|compose|композиция)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="\b(selector|селектор|value|значение|path|путь|detail|описание|functors|функторы|arg|аргумент)\b">
        <token type="NameProperty"/>
      </rule>

      <!-- comparisons must come before the bare is/является modality below -->
      <rule pattern="\b(не меньше|не больше|не равен|не равна|не равно|равен|равна|равно|больше|меньше|is at least|is at most|is not equal to|equals|is greater than|is less than)\b">
        <token type="OperatorWord"/>
      </rule>

      <rule pattern="\b(иногда является|является|may be|is)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="\b(состоянием|state)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="\b(строкой|текстом|числом|датой|деньгами|признаком|строку|число|дату|деньги|признак|string|number|date|money|boolean)\b">
        <token type="KeywordType"/>
      </rule>

      <!-- theorem / morphism clauses: longest phrases first -->
      <rule pattern="\b(затем по морфизму|затем применить морфизм|по морфизму|применить морфизм|следовательно|получаем|then by morphism|then apply morphism|by morphism|apply morphism|therefore)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="\b(в данных|найти где|дано|имеет|равное|in data|find where|given|has|equal to)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="\b(то добавить|то результат|то|если|и|из|в|по закону|then add|then result|then|if|and|from|to|under law)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="\b(принимает|возвращает|начинает с|ожидается|accepts|returns|starts with|expected)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="\b(процентов от поля|процента от поля|процент от поля|percent of field|percents of field|поле|field|результат|result)\b">
        <token type="Keyword"/>
      </rule>

      <rule pattern="\b(да|нет|true|false)\b">
        <token type="KeywordConstant"/>
      </rule>
      <rule pattern="\b(ничто|null)\b">
        <token type="KeywordConstant"/>
      </rule>

      <rule pattern="-?\b(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?\b">
        <token type="LiteralNumberInteger"/>
      </rule>

      <rule pattern="-&gt;|=&gt;">
        <token type="Operator"/>
      </rule>
      <rule pattern="[{}\[\]]">
        <token type="Punctuation"/>
      </rule>
      <rule pattern="[,:;.?]">
        <token type="Punctuation"/>
      </rule>

      <rule pattern="[\p{L}_$][\p{L}\p{N}_$-]*">
        <token type="Name"/>
      </rule>
      <rule pattern=".">
        <token type="Error"/>
      </rule>
    </state>

    <state name="comment">
      <rule pattern="[^*/]+">
        <token type="CommentMultiline"/>
      </rule>
      <rule pattern="/\*">
        <token type="CommentMultiline"/>
        <push/>
      </rule>
      <rule pattern="\*/">
        <token type="CommentMultiline"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="[*/]">
        <token type="CommentMultiline"/>
      </rule>
    </state>

    <state name="dqs">
      <rule pattern="&#34;">
        <token type="LiteralStringDouble"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="\\.">
        <token type="LiteralStringEscape"/>
      </rule>
      <rule pattern="[^&#34;\\]+">
        <token type="LiteralStringDouble"/>
      </rule>
    </state>

    <state name="sqs">
      <rule pattern="&#39;">
        <token type="LiteralStringSingle"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="\\.">
        <token type="LiteralStringEscape"/>
      </rule>
      <rule pattern="[^&#39;\\]+">
        <token type="LiteralStringSingle"/>
      </rule>
    </state>
  </rules>
</lexer>
