{
  "name": "fts-language",
  "displayName": "FTS Language",
  "description": "Syntax highlighting for FTS (.fts) - the categorical/natural-language modelling language used by the Digitable courses.",
  "version": "0.1.0",
  "publisher": "digitable",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "fts",
        "aliases": ["FTS", "fts"],
        "extensions": [".fts"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fts",
        "scopeName": "source.fts",
        "path": "./syntaxes/fts.tmLanguage.json"
      }
    ]
  }
}
