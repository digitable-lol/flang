{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FTS",
  "scopeName": "source.fts",
  "fileTypes": ["fts"],
  "patterns": [{ "include": "#main" }],
  "repository": {
    "main": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#module-lines" },
        { "include": "#mapping-arrows" },
        { "include": "#declaration-header" },
        { "include": "#comparison-operator" },
        { "include": "#field-modality" },
        { "include": "#clause-keywords" },
        { "include": "#operand-keywords" },
        { "include": "#legacy-keywords" },
        { "include": "#arrow" },
        { "include": "#legacy-brace-body" },
        { "include": "#values" },
        { "include": "#names" }
      ]
    },

    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.fts", "match": "//.*$" },
        { "name": "comment.block.fts", "begin": "/\\*", "end": "\\*/" }
      ]
    },

    "names": {
      "patterns": [
        { "include": "#quoted-names" },
        { "name": "variable.other.fts", "match": "[\\p{L}_$][\\p{L}\\p{N}_$\\u200C\\u200D-]*" }
      ]
    },

    "quoted-names": {
      "patterns": [
        { "name": "string.quoted.guillemet.fts", "begin": "«", "end": "»" },
        {
          "name": "string.quoted.double.fts",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.fts", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.fts",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.fts", "match": "\\\\." }]
        }
      ]
    },

    "values": {
      "patterns": [
        { "include": "#quoted-names" },
        { "name": "constant.language.boolean.fts", "match": "\\b(да|нет|true|false)\\b" },
        { "name": "constant.language.null.fts", "match": "\\b(ничто|null)\\b" },
        {
          "name": "constant.numeric.fts",
          "match": "-?\\b(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },

    "builtin-type": {
      "name": "support.type.builtin.fts",
      "match": "\\b(строкой|текстом|числом|датой|деньгами|признаком|строку|число|дату|деньги|признак|string|number|date|money|boolean)\\b"
    },

    "module-lines": {
      "patterns": [
        { "name": "keyword.control.module.fts", "match": "\\b(модуль|module)\\b" },
        { "name": "keyword.control.import.fts", "match": "\\b(использует|uses)\\b" },
        { "name": "keyword.control.export.fts", "match": "\\b(экспортирует|exports)\\b" }
      ]
    },

    "mapping-arrows": {
      "patterns": [
        {
          "name": "keyword.operator.mapsto.fts",
          "match": "\\b(отображается в поле|maps to field|отображается в морфизм|maps to morphism|отображается в|maps to)\\b"
        }
      ]
    },

    "declaration-header": {
      "name": "keyword.control.declaration.fts",
      "match": "\\b(вложен объект|вложена структура|nested object|nested structure|объект|структура|object|structure|морфизм|morphism|теорема|theorem|утилита|utility|правило|rule|свойство|property|пример|example|функтор|functor|категория|category)\\b"
    },

    "field-modality": {
      "patterns": [
        { "name": "keyword.other.modality.fts", "match": "\\b(иногда является|является|may be|is)\\b" },
        { "name": "keyword.other.state.fts", "match": "\\b(состоянием|state)\\b" },
        { "include": "#builtin-type" }
      ]
    },

    "clause-keywords": {
      "patterns": [
        {
          "name": "keyword.control.clause.fts",
          "match": "\\b(затем по морфизму|затем применить морфизм|по морфизму|применить морфизм|следовательно|получаем|then by morphism|then apply morphism|by morphism|apply morphism|therefore)\\b"
        },
        {
          "name": "keyword.control.clause.fts",
          "match": "\\b(в данных|найти где|дано|имеет|равное|in data|find where|given|has|equal to)\\b"
        },
        {
          "name": "keyword.control.clause.fts",
          "match": "\\b(то добавить|то результат|то|если|и|из|в|по закону|then add|then result|then|if|and|from|to|under law)\\b"
        },
        {
          "name": "keyword.control.clause.fts",
          "match": "\\b(принимает|возвращает|начинает с|ожидается|accepts|returns|starts with|expected)\\b"
        }
      ]
    },

    "comparison-operator": {
      "name": "keyword.operator.comparison.fts",
      "match": "\\b(не меньше|не больше|не равен|не равна|не равно|равен|равна|равно|больше|меньше|is at least|is at most|is not equal to|equals|is greater than|is less than)\\b"
    },

    "operand-keywords": {
      "name": "keyword.other.operand.fts",
      "match": "\\b(процентов от поля|процента от поля|процент от поля|percent of field|percents of field|поле|field|результат|result)\\b"
    },

    "legacy-keywords": {
      "name": "keyword.control.fts",
      "match": "\\b(proposition|утверждение|witness|свидетельство|apply|применить|compose|композиция|selector|селектор|value|значение|path|путь|detail|описание|functors|функторы|arg|аргумент)\\b"
    },

    "arrow": {
      "name": "keyword.operator.arrow.fts",
      "match": "->|=>"
    },

    "legacy-brace-body": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.block.begin.fts" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.block.end.fts" } },
      "name": "meta.block.fts",
      "patterns": [
        { "include": "#comments" },
        { "include": "#declaration-header" },
        { "include": "#legacy-keywords" },
        { "include": "#arrow" },
        { "include": "#values" },
        { "include": "#legacy-brace-body" },
        {
          "name": "variable.other.property.fts",
          "match": "[\\p{L}_$][\\p{L}\\p{N}_$\\u200C\\u200D-]*(?=\\s*[:?])"
        },
        { "name": "punctuation.section.array.fts", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.fts", "match": "[,:;]" },
        { "include": "#names" }
      ]
    }
  }
}
