модуль «ECDSA signature»
  использует «ECDSA» из "../../flang/stdlib/ecdsa.flang"

тотальная функция «Ключ»
  возвращает список числа
  обеспечивает «шестьдесят четыре байта: X и Y» (длина результат) равен 64
  пример «открытый ключ P-256 из podpis: 010ea945…d0466c — тридцать два октета X, потом тридцать два Y»
    ожидается [1, 14, 169, 69, 162, 189, 253, 130, 93, 82, 25, 145, 125, 113, 48, 177, 204, 95, 188, 68, 157, 178, 243, 196, 22, 190, 4, 15, 236, 0, 35, 174, 127, 118, 127, 166, 222, 126, 166, 222, 11, 97, 94, 34, 229, 144, 224, 17, 253, 110, 62, 23, 165, 126, 19, 157, 62, 58, 79, 112, 225, 208, 70, 108]
  [1, 14, 169, 69, 162, 189, 253, 130, 93, 82, 25, 145, 125, 113, 48, 177, 204, 95, 188, 68, 157, 178, 243, 196, 22, 190, 4, 15, 236, 0, 35, 174, 127, 118, 127, 166, 222, 126, 166, 222, 11, 97, 94, 34, 229, 144, 224, 17, 253, 110, 62, 23, 165, 126, 19, 157, 62, 58, 79, 112, 225, 208, 70, 108]

тотальная функция «Подпись»
  возвращает список числа
  обеспечивает «семьдесят один октет DER» (длина результат) равен 71
  пример «DER подписи openssl: 3045022100…dce49c28 — две метки INTEGER в семидесяти одном октете»
    ожидается [48, 69, 2, 33, 0, 178, 100, 127, 120, 30, 39, 122, 206, 207, 210, 175, 67, 138, 219, 107, 118, 50, 146, 127, 9, 135, 215, 196, 80, 118, 7, 134, 111, 110, 24, 143, 104, 2, 32, 6, 178, 124, 2, 226, 206, 82, 238, 110, 180, 152, 115, 16, 60, 134, 125, 199, 170, 8, 79, 50, 82, 137, 206, 110, 64, 3, 32, 220, 228, 156, 40]
  [48, 69, 2, 33, 0, 178, 100, 127, 120, 30, 39, 122, 206, 207, 210, 175, 67, 138, 219, 107, 118, 50, 146, 127, 9, 135, 215, 196, 80, 118, 7, 134, 111, 110, 24, 143, 104, 2, 32, 6, 178, 124, 2, 226, 206, 82, 238, 110, 180, 152, 115, 16, 60, 134, 125, 199, 170, 8, 79, 50, 82, 137, 206, 110, 64, 3, 32, 220, 228, 156, 40]

тотальная функция «Испорченная»
  возвращает список числа
  обеспечивает «семьдесят один октет DER» (длина результат) равен 71
  пример «та же DER, двадцать шестой октет 27 стал 26 шестнадцатеричным»
    ожидается [48, 69, 2, 33, 0, 178, 100, 127, 120, 30, 38, 122, 206, 207, 210, 175, 67, 138, 219, 107, 118, 50, 146, 127, 9, 135, 215, 196, 80, 118, 7, 134, 111, 110, 24, 143, 104, 2, 32, 6, 178, 124, 2, 226, 206, 82, 238, 110, 180, 152, 115, 16, 60, 134, 125, 199, 170, 8, 79, 50, 82, 137, 206, 110, 64, 3, 32, 220, 228, 156, 40]
  [48, 69, 2, 33, 0, 178, 100, 127, 120, 30, 38, 122, 206, 207, 210, 175, 67, 138, 219, 107, 118, 50, 146, 127, 9, 135, 215, 196, 80, 118, 7, 134, 111, 110, 24, 143, 104, 2, 32, 6, 178, 124, 2, 226, 206, 82, 238, 110, 180, 152, 115, 16, 60, 134, 125, 199, 170, 8, 79, 50, 82, 137, 206, 110, 64, 3, 32, 220, 228, 156, 40]

тотальная функция «Сообщение»
  возвращает список числа
  обеспечивает «двадцать пять байтов» (длина результат) равен 25
  пример «UTF-8 слова проба подписи: d0bfd180d0bed0b1d0b020d0bfd0bed0b4d0bfd0b8d181d0b8»
    ожидается [208, 191, 209, 128, 208, 190, 208, 177, 208, 176, 32, 208, 191, 208, 190, 208, 180, 208, 191, 208, 184, 209, 129, 208, 184]
  [208, 191, 209, 128, 208, 190, 208, 177, 208, 176, 32, 208, 191, 208, 190, 208, 180, 208, 191, 208, 184, 209, 129, 208, 184]

тотальная функция «Свод сообщения»
  возвращает список числа
  обеспечивает «тридцать два байта» (длина результат) равен 32
  пример «то же, что печатает sha256sum: 70671ea7a55026258ab5a6610e46868f80ed85c8e3bc98fcdd780a0fb0e0aabb»
    ожидается [112, 103, 30, 167, 165, 80, 38, 37, 138, 181, 166, 97, 14, 70, 134, 143, 128, 237, 133, 200, 227, 188, 152, 252, 221, 120, 10, 15, 176, 224, 170, 187]
  [112, 103, 30, 167, 165, 80, 38, 37, 138, 181, 166, 97, 14, 70, 134, 143, 128, 237, 133, 200, 227, 188, 152, 252, 221, 120, 10, 15, 176, 224, 170, 187]

тотальная функция «Отчёт о верной»
  возвращает строка
  соединить ["сообщение, байтов UTF-8: ", (к строке (длина («Сообщение»))), "\nбайтов свода SHA-256: ", (к строке (длина («Свод сообщения»))), "\nоктетов DER в подписи: ", (к строке (длина («Подпись»))), "\nобразующая лежит на кривой: ", (если («Образующая на кривой») то "да" иначе "нет"), "\nоткрытый ключ лежит на кривой: ", (если («Точка на кривой» от («Точка ключа» от («Ключ»))) то "да" иначе "нет"), "\nподпись openssl: ", («Слово о подписи» от («Ключ») и («Подпись») и («Свод сообщения»))] по ""

тотальная функция «Отчёт об испорченной»
  возвращает строка
  соединить ["сообщение, байтов UTF-8: ", (к строке (длина («Сообщение»))), "\nбайтов свода SHA-256: ", (к строке (длина («Свод сообщения»))), "\nоктетов DER в подписи: ", (к строке (длина («Испорченная»))), "\nподпись с испорченным октетом: ", («Слово о подписи» от («Ключ») и («Испорченная») и («Свод сообщения»))] по ""
