модуль «Signature»
  использует «RSA signature» из "../../flang/stdlib/rsa.flang"
  использует «SHA-256» из "../../flang/stdlib/sha256.flang"

// ПОДПИСЬ RSA, ПРОВЕРЕННАЯ СВОИМИ РУКАМИ. Программа берёт НАСТОЯЩУЮ подпись
// настоящего ключа RSA-2048, возводит её в открытую степень по модулю в 2048
// бит — своей длинной арифметикой, своим Монтгомери — и сверяет, что вышло, с
// набивкой PKCS#1 v1.5 вокруг SHA-256, посчитанного здесь же, тоже своего.
//
// Ключ и подпись сделаны openssl рядом с этими файлами:
//   openssl genrsa -out kluch.pem 2048
//   openssl rsa -in kluch.pem -pubout -out signature-public-key.pem
//   printf 'проба подписи' > signature-message.txt
//   openssl dgst -sha256 -sign kluch.pem -out signature.bin signature-message.txt
//   openssl dgst -sha256 -verify signature-public-key.pem -signature signature.bin \
//           signature-message.txt          # Verified OK
// Закрытый ключ в дерево НЕ положен и положен не будет; открытый — рядом, и по
// нему openssl повторит проверку сам, независимо от этой программы.
//
// Модуль и подпись приезжают сюда шестнадцатеричным текстом, потому что план
// читает файл как ТЕКСТ, а подпись — 256 сырых байтов, среди которых нет ни
// одной годной строки UTF-8. Тексты сделаны так:
//   openssl rsa -pubin -in signature-public-key.pem -modulus -noout \
//     | sed 's/^Modulus=//' | tr -d '\n' > signature-modulus.hex
//   xxd -p -c 100000 signature.bin | tr -d '\n'  > signature-valid.hex
//   xxd -p -c 100000 signature-message.txt | tr -d '\n' > signature-message.hex
// Само подписанное сообщение приезжает тем же путём и по той же причине: план
// читает файл как текст, а сверять надо БАЙТЫ, ровно те, что подписал openssl,
// а не то, во что они превратятся после переправы через строку и обратно.
// Испорченная подпись — та же самая, у которой в сто первом байте перевёрнут
// один бит: signature-corrupted.hex. openssl на ней говорит
// «Verification failure», и эта программа обязана сказать «подпись НЕ верна».
// Проверка, которая всегда говорит «верна», хуже отсутствующей.
//
// Прогон из корня дерева:
//   bootstrap/flang io examples/crypto/signature.flang --max-steps 1000000000
// ★ КЛЮЧ «--max-steps» ОБЯЗАТЕЛЕН: два возведения в степень по модулю в 2048
// бит стоят сотни миллионов витков вычислителя, а умолчание — десять миллионов.

тип «Ход»
  вариант «Начало»
  вариант «Ждём ключ»
  вариант «Ждём верную» содержит ключ: строка
  вариант «Ждём порченую» содержит ключ: строка, верная: строка
  вариант «Ждём сообщение» содержит ключ: строка, верная: строка, порченая: строка

тотальная функция «Начало хода»
  возвращает «Ход»
  пример «план начинается с чтения открытого ключа»
    ожидается вариант «Начало»
  вариант «Начало»

тотальная функция «Показатель»
  возвращает число
  пример «открытый показатель этого ключа — 65537»
    ожидается 65537
  65537

// Свод SHA-256 — восемь тридцатидвухбитных слов; PKCS#1 просит их байтами,
// старшим вперёд. «SHA-256» такой печати не даёт (она живёт в «HMAC», а брать
// сюда весь HMAC ради четырёх строк незачем), поэтому она здесь.
тотальная функция «Байты слова»
  принимает слово: число
  возвращает список числа
  обеспечивает «слово — четыре байта» (длина результат) равен 4
  пример «Единица»
    дано слово равно 1
    ожидается [0, 0, 0, 1]
  пример «Все единицы»
    дано слово равно 4294967295
    ожидается [255, 255, 255, 255]
  [((слово минус (слово остаток от 16777216)) делить на 16777216), (((слово остаток от 16777216) минус (слово остаток от 65536)) делить на 65536), (((слово остаток от 65536) минус (слово остаток от 256)) делить на 256), (слово остаток от 256)]

тотальная функция «Байты хеша»
  принимает свод: «Свод sha256»
  возвращает список числа
  обеспечивает «хеш — тридцать два байта» (длина результат) равен 32
  «Приписать список» от («Байты слова» от свод.н0) и («Приписать список» от («Байты слова» от свод.н1) и («Приписать список» от («Байты слова» от свод.н2) и («Приписать список» от («Байты слова» от свод.н3) и («Приписать список» от («Байты слова» от свод.н4) и («Приписать список» от («Байты слова» от свод.н5) и («Приписать список» от («Байты слова» от свод.н6) и («Байты слова» от свод.н7)))))))

тотальная функция «Печать байтов»
  принимает байты: список числа
  возвращает строка
  пример «Два байта»
    дано байты равно [0, 255]
    ожидается "00ff"
  свёртка байты начиная с "" как акк и б → соединить акк с (соединить («Цифра 16» от ((б минус (б остаток от 16)) делить на 16)) с («Цифра 16» от (б остаток от 16)))

тотальная функция «Приговор»
  принимает верна: признак
  возвращает строка
  пример «Верна»
    дано верна равно да
    ожидается "подпись верна"
  пример «Не верна»
    дано верна равно нет
    ожидается "подпись НЕ верна"
  если верна то "подпись верна" иначе "подпись НЕ верна"

// Один разбор одной подписи: что вышло из возведения в степень, что ожидалось,
// и приговор. Печатаются обе набивки целиком — чтобы «не сошлось» можно было
// посмотреть глазами, а не принимать на слово.
тотальная функция «Отчёт о подписи»
  принимает имя: строка, подпись: список числа, ключ: список числа, хеш: список числа
  возвращает строка
  пусть вышло равно «Восстановленная набивка» от подпись и ключ и («Показатель»)
  пусть ждали равно «Ожидаемая набивка» от хеш и (длина ключ)
  соединить [
    "\n── ", имя, " ──",
    "\n  байтов в подписи: ", (к строке (длина подпись)),
    "\n  вышло из степени: ", («Печать байтов» от вышло),
    "\n  ожидалось по PKCS#1: ", («Печать байтов» от ждали),
    "\n  ", («Приговор» от («Подпись верна» от подпись и ключ и («Показатель») и хеш))] по ""

тотальная функция «Отчёт»
  принимает ключ: строка, верная: строка, порченая: строка, сообщение: строка
  возвращает строка
  пусть модульбайтами равно «Байты из шестнадцатеричного» от ключ
  пусть байтысообщения равно «Байты из шестнадцатеричного» от сообщение
  пусть свод равно «Свод байтов» от байтысообщения
  пусть хеш равно «Байты хеша» от свод
  соединить [
    "сообщение байтами: ", сообщение,
    "\nбайтов в сообщении: ", (к строке (длина байтысообщения)),
    "\nSHA-256 сообщения: ", («Свод шестнадцатеричным» от свод),
    "\nбайтов в модуле: ", (к строке (длина модульбайтами)),
    "\nоткрытый показатель: ", (к строке («Показатель»)),
    («Отчёт о подписи» от "подпись openssl, как есть" и («Байты из шестнадцатеричного» от верная) и модульбайтами и хеш),
    («Отчёт о подписи» от "она же с одним перевёрнутым битом" и («Байты из шестнадцатеричного» от порченая) и модульбайтами и хеш)] по ""

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  пример «первым делом читается модуль открытого ключа»
    дано ход равно вариант «Начало»
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "signature-modulus.hex") и потом равным (вариант «Ждём ключ»)
  разбор ход
    случай вариант «Начало»
      то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "signature-modulus.hex") и потом равным (вариант «Ждём ключ»)
    случай вариант «Ждём ключ»
      разбор отклик
        случай вариант «Прочитано» с содержимое как текст
          то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "signature-valid.hex") и потом равным (вариант «Ждём верную» с ключ равным текст)
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным код и сообщение равным сообщение
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали модуля открытого ключа"
    случай вариант «Ждём верную» с ключ как ключ
      разбор отклик
        случай вариант «Прочитано» с содержимое как текст
          то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "signature-corrupted.hex") и потом равным (вариант «Ждём порченую» с ключ равным ключ и верная равным текст)
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным код и сообщение равным сообщение
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали верной подписи"
    случай вариант «Ждём порченую» с ключ как ключ и верная как верная
      разбор отклик
        случай вариант «Прочитано» с содержимое как текст
          то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "signature-message.hex") и потом равным (вариант «Ждём сообщение» с ключ равным ключ и верная равным верная и порченая равным текст)
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным код и сообщение равным сообщение
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали испорченной подписи"
    случай вариант «Ждём сообщение» с ключ как ключ и верная как верная и порченая как порченая
      разбор отклик
        случай вариант «Прочитано» с содержимое как текст
          то вариант «Конец работы» с значение равным («Отчёт» от ключ и верная и порченая и текст)
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным код и сообщение равным сообщение
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали подписанного сообщения"

план «Проверить подпись RSA»
  состояние «Ход»
  начинает с «Начало хода»
  обрабатывает «Дальше»
