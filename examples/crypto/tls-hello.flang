// openssl печатает версию записи шестнадцатеричным БЕЗ ведущего нуля: «0x301»,
// а не «0x0301». Здесь то же самое, и только для того, чтобы строки можно было
// сличать глазом, а не пересказывать.
тотальная функция «Версия по-openssl»
  принимает версия: число
  возвращает строка
  обеспечивает «печать версии не пустая» (длина результат) больше 0
  пример «769 печатается как 301»
    дано версия равно 769
    ожидается "301"
  пример «771 печатается как 303»
    дано версия равно 771
    ожидается "303"
  если («Делить нацело» от версия и 4096) равен 0
    то соединить («Знак шестнадцати» от («Делить нацело» от версия и 256)) с («Октет заглавными» от (версия остаток от 256))
    иначе соединить («Октет заглавными» от («Делить нацело» от версия и 256)) с («Октет заглавными» от (версия остаток от 256))

тотальная функция «Сжатие словом»
  принимает код: число
  возвращает строка
  обеспечивает «имя не пустое» (длина результат) больше 0
  пример «Ноль — единственный способ, оставленный TLS 1.3»
    дано код равно 0
    ожидается "No Compression (0x00)"
  пример «Чужой код печатается числом»
    дано код равно 1
    ожидается "(0x01)"
  если код равен 0 то "No Compression (0x00)" иначе (соединить ["(0x", («Октет заглавными» от код), ")"] по "")

тотальная функция «Да или нет»
  принимает признак: признак
  возвращает строка
  обеспечивает «ответ — одно из двух слов» (результат равен "да") или (результат равен "нет")
  пример «Истина»
    дано признак равно да
    ожидается "да"
  пример «Ложь»
    дано признак равно нет
    ожидается "нет"
  если признак то "да" иначе "нет"

// Заголовок записи, ПЕРЕСОБРАННЫЙ из разобранных полей. Сборка проверяется тем
// же, чем проверяют пересборку: собранное сличается с пришедшим.
тотальная функция «Пересобранный заголовок»
  принимает октеты: список числа
  возвращает строка
  обеспечивает «пять октетов — десять знаков» (длина результат) равен 10
  пример «Заголовок записи рукопожатия TLS 1.0 длиной 221»
    дано октеты равно [22, 3, 1, 0, 221, 1]
    ожидается "16030100DD"
  «Октеты заглавными» от («Заголовок записи» от («Тип записи» от октеты) и («Версия записи» от октеты) и («Длина записи» от октеты))

тотальная функция «Заголовок совпал»
  принимает октеты: список числа
  возвращает признак
  пример «Пересобранный заголовок равен пришедшему»
    дано октеты равно [22, 3, 1, 0, 221, 1]
    ожидается да
  («Пересобранный заголовок» от октеты) равен («Октеты заглавными» от («Кусок» от октеты и 1 и 5))

тотальная функция «Общая часть привета»
  принимает тело: список числа
  возвращает строка
  обеспечивает «печать общей части не пустая» (длина результат) больше 0
  пример «Пустое тело печатает пустые поля, а не падает»
    дано тело равно пустой список
    ожидается "\n      Random:\n        gmt_unix_time=0x\n        random_bytes (len=0): \n      session_id (len=0): "
  соединить [
    "\n      Random:",
    "\n        gmt_unix_time=0x", («Октеты заглавными» от («Кусок» от тело и 7 и 10)),
    "\n        random_bytes (len=", (к строке (длина («Случайные октеты» от тело))), "): ", («Октеты заглавными» от («Случайные октеты» от тело)),
    "\n      session_id (len=", (к строке («Длина сессии» от тело)), "): ", («Октеты заглавными» от («Идентификатор сессии» от тело))] по ""

тотальная функция «Заголовок записи по-openssl»
  принимает октеты: список числа, откуда: строка
  возвращает строка
  обеспечивает «печать заголовка длиннее слова, с которого начинается» (длина результат) больше (длина откуда)
  пример «Пустой вход печатает нули, а не падает»
    дано октеты равно пустой список
    дано откуда равно "Sent"
    ожидается "Sent TLS Record\nHeader:\n  Version = неизвестная версия (0x000)\n  Content Type = неизвестный тип (0)\n  Length = 0"
  соединить [
    откуда, " TLS Record\nHeader:",
    "\n  Version = ", («Версия словом» от («Версия записи» от октеты)), " (0x", («Версия по-openssl» от («Версия записи» от октеты)), ")",
    "\n  Content Type = ", («Имя типа записи» от («Тип записи» от октеты)), " (", (к строке («Тип записи» от октеты)), ")",
    "\n  Length = ", (к строке («Длина записи» от октеты))] по ""

тотальная функция «Отчёт о клиенте»
  принимает октеты: список числа
  возвращает строка
  обеспечивает «отчёт не пустой» (длина результат) больше 0
  пусть тело равно («Тело записи» от октеты)
  пусть расширения равно («Расширения клиента» от тело)
  соединить [
    («Заголовок записи по-openssl» от октеты и "Sent"),
    "\n    ", («Имя типа рукопожатия» от («Тип рукопожатия» от тело)), ", Length=", (к строке («Длина рукопожатия» от тело)),
    "\n      client_version=0x", («Версия по-openssl» от («Версия привета» от тело)), " (", («Версия словом» от («Версия привета» от тело)), ")",
    («Общая часть привета» от тело),
    "\n      cipher_suites (len=", (к строке («Длина наборов» от тело)), ")",
    («Печать наборов» от («Пары октетов» от («Наборы шифров» от тело))),
    "\n      compression_methods (len=", (к строке («Длина сжатия» от тело)), ")",
    "\n      extensions, length = ", (к строке («Длина расширений клиента» от тело)),
    («Печать расширений» от расширения),
    "\nразобрано расширений: ", (к строке («Сколько расширений» от расширения)),
    "\nсвои поля, которых openssl не печатает отдельной строкой:",
    "\n  supported_versions клиента:", («Печать версий» от («Версии клиента» от расширения)),
    "\n  key_share клиента: ", («Группа словом» от («Группа клиента» от расширения)), " (", (к строке («Группа клиента» от расширения)), ")",
    "\n  key_exchange (len=", (к строке (длина («Ключ клиента» от расширения))), "): ", («Октеты заглавными» от («Ключ клиента» от расширения)),
    "\n  запись целая: ", («Да или нет» от («Запись целая» от октеты)),
    "\n  заголовок пересобран: ", («Пересобранный заголовок» от октеты), " — совпал с пришедшим: ", («Да или нет» от («Заголовок совпал» от октеты))] по ""

тотальная функция «Отчёт о сервере»
  принимает октеты: список числа
  возвращает строка
  обеспечивает «отчёт не пустой» (длина результат) больше 0
  пусть тело равно («Тело записи» от октеты)
  пусть расширения равно («Расширения сервера» от тело)
  соединить [
    («Заголовок записи по-openssl» от октеты и "Received"),
    "\n    ", («Имя типа рукопожатия» от («Тип рукопожатия» от тело)), ", Length=", (к строке («Длина рукопожатия» от тело)),
    "\n      server_version=0x", («Версия по-openssl» от («Версия привета» от тело)), " (", («Версия словом» от («Версия привета» от тело)), ")",
    («Общая часть привета» от тело),
    "\n      cipher_suite {0x", («Октет заглавными» от («Делить нацело» от («Набор сервера» от тело) и 256)), ", 0x", («Октет заглавными» от ((«Набор сервера» от тело) остаток от 256)), "} ", («Набор словом» от («Набор сервера» от тело)),
    "\n      compression_method: ", («Сжатие словом» от («Сжатие сервера» от тело)),
    "\n      extensions, length = ", (к строке («Длина расширений сервера» от тело)),
    («Печать расширений» от расширения),
    "\nразобрано расширений: ", (к строке («Сколько расширений» от расширения)),
    "\nсвои поля, которых openssl не печатает отдельной строкой:",
    "\n  supported_versions сервера: ", («Версия словом» от («Версия сервера» от расширения)), " (", (к строке («Версия сервера» от расширения)), ")",
    "\n  key_share сервера: ", («Группа словом» от («Группа сервера» от расширения)), " (", (к строке («Группа сервера» от расширения)), ")",
    "\n  key_exchange (len=", (к строке (длина («Ключ сервера» от расширения))), "): ", («Октеты заглавными» от («Ключ сервера» от расширения)),
    "\n  запись целая: ", («Да или нет» от («Запись целая» от октеты)),
    "\n  заголовок пересобран: ", («Пересобранный заголовок» от октеты), " — совпал с пришедшим: ", («Да или нет» от («Заголовок совпал» от октеты))] по ""

тотальная функция «Отчёт»
  возвращает строка
  обеспечивает «отчёт длиннее каждой из двух своих половин» ((длина результат) больше (длина («Отчёт о клиенте» от («Запись клиента»)))) и притом ((длина результат) больше (длина («Отчёт о сервере» от («Запись сервера»))))
  соединить [(«Отчёт о клиенте» от («Запись клиента»)), "\n\n", («Отчёт о сервере» от («Запись сервера»))] по ""

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Начало»
      то вариант «Конец работы» с значение равным («Отчёт»)

план «Разобрать привет TLS»
  состояние «Ход»
  начинает с «Начало хода»
  обрабатывает «Дальше»
