category КредитнаяПолитика {
  structure ЗаявкаНаЛимит {
    номер: string
    клиент: string
    сумма: Money
    скорингПройден: СкорингПройден
    решениеРисков: РискиОдобрили
  }

  functor скорингОткрываетРискПроверку: СкорингПройден -> РискПроверкаРазрешена
  functor рискПроверкаРазрешаетЛимит: РискПроверкаРазрешена -> ЛимитМожетБытьУстановлен

  proposition compose {
    functors: ["скорингОткрываетРискПроверку", "рискПроверкаРазрешаетЛимит"]
    witness ЗаявкаНаЛимит.скорингПройден {
      value true
      path ["заявки", { номер: "ЛМ-205" }, "скорингПройден"]
      detail "Цепочка политики выдачи кредитного лимита"
    }
  }
}
