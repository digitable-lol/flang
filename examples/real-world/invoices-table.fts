category ДебиторскаяЗадолженность {
  structure СтрокаСчёта {
    номер: string
    контрагент: string
    сумма: Money
    валюта: Валюта
    срокОплаты: Date
    просрочен: Просрочен
  }

  functor просрочкаТребуетКонтроля: Просрочен -> ТребуетсяКонтроль

  proposition apply просрочкаТребуетКонтроля {
    witness СтрокаСчёта.просрочен {
      value true
      path ["счета", { номер: "СЧ-2026-0087" }, "просрочен"]
      detail "Срок оплаты прошёл, счёт включается в очередь контроля"
    }
  }
}
