module «Ackermann function»

function «Ackermann»
  accepts m: number, n: number
  returns number
  ensures «at m zero Ackermann just adds one» if m equals 0 then (result equals (n plus 1)) else true
  ensures «at n zero the step goes with one» if not (m equals 0) then (if n equals 0 then (result equals («Ackermann» of (m minus 1) and 1)) else true) else true
  example «A(0, 0) = 1»
    given m equals 0
    given n equals 0
    expected 1
  example «A(0, 4) = 5 — the bottom row simply adds one»
    given m equals 0
    given n equals 4
    expected 5
  example «A(1, 1) = 3»
    given m equals 1
    given n equals 1
    expected 3
  example «A(1, 5) = 7 — the first row is n + 2»
    given m equals 1
    given n equals 5
    expected 7
  example «A(2, 2) = 7»
    given m equals 2
    given n equals 2
    expected 7
  example «A(2, 4) = 11 — the second row is 2n + 3»
    given m equals 2
    given n equals 4
    expected 11
  example «A(3, 3) = 61 — the third row is a power of two less three»
    given m equals 3
    given n equals 3
    expected 61
  example «A(3, 5) = 253»
    given m equals 3
    given n equals 5
    expected 253
  if m equals 0
    then n plus 1
    else
      if n equals 0
        then «Ackermann» of (m minus 1) and 1
        else «Ackermann» of (m minus 1) and («Ackermann» of m and (n minus 1))

total function «Ackermann in closed form»
  accepts m: number, n: number
  returns number
  example «Row zero»
    given m equals 0
    given n equals 4
    expected 5
  example «Row one»
    given m equals 1
    given n equals 5
    expected 7
  example «Row two»
    given m equals 2
    given n equals 4
    expected 11
  example «Beyond the first three rows — zero, there is nothing to compute with»
    given m equals 3
    given n equals 3
    expected 0
  if m equals 0
    then n plus 1
    else
      if m equals 1
        then n plus 2
        else
          if m equals 2 then (2 times n) plus 3 else 0

function «The two forms agree»
  accepts m: number, n: number
  returns boolean
  example «Row zero»
    given m equals 0
    given n equals 4
    expected true
  example «Row one»
    given m equals 1
    given n equals 5
    expected true
  example «Row two»
    given m equals 2
    given n equals 6
    expected true
  («Ackermann» of m and n) equals («Ackermann in closed form» of m and n)
