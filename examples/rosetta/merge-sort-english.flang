module «Merge sort»

total function «Prepend»
  accepts element: number, items: list of number
  returns list of number
  example «Into a non-empty list»
    given element equals 1
    given items equals [2, 3]
    expected [1, 2, 3]
  fold items starting with [element] as acc and elem → add elem to acc

total function «Concatenate lists»
  accepts left: list of number, right: list of number
  returns list of number
  example «Two non-empty lists»
    given left equals [1, 2]
    given right equals [3]
    expected [1, 2, 3]
  fold right starting with left as acc and elem → add elem to acc

total function «Take first»
  accepts items: list of number, count: number
  returns list of number
  ensures «taking none gives the empty list» if count is at most 0 then (result equals empty list) else true
  example «Take two»
    given items equals [1, 2, 3, 4]
    given count equals 2
    expected [1, 2]
  match items
    case empty
      then empty list
    case head and tail
      if count is at most 0
        then empty list
        else «Prepend» of head and («Take first» of tail and (count minus 1))

total function «Drop first»
  accepts items: list of number, count: number
  returns list of number
  example «Drop two»
    given items equals [1, 2, 3, 4]
    given count equals 2
    expected [3, 4]
  match items
    case empty
      then empty list
    case head and tail
      if count is at most 0
        then items
        else «Drop first» of tail and (count minus 1)

total function «Merge with fuel»
  accepts fuel: list of number, left: list of number, right: list of number
  returns list of number
  example «The fuel suffices»
    given fuel equals [0, 0, 0, 0]
    given left equals [1, 3]
    given right equals [2, 4]
    expected [1, 2, 3, 4]
  match fuel
    case empty
      then «Concatenate lists» of left and right
    case head f and tail rf
      match left
        case empty
          then right
        case head hl and tail tl
          match right
            case empty
              then left
            case head hr and tail tr
              if hl is at most hr
                then «Prepend» of hl and («Merge with fuel» of rf and tl and right)
                else «Prepend» of hr and («Merge with fuel» of rf and left and tr)

total function «Merge»
  accepts left: list of number, right: list of number
  returns list of number
  example «Two sorted lists»
    given left equals [1, 3, 5]
    given right equals [2, 4, 6]
    expected [1, 2, 3, 4, 5, 6]
  example «One of them is empty»
    given left equals empty list
    given right equals [2, 4]
    expected [2, 4]
  «Merge with fuel» of («Concatenate lists» of left and right) and left and right

total function «Merge sort with fuel»
  accepts fuel: list of number, items: list of number
  returns list of number
  example «The fuel suffices»
    given fuel equals [0, 0, 0, 0]
    given items equals [4, 2, 3, 1]
    expected [1, 2, 3, 4]
  match fuel
    case empty
      then items
    case head f and tail rf
      let count equals length items
      if count is at most 1
        then items
        else
          let half equals (count minus (count modulo 2)) divided by 2
          let left equals «Merge sort with fuel» of rf and («Take first» of items and half)
          let right equals «Merge sort with fuel» of rf and («Drop first» of items and half)
          «Merge» of left and right

total function «Merge sort»
  accepts items: list of number
  returns list of number
  example «A shuffled list»
    given items equals [4, 65, 2, -31, 0, 99, 2, 83, 782, 1]
    expected [-31, 0, 1, 2, 2, 4, 65, 83, 99, 782]
  example «Empty list»
    given items equals empty list
    expected empty list
  example «One item»
    given items equals [7]
    expected [7]
  example «Stable under duplicates»
    given items equals [5, 1, 5, 1, 5]
    expected [1, 1, 5, 5, 5]
  example «Already sorted»
    given items equals [1, 2, 3, 4, 5, 6, 7, 8]
    expected [1, 2, 3, 4, 5, 6, 7, 8]
  «Merge sort with fuel» of items and items
