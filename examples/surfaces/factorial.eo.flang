module «Faktorialo»

// Rosetta Code — Faktorialo, sur la ESPERANTA vortsurfaco.
//
// La sama programo kiel `examples/rosetta/factorial.flang`, vorto post
// vorto: la du sintaksarboj koincidas ĝis reciproke unusenca renomado.
//
// UNU VORTO RESTAS ANGLA, kaj tio estas decido, ne preteratento. En Esperanto
// «modulo» nomas kaj la programeron kaj la reston de divido, kaj la anglan
// «modulo» la tabelo jam donis al `resto de`. Unu vorto ne rajtas nomi du
// konstruojn, do la esperanta surfaco ĉi tie silentas kaj la dosiero uzas la
// anglan `module`. La elekto de la termino apartenas al la posedanto de la
// lingvo, ne al la tradukilo.

totala funkcio «Antaŭmeti»
  akceptas elemento: nombro, eroj: listo de nombro
  redonas listo de nombro
  ekzemplo «En malplenan»
    donite elemento egalas 1
    donite eroj egalas malplena listo
    atendata [1]
  faldo eroj komencante per [elemento] kiel akumulo kaj elem → aldoni elem al akumulo

totala funkcio «Produto»
  akceptas eroj: listo de nombro
  redonas nombro
  ekzemplo «Produto de kvar»
    donite eroj egalas [1, 2, 3, 4]
    atendata 24
  ekzemplo «Produto de malplena estas unu»
    donite eroj egalas malplena listo
    atendata 1
  faldo eroj komencante per 1 kiel akumulo kaj elem → akumulo fojoj elem

// ─────────────────────────────────────────────────────────────────────────
// Sube — ordinaraj funkcioj: rekursio laŭ nombro.
// ─────────────────────────────────────────────────────────────────────────

funkcio «Nombroj de kaj ĝis»
  akceptas komenco: nombro, fino: nombro
  redonas listo de nombro
  ekzemplo «De unu ĝis kvin»
    donite komenco egalas 1
    donite fino egalas 5
    atendata [1, 2, 3, 4, 5]
  ekzemplo «Malplena intervalo»
    donite komenco egalas 1
    donite fino egalas 0
    atendata malplena listo
  se komenco pli granda ol fino
    tiam malplena listo
    alie «Antaŭmeti» de komenco kaj («Nombroj de kaj ĝis» de (komenco plus 1) kaj fino)

funkcio «Faktorialo per produto»
  akceptas n: nombro
  redonas nombro
  ekzemplo «Kvin faktorialo»
    donite n egalas 5
    atendata 120
  ekzemplo «Nul faktorialo»
    donite n egalas 0
    atendata 1
  «Produto» de («Nombroj de kaj ĝis» de 1 kaj n)

totala funkcio «Faktorialo»
  akceptas n: naturo
  redonas nombro
  ekzemplo «Kvin faktorialo»
    donite n egalas 5
    atendata 120
  ekzemplo «Dek faktorialo»
    donite n egalas 10
    atendata 3628800
  ekzemplo «Nul faktorialo»
    donite n egalas 0
    atendata 1
  ekzemplo «Dudek faktorialo ankoraŭ ĝustas en double»
    donite n egalas 20
    atendata 2432902008176640000
  se n ne pli granda ol 1
    tiam 1
    alie n fojoj («Faktorialo» de (n minus 1))
