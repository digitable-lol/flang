модуль «By cores bench»

объект «Счёт»
  «ещё»: число
  «мин»: число
  «старт»: число
  «база»: число

объект «Замер»
  «потоки»: список строки
  «стенд»: строка
  «пробегов»: строка
  «строки»: список строки
  «счёт»: «Счёт»

тип «Ход»
  вариант «Просим доводы»
  вариант «Ждём доводы»
  вариант «Ждём начало» содержит замер: «Замер»
  вариант «Ждём прогон» содержит замер: «Замер»
  вариант «Ждём конец» содержит замер: «Замер»
  вариант «Готово» содержит отчёт: строка
  вариант «Отказ» содержит код: строка, сообщение: строка
  вариант «Не мерили» содержит код: строка, сообщение: строка

тотальная функция «Начало»
  возвращает «Ход»
  пример «план начинается с просьбы о доводах»
    ожидается вариант «Просим доводы»
  вариант «Просим доводы»

тотальная функция «Повторов»
  возвращает число
  обеспечивает «повторов больше нуля» результат больше 0
  пример «минимум из трёх повторов»
    ожидается 3
  3

тотальная функция «Шапка»
  возвращает строка
  пример «четыре столбца»
    ожидается "потоков мс пробегов/с раз"
  "потоков мс пробегов/с раз"

тотальная функция «Запрос»
  принимает пробегов: строка, потоков: строка
  возвращает строка
  пример «тот же запрос, что собирала оболочка»
    дано пробегов равно "2000000"
    дано потоков равно "8"
    ожидается "{\"run\":\"стенд\",\"seed\":\"1\",\"turns\":\"2000000\",\"journal\":\"0\",\"workers\":\"8\"}"
  соединить ["{\"run\":\"стенд\",\"seed\":\"1\",\"turns\":\"", пробегов, "\",\"journal\":\"0\",\"workers\":\"", потоков,
    "\"}"] по ""

тотальная функция «Сценарий оболочки»
  возвращает строка
  пример «оболочка подаёт запрос на вход стенда и отдаёт только начало ответа»
    ожидается "echo \"$1\" | \"$0/flang_cli\" | head -c 12"
  "echo \"$1\" | \"$0/flang_cli\" | head -c 12"

тотальная функция «Поручение прогона»
  принимает замер: «Замер»
  возвращает «Поручение»
  пример «стенд зовётся через sh, потому что у хозяина нет поручения с вводом»
    дано замер равно запись «Замер» с «потоки» равным [
      "2"] и «стенд» равным "/z/b" и «пробегов» равным "5" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
    ожидается вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c",
      "echo \"$1\" | \"$0/flang_cli\" | head -c 12", "/z/b",
      "{\"run\":\"стенд\",\"seed\":\"1\",\"turns\":\"5\",\"journal\":\"0\",\"workers\":\"2\"}"]
  пусть «запрос» равно («Запрос» от (замер.«пробегов») и («Первые потоки» от (замер.«потоки»)))
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Сценарий оболочки»),
    (замер.«стенд»), «запрос»]

тотальная функция «Целое»
  принимает х: число
  возвращает число
  пример «дробь отбрасывается»
    дано х равно 7.75
    ожидается 7
  пример «целое остаётся»
    дано х равно 12
    ожидается 12
  х минус (х остаток от 1)

тотальная функция «Сотые»
  принимает х: число
  возвращает число
  пример «две цифры после точки»
    дано х равно 2.9187
    ожидается 2.91
  («Целое» от (х умножить на 100)) делить на 100

тотальная функция «Пробегов в секунду»
  принимает пробегов: число, мс: число
  возвращает число
  пример «миллион за полсекунды»
    дано пробегов равно 1000000
    дано мс равно 500
    ожидается 2000000
  пример «нулевое время не делит на ноль»
    дано пробегов равно 10
    дано мс равно 0
    ожидается 0
  если мс больше 0
    то «Целое» от ((пробегов умножить на 1000) делить на мс)
    иначе 0

тотальная функция «Во сколько раз»
  принимает база: число, мс: число
  возвращает число
  пример «вдвое быстрее»
    дано база равно 1000
    дано мс равно 500
    ожидается 2
  пример «нулевое время не делит на ноль»
    дано база равно 1000
    дано мс равно 0
    ожидается 0
  если мс больше 0
    то «Сотые» от (база делить на мс)
    иначе 0

тотальная функция «Число довода»
  принимает довод: строка
  возвращает число
  пример «число»
    дано довод равно "64"
    ожидается 64
  пример «не число даёт нуль»
    дано довод равно "много"
    ожидается 0
  разбор (к числу или беда довод)
    случай вариант «Разобрано» с значение как значение
      то значение
    случай вариант «Не разобрано» с код как код и сообщение как сообщение
      то 0

тотальная функция «Строка замера»
  принимает потоков: строка, пробегов: строка, мс: число, база: число
  возвращает строка
  пример «восемь потоков вдвое быстрее одного»
    дано потоков равно "8"
    дано пробегов равно "4000000"
    дано мс равно 1000
    дано база равно 2000
    ожидается "8 1000 4000000 2"
  соединить [потоков, (к строке мс), (к строке («Пробегов в секунду» от («Число довода» от пробегов) и мс)),
    (к строке («Во сколько раз» от база и мс))] по " "

тотальная функция «Меньшее»
  принимает лучшее: число, новое: число
  возвращает число
  пример «первое время берётся как есть»
    дано лучшее равно -1
    дано новое равно 900
    ожидается 900
  пример «из двух берётся меньшее»
    дано лучшее равно 800
    дано новое равно 900
    ожидается 800
  если (лучшее меньше 0) или (новое меньше лучшее)
    то новое
    иначе лучшее

тотальная функция «Негодные числа»
  принимает доводы: список строки
  возвращает список строки
  пример «нуль и слово негодны»
    дано доводы равно ["64", "0", "много"]
    ожидается ["0", "много"]
  отфильтровать доводы где довод → не ((«Число довода» от довод) больше 0)

тотальная функция «Прогон годен»
  принимает код: число, вывод: строка
  возвращает признак
  пример «кончился нулём и сказал ok»
    дано код равно 0
    дано вывод равно "{\"ok\":true,\"run\":\"стенд\"}"
    ожидается да
  пример «отказ стенда замером не считается»
    дано код равно 0
    дано вывод равно "{\"ok\":false}"
    ожидается нет
  (код равен 0) и притом (вывод содержит "\"ok\":true")

тотальная функция «База или»
  принимает база: число, мс: число
  возвращает число
  пример «первая точка становится базой»
    дано база равно 0
    дано мс равно 700
    ожидается 700
  пример «база не меняется»
    дано база равно 500
    дано мс равно 700
    ожидается 500
  если база больше 0
    то база
    иначе мс

тотальная функция «Первые потоки»
  принимает потоки: список строки
  возвращает строка
  пример «голова списка»
    дано потоки равно ["8", "16"]
    ожидается "8"
  пример «пустой список — пустая строка»
    дано потоки равно пустой список
    ожидается ""
  разбор потоки
    случай пусто
      то ""
    случай голова и хвост
      то голова

тотальная функция «Хвост потоков»
  принимает потоки: список строки
  возвращает список строки
  пример «без головы»
    дано потоки равно ["8", "16"]
    ожидается ["16"]
  разбор потоки
    случай пусто
      то пустой список
    случай голова и хвост
      то хвост

тотальная функция «Новый счёт»
  принимает база: число
  возвращает «Счёт»
  обеспечивает «база названа» (результат.«база») равен база
  пример «повторов три, лучшего пока нет»
    дано база равно 700
    ожидается запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 700
  запись «Счёт» с «ещё» равным («Повторов») и «мин» равным -1 и «старт» равным 0 и «база» равным база

тотальная функция «Замер с»
  принимает замер: «Замер», ч: «Счёт», т: список строки, р: список строки
  возвращает «Замер»
  обеспечивает «счёт заменён» (результат.«счёт») равен ч
  пример «счёт, потоки и строки заменены, стенд и пробеги те же»
    дано замер равно запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
    дано ч равно запись «Счёт» с «ещё» равным 2 и «мин» равным -1 и «старт» равным 0 и «база» равным 0
    дано т равно ["2"]
    дано р равно ["x"]
    ожидается запись «Замер» с «потоки» равным [
      "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      "x"
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 2 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
  пусть ст равно (замер.«стенд»)
  пусть п равно (замер.«пробегов»)
  запись «Замер» с «потоки» равным т и «стенд» равным ст и «пробегов» равным п и «строки» равным р и «счёт» равным ч

тотальная функция «Замер из доводов»
  принимает ст: строка, п: строка, т: список строки
  возвращает «Замер»
  обеспечивает «потоки названы все» (длина (результат.«потоки»)) равен (длина т)
  пример «каталог, пробеги и два числа потоков»
    дано ст равно "/z/b"
    дано п равно "100"
    дано т равно ["1", "2"]
    ожидается запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
  пусть ч равно («Новый счёт» от 0)
  пусть р равно (пустой список)
  запись «Замер» с «потоки» равным т и «стенд» равным ст и «пробегов» равным п и «строки» равным р и «счёт» равным ч

тотальная функция «С началом»
  принимает замер: «Замер», мс: число
  возвращает «Замер»
  пример «отметка до прогона записана в счёт»
    дано замер равно запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
    дано мс равно 5000
    ожидается запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 5000 и «база» равным 0)
  пусть ч равно (замер.«счёт»)
  пусть о равно (ч.«ещё»)
  пусть л равно (ч.«мин»)
  пусть «новый» равно (запись «Счёт» с «ещё» равным о и «мин» равным л и «старт» равным мс и «база» равным (ч.«база»))
  «Замер с» от замер и «новый» и (замер.«потоки») и (замер.«строки»)

тотальная функция «Ещё повтор»
  принимает замер: «Замер», мс: число
  возвращает «Замер»
  пример «первый повтор становится лучшим, повторов остаётся два»
    дано замер равно запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 5000 и «база» равным 0)
    дано мс равно 700
    ожидается запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 2 и «мин» равным 700 и «старт» равным 0 и «база» равным 0)
  пусть ч равно (замер.«счёт»)
  пусть о равно ((ч.«ещё») минус 1)
  пусть л равно («Меньшее» от (ч.«мин») и мс)
  пусть «новый» равно (запись «Счёт» с «ещё» равным о и «мин» равным л и «старт» равным 0 и «база» равным (ч.«база»))
  «Замер с» от замер и «новый» и (замер.«потоки») и (замер.«строки»)

тотальная функция «Следующие потоки»
  принимает замер: «Замер»
  возвращает «Замер»
  пример «первая точка становится базой и строкой отчёта»
    дано замер равно запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 0 и «мин» равным 700 и «старт» равным 0 и «база» равным 0)
    ожидается запись «Замер» с «потоки» равным [
      "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      "1 700 142 1"
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 700)
  пусть ч равно (замер.«счёт»)
  пусть т равно (замер.«потоки»)
  пусть «база» равно («База или» от (ч.«база») и (ч.«мин»))
  пусть «строка» равно («Строка замера» от («Первые потоки» от т) и (замер.«пробегов») и (ч.«мин») и «база»)
  «Замер с» от замер и («Новый счёт» от «база») и («Хвост потоков» от т) и (добавить «строка» к (замер.«строки»))

тотальная функция «Отчёт»
  принимает стенд: строка, пробегов: строка, строки: список строки
  возвращает строка
  пример «заголовок, шапка, потом строки»
    дано стенд равно "/z/b"
    дано пробегов равно "100"
    дано строки равно ["1 700 142 1"]
    ожидается "/z/b пробегов 100, повторов 3\nпотоков мс пробегов/с раз\n1 700 142 1"
  пусть «заголовок» равно (соединить [стенд, " пробегов ", пробегов, ", повторов ", (к строке («Повторов»))] по "")
  пусть «верх» равно [«заголовок», («Шапка»)]
  пусть «всё» равно (свёртка строки начиная с «верх» как собрано и строка → добавить строка к собрано)
  соединить «всё» по "\n"

тотальная функция «Пустить»
  принимает замер: «Замер»
  возвращает «Ход»
  пример «потоков не осталось — отчёт»
    дано замер равно запись «Замер» с «потоки» равным [
      ] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      "1 700 142 1"
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
    ожидается вариант «Готово» с отчёт равным "/z/b пробегов 100, повторов 3\nпотоков мс пробегов/с раз\n1 700 142 1"
  разбор (замер.«потоки»)
    случай пусто
      то вариант «Готово» с отчёт равным («Отчёт» от (замер.«стенд») и (замер.«пробегов») и (замер.«строки»))
    случай голова и хвост
      то вариант «Ждём начало» с замер равным замер

тотальная функция «После конца»
  принимает замер: «Замер», мс: число
  возвращает «Ход»
  пример «последний повтор закрывает число потоков и переходит к следующему»
    дано замер равно запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 1 и «мин» равным 800 и «старт» равным 5000 и «база» равным 0)
    дано мс равно 5700
    ожидается вариант «Ждём начало» с замер равным (запись «Замер» с «потоки» равным [
      "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      "1 700 142 1"
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 700))
  пусть «прошло» равно (мс минус (замер.«счёт».«старт»))
  пусть «дальше» равно («Ещё повтор» от замер и «прошло»)
  если («дальше».«счёт».«ещё») больше 0
    то вариант «Ждём начало» с замер равным «дальше»
    иначе «Пустить» от («Следующие потоки» от «дальше»)

тотальная функция «Мало доводов»
  возвращает «Ход»
  пример «назван код отказа»
    ожидается вариант «Не мерили» с код равным "FLANG_BENCH_ARGUMENTS" и сообщение равным "нужны стенд, пробеги, потоки"
  вариант «Не мерили» с код равным "FLANG_BENCH_ARGUMENTS" и сообщение равным "нужны стенд, пробеги, потоки"

тотальная функция «Начать замер»
  принимает стенд: строка, пробегов: строка, потоки: список строки
  возвращает «Ход»
  пример «без потоков мерить нечего»
    дано стенд равно "/z/b"
    дано пробегов равно "100"
    дано потоки равно пустой список
    ожидается вариант «Не мерили» с код равным "FLANG_BENCH_ARGUMENTS" и сообщение равным "нужны стенд, пробеги, потоки"
  разбор потоки
    случай пусто
      то «Мало доводов»
    случай голова и хвост
      то «Пустить» от («Замер из доводов» от стенд и пробегов и потоки)

тотальная функция «Судить потоки»
  принимает стенд: строка, числа: список строки, потоки: список строки
  возвращает «Ход»
  пример «нуль потоков отбит до запуска»
    дано стенд равно "/z/b"
    дано числа равно ["100", "0"]
    дано потоки равно ["0"]
    ожидается вариант «Отказ» с код равным "FLANG_BENCH_ARGUMENTS" и сообщение равным "названо негодное число: 0"
  разбор («Негодные числа» от числа)
    случай голова и хвост
      то вариант «Отказ» с код равным "FLANG_BENCH_ARGUMENTS" и сообщение равным (соединить [
        "названо негодное число: ", голова] по "")
    случай пусто
      то «Начать замер» от стенд и («Первые потоки» от числа) и потоки

тотальная функция «Судить числа»
  принимает стенд: строка, числа: список строки
  возвращает «Ход»
  пример «без пробегов мерить нечего»
    дано стенд равно "/z/b"
    дано числа равно пустой список
    ожидается вариант «Не мерили» с код равным "FLANG_BENCH_ARGUMENTS" и сообщение равным "нужны стенд, пробеги, потоки"
  разбор числа
    случай пусто
      то «Мало доводов»
    случай голова и хвост
      то «Судить потоки» от стенд и числа и хвост

тотальная функция «Судить доводы»
  принимает доводы: список строки
  возвращает «Ход»
  пример «без доводов мерить нечего»
    дано доводы равно пустой список
    ожидается вариант «Не мерили» с код равным "FLANG_BENCH_ARGUMENTS" и сообщение равным "нужны стенд, пробеги, потоки"
  разбор доводы
    случай голова и хвост
      то «Судить числа» от (голова) и (хвост)
    случай пусто
      то «Мало доводов»

тотальная функция «После доводов»
  принимает отклик: «Отклик»
  возвращает «Ход»
  пример «сбой хозяина доезжает своим кодом»
    дано отклик равно вариант «Сбой» с код равным "FLANG_IO_DENIED" и сообщение равным "нет часов"
    ожидается вариант «Не мерили» с код равным "FLANG_IO_DENIED" и сообщение равным "нет часов"
  разбор отклик
    случай вариант «Доводы» с доводы как доводы
      то «Судить доводы» от доводы
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Не мерили» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Отказ» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали доводы"

тотальная функция «После часов до прогона»
  принимает замер: «Замер», отклик: «Отклик»
  возвращает «Ход»
  пример «отметка записана, стенд пускается»
    дано замер равно запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
    дано отклик равно вариант «Отметка времени» с миллисекунды равным 5000
    ожидается вариант «Ждём прогон» с замер равным (запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 5000 и «база» равным 0))
  разбор отклик
    случай вариант «Отметка времени» с миллисекунды как мс
      то вариант «Ждём прогон» с замер равным («С началом» от замер и мс)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Не мерили» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Отказ» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали отметку времени"

тотальная функция «Судить прогон»
  принимает замер: «Замер», код: число, вывод: строка, ошибки: строка
  возвращает «Ход»
  пример «отказ стенда назван и замером не считается»
    дано замер равно запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
    дано код равно 1
    дано вывод равно ""
    дано ошибки равно "нет памяти"
    ожидается вариант «Отказ» с код равным "FLANG_BENCH_RUN" и сообщение равным "стенд отказал: 1 нет памяти"
  пусть «слово» равно (соединить ["стенд отказал: ", (к строке код), " ", ошибки] по "")
  если «Прогон годен» от код и вывод
    то вариант «Ждём конец» с замер равным замер
    иначе вариант «Отказ» с код равным "FLANG_BENCH_RUN" и сообщение равным «слово»

тотальная функция «После прогона»
  принимает замер: «Замер», отклик: «Отклик»
  возвращает «Ход»
  пример «вместо конца процесса пришло другое»
    дано замер равно запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
    дано отклик равно вариант «Показано»
    ожидается вариант «Отказ» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали конца стенда"
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то «Судить прогон» от замер и код и вывод и ошибки
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Не мерили» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Отказ» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали конца стенда"

тотальная функция «После часов после прогона»
  принимает замер: «Замер», отклик: «Отклик»
  возвращает «Ход»
  пример «без часов не мерим»
    дано замер равно запись «Замер» с «потоки» равным [
      "1", "2"] и «стенд» равным "/z/b" и «пробегов» равным "100" и «строки» равным [
      ] и «счёт» равным (запись «Счёт» с «ещё» равным 3 и «мин» равным -1 и «старт» равным 0 и «база» равным 0)
    дано отклик равно вариант «Сбой» с код равным "FLANG_IO_DENIED" и сообщение равным "нет часов"
    ожидается вариант «Не мерили» с код равным "FLANG_IO_DENIED" и сообщение равным "нет часов"
  разбор отклик
    случай вариант «Отметка времени» с миллисекунды как мс
      то «После конца» от замер и мс
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Не мерили» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Отказ» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали отметку времени"

тотальная функция «Шаг»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Ход»
  пример «после начала план ждёт доводы»
    дано ход равно вариант «Просим доводы»
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Ждём доводы»
  разбор ход
    случай вариант «Просим доводы»
      то вариант «Ждём доводы»
    случай вариант «Ждём доводы»
      то «После доводов» от отклик
    случай вариант «Ждём начало» с замер как замер
      то «После часов до прогона» от замер и отклик
    случай вариант «Ждём прогон» с замер как замер
      то «После прогона» от замер и отклик
    случай вариант «Ждём конец» с замер как замер
      то «После часов после прогона» от замер и отклик
    случай любое
      то ход

тотальная функция «Продолжение хода»
  принимает ход: «Ход»
  возвращает «Продолжение»
  пример «ждать доводы — значит попросить их»
    дано ход равно вариант «Ждём доводы»
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать доводы») и потом равным (вариант «Ждём доводы»)
  пример «готовый отчёт кончает работу»
    дано ход равно вариант «Готово» с отчёт равным "отчёт"
    ожидается вариант «Конец работы» с значение равным "отчёт"
  разбор ход
    случай вариант «Просим доводы»
      то вариант «Сделать» с поручение равным (вариант «Прочитать доводы») и потом равным (вариант «Ждём доводы»)
    случай вариант «Ждём доводы»
      то вариант «Сделать» с поручение равным (вариант «Прочитать доводы») и потом равным ход
    случай вариант «Ждём начало» с замер как замер
      то вариант «Сделать» с поручение равным (вариант «Текущее время») и потом равным ход
    случай вариант «Ждём прогон» с замер как замер
      то вариант «Сделать» с поручение равным («Поручение прогона» от замер) и потом равным ход
    случай вариант «Ждём конец» с замер как замер
      то вариант «Сделать» с поручение равным (вариант «Текущее время») и потом равным ход
    случай вариант «Готово» с отчёт как отчёт
      то вариант «Конец работы» с значение равным отчёт
    случай вариант «Отказ» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным сообщение
    случай вариант «Не мерили» с код как код и сообщение как сообщение
      то вариант «Не проверено» с код равным код и сообщение равным сообщение

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  пример «первый шаг — просьба о доводах»
    дано ход равно вариант «Просим доводы»
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать доводы») и потом равным (вариант «Ждём доводы»)
  «Продолжение хода» от («Шаг» от ход и отклик)

план «Растёт ли с ядрами»
  состояние «Ход»
  начинает с «Начало»
  обрабатывает «Дальше»
