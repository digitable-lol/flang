тотальная функция «Дерево надзора»
  возвращает строка
  обеспечивает «в плане названы оба надзора» (результат содержит "Связь") и притом (результат содержит "Цех")
  пример «данные слово в слово как в flang/concurrency/examples/distributed.flang»
    ожидается "{\"процессы\":[{\"имя\":\"Счётчик\",\"начальное\":\"Начальный счёт\",\"обработчик\":\"Обработчик счёта\",\"ящик\":null},{\"имя\":\"Учётчик\",\"начальное\":\"Начальные записи\",\"обработчик\":\"Обработчик учёта\",\"ящик\":null}],\"надзоры\":[{\"имя\":\"Связь\",\"порог\":2,\"окно\":5000,\"иначе\":\"передать выше\",\"процессы\":[{\"кто\":\"Учётчик\",\"стратегия\":\"перезапустить\"}],\"надзоры\":[]},{\"имя\":\"Цех\",\"порог\":1,\"окно\":5000,\"иначе\":\"передать выше\",\"процессы\":[{\"кто\":\"Счётчик\",\"стратегия\":\"перезапустить\"}],\"надзоры\":[{\"кто\":\"Связь\",\"стратегия\":\"передать выше\"}]}]}"
  соединить [
    "{\"процессы\":[", («Два процесса»), "],\"надзоры\":[",
    "{\"имя\":\"Связь\",\"порог\":2,\"окно\":5000,\"иначе\":\"передать выше\",",
    "\"процессы\":[{\"кто\":\"Учётчик\",\"стратегия\":\"перезапустить\"}],\"надзоры\":[]},",
    "{\"имя\":\"Цех\",\"порог\":1,\"окно\":5000,\"иначе\":\"передать выше\",",
    "\"процессы\":[{\"кто\":\"Счётчик\",\"стратегия\":\"перезапустить\"}],",
    "\"надзоры\":[{\"кто\":\"Связь\",\"стратегия\":\"передать выше\"}]}]}"] по ""

тотальная функция «Два процесса»
  возвращает строка
  обеспечивает «названы оба процесса» (результат содержит "Счётчик") и притом (результат содержит "Учётчик")
  пример «два процесса с начальными состояниями и обработчиками»
    ожидается "{\"имя\":\"Счётчик\",\"начальное\":\"Начальный счёт\",\"обработчик\":\"Обработчик счёта\",\"ящик\":null},{\"имя\":\"Учётчик\",\"начальное\":\"Начальные записи\",\"обработчик\":\"Обработчик учёта\",\"ящик\":null}"
  соединить [
    "{\"имя\":\"Счётчик\",\"начальное\":\"Начальный счёт\",\"обработчик\":\"Обработчик счёта\",\"ящик\":null},",
    "{\"имя\":\"Учётчик\",\"начальное\":\"Начальные записи\",\"обработчик\":\"Обработчик учёта\",\"ящик\":null}"] по ""

тотальная функция «Дерево без надзора»
  возвращает строка
  обеспечивает «надзоров в улике ДО нет вовсе» не (результат содержит "надзоры")
  пример «улика ДО: те же два процесса, и ни одного надзора»
    ожидается "{\"процессы\":[{\"имя\":\"Счётчик\",\"начальное\":\"Начальный счёт\",\"обработчик\":\"Обработчик счёта\",\"ящик\":null},{\"имя\":\"Учётчик\",\"начальное\":\"Начальные записи\",\"обработчик\":\"Обработчик учёта\",\"ящик\":null}]}"
  соединить ["{\"процессы\":[", («Два процесса»), "]}"] по ""

тотальная функция «Строки оболочки»
  возвращает список строки
  обеспечивает «строк оболочки ровно сорок пять» (длина результат) равен 45
  обеспечивает «первая строка — запрет недоговорённых имён» (элемент 1 в результат) равен "set -u"
  [
    "set -u",
    "IMYA=$1; PLAN=$2; UDAR=$3; RAB=$4; SROK=$5; PULS=$6; HESH=$7",
    "JU=$RAB/$IMYA-uchyot.jsonl; JS=$RAB/$IMYA-schyot.jsonl",
    ": >\"$JU\"; : >\"$JS\"",
    "trap 'kill -KILL ${PU:-} ${PS:-} 2>/dev/null' EXIT",
    "SRAZU='[{\"кому\":\"Счётчик\",\"что\":[\"в\",\"замерить\",{\"сколько\":[\"ч\",2]}]}]'",
    "POZZHE='[{\"через\":6000,\"кому\":\"Счётчик\",\"что\":[\"в\",\"замерить\",{\"сколько\":[\"ч\",5]}]},'",
    "POZZHE=$POZZHE'{\"через\":7000,\"кому\":\"Счётчик\",\"что\":[\"в\",\"замерить\",{\"сколько\":[\"ч\",6]}]}]'",
    "zhdat() {",
    "  vitkov=$(( $3 * 10 ))",
    "  while [ \"$vitkov\" -gt 0 ]; do",
    "    grep -Eq \"$2\" \"$1\" 2>/dev/null && return 0",
    "    sleep 0.1",
    "    vitkov=$(( vitkov - 1 ))",
    "  done",
    "  return 1",
    "}",
    "( cd \"$RAB/uchyot\" && exec env LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8 python3 -B node.py \\",
    "    --я учёт --слушать 127.0.0.1:0 --хэш \"$HESH\" --план-файл \"$PLAN\" \\",
    "    --размещение '{\"Счётчик\":\"счёт\",\"Учётчик\":\"учёт\"}' \\",
    "    --срок \"$SROK\" --пульс \"$PULS\" --жить 16 >\"$JU\" 2>\"$RAB/$IMYA-uchyot.err\" ) &",
    "PU=$!",
    "zhdat \"$JU\" '\"в\": *\"поднят\"' 20 || { echo 'учёт не поднялся'; cat \"$RAB/$IMYA-uchyot.err\"; exit 1; }",
    "PORT=$(grep -o '\"порт\": *[0-9]*' \"$JU\" | tail -1 | grep -o '[0-9]*$')",
    "echo \"учёт поднят: порт $PORT\"",
    "( cd \"$RAB/schyot\" && exec env LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8 python3 -B node.py \\",
    "    --я счёт --слушать 127.0.0.1:0 --хэш \"$HESH\" --план-файл \"$PLAN\" \\",
    "    --размещение \"{\\\"Счётчик\\\":\\\"счёт\\\",\\\"Учётчик\\\":\\\"учёт\\\",\\\"звонить\\\":{\\\"учёт\\\":\\\"127.0.0.1:$PORT\\\"}}\" \\",
    "    --вбросить \"$SRAZU\" --вбросить-позже \"$POZZHE\" \\",
    "    --срок \"$SROK\" --пульс \"$PULS\" --жить 14 >\"$JS\" 2>\"$RAB/$IMYA-schyot.err\" ) &",
    "PS=$!",
    "zhdat \"$JS\" '\"что\": *\"заведена\"' 20 || { echo 'связь не завелась'; cat \"$RAB/$IMYA-schyot.err\"; exit 1; }",
    "echo 'счёт поднят: связь заведена'",
    "sleep 2",
    "case \"$UDAR\" in",
    "  ubit) echo \"→ SIGKILL узлу «учёт»\"; kill -KILL \"$PU\" ;;",
    "  tiho) echo \"→ SIGSTOP узлу «учёт» на 1000 мс при сроке $SROK мс\"; kill -STOP \"$PU\"; sleep 1; kill -CONT \"$PU\" ;;",
    "  dolgo) echo \"→ SIGSTOP узлу «учёт» на 4000 мс при сроке $SROK мс\"; kill -STOP \"$PU\"; sleep 4; kill -CONT \"$PU\" ;;",
    "esac",
    "wait \"$PS\" 2>/dev/null; echo \"счёт завершился, код возврата $?\"",
    "wait \"$PU\" 2>/dev/null; echo \"учёт завершился, код возврата $?\"",
    "echo '── журнал узла «счёт»: связь, надзор, потери, конец ──'",
    "grep -E '\"в\": *(\"связь\"|\"надзор\"|\"потеря\"|\"конец\")' \"$JS\" | uniq -c || echo '  (пусто)'",
    "echo '── чем кончил узел «учёт» ──'",
    "grep -E '\"в\": *\"конец\"' \"$JU\" || echo '  узел «учёт» до конца не дожил'"
  ]

тотальная функция «Оболочка»
  возвращает строка
  обеспечивает «в оболочке есть и фон, и сигнал» (результат содержит "kill -STOP") и притом (результат содержит "PU=$!")
  соединить («Строки оболочки») по "\n"

тотальная функция «Внутри работы»
  принимает заход: «Заход», имя: строка
  возвращает строка
  обеспечивает «путь начинается каталогом работы» результат начинается с (заход.«работа»)
  пример «файл оболочки лежит в каталоге работы»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    дано имя равно "case.sh"
    ожидается "/srv/tmp/x/case.sh"
  соединить [заход.«работа», "/", имя] по ""

тотальная функция «В дереве»
  принимает заход: «Заход», путь: строка
  возвращает строка
  обеспечивает «путь начинается корнем дерева» результат начинается с (заход.«корень»)
  пример «двоичный берётся тот же, каким идёт план»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    дано путь равно "bootstrap/flang"
    ожидается "../bootstrap/flang"
  соединить [заход.«корень», "/", путь] по ""

тотальная функция «Доводы случая»
  принимает заход: «Заход», дело: «Случай»
  возвращает список строки
  обеспечивает «доводов ровно восемь» (длина результат) равен 8
  пример «восемь доводов, и все восемь называет план, а не оболочка»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    дано дело равно запись «Случай» с «имя» равным "bez" и «план» равным "plan-bez.json" и «удар» равным "ubit"
    ожидается ["/srv/tmp/x/case.sh", "bez", "plan-bez.json", "ubit", "/srv/tmp/x", "2000", "200", "0123456789abcdef"]
  [(«Внутри работы» от заход и "case.sh"), дело.«имя», дело.«план», дело.«удар», заход.«работа», "2000", "200", "0123456789abcdef"]

тотальная функция «Поручение случая»
  принимает заход: «Заход», дело: «Случай»
  возвращает «Поручение»
  пример «случай идёт одним поручением под своим сроком»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    дано дело равно запись «Случай» с «имя» равным "bez" и «план» равным "plan-bez.json" и «удар» равным "ubit"
    ожидается вариант «Запустить процесс с пределом» с программа равным "sh" и аргументы равным ["/srv/tmp/x/case.sh", "bez", "plan-bez.json", "ubit", "/srv/tmp/x", "2000", "200", "0123456789abcdef"] и память равным 0 и срок равным 90000
  вариант «Запустить процесс с пределом» с программа равным "sh" и аргументы равным («Доводы случая» от заход и дело) и память равным 0 и срок равным («Срок случая»)


тотальная функция «Что сказал случай»
  принимает отклик: «Отклик»
  возвращает строка
  пример «кончился сам — оба потока подряд»
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "учёт поднят" и ошибки равным ""
    ожидается "учёт поднят"
  пример «оборван по сроку поручения — отклик СВОЙ, и он приносит напечатанное до обрыва»
    дано отклик равно вариант «Процесс оборван» с предел равным 90000 и вывод равным "учёт поднят" и ошибки равным ""
    ожидается "ОБОРВАН ХОЗЯИНОМ по сроку 90000 мс, успел напечатать:\nучёт поднят"
  пример «убит извне — это НЕ срок, и слово другое»
    дано отклик равно вариант «Процесс убит» с сигнал равным "SIGTERM" и вывод равным "" и ошибки равным ""
    ожидается "УБИТ СИГНАЛОМ SIGTERM"
  пример «сбой хозяина доезжает своим кодом»
    дано отклик равно вариант «Сбой» с код равным "FLANG_IO_DENIED" и сообщение равным "нельзя"
    ожидается "СБОЙ FLANG_IO_DENIED: нельзя"
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то соединить [вывод, ошибки] по ""
    случай вариант «Процесс оборван» с предел как предел и вывод как вывод и ошибки как ошибки
      то соединить ["ОБОРВАН ХОЗЯИНОМ по сроку ", (к строке предел), " мс, успел напечатать:\n", вывод, ошибки] по ""
    случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
      то соединить ["УБИТ СИГНАЛОМ ", сигнал] по ""
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то соединить ["СБОЙ ", код, ": ", сообщение] по ""
    случай любое
      то "ждали конца случая, а пришло другое"

тотальная функция «Заголовок случая»
  принимает дело: «Случай»
  возвращает строка
  обеспечивает «в заголовке названы имя, план и удар» ((результат содержит (дело.«имя»)) и притом (результат содержит (дело.«план»))) и притом (результат содержит (дело.«удар»))
  пример «тот же заголовок, что печатала оболочка»
    дано дело равно запись «Случай» с «имя» равным "nadzor" и «план» равным "plan.json" и «удар» равным "ubit"
    ожидается "════ случай «nadzor»: план plan.json, удар «ubit» ════"
  соединить ["════ случай «", (дело.«имя»), "»: план ", (дело.«план»), ", удар «", (дело.«удар»), "» ════"] по ""

тотальная функция «Блок случая»
  принимает дело: «Случай», отклик: «Отклик»
  возвращает строка
  обеспечивает «в блоке есть заголовок случая» результат содержит (дело.«имя»)
  пример «заголовок и то, что сказал прогон»
    дано дело равно запись «Случай» с «имя» равным "bez" и «план» равным "plan-bez.json" и «удар» равным "ubit"
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "учёт поднят\n" и ошибки равным ""
    ожидается "════ случай «bez»: план plan-bez.json, удар «ubit» ════\nучёт поднят\n"
  соединить [(«Заголовок случая» от дело), "\n", («Что сказал случай» от отклик)] по ""

тотальная функция «Отчёт»
  принимает блоки: список строки
  возвращает строка
  пример «блоки идут в том же порядке, в каком названы случаи»
    дано блоки равно ["первый", "второй"]
    ожидается "первый\n\nвторой"
  соединить блоки по "\n\n"

тотальная функция «Поручение печати»
  принимает заход: «Заход»
  возвращает «Поручение»
  пример «узел печатается в цель python тем же двоичным, каким идёт план»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    ожидается вариант «Запустить процесс» с программа равным "../bootstrap/flang" и аргументы равным ["emit", "../flang/concurrency/node-benchmark.flang", "--target", "python", "--out", "/srv/tmp/x/uchyot"]
  вариант «Запустить процесс» с программа равным (соединить [заход.«корень», "/bootstrap/flang"] по "") и аргументы равным [
    "emit", (соединить [заход.«корень», "/flang/concurrency/node-benchmark.flang"] по ""),
    "--target", "python", "--out", (соединить [заход.«работа», "/uchyot"] по "")]

тотальная функция «Поручение раскладки»
  принимает заход: «Заход»
  возвращает «Поручение»
  пример «копия каталога под второй узел — одно поручение, одна строка»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    ожидается вариант «Запустить процесс» с программа равным "cp" и аргументы равным ["-r", "/srv/tmp/x/uchyot", "/srv/tmp/x/schyot"]
  вариант «Запустить процесс» с программа равным "cp" и аргументы равным [
    "-r", (соединить [заход.«работа», "/uchyot"] по ""), (соединить [заход.«работа», "/schyot"] по "")]

тотальная функция «Поручение хозяина узла»
  принимает заход: «Заход»
  возвращает «Поручение»
  пример «хозяин узла кладётся В ОБА каталога одним поручением»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    ожидается вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "cp '../flang/concurrency/bin/node.py' '/srv/tmp/x/uchyot/' && cp '../flang/concurrency/bin/node.py' '/srv/tmp/x/schyot/'"]
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (соединить [
    "cp '", (заход.«корень»), "/flang/concurrency/bin/node.py' '", (заход.«работа»), "/uchyot/' && ",
    "cp '", (заход.«корень»), "/flang/concurrency/bin/node.py' '", (заход.«работа»), "/schyot/'"] по "")]

тотальная функция «Файлы данных»
  возвращает список строки
  обеспечивает «файлов данных ровно пять» (длина результат) равен 5
  пример «два дерева надзора в оба каталога и сама оболочка случая»
    ожидается ["uchyot/plan.json", "uchyot/plan-bez.json", "schyot/plan.json", "schyot/plan-bez.json", "case.sh"]
  ["uchyot/plan.json", "uchyot/plan-bez.json", "schyot/plan.json", "schyot/plan-bez.json", "case.sh"]

тотальная функция «Содержимое файла»
  принимает имя: строка
  возвращает строка
  пример «план с надзором»
    дано имя равно "uchyot/plan.json"
    ожидается "{\"процессы\":[{\"имя\":\"Счётчик\",\"начальное\":\"Начальный счёт\",\"обработчик\":\"Обработчик счёта\",\"ящик\":null},{\"имя\":\"Учётчик\",\"начальное\":\"Начальные записи\",\"обработчик\":\"Обработчик учёта\",\"ящик\":null}],\"надзоры\":[{\"имя\":\"Связь\",\"порог\":2,\"окно\":5000,\"иначе\":\"передать выше\",\"процессы\":[{\"кто\":\"Учётчик\",\"стратегия\":\"перезапустить\"}],\"надзоры\":[]},{\"имя\":\"Цех\",\"порог\":1,\"окно\":5000,\"иначе\":\"передать выше\",\"процессы\":[{\"кто\":\"Счётчик\",\"стратегия\":\"перезапустить\"}],\"надзоры\":[{\"кто\":\"Связь\",\"стратегия\":\"передать выше\"}]}]}"
  пример «план без надзора — улика ДО»
    дано имя равно "schyot/plan-bez.json"
    ожидается "{\"процессы\":[{\"имя\":\"Счётчик\",\"начальное\":\"Начальный счёт\",\"обработчик\":\"Обработчик счёта\",\"ящик\":null},{\"имя\":\"Учётчик\",\"начальное\":\"Начальные записи\",\"обработчик\":\"Обработчик учёта\",\"ящик\":null}]}"
  если имя равен "case.sh"
    то «Оболочка»
    иначе (если имя содержит "plan-bez.json" то («Дерево без надзора») иначе («Дерево надзора»))

тотальная функция «Пустить запись»
  принимает заход: «Заход», осталось: список строки
  возвращает «Продолжение»
  пример «файлы кончились — пошли случаи»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    дано осталось равно пустой список
    ожидается вариант «Конец работы» с значение равным ""
  разбор осталось
    случай пусто
      то «Пустить случай» от заход
    случай голова и хвост
      то вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным (соединить [заход.«работа», "/", голова] по "") и содержимое равным («Содержимое файла» от голова)) и потом равным (вариант «Ждём запись» с заход равным заход и осталось равным хвост)

тотальная функция «Пустить случай»
  принимает заход: «Заход»
  возвращает «Продолжение»
  пример «случаи кончились — отчёт и конец работы»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным ["первый"]
    ожидается вариант «Конец работы» с значение равным "первый"
  разбор (заход.«случаи»)
    случай пусто
      то вариант «Конец работы» с значение равным («Отчёт» от (заход.«блоки»))
    случай голова и хвост
      то вариант «Сделать» с поручение равным («Поручение случая» от заход и голова) и потом равным (вариант «Ждём случай» с заход равным (запись «Заход» с «корень» равным (заход.«корень») и «работа» равным (заход.«работа») и «случаи» равным хвост и «блоки» равным (заход.«блоки»)) и дело равным голова)

тотальная функция «После доводов»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пример «доводы прочтены — заводится каталог работы»
    дано отклик равно вариант «Доводы» с доводы равным ["dolgo"]
    ожидается вариант «Сделать» с поручение равным (вариант «Завести временный каталог» с образец равным "/srv/tmp/node-death-") и потом равным (вариант «Ждём каталог» с случаи равным [запись «Случай» с «имя» равным "dolgo" и «план» равным "plan.json" и «удар» равным "dolgo"])
  пример «назван случай, которого нет — гнать нечего, и это НЕ приговор узлу»
    дано отклик равно вариант «Доводы» с доводы равным ["такого нет"]
    ожидается вариант «Не проверено» с код равным "FLANG_SMERT_UZLA_NECHEM_MERIT" и сообщение равным "названных случаев нет среди четырёх: bez, nadzor, tiho, dolgo"
  разбор отклик
    случай вариант «Доводы» с доводы как доводы
      то «Судить выбор» от («Выбранные случаи» от доводы)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Не проверено» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали доводы"

тотальная функция «Судить выбор»
  принимает случаи: список «Случай»
  возвращает «Продолжение»
  пример «выбор пуст — мерить нечем»
    дано случаи равно пустой список
    ожидается вариант «Не проверено» с код равным "FLANG_SMERT_UZLA_NECHEM_MERIT" и сообщение равным "названных случаев нет среди четырёх: bez, nadzor, tiho, dolgo"
  пример «выбор есть — заводится каталог работы»
    дано случаи равно [запись «Случай» с «имя» равным "tiho" и «план» равным "plan.json" и «удар» равным "tiho"]
    ожидается вариант «Сделать» с поручение равным (вариант «Завести временный каталог» с образец равным "/srv/tmp/node-death-") и потом равным (вариант «Ждём каталог» с случаи равным [запись «Случай» с «имя» равным "tiho" и «план» равным "plan.json" и «удар» равным "tiho"])
  если пусто случаи
    то вариант «Не проверено» с код равным "FLANG_SMERT_UZLA_NECHEM_MERIT" и сообщение равным "названных случаев нет среди четырёх: bez, nadzor, tiho, dolgo"
    иначе вариант «Сделать» с поручение равным (вариант «Завести временный каталог» с образец равным («Образец каталога»)) и потом равным (вариант «Ждём каталог» с случаи равным случаи)

тотальная функция «Корень дерева»
  возвращает строка
  обеспечивает «корень — два уровня вверх от каталога плана» результат равен "../../.."
  пример «план лежит в flang/concurrency/bench, значит корень — три уровня вверх»
    ожидается "../../.."
  "../../.."

тотальная функция «После каталога»
  принимает случаи: список «Случай», отклик: «Отклик»
  возвращает «Продолжение»
  пример «каталог заведён — печатается узел»
    дано случаи равно [запись «Случай» с «имя» равным "tiho" и «план» равным "plan.json" и «удар» равным "tiho"]
    дано отклик равно вариант «Заведено» с путь равным "/srv/tmp/x"
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "../../../bootstrap/flang" и аргументы равным ["emit", "../../../flang/concurrency/node-benchmark.flang", "--target", "python", "--out", "/srv/tmp/x/uchyot"]) и потом равным (вариант «Ждём печать» с заход равным (запись «Заход» с «корень» равным "../../.." и «работа» равным "/srv/tmp/x" и «случаи» равным [запись «Случай» с «имя» равным "tiho" и «план» равным "plan.json" и «удар» равным "tiho"] и «блоки» равным пустой список))
  разбор отклик
    случай вариант «Заведено» с путь как путь
      то «Печатать узел» от (запись «Заход» с «корень» равным («Корень дерева») и «работа» равным путь и «случаи» равным случаи и «блоки» равным пустой список)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Не проверено» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали временный каталог"

тотальная функция «Печатать узел»
  принимает заход: «Заход»
  возвращает «Продолжение»
  пример «печать идёт одним поручением»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "../bootstrap/flang" и аргументы равным ["emit", "../flang/concurrency/node-benchmark.flang", "--target", "python", "--out", "/srv/tmp/x/uchyot"]) и потом равным (вариант «Ждём печать» с заход равным (запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список))
  вариант «Сделать» с поручение равным («Поручение печати» от заход) и потом равным (вариант «Ждём печать» с заход равным заход)

тотальная функция «Шаг после удачи»
  принимает заход: «Заход», отклик: «Отклик», чей: строка, дальше: «Продолжение»
  возвращает «Продолжение»
  пример «нулевой код — идём дальше»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "" и ошибки равным ""
    дано чей равно "печать"
    дано дальше равно вариант «Конец работы» с значение равным "дальше"
    ожидается вариант «Конец работы» с значение равным "дальше"
  пример «ненулевой код — план сдаётся сам и называет, ЧТО не вышло»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным пустой список и «блоки» равным пустой список
    дано отклик равно вариант «Процесс завершён» с код равным 1 и вывод равным "" и ошибки равным "не собралось"
    дано чей равно "печать"
    дано дальше равно вариант «Конец работы» с значение равным "дальше"
    ожидается вариант «Провал» с код равным "FLANG_SMERT_UZLA_NE_GOTOVA" и сообщение равным "печать отказала кодом 1: не собралось"
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то если код равен 0
        то дальше
        иначе вариант «Провал» с код равным "FLANG_SMERT_UZLA_NE_GOTOVA" и сообщение равным (соединить [чей, " отказала кодом ", (к строке код), ": ", ошибки, вывод] по "")
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Не проверено» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным (соединить ["ждали конца: ", чей] по "")

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  пример «первым делом спрашиваются доводы»
    дано ход равно вариант «Просим доводы»
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать доводы») и потом равным (вариант «Ждём доводы»)
  разбор ход
    случай вариант «Просим доводы»
      то вариант «Сделать» с поручение равным (вариант «Прочитать доводы») и потом равным (вариант «Ждём доводы»)
    случай вариант «Ждём доводы»
      то «После доводов» от отклик
    случай вариант «Ждём каталог» с случаи как случаи
      то «После каталога» от случаи и отклик
    случай вариант «Ждём печать» с заход как заход
      то «Шаг после удачи» от заход и отклик и "печать узла" и (вариант «Сделать» с поручение равным («Поручение раскладки» от заход) и потом равным (вариант «Ждём раскладку» с заход равным заход))
    случай вариант «Ждём раскладку» с заход как заход
      то «Шаг после удачи» от заход и отклик и "раскладка каталогов" и (вариант «Сделать» с поручение равным («Поручение хозяина узла» от заход) и потом равным (вариант «Ждём хозяина узла» с заход равным заход))
    случай вариант «Ждём хозяина узла» с заход как заход
      то «Шаг после удачи» от заход и отклик и "раскладка хозяина узла" и («Пустить запись» от заход и («Файлы данных»))
    случай вариант «Ждём запись» с заход как заход и осталось как осталось
      то «Пустить запись» от заход и осталось
    случай вариант «Ждём случай» с заход как заход и дело как дело
      то «Пустить случай» от (запись «Заход» с «корень» равным (заход.«корень») и «работа» равным (заход.«работа») и «случаи» равным (заход.«случаи») и «блоки» равным (добавить («Блок случая» от дело и отклик) к (заход.«блоки»)))

план «Смерть узла»
  состояние «Ход»
  начинает с «Начало»
  обрабатывает «Дальше»
