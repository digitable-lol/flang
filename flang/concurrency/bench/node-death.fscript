      то «Слить» от («Слить» от ["ждём случай"] и («Заход словами» от заход)) и («Случай словами» от дело)

тотальная функция «Словами»
  принимает дальше: «Продолжение»
  возвращает список строки
  разбор дальше
    случай вариант «Сделать» с поручение как поручение и потом как потом
      то «Слить» от («Поручение словами» от поручение) и («Ход словами» от потом)
    случай вариант «Провал» с код как код и сообщение как сообщение
      то ["провал", код, сообщение]
    случай вариант «Не проверено» с код как код и сообщение как сообщение
      то ["не проверено", код, сообщение]
    случай вариант «Конец работы» с значение как значение
      то ["конец работы", значение]
    случай любое
      то ["иное продолжение"]

тотальная функция «Дерево надзора по частям»
  возвращает список строки
  пример «данные слово в слово как в flang/concurrency/examples/distributed.flang»
    ожидается [
      "{\"процессы\":[{\"имя\":\"Счётчик\"", "\"начальное\":\"Начальный счёт\"",
      "\"обработчик\":\"Обработчик счёта\"", "\"ящик\":null}", "{\"имя\":\"Учётчик\"",
      "\"начальное\":\"Начальные записи\"", "\"обработчик\":\"Обработчик учёта\"", "\"ящик\":null}]",
      "\"надзоры\":[{\"имя\":\"Связь\"", "\"порог\":2", "\"окно\":5000", "\"иначе\":\"передать выше\"",
      "\"процессы\":[{\"кто\":\"Учётчик\"", "\"стратегия\":\"перезапустить\"}]", "\"надзоры\":[]}",
      "{\"имя\":\"Цех\"", "\"порог\":1", "\"окно\":5000", "\"иначе\":\"передать выше\"",
      "\"процессы\":[{\"кто\":\"Счётчик\"", "\"стратегия\":\"перезапустить\"}]",
      "\"надзоры\":[{\"кто\":\"Связь\"", "\"стратегия\":\"передать выше\"}]}]}"]
  разделить («Дерево надзора») по ","

тотальная функция «Два процесса по частям»
  возвращает список строки
  пример «два процесса с начальными состояниями и обработчиками»
    ожидается [
      "{\"имя\":\"Счётчик\"", "\"начальное\":\"Начальный счёт\"", "\"обработчик\":\"Обработчик счёта\"",
      "\"ящик\":null}", "{\"имя\":\"Учётчик\"", "\"начальное\":\"Начальные записи\"",
      "\"обработчик\":\"Обработчик учёта\"", "\"ящик\":null}"]
  разделить («Два процесса») по ","

тотальная функция «Дерево без надзора по частям»
  возвращает список строки
  пример «улика ДО: те же два процесса, и ни одного надзора»
    ожидается [
      "{\"процессы\":[{\"имя\":\"Счётчик\"", "\"начальное\":\"Начальный счёт\"",
      "\"обработчик\":\"Обработчик счёта\"", "\"ящик\":null}", "{\"имя\":\"Учётчик\"",
      "\"начальное\":\"Начальные записи\"", "\"обработчик\":\"Обработчик учёта\"", "\"ящик\":null}]}"]
  разделить («Дерево без надзора») по ","

тотальная функция «Содержимое файла по частям»
  принимает имя: строка
  возвращает список строки
  пример «план с надзором»
    дано имя равно "uchyot/plan.json"
    ожидается [
      "{\"процессы\":[{\"имя\":\"Счётчик\"", "\"начальное\":\"Начальный счёт\"",
      "\"обработчик\":\"Обработчик счёта\"", "\"ящик\":null}", "{\"имя\":\"Учётчик\"",
      "\"начальное\":\"Начальные записи\"", "\"обработчик\":\"Обработчик учёта\"", "\"ящик\":null}]",
      "\"надзоры\":[{\"имя\":\"Связь\"", "\"порог\":2", "\"окно\":5000", "\"иначе\":\"передать выше\"",
      "\"процессы\":[{\"кто\":\"Учётчик\"", "\"стратегия\":\"перезапустить\"}]", "\"надзоры\":[]}",
      "{\"имя\":\"Цех\"", "\"порог\":1", "\"окно\":5000", "\"иначе\":\"передать выше\"",
      "\"процессы\":[{\"кто\":\"Счётчик\"", "\"стратегия\":\"перезапустить\"}]",
      "\"надзоры\":[{\"кто\":\"Связь\"", "\"стратегия\":\"передать выше\"}]}]}"]
  пример «план без надзора — улика ДО»
    дано имя равно "schyot/plan-bez.json"
    ожидается [
      "{\"процессы\":[{\"имя\":\"Счётчик\"", "\"начальное\":\"Начальный счёт\"",
      "\"обработчик\":\"Обработчик счёта\"", "\"ящик\":null}", "{\"имя\":\"Учётчик\"",
      "\"начальное\":\"Начальные записи\"", "\"обработчик\":\"Обработчик учёта\"", "\"ящик\":null}]}"]
  разделить («Содержимое файла» от имя) по ","

тотальная функция «После доводов словами»
  принимает отклик: «Отклик»
  возвращает список строки
  пример «доводы прочтены — заводится каталог работы»
    дано отклик равно вариант «Доводы» с доводы равным ["dolgo"]
    ожидается [
      "завести временный каталог", "/srv/tmp/node-death-", "ждём каталог", "dolgo", "plan.json", "dolgo"]
  пример «назван случай, которого нет — гнать нечего, и это НЕ приговор узлу»
    дано отклик равно вариант «Доводы» с доводы равным ["такого нет"]
    ожидается [
      "не проверено", "FLANG_SMERT_UZLA_NECHEM_MERIT",
      "названных случаев нет среди четырёх: bez, nadzor, tiho, dolgo"]
  «Словами» от («После доводов» от отклик)

тотальная функция «Судить выбор словами»
  принимает случаи: список «Случай»
  возвращает список строки
  пример «выбор пуст — мерить нечем»
    дано случаи равно пустой список
    ожидается [
      "не проверено", "FLANG_SMERT_UZLA_NECHEM_MERIT",
      "названных случаев нет среди четырёх: bez, nadzor, tiho, dolgo"]
  пример «выбор есть — заводится каталог работы»
    дано случаи равно [запись «Случай» с «имя» равным "tiho" и «план» равным "plan.json" и «удар» равным "tiho"]
    ожидается [
      "завести временный каталог", "/srv/tmp/node-death-", "ждём каталог", "tiho", "plan.json", "tiho"]
  «Словами» от («Судить выбор» от случаи)

тотальная функция «После каталога словами»
  принимает случаи: список «Случай», отклик: «Отклик»
  возвращает список строки
  пример «каталог заведён — печатается узел»
    дано случаи равно [запись «Случай» с «имя» равным "tiho" и «план» равным "plan.json" и «удар» равным "tiho"]
    дано отклик равно вариант «Заведено» с путь равным "/srv/tmp/x"
    ожидается [
      "запустить", "../../../bootstrap/flang", "emit", "../../../flang/concurrency/node-benchmark.flang",
      "--target", "python", "--out", "/srv/tmp/x/uchyot", "ждём печать", "корень", "../../..", "работа",
      "/srv/tmp/x", "случаи", "tiho", "plan.json", "tiho", "блоков", "0"]
  «Словами» от («После каталога» от случаи и отклик)

тотальная функция «Печатать узел словами»
  принимает заход: «Заход»
  возвращает список строки
  пример «печать идёт одним поручением»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным [
      ] и «блоки» равным [
      ]
    ожидается [
      "запустить", "../bootstrap/flang", "emit", "../flang/concurrency/node-benchmark.flang", "--target",
      "python", "--out", "/srv/tmp/x/uchyot", "ждём печать", "корень", "..", "работа", "/srv/tmp/x", "случаи",
      "блоков", "0"]
  «Словами» от («Печатать узел» от заход)

тотальная функция «Шаг после удачи словами»
  принимает заход: «Заход», отклик: «Отклик», чей: строка, дальше: «Продолжение»
  возвращает список строки
  пример «нулевой код — идём дальше»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным [
      ] и «блоки» равным [
      ]
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "" и ошибки равным ""
    дано чей равно "печать"
    дано дальше равно вариант «Конец работы» с значение равным "дальше"
    ожидается [
      "конец работы", "дальше"]
  пример «ненулевой код — план сдаётся сам и называет, ЧТО не вышло»
    дано заход равно запись «Заход» с «корень» равным ".." и «работа» равным "/srv/tmp/x" и «случаи» равным [
      ] и «блоки» равным [
      ]
    дано отклик равно вариант «Процесс завершён» с код равным 1 и вывод равным "" и ошибки равным "не собралось"
    дано чей равно "печать"
    дано дальше равно вариант «Конец работы» с значение равным "дальше"
    ожидается [
      "провал", "FLANG_SMERT_UZLA_NE_GOTOVA", "печать отказала кодом 1: не собралось"]
  «Словами» от («Шаг после удачи» от заход и отклик и чей и дальше)

план «Смерть узла»
  состояние «Ход»
  начинает с «Начало»
  обрабатывает «Дальше»
