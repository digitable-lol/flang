модуль «Parallel map gate»
  использует «Inquiry» из "../../../scripts/inquiry.fscript"
  использует «Lists» только «Соединить списки»

тотальная функция «Сценарий подготовки»
  возвращает список строки
  обеспечивает «строк подготовки 26» (длина результат) равен 26
  [
    "set -u",
    "F=${FLANG:-bootstrap/flang}",
    "B=flang/concurrency/bench",
    "R=$(mktemp -d \"${TMPDIR:-/tmp}/parallel-map.XXXXXX\") || exit 1",
    "trap 'rm -rf \"$R\"' EXIT",
    "O='-std=c99 -Wall -Wextra -Werror -pedantic'",
    "P='-DFL_PAR_WAIT_NS=0L -DFL_PAR_WORTH_NS=0L'",
    "T='-O1 -g -fsanitize=thread'",
    соединить [
      "emit() { $F emit \"$B/$1.flang\" --target c --out \"$R/$2\" >/dev/null 2>&1; ",
      "[ -f \"$R/$2/Makefile\" ] || { echo \"emit=$1\"; exit 1; }; }"
    ] по "",
    "build() { make -s -C \"$R/$1\" CFLAGS=\"$2\" >/dev/null 2>&1 || { echo \"build=$1\"; exit 1; }; }",
    "count() { cat \"$R\"/$1/*.c | grep -c \"$2\"; }",
    "emit parallel-map main",
    "emit parallel-map-forged-number number",
    "emit parallel-map-forged-unit unit",
    "echo \"map_main=$(count main 'fl_par_map(ctx')\"",
    "echo \"fold_main=$(count main 'fl_par_fold(ctx')\"",
    "echo \"fold_number=$(count number 'fl_par_fold(ctx')\"",
    "echo \"fold_unit=$(count unit 'fl_par_fold(ctx')\"",
    "for d in force tsan forged; do cp -r \"$R/main\" \"$R/$d\"; done",
    "G=\"$R/forged/flang_runtime.c\"",
    соединить [
      "sed -i 's/if (fl_watch_mine \\&\\& ctx->lane == 0 \\&\\& ctx->depth < FL_WATCH_FRAMES)/",
      "if (ctx->depth < FL_WATCH_FRAMES)/' \"$G\""
    ] по "",
    "grep -q \"  if (ctx->depth < FL_WATCH_FRAMES)\" \"$G\" || { echo forged=unbuilt; exit 1; }",
    "build main \"$O -O2 -flto\"",
    "build force \"$O -O2 $P\"",
    "build tsan \"$O $T $P\"",
    "build forged \"$O $T $P\""
  ]

тотальная функция «Сценарий прогонов»
  возвращает список строки
  обеспечивает «строк прогонов 17» (длина результат) равен 17
  [
    соединить [
      "req() { awk -v fn=\"$1\" -v n=\"$2\" -v m=\"$3\" -v steps=\"$4\" ",
      "'BEGIN { q = \"\\\"\"; printf \"{%sfn%s:%s%s%s,%sargs%s:[{%sl%s:[\", q, q, q, fn, q, q, q, q, q; ",
      "for (i = 0; i < n; i++) printf \"%s{%sn%s:%s%d.5%s}\", (i ? \",\" : \"\"), q, q, q, i + 1, q; ",
      "printf \"]},{%sl%s:[\", q, q; ",
      "for (i = 0; i < m; i++) printf \"%s{%sn%s:%s0.00%d%s}\", (i ? \",\" : \"\"), q, q, q, i % 97, q; ",
      "printf \"]}],%ssteps%s:%s%s%s}\\n\", q, q, q, steps, q }'; }"
    ] по "",
    соединить [
      "sum() { awk -v n=\"$1\" ",
      "'BEGIN { q = \"\\\"\"; printf \"{%sfn%s:%sСумма%s,%sargs%s:[{%sl%s:[\", q, q, q, q, q, q, q, q; ",
      "for (i = 0; i < n; i++) printf \"%s{%sl%s:[{%sn%s:%s%d%s},{%sn%s:%s%d%s}]}\", (i ? \",\" : \"\"), ",
      "q, q, q, q, q, (i * 7919) % 4194304, q, q, q, q, i % 5 + 1, q; ",
      "printf \"]}],%ssteps%s:%s0%s}\\n\", q, q, q, q }'; }"
    ] по "",
    "run() { FLANG_THREADS=$1 \"$R/$2/flang_cli\" 2>/dev/null; }",
    "for t in 1 2 8 64; do",
    "  echo \"map_$t=$(req 'Все работы' 256 300 0 | run $t force | cksum)\"",
    "  echo \"refusal_$t=$(req 'Все работы' 256 300 40000 | run $t force | cksum)\"",
    "  echo \"sum_$t=$(sum 4000 | run $t force | cksum)\"",
    "  echo \"grown_$t=$(req 'Добавить к выросшей' 2000 3 0 | run $t force | cksum)\"",
    "done",
    "echo \"refusal_text=$(req 'Все работы' 256 300 40000 | run 8 force | head -c 120)\"",
    "four() { FLANG_THREADS=4 \"$R/$1/flang_cli\"; }",
    соединить [
      "probe() { req 'Все работы' 64 120 0 | four $1; sum 2000 | four $1; ",
      "req 'Добавить к выросшей' 2000 3 0 | four $1; }"
    ] по "",
    "echo \"tsan=$(probe tsan 2>&1 >/dev/null | grep -c 'WARNING: ThreadSanitizer')\"",
    "echo \"tsan_forged=$(probe forged 2>&1 >/dev/null | grep -c 'WARNING: ThreadSanitizer')\"",
    соединить [
      "ms() { s=$(date +%s%N); req 'Все работы' 1024 1000 0 | run $1 main >/dev/null; ",
      "e=$(date +%s%N); echo $(( (e - s) / 1000000 )); }"
    ] по "",
    "best() { b=$(ms $1); for k in 2 3; do m=$(ms $1); [ \"$m\" -lt \"$b\" ] && b=$m; done; echo \"$b\"; }",
    "echo \"ms_1=$(best 1)\"; echo \"ms_8=$(best 8)\""
  ]

тотальная функция «Сценарий»
  возвращает строка
  обеспечивает «сценарий начинается с set -u» результат начинается с "set -u"
  пусть «все» равно («Соединить списки» от («Сценарий подготовки») и («Сценарий прогонов»))
  соединить «все» по "\n"

тотальная функция «Значение строки»
  принимает строка: строка, ключ: строка
  возвращает строка
  пример «значение после знака равенства»
    дано строка равно "ms_8=640"
    дано ключ равно "ms_8"
    ожидается "640"
  пример «чужой ключ не даёт ничего»
    дано строка равно "ms_1=5000"
    дано ключ равно "ms_8"
    ожидается ""
  если строка начинается с (соединить ключ с "=")
    то соединить (хвост (разделить строка по "=")) по "="
    иначе ""

тотальная функция «Значение ключа»
  принимает вывод: строка, ключ: строка
  возвращает строка
  пример «ключ находится среди строк»
    дано вывод равно "map_main=1\nfold_main=1\n"
    дано ключ равно "fold_main"
    ожидается "1"
  пример «ключа нет — пусто»
    дано вывод равно "map_main=1\n"
    дано ключ равно "tsan"
    ожидается ""
  пусть строки равно (разделить вывод по "\n")
  свёртка строки начиная с "" как найдено и строка → соединить найдено с («Значение строки» от строка и ключ)

тотальная функция «Число ключа»
  принимает вывод: строка, ключ: строка
  возвращает число
  пример «число читается»
    дано вывод равно "tsan=0\n"
    дано ключ равно "tsan"
    ожидается 0
  пример «нет числа — минус единица»
    дано вывод равно "tsan=\n"
    дано ключ равно "tsan"
    ожидается -1
  разбор (к числу или беда («Значение ключа» от вывод и ключ))
    случай вариант «Разобрано» с значение как значение
      то значение
    случай вариант «Не разобрано» с код как код и сообщение как сообщение
      то -1

объект «Требование»
  «что»: строка
  «выполнено»: признак

тотальная функция «Требуется»
  принимает что: строка, выполнено: признак
  возвращает «Требование»
  пример «требование несёт слова и признак»
    дано что равно "a"
    дано выполнено равно да
    ожидается запись «Требование» с «что» равным "a" и «выполнено» равным да
  запись «Требование» с «что» равным что и «выполнено» равным выполнено

тотальная функция «Одинаково на потоках»
  принимает вывод: строка, ключ: строка
  возвращает «Требование»
  пример «четыре одинаковых ответа»
    дано вывод равно "map_1=7 9\nmap_2=7 9\nmap_8=7 9\nmap_64=7 9\n"
    дано ключ равно "map"
    ожидается запись «Требование» с «что» равным "map: один ответ при 1, 2, 8 и 64 потоках" и «выполнено» равным да
  пример «разошёлся один»
    дано вывод равно "map_1=7 9\nmap_2=7 9\nmap_8=7 8\nmap_64=7 9\n"
    дано ключ равно "map"
    ожидается запись «Требование» с «что» равным "map: один ответ при 1, 2, 8 и 64 потоках" и «выполнено» равным нет
  пусть один равно («Значение ключа» от вывод и (соединить ключ с "_1"))
  пусть все равно [«Значение ключа» от вывод и (соединить ключ с "_2"),
    «Значение ключа» от вывод и (соединить ключ с "_8"), «Значение ключа» от вывод и (соединить ключ с "_64")]
  пусть сошлись равно ((один не равен "") и притом (пусто (отфильтровать все где ответ → ответ не равен один)))
  «Требуется» от (соединить [ключ, ": один ответ при 1, 2, 8 и 64 потоках"] по "") и сошлись

тотальная функция «Ускорение»
  принимает вывод: строка
  возвращает число
  пример «восемь потоков в семь раз быстрее»
    дано вывод равно "ms_1=7000\nms_8=1000\n"
    ожидается 7
  пример «без замера ускорения нет»
    дано вывод равно "ms_1=7000\n"
    ожидается 0
  пусть база равно («Число ключа» от вывод и "ms_1")
  пусть восемь равно («Число ключа» от вывод и "ms_8")
  если восемь больше 0
    то база делить на восемь
    иначе 0

тотальная функция «Требования»
  принимает вывод: строка
  возвращает список «Требование»
  обеспечивает «требований двенадцать» (длина результат) равен 12
  пусть отказ равно («Значение ключа» от вывод и "refusal_text")
  пусть режет равно ((«Число ключа» от вывод и "fold_main") равен 1)
  пусть краснеет равно ((«Число ключа» от вывод и "tsan_forged") больше 0)
  [
    «Одинаково на потоках» от вывод и "map",
    «Одинаково на потоках» от вывод и "refusal",
    «Одинаково на потоках» от вывод и "sum",
    «Одинаково на потоках» от вывод и "grown",
    «Требуется» от "отказ по пределу шагов назван FLANG_RECURSION_LIMIT" и (отказ содержит "FLANG_RECURSION_LIMIT"),
    «Требуется» от "отображение печатается через fl_par_map" и ((«Число ключа» от вывод и "map_main") больше 0),
    «Требуется» от "свёртка по доказанному моноиду печатается через fl_par_fold" и режет,
    «Требуется» от "моноид над число не режет свёртку" и ((«Число ключа» от вывод и "fold_number") равен 0),
    «Требуется» от "моноид с ложной единицей не режет свёртку" и ((«Число ключа» от вывод и "fold_unit") равен 0),
    «Требуется» от "ThreadSanitizer молчит" и ((«Число ключа» от вывод и "tsan") равен 0),
    «Требуется» от "возвращённая запись из куска краснит ThreadSanitizer" и краснеет,
    «Требуется» от "восемь потоков быстрее одного не меньше чем в шесть раз" и ((«Ускорение» от вывод) не меньше 6)
  ]

тотальная функция «Отчёт»
  принимает вывод: строка
  возвращает строка
  пример «отчёт называет время и ускорение»
    дано вывод равно "ms_1=7000\nms_8=1000\ntsan=0\ntsan_forged=3\n"
    ожидается "1 поток 7000 мс, 8 потоков 1000 мс, ускорение 7; ThreadSanitizer 0, на подделке 3"
  соединить ["1 поток ", («Значение ключа» от вывод и "ms_1"), " мс, 8 потоков ", («Значение ключа» от вывод и "ms_8"),
    " мс, ускорение ", (к строке («Ускорение» от вывод)), "; ThreadSanitizer ", («Значение ключа» от вывод и "tsan"),
    ", на подделке ", («Значение ключа» от вывод и "tsan_forged")] по ""

тотальная функция «Приговор по выводу»
  принимает вывод: строка
  возвращает «Продолжение»
  пример «всё выполнено»
    дано вывод равно "map_1=1
map_2=1
map_8=1
map_64=1
refusal_1=2
refusal_2=2
refusal_8=2
refusal_64=2
sum_1=3
sum_2=3
sum_8=3
sum_64=3
grown_1=4
grown_2=4
grown_8=4
grown_64=4
refusal_text={\"ok\":false,\"code\":\"FLANG_RECURSION_LIMIT\"
map_main=1
fold_main=1
fold_number=0
fold_unit=0
tsan=0
tsan_forged=5
ms_1=6000
ms_8=900
"
    ожидается вариант «Конец работы» с значение равным "параллельный отобразить и свёртка по моноиду: требований 12
1 поток 6000 мс, 8 потоков 900 мс, ускорение 6.666666666666667; ThreadSanitizer 0, на подделке 5"
  пусть провалы равно (отфильтровать («Требования» от вывод) где т → не (т.«выполнено»))
  пусть отчёт равно («Отчёт» от вывод)
  пусть жалобы равно (соединить (приписать отчёт к (отобразить провалы как т → т.«что»)) по "\n  · ")
  пусть итог равно (соединить ["параллельный отобразить и свёртка по моноиду: требований 12\n", отчёт] по "")
  если пусто провалы
    то вариант «Конец работы» с значение равным итог
    иначе вариант «Провал» с код равным "FLANG_PARALLEL_GATE" и сообщение равным жалобы

тотальная функция «Приговор»
  принимает ответы: список «Answer»
  возвращает «Продолжение»
  пусть код равно («Exit code of» от "стенд" и ответы)
  пусть вывод равно («Output of» от "стенд" и ответы)
  пусть беда равно (соединить ["стенд не собран: ", вывод, («Errors of» от "стенд" и ответы)] по "")
  если код равен 0
    то «Приговор по выводу» от вывод
    иначе вариант «Не проверено» с код равным "FLANG_PARALLEL_UNBUILT" и сообщение равным беда

тотальная функция «Начать»
  возвращает «Inquiry»
  «Begin with» от 1

тотальная функция «Дальше»
  принимает inquiry: «Inquiry», отклик: «Отклик»
  возвращает «Продолжение»
  пусть ответы равно («Heard» от inquiry и отклик)
  если (inquiry.«stages») больше 0
    то «Ask» от («Run from» от "стенд" и "../../.." и "sh" и ["-c", («Сценарий»)]) и пустой список и 0 и ответы
    иначе «Приговор» от ответы

план «Проверка»
  состояние «Inquiry»
  начинает с «Начать»
  обрабатывает «Дальше»
