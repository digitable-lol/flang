модуль «Spread map gate»
  использует «Inquiry» из "../../../scripts/inquiry.fscript"

тотальная функция «Сценарий строками»
  возвращает список строки
  обеспечивает «строк сценария 37» (длина результат) равен 37
  [
    "set -u",
    "F=${FLANG:-bootstrap/flang}",
    "B=flang/concurrency/bench",
    "C=flang/src/emit/c",
    "R=$(mktemp -d \"${TMPDIR:-/tmp}/spread-map.XXXXXX\") || exit 1",
    "trap 'rm -rf \"$R\"' EXIT",
    "O='-std=c99 -Wall -Wextra -Werror -pedantic -O2 -DFL_SPREAD_WAIT_NS=0L -DFL_SPREAD_WORTH_NS=0L'",
    "$F emit \"$B/spread-map.flang\" --target c --out \"$R/main\" >/dev/null 2>&1",
    "[ -f \"$R/main/Makefile\" ] || { echo emit=main; exit 1; }",
    "cp \"$C/flang_runtime.c\" \"$C/flang_runtime.h\" \"$R/main/\"",
    "sed -i 's/fl_par_map(ctx/fl_spread_map(ctx/' \"$R/main/spread_map_bench.c\"",
    "grep -q 'fl_spread_map(ctx' \"$R/main/spread_map_bench.c\" || { echo spread=unprinted; exit 1; }",
    "cp -r \"$R/main\" \"$R/forged\"",
    "G=\"$R/forged/flang_runtime.c\"",
    "sed -i 's/\\&items\\[from + index\\], 0u)/\\&items[from + (rest - 1u - index)], 0u)/' \"$G\"",
    "grep -q 'rest - 1u - index' \"$G\" || { echo forged=unbuilt; exit 1; }",
    "for d in main forged; do make -s -C \"$R/$d\" CFLAGS=\"$O\" >/dev/null 2>&1 || { echo build=$d; exit 1; }; done",
    соединить [
      "req() { awk -v n=\"$1\" -v k=\"$2\" -v f=\"$3\" -v s=\"$4\" 'BEGIN { q = \"\\\"\"; ",
      "printf \"{%sfn%s:%sВсе пробы%s,%sargs%s:[{%sl%s:[\", q, q, q, q, q, q, q, q; ",
      "for (i = 0; i < n; i++) printf \"%s{%sn%s:%s%d%s}\", (i ? \",\" : \"\"), q, q, q, i, q; ",
      "printf \"]},{%sl%s:[\", q, q; ",
      "for (i = 0; i < k; i++) printf \"%s{%sn%s:%s%d%s}\", (i ? \",\" : \"\"), q, q, q, i % 5, q; ",
      "printf \"]},{%sl%s:[\", q, q; ",
      "for (i = 0; i < k; i++) printf \"%s{%sn%s:%s0.00%d%s}\", (i ? \",\" : \"\"), q, q, q, i % 97, q; ",
      "printf \"]},{%sn%s:%s%s%s}],%ssteps%s:%s%s%s}\\n\", q, q, q, f, q, q, q, q, s, q }'; }"
    ] по "",
    "req 300 100 -1 0 > \"$R/map\"; req 300 100 199.75 0 > \"$R/refusal\"; req 300 100 -1 100000 > \"$R/limit\"",
    "req 300 1000 -1 0 > \"$R/big\"",
    "run() { FLANG_JOBS=$1 \"$R/$2/flang_cli\" < \"$R/$3\" 2>/dev/null; }",
    "for t in 1 2 8 64; do",
    "  echo \"map_$t=$(run $t main map | cksum)\"",
    "  echo \"refusal_$t=$(run $t main refusal | cksum)\"",
    "  echo \"limit_$t=$(run $t main limit | cksum)\"",
    "done",
    "echo \"refusal_text=$(run 8 main refusal | head -c 120)\"",
    "echo \"limit_text=$(run 8 main limit | head -c 120)\"",
    "echo \"forged_8=$(run 8 forged map | cksum)\"",
    "FLANG_JOBS=8 \"$R/main/flang_cli\" < \"$R/big\" > \"$R/killed\" 2>/dev/null & p=$!",
    "c=; i=0; while [ -z \"$c\" ] && [ $i -lt 500 ]; do c=$(pgrep -P $p | head -n 1); i=$((i + 1)); sleep 0.01; done",
    "[ -n \"$c\" ] && kill -9 \"$c\"; wait $p",
    "echo \"killed_child=${c:-none}\"",
    "echo \"killed_8=$(cksum < \"$R/killed\")\"",
    соединить [
      "ms() { s=$(date +%s%N); run $1 main big > \"$R/ms_$1\"; e=$(date +%s%N); echo ",
      "$(( (e - s) / 1000000 )); }"
    ] по "",
    "echo \"ms_1=$(ms 1)\"; echo \"ms_8=$(ms 8)\"",
    "echo \"killed_1=$(cksum < \"$R/ms_1\")\""
  ]

тотальная функция «Сценарий»
  возвращает строка
  обеспечивает «сценарий начинается с set -u» результат начинается с "set -u"
  соединить («Сценарий строками») по "\n"

тотальная функция «Значение строки»
  принимает строка: строка, ключ: строка
  возвращает строка
  пример «значение после знака равенства»
    дано строка равно "ms_8=640"
    дано ключ равно "ms_8"
    ожидается "640"
  пример «чужой ключ не даёт ничего»
    дано строка равно "ms_1=5000"
    дано ключ равно "ms_8"
    ожидается ""
  если строка начинается с (соединить ключ с "=")
    то соединить (хвост (разделить строка по "=")) по "="
    иначе ""

тотальная функция «Значение ключа»
  принимает вывод: строка, ключ: строка
  возвращает строка
  пример «ключ находится среди строк»
    дано вывод равно "map_1=1\nms_8=2\n"
    дано ключ равно "ms_8"
    ожидается "2"
  пусть строки равно (разделить вывод по "\n")
  свёртка строки начиная с "" как найдено и строка → соединить найдено с («Значение строки» от строка и ключ)

тотальная функция «Число ключа»
  принимает вывод: строка, ключ: строка
  возвращает число
  пример «нет числа — минус единица»
    дано вывод равно "ms_8=\n"
    дано ключ равно "ms_8"
    ожидается -1
  разбор (к числу или беда («Значение ключа» от вывод и ключ))
    случай вариант «Разобрано» с значение как значение
      то значение
    случай вариант «Не разобрано» с код как код и сообщение как сообщение
      то -1

объект «Требование»
  «что»: строка
  «выполнено»: признак

тотальная функция «Требуется»
  принимает что: строка, выполнено: признак
  возвращает «Требование»
  запись «Требование» с «что» равным что и «выполнено» равным выполнено

тотальная функция «Одинаково у работников»
  принимает вывод: строка, ключ: строка
  возвращает «Требование»
  пример «четыре одинаковых ответа»
    дано вывод равно "map_1=7 9\nmap_2=7 9\nmap_8=7 9\nmap_64=7 9\n"
    дано ключ равно "map"
    ожидается запись «Требование» с «что» равным "map: один ответ при 1, 2, 8 и 64 работниках" и «выполнено» равным да
  пример «разошёлся один»
    дано вывод равно "map_1=7 9\nmap_2=7 9\nmap_8=7 8\nmap_64=7 9\n"
    дано ключ равно "map"
    ожидается запись «Требование» с «что» равным "map: один ответ при 1, 2, 8 и 64 работниках" и «выполнено» равным нет
  пусть один равно («Значение ключа» от вывод и (соединить ключ с "_1"))
  пусть все равно [«Значение ключа» от вывод и (соединить ключ с "_2"),
    «Значение ключа» от вывод и (соединить ключ с "_8"), «Значение ключа» от вывод и (соединить ключ с "_64")]
  пусть сошлись равно ((один не равен "") и притом (пусто (отфильтровать все где ответ → ответ не равен один)))
  «Требуется» от (соединить [ключ, ": один ответ при 1, 2, 8 и 64 работниках"] по "") и сошлись

тотальная функция «Ускорение»
  принимает вывод: строка
  возвращает число
  пример «восемь работников в пять раз быстрее»
    дано вывод равно "ms_1=5000\nms_8=1000\n"
    ожидается 5
  пример «без замера ускорения нет»
    дано вывод равно "ms_1=7000\n"
    ожидается 0
  пусть база равно («Число ключа» от вывод и "ms_1")
  пусть восемь равно («Число ключа» от вывод и "ms_8")
  если восемь больше 0
    то база делить на восемь
    иначе 0

тотальная функция «Требования»
  принимает вывод: строка
  возвращает список «Требование»
  обеспечивает «требований девять» (длина результат) равен 9
  пусть один равно («Значение ключа» от вывод и "map_1")
  пусть подделка равно («Значение ключа» от вывод и "forged_8")
  пусть убит равно («Значение ключа» от вывод и "killed_8")
  пусть порядок равно («Значение ключа» от вывод и "killed_1")
  пусть отказ равно («Значение ключа» от вывод и "refusal_text")
  пусть предел равно («Значение ключа» от вывод и "limit_text")
  пусть краснеет равно ((подделка не равен "") и притом (подделка не равен один))
  пусть устоял равно ((убит не равен "") и притом (убит равен порядок))
  [
    «Одинаково у работников» от вывод и "map",
    «Одинаково у работников» от вывод и "refusal",
    «Одинаково у работников» от вывод и "limit",
    «Требуется» от "отказ элемента назван своим кодом" и (отказ содержит "FLANG_PROPERTY"),
    «Требуется» от "предел шагов назван FLANG_RECURSION_LIMIT" и (предел содержит "FLANG_RECURSION_LIMIT"),
    «Требуется» от "ответы по приходу вместо номера дают другой ответ" и краснеет,
    «Требуется» от "убитый работник не меняет ответа" и ((«Значение ключа» от вывод и "killed_child") не равен "none"),
    «Требуется» от "после убитого работника ответ тот же, что по порядку" и устоял,
    «Требуется» от "восемь работников быстрее одного не меньше чем в четыре раза" и ((«Ускорение» от вывод) не меньше 4)
  ]

тотальная функция «Отчёт»
  принимает вывод: строка
  возвращает строка
  пример «отчёт называет время и ускорение»
    дано вывод равно "ms_1=5000\nms_8=1000\n"
    ожидается "1 работник 5000 мс, 8 работников 1000 мс, ускорение 5"
  соединить ["1 работник ", («Значение ключа» от вывод и "ms_1"), " мс, 8 работников ",
    («Значение ключа» от вывод и "ms_8"),
    " мс, ускорение ", (к строке («Ускорение» от вывод))] по ""

тотальная функция «Приговор по выводу»
  принимает вывод: строка
  возвращает «Продолжение»
  пусть провалы равно (отфильтровать («Требования» от вывод) где т → не (т.«выполнено»))
  пусть отчёт равно («Отчёт» от вывод)
  пусть жалобы равно (соединить (приписать отчёт к (отобразить провалы как т → т.«что»)) по "\n  · ")
  если пусто провалы
    то вариант «Конец работы» с значение равным (соединить ["раздача по работникам: требований 9\n", отчёт] по "")
    иначе вариант «Провал» с код равным "FLANG_SPREAD_GATE" и сообщение равным жалобы

тотальная функция «Приговор»
  принимает ответы: список «Answer»
  возвращает «Продолжение»
  пусть код равно («Exit code of» от "стенд" и ответы)
  пусть вывод равно («Output of» от "стенд" и ответы)
  пусть беда равно (соединить ["стенд не собран: ", вывод, («Errors of» от "стенд" и ответы)] по "")
  если код равен 0
    то «Приговор по выводу» от вывод
    иначе вариант «Не проверено» с код равным "FLANG_SPREAD_UNBUILT" и сообщение равным беда

тотальная функция «Начать»
  возвращает «Inquiry»
  «Begin with» от 1

тотальная функция «Дальше»
  принимает inquiry: «Inquiry», отклик: «Отклик»
  возвращает «Продолжение»
  пусть ответы равно («Heard» от inquiry и отклик)
  если (inquiry.«stages») больше 0
    то «Ask» от («Run from» от "стенд" и "../../.." и "sh" и ["-c", («Сценарий»)]) и пустой список и 0 и ответы
    иначе «Приговор» от ответы

план «Проверка»
  состояние «Inquiry»
  начинает с «Начать»
  обрабатывает «Дальше»
