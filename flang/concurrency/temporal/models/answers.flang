модуль «Temporal answers»
  использует «Temporal explore» из "../explore.flang"
  использует «Temporal liveness» из "../liveness.flang"
  использует «Temporal model rally» из "rally.flang"
  использует «Temporal model deadlock» из "deadlock.flang"
  использует «Temporal model overflow» из "overflow.flang"
  использует «Temporal model lost letter» из "lost-letter.flang"
  использует «Temporal model fairness» из "fairness.flang"

тотальная функция «Мяч возвращается к подаче»
  возвращает «Свойство ответа»
  пример «Свойство записано деревом условий»
    ожидается (запись «Свойство ответа» с «имя» равным "мяч возвращается к подаче" и «ответ» равным (вариант «После» с
        повод равным (вариант «В состоянии» с кто равным "Подающий" и этап равным "ждёт") и цель равным (
        вариант «В состоянии» с кто равным "Подающий" и этап равным "подаёт")))
  (запись «Свойство ответа» с «имя» равным "мяч возвращается к подаче" и «ответ» равным (вариант «После» с
      повод равным (вариант «В состоянии» с кто равным "Подающий" и этап равным "ждёт") и цель равным (
      вариант «В состоянии» с кто равным "Подающий" и этап равным "подаёт")))

тотальная функция «Клиент получает ответ»
  возвращает «Свойство ответа»
  пример «Свойство записано деревом условий»
    ожидается (запись «Свойство ответа» с «имя» равным "клиент получает ответ" и «ответ» равным (вариант «После» с
        повод равным (вариант «В состоянии» с кто равным "Клиент" и этап равным "ждёт ответа") и цель равным (
        вариант «В состоянии» с кто равным "Клиент" и этап равным "получил")))
  (запись «Свойство ответа» с «имя» равным "клиент получает ответ" и «ответ» равным (вариант «После» с
      повод равным (вариант «В состоянии» с кто равным "Клиент" и этап равным "ждёт ответа") и цель равным (
      вариант «В состоянии» с кто равным "Клиент" и этап равным "получил")))

тотальная функция «Поручение исполняется»
  возвращает «Свойство ответа»
  пример «Свойство записано деревом условий»
    ожидается (запись «Свойство ответа» с «имя» равным "поручение исполняется" и «ответ» равным (вариант «После» с
        повод равным (вариант «В состоянии» с кто равным "Начальник" и этап равным "поручил") и цель равным (
        вариант «В состоянии» с кто равным "Работник" и этап равным "сделал")))
  (запись «Свойство ответа» с «имя» равным "поручение исполняется" и «ответ» равным (вариант «После» с
      повод равным (вариант «В состоянии» с кто равным "Начальник" и этап равным "поручил") и цель равным (
      вариант «В состоянии» с кто равным "Работник" и этап равным "сделал")))

тотальная функция «Работа делается»
  возвращает «Свойство ответа»
  пример «Свойство записано деревом условий»
    ожидается (запись «Свойство ответа» с «имя» равным "работа делается" и «ответ» равным (вариант «Когда-нибудь» с
        цель равным (вариант «В состоянии» с кто равным "Работник" и этап равным "сделал")))
  (запись «Свойство ответа» с «имя» равным "работа делается" и «ответ» равным (вариант «Когда-нибудь» с
      цель равным (вариант «В состоянии» с кто равным "Работник" и этап равным "сделал")))

тотальная функция «Насос жив хоть раз»
  возвращает «Свойство ответа»
  пример «Свойство записано деревом условий»
    ожидается (запись «Свойство ответа» с «имя» равным "насос жив хоть раз" и «ответ» равным (вариант «Когда-нибудь» с
        цель равным (вариант «Жив» с кто равным "Насос")))
  (запись «Свойство ответа» с «имя» равным "насос жив хоть раз" и «ответ» равным (вариант «Когда-нибудь» с
      цель равным (вариант «Жив» с кто равным "Насос")))

тотальная функция «Перебор: мяч возвращается к подаче»
  возвращает «Вердикт ответа»
  пример «Мяч ходит по кругу и к подаче не возвращается»
    ожидается (вариант «Без ответа» с имя равным "мяч возвращается к подаче" и путь равным [(
        запись «Шаг» с «процесс» равным "Подающий" и «письмо» равным "старт" и «из» равным "подаёт" и
        «в» равным "ждёт" и «итог» равным "отправлено Отбивающий мяч")] и петля равным [(
        запись «Шаг» с «процесс» равным "Отбивающий" и «письмо» равным "мяч" и «из» равным "стоит" и
        «в» равным "стоит" и «итог» равным "отправлено Подающий мяч"), (
        запись «Шаг» с «процесс» равным "Подающий" и «письмо» равным "мяч" и «из» равным "ждёт" и
        «в» равным "ждёт" и «итог» равным "отправлено Отбивающий мяч"), (
        запись «Шаг» с «процесс» равным "Отбивающий" и «письмо» равным "мяч" и «из» равным "стоит" и
        «в» равным "стоит" и «итог» равным "отправлено Подающий мяч"), (
        запись «Шаг» с «процесс» равным "Подающий" и «письмо» равным "мяч" и «из» равным "ждёт" и
        «в» равным "ждёт" и «итог» равным "отправлено Отбивающий мяч")])
  «Перебрать ответ» от («Модель подачи») и («Мяч возвращается к подаче») и 20

тотальная функция «Перебор: клиент получает ответ»
  возвращает «Вердикт ответа»
  пример «Запрос во время учёта снят, и всё останавливается без ответа»
    ожидается (вариант «Без ответа» с имя равным "клиент получает ответ" и путь равным [(
        запись «Шаг» с «процесс» равным "Ревизор" и «письмо» равным "старт" и «из» равным "ждёт" и
        «в» равным "считает" и «итог» равным "отправлено Склад учёт; отправлено Ревизор счёт"), (
        запись «Шаг» с «процесс» равным "Клиент" и «письмо» равным "старт" и «из» равным "готов" и
        «в» равным "ждёт ответа" и «итог» равным "отправлено Склад запрос"), (
        запись «Шаг» с «процесс» равным "Склад" и «письмо» равным "учёт" и «из» равным "открыт" и
        «в» равным "на учёте" и «итог» равным "принято"), (
        запись «Шаг» с «процесс» равным "Склад" и «письмо» равным "запрос" и «из» равным "на учёте" и
        «в» равным "на учёте" и «итог» равным "без правила"), (
        запись «Шаг» с «процесс» равным "Ревизор" и «письмо» равным "счёт" и «из» равным "считает" и
        «в» равным "закончил" и «итог» равным "отправлено Склад конец учёта"), (
        запись «Шаг» с «процесс» равным "Склад" и «письмо» равным "конец учёта" и «из» равным "на учёте" и
        «в» равным "открыт" и «итог» равным "принято")] и петля равным пустой список)
  «Перебрать ответ» от («Модель склада») и («Клиент получает ответ») и 20

тотальная функция «Перебор: поручение исполняется»
  возвращает «Вердикт ответа»
  пример «Работник остановился, поручение так и не исполнено»
    ожидается (вариант «Без ответа» с имя равным "поручение исполняется" и путь равным [(
        запись «Шаг» с «процесс» равным "Начальник" и «письмо» равным "старт" и «из» равным "ждёт" и
        «в» равным "поручил" и «итог» равным "отправлено Работник задание"), (
        запись «Шаг» с «процесс» равным "Работник" и «письмо» равным "стоп" и «из» равным "свободен" и
        «в» равным "свободен" и «итог» равным "остановился")] и петля равным пустой список)
  «Перебрать ответ» от («Модель поручения») и («Поручение исполняется») и 20

тотальная функция «Перебор: работа делается»
  возвращает «Вердикт ответа»
  пример «При справедливости болтун не заслоняет работника»
    ожидается (вариант «Ответ есть» с итог равным (запись «Перебрано» с «свойство» равным "работа делается" и
        «глубина» равным 1 и «состояний» равным 2 и «целиком» равным да))
  «Перебрать ответ» от («Модель болтуна») и («Работа делается») и 20

тотальная функция «Перебор: насос жив хоть раз»
  возвращает «Вердикт ответа»
  пример «Неограниченный сток — перебор только до границы»
    ожидается (вариант «Ответ есть» с итог равным (запись «Перебрано» с «свойство» равным "насос жив хоть раз" и
        «глубина» равным 12 и «состояний» равным 24 и «целиком» равным нет))
  «Перебрать ответ» от («Модель насоса» от 0) и («Насос жив хоть раз») и 12
