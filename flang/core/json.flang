// ─────────────────────────────── документ ───────────────────────────────

// Порядок ключей — из `src/parser.ts` (`parseDocument`) и `normalizeDocument`:
// category, structures, functors, proposition, ts_compat и, если утилиты
// в документе есть, utilities последним.
тотальная функция «Печать документа»
  принимает «документ»: «Документ»
  возвращает строка
  обеспечивает «напечатанный документ — объект, то есть не короче двух знаков» 2 не больше (длина результат)
  пример «Пустой документ — пять обязательных ключей и ни одной утилиты»
    дано «документ» равно запись «Документ» с «категория» равным "" и «структуры» равным пустой список и «функторы» равным пустой список и «утверждение» равным (вариант «Нет утверждения») и «совместимость» равным пустой список и «утилиты» равным (вариант «Нет утилит»)
    ожидается "{\"category\":\"\",\"structures\":[],\"functors\":[],\"proposition\":null,\"ts_compat\":{}}"
  «Печать объекта» от [
    («Печать поля» от "category" и («Печать строки» от («документ».«категория»))),
    («Печать поля» от "structures" и («Печать массива» от (отобразить («документ».«структуры») как «структура» → «Печать структуры» от «структура»))),
    («Печать поля» от "functors" и («Печать массива» от (отобразить («документ».«функторы») как «функтор» → «Печать функтора» от «функтор»))),
    («Печать поля» от "proposition" и («Печать необязательного утверждения» от («документ».«утверждение»))),
    («Печать поля» от "ts_compat" и («Печать объекта» от (отобразить («документ».«совместимость») как «пара» → «Печать пары» от «пара»))),
    («Печать необязательных утилит» от («документ».«утилиты»))
  ]
