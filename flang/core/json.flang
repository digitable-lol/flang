  возвращает строка
  обеспечивает «напечатанный операнд — объект, то есть не короче двух знаков» 2 не больше (длина результат)
  пример «Операнд-результат — один ключ»
    дано «операнд» равно вариант «Результат операнда»
    ожидается "{\"kind\":\"result\"}"
  разбор «операнд»
    случай вариант «Значение операнда» с «скаляр» как «скаляр»
      то «Печать объекта» от [
        («Печать поля» от "kind" и («Печать строки» от "value")),
        («Печать поля» от "value" и («Печать скаляра» от «скаляр»))
      ]
    случай вариант «Поле операнда» с «поле» как «поле»
      то «Печать объекта» от [
        («Печать поля» от "kind" и («Печать строки» от "field")),
        («Печать поля» от "field" и («Печать строки» от «поле»))
      ]
    случай вариант «Процент операнда» с «процент» как «процент», «поле» как «поле»
      то «Печать объекта» от [
        («Печать поля» от "kind" и («Печать строки» от "percent")),
        («Печать поля» от "percent" и («Печать числа» от «процент»)),
        («Печать поля» от "field" и («Печать строки» от «поле»))
      ]
    случай «Результат операнда»
      то «Печать объекта» от [(«Печать поля» от "kind" и («Печать строки» от "result"))]

тотальная функция «Печать условия»
  принимает «условие»: «Условие»
  возвращает строка
  обеспечивает «напечатанный объект — это фигурные скобки плюс нутро, то есть не короче двух знаков» 2 не больше (длина результат)
