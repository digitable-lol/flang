модуль «Russian pregroup category»
  использует «Russian pregroup» из "pregroup.flang"
  использует «Russian parser» из "parse.flang"

тотальная функция «Типы равны»
  принимает первый: «Тип», второй: «Тип»
  возвращает признак
  первый равен второй

тотальная функция «Свернуть»
  принимает т: «Тип»
  возвращает «Тип»
  «Свернуть первую пару» от т

тотальная функция «Забыть согласование»
  принимает т: «Тип»
  возвращает «Тип»
  «Стереть согласование» от т

тотальная функция «Забыть падеж»
  принимает т: «Тип»
  возвращает «Тип»
  «Стереть падеж» от т

морфизм «свернуть» из «Тип» в «Тип»
  даёт «Свернуть»
  закон «подлежащее сокращается с глаголом, остаётся s»
    пример «мама спит»
      дано т равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
        и лицо равным "3" и сопряжение равным 0), (запись «Простой тип» с вид равным "n" и падеж равным "им"
        и род равным "*" и число равным "ед" и лицо равным "3" и сопряжение равным 1),
        (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*" и лицо равным "*"
        и сопряжение равным 0)]
      ожидается [(запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*"
        и лицо равным "*" и сопряжение равным 0)]
  закон «где сокращать нечего, тип не меняется»
    пример «мама спят»
      дано т равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
        и лицо равным "3" и сопряжение равным 0), (запись «Простой тип» с вид равным "n" и падеж равным "им"
        и род равным "*" и число равным "мн" и лицо равным "3" и сопряжение равным 1),
        (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*" и лицо равным "*"
        и сопряжение равным 0)]
      ожидается [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
        и лицо равным "3" и сопряжение равным 0), (запись «Простой тип» с вид равным "n" и падеж равным "им"
        и род равным "*" и число равным "мн" и лицо равным "3" и сопряжение равным 1),
        (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*" и лицо равным "*"
        и сопряжение равным 0)]

морфизм «забыть согласование» из «Тип» в «Тип»
  даёт «Забыть согласование»
  закон «род, число и лицо уходят, падеж остаётся»
    пример «мама»
      дано т равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
        и лицо равным "3" и сопряжение равным 0)]
      ожидается [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "*"
        и лицо равным "*" и сопряжение равным 0)]

морфизм «забыть падеж» из «Тип» в «Тип»
  даёт «Забыть падеж»
  закон «падеж уходит, сопряжение остаётся»
    пример «книгу как дополнение глагола»
      дано т равно [(запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "*" и число равным "*"
        и лицо равным "*" и сопряжение равным -1)]
      ожидается [(запись «Простой тип» с вид равным "n" и падеж равным "*" и род равным "*" и число равным "*"
        и лицо равным "*" и сопряжение равным -1)]

морфизм «свернуть без согласования» это «свернуть» после «забыть согласование»

морфизм «забыть всё» это «забыть падеж» после «забыть согласование»

единица «Тип»

категория «Свёртки типов»
  морфизм «свернуть»
  морфизм «забыть согласование»
  морфизм «забыть падеж»
  морфизм «свернуть без согласования»
  морфизм «забыть всё»
  объект «Тип» даёт «Типы равны»

моноид «Умножение типов»
  носитель «Тип»
  операция «Произведение типов»
  единица пустой список

тотальная функция «Произведение ассоциативно»
  принимает а: «Тип», б: «Тип», г: «Тип»
  возвращает признак
  обеспечивает «моноид: скобки при умножении типов не важны» результат равен да
  пример «n, s и qʳ»
    дано а равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 0)]
    дано б равно [(запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 0)]
    дано г равно [(запись «Простой тип» с вид равным "q" и падеж равным "*" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 1)]
    ожидается да
  пример «пустой тип в середине»
    дано а равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 0)]
    дано б равно пустой список
    дано г равно [(запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 0)]
    ожидается да
  («Типы равны» от («Произведение типов» от («Произведение типов» от а и б) и г) и («Произведение типов» от а
    и («Произведение типов» от б и г)))

тотальная функция «Единица нейтральна»
  принимает а: «Тип»
  возвращает признак
  обеспечивает «моноид: пустой тип — единица умножения» результат равен да
  пример «тип переходного глагола»
    дано а равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
      и лицо равным "3" и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*"
      и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 0),
      (запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "*" и число равным "*" и лицо равным "*"
      и сопряжение равным -1)]
    ожидается да
  ((«Типы равны» от («Произведение типов» от пустой список и а) и а)
    и притом («Типы равны» от («Произведение типов» от а и пустой список) и а))

тотальная функция «Сопряжения взаимно обратны»
  принимает а: «Тип»
  возвращает признак
  обеспечивает «прегруппа: правое от левого и левое от правого возвращают тип» результат равен да
  пример «тип переходного глагола»
    дано а равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
      и лицо равным "3" и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*"
      и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 0),
      (запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "*" и число равным "*" и лицо равным "*"
      и сопряжение равным -1)]
    ожидается да
  ((«Типы равны» от («Правое сопряжённое» от («Левое сопряжённое» от а)) и а)
    и притом («Типы равны» от («Левое сопряжённое» от («Правое сопряжённое» от а)) и а))

тотальная функция «Сопряжение переворачивает произведение»
  принимает а: «Тип», б: «Тип»
  возвращает признак
  обеспечивает «прегруппа: (а · б)ˡ = бˡ · аˡ и (а · б)ʳ = бʳ · аʳ» результат равен да
  пример «подлежащее и дополнение»
    дано а равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
      и лицо равным "3" и сопряжение равным 0)]
    дано б равно [(запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 0), (запись «Простой тип» с вид равным "s" и падеж равным "*"
      и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 1)]
    ожидается да
  пусть левое_верно равно («Типы равны» от («Левое сопряжённое» от («Произведение типов» от а и б))
    и («Произведение типов» от («Левое сопряжённое» от б) и («Левое сопряжённое» от а)))
  (левое_верно и притом («Типы равны» от («Правое сопряжённое» от («Произведение типов» от а и б))
    и («Произведение типов» от («Правое сопряжённое» от б) и («Правое сопряжённое» от а))))

тотальная функция «Сопряжённые сокращаются»
  принимает п: «Простой тип»
  возвращает признак
  обеспечивает «прегруппа: аˡ · а → 1 и а · аʳ → 1» результат равен да
  пример «винительный»
    дано п равно (запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "ж" и число равным "ед"
      и лицо равным "3" и сопряжение равным 0)
    ожидается да
  пример «уже левое сопряжённое»
    дано п равно (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным -1)
    ожидается да
  («Сокращаются» от («Сопряжённый» от п и -1) и п) и притом («Сокращаются» от п и («Сопряжённый» от п и 1))

тотальная функция «Забывание — гомоморфизм»
  принимает а: «Тип», б: «Тип»
  возвращает признак
  обеспечивает «забывание согласования и падежа сохраняет умножение и сопряжения» результат равен да
  пример «подлежащее и глагол»
    дано а равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
      и лицо равным "3" и сопряжение равным 0)]
    дано б равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "мн"
      и лицо равным "3" и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*"
      и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 0)]
    ожидается да
  пусть произведение_верно равно («Типы равны»
    от («Забыть падеж» от («Забыть согласование» от («Произведение типов» от а и б)))
    и («Произведение типов» от («Забыть падеж» от («Забыть согласование» от а))
    и («Забыть падеж» от («Забыть согласование» от б))))
  (произведение_верно и притом («Типы равны» от («Забыть согласование» от («Левое сопряжённое» от а))
    и («Левое сопряжённое» от («Забыть согласование» от а))))

тотальная функция «Забывание сохраняет свёртку»
  принимает а: «Тип»
  возвращает признак
  обеспечивает «что сворачивалось до забывания, сворачивается и после» результат равен да
  пример «мама спит»
    дано а равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
      и лицо равным "3" и сопряжение равным 0), (запись «Простой тип» с вид равным "n" и падеж равным "им"
      и род равным "*" и число равным "ед" и лицо равным "3" и сопряжение равным 1),
      (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*" и лицо равным "*"
      и сопряжение равным 0)]
    ожидается да
  пример «мама спят: до забывания не сворачивалось, обещание не нарушено»
    дано а равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
      и лицо равным "3" и сопряжение равным 0), (запись «Простой тип» с вид равным "n" и падеж равным "им"
      и род равным "*" и число равным "мн" и лицо равным "3" и сопряжение равным 1),
      (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*" и лицо равным "*"
      и сопряжение равным 0)]
    ожидается да
  если (длина («Свернуть» от а)) меньше (длина а)
    то (длина («Свернуть» от («Забыть падеж» от («Забыть согласование» от а)))) меньше (длина а)
    иначе да
