   «Существительное» от "письмо" и ["им с ед", "вин с ед"],
   «Существительное» от "письма" и ["род с ед", "им * мн", "вин * мн"],
   «Существительное» от "письме" и ["предл с ед"],
   «Существительное» от "окно" и ["им с ед", "вин с ед"],
   «Существительное» от "окне" и ["предл с ед"],
   «Существительное» от "дети" и ["им * мн"],
   «Существительное» от "детям" и ["дат * мн"]]

тотальная функция «Местоимения»
  возвращает список «Статья»
  [«Местоимение» от "я" и ["им м ед 1", "им ж ед 1"],
   «Местоимение» от "ты" и ["им м ед 2", "им ж ед 2"],
   «Местоимение» от "он" и ["им м ед 3"],
   «Местоимение» от "она" и ["им ж ед 3"],
   «Местоимение» от "мы" и ["им * мн 1"],
   «Местоимение» от "они" и ["им * мн 3"],
   «Местоимение» от "меня" и ["род * ед 1", "вин * ед 1"],
   «Местоимение» от "его" и ["род м ед 3", "вин м ед 3"],
   «Местоимение» от "её" и ["род ж ед 3", "вин ж ед 3"],
   «Местоимение» от "ему" и ["дат м ед 3"]]

тотальная функция «Глаголы»
  возвращает список «Статья»
  [«Переходный» от "читаю" и («Подлежащее настоящего» от "ед" и "1") и "вин",
   «Переходный» от "читаешь" и («Подлежащее настоящего» от "ед" и "2") и "вин",
   «Переходный» от "читает" и («Подлежащее настоящего» от "ед" и "3") и "вин",
   «Переходный» от "читаем" и («Подлежащее настоящего» от "мн" и "1") и "вин",
   «Переходный» от "читают" и («Подлежащее настоящего» от "мн" и "3") и "вин",
   «Переходный» от "читал" и («Подлежащее прошедшего» от "м" и "ед") и "вин",
   «Переходный» от "читала" и («Подлежащее прошедшего» от "ж" и "ед") и "вин",
   «Переходный» от "читали" и («Подлежащее прошедшего» от "*" и "мн") и "вин",
   «Переходный» от "видит" и («Подлежащее настоящего» от "ед" и "3") и "вин",
   «Переходный» от "видят" и («Подлежащее настоящего» от "мн" и "3") и "вин",
   «Переходный» от "видел" и («Подлежащее прошедшего» от "м" и "ед") и "вин",
   «Переходный» от "видела" и («Подлежащее прошедшего» от "ж" и "ед") и "вин",
   «Переходный» от "любит" и («Подлежащее настоящего» от "ед" и "3") и "вин",
   «Переходный» от "любят" и («Подлежащее настоящего» от "мн" и "3") и "вин",
   «Переходный» от "пишет" и («Подлежащее настоящего» от "ед" и "3") и "вин",
   «Переходный» от "пишут" и («Подлежащее настоящего» от "мн" и "3") и "вин",
   «Переходный» от "писала" и («Подлежащее прошедшего» от "ж" и "ед") и "вин",
   «Переходный» от "помогает" и («Подлежащее настоящего» от "ед" и "3") и "дат",
   «Переходный» от "помогают" и («Подлежащее настоящего» от "мн" и "3") и "дат",
   «Непереходный» от "сплю" и («Подлежащее настоящего» от "ед" и "1"),
   «Непереходный» от "спит" и («Подлежащее настоящего» от "ед" и "3"),
   «Непереходный» от "спят" и («Подлежащее настоящего» от "мн" и "3"),
   «Непереходный» от "спал" и («Подлежащее прошедшего» от "м" и "ед"),
   «Непереходный» от "спала" и («Подлежащее прошедшего» от "ж" и "ед"),
   «Непереходный» от "спали" и («Подлежащее прошедшего» от "*" и "мн"),
   «Непереходный» от "гуляет" и («Подлежащее настоящего» от "ед" и "3"),
   «Непереходный» от "гуляют" и («Подлежащее настоящего» от "мн" и "3"),
   «Непереходный» от "гуляла" и («Подлежащее прошедшего» от "ж" и "ед"),
   «Дательный и винительный» от "даёт" и («Подлежащее настоящего» от "ед" и "3"),
   «Дательный и винительный» от "дают" и («Подлежащее настоящего» от "мн" и "3"),
   «Дательный и винительный» от "дала" и («Подлежащее прошедшего» от "ж" и "ед")]

тотальная функция «Прилагательные»
  возвращает список «Статья»
  [«Прилагательное» от "новый" и ["им м ед", "вин м ед"],
   «Прилагательное» от "новая" и ["им ж ед"],
   «Прилагательное» от "новое" и ["им с ед", "вин с ед"],
   «Прилагательное» от "новую" и ["вин ж ед"],
   «Прилагательное» от "нового" и ["род м ед", "род с ед", "вин м ед"],
   «Прилагательное» от "новой" и ["род ж ед", "дат ж ед", "предл ж ед"],
   «Прилагательное» от "новом" и ["предл м ед", "предл с ед"],
   «Прилагательное» от "новые" и ["им * мн", "вин * мн"],
   «Прилагательное» от "большой" и ["им м ед", "вин м ед", "род ж ед", "дат ж ед", "предл ж ед"],
   «Прилагательное» от "большая" и ["им ж ед"],
   «Прилагательное» от "большую" и ["вин ж ед"],
   «Прилагательное» от "большое" и ["им с ед", "вин с ед"],
   «Прилагательное» от "большом" и ["предл м ед", "предл с ед"],
   «Прилагательное» от "большие" и ["им * мн", "вин * мн"],
   «Прилагательное» от "старый" и ["им м ед", "вин м ед"],
   «Прилагательное» от "старая" и ["им ж ед"],
   «Прилагательное» от "старую" и ["вин ж ед"],
   «Прилагательное» от "старом" и ["предл м ед", "предл с ед"],
   «Прилагательное» от "маленький" и ["им м ед", "вин м ед"],
   «Прилагательное» от "маленькая" и ["им ж ед"]]

тотальная функция «Предлоги»
  возвращает список «Статья»
  [«Предлог» от "в" и "предл",
   «Предлог» от "на" и "предл",
   «Предлог» от "о" и "предл",
   «Предлог» от "к" и "дат"]

тотальная функция «Словарь»
  возвращает список «Статья»
  («Склеить списки» от («Склеить списки» от («Существительные») и («Местоимения»))
    и («Склеить списки» от («Склеить списки» от («Глаголы») и («Прилагательные»)) и («Предлоги»)))

тотальная функция «Статьи слова»
  принимает словарь: список «Статья», слово: строка
  возвращает список «Статья»
  отфильтровать словарь где статья → статья.слово равен слово
