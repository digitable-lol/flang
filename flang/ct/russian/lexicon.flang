модуль «Russian lexicon»
  использует «Pregroup» из "../pregroup.flang"

объект «Статья»
  слово является строкой
  часть является строкой
  типы является список «Тип»

объект «Разрез»
  лево является «Тип»
  право является «Тип»

тотальная функция «Подлежащее настоящего»
  принимает число: строка, лицо: строка
  возвращает «Простой тип»
  пример «читает ждёт подлежащее единственного числа третьего лица, род не важен»
    дано число равно "ед"
    дано лицо равно "3"
    ожидается (запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
      и лицо равным "3" и сопряжение равным 0)
  «Именная» от "им" и "*" и число и лицо

тотальная функция «Подлежащее прошедшего»
  принимает род: строка, число: строка
  возвращает «Простой тип»
  пример «читала ждёт подлежащее женского рода, лицо не важно»
    дано род равно "ж"
    дано число равно "ед"
    ожидается (запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
      и лицо равным "*" и сопряжение равным 0)
  «Именная» от "им" и род и число и "*"

тотальная функция «Дополнение»
  принимает падеж: строка
  возвращает «Простой тип»
  пример «прямое дополнение в винительном, остальное не важно»
    дано падеж равно "вин"
    ожидается (запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 0)
  «Именная» от падеж и "*" и "*" и "*"

тотальная функция «Вставки»
  принимает новый: «Простой тип», т: «Тип»
  возвращает список «Тип»
  разбор т
    случай пусто
      то [[новый]]
    случай голова и хвост
      то (приписать (приписать новый к т) к (отобразить («Вставки» от новый
        и хвост) как вставка → приписать голова к вставка))

тотальная функция «Перестановки»
  принимает т: «Тип»
  возвращает список «Тип»
  разбор т
    случай пусто
      то [пустой список]
    случай голова и хвост
      то (свёртка («Перестановки» от хвост) начиная с пустой список как итог и п → «Склеить списки» от итог
        и («Вставки» от голова и п))

тотальная функция «Разрезы»
  принимает т: «Тип»
  возвращает список «Разрез»
  разбор т
    случай пусто
      то [запись «Разрез» с лево равным пустой список и право равным пустой список]
    случай голова и хвост
      то (приписать (запись «Разрез» с лево равным пустой список
        и право равным т) к (отобразить («Разрезы» от хвост)
        как р → запись «Разрез» с лево равным (приписать голова к р.лево) и право равным р.право))

тотальная функция «Тип глагола при разрезе»
  принимает разрез: «Разрез»
  возвращает «Тип»
  пример «подлежащее слева, дополнение справа: nʳ · s · nˡ»
    дано разрез равно (запись «Разрез» с лево равным [(запись «Простой тип» с вид равным "n" и падеж равным "им"
      и род равным "*" и число равным "ед" и лицо равным "3" и сопряжение равным 0)] и право равным [
      (запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "*" и число равным "*" и лицо равным "*"
      и сопряжение равным 0)])
    ожидается [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
      и лицо равным "3" и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*"
      и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 0),
      (запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "*" и число равным "*" и лицо равным "*"
      и сопряжение равным -1)]
  («Произведение типов» от («Правое сопряжённое» от разрез.лево)
    и (приписать («Предложение») к («Левое сопряжённое» от разрез.право)))

тотальная функция «Порядки»
  принимает рамка: «Тип»
  возвращает список «Тип»
  пример «у непереходного глагола два порядка: мама спит и спит мама»
    дано рамка равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
      и лицо равным "3" и сопряжение равным 0)]
    ожидается [[(запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 0), (запись «Простой тип» с вид равным "n" и падеж равным "им"
      и род равным "*" и число равным "ед" и лицо равным "3" и сопряжение равным -1)], [
      (запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед" и лицо равным "3"
      и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*"
      и число равным "*" и лицо равным "*" и сопряжение равным 0)]]
  (свёртка («Перестановки» от рамка) начиная с пустой список как итог и п → «Склеить списки» от итог
    и (отобразить («Разрезы» от п) как р → «Тип глагола при разрезе» от р))

тотальная функция «Глагол»
  принимает слово: строка, рамки: список «Тип»
  возвращает «Статья»
  (запись «Статья» с слово равным слово и часть равным "глагол"
    и типы равным (свёртка рамки начиная с пустой список как итог и рамка → «Склеить списки» от итог
    и («Порядки» от рамка)))

тотальная функция «Непереходный»
  принимает слово: строка, подлежащее: «Простой тип»
  возвращает «Статья»
  «Глагол» от слово и [[подлежащее]]

тотальная функция «Переходный»
  принимает слово: строка, подлежащее: «Простой тип», падеж: строка
  возвращает «Статья»
  «Глагол» от слово и [[подлежащее], [подлежащее, («Дополнение» от падеж)]]

тотальная функция «Дательный и винительный»
  принимает слово: строка, подлежащее: «Простой тип»
  возвращает «Статья»
  «Глагол» от слово и [[подлежащее, («Дополнение» от "дат"), («Дополнение» от "вин")]]

тотальная функция «Признаки»
  принимает форма: строка
  возвращает список строки
  пример «падеж, род, число через пробел»
    дано форма равно "вин ж ед"
    ожидается ["вин", "ж", "ед"]
  разделить форма по " "

тотальная функция «Существительное»
  принимает слово: строка, формы: список строки
  возвращает «Статья»
  пример «книгу — винительный женского рода единственного числа»
    дано слово равно "книгу"
    дано формы равно ["вин ж ед"]
    ожидается (запись «Статья» с слово равным "книгу" и часть равным "существительное" и типы равным [[
      (запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "ж" и число равным "ед" и лицо равным "3"
      и сопряжение равным 0)]])
  (запись «Статья» с слово равным слово и часть равным "существительное" и типы равным (отобразить формы как форма → [
    («Именная» от (элемент 1 в («Признаки» от форма)) и (элемент 2 в («Признаки» от форма))
    и (элемент 3 в («Признаки» от форма)) и "3")]))

тотальная функция «Местоимение»
  принимает слово: строка, формы: список строки
  возвращает «Статья»
  пример «я — именительный первого лица, род любой из двух»
    дано слово равно "я"
    дано формы равно ["им м ед 1"]
    ожидается (запись «Статья» с слово равным "я" и часть равным "местоимение" и типы равным [[
      (запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "м" и число равным "ед" и лицо равным "1"
      и сопряжение равным 0)]])
  (запись «Статья» с слово равным слово и часть равным "местоимение" и типы равным (отобразить формы как форма → [
    («Именная» от (элемент 1 в («Признаки» от форма)) и (элемент 2 в («Признаки» от форма))
    и (элемент 3 в («Признаки» от форма)) и (элемент 4 в («Признаки» от форма)))]))

тотальная функция «Тип прилагательного»
  принимает форма: строка
  возвращает «Тип»
  пример «новую: n[вин ж ед 3] · n[вин ж ед]ˡ»
    дано форма равно "вин ж ед"
    ожидается [(запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "ж" и число равным "ед"
      и лицо равным "3" и сопряжение равным 0), (запись «Простой тип» с вид равным "n" и падеж равным "вин"
      и род равным "ж" и число равным "ед" и лицо равным "*" и сопряжение равным -1)]
  пусть п равно «Признаки» от форма
  [(«Именная» от (элемент 1 в п) и (элемент 2 в п) и (элемент 3 в п) и "3"),
    («Сопряжённый» от («Именная» от (элемент 1 в п) и (элемент 2 в п) и (элемент 3 в п) и "*") и -1)]

тотальная функция «Прилагательное»
  принимает слово: строка, формы: список строки
  возвращает «Статья»
  (запись «Статья» с слово равным слово и часть равным "прилагательное"
    и типы равным (отобразить формы как форма → «Тип прилагательного» от форма))

тотальная функция «Предлог»
  принимает слово: строка, падеж: строка
  возвращает «Статья»
  пример «в с предложным: обстоятельство в начале или в конце предложения»
    дано слово равно "в"
    дано падеж равно "предл"
    ожидается (запись «Статья» с слово равным "в" и часть равным "предлог" и типы равным [[
      (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*" и лицо равным "*"
      и сопряжение равным 0), (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*"
      и число равным "*" и лицо равным "*" и сопряжение равным -1), (запись «Простой тип» с вид равным "n"
      и падеж равным "предл" и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным -1)], [
      (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*" и лицо равным "*"
      и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*"
      и число равным "*" и лицо равным "*" и сопряжение равным 0), (запись «Простой тип» с вид равным "n"
      и падеж равным "предл" и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным -1)]])
  пусть дополнение равно «Сопряжённый» от («Дополнение» от падеж) и -1
  (запись «Статья» с слово равным слово и часть равным "предлог" и типы равным [[«Предложение»,
    «Сопряжённый» от («Предложение») и -1, дополнение], [«Сопряжённый» от («Предложение») и 1, «Предложение»,
    дополнение]])

тотальная функция «Существительные»
  возвращает список «Статья»
  [«Существительное» от "мама" и ["им ж ед"],
   «Существительное» от "маму" и ["вин ж ед"],
   «Существительное» от "маме" и ["дат ж ед", "предл ж ед"],
   «Существительное» от "мамы" и ["род ж ед"],
   «Существительное» от "папа" и ["им м ед"],
   «Существительное» от "папу" и ["вин м ед"],
   «Существительное» от "папе" и ["дат м ед", "предл м ед"],
   «Существительное» от "брат" и ["им м ед"],
   «Существительное» от "брата" и ["род м ед", "вин м ед"],
   «Существительное» от "брату" и ["дат м ед"],
   «Существительное» от "сестра" и ["им ж ед"],
   «Существительное» от "сестру" и ["вин ж ед"],
   «Существительное» от "сестре" и ["дат ж ед", "предл ж ед"],
   «Существительное» от "мальчик" и ["им м ед"],
   «Существительное» от "мальчика" и ["род м ед", "вин м ед"],
   «Существительное» от "мальчику" и ["дат м ед"],
   «Существительное» от "девочка" и ["им ж ед"],
   «Существительное» от "девочку" и ["вин ж ед"],
   «Существительное» от "девочке" и ["дат ж ед", "предл ж ед"],
   «Существительное» от "кошка" и ["им ж ед"],
   «Существительное» от "кошку" и ["вин ж ед"],
   «Существительное» от "кошке" и ["дат ж ед", "предл ж ед"],
   «Существительное» от "кошки" и ["род ж ед", "им * мн"],
   «Существительное» от "книга" и ["им ж ед"],
   «Существительное» от "книгу" и ["вин ж ед"],
