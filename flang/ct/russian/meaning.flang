    "превратиться в", "превращаться в", "превратить в", "входить в", "войти в", "включать в", "включить в",
    "заключаться в", "состоять в", "нуждаться в", "участвовать в", "выражаться в", "выразиться в", "проявляться в",
    "проявиться в", "воплотить в", "воплощаться в", "вовлекать в", "вовлечь в", "вступать в", "вступить в",
    "верить в", "убедиться в", "убеждаться в",
    "связать с", "связанный с", "связывать с", "сравнивать с", "сравнить с", "совпадать с", "совпасть с",
    "согласоваться с", "соотноситься с", "сопоставлять с", "сопоставить с", "сопоставляться с",
    "взаимодействовать с", "сочетаться с", "сталкиваться с", "столкнуться с", "бороться с", "соглашаться с",
    "согласиться с", "согласный с", "справиться с", "справляться с", "сопрячь с", "совместимый с", "коррелировать с",
    "ассоциироваться с", "работать с",
    "характерный для", "свойственный для", "типичный для", "необходимый для", "достаточный для", "пригодный для",
    "полезный для", "предназначить для", "предназначенный для", "служить для",
    "отвечать за", "выступать за", "следить за", "наблюдать за", "работать над", "преобладать над",
    "доминировать над", "понимать под", "пониматься под", "подразумевать под", "подразумеваться под",
    "различать между", "обозначить через", "обозначать через", "выражаться через", "выразить через",
    "выступать против", "возражать против", "выступать в_качестве", "использовать в_качестве",
    "использоваться в_качестве", "рассматривать в_качестве", "рассматриваться в_качестве", "служить в_качестве"]

тотальная функция «Управляет»
  принимает лемма: строка, предлог: строка
  возвращает признак
  пример «состоять из — группа с предлогом входит в понятие»
    дано лемма равно "состоять"
    дано предлог равно "из"
    ожидается да
  пример «работать в — свободное обстоятельство»
    дано лемма равно "работать"
    дано предлог равно "в"
    ожидается нет
  пример «варианты предлога сводятся к одному»
    дано лемма равно "свидетельствовать"
    дано предлог равно "об"
    ожидается да
  пусть ровный равно (свёртка [["об", "о"], ["обо", "о"], ["во", "в"], ["ко", "к"], ["со", "с"], ["изо", "из"],
    ["ото", "от"], ["надо", "над"], ["подо", "под"]] начиная с предлог как итог и пара → если (элемент 1 в пара)
    равен предлог
    то (элемент 2 в пара)
    иначе итог)
  («Управление») содержит (соединить [лемма, " ", ровный] по "")

тотальная функция «Служебные леммы»
  возвращает список строки
  ["один", "другой", "каждый", "весь", "сам", "такой", "тот", "этот", "первый", "второй", "третий", "последний",
    "данный", "некоторый", "любой", "многие", "остальной", "следующий", "прочий", "иной"]

тотальная функция «Годится в место»
  принимает п: «Разбор предложения», узел: число
  возвращает признак
  пусть часть равно («Часть слова» от п и узел)
  пусть личное равно ((часть равен "местоимение")
    и притом (["он", "она", "оно", "они"] содержит (элемент узел в п.леммы)))
  (((["сущ", "имя", "родительный"] содержит часть) или личное)
    и притом (не ((«Служебные леммы») содержит (элемент узел в п.леммы))))

тотальная функция «Места без предлога»
  принимает п: «Разбор предложения», место: число
  возвращает список «Место при сказуемом»
  пусть связка равно ((«Часть слова» от п и место) равен "связка")
  пусть косвенные равно (если связка
    то пустой список
    иначе («Зависимые» от п и место и ["дополнение в творительном", "дополнение в дательном",
      "дополнение в родительном"]))
  (отобразить («Соединить списки» от («Зависимые» от п и место и ["дополнение"]) и косвенные) как номер →
    запись «Место при сказуемом» с узел равным номер и привязка равным номер и предлог равным "")

тотальная функция «Места с предлогом»
  принимает п: «Разбор предложения», место: число
  возвращает список «Место при сказуемом»
  пусть лемма равно (элемент место в п.леммы)
  пусть предлоги равно (отфильтровать («Зависимые» от п и место и ["обстоятельство"]) где номер →
    ((элемент номер в п.части) равен "предлог") и притом («Управляет» от лемма и (элемент номер в п.леммы)))
  (свёртка предлоги начиная с пустой список как готово и номер → «Соединить списки» от готово
    и (отобразить («Первые места» от («Зависимые» от п и номер и ["предлог"]) и 1) как имя →
    запись «Место при сказуемом» с узел равным имя и привязка равным номер
    и предлог равным («Чистое имя» от (элемент номер в п.леммы))))

тотальная функция «Первые места»
  принимает номера: список числа, сколько: число
  возвращает список числа
  пример «первые два из трёх»
    дано номера равно [4, 7, 9]
    дано сколько равно 2
    ожидается [4, 7]
  (свёртка номера начиная с пустой список как взято и номер → если (длина взято) меньше сколько
    то добавить номер к взято
    иначе взято)

тотальная функция «Места сказуемого»
  принимает п: «Разбор предложения», место: число
  возвращает список «Место при сказуемом»
  пусть все равно (отфильтровать («Соединить списки» от («Места без предлога» от п и место)
    и («Места с предлогом» от п и место)) где занятое → «Годится в место» от п и занятое.узел)
  (свёртка все начиная с пустой список как взято и занятое → если (длина взято) меньше 2
    то добавить занятое к взято
    иначе взято)

тотальная функция «Терм места»
  принимает п: «Разбор предложения», узел: число
  возвращает строка
  если («Часть слова» от п и узел) равен "местоимение"
    то соединить ["ОТСЫЛКА_", (элемент узел в п.слова)] по ""
    иначе «Чистое имя» от (элемент узел в п.леммы)

тотальная функция «Признак сказуемого»
  принимает п: «Разбор предложения», место: число
  возвращает «Formula»
  пусть места равно («Места сказуемого» от п и место)
  пусть предлоги равно (отобразить (отфильтровать места где занятое → не (пусто занятое.предлог)) как занятое →
    занятое.предлог)
  (вариант «Atom» с name равным (соединить (приписать («Чистое имя» от (элемент место в п.леммы)) к предлоги) по "_")
    и terms равным (приписать "•" к (отобразить места как занятое → «Терм места» от п и занятое.узел)))

тотальная функция «Именная часть»
  принимает п: «Разбор предложения», место: число, топливо: число
  возвращает «Смысл»
  пусть части равно («Зависимые» от п и место и ["именная часть", "дополнение в творительном"])
  пусть первая равно (если пусто части то место иначе голова части)
  пусть при_предлоге равно ((элемент первая в п.части) равен "предлог")
  пусть признак_части равно (вариант «Свойство» с тело равным (если при_предлоге
    то «Признак в месте» от («Имя узла» от п и первая и топливо)
    иначе «Признак сказуемого» от п и первая) и число равным "*")
  если пусто части
    то (вариант «Свойство» с тело равным («Признак в месте» от («Имя сказуемого» от п и место и топливо))
      и число равным "*")
    иначе (если ["сущ", "родительный", "имя"] содержит («Часть слова» от п и первая)
      то «Именное» от п и первая и топливо
      иначе признак_части)

тотальная функция «Под модальным»
  принимает п: «Разбор предложения», место: число
  возвращает «Смысл»
  разбор («Зависимые» от п и место и ["инфинитив"])
    случай пусто
      то (вариант «Отказ» с причина равным (соединить ["модальность: «", (элемент место в п.слова), "»"] по ""))
    случай голова и хвост
      то (вариант «Свойство» с тело равным (если «Есть отрицание» от п и голова
        то (вариант «Not» с inner равным («Признак сказуемого» от п и голова))
        иначе «Признак сказуемого» от п и голова) и число равным "*")

тотальная функция «Силы разбора»
  принимает п: «Разбор предложения»
  возвращает список строки
  пусть модальные равно (отфильтровать («Числа от до» от 1 и (длина п.слова)) где номер →
    ((«Часть слова» от п и номер) равен "модальное")
    и притом (не (пусто («Зависимые» от п и номер и ["инфинитив"]))))
  (отобразить модальные как номер → соединить [(«Чистое имя» от (элемент (голова («Зависимые» от п и номер
    и ["инфинитив"])) в п.леммы)), " + сила «", (если «Есть отрицание» от п и номер то "не " иначе ""),
    (элемент номер в п.слова), "»"] по "")

тотальная функция «Качество без отрицания»
  принимает п: «Разбор предложения», место: число, топливо: число
  возвращает «Смысл»
  пусть часть равно («Часть слова» от п и место)
  пусть при_связке равно (не (пусто («Зависимые» от п и место и ["подлежащее при связке"])))
  пусть именное_сказуемое равно (при_связке и притом (["сущ", "родительный", "имя"] содержит часть))
  пусть глагольное равно (вариант «Свойство» с тело равным («Признак сказуемого» от п и место) и число равным "*")
  («Первый смысл» от [
    («Если» от (часть равен "модальное") и («Под модальным» от п и место)),
    («Если» от (часть равен "связка") и («Именная часть» от п и место и топливо)),
    («Если» от именное_сказуемое и («Именное» от п и место и топливо)),
    глагольное])

тотальная функция «Качество сказуемого»
  принимает п: «Разбор предложения», место: число, топливо: число
  возвращает «Смысл»
  пусть отрицание равно («Есть отрицание» от п и место)
  пусть прямое равно («Качество без отрицания» от п и место и топливо)
  разбор прямое
    случай вариант «Свойство» с тело как тело и число как число
      то (вариант «Свойство» с тело равным (если отрицание то (вариант «Not» с inner равным тело) иначе тело)
        и число равным число)
    случай вариант «Предмет» с имя как имя
      то вариант «Отказ» с причина равным "неизвестная конструкция: равенство двух предметов"
    случай вариант «Обобщение» с квантор как квантор и тело как тело
      то вариант «Отказ» с причина равным "неизвестная конструкция: квантор в сказуемом"
    случай вариант «Отсылка» с слово как слово
      то вариант «Отказ» с причина равным (соединить ["отсылка в сказуемом: «", слово, "»"] по "")
    случай любое
      то прямое

тотальная функция «Исход из форм»
  принимает формы: список «Quantified», причина: строка
  возвращает «Исход смысла»
  запись «Исход смысла» с формы равным формы и причина равным (если пусто формы то причина иначе "")

тотальная функция «Приложения»
  принимает подлежащее: «Смысл», качество: «Formula»
  возвращает «Исход смысла»
  пример «единственное число без квантора читается двояко: названный предмет и общее суждение»
    дано подлежащее равно (вариант «Свойство» с тело равным (вариант «Atom» с name равным "кит" и terms равным ["•"])
      и число равным "ед")
    дано качество равно (вариант «Atom» с name равным "дышать" и terms равным ["•"])
    ожидается (запись «Исход смысла» с формы равным [(запись «Quantified» с «quantifier» равным ""
      и «variables» равным пустой список
      и «body» равным (вариант «Atom» с name равным "дышать" и terms равным ["кит"]) и «fault» равным ""),
      (запись «Quantified» с «quantifier» равным "все" и «variables» равным ["x"]
      и «body» равным (вариант «Implies» с left равным (вариант «Atom» с name равным "кит" и terms равным ["x"])
      и right равным (вариант «Atom» с name равным "дышать" и terms равным ["x"])) и «fault» равным "")]
      и причина равным "")
  разбор подлежащее
    случай вариант «Предмет» с имя как имя
      то «Исход из форм» от [(«Простая форма» от («В место» от качество и имя))] и ""
    случай вариант «Свойство» с тело как тело и число как число
      то (если число равен "мн"
        то «Исход из форм» от («Обобщённые формы» от "все" и тело и качество) и ""
        иначе («Исход из форм» от (приписать («Простая форма» от («В место» от качество
          и («Составное имя» от тело))) к («Обобщённые формы» от "все" и тело и качество)) и ""))
    случай вариант «Обобщение» с квантор как квантор и тело как тело
      то «Исход из форм» от («Обобщённые формы» от квантор и тело и качество) и "неизвестная конструкция: квантор"
    случай вариант «Отсылка» с слово как слово
      то («Исход из форм» от [(«Простая форма» от («В место» от качество
        и (соединить ["ОТСЫЛКА_", слово] по "")))] и "")
    случай вариант «Отказ» с причина как причина
      то «Исход из форм» от пустой список и причина
    случай вариант «Пусто»
      то «Исход из форм» от [(«Простая форма» от («Без места» от качество))] и ""

тотальная функция «Связать тела»
  принимает связка: строка, левое: «Formula», правое: «Formula»
  возвращает «Formula»
  разбор связка
    случай "если"
      то вариант «Implies» с left равным левое и right равным правое
    случай "или"
      то вариант «Or» с left равным левое и right равным правое
    случай любое
      то вариант «And» с left равным левое и right равным правое

тотальная функция «Сложить формы»
  принимает связка: строка, левая: «Quantified», правая: «Quantified»
  возвращает список «Quantified»
  пример «условие без квантора при общем следствии выносит квантор вперёд»
    дано связка равно "если"
    дано левая равно (запись «Quantified» с «quantifier» равным "" и «variables» равным пустой список
      и «body» равным (вариант «Atom» с name равным "дождь" и terms равным пустой список) и «fault» равным "")
    дано правая равно (запись «Quantified» с «quantifier» равным "все" и «variables» равным ["x"]
      и «body» равным (вариант «Atom» с name равным "мокрый" и terms равным ["x"]) и «fault» равным "")
    ожидается [(запись «Quantified» с «quantifier» равным "все" и «variables» равным ["x"]
      и «body» равным (вариант «Implies»
      с left равным (вариант «Atom» с name равным "дождь" и terms равным пустой список)
      и right равным (вариант «Atom» с name равным "мокрый" и terms равным ["x"])) и «fault» равным "")]
  пусть тело равно («Связать тела» от связка и (левая.«body») и (правая.«body»))
  пусть оба_общие равно (((левая.«quantifier») равен "все") и притом ((правая.«quantifier») равен "все"))
  пусть слева_пусто равно (пусто (левая.«quantifier»))
  пусть выносится равно ((не (связка равен "если")) и притом ((пусто (правая.«quantifier»)) или оба_общие))
  пусть несущая равно (если слева_пусто то правая иначе левая)
  если слева_пусто или выносится
    то [(запись «Quantified» с «quantifier» равным (несущая.«quantifier»)
      и «variables» равным (несущая.«variables») и «body» равным тело и «fault» равным "")]
    иначе пустой список

тотальная функция «Первые»
  принимает формы: список «Quantified», сколько: число
  возвращает список «Quantified»
  (свёртка формы начиная с пустой список как взято и форма → если (длина взято) меньше сколько
    то добавить форма к взято
    иначе взято)

тотальная функция «Пары форм»
  принимает связка: строка, левые: список «Quantified», правые: список «Quantified»
  возвращает список «Quantified»
  (свёртка левые начиная с пустой список как готово и левая → свёртка правые начиная с готово как выросло
    и правая → «Соединить списки» от выросло и («Сложить формы» от связка и левая и правая))

тотальная функция «Сложить исходы»
  принимает связка: строка, левый: «Исход смысла», правый: «Исход смысла»
  возвращает «Исход смысла»
  пусть пары равно («Первые» от («Пары форм» от связка и левый.формы и правый.формы) и 8)
  если пусто левый.формы
    то левый
    иначе (если пусто правый.формы
      то правый
      иначе «Исход из форм» от пары и "неизвестная конструкция: квантор внутри сложного суждения")

тотальная функция «Обратный квантор»
  принимает квантор: строка
  возвращает строка
  пример «не все — значит есть такой, что не»
    дано квантор равно "все"
    ожидается "есть"
  если квантор равен "все"
    то "есть"
    иначе (если квантор равен "есть" то "все" иначе квантор)

тотальная функция «Бытие»
  принимает подлежащее: «Смысл», отрицание: признак
  возвращает «Исход смысла»
  разбор подлежащее
    случай вариант «Свойство» с тело как тело и число как число
      то «Бытие признака» от тело и число и отрицание
    случай вариант «Отказ» с причина как причина
      то «Исход из форм» от пустой список и причина
    случай любое
      то «Исход из форм» от пустой список и "неизвестная конструкция: глагол бытия без нарицательного подлежащего"

тотальная функция «Бытие признака»
  принимает тело: «Formula», число: строка, отрицание: признак
  возвращает «Исход смысла»
  пусть высказывание равно («Без места» от («Признак в месте» от («Составное имя» от тело)))
  пусть общее равно («Форма с квантором» от (если отрицание то "все" иначе "есть")
    и (если отрицание то (вариант «Not» с inner равным тело) иначе тело))
  пусть частное равно («Простая форма» от (если отрицание то (вариант «Not» с inner равным высказывание)
    иначе высказывание))
  «Исход из форм» от [(если число равен "мн" то общее иначе частное)] и ""

тотальная функция «Член из узла»
  принимает п: «Разбор предложения», номер: число
  возвращает «Член ряда»
  разбор («Зависимые» от п и номер и ["союз"])
    случай пусто
      то запись «Член ряда» с место равным номер и союз равным "и"
    случай голова и хвост
      то запись «Член ряда» с место равным голова и союз равным (элемент номер в п.леммы)

тотальная функция «Ряд узла»
  принимает п: «Разбор предложения», место: число
  возвращает список «Член ряда»
  отобразить («Зависимые» от п и место и ["однородное"]) как номер → «Член из узла» от п и номер

тотальная функция «Связка союза»
  принимает союз: строка
  возвращает строка
  пример «либо — или»
    дано союз равно "либо"
    ожидается "или"
  пример «а и но соединяют как и»
    дано союз равно "но"
    ожидается "и"
  если ["или", "либо", "или_же"] содержит союз то "или" иначе "и"

тотальная функция «О подлежащих»
  принимает п: «Разбор предложения», подлежащие: список числа, качество: «Смысл», топливо: число
  возвращает «Исход смысла»
  пусть первое равно (если пусто подлежащие то (вариант «Пусто») иначе «Именное» от п и (голова подлежащие) и топливо)
  пусть ряд равно (если пусто подлежащие то пустой список иначе «Ряд узла» от п и (голова подлежащие))
  разбор качество
    случай вариант «Свойство» с тело как тело и число как число
      то (свёртка ряд начиная с («Приложения» от первое и тело) как исход и член → «Сложить исходы»
        от («Связка союза» от член.союз) и исход и («Приложения» от («Именное» от п и член.место и топливо) и тело))
    случай вариант «Отказ» с причина как причина
      то «Исход из форм» от пустой список и причина
    случай любое
      то «Исход из форм» от пустой список и "неизвестная конструкция: сказуемое без признака"

тотальная функция «Основа узла»
  принимает п: «Разбор предложения», место: число, подлежащие: список числа, топливо: число
  возвращает «Исход смысла»
  пусть свои равно («Зависимые» от п и место и ["подлежащее", "подлежащее при связке"])
  пусть чьи равно (если пусто свои то подлежащие иначе свои)
  пусть бытийный равно ((«Часть слова» от п и место) равен "бытийный")
  пусть обычная равно («О подлежащих» от п и чьи и («Качество сказуемого» от п и место и топливо) и топливо)
  пусть обороты равно («Зависимые» от п и место и ["деепричастный оборот"])
  пусть с_оборотами равно (свёртка обороты начиная с обычная как исход и номер → «Сложить исходы» от "и" и исход
    и («О подлежащих» от п и чьи и («Качество сказуемого» от п и номер и топливо) и топливо))
  если бытийный и притом (не (пусто чьи))
    то «Бытие» от («Именное» от п и (голова чьи) и топливо) и («Есть отрицание» от п и место)
    иначе с_оборотами

тотальная функция «Связка придаточного»
  принимает союз: строка
  возвращает строка
  пример «если — условие»
    дано союз равно "если"
    ожидается "если"
  пример «чтобы — цель, формы у неё нет»
    дано союз равно "чтобы"
    ожидается "цель"
  пример «так как — причина, обе части утверждаются»
    дано союз равно "так_как"
    ожидается "и"
  если ["если", "когда", "раз", "коль", "ежели"] содержит союз
    то "если"
    иначе (если ["чтобы", "дабы", "для_того_чтобы", "с_тем_чтобы"] содержит союз то "цель" иначе "и")

тотальная функция «Суждения узла»
  принимает п: «Разбор предложения», место: число, подлежащие: список числа, топливо: число
  возвращает «Исход смысла»
  убывает топливо
  пусть свои равно («Зависимые» от п и место и ["подлежащее", "подлежащее при связке"])
  пусть чьи равно (если пусто свои то подлежащие иначе свои)
  пусть основа равно («Основа узла» от п и место и подлежащие и топливо)
  пусть с_рядом равно (свёртка («Ряд узла» от п и место) начиная с основа как исход и член → «Сложить исходы»
    от («Связка союза» от член.союз) и исход и («Суждения узла» от п и член.место и чьи и (топливо минус 1)))
  если топливо не больше 0
    то основа
    иначе (свёртка («Зависимые» от п и место и ["придаточное"]) начиная с с_рядом как исход и номер →
      «С придаточным» от исход и («Связка придаточного» от (элемент номер в п.леммы))
      и («Суждения первого» от п и («Зависимые» от п и номер и ["союз"]) и (топливо минус 1)))

тотальная функция «Суждения первого»
  принимает п: «Разбор предложения», места: список числа, топливо: число
  возвращает «Исход смысла»
  убывает топливо
  разбор места
    случай пусто
      то «Исход из форм» от пустой список и "неизвестная конструкция: придаточное без сказуемого"
    случай голова и хвост
      то (если топливо не больше 0
        то «Исход из форм» от пустой список и "неизвестная конструкция: слишком глубокое вложение"
        иначе «Суждения узла» от п и голова и пустой список и (топливо минус 1))

тотальная функция «С придаточным»
  принимает главное: «Исход смысла», связка: строка, придаточное: «Исход смысла»
  возвращает «Исход смысла»
  разбор связка
    случай "если"
      то «Сложить исходы» от "если" и придаточное и главное
    случай "цель"
      то «Исход из форм» от пустой список и "цель: придаточное с «чтобы»"
    случай любое
      то «Сложить исходы» от "и" и главное и придаточное

тотальная функция «Корень разбора»
  принимает п: «Разбор предложения»
  возвращает число
  пусть зависимые равно (отобразить п.связи как связь → связь.зависимое)
  (свёртка («Числа от до» от 1 и (длина п.слова)) начиная с 0 как корень и номер → (если (корень равен 0)
    и притом (не (зависимые содержит номер))
    то номер
    иначе корень))

тотальная функция «Формы разбора»
  принимает п: «Разбор предложения»
  возвращает «Исход смысла»
  пусть корень равно («Корень разбора» от п)
  если корень равен 0
    то «Исход из форм» от пустой список и "неизвестная конструкция: в разборе нет вершины"
    иначе «Суждения узла» от п и корень и пустой список и ((длина п.слова) плюс 2)

тотальная функция «Есть вывод»
  принимает разборы: список «Разбор предложения»
  возвращает признак
  (не (пусто (отфильтровать разборы где п → не (пусто (отфильтровать п.связи где связь → связь.роль равен "вывод")))))

тотальная функция «Тексты исходов»
  принимает исходы: список «Исход смысла»
  возвращает список строки
  («Each once» от (свёртка исходы начиная с пустой список как готово и исход → «Соединить списки» от готово
    и (отобразить исход.формы как форма → «Form text» от форма)))

тотальная функция «Причины исходов»
  принимает исходы: список «Исход смысла»
  возвращает список строки
  «Each once» от (отобразить (отфильтровать исходы где исход → пусто исход.формы) как исход → исход.причина)

тотальная функция «Первые строки»
  принимает строки: список строки, сколько: число
  возвращает список строки
  (свёртка строки начиная с пустой список как взято и строка_формы → если (длина взято) меньше сколько
    то добавить строка_формы к взято
    иначе взято)

тотальная функция «Роли уточнений»
  возвращает список строки
  ["обстоятельство", "инфинитив", "изъяснительное", "дополнение в творительном", "дополнение в дательном",
    "дополнение в родительном", "придаточное определительное", "обособленное определение"]

тотальная функция «Привязки»
  принимает п: «Разбор предложения», место: число
  возвращает список числа
  отобразить («Места сказуемого» от п и место) как занятое → занятое.привязка

тотальная функция «Слова при узле»
  принимает п: «Разбор предложения», узел: число
  возвращает список строки
  разбор («Mentions of» от («Тело группы» от п и узел и (длина п.слова)))
    случай пусто
      то пустой список
    случай голова и хвост
      то отобразить хвост как упоминание → элемент 1 в упоминание

тотальная функция «Утверждается»
  принимает п: «Разбор предложения», место: число
  возвращает признак
  пусть условные равно (отфильтровать («Зависимые» от п и место и ["придаточное"]) где номер →
    не ((«Связка придаточного» от (элемент номер в п.леммы)) равен "и"))
  пусть прямое равно ((место равен («Корень разбора» от п)) и притом (не («Есть отрицание» от п и место)))
  ((прямое и притом (пусто условные)) и притом (не ((«Часть слова» от п и место) равен "бытийный")))

тотальная функция «Названо словом»
  принимает п: «Разбор предложения», номер: число
  возвращает признак
  разбор («Именное» от п и номер и (длина п.слова))
    случай вариант «Свойство» с тело как тело и число как число
      то не (число равен "мн")
    случай любое
      то нет

тотальная функция «Сказанное о слове»
  принимает имена: список строки, терм: строка
  возвращает список строки
  пример «признак при слове становится суждением о нём»
    дано имена равно ["равноправный"]
    дано терм равно "узел"
    ожидается ["равноправный(узел)"]
  отобразить имена как имя → «Formula text» от (вариант «Atom» с name равным имя и terms равным [терм])

тотальная функция «Узлы мест»
  принимает п: «Разбор предложения», место: число
  возвращает список числа
  (отобразить (отфильтровать («Места сказуемого» от п и место) где занятое →
    не ((«Часть слова» от п и занятое.узел) равен "местоимение")) как занятое → занятое.узел)

тотальная функция «Спутники разбора»
  принимает п: «Разбор предложения»
  возвращает список строки
  пусть корень равно («Корень разбора» от п)
  пусть подлежащие равно (отфильтровать («Первые места» от («Зависимые» от п и корень и ["подлежащее",
    "подлежащее при связке"]) и 1) где номер → «Названо словом» от п и номер)
  пусть узлы равно («Соединить списки» от подлежащие и («Узлы мест» от п и корень))
  если (корень больше 0) и притом («Утверждается» от п и корень)
    то («Each once» от (свёртка узлы начиная с пустой список как готово и узел → «Соединить списки» от готово
      и («Сказанное о слове» от («Слова при узле» от п и узел) и («Чистое имя» от (элемент узел в п.леммы)))))
    иначе пустой список

тотальная функция «Уточнения при местах»
  принимает п: «Разбор предложения», место: число
  возвращает список строки
  если «Утверждается» от п и место
    то пустой список
    иначе (свёртка («Узлы мест» от п и место) начиная с пустой список как готово и узел → «Соединить списки»
      от готово и (отобразить («Слова при узле» от п и узел) как имя → соединить [(«Чистое имя» от (элемент узел
      в п.леммы)), " + ", имя] по ""))

тотальная функция «Уточнения разбора»
  принимает п: «Разбор предложения»
  возвращает список строки
  пусть связи равно (отфильтровать п.связи где связь → (((«Роли уточнений») содержит связь.роль)
    и притом (не ((«Часть слова» от п и (связь.главное)) равен "связка")))
    и притом (не ((«Привязки» от п и (связь.главное)) содержит связь.зависимое)))
  пусть свободные равно (отобразить связи как связь → соединить [(«Чистое имя» от (элемент (связь.главное)
    в п.леммы)), " + ", («Полное имя» от п и (связь.зависимое) и (длина п.слова))] по "")
  (свёртка («Числа от до» от 1 и (длина п.слова)) начиная с («Соединить списки» от («Силы разбора» от п)
    и свободные) как готово и место → «Соединить списки» от готово и («Уточнения при местах» от п и место))

тотальная функция «Разбор главной формы»
  принимает разборы: список «Разбор предложения»
  возвращает список «Разбор предложения»
  пусть годные равно (отфильтровать разборы где п → не (пусто («Формы разбора» от п).формы))
  «Первые разборы» от (если пусто годные то разборы иначе годные)

тотальная функция «Уточнения разборов»
  принимает разборы: список «Разбор предложения»
  возвращает список строки
  разбор («Разбор главной формы» от разборы)
    случай пусто
      то пустой список
    случай голова и хвост
      то «Уточнения разбора» от голова

тотальная функция «Спутники разборов»
  принимает разборы: список «Разбор предложения»
  возвращает список строки
  разбор («Разбор главной формы» от разборы)
    случай пусто
      то пустой список
    случай голова и хвост
      то отфильтровать («Спутники разбора» от голова) где спутник → не (спутник содержит "ОТСЫЛКА_")

тотальная функция «Формы из разборов»
  принимает разборы: список «Разбор предложения», всего: число, предел: число
  возвращает «Формы»
  пусть исходы равно (отобразить разборы как п → «Формы разбора» от п)
  пусть тексты равно («Тексты исходов» от исходы)
  пусть много равно ((длина тексты) больше предел)
  пусть избыток равно (соединить ["слишком много чтений: ", (к строке (длина тексты))] по "")
  (запись «Формы» с уточнения равным («Уточнения разборов» от разборы)
    и спутники равным (если много то пустой список иначе («Спутники разборов» от разборы))
    и формы равным (если много то («Первые строки» от тексты и 3) иначе тексты)
    и причины равным (если много то [избыток] иначе («Причины исходов» от исходы))
    и разборов равным всего и различных равным (длина тексты) и вывод равным («Есть вывод» от разборы))

тотальная функция «Пробные слова»
  возвращает список строки
  ["кит=кит,сущ,им,м,ед,*,*,одуш", "киты=кит,сущ,им,м,мн,*,*,одуш", "кита=кит,сущ,род,м,ед,*,*,одуш",
    "китов=кит,сущ,род,м,мн,*,*,одуш", "млекопитающее=млекопитающее,сущ,им,с,ед",
    "млекопитающие=млекопитающее,сущ,им,с,мн", "млекопитающими=млекопитающее,сущ,тв,с,мн",
    "рыба=рыба,сущ,им,ж,ед", "рыбы=рыба,сущ,им,ж,мн", "рыбы=рыба,сущ,род,ж,ед", "рыбой=рыба,сущ,тв,ж,ед",
    "рыбами=рыба,сущ,тв,ж,мн", "человек=человек,сущ,им,м,ед,*,*,одуш", "человеком=человек,сущ,тв,м,ед,*,*,одуш",
    "люди=человек,сущ,им,м,мн,*,*,одуш",
    "дельфин=дельфин,сущ,им,м,ед,*,*,одуш", "дельфины=дельфин,сущ,им,м,мн,*,*,одуш",
    "дождь=дождь,сущ,им,м,ед", "дорога=дорога,сущ,им,ж,ед", "улица=улица,сущ,им,ж,ед",
    "сервис=сервис,сущ,им,м,ед", "сервисы=сервис,сущ,им,м,мн", "сервиса=сервис,сущ,род,м,ед",
    "копия=копия,сущ,им,ж,ед", "копию=копия,сущ,вин,ж,ед", "копией=копия,сущ,тв,ж,ед",
    "иерархия=иерархия,сущ,им,ж,ед", "достижение=достижение,сущ,вин,с,ед", "статуса=статус,сущ,род,м,ед",
    "матрица=матрица,сущ,им,ж,ед", "достижимости=достижимость,сущ,род,ж,ед",
    "сократ=сократ,сущ,им,м,ед,*,*,имя одуш", "моби=моби,сущ,им,м,ед,*,*,имя одуш",
    "архив=архив,сущ,им,м,ед,*,*,имя", "икс=икс,сущ,им,м,ед,*,*,имя", "игрек=игрек,сущ,им,м,ед,*,*,имя",
    "зет=зет,сущ,им,м,ед,*,*,имя", "икса=икс,сущ,род,м,ед,*,*,имя", "улица=улица,сущ,им,ж,ед",
    "смертен=смертный,кр_прил,*,м,ед", "смертны=смертный,кр_прил,*,*,мн",
    "надежен=надёжный,кр_прил,*,м,ед", "надежна=надёжный,кр_прил,*,ж,ед", "надежны=надёжный,кр_прил,*,*,мн",
    "умен=умный,кр_прил,*,м,ед", "умны=умный,кр_прил,*,*,мн", "антисимметрична=антисимметричный,кр_прил,*,ж,ед",
    "мокрая=мокрый,прил,им,ж,ед", "белые=белый,прил,им,*,мн", "белый=белый,прил,им,м,ед",
    "резервной=резервный,прил,тв,ж,ед", "резервную=резервный,прил,вин,ж,ед",
    "идет=идти,глагол,*,*,ед,3,наст", "дышит=дышать,глагол,*,*,ед,3,наст", "дышат=дышать,глагол,*,*,мн,3,наст",
    "плавает=плавать,глагол,*,*,ед,3,наст", "плавают=плавать,глагол,*,*,мн,3,наст",
    "имеет=иметь,глагол,*,*,ед,3,наст,перех", "затрудняет=затруднять,глагол,*,*,ед,3,наст,перех",
    "существуют=существовать,глагол,*,*,мн,3,наст", "является=являться,глагол,*,*,ед,3,наст,возвр",
    "являются=являться,глагол,*,*,мн,3,наст,возвр", "может=мочь,глагол,*,*,ед,3,наст",
    "плавать=плавать,инф", "он=он,мест,им,м,ед,3", "она=она,мест,им,ж,ед,3", "они=они,мест,им,*,мн,3",
    "все=весь,прил,им,*,мн,*,*,местоим", "каждый=каждый,прил,им,м,ед,*,*,местоим",
    "некоторые=некоторый,прил,им,*,мн,*,*,местоим", "никакой=никакой,прил,им,м,ед,*,*,местоим",
    "состоит=состоять,глагол,*,*,ед,3,наст", "равноправных=равноправный,прил,род,*,мн",
    "узлов=узел,сущ,род,м,мн", "зависит=зависеть,глагол,*,*,ед,3,наст", "алгоритм=алгоритм,сущ,им,м,ед",
    "размера=размер,сущ,род,м,ед", "сети=сеть,сущ,род,ж,ед", "сети=сеть,сущ,предл,ж,ед",
    "содержит=содержать,глагол,*,*,ед,3,наст,перех", "центральных=центральный,прил,род,*,мн",
    "приводит=приводить,глагол,*,*,ед,3,наст", "сбой=сбой,сущ,им,м,ед", "ошибке=ошибка,сущ,дат,ж,ед",
    "обладает=обладать,глагол,*,*,ед,3,наст", "памятью=память,сущ,тв,ж,ед", "большой=большой,прил,тв,ж,ед"]

тотальная функция «Лемма строки словаря»
  принимает строка_словаря: строка
  возвращает строка
  пример «лемма стоит после знака равенства»
    дано строка_словаря равно "китов=кит,сущ,род,м,мн"
    ожидается "кит"
  элемент 1 в (разделить (элемент 2 в (разделить (соединить [строка_словаря, "="] по "") по "=")) по ",")

тотальная функция «Леммы имён»
  принимает словарь: список строки
  возвращает список строки
  пример «имя узнаётся по помете в строке словаря»
    дано словарь равно ["сократ=сократ,сущ,им,м,ед,*,*,имя одуш", "кит=кит,сущ,им,м,ед,*,*,одуш"]
    ожидается ["сократ"]
  пример «слово, у которого есть и обычное чтение, именем не считается»
    дано словарь равно ["пола=пол,сущ,род,м,ед,*,*,одуш имя", "пола=пол,сущ,род,м,ед,*,*,неодуш"]
    ожидается пустой список
  пример «предлог не становится именем из-за инициала»
    дано словарь равно ["к=к,сущ,им,м,ед,*,*,имя инициал", "к=к,предлог"]
    ожидается пустой список
  пусть с_пометой равно (отфильтровать словарь где строка_словаря → (строка_словаря содержит ",имя")
    или (строка_словаря содержит " имя"))
  пусть прочие равно («Each once» от (отобразить (отфильтровать словарь где строка_словаря →
    не ((строка_словаря содержит ",имя") или (строка_словаря содержит " имя"))) как строка_словаря →
    «Лемма строки словаря» от строка_словаря))
  (отфильтровать («Each once» от (отобразить с_пометой как строка_словаря → «Лемма строки словаря»
    от строка_словаря)) где лемма → не (прочие содержит лемма))

тотальная функция «С именами»
  принимает п: «Разбор предложения», имена: список строки
  возвращает «Разбор предложения»
  пусть части равно (свёртка п.части начиная с пустой список как готово и часть → добавить (если имена
    содержит (элемент ((длина готово) плюс 1) в п.леммы)
    то "слово"
    иначе часть) к готово)
  (запись «Разбор предложения» с слова равным п.слова и леммы равным п.леммы и части равным части
    и типы равным п.типы и строй равным п.строй и связи равным п.связи)

тотальная функция «Формы предложения»
  принимает предложение: строка, словарь: список строки, предел: число
  возвращает «Формы»
  пусть слова равно («Соединить списки» от словарь и («Соединить списки» от («Пробные слова») и («Пробный словарь»)))
  пусть ответ равно («Разборы по словарю» от предложение и слова и 24)
  пусть имена равно («Леммы имён» от слова)
  разбор ответ
    случай вариант «Разобрано» с разборы как разборы
      то («Формы из разборов» от (отобразить разборы как п → «С именами» от п и имена)
        и («Чтения из ответа» от ответ).всего и предел)
    случай вариант «Не разобрано» с причина как причина и слово как слово и место как место и работа как работа
      то (запись «Формы» с уточнения равным пустой список и спутники равным пустой список
        и формы равным пустой список
        и причины равным [(если пусто слово то причина иначе (соединить [причина, ": «", слово, "»"] по ""))]
        и разборов равным 0 и различных равным 0 и вывод равным нет)

тотальная функция «Записать формы»
  принимает формы: «Формы»
  возвращает строка
  пример «одна форма»
    дано формы равно (запись «Формы» с уточнения равным пустой список и спутники равным пустой список
      и формы равным ["смертный(сократ)"] и причины равным пустой список
      и разборов равным 1 и различных равным 1 и вывод равным нет)
    ожидается "форма: смертный(сократ)"
  пример «две формы названы обе»
    дано формы равно (запись «Формы» с уточнения равным пустой список и спутники равным пустой список
      и формы равным ["а", "б"] и причины равным пустой список
      и разборов равным 3 и различных равным 2 и вывод равным нет)
    ожидается "форм 2: а | б"
  пример «сверх предела названо число чтений и первые формы»
    дано формы равно (запись «Формы» с уточнения равным пустой список и спутники равным пустой список
      и формы равным ["а", "б", "в"] и причины равным ["слишком много чтений: 9"]
      и разборов равным 40 и различных равным 9 и вывод равным нет)
    ожидается "не построено: слишком много чтений: 9; первые: а | б | в"
  пусть сколько равно (длина формы.формы)
  пусть причины равно (соединить формы.причины по "; ")
  пусть перечень равно (соединить формы.формы по " | ")
  пусть первые равно (если сколько равен 0 то "" иначе (соединить ["; первые: ", перечень] по ""))
  если (сколько равен 0) или (формы.различных больше сколько)
    то соединить ["не построено: ", причины, первые] по ""
    иначе (если сколько равен 1
      то соединить ["форма: ", (элемент 1 в формы.формы)] по ""
      иначе соединить ["форм ", (к строке сколько), ": ", (соединить формы.формы по " | ")] по "")

тотальная функция «Предел форм»
  возвращает число
  пример «больше двенадцати разных форм — слишком много чтений»
    ожидается 12
  12

тотальная функция «Прочитать»
  принимает предложение: строка
  возвращает строка
  «Записать формы» от («Формы в тексте» от предложение и "" и пустой список и («Предел форм»)).формы

тотальная функция «Строки словаря из текста»
  принимает словарь: строка
  возвращает список строки
  пример «строки словаря идут по одной в строке или через черту»
    дано словарь равно "кит=кит,сущ,им,м,ед\n\nкиты=кит,сущ,им,м,мн|кита=кит,сущ,род,м,ед"
    ожидается ["кит=кит,сущ,им,м,ед", "киты=кит,сущ,им,м,мн", "кита=кит,сущ,род,м,ед"]
  (отфильтровать (разделить («Replaced in» от словарь и "\n" и "|") по "|") где строка_словаря →
    не (пусто строка_словаря))

тотальная функция «Прочитать со словарём»
  принимает предложение: строка, словарь: строка
  возвращает строка
  пусть строки равно («Строки словаря из текста» от словарь)
  «Записать формы» от («Формы в тексте» от предложение и "" и строки и («Предел форм»)).формы

объект «Опора»
  лемма является строкой
  род является строкой
  число является строкой
  место является числом

объект «Чтение в тексте»
  формы является «Формы»
  пометы является список строки

тотальная функция «Род узла»
  принимает п: «Разбор предложения», место: число
  возвращает строка
  (свёртка (элемент место в п.строй) начиная с "*" как род и простой → (если (простой.сопряжение равен 0)
    и притом (простой.вид равен "n")
    то простой.род
    иначе род))

тотальная функция «Опоры разбора»
  принимает п: «Разбор предложения»
  возвращает список «Опора»
  пусть места равно (отфильтровать («Числа от до» от 1 и (длина п.слова)) где номер →
    ["сущ", "имя"] содержит («Часть слова» от п и номер))
  пусть роли равно ["подлежащее", "подлежащее при связке"]
  пусть прочие равно (отфильтровать места где номер → не (роли содержит («Роль входящей связи» от п и номер)))
  пусть подлежащие равно (отфильтровать места где номер → роли содержит («Роль входящей связи» от п и номер))
  (отобразить («Соединить списки» от прочие и подлежащие) как номер → запись «Опора»
    с лемма равным («Чистое имя» от (элемент номер в п.леммы))
    и род равным («Род узла» от п и номер) и число равным («Число узла» от п и номер) и место равным номер)

тотальная функция «Первый разбор»
  принимает предложение: строка, слова: список строки
  возвращает список «Разбор предложения»
  разбор («Разборы по словарю» от предложение и слова и 1)
    случай вариант «Разобрано» с разборы как разборы
      то отобразить («Первые разборы» от разборы) как п → «С именами» от п и («Леммы имён» от слова)
    случай любое
      то пустой список

тотальная функция «Первые разборы»
  принимает разборы: список «Разбор предложения»
  возвращает список «Разбор предложения»
  разбор разборы
    случай пусто
      то пустой список
    случай голова и хвост
      то [голова]

тотальная функция «Признаки местоимения»
  принимает слово: строка
  возвращает список строки
  пример «она — женский род, единственное число»
    дано слово равно "она"
    ожидается ["ж", "ед"]
  пример «они — множественное число, род любой»
    дано слово равно "они"
    ожидается ["*", "мн"]
  (свёртка [["м", "ед", "он", "его", "ему", "им", "нем", "него", "нему", "этот", "тот", "который"],
    ["ж", "ед", "она", "ее", "ей", "нее", "ней", "эта", "та", "которая"],
    ["с", "ед", "оно", "это", "то", "которое"],
    ["*", "мн", "они", "их", "ими", "них", "ним", "эти", "те", "которые"]] начиная с ["*", "*"] как найдено и ряд →
    если ряд содержит слово то [(элемент 1 в ряд), (элемент 2 в ряд)] иначе найдено)

тотальная функция «Опора подходит»
  принимает опора: «Опора», признаки: список строки
  возвращает признак
  пусть род равно (элемент 1 в признаки)
  пусть число равно (элемент 2 в признаки)
  (((род равен "*") или (опора.род равен род)) и притом ((число равен "*") или (опора.число равен число)))

тотальная функция «Ближайшая опора»
  принимает опоры: список «Опора», слово: строка
  возвращает строка
  пример «берётся последняя подходящая по роду и числу»
    дано опоры равно [(запись «Опора» с лемма равным "кит" и род равным "м" и число равным "ед" и место равным 1),
      (запись «Опора» с лемма равным "рыба" и род равным "ж" и число равным "ед" и место равным 3)]
    дано слово равно "он"
    ожидается "кит"
  (свёртка опоры начиная с "" как найдено и опора → если «Опора подходит» от опора и («Признаки местоимения» от слово)
    то опора.лемма
    иначе найдено)

тотальная функция «Слова отсылок»
  принимает формы: список строки
  возвращает список строки
  пример «местоимение в форме узнаётся по метке»
    дано формы равно ["смертный(ОТСЫЛКА_он)"]
    ожидается ["он"]
  пусть куски равно (свёртка формы начиная с пустой список как готово и форма → «Соединить списки» от готово
    и («Numbered words» от (разделить форма по "ОТСЫЛКА_")))
  «Each once» от (отобразить куски как кусок → элемент 1 в (разделить («Replaced in» от кусок и ")" и ",") по ","))

тотальная функция «Место слова»
  принимает слова: список строки, слово: строка
  возвращает число
  пример «первое вхождение слова»
    дано слова равно ["кит", "он", "он"]
    дано слово равно "он"
    ожидается 2
  пусть счёт равно (свёртка слова начиная с [0, 0] как пара и очередное → [((элемент 1 в пара) плюс 1),
    (если ((элемент 2 в пара) равен 0) и притом (очередное равен слово)
      то ((элемент 1 в пара) плюс 1)
      иначе (элемент 2 в пара))])
  элемент 2 в счёт

тотальная функция «Опоры для слова»
  принимает прежние: список «Опора», свои: список «Разбор предложения», слово: строка
  возвращает список «Опора»
  разбор свои
    случай пусто
      то прежние
    случай голова и хвост
      то («Соединить списки» от прежние и (отфильтровать («Опоры разбора» от голова) где опора →
        опора.место меньше («Место слова» от голова.слова и слово)))

тотальная функция «Шаг разрешения»
  принимает чтение: «Чтение в тексте», слово: строка, опора: строка
  возвращает «Чтение в тексте»
  пусть метка равно (соединить ["ОТСЫЛКА_", слово] по "")
  пусть формы равно чтение.формы
  пусть новые равно (отобразить формы.формы как форма → «Replaced in» от форма и метка и опора)
  пусть без_опоры равно (отфильтровать формы.формы где форма → не (форма содержит метка))
  пусть причина равно (соединить ["отсылка: «", слово, "»"] по "")
  если пусто опора
    то (запись «Чтение в тексте» с формы равным (запись «Формы» с уточнения равным формы.уточнения
      и спутники равным формы.спутники и формы равным без_опоры
      и причины равным (добавить причина к формы.причины) и разборов равным формы.разборов
      и различных равным (длина без_опоры) и вывод равным формы.вывод) и пометы равным чтение.пометы)
    иначе (запись «Чтение в тексте» с формы равным (запись «Формы» с уточнения равным формы.уточнения
      и спутники равным формы.спутники и формы равным новые
      и причины равным формы.причины и разборов равным формы.разборов и различных равным формы.различных
      и вывод равным формы.вывод) и пометы равным (добавить (соединить [слово, " = ", опора] по "") к чтение.пометы))

тотальная функция «Опоры прежнего»
  принимает прежнее: строка, слова: список строки
  возвращает список «Опора»
  разбор («Первый разбор» от прежнее и слова)
    случай пусто
      то пустой список
    случай голова и хвост
      то «Опоры разбора» от голова

тотальная функция «Формы в тексте»
  принимает предложение: строка, прежнее: строка, словарь: список строки, предел: число
  возвращает «Чтение в тексте»
  пусть слова равно («Соединить списки» от словарь и («Соединить списки» от («Пробные слова») и («Пробный словарь»)))
  пусть формы равно («Формы предложения» от предложение и словарь и предел)
  пусть отсылки равно («Слова отсылок» от формы.формы)
  пусть нужны равно ((не (пусто отсылки)) и притом (не (пусто прежнее)))
  пусть прежние равно (если нужны то «Опоры прежнего» от прежнее и слова иначе пустой список)
  пусть свои равно (если пусто отсылки то пустой список иначе «Первый разбор» от предложение и слова)
  (свёртка отсылки начиная с (запись «Чтение в тексте» с формы равным формы и пометы равным пустой список)
    как чтение и слово → «Шаг разрешения» от чтение и слово и («Ближайшая опора» от («Опоры для слова» от прежние
    и свои и слово) и слово))
