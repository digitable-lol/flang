модуль «Russian parser»
  использует «Russian pregroup» из "pregroup.flang"
  использует «Russian lexicon» из "lexicon.flang"

тип «Вердикт»
  вариант «Грамматично» содержит выбор: список «Тип», связи: список «Связь»
  вариант «Неизвестное слово» содержит слово: строка
  вариант «Нет сказуемого»
  вариант «Нет согласования»
  вариант «Неверный падеж»
  вариант «Неверный падеж и нет согласования»
  вариант «Строй не сводится»

тотальная функция «Строчная буква»
  принимает знак: строка
  возвращает строка
  пример «заглавная кириллица опускается»
    дано знак равно "М"
    ожидается "м"
  пример «Ё становится ё»
    дано знак равно "Ё"
    ожидается "ё"
  пример «строчная не меняется»
    дано знак равно "а"
    ожидается "а"
  пусть код равно код символа знак
  если (код не меньше 1040) и притом (код не больше 1071)
    то символ по коду (код плюс 32)
    иначе (если код равен 1025
      то "ё"
      иначе знак)

тотальная функция «Без знаков препинания»
  принимает знак: строка
  возвращает строка
  пример «точка уходит»
    дано знак равно "."
    ожидается " "
  пример «буква остаётся»
    дано знак равно "к"
    ожидается "к"
  если (знак равен ".") или ((знак равен ",") или ((знак равен "!") или ((знак равен "?") или (знак равен "—"))))
    то " "
    иначе знак

тотальная функция «Слова»
  принимает текст: строка
  возвращает список строки
  пример «заглавная, точка и лишние пробелы не мешают»
    дано текст равно "Мама  читает книгу."
    ожидается ["мама", "читает", "книгу"]
  пусть знаки равно (отобразить (разложить текст на символы)
    как знак → «Без знаков препинания» от («Строчная буква» от знак))
  отфильтровать (разделить (соединить знаки по "") по " ") где слово → (длина слово) больше 0

тотальная функция «Стереть согласование у простого»
  принимает простой: «Простой тип»
  возвращает «Простой тип»
  пример «род, число и лицо забыты, падеж и сопряжение остались»
    дано простой равно (запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
      и лицо равным "3" и сопряжение равным 1)
    ожидается (запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 1)
  (запись «Простой тип» с вид равным простой.вид и падеж равным простой.падеж и род равным "*" и число равным "*"
    и лицо равным "*" и сопряжение равным простой.сопряжение)

тотальная функция «Стереть падеж у простого»
  принимает простой: «Простой тип»
  возвращает «Простой тип»
  пример «падеж забыт, остальное осталось»
    дано простой равно (запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "ж" и число равным "ед"
      и лицо равным "3" и сопряжение равным -1)
    ожидается (запись «Простой тип» с вид равным "n" и падеж равным "*" и род равным "ж" и число равным "ед"
      и лицо равным "3" и сопряжение равным -1)
  (запись «Простой тип» с вид равным простой.вид и падеж равным "*" и род равным простой.род
    и число равным простой.число и лицо равным простой.лицо и сопряжение равным простой.сопряжение)

тотальная функция «Стереть согласование»
  принимает т: «Тип»
  возвращает «Тип»
  для всех т обеспечивает «стирание согласования не меняет длины» (длина результат) равен (длина т)
  отобразить т как простой → «Стереть согласование у простого» от простой

тотальная функция «Стереть падеж»
  принимает т: «Тип»
  возвращает «Тип»
  для всех т обеспечивает «стирание падежа не меняет длины» (длина результат) равен (длина т)
  отобразить т как простой → «Стереть падеж у простого» от простой

тотальная функция «Ослабить тип»
  принимает т: «Тип», согласование: признак, падеж: признак
  возвращает «Тип»
  пусть без_согласования равно (если согласование то «Стереть согласование» от т иначе т)
  если падеж то «Стереть падеж» от без_согласования иначе без_согласования

тотальная функция «Ослабить слова»
  принимает слова: список «Слово с типами», согласование: признак, падеж: признак
  возвращает список «Слово с типами»
  (отобразить слова как слово → запись «Слово с типами» с номер равным слово.номер
    и типы равным (отобразить слово.типы как т → «Ослабить тип» от т и согласование и падеж))

тотальная функция «Сводится ли»
  принимает слова: список «Слово с типами»
  возвращает признак
  разбор («Разобрать типы» от слова и («Предложение»))
    случай вариант «Сводится» с выбор как выбор и связи как связи
      то да
    случай любое
      то нет

тотальная функция «Пронумеровать»
  принимает словарь: список «Статья», слова: список строки
  возвращает список «Слово с типами»
  (свёртка слова начиная с пустой список как итог
    и слово → добавить (запись «Слово с типами» с номер равным ((длина итог) плюс 1)
    и типы равным (свёртка («Статьи слова» от словарь и слово) начиная с пустой список как типы
    и статья → «Склеить списки» от типы и статья.типы)) к итог)

тотальная функция «Первое неизвестное»
  принимает словарь: список «Статья», слова: список строки
  возвращает строка
  (свёртка слова начиная с "" как найдено и слово → (если (найдено равен "") и притом ((длина («Статьи слова» от словарь
    и слово)) равен 0) то слово иначе найдено))

тотальная функция «Есть сказуемое»
  принимает словарь: список «Статья», слова: список строки
  возвращает признак
  (свёртка слова начиная с нет как есть и слово → есть или ((длина (отфильтровать («Статьи слова» от словарь
    и слово) где статья → статья.часть равен "глагол")) больше 0))

тотальная функция «Ошибка без согласования»
  принимает слова: список «Слово с типами»
  возвращает «Вердикт»
  если «Сводится ли» от («Ослабить слова» от слова и нет и да)
    то вариант «Неверный падеж»
    иначе (если «Сводится ли» от («Ослабить слова» от слова и да и да)
      то вариант «Неверный падеж и нет согласования»
      иначе вариант «Строй не сводится»)

тотальная функция «Ошибка по ослаблениям»
  принимает слова: список «Слово с типами»
  возвращает «Вердикт»
  если «Сводится ли» от («Ослабить слова» от слова и да и нет)
    то вариант «Нет согласования»
    иначе «Ошибка без согласования» от слова

тотальная функция «Вердикт по словам»
  принимает слова: список «Слово с типами»
  возвращает «Вердикт»
  разбор («Разобрать типы» от слова и («Предложение»))
    случай вариант «Сводится» с выбор как выбор и связи как связи
      то вариант «Грамматично» с выбор равным выбор и связи равным связи
    случай любое
      то «Ошибка по ослаблениям» от слова

тотальная функция «Вердикт знакомых слов»
  принимает словарь: список «Статья», слова: список строки
  возвращает «Вердикт»
  если «Есть сказуемое» от словарь и слова
    то «Вердикт по словам» от («Пронумеровать» от словарь и слова)
    иначе вариант «Нет сказуемого»

тотальная функция «Вердикт»
  принимает предложение: строка
  возвращает «Вердикт»
  пример «мама спит»
    дано предложение равно "мама спит"
    ожидается (вариант «Грамматично» с выбор равным [[(запись «Простой тип» с вид равным "n" и падеж равным "им"
      и род равным "ж" и число равным "ед" и лицо равным "3" и сопряжение равным 0)], [
      (запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед" и лицо равным "3"
      и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*"
      и число равным "*" и лицо равным "*" и сопряжение равным 0)]] и связи равным [(запись «Связь» с левое равным 1
      и правое равным 2)])
  пример «мама спят — число не согласовано»
    дано предложение равно "мама спят"
    ожидается вариант «Нет согласования»
  пример «мама книгу — сказуемого нет»
    дано предложение равно "мама книгу"
    ожидается вариант «Нет сказуемого»
  пусть словарь равно «Словарь»
  пусть слова равно «Слова» от предложение
  пусть неизвестное равно «Первое неизвестное» от словарь и слова
  если (длина неизвестное) больше 0
    то вариант «Неизвестное слово» с слово равным неизвестное
    иначе «Вердикт знакомых слов» от словарь и слова

тотальная функция «Метка сопряжения»
  принимает сопряжение: число
  возвращает строка
  пример «левое»
    дано сопряжение равно -1
    ожидается "ˡ"
  пример «дважды правое»
    дано сопряжение равно 2
    ожидается "ʳʳ"
  пусть знак равно (если сопряжение меньше 0 то "ˡ" иначе "ʳ")
  пусть сколько равно (если сопряжение меньше 0 то 0 минус сопряжение иначе сопряжение)
  если сколько равен 0
    то ""
    иначе (если сколько равен 1 то знак иначе соединить [знак, знак] по "")

тотальная функция «Записать простой»
  принимает простой: «Простой тип»
  возвращает строка
  пример «правое сопряжённое подлежащего»
    дано простой равно (запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
      и лицо равным "3" и сопряжение равным 1)
    ожидается "n[им ед 3]ʳ"
  пример «предложение без признаков»
    дано простой равно (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным 0)
    ожидается "s"
  пусть признаки равно (отфильтровать [простой.падеж, простой.род, простой.число,
    простой.лицо] где признак → не (признак равен "*"))
  пусть скобки равно (если (длина признаки) равен 0 то "" иначе соединить ["[", соединить признаки по " ", "]"] по "")
  соединить [простой.вид, скобки, «Метка сопряжения» от простой.сопряжение] по ""

тотальная функция «Записать тип»
  принимает т: «Тип»
  возвращает строка
  пример «переходный глагол между подлежащим и дополнением»
    дано т равно [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
      и лицо равным "3" и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*"
      и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 0),
      (запись «Простой тип» с вид равным "n" и падеж равным "вин" и род равным "*" и число равным "*" и лицо равным "*"
      и сопряжение равным -1)]
    ожидается "n[им ед 3]ʳ · s · n[вин]ˡ"
  соединить (отобразить т как простой → «Записать простой» от простой) по " · "

тотальная функция «Записать связи»
  принимает слова: список строки, связи: список «Связь»
  возвращает строка
  пример «две связи»
    дано слова равно ["мама", "читает", "книгу"]
    дано связи равно [(запись «Связь» с левое равным 1 и правое равным 2), (запись «Связь» с левое равным 2
      и правое равным 3)]
    ожидается "мама—читает, читает—книгу"
  (соединить (отобразить связи как связь → соединить [элемент связь.левое в слова, "—",
    элемент связь.правое в слова] по "") по ", ")

тотальная функция «Записать выбор»
  принимает слова: список строки, выбор: список «Тип»
  возвращает строка
  пример «слово и его тип»
    дано слова равно ["мама"]
    дано выбор равно [[(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
      и лицо равным "3" и сопряжение равным 0)]]
    ожидается "мама: n[им ж ед 3]"
  (соединить (свёртка выбор начиная с пустой список как строки и т → добавить (соединить [
    элемент ((длина строки) плюс 1) в слова, ": ", «Записать тип» от т] по "") к строки) по "; ")

тотальная функция «Разобрать»
  принимает предложение: строка
  возвращает строка
  пример «грамматичное предложение: типы слов и связи»
    дано предложение равно "Мама спит."
    ожидается "грамматично: мама: n[им ж ед 3]; спит: n[им ед 3]ʳ · s; связи: мама—спит"
  пример «неверный падеж»
    дано предложение равно "мама читает книга"
    ожидается "не грамматично: неверный падеж"
  пусть слова равно «Слова» от предложение
  разбор («Вердикт» от предложение)
    случай вариант «Грамматично» с выбор как выбор и связи как связи
      то (соединить ["грамматично: ", «Записать выбор» от слова и выбор, "; связи: ",
        «Записать связи» от слова и связи] по "")
    случай вариант «Неизвестное слово» с слово как слово
      то соединить ["не грамматично: неизвестное слово «", слово, "»"] по ""
    случай вариант «Нет сказуемого»
      то "не грамматично: нет сказуемого"
    случай вариант «Нет согласования»
      то "не грамматично: нет согласования по роду, числу или лицу"
    случай вариант «Неверный падеж»
      то "не грамматично: неверный падеж"
    случай вариант «Неверный падеж и нет согласования»
      то "не грамматично: неверный падеж и нет согласования"
    случай вариант «Строй не сводится»
      то "не грамматично: типы слов не сводятся к s"

тотальная функция «Типы слова»
  принимает слово: строка
  возвращает строка
  пример «непереходный глагол: два порядка»
    дано слово равно "спит"
    ожидается "s · n[им ед 3]ˡ; n[им ед 3]ʳ · s"
  пример «незнакомое слово типов не имеет»
    дано слово равно "шьёт"
    ожидается ""
  пусть статьи равно «Статьи слова» от («Словарь») и слово
  (соединить (свёртка статьи начиная с пустой список как типы и статья → «Склеить списки» от типы
    и (отобразить статья.типы как т → «Записать тип» от т)) по "; ")
