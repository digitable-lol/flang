модуль «Russian sentence»
  использует «Russian chart» из "chart.flang"
  использует «Russian sample dictionary» из "sample-dictionary.flang"

объект «Разбор предложения»
  слова является список строки
  леммы является список строки
  части является список строки
  типы является список строки
  строй является список «Тип»
  связи является список «Связь разбора»

объект «Сверх разбора»
  цены является список числа
  пометы является список список строки
  вид является строкой

тип «Ответ разбора»
  вариант «Разобрано» содержит разборы: список «Разбор предложения», всего: число, работа: число, сверх: «Сверх разбора»
  вариант «Не разобрано» содержит причина: строка, слово: строка, место: число, работа: число

тотальная функция «Запись основы»
  принимает кат: строка, признаки: список строки
  возвращает строка
  пример «именная группа с признаками»
    дано кат равно "n"
    дано признаки равно ["вин", "ж", "ед", "3"]
    ожидается "n[вин ж ед 3]"
  пример «сказуемое пишется буквой s, звёздочки опускаются»
    дано кат равно "v"
    дано признаки равно ["*", "*", "ед", "3"]
    ожидается "s[ед 3]"
  пример «без признаков скобок нет»
    дано кат равно "d"
    дано признаки равно ["*", "*", "*", "*"]
    ожидается "d"
  пусть важные равно отфильтровать признаки где признак → признак не равен "*"
  пусть буква равно (если кат равен "v" то "s" иначе кат)
  если (длина важные) равен 0
    то буква
    иначе соединить [буква, "[", соединить важные по " ", "]"] по ""

тотальная функция «Лексический узел»
  принимает слово: «Слово предложения», кат: строка, признаки: список строки, свойства: строка, отн: строка
  возвращает «Узел карты»
  («Собрать узел» от кат и [элемент 1 в признаки, элемент 2 в признаки, элемент 3 в признаки,
    элемент 4 в признаки, свойства, "", отн] и нет и нет и 1 и [(запись «Дерево» с вершина равным слово.место
    и цена равным 0 и примета равным 0
    и связи равным [(запись «Связь разбора» с главное равным 0 и зависимое равным слово.место
    и роль равным (соединить (приписать кат к признаки) по ";"))])])

тотальная функция «С леммой»
  принимает узел: «Узел карты», лемма: строка, часть: строка, пометы: строка
  возвращает «Узел карты»
  («Собрать узел» от узел.кат и («Признаки узла» от узел) и узел.слева и узел.сочинён и узел.счёт
    и (отобразить узел.деревья как дерево → (запись «Дерево» с вершина равным дерево.вершина
    и цена равным дерево.цена и примета равным дерево.примета
    и связи равным (отобразить дерево.связи как связь → (запись «Связь разбора»
    с главное равным связь.главное и зависимое равным связь.зависимое
    и роль равным (соединить [связь.роль, лемма, часть, пометы] по ";"))))))

тотальная функция «Помета свойства»
  принимает есть: признак, текст: строка
  возвращает строка
  если есть то соединить текст с " " иначе ""

тотальная функция «Свойства глагола»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает строка
  (соединить [" ", «Помета свойства» от (чтение.прочее содержит "перех") и "перех",
    «Помета свойства» от ((«Связочные глаголы») содержит чтение.лемма) и "связка",
    «Помета свойства» от ((«Глаголы с родительным») содержит чтение.лемма) и "род+",
    «Помета свойства» от ((«Слова с дательным») содержит чтение.лемма) и "дат+",
    «Помета свойства» от ((«Глаголы речи и мысли») содержит чтение.лемма) и "речь",
    «Помета свойства» от слово.отрицание и "отр", «Помета свойства» от слово.сравнение и "сравн"] по "")

тотальная функция «Узлы определения»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть неизменяемое равно чтение.прочее содержит "неизм"
  пусть признаки равно (если неизменяемое то ["*", "*", "*", "*"] иначе [чтение.падеж, чтение.род, чтение.число,
    "*"])
  пусть переходное равно (чтение.прочее содержит "перех") и притом (не (чтение.прочее содержит "страд"))
  пусть творительное равно (((чтение.прочее содержит "страд") или (чтение.прочее содержит "возвр"))
    или ((«Слова с творительным») содержит чтение.лемма))
  пусть свойства равно (соединить [" ", «Помета свойства» от (чтение.часть равен "прич") и "прич",
    «Помета свойства» от переходное и "перех", «Помета свойства» от творительное и "тв+",
    «Помета свойства» от ((«Слова с дательным») содержит чтение.лемма) и "дат+",
    «Помета свойства» от ((«Глаголы с родительным») содержит чтение.лемма) и "род+",
    «Помета свойства» от (чтение.прочее содержит "местоим") и "опр",
    «Помета свойства» от слово.отрицание и "отр", «Помета свойства» от слово.сравнение и "сравн"] по "")
  пусть определение равно «Лексический узел» от слово и "a" и признаки и свойства и ""
  пусть имя равно («Лексический узел» от слово и "n" и [чтение.падеж, чтение.род, чтение.число, "3"] и " мест "
    и "")
  если чтение.лемма равен "который"
    то [(«Лексический узел» от слово и "n" и [чтение.падеж, чтение.род, чтение.число, "3"] и " мест "
      и (соединить [чтение.род, " ", чтение.число] по ""))]
    иначе (если («Определители без существительного») содержит чтение.лемма
      то [определение, имя]
      иначе [определение])

тотальная функция «Узлы имени»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть ярлык равно (чтение.прочее содержит "ярлык") или (чтение.прочее содержит "сокр")
  пусть лицо равно (если чтение.лицо равен "*" то "3" иначе чтение.лицо)
  пусть отглагольное равно («Кончается на» от чтение.лемма и "ние") или («Кончается на» от чтение.лемма и "тие")
  пусть ясный_дательный равно (чтение.падеж равен "дат") и притом (чтение.прочее содержит "дат!")
  пусть общие равно (соединить [«Помета свойства» от ясный_дательный и "дат!",
    «Помета свойства» от слово.отрицание и "отр",
    «Помета свойства» от (слово.заглавное и притом (слово.место больше 1)) и "загл"] по "")
  пусть род равно (если чтение.число равен "мн" то "*" иначе чтение.род)
  если чтение.часть равен "сущ"
    то [(«Лексический узел» от слово и "n" и [чтение.падеж, род, чтение.число, "3"] и (соединить [" ",
      «Помета свойства» от ярлык и "ярлык", «Помета свойства» от отглагольное и "отгл", общие] по "") и "")]
    иначе [(«Лексический узел» от слово и "n" и [чтение.падеж, чтение.род, чтение.число, лицо] и (соединить [
      " мест ", «Помета свойства» от (чтение.прочее содержит "это") и "это", общие] по "")
      и (если чтение.лемма равен "что" то "с ед" иначе ""))]

тотальная функция «Кончается на»
  принимает слово: строка, хвост: строка
  возвращает признак
  пример «отглагольное существительное»
    дано слово равно "управление"
    дано хвост равно "ние"
    ожидается да
  пример «короткое слово»
    дано слово равно "ие"
    дано хвост равно "ние"
    ожидается нет
  ((длина слово) больше (длина хвост)) и притом ((подстрока слово с (((длина слово) минус (длина хвост))
    плюс 1) по (длина слово)) равен хвост)

тотальная функция «Пометить ясный дательный»
  принимает чтения: список «Чтение»
  возвращает список «Чтение»
  пусть имена равно (отфильтровать чтения где чтение → (чтение.часть равен "сущ")
    или (чтение.часть равен "мест"))
  пусть иные равно отфильтровать имена где чтение → чтение.падеж не равен "дат"
  если ((длина иные) больше 0) или ((длина имена) равен 0)
    то чтения
    иначе (отобразить чтения как чтение → (запись «Чтение» с лемма равным чтение.лемма
      и часть равным чтение.часть и падеж равным чтение.падеж и род равным чтение.род
      и число равным чтение.число и лицо равным чтение.лицо и время равным чтение.время
      и прочее равным (соединить [чтение.прочее, " дат!"] по "")))

тотальная функция «Слить роды»
  принимает чтения: список «Чтение»
  возвращает список «Чтение»
  (отобразить (отфильтровать чтения где чтение → не («Средний при мужском» от чтения
    и чтение)) как чтение → (если «Мужской при среднем» от чтения и чтение
    то (запись «Чтение» с лемма равным чтение.лемма и часть равным чтение.часть и падеж равным чтение.падеж
      и род равным "м|с" и число равным чтение.число и лицо равным чтение.лицо и время равным чтение.время
      и прочее равным чтение.прочее)
    иначе чтение))

тотальная функция «Слить падежи числительных»
  принимает чтения: список «Чтение»
  возвращает список «Чтение»
  (отобразить (отфильтровать чтения где чтение → не («Числительное в падеже» от чтения и чтение и "вин"
    и "им")) как чтение → (если «Числительное в падеже» от чтения и чтение и "им" и "вин"
    то (запись «Чтение» с лемма равным чтение.лемма и часть равным чтение.часть и падеж равным "им|вин"
      и род равным чтение.род и число равным чтение.число и лицо равным чтение.лицо и время равным чтение.время
      и прочее равным чтение.прочее)
    иначе чтение))

тотальная функция «Числительное в падеже»
  принимает чтения: список «Чтение», чтение: «Чтение», свой: строка, чужой: строка
  возвращает признак
  (((чтение.часть равен "числ") и притом (чтение.падеж равен свой)) и притом (свёртка чтения начиная с нет
    как есть и другое → есть или ((другое.часть равен "числ") и притом (другое.падеж равен чужой))))

тотальная функция «Те же кроме рода»
  принимает первое: «Чтение», второе: «Чтение»
  возвращает признак
  ((первое.часть равен второе.часть) и притом (первое.падеж равен второе.падеж)) и притом ((первое.число
    равен второе.число) и притом ((первое.лемма равен второе.лемма) и притом (первое.прочее равен второе.прочее)))

тотальная функция «Определительное чтение»
  принимает чтение: «Чтение»
  возвращает признак
  (чтение.часть равен "прил") или (чтение.часть равен "прич")

тотальная функция «Средний при мужском»
  принимает чтения: список «Чтение», чтение: «Чтение»
  возвращает признак
  (((«Определительное чтение» от чтение) и притом (чтение.род равен "с")) и притом (свёртка чтения начиная с нет
    как есть и другое → есть или ((другое.род равен "м") и притом («Те же кроме рода» от чтение и другое))))

тотальная функция «Мужской при среднем»
  принимает чтения: список «Чтение», чтение: «Чтение»
  возвращает признак
  (((«Определительное чтение» от чтение) и притом (чтение.род равен "м")) и притом (свёртка чтения начиная с нет
    как есть и другое → есть или ((другое.род равен "с") и притом («Те же кроме рода» от чтение и другое))))

тотальная функция «Узлы сказуемого»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  пусть отрицание равно «Помета свойства» от слово.отрицание и "отр"
  если часть равен "глагол"
    то [(«Лексический узел» от слово и "v" и ["*", чтение.род, чтение.число, чтение.лицо] и («Свойства глагола»
      от слово и чтение) и "")]
    иначе (если часть равен "предик"
      то [(«Лексический узел» от слово и "v" и ["*", "*", "*", "*"] и (соединить («Свойства глагола» от слово
        и чтение) с "безл ") и "")]
      иначе [(«Лексический узел» от слово и "v" и ["*", чтение.род, чтение.число, "*"] и (соединить [
        «Свойства глагола» от слово и чтение, "крат "] по "") и "")])

тотальная функция «Узлы неличной формы»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть кат равно (если чтение.часть равен "инф" то "i" иначе "g")
  [(«Лексический узел» от слово и кат и ["*", "*", "*", "*"] и («Свойства глагола» от слово и чтение) и "")]

тотальная функция «Узлы служебного»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  пусть без_признаков равно ["*", "*", "*", "*"]
  пусть с_пробелами равно соединить [" ", чтение.прочее, " "] по ""
  пусть союз равно (если чтение.прочее равен "соч" то "&" иначе "c")
  если часть равен "предлог"
    то [(«Лексический узел» от слово и "r" и без_признаков и с_пробелами и "")]
    иначе (если часть равен "союз"
      то [(«Лексический узел» от слово и союз и без_признаков и с_пробелами и "")]
      иначе «Узлы наречия» от слово и чтение)

тотальная функция «Узлы наречия»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  пусть без_признаков равно ["*", "*", "*", "*"]
  если часть равен "комп"
    то [(«Лексический узел» от слово и "d" и без_признаков и " сравн " и ""),
      («Лексический узел» от слово и "v" и без_признаков и " род+ крат сравн " и "")]
    иначе «Узлы простого наречия» от слово и чтение

тотальная функция «Узлы простого наречия»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  пусть без_признаков равно ["*", "*", "*", "*"]
  если часть равен "нареч"
    то [(«Лексический узел» от слово и "d" и без_признаков и (соединить [" ",
      «Помета свойства» от слово.сравнение и "сравн",
      «Помета свойства» от ((«Наречия степени») содержит чтение.лемма) и "степень"] по "") и "")]
    иначе (если (часть равен "вводное") или (часть равен "вывод")
      то [(«Лексический узел» от слово и "d" и без_признаков и (соединить [" ", часть, " вв "] по "") и "")]
      иначе «Узлы числительного» от слово и чтение)

тотальная функция «Узлы числительного»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть малое равно ["два", "три", "четыре", "оба", "полтора"] содержит чтение.лемма
  пусть неопределённое равно ["много", "мало", "немало", "сколько", "столько", "несколько"] содержит чтение.лемма
  пусть свойства равно (соединить [" ", «Помета свойства» от малое и "малое",
    «Помета свойства» от неопределённое и "неопр"] по "")
  если чтение.часть равен "числ"
    то [(«Лексический узел» от слово и "q" и [чтение.падеж, "*", "*", "*"] и свойства и "")]
    иначе пустой список

тотальная функция «Узлы чтения»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  если (часть равен "сущ") или (часть равен "мест")
    то «Узлы имени» от слово и чтение
    иначе (если (часть равен "прил") или (часть равен "прич")
      то «Узлы определения» от слово и чтение
      иначе «Узлы глагольного чтения» от слово и чтение)

тотальная функция «Узлы глагольного чтения»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  пусть сказуемое равно (часть равен "глагол") или ((часть равен "предик") или ((часть равен "кр_прил")
    или (часть равен "кр_прич")))
  если сказуемое
    то «Узлы сказуемого» от слово и чтение
    иначе (если (часть равен "инф") или (часть равен "деепр")
      то «Узлы неличной формы» от слово и чтение
      иначе «Узлы служебного» от слово и чтение)

тотальная функция «Есть ключ»
  принимает узлы: список «Узел карты», ключ: строка
  возвращает признак
  свёртка узлы начиная с нет как есть и узел → есть или (узел.ключ равен ключ)

тотальная функция «Без повторов»
  принимает узлы: список «Узел карты»
  возвращает список «Узел карты»
  (свёртка узлы начиная с пустой список как итог и узел → (если «Есть ключ» от итог и узел.ключ
    то итог
    иначе добавить узел к итог))

тотальная функция «Причастие заслоняет»
  принимает узлы: список «Узел карты», узел: «Узел карты»
  возвращает признак
  пусть простое равно (узел.кат равен "a") и притом (не (узел.свойства содержит " прич "))
  (простое и притом (свёртка узлы начиная с нет как есть и другой → есть или ((другой.кат равен "a")
    и притом ((другой.свойства содержит " прич ") и притом ((другой.падеж равен узел.падеж)
    и притом ((другой.род равен узел.род) и притом (другой.число равен узел.число)))))))

тотальная функция «Узлы по виду»
  принимает слово: «Слово предложения»
  возвращает список «Узел карты»
  пусть без_признаков равно ["*", "*", "*", "3"]
  пусть имя_посреди равно (слово.вид равен "слово") и притом (слово.заглавное и притом (слово.место больше 1))
  если слово.вид равен "число"
    то [(«Лексический узел» от слово и "q" и ["*", "*", "*", "*"] и " цифра " и ""),
      («Лексический узел» от слово и "n" и без_признаков и " ярлык " и "")]
    иначе (если ((слово.вид равен "латиница") или (слово.вид равен "цитата")) или имя_посреди
      то [(«Лексический узел» от слово и "n" и без_признаков и " ярлык " и "")]
      иначе пустой список)

тотальная функция «Чтения слова»
  принимает слово: «Слово предложения», словарь: список строки
  возвращает список «Чтение»
  пусть закрытые равно «Закрытые чтения» от слово.слово
  если (длина закрытые) больше 0
    то закрытые
    иначе «Открытые чтения» от словарь и слово.слово

тотальная функция «Открытые чтения»
  принимает словарь: список строки, форма: строка
  возвращает список «Чтение»
  пример «перенос внутри слова: форма без дефиса»
    дано словарь равно ["галоперидол=галоперидол,сущ,им,м,ед"]
    дано форма равно "галопе-ридол"
    ожидается [(запись «Чтение» с лемма равным "галоперидол" и часть равным "сущ" и падеж равным "им" и род равным "м"
      и число равным "ед" и лицо равным "*" и время равным "*" и прочее равным "*")]
  пример «составное слово через дефис: последняя часть»
    дано словарь равно ["финансисты=финансист,сущ,им,м,мн"]
    дано форма равно "экономисты-финансисты"
    ожидается [(запись «Чтение» с лемма равным "финансист" и часть равным "сущ" и падеж равным "им" и род равным "м"
      и число равным "мн" и лицо равным "*" и время равным "*" и прочее равным "*")]
  пусть части равно разделить форма по "-"
  пусть целое равно «Открытые чтения формы» от словарь и форма
  пусть слитно равно (если (длина части) больше 1 то «Открытые чтения формы» от словарь и (соединить части по "")
    иначе пустой список)
  если ((длина целое) больше 0) или ((длина части) меньше 2)
    то целое
    иначе (если (длина слитно) больше 0
      то слитно
      иначе «Открытые чтения формы» от словарь и (элемент (длина части) в части))

тотальная функция «Открытые чтения формы»
  принимает словарь: список строки, форма: строка
  возвращает список «Чтение»
  (отфильтровать («Чтения по таблице» от словарь и форма) где чтение → не (["союз", "предлог",
    "частица", "межд", "вводное", "вывод"] содержит чтение.часть))

тотальная функция «Пометы слова»
  принимает слово: «Слово предложения», прочее: строка
  возвращает строка
  пусть посреди равно слово.заглавное и притом (слово.место больше 1)
  (соединить (отфильтровать [(если слово.отрицание то "отрицание" иначе ""),
    (если посреди то "заглавное" иначе ""), (если слово.сравнение то "сравнение" иначе ""),
    (если (прочее содержит "имя") то "имя" иначе "")] где помета → (длина помета) больше 0) по " ")

тотальная функция «Лемма для разбора»
  принимает чтения: список «Чтение», чтение: «Чтение»
  возвращает строка
  (свёртка чтения начиная с чтение.лемма как лемма и другое → (если ((чтение.часть равен "прич")
    и притом (другое.часть равен "прил")) и притом ((другое.падеж равен чтение.падеж)
    и притом (другое.число равен чтение.число))
    то другое.лемма
    иначе лемма))

тотальная функция «Узлы слова»
  принимает слово: «Слово предложения», словарь: список строки
  возвращает список «Узел карты»
  пример «неизвестное слово — пустой список»
    дано слово равно (запись «Слово предложения» с место равным 1 и слово равным "шьет" и вид равным "слово"
      и заглавное равным нет и запятая равным нет и тире равным нет и двоеточие равным нет и отрицание равным нет
      и сравнение равным нет
      и привязки равным пустой список)
    дано словарь равно пустой список
    ожидается пустой список
  пусть чтения равно («Слить падежи числительных» от («Слить роды» от («Пометить ясный дательный»
    от («Чтения слова» от слово и словарь))))
  пусть все равно («Без повторов» от (свёртка чтения начиная с пустой список как итог и чтение → «Вместе» от итог
    и (отобразить («Узлы чтения» от слово и чтение) как узел → «С леммой» от узел и («Лемма для разбора»
    от чтения и чтение) и чтение.часть и («Пометы слова» от слово и чтение.прочее))))
  пусть узлы равно отфильтровать все где узел → не («Причастие заслоняет» от все и узел)
  если ((длина узлы) равен 0) и притом ((длина чтения) равен 0)
    то (отобразить («Узлы по виду» от слово) как узел → «С леммой» от узел и слово.слово и слово.вид
      и («Пометы слова» от слово и ""))
    иначе узлы

тотальная функция «Условия разбора»
  принимает согласование: признак, падежи: признак, деревьев: число
  возвращает «Условия»
  (запись «Условия» с согласование равным согласование и падежи равным падежи и деревьев равным деревьев
    и работы равным («Предел работы»))

тотальная функция «Предел работы»
  возвращает число
  40000

тотальная функция «Предел слов»
  возвращает число
  60

тотальная функция «Предел слов для подсказки»
  возвращает число
  12

тотальная функция «Предложения клетки»
  принимает узлы: список «Узел карты»
  возвращает список «Узел карты»
  отфильтровать узлы где узел → (узел.кат равен "v") и притом (узел.отн равен "")

тотальная функция «Назывные клетки»
  принимает узлы: список «Узел карты»
  возвращает список «Узел карты»
  отфильтровать узлы где узел → ((узел.кат равен "n") и притом (узел.отн равен "")) и притом («Подходит» от узел.падеж
    и "им")

тотальная функция «Целая клетка»
  принимает карта: «Карта», слов: число
  возвращает список «Узел карты»
  «Предложения клетки» от («Клетка карты» от карта.ряды и 0 и слов)

тотальная функция «Описание слова»
  принимает связи: список «Связь разбора», место: число
  возвращает список строки
  (свёртка связи начиная с пустой список как описание и связь → (если (связь.зависимое равен место)
    и притом (связь.главное равен 0)
    то разделить связь.роль по ";"
    иначе описание))

тотальная функция «Слово со связкой»
  принимает связи: список «Связь разбора», место: число
  возвращает признак
  (свёртка связи начиная с нет как есть и связь → есть или ((связь.главное равен место)
    и притом (связь.роль равен "подлежащее при связке")))

тотальная функция «Признаки из описания»
  принимает описание: список строки
  возвращает список строки
  [«Поле чтения» от описание и 2, «Поле чтения» от описание и 3, «Поле чтения» от описание и 4,
    «Поле чтения» от описание и 5]

тотальная функция «Основа слова»
  принимает связи: список «Связь разбора», место: число
  возвращает строка
  пусть описание равно «Описание слова» от связи и место
  если (длина описание) равен 0
    то ""
    иначе (если «Слово со связкой» от связи и место
      то "s"
      иначе «Запись основы» от («Поле чтения» от описание и 1) и («Признаки из описания» от описание))

тотальная функция «Простой тип слова»
  принимает связи: список «Связь разбора», место: число, сопряжение: число
  возвращает «Простой тип»
  пусть описание равно «Описание слова» от связи и место
  пусть кат равно «Поле чтения» от описание и 1
  если («Слово со связкой» от связи и место) или ((длина описание) равен 0)
    то (запись «Простой тип» с вид равным "s" и падеж равным "*" и род равным "*" и число равным "*"
      и лицо равным "*" и сопряжение равным сопряжение)
    иначе (запись «Простой тип» с вид равным (если кат равен "v" то "s" иначе кат)
      и падеж равным («Поле чтения» от описание и 2) и род равным («Поле чтения» от описание и 3)
      и число равным («Поле чтения» от описание и 4) и лицо равным («Поле чтения» от описание и 5)
      и сопряжение равным сопряжение)

тотальная функция «Простые с края»
  принимает связи: список «Связь разбора», зависимые: список «Связь разбора», места: список числа
  принимает сопряжение: число
  возвращает «Тип»
  (свёртка места начиная с пустой список как итог и место → (свёртка зависимые начиная с итог как сбор
    и связь → (если связь.зависимое равен место
    то добавить («Простой тип слова» от связи и место и сопряжение) к сбор
    иначе сбор)))

тотальная функция «Строй слова»
  принимает связи: список «Связь разбора», место: число, слов: число
  возвращает «Тип»
  пусть зависимые равно отфильтровать связи где связь → связь.главное равен место
  пусть левые равно «Простые с края» от связи и зависимые и («Числа вниз» от (место минус 1) и 1) и 1
  пусть правые равно «Простые с края» от связи и зависимые и («Числа вниз» от слов и (место плюс 1)) и -1
  если (длина («Описание слова» от связи и место)) равен 0
    то пустой список
    иначе («Склеить списки» от («Склеить списки» от левые и [(«Простой тип слова» от связи и место и 0)])
      и правые)

тотальная функция «Роль приставного в разборе»
  принимает приставные: список «Связь разбора», место: число
  возвращает строка
  (свёртка приставные начиная с "" как роль и связь → (если связь.зависимое равен место
    то связь.роль
    иначе роль))

тотальная функция «Пометы в разборе»
  принимает связи: список «Связь разбора», место: число
  возвращает строка
  пусть описание равно «Описание слова» от связи и место
  если (длина описание) не меньше 8 то элемент 8 в описание иначе ""

тотальная функция «Лемма или роль»
  принимает связи: список «Связь разбора», приставные: список «Связь разбора», слово: строка, место: число
  принимает номер: число
  возвращает строка
  пусть описание равно «Описание слова» от связи и место
  если (длина описание) больше 0
    то «Поле чтения» от описание и номер
    иначе (если номер равен 6 то слово иначе «Роль приставного в разборе» от приставные и место)

тотальная функция «Сопряжённые с края»
  принимает связи: список «Связь разбора», зависимые: список «Связь разбора», места: список числа, знак: строка
  возвращает список строки
  (свёртка места начиная с пустой список как итог и место → (свёртка зависимые начиная с итог как сбор
    и связь → (если связь.зависимое равен место
    то добавить (соединить («Основа слова» от связи и место) с знак) к сбор
    иначе сбор)))

тотальная функция «Числа вниз»
  принимает от_числа: число, до_числа: число
  возвращает список числа
  пример «три числа вниз»
    дано от_числа равно 4
    дано до_числа равно 2
    ожидается [4, 3, 2]
  «Перевернуть» от («Числа от до» от до_числа и от_числа)

тотальная функция «Тип слова в разборе»
  принимает связи: список «Связь разбора», приставные: список «Связь разбора», место: число, слов: число
  возвращает строка
  пусть основа равно «Основа слова» от связи и место
  пусть зависимые равно отфильтровать связи где связь → связь.главное равен место
  пусть левые равно «Сопряжённые с края» от связи и зависимые и («Числа вниз» от (место минус 1) и 1) и "ʳ"
  пусть правые равно «Сопряжённые с края» от связи и зависимые и («Числа вниз» от слов и (место плюс 1)) и "ˡ"
  если основа равен ""
    то (свёртка приставные начиная с "" как роль и связь → (если связь.зависимое равен место
      то связь.роль
      иначе роль))
    иначе соединить («Склеить списки» от («Склеить списки» от левые и [основа]) и правые) по " · "

тотальная функция «Приставные связи»
  принимает слова: список «Слово предложения»
  возвращает список «Связь разбора»
  (свёртка слова начиная с пустой список как итог и слово → (свёртка слово.привязки начиная с итог как сбор
    и привязка → добавить (запись «Связь разбора» с главное равным слово.место и зависимое равным привязка.место
    и роль равным привязка.роль) к сбор))

тотальная функция «Разбор из дерева»
  принимает разметка: «Разметка», дерево: «Дерево»
  возвращает «Разбор предложения»
  пусть приставные равно «Приставные связи» от разметка.слова
  пусть слов равно длина разметка.видимые
  пусть места равно «Числа от до» от 1 и слов
  (запись «Разбор предложения» с слова равным разметка.видимые
    и леммы равным (отобразить места как место → «Лемма или роль» от дерево.связи и приставные
    и (элемент место в разметка.видимые) и место и 6)
    и части равным (отобразить места как место → «Лемма или роль» от дерево.связи и приставные
    и (элемент место в разметка.видимые) и место и 7)
    и типы равным (отобразить места как место → «Тип слова в разборе» от дерево.связи
    и приставные и место и слов)
    и строй равным (отобразить места как место → «Строй слова» от дерево.связи и место и слов)
    и связи равным («Склеить списки» от (отфильтровать дерево.связи где связь → связь.главное больше 0)
    и приставные))

тотальная функция «Пометы дерева»
  принимает разметка: «Разметка», дерево: «Дерево»
  возвращает список строки
  (отобразить («Числа от до» от 1 и (длина разметка.видимые)) как место → «Пометы в разборе» от дерево.связи
    и место)

тотальная функция «Первое неизвестное слово»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты»
  возвращает «Слово предложения»
  (свёртка слова начиная с (запись «Слово предложения» с место равным 0 и слово равным "" и вид равным ""
    и заглавное равным нет и запятая равным нет и тире равным нет и двоеточие равным нет и отрицание равным нет
      и сравнение равным нет
    и привязки равным пустой список) как найдено и слово → (если (найдено.место равен 0)
    и притом ((длина (элемент ((длина («Слова до» от слова и слово.место)) плюс 1) в ряд)) равен 0)
    то слово
    иначе найдено))

тотальная функция «Слова до»
  принимает слова: список «Слово предложения», место: число
  возвращает список «Слово предложения»
  отфильтровать слова где слово → слово.место меньше место

тотальная функция «Место остановки»
  принимает карта: «Карта», слов: число
  возвращает число
  (свёртка («Числа от до» от 1 и слов) начиная с 0 как дальше и длина_куска → (если (длина («Клетка карты»
    от карта.ряды и 0 и длина_куска)) больше 0
    то длина_куска
    иначе дальше))

тотальная функция «Есть сказуемое в ряду»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты»
  возвращает признак
  пусть глагол равно (свёртка ряд начиная с нет как есть и узлы → есть или ((длина (отфильтровать узлы
    где узел → узел.кат равен "v")) больше 0))
  пусть тире равно свёртка слова начиная с нет как есть и слово → есть или слово.тире
  пусть указатель равно (свёртка ряд начиная с нет как есть и узлы → есть или ((длина (отфильтровать узлы
    где узел → узел.свойства содержит " это ")) больше 0))
  глагол или (тире или указатель)

тотальная функция «Разбирается при условиях»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты», усл: «Условия»
  возвращает признак
  (длина («Целая клетка» от («Построить карту» от слова и ряд и усл) и (длина слова))) больше 0

тотальная функция «Подсказка»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты»
  возвращает строка
  если «Разбирается при условиях» от слова и ряд и («Условия разбора» от нет и да и 1)
    то "нет согласования по роду, числу или лицу"
    иначе (если «Разбирается при условиях» от слова и ряд и («Условия разбора» от да и нет и 1)
      то "неверный падеж"
      иначе «Подсказка при двух ослаблениях» от слова и ряд)

тотальная функция «Подсказка при двух ослаблениях»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты»
  возвращает строка
  если «Разбирается при условиях» от слова и ряд и («Условия разбора» от нет и нет и 1)
    то "неверный падеж и нет согласования"
    иначе "слова не связываются в предложение"

тотальная функция «Слово по счёту»
  принимает слова: список «Слово предложения», номер: число
  возвращает «Слово предложения»
  элемент (если номер больше (длина слова) то длина слова иначе (если номер меньше 1 то 1 иначе номер)) в слова

тотальная функция «Диагноз»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты», карта: «Карта»
  возвращает «Ответ разбора»
  пусть стоп равно «Слово по счёту» от слова и ((«Место остановки» от карта и (длина слова)) плюс 1)
  если не («Есть сказуемое в ряду» от слова и ряд)
    то (вариант «Не разобрано» с причина равным "нет сказуемого" и слово равным "" и место равным 0
      и работа равным карта.работа)
    иначе (вариант «Не разобрано» с причина равным (если (длина слова) не больше («Предел слов для подсказки»)
      то «Подсказка» от слова и ряд
      иначе "слова не связываются в предложение") и слово равным стоп.слово и место равным стоп.место
      и работа равным карта.работа)

тотальная функция «Лучшие деревья»
  принимает узлы: список «Узел карты»
  возвращает список «Дерево»
  пусть все равно (свёртка узлы начиная с пустой список как итог и узел → (свёртка узел.деревья начиная с итог
    как сбор и дерево → добавить дерево к сбор))
  свёртка все начиная с пустой список как итог и дерево → «Вставить дерево» от итог и дерево и (длина все)

тотальная функция «Ответ по карте»
  принимает разметка: «Разметка», ряд: список список «Узел карты», карта: «Карта»
  возвращает «Ответ разбора»
  пусть слова равно разметка.слова
  пусть сказуемые равно «Целая клетка» от карта и (длина слова)
  пусть назывные равно (если ((длина сказуемые) больше 0) или («Есть сказуемое в ряду» от слова и ряд)
    то пустой список
    иначе «Назывные клетки» от («Клетка карты» от карта.ряды и 0 и (длина слова)))
  пусть предложения равно (если (длина сказуемые) больше 0 то сказуемые иначе назывные)
  пусть вид равно (если (длина сказуемые) больше 0 то "предложение" иначе "назывное")
  если карта.работа больше («Предел работы»)
    то (вариант «Не разобрано» с причина равным "превышен предел работы" и слово равным "" и место равным 0
      и работа равным карта.работа)
    иначе (если (длина предложения) равен 0
      то «Диагноз» от слова и ряд и карта
      иначе (вариант «Разобрано» с разборы равным (отобразить («Лучшие деревья» от предложения)
        как дерево → «Разбор из дерева» от разметка и дерево)
        и сверх равным (запись «Сверх разбора»
        с цены равным (отобразить («Лучшие деревья» от предложения) как дерево → дерево.цена)
        и пометы равным (отобразить («Лучшие деревья» от предложения) как дерево → «Пометы дерева» от разметка
        и дерево) и вид равным вид)
        и всего равным (свёртка предложения начиная с 0 как всего и узел → всего плюс узел.счёт)
        и работа равным карта.работа))

тотальная функция «Ответ по словам»
  принимает разметка: «Разметка», словарь: список строки, деревьев: число
  возвращает «Ответ разбора»
  пусть слова равно разметка.слова
  пусть ряд равно отобразить слова как слово → «Узлы слова» от слово и словарь
  пусть неизвестное равно «Первое неизвестное слово» от слова и ряд
  если неизвестное.место больше 0
    то (вариант «Не разобрано» с причина равным "неизвестное слово" и слово равным неизвестное.слово
      и место равным неизвестное.место и работа равным 0)
    иначе («Ответ по карте» от разметка и ряд и («Построить карту» от слова и ряд и («Условия разбора» от да и да
      и деревьев)))

тотальная функция «Разборы по словарю»
  принимает предложение: строка, словарь: список строки, деревьев: число
  возвращает «Ответ разбора»
  пусть разметка равно «Разметить» от предложение
  пусть слов равно длина разметка.слова
  если слов равен 0
    то (вариант «Не разобрано» с причина равным "в предложении нет слов" и слово равным "" и место равным 0
      и работа равным 0)
    иначе (если слов больше («Предел слов»)
      то (вариант «Не разобрано» с причина равным "предложение длиннее предела" и слово равным ""
        и место равным 0 и работа равным 0)
      иначе «Ответ по словам» от разметка и словарь и деревьев)

тотальная функция «Признаки слова»
  принимает форма: строка
  возвращает список «Чтение»
  пример «у формы два чтения: родительный единственного и именительный множественного»
    дано форма равно "задачи"
    ожидается [(запись «Чтение» с лемма равным "задача" и часть равным "сущ" и падеж равным "род" и род равным "ж"
      и число равным "ед" и лицо равным "*" и время равным "*" и прочее равным "*"),
      (запись «Чтение» с лемма равным "задача" и часть равным "сущ" и падеж равным "им" и род равным "ж"
      и число равным "мн" и лицо равным "*" и время равным "*" и прочее равным "*"),
      (запись «Чтение» с лемма равным "задача" и часть равным "сущ" и падеж равным "вин" и род равным "ж"
      и число равным "мн" и лицо равным "*" и время равным "*" и прочее равным "*")]
  пример «неизвестное слово — пустой список, а не отказ»
    дано форма равно "куздра"
    ожидается пустой список
  «Чтения по таблице» от («Пробный словарь») и форма

тотальная функция «Разборы»
  принимает предложение: строка
  возвращает «Ответ разбора»
  «Разборы по словарю» от предложение и («Пробный словарь») и 8

тотальная функция «Записать связь разбора»
  принимает слова: список строки, связь: «Связь разбора»
  возвращает строка
  соединить [элемент (связь.главное) в слова, "→", элемент (связь.зависимое) в слова, " ", связь.роль] по ""

тотальная функция «Записать разбор»
  принимает прочтение: «Разбор предложения»
  возвращает строка
  пусть типы равно (свёртка прочтение.типы начиная с пустой список как строки и т → добавить (соединить [
    элемент ((длина строки) плюс 1) в прочтение.слова, ": ", т] по "") к строки)
  (соединить [соединить типы по "; ", "; связи: ", (соединить (отобразить прочтение.связи
    как связь → «Записать связь разбора» от прочтение.слова и связь) по ", ")] по "")

тотальная функция «Записать ответ»
  принимает ответ: «Ответ разбора»
  возвращает строка
  разбор ответ
    случай вариант «Разобрано» с разборы как разборы и всего как всего и работа как работа и сверх как сверх
      то (соединить [соединить ["разборов ", к строке всего, (если сверх.вид равен "назывное" то " (назывное)"
        иначе "")] по "", (соединить (отобразить разборы
        как прочтение → «Записать разбор» от прочтение) по " || ")] по ": ")
    случай вариант «Не разобрано» с причина как причина и слово как слово и место как место и работа как работа
      то (если слово равен ""
        то соединить "не разобрано: " с причина
        иначе соединить ["не разобрано: ", причина, ", слово «", слово, "»"] по "")

тотальная функция «Разобрать подробно»
  принимает предложение: строка
  возвращает строка
  «Записать ответ» от («Разборы» от предложение)

тотальная функция «Разобрать со словарём»
  принимает предложение: строка, словарь: строка
  возвращает строка
  «Записать ответ» от («Разборы по словарю» от предложение и (разделить словарь по "|") и 4)

тотальная функция «Итог со словарём»
  принимает предложение: строка, словарь: строка
  возвращает строка
  разбор («Разборы по словарю» от предложение и (разделить словарь по "|") и 1)
    случай вариант «Разобрано» с разборы как разборы и всего как всего и работа как работа
      то соединить ["да", к строке всего, "", "", к строке работа] по "\t"
    случай вариант «Не разобрано» с причина как причина и слово как слово и место как место и работа как работа
      то соединить ["нет", "0", причина, слово, к строке работа] по "\t"

тотальная функция «Самый длинный кусок»
  принимает карта: «Карта», начало: число, слов: число
  возвращает число
  (свёртка («Числа от до» от 1 и (слов минус начало)) начиная с 1 как дальше и длина_куска → (если (длина
    («Клетка карты» от карта.ряды и начало и длина_куска)) больше 0
    то длина_куска
    иначе дальше))

тотальная функция «Виды клетки»
  принимает узлы: список «Узел карты»
  возвращает строка
  (соединить (свёртка узлы начиная с пустой список как виды и узел → (если виды содержит узел.кат
    то виды
    иначе добавить узел.кат к виды)) по "")

тотальная функция «Слова куска»
  принимает слова: список «Слово предложения», начало: число, длина_куска: число
  возвращает строка
  (соединить (отобразить («Числа от до» от (начало плюс 1) и (начало плюс длина_куска))
    как номер → (элемент номер в слова).слово) по " ")

тотальная функция «Собрать куски»
  принимает карта: «Карта», слова: список «Слово предложения», начало: число
  возвращает список строки
  убывает (длина слова) минус начало
  пусть длина_куска равно «Самый длинный кусок» от карта и начало и (длина слова)
  если начало не меньше (длина слова)
    то пустой список
    иначе (приписать (соединить ["[", «Слова куска» от слова и начало и длина_куска, "]",
      «Виды клетки» от («Клетка карты» от карта.ряды и начало и длина_куска)] по "") к («Собрать куски» от карта
      и слова и (начало плюс длина_куска)))

тотальная функция «Куски со словарём»
  принимает предложение: строка, словарь: строка
  возвращает строка
  пусть слова равно («Разметить» от предложение).слова
  пусть таблица равно разделить словарь по "|"
  пусть ряд равно отобразить слова как слово → «Узлы слова» от слово и таблица
  пусть неизвестное равно «Первое неизвестное слово» от слова и ряд
  если ((длина слова) равен 0) или ((неизвестное.место больше 0) или ((длина слова) больше («Предел слов»)))
    то соединить "нет карты: " с неизвестное.слово
    иначе (соединить («Собрать куски» от («Построить карту» от слова и ряд и («Условия разбора» от да и да
      и 1)) и слова и 0) по " ")

тотальная функция «Часть по словарю»
  принимает часть: строка
  возвращает строка
  пример «длинное имя части речи становится коротким»
    дано часть равно "существительное"
    ожидается "сущ"
  пример «незнакомое имя остаётся как есть»
    дано часть равно "союз"
    ожидается "союз"
  (свёртка ["существительное=сущ", "местоимение=мест", "прилагательное=прил", "причастие=прич",
    "деепричастие=деепр", "числительное=числ", "наречие=нареч",
    "предикатив=предик"] начиная с часть как итог и пара → (если пара начинается с (соединить часть с "=")
    то подстрока пара с ((длина часть) плюс 2) по (длина пара)
    иначе итог))

тотальная функция «Краткая или сравнительная»
  принимает часть: строка, пометы: список строки
  возвращает строка
  пусть краткая равно пометы содержит "кратк"
  пусть прилагательное равно (если краткая то "кр_прил" иначе (если пометы содержит "сравн" то "комп"
    иначе "прил"))
  если часть равен "прил"
    то прилагательное
    иначе (если (часть равен "прич") и притом краткая то "кр_прич" иначе часть)

тотальная функция «Часть с пометами»
  принимает часть: строка, падеж: строка, пометы: список строки
  возвращает строка
  пример «краткое прилагательное»
    дано часть равно "прилагательное"
    дано падеж равно "*"
    дано пометы равно ["кратк", "кач"]
    ожидается "кр_прил"
  пример «инфинитив записан глаголом с пометой»
    дано часть равно "глагол"
    дано падеж равно "*"
    дано пометы равно ["инф", "несов", "перех"]
    ожидается "инф"
  пример «повеление и звательный падеж грамматика не читает»
    дано часть равно "глагол"
    дано падеж равно "*"
    дано пометы равно ["несов", "перех", "повел"]
    ожидается "повел"
  пусть короткая равно «Часть по словарю» от часть
  пусть глагольная равно (если пометы содержит "инф" то "инф" иначе (если пометы содержит "повел" то "повел"
    иначе "глагол"))
  если падеж равен "зв"
    то "зв"
    иначе (если короткая равен "глагол" то глагольная иначе «Краткая или сравнительная» от короткая и пометы)

тотальная функция «Пометы из таблицы»
  принимает лемма: строка, часть: строка, пометы: список строки
  возвращает строка
  пример «переходный глагол»
    дано лемма равно "читать"
    дано часть равно "глагол"
    дано пометы равно ["несов", "перех"]
    ожидается "перех "
  пример «непереходный возвратный глагол переходным не считается»
    дано лемма равно "являться"
    дано часть равно "глагол"
    дано пометы равно ["несов", "неперех"]
    ожидается "возвр "
  пусть собственное равно (свёртка ["имя", "фамилия", "отчество", "место", "организация"] начиная с нет как есть
    и помета → есть или (пометы содержит помета))
  пусть глагольное равно ["глагол", "инф", "прич", "кр_прич", "деепр"] содержит часть
  пусть возвратное равно глагольное и притом ((«Кончается на» от лемма и "ся") или («Кончается на» от лемма и "сь"))
  (соединить [«Помета свойства» от (пометы содержит "перех") и "перех",
    «Помета свойства» от (пометы содержит "страд") и "страд",
    «Помета свойства» от (пометы содержит "неизм") и "неизм",
    «Помета свойства» от (пометы содержит "мест") и "местоим",
    «Помета свойства» от (пометы содержит "сокр") и "сокр", «Помета свойства» от собственное и "имя",
    «Помета свойства» от возвратное и "возвр"] по "")

тотальная функция «Строка словаря из строки таблицы»
  принимает строка: строка
  возвращает строка
  пример «строка таблицы признаков становится строкой словаря разбора»
    дано строка равно "стали стать глагол * * мн * прош сов,неперех словарь"
    ожидается "стали=стать,глагол,*,*,мн,*,прош,"
  пример «короткая строка не чтение»
    дано строка равно "стали"
    ожидается ""
  пусть графы равно отфильтровать (разделить строка по " ") где графа → (длина графа) больше 0
  пусть пометы равно разделить («Поле чтения» от графы и 9) по ","
  пусть часть равно «Часть с пометами» от («Поле чтения» от графы и 3) и («Поле чтения» от графы и 4) и пометы
  если (длина графы) меньше 8
    то ""
    иначе (соединить [соединить [«Поле чтения» от графы и 1, "=", «Поле чтения» от графы и 2] по "", часть,
      «Поле чтения» от графы и 4, «Поле чтения» от графы и 5, «Поле чтения» от графы и 6,
      «Поле чтения» от графы и 7, «Поле чтения» от графы и 8,
      «Пометы из таблицы» от («Поле чтения» от графы и 2) и часть и пометы] по ",")

тотальная функция «Словарь из таблицы признаков»
  принимает таблица: строка
  возвращает список строки
  пример «две строки таблицы — два чтения»
    дано таблица равно "мы мы местоимение им * мн 1 * * словарь\nсемью семь числительное тв * * * * * словарь\n"
    ожидается ["мы=мы,мест,им,*,мн,1,*,", "семью=семь,числ,тв,*,*,*,*,"]
  (отфильтровать (отобразить (разделить таблица по "\n") как строка → «Строка словаря из строки таблицы»
    от строка) где строка → (длина строка) больше 0)

тотальная функция «Разборы по таблице признаков»
  принимает предложение: строка, таблица: строка, деревьев: число
  возвращает «Ответ разбора»
  «Разборы по словарю» от предложение и («Словарь из таблицы признаков» от таблица) и деревьев

тотальная функция «Разобрать по таблице признаков»
  принимает предложение: строка, таблица: строка
  возвращает строка
  «Записать ответ» от («Разборы по таблице признаков» от предложение и таблица и 4)

тотальная функция «Итог по таблице признаков»
  принимает предложение: строка, таблица: строка
  возвращает строка
  разбор («Разборы по таблице признаков» от предложение и таблица и 1)
    случай вариант «Разобрано» с разборы как разборы и всего как всего и работа как работа
      то соединить ["да", к строке всего, "", "", к строке работа] по "\t"
    случай вариант «Не разобрано» с причина как причина и слово как слово и место как место и работа как работа
      то соединить ["нет", "0", причина, слово, к строке работа] по "\t"

объект «Слово разбора»
  слово является строкой
  лемма является строкой
  часть является строкой
  тип является «Тип»

объект «Стык типов»
  откуда является числом
  гнездо является числом
  куда является числом
  паз является числом

объект «Разбор»
  слова является список «Слово разбора»
  связи является список «Связь»
  роли является список строки
  стыки является список «Стык типов»
  пометы является список строки
  приставные является список «Связь разбора»
  цена является числом

объект «Чтения предложения»
  разборы является список «Разбор»
  всего является числом
  причина является строкой
  слово является строкой
  вид является строкой

тотальная функция «Часть по лемме»
  принимает лемма: строка, часть: строка
  возвращает строка
  пример «квантор узнаётся по лемме»
    дано лемма равно "каждый"
    дано часть равно "прил"
    ожидается "квантор"
  пример «обычное слово остаётся со своей частью речи»
    дано лемма равно "система"
    дано часть равно "сущ"
    ожидается "сущ"
  (свёртка ["весь=квантор", "всякий=квантор", "каждый=квантор", "любой=квантор", "некоторый=квантор",
    "никакой=квантор", "многие=квантор", "мочь=модальное", "должен=модальное", "должный=модальное",
    "можно=модальное", "нужно=модальное", "нельзя=модальное", "возможно=модальное", "вероятно=модальное",
    "необходимо=модальное", "существовать=бытийный", "иметься=бытийный", "быть=связка", "являться=связка",
    "если=если", "неверно=неверно"] начиная с часть как итог и пара → (если пара начинается с (соединить лемма
    с "=")
    то подстрока пара с ((длина лемма) плюс 2) по (длина пара)
    иначе итог))

тотальная функция «Часть по роли»
  принимает часть: строка, роль: строка
  возвращает строка
  пример «существительное в родительном при имени»
    дано часть равно "сущ"
    дано роль равно "родительное"
    ожидается "родительный"
  пример «прилагательное в составе сказуемого»
    дано часть равно "прил"
    дано роль равно "именная часть"
    ожидается "сказ_прил"
  пусть короткая равно (свёртка ["мест=местоимение", "числ=числительное", "число=числительное", "прич=прил",
    "кр_прич=кр_прил", "слово=имя", "латиница=имя", "цитата=имя"] начиная с часть как итог
    и пара → (если пара начинается с (соединить часть с "=")
    то подстрока пара с ((длина часть) плюс 2) по (длина пара)
    иначе итог))
  если (короткая равен "сущ") и притом (роль равен "родительное")
    то "родительный"
    иначе (если (короткая равен "прил") и притом (роль равен "именная часть") то "сказ_прил" иначе короткая)

тотальная функция «Роль входящей связи»
  принимает прочтение: «Разбор предложения», место: число
  возвращает строка
  (свёртка прочтение.связи начиная с "" как роль и связь → (если связь.зависимое равен место
    то связь.роль
    иначе роль))

тотальная функция «Слово для смысла»
  принимает прочтение: «Разбор предложения», место: число
  возвращает «Слово разбора»
  «Слово для смысла с пометами» от прочтение и пустой список и место

тотальная функция «Слово для смысла с пометами»
  принимает прочтение: «Разбор предложения», пометы_слов: список строки, место: число
  возвращает «Слово разбора»
  пусть слово равно элемент место в прочтение.слова
  пусть лемма равно элемент место в прочтение.леммы
  пусть строй равно элемент место в прочтение.строй
  пусть по_роли равно «Часть по роли» от (элемент место в прочтение.части) и («Роль входящей связи» от прочтение
    и место)
  пусть приставное равно (если ["не", "то", "ни"] содержит слово то слово иначе элемент место в прочтение.части)
  пусть пометы равно (если (длина пометы_слов) не меньше место то элемент место в пометы_слов иначе "")
  пусть собственное равно (по_роли равен "сущ") и притом ((пометы содержит "имя") или (пометы содержит "заглавное"))
  пусть со_словом равно (если собственное то "имя" иначе «Часть по лемме» от лемма и по_роли)
  (запись «Слово разбора» с слово равным слово и лемма равным лемма
    и часть равным (если (длина строй) равен 0 то приставное иначе со_словом)
    и тип равным строй)

тотальная функция «Связи с типами»
  принимает прочтение: «Разбор предложения»
  возвращает список «Связь разбора»
  (отфильтровать прочтение.связи где связь → (длина (элемент (связь.зависимое) в прочтение.строй)) больше 0)

тотальная функция «Зависимых между»
  принимает связи: список «Связь разбора», главное: число, низ: число, верх: число
  возвращает число
  (длина (отфильтровать связи где связь → (связь.главное равен главное) и притом ((связь.зависимое больше низ)
    и притом (связь.зависимое меньше верх))))

тотальная функция «Стык связи»
  принимает связи: список «Связь разбора», связь: «Связь разбора», слов: число
  возвращает «Стык типов»
  пусть главное равно связь.главное
  пусть зависимое равно связь.зависимое
  пусть основа_главного равно («Зависимых между» от связи и главное и 0 и главное) плюс 1
  пусть основа_зависимого равно («Зависимых между» от связи и зависимое и 0 и зависимое) плюс 1
  если зависимое меньше главное
    то (запись «Стык типов» с откуда равным зависимое и гнездо равным основа_зависимого и куда равным главное
      и паз равным ((«Зависимых между» от связи и главное и зависимое и главное) плюс 1))
    иначе (запись «Стык типов» с откуда равным главное
      и гнездо равным ((основа_главного плюс («Зависимых между» от связи и главное и зависимое и (слов плюс 1)))
      плюс 1) и куда равным зависимое и паз равным основа_зависимого)

тотальная функция «Разбор для смысла»
  принимает прочтение: «Разбор предложения», пометы_слов: список строки, цена: число
  возвращает «Разбор»
  пусть слов равно длина прочтение.слова
  пусть связи равно «Связи с типами» от прочтение
  (запись «Разбор» с слова равным (отобразить («Числа от до» от 1 и слов) как место → «Слово для смысла с пометами»
    от прочтение и пометы_слов и место)
    и связи равным (отобразить связи как связь → (запись «Связь»
    с левое равным (если связь.главное меньше связь.зависимое то связь.главное иначе связь.зависимое)
    и правое равным (если связь.главное меньше связь.зависимое то связь.зависимое иначе связь.главное)))
    и роли равным (отобразить связи как связь → связь.роль)
    и стыки равным (отобразить связи как связь → «Стык связи» от связи и связь и слов)
    и пометы равным пометы_слов
    и приставные равным (отфильтровать прочтение.связи где связь → (длина (элемент (связь.зависимое)
    в прочтение.строй)) равен 0)
    и цена равным цена)

тотальная функция «Чтения из ответа»
  принимает ответ: «Ответ разбора»
  возвращает «Чтения предложения»
  разбор ответ
    случай вариант «Разобрано» с разборы как разборы и всего как всего и сверх как сверх
      то (запись «Чтения предложения» с разборы равным (отобразить («Числа от до» от 1 и (длина разборы))
        как номер → «Разбор для смысла» от (элемент номер в разборы) и (элемент номер в сверх.пометы)
        и (элемент номер в сверх.цены)) и всего равным всего и причина равным "" и слово равным ""
        и вид равным сверх.вид)
    случай вариант «Не разобрано» с причина как причина и слово как слово и место как место и работа как работа
      то (запись «Чтения предложения» с разборы равным пустой список и всего равным 0 и причина равным причина
        и слово равным слово и вид равным "")

тотальная функция «Разборы для смысла»
  принимает предложение: строка, словарь: список строки, деревьев: число
  возвращает «Чтения предложения»
  «Чтения из ответа» от («Разборы по словарю» от предложение и словарь и деревьев)

тотальная функция «Разборы для смысла по пробному словарю»
  принимает предложение: строка
  возвращает «Чтения предложения»
  «Чтения из ответа» от («Разборы» от предложение)
