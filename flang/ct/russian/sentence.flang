модуль «Russian sentence»
  использует «Russian chart» из "chart.flang"
  использует «Russian sample dictionary» из "sample-dictionary.flang"

объект «Разбор предложения»
  слова является список строки
  типы является список строки
  связи является список «Связь разбора»

тип «Ответ разбора»
  вариант «Разобрано» содержит разборы: список «Разбор предложения», всего: число, работа: число
  вариант «Не разобрано» содержит причина: строка, слово: строка, место: число, работа: число

тотальная функция «Запись основы»
  принимает кат: строка, признаки: список строки
  возвращает строка
  пример «именная группа с признаками»
    дано кат равно "n"
    дано признаки равно ["вин", "ж", "ед", "3"]
    ожидается "n[вин ж ед 3]"
  пример «сказуемое пишется буквой s, звёздочки опускаются»
    дано кат равно "v"
    дано признаки равно ["*", "*", "ед", "3"]
    ожидается "s[ед 3]"
  пример «без признаков скобок нет»
    дано кат равно "d"
    дано признаки равно ["*", "*", "*", "*"]
    ожидается "d"
  пусть важные равно отфильтровать признаки где признак → признак не равен "*"
  пусть буква равно (если кат равен "v" то "s" иначе кат)
  если (длина важные) равен 0
    то буква
    иначе соединить [буква, "[", соединить важные по " ", "]"] по ""

тотальная функция «Лексический узел»
  принимает слово: «Слово предложения», кат: строка, признаки: список строки, свойства: строка, отн: строка
  возвращает «Узел карты»
  («Собрать узел» от кат и [элемент 1 в признаки, элемент 2 в признаки, элемент 3 в признаки,
    элемент 4 в признаки, свойства, "", отн] и нет и нет и 1 и [(запись «Дерево» с вершина равным слово.место
    и связи равным [(запись «Связь разбора» с главное равным 0 и зависимое равным слово.место
    и роль равным («Запись основы» от кат и признаки))])])

тотальная функция «Помета свойства»
  принимает есть: признак, текст: строка
  возвращает строка
  если есть то соединить текст с " " иначе ""

тотальная функция «Свойства глагола»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает строка
  (соединить [" ", «Помета свойства» от (чтение.прочее содержит "перех") и "перех",
    «Помета свойства» от ((«Связочные глаголы») содержит чтение.лемма) и "связка",
    «Помета свойства» от ((«Глаголы с родительным») содержит чтение.лемма) и "род+",
    «Помета свойства» от ((«Слова с дательным») содержит чтение.лемма) и "дат+",
    «Помета свойства» от слово.отрицание и "отр"] по "")

тотальная функция «Узлы определения»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть неизменяемое равно чтение.прочее содержит "неизм"
  пусть признаки равно (если неизменяемое то ["*", "*", "*", "*"] иначе [чтение.падеж, чтение.род, чтение.число,
    "*"])
  пусть переходное равно (чтение.прочее содержит "перех") и притом (не (чтение.прочее содержит "страд"))
  пусть свойства равно (соединить [" ", «Помета свойства» от (чтение.часть равен "прич") и "прич",
    «Помета свойства» от переходное и "перех",
    «Помета свойства» от ((«Слова с дательным») содержит чтение.лемма) и "дат+",
    «Помета свойства» от ((«Глаголы с родительным») содержит чтение.лемма) и "род+",
    «Помета свойства» от (чтение.прочее содержит "местоим") и "опр",
    «Помета свойства» от слово.отрицание и "отр"] по "")
  пусть определение равно «Лексический узел» от слово и "a" и признаки и свойства и ""
  пусть имя равно («Лексический узел» от слово и "n" и [чтение.падеж, чтение.род, чтение.число, "3"] и " " и "")
  если чтение.лемма равен "который"
    то [(«Лексический узел» от слово и "n" и [чтение.падеж, чтение.род, чтение.число, "3"] и " мест "
      и (соединить [чтение.род, " ", чтение.число] по ""))]
    иначе (если («Определители без существительного») содержит чтение.лемма
      то [определение, имя]
      иначе [определение])

тотальная функция «Узлы имени»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть ярлык равно (чтение.прочее содержит "ярлык") или (чтение.прочее содержит "сокр")
  пусть лицо равно (если чтение.лицо равен "*" то "3" иначе чтение.лицо)
  если чтение.часть равен "сущ"
    то [(«Лексический узел» от слово и "n" и [чтение.падеж, чтение.род, чтение.число, "3"] и (соединить [" ",
      «Помета свойства» от ярлык и "ярлык"] по "") и "")]
    иначе [(«Лексический узел» от слово и "n" и [чтение.падеж, чтение.род, чтение.число, лицо] и (соединить [
      " мест ", «Помета свойства» от (чтение.прочее содержит "это") и "это"] по "") и "")]

тотальная функция «Узлы сказуемого»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  пусть отрицание равно «Помета свойства» от слово.отрицание и "отр"
  если часть равен "глагол"
    то [(«Лексический узел» от слово и "v" и ["*", чтение.род, чтение.число, чтение.лицо] и («Свойства глагола»
      от слово и чтение) и "")]
    иначе (если часть равен "предик"
      то [(«Лексический узел» от слово и "v" и ["*", "*", "*", "*"] и (соединить («Свойства глагола» от слово
        и чтение) с "безл ") и "")]
      иначе [(«Лексический узел» от слово и "v" и ["*", чтение.род, чтение.число, "*"] и (соединить [
        «Свойства глагола» от слово и чтение, "крат "] по "") и "")])

тотальная функция «Узлы неличной формы»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть кат равно (если чтение.часть равен "инф" то "i" иначе "g")
  [(«Лексический узел» от слово и кат и ["*", "*", "*", "*"] и («Свойства глагола» от слово и чтение) и "")]

тотальная функция «Узлы служебного»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  пусть без_признаков равно ["*", "*", "*", "*"]
  пусть с_пробелами равно соединить [" ", чтение.прочее, " "] по ""
  пусть союз равно (если чтение.прочее равен "соч" то "&" иначе "c")
  если часть равен "предлог"
    то [(«Лексический узел» от слово и "r" и без_признаков и с_пробелами и "")]
    иначе (если часть равен "союз"
      то [(«Лексический узел» от слово и союз и без_признаков и с_пробелами и "")]
      иначе «Узлы наречия» от слово и чтение)

тотальная функция «Узлы наречия»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  пусть без_признаков равно ["*", "*", "*", "*"]
  если (часть равен "нареч") или (часть равен "комп")
    то [(«Лексический узел» от слово и "d" и без_признаков и " " и "")]
    иначе (если (часть равен "вводное") или (часть равен "вывод")
      то [(«Лексический узел» от слово и "d" и без_признаков и (соединить [" ", часть, " вв "] по "") и "")]
      иначе «Узлы числительного» от слово и чтение)

тотальная функция «Узлы числительного»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  если чтение.часть равен "числ"
    то [(«Лексический узел» от слово и "q" и [чтение.падеж, "*", "*", "*"] и " " и "")]
    иначе пустой список

тотальная функция «Узлы чтения»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  если (часть равен "сущ") или (часть равен "мест")
    то «Узлы имени» от слово и чтение
    иначе (если (часть равен "прил") или (часть равен "прич")
      то «Узлы определения» от слово и чтение
      иначе «Узлы глагольного чтения» от слово и чтение)

тотальная функция «Узлы глагольного чтения»
  принимает слово: «Слово предложения», чтение: «Чтение»
  возвращает список «Узел карты»
  пусть часть равно чтение.часть
  пусть сказуемое равно (часть равен "глагол") или ((часть равен "предик") или ((часть равен "кр_прил")
    или (часть равен "кр_прич")))
  если сказуемое
    то «Узлы сказуемого» от слово и чтение
    иначе (если (часть равен "инф") или (часть равен "деепр")
      то «Узлы неличной формы» от слово и чтение
      иначе «Узлы служебного» от слово и чтение)

тотальная функция «Есть ключ»
  принимает узлы: список «Узел карты», ключ: строка
  возвращает признак
  свёртка узлы начиная с нет как есть и узел → есть или (узел.ключ равен ключ)

тотальная функция «Без повторов»
  принимает узлы: список «Узел карты»
  возвращает список «Узел карты»
  (свёртка узлы начиная с пустой список как итог и узел → (если «Есть ключ» от итог и узел.ключ
    то итог
    иначе добавить узел к итог))

тотальная функция «Причастие заслоняет»
  принимает узлы: список «Узел карты», узел: «Узел карты»
  возвращает признак
  пусть простое равно (узел.кат равен "a") и притом (не (узел.свойства содержит " прич "))
  (простое и притом (свёртка узлы начиная с нет как есть и другой → есть или ((другой.кат равен "a")
    и притом ((другой.свойства содержит " прич ") и притом ((другой.падеж равен узел.падеж)
    и притом ((другой.род равен узел.род) и притом (другой.число равен узел.число)))))))

тотальная функция «Узлы по виду»
  принимает слово: «Слово предложения»
  возвращает список «Узел карты»
  пусть без_признаков равно ["*", "*", "*", "3"]
  пусть имя_посреди равно (слово.вид равен "слово") и притом (слово.заглавное и притом (слово.место больше 1))
  если слово.вид равен "число"
    то [(«Лексический узел» от слово и "q" и ["*", "*", "*", "*"] и " цифра " и ""),
      («Лексический узел» от слово и "n" и без_признаков и " ярлык " и "")]
    иначе (если ((слово.вид равен "латиница") или (слово.вид равен "цитата")) или имя_посреди
      то [(«Лексический узел» от слово и "n" и без_признаков и " ярлык " и "")]
      иначе пустой список)

тотальная функция «Чтения слова»
  принимает слово: «Слово предложения», словарь: список строки
  возвращает список «Чтение»
  пусть закрытые равно «Закрытые чтения» от слово.слово
  если (длина закрытые) больше 0
    то закрытые
    иначе (отфильтровать («Чтения по таблице» от словарь и слово.слово) где чтение → не (["союз", "предлог",
      "частица", "межд", "вводное", "вывод"] содержит чтение.часть))

тотальная функция «Узлы слова»
  принимает слово: «Слово предложения», словарь: список строки
  возвращает список «Узел карты»
  пример «неизвестное слово — пустой список»
    дано слово равно (запись «Слово предложения» с место равным 1 и слово равным "шьет" и вид равным "слово"
      и заглавное равным нет и запятая равным нет и тире равным нет и отрицание равным нет
      и привязки равным пустой список)
    дано словарь равно пустой список
    ожидается пустой список
  пусть чтения равно «Чтения слова» от слово и словарь
  пусть все равно («Без повторов» от (свёртка чтения начиная с пустой список как итог и чтение → «Вместе» от итог
    и («Узлы чтения» от слово и чтение)))
  пусть узлы равно отфильтровать все где узел → не («Причастие заслоняет» от все и узел)
  если ((длина узлы) равен 0) и притом ((длина чтения) равен 0)
    то «Узлы по виду» от слово
    иначе узлы

тотальная функция «Условия разбора»
  принимает согласование: признак, падежи: признак, деревьев: число
  возвращает «Условия»
  (запись «Условия» с согласование равным согласование и падежи равным падежи и деревьев равным деревьев
    и работы равным («Предел работы»))

тотальная функция «Предел работы»
  возвращает число
  40000

тотальная функция «Предел слов»
  возвращает число
  60

тотальная функция «Предел слов для подсказки»
  возвращает число
  12

тотальная функция «Предложения клетки»
  принимает узлы: список «Узел карты»
  возвращает список «Узел карты»
  отфильтровать узлы где узел → (узел.кат равен "v") и притом (узел.отн равен "")

тотальная функция «Целая клетка»
  принимает карта: «Карта», слов: число
  возвращает список «Узел карты»
  «Предложения клетки» от («Клетка карты» от карта.ряды и 0 и слов)

тотальная функция «Основа в связях»
  принимает связи: список «Связь разбора», место: число
  возвращает строка
  (свёртка связи начиная с "" как основа и связь → (если (связь.зависимое равен место) и притом (связь.главное равен 0)
    то связь.роль
    иначе (если (связь.главное равен место) и притом (связь.роль равен "подлежащее при связке")
      то "s"
      иначе основа)))

тотальная функция «Основа слова»
  принимает связи: список «Связь разбора», место: число
  возвращает строка
  пусть связка равно (свёртка связи начиная с нет как есть и связь → есть или ((связь.главное равен место)
    и притом (связь.роль равен "подлежащее при связке")))
  если связка то "s" иначе «Основа в связях» от связи и место

тотальная функция «Сопряжённые с края»
  принимает связи: список «Связь разбора», зависимые: список «Связь разбора», места: список числа, знак: строка
  возвращает список строки
  (свёртка места начиная с пустой список как итог и место → (свёртка зависимые начиная с итог как сбор
    и связь → (если связь.зависимое равен место
    то добавить (соединить («Основа слова» от связи и место) с знак) к сбор
    иначе сбор)))

тотальная функция «Числа вниз»
  принимает от_числа: число, до_числа: число
  возвращает список числа
  пример «три числа вниз»
    дано от_числа равно 4
    дано до_числа равно 2
    ожидается [4, 3, 2]
  «Перевернуть» от («Числа от до» от до_числа и от_числа)

тотальная функция «Тип слова в разборе»
  принимает связи: список «Связь разбора», приставные: список «Связь разбора», место: число, слов: число
  возвращает строка
  пусть основа равно «Основа слова» от связи и место
  пусть зависимые равно отфильтровать связи где связь → связь.главное равен место
  пусть левые равно «Сопряжённые с края» от связи и зависимые и («Числа вниз» от (место минус 1) и 1) и "ʳ"
  пусть правые равно «Сопряжённые с края» от связи и зависимые и («Числа вниз» от слов и (место плюс 1)) и "ˡ"
  если основа равен ""
    то (свёртка приставные начиная с "" как роль и связь → (если связь.зависимое равен место
      то связь.роль
      иначе роль))
    иначе соединить («Склеить списки» от («Склеить списки» от левые и [основа]) и правые) по " · "

тотальная функция «Приставные связи»
  принимает слова: список «Слово предложения»
  возвращает список «Связь разбора»
  (свёртка слова начиная с пустой список как итог и слово → (свёртка слово.привязки начиная с итог как сбор
    и привязка → добавить (запись «Связь разбора» с главное равным слово.место и зависимое равным привязка.место
    и роль равным привязка.роль) к сбор))

тотальная функция «Разбор из дерева»
  принимает разметка: «Разметка», дерево: «Дерево»
  возвращает «Разбор предложения»
  пусть приставные равно «Приставные связи» от разметка.слова
  пусть слов равно длина разметка.видимые
  (запись «Разбор предложения» с слова равным разметка.видимые
    и типы равным (отобразить («Числа от до» от 1 и слов) как место → «Тип слова в разборе» от дерево.связи
    и приставные и место и слов)
    и связи равным («Склеить списки» от (отфильтровать дерево.связи где связь → связь.главное больше 0)
    и приставные))

тотальная функция «Первое неизвестное слово»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты»
  возвращает «Слово предложения»
  (свёртка слова начиная с (запись «Слово предложения» с место равным 0 и слово равным "" и вид равным ""
    и заглавное равным нет и запятая равным нет и тире равным нет и отрицание равным нет
    и привязки равным пустой список) как найдено и слово → (если (найдено.место равен 0)
    и притом ((длина (элемент ((длина («Слова до» от слова и слово.место)) плюс 1) в ряд)) равен 0)
    то слово
    иначе найдено))

тотальная функция «Слова до»
  принимает слова: список «Слово предложения», место: число
  возвращает список «Слово предложения»
  отфильтровать слова где слово → слово.место меньше место

тотальная функция «Место остановки»
  принимает карта: «Карта», слов: число
  возвращает число
  (свёртка («Числа от до» от 1 и слов) начиная с 0 как дальше и длина_куска → (если (длина («Клетка карты»
    от карта.ряды и 0 и длина_куска)) больше 0
    то длина_куска
    иначе дальше))

тотальная функция «Есть сказуемое в ряду»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты»
  возвращает признак
  пусть глагол равно (свёртка ряд начиная с нет как есть и узлы → есть или ((длина (отфильтровать узлы
    где узел → узел.кат равен "v")) больше 0))
  пусть тире равно свёртка слова начиная с нет как есть и слово → есть или слово.тире
  пусть указатель равно (свёртка ряд начиная с нет как есть и узлы → есть или ((длина (отфильтровать узлы
    где узел → узел.свойства содержит " это ")) больше 0))
  глагол или (тире или указатель)

тотальная функция «Разбирается при условиях»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты», усл: «Условия»
  возвращает признак
  (длина («Целая клетка» от («Построить карту» от слова и ряд и усл) и (длина слова))) больше 0

тотальная функция «Подсказка»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты»
  возвращает строка
  если «Разбирается при условиях» от слова и ряд и («Условия разбора» от нет и да и 1)
    то "нет согласования по роду, числу или лицу"
    иначе (если «Разбирается при условиях» от слова и ряд и («Условия разбора» от да и нет и 1)
      то "неверный падеж"
      иначе «Подсказка при двух ослаблениях» от слова и ряд)

тотальная функция «Подсказка при двух ослаблениях»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты»
  возвращает строка
  если «Разбирается при условиях» от слова и ряд и («Условия разбора» от нет и нет и 1)
    то "неверный падеж и нет согласования"
    иначе "слова не связываются в предложение"

тотальная функция «Слово по счёту»
  принимает слова: список «Слово предложения», номер: число
  возвращает «Слово предложения»
  элемент (если номер больше (длина слова) то длина слова иначе (если номер меньше 1 то 1 иначе номер)) в слова

тотальная функция «Диагноз»
  принимает слова: список «Слово предложения», ряд: список список «Узел карты», карта: «Карта»
  возвращает «Ответ разбора»
  пусть стоп равно «Слово по счёту» от слова и ((«Место остановки» от карта и (длина слова)) плюс 1)
  если не («Есть сказуемое в ряду» от слова и ряд)
    то (вариант «Не разобрано» с причина равным "нет сказуемого" и слово равным "" и место равным 0
      и работа равным карта.работа)
    иначе (вариант «Не разобрано» с причина равным (если (длина слова) не больше («Предел слов для подсказки»)
      то «Подсказка» от слова и ряд
      иначе "слова не связываются в предложение") и слово равным стоп.слово и место равным стоп.место
      и работа равным карта.работа)

тотальная функция «Ответ по карте»
  принимает разметка: «Разметка», ряд: список список «Узел карты», карта: «Карта»
  возвращает «Ответ разбора»
  пусть слова равно разметка.слова
  пусть предложения равно «Целая клетка» от карта и (длина слова)
  если карта.работа больше («Предел работы»)
    то (вариант «Не разобрано» с причина равным "превышен предел работы" и слово равным "" и место равным 0
      и работа равным карта.работа)
    иначе (если (длина предложения) равен 0
      то «Диагноз» от слова и ряд и карта
      иначе (вариант «Разобрано» с разборы равным (свёртка предложения начиная с пустой список как итог
        и узел → «Склеить списки» от итог и (отобразить узел.деревья как дерево → «Разбор из дерева» от разметка
        и дерево)) и всего равным (свёртка предложения начиная с 0 как всего и узел → всего плюс узел.счёт)
        и работа равным карта.работа))

тотальная функция «Ответ по словам»
  принимает разметка: «Разметка», словарь: список строки, деревьев: число
  возвращает «Ответ разбора»
  пусть слова равно разметка.слова
  пусть ряд равно отобразить слова как слово → «Узлы слова» от слово и словарь
  пусть неизвестное равно «Первое неизвестное слово» от слова и ряд
  если неизвестное.место больше 0
    то (вариант «Не разобрано» с причина равным "неизвестное слово" и слово равным неизвестное.слово
      и место равным неизвестное.место и работа равным 0)
    иначе («Ответ по карте» от разметка и ряд и («Построить карту» от слова и ряд и («Условия разбора» от да и да
      и деревьев)))

тотальная функция «Разборы по словарю»
  принимает предложение: строка, словарь: список строки, деревьев: число
  возвращает «Ответ разбора»
  пусть разметка равно «Разметить» от предложение
  пусть слов равно длина разметка.слова
  если слов равен 0
    то (вариант «Не разобрано» с причина равным "в предложении нет слов" и слово равным "" и место равным 0
      и работа равным 0)
    иначе (если слов больше («Предел слов»)
      то (вариант «Не разобрано» с причина равным "предложение длиннее предела" и слово равным ""
        и место равным 0 и работа равным 0)
      иначе «Ответ по словам» от разметка и словарь и деревьев)

тотальная функция «Разборы»
  принимает предложение: строка
  возвращает «Ответ разбора»
  «Разборы по словарю» от предложение и («Пробный словарь») и 8

тотальная функция «Записать связь разбора»
  принимает слова: список строки, связь: «Связь разбора»
  возвращает строка
  соединить [элемент (связь.главное) в слова, "→", элемент (связь.зависимое) в слова, " ", связь.роль] по ""

тотальная функция «Записать разбор»
  принимает прочтение: «Разбор предложения»
  возвращает строка
  пусть типы равно (свёртка прочтение.типы начиная с пустой список как строки и т → добавить (соединить [
    элемент ((длина строки) плюс 1) в прочтение.слова, ": ", т] по "") к строки)
  (соединить [соединить типы по "; ", "; связи: ", (соединить (отобразить прочтение.связи
    как связь → «Записать связь разбора» от прочтение.слова и связь) по ", ")] по "")

тотальная функция «Записать ответ»
  принимает ответ: «Ответ разбора»
  возвращает строка
  разбор ответ
    случай вариант «Разобрано» с разборы как разборы и всего как всего и работа как работа
      то (соединить [соединить ["разборов ", к строке всего] по "", (соединить (отобразить разборы
        как прочтение → «Записать разбор» от прочтение) по " || ")] по ": ")
    случай вариант «Не разобрано» с причина как причина и слово как слово и место как место и работа как работа
      то (если слово равен ""
        то соединить "не разобрано: " с причина
        иначе соединить ["не разобрано: ", причина, ", слово «", слово, "»"] по "")

тотальная функция «Разобрать подробно»
  принимает предложение: строка
  возвращает строка
  «Записать ответ» от («Разборы» от предложение)

тотальная функция «Разобрать со словарём»
  принимает предложение: строка, словарь: строка
  возвращает строка
  «Записать ответ» от («Разборы по словарю» от предложение и (разделить словарь по "|") и 4)

тотальная функция «Итог со словарём»
  принимает предложение: строка, словарь: строка
  возвращает строка
  разбор («Разборы по словарю» от предложение и (разделить словарь по "|") и 1)
    случай вариант «Разобрано» с разборы как разборы и всего как всего и работа как работа
      то соединить ["да", к строке всего, "", "", к строке работа] по "\t"
    случай вариант «Не разобрано» с причина как причина и слово как слово и место как место и работа как работа
      то соединить ["нет", "0", причина, слово, к строке работа] по "\t"

тотальная функция «Самый длинный кусок»
  принимает карта: «Карта», начало: число, слов: число
  возвращает число
  (свёртка («Числа от до» от 1 и (слов минус начало)) начиная с 1 как дальше и длина_куска → (если (длина
    («Клетка карты» от карта.ряды и начало и длина_куска)) больше 0
    то длина_куска
    иначе дальше))

тотальная функция «Виды клетки»
  принимает узлы: список «Узел карты»
  возвращает строка
  (соединить (свёртка узлы начиная с пустой список как виды и узел → (если виды содержит узел.кат
    то виды
    иначе добавить узел.кат к виды)) по "")

тотальная функция «Слова куска»
  принимает слова: список «Слово предложения», начало: число, длина_куска: число
  возвращает строка
  (соединить (отобразить («Числа от до» от (начало плюс 1) и (начало плюс длина_куска))
    как номер → (элемент номер в слова).слово) по " ")

тотальная функция «Собрать куски»
  принимает карта: «Карта», слова: список «Слово предложения», начало: число
  возвращает список строки
  убывает (длина слова) минус начало
  пусть длина_куска равно «Самый длинный кусок» от карта и начало и (длина слова)
  если начало не меньше (длина слова)
    то пустой список
    иначе (приписать (соединить ["[", «Слова куска» от слова и начало и длина_куска, "]",
      «Виды клетки» от («Клетка карты» от карта.ряды и начало и длина_куска)] по "") к («Собрать куски» от карта
      и слова и (начало плюс длина_куска)))

тотальная функция «Куски со словарём»
  принимает предложение: строка, словарь: строка
  возвращает строка
  пусть слова равно («Разметить» от предложение).слова
  пусть таблица равно разделить словарь по "|"
  пусть ряд равно отобразить слова как слово → «Узлы слова» от слово и таблица
  пусть неизвестное равно «Первое неизвестное слово» от слова и ряд
  если ((длина слова) равен 0) или ((неизвестное.место больше 0) или ((длина слова) больше («Предел слов»)))
    то соединить "нет карты: " с неизвестное.слово
    иначе (соединить («Собрать куски» от («Построить карту» от слова и ряд и («Условия разбора» от да и да
      и 1)) и слова и 0) по " ")
