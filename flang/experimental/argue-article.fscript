тотальная функция «Kernel script»
  возвращает строка
  """
  d=$(mktemp -d -p "${FLANG_TMP:-${TMPDIR:-/tmp}}" argue.XXXXXX)
  bin="${FLANG_BIN:-$0/bootstrap/flang}"
  limit="${FLANG_ARGUE_KERNEL_SECONDS:-600}"
  i=0
  for program in "$@"; do
    i=$((i + 1))
    mkdir "$d/$i"
    printf '%s' "$program" > "$d/$i/step.flang"
    (
      if command -v timeout > /dev/null 2>&1; then
        timeout "$limit" "$bin" check "$d/$i/step.flang" --proof --strict > "$d/$i/out" 2>&1
      else
        "$bin" check "$d/$i/step.flang" --proof --strict > "$d/$i/out" 2>&1
      fi
      echo $? > "$d/$i/code"
    ) &
  done
  wait
  j=0
  while [ "$j" -lt "$i" ]; do
    j=$((j + 1))
    printf '%s\\t%s\\n' "$(cat "$d/$j/code")" "$(tr '\\n' ' ' < "$d/$j/out")"
  done
  rm -rf "$d"
  """

тотальная функция «Lines after»
  принимает jobs: список строки, count: число
