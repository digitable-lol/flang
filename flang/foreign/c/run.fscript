  «Batch of» от names и (отобразить files как file → «Write order» от answers и file)

тотальная функция «File of»
  принимает name: строка, pieces: список строки, lines: список строки
  возвращает «File»
  пример «A file record»
    дано name равно "w"
    дано pieces равно ["a"]
    дано lines равно ["b"]
    ожидается запись «File» с «name» равным "w" и «pieces» равным ["a"] и «lines» равным ["b"]
  запись «File» с «name» равным name и «pieces» равным pieces и «lines» равным lines

тотальная функция «Function files»
  принимает one: «Prepared»
  возвращает список «File»
  пример «A function without inputs still gets its six files»
    дано one равно запись «Prepared» с «file» равным "s" и «claims» равным [
      ] и «translated» равным (запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      ] и «flow» равным (запись «Flow» с «lines» равным ["  0"] и «duties» равным [] и «refusals» равным [
      ] и «helpers» равным [] и «leaves» равным []) и «literals» равным [] и «refusals» равным [
      ] и «defined» равным да и «support» равным [] и «calls» равным [] и «types» равным [
        ]) и «probe» равным (запись «Probe» с «name» равным "f" и «parameters» равным [
      ] и «inputs» равным [] и «shapes» равным [] и «checked» равным [])
    ожидается [запись «File» с «name» равным "write T f" и «pieces» равным ["T-", "f", ".flang"] и «lines» равным [
      "модуль «Перевод f»", "", "тотальная функция «f»", "  принимает ", "  возвращает число", "  0"],
      запись «File» с «name» равным "write D f" и «pieces» равным ["D-", "f", ".flang"] и «lines» равным [
      "модуль «Выведено f»", "", "тотальная функция «f»", "  принимает ", "  возвращает число",
      "  обеспечивает «выведено 1» результат не меньше 0", "  0"],
      запись «File» с «name» равным "write input f" и «pieces» равным ["input-", "f", ".txt"] и «lines» равным [""],
      запись «File» с «name» равным "write requests f" и «pieces» равным ["requests-", "f", ".jsonl"] и «lines» равным [
      ""], запись «File» с «name» равным "write values f" и «pieces» равным ["values-", "f",
      ".jsonl"] и «lines» равным [""],
      запись «File» с «name» равным "write C f" и «pieces» равным ["C-", "f", ".flang"] и «lines» равным [
      "модуль «Перевод f»", "", "тотальная функция «f»", "  принимает ", "  возвращает число", "  0"]]
  пусть name равно («Name of» от one)
  пусть probe равно (one.«probe»)
  пусть translated равно (one.«translated»)
  пусть translation равно («Translation text» от translated и (one.«claims»))
  пусть derived равно («Derived text» от translated и (one.«claims») и («Candidates» от translated))
  пусть input равно [(«Without last line end» от («Harness input» от probe))]
  пусть requests равно [(«Without last line end» от («Requests» от probe и («Called names» от probe)))]
  пусть values равно [(«Without last line end» от («Requests» от probe и [name]))]
  пусть t равно («File of» от (соединить ["write T ", name] по "") и ["T-", name, ".flang"] и translation)
  пусть d равно («File of» от (соединить ["write D ", name] по "") и ["D-", name, ".flang"] и derived)
  пусть i равно («File of» от (соединить ["write input ", name] по "") и ["input-", name, ".txt"] и input)
  пусть r равно («File of» от (соединить ["write requests ", name] по "") и ["requests-", name, ".jsonl"] и requests)
  пусть v равно («File of» от (соединить ["write values ", name] по "") и ["values-", name, ".jsonl"] и values)
  пусть confirmation равно («Confirmation text» от translated и (one.«claims»))
  пусть c равно («File of» от (соединить ["write C ", name] по "") и ["C-", name, ".flang"] и confirmation)
  [t, d, i, r, v, c]

тотальная функция «Without last line end»
  принимает text: строка
  возвращает строка
  пример «The text without its last line end»
    дано text равно "a\nb\n"
    ожидается "a\nb"
  если («Ends with» от text и "\n") то (подстрока text с 1 по ((длина text) минус 1)) иначе text

функция «File files»
  принимает source: «Source», prepared: список «Prepared»
  возвращает список «File»
  пример «An empty file still gets its probe, harness and forgeries»
    дано source равно запись «Source» с «file» равным "s" и «nodes» равным [] и «functions» равным []
    дано prepared равно []
    ожидается [запись «File» с «name» равным "write probe s" и «pieces» равным ["probe-", "s",
      ".flang"] и «lines» равным ["модуль «Проба s»"],
      запись «File» с «name» равным "write harness s" и «pieces» равным ["harness-", "s", ".c"] и «lines» равным [
      "#define _POSIX_C_SOURCE 200809L", "#include <stdio.h>", "#include <string.h>", "#include <unistd.h>",
      "#include <sys/wait.h>", "#include \"s.c\"", "static int call(const char *f, const long *a) {", "  return 0;",
      "}", "int main(void) {", "  char f[256];", "  long a[8];",
      "  while (scanf(\"%255s %ld %ld %ld %ld %ld %ld %ld %ld\", f, &a[0], &a[1], &a[2], &a[3],",
      "      &a[4], &a[5], &a[6], &a[7]) == 9) {", "    fflush(stdout);",
      "    pid_t p = fork();", "    if (p == 0) { printf(\"ok %d\\n\", call(f, a)); fflush(stdout); _exit(0); }",
      "    int s = 0;", "    waitpid(p, &s, 0);", "    if (!(WIFEXITED(s) && WEXITSTATUS(s) == 0)) printf(\"ub\\n\");",
      "    fflush(stdout);", "  }", "  return 0;", "}"],
      запись «File» с «name» равным "write forged drop-branch s" и «pieces» равным ["forged-", "drop-branch", "-", "s",
      ".flang"] и «lines» равным ["модуль «Подделка s»"],
      запись «File» с «name» равным "write forged shift-constant s" и «pieces» равным ["forged-", "shift-constant", "-",
      "s", ".flang"] и «lines» равным ["модуль «Подделка s»"],
      запись «File» с «name» равным "write forged swap-operands s" и «pieces» равным ["forged-", "swap-operands", "-",
      "s", ".flang"] и «lines» равным ["модуль «Подделка s»"]]
  пусть file равно (source.«file»)
  пусть mine равно (отфильтровать prepared где one → (one.«file») равен file)
  пусть parts равно (отобразить mine как one → «Probe of» от one)
  пусть probe равно («Module text» от (соединить ["Проба ", file] по "") и («Joined blocks» от parts))
  пусть harness равно («Harness text» от (соединить [file, ".c"] по "") и (отобразить mine как one → one.«probe»))
  пусть p равно («File of» от (соединить ["write probe ", file] по "") и ["probe-", file, ".flang"] и probe)
  пусть h равно («File of» от (соединить ["write harness ", file] по "") и ["harness-", file, ".c"] и harness)
  пусть forged равно (отобразить («Modes») как mode → «Forged file» от source и mode)
  «Соединить списки» от [p, h] и forged

тотальная функция «Probe of»
  принимает one: «Prepared»
