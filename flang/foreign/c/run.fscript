тотальная функция «Refusal kind»
  принимает reason: строка
  возвращает строка
  пример «A loop»
    дано reason равно "строка 4: оператор «WhileStmt» вне подмножества"
    ожидается "оператор «WhileStmt»"
  пример «A signature»
    дано reason равно "строка 1: функция «f»: сигнатура «void (int *)» вне подмножества"
    ожидается "сигнатура не int f(int, …)"
  пусть marked равно (соединить ["«", («Between» от "«" и "»" и reason), "»"] по "")
  пусть rules равно [(«When» от (reason содержит ": сигнатура «") и "сигнатура не int f(int, …)"),
    («When» от (reason содержит ": оператор «") и (соединить ["оператор ", marked] по "")),
    («When» от (reason содержит ": выражение «") и (соединить ["выражение ", marked] по "")),
    («When» от (reason содержит ": операция «") и (соединить ["операция ", marked] по "")),
    («When» от (reason содержит "приведение") и "неявное приведение типа"),
    («When» от (reason содержит ": литерал") и "литерал не int"),
    («When» от (reason содержит "не типа int") и "имя не типа int"),
    («When» от (reason содержит "цикл без выводимой меры") и "цикл без выводимой меры"),
    («When» от (reason содержит "return внутри цикла") и "return внутри цикла"),
    («When» от (reason содержит "рекурсия") и "рекурсия"),
    («When» от (reason содержит "не переведена выше") и "вызов функции, не переведённой выше"),
    («When» от (reason содержит "читается до присваивания") и "чтение до присваивания"),
    («When» от (reason содержит ": присваивание «") и "присваивание не локальной int"),
    («When» от (reason содержит "поле ") и "поле не записи-параметра"),
    («When» от (reason содержит ": имя «") и "имя не параметр и не локальная"),
    («When» от (reason содержит "без начального значения") и "переменная без начального значения")]
  «Chosen» от rules и "прочее"

