    дано rows равно []
    ожидается запись «Prepared» с «file» равным "s" и «claims» равным [
      ] и «translated» равным (запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      ] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «helpers» равным [] и «leaves» равным []) и «literals» равным [] и «refusals» равным [
      ] и «defined» равным да и «support» равным [] и «calls» равным [] и «types» равным [
        ]) и «probe» равным (запись «Probe» с «name» равным "f" и «parameters» равным [
      ] и «inputs» равным [[]] и «shapes» равным [] и «checked» равным [
