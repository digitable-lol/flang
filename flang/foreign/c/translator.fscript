    дано made равно []
    дано said равно запись «Claim» с «role» равным "" и «words» равным ["a", "да", "человек"]
    ожидается [
      запись «Numbered» с «at» равным 1 и «it» равным (запись «Claim» с «role» равным "" и «words» равным ["a",
        "да", "человек"])]
  добавить (запись «Numbered» с «at» равным ((длина made) плюс 1) и «it» равным said) к made

тотальная функция «Bound»
  принимает kind: строка, name: строка, body: строка, pure: строка
  возвращает «Binding»
  пример «A local bound to its flang name and to its value over the parameters»
    дано kind равно "int"
    дано name равно "full"
    дано body равно "«full»"
    дано pure равно "p"
    ожидается запись «Binding» с «kind» равным "int" и «name» равным "full" и «body» равным "«full»" и «pure» равным "p"
  запись «Binding» с «kind» равным kind и «name» равным name и «body» равным body и «pure» равным pure

тотальная функция «Variable kind»
  принимает kind: строка
  возвращает признак
  пример «An int is a variable»
    дано kind равно "int"
    ожидается да
  пример «A record parameter is a variable»
    дано kind равно "struct rect left width"
    ожидается да
  пример «A function is not»
    дано kind равно "function"
    ожидается нет
  (kind равен "int") или ((kind равен "gone") или (kind начинается с "struct "))

тотальная функция «Newest»
  принимает name: строка, scope: список «Binding»
  возвращает список «Binding»
  пример «The latest binding of a name hides the earlier ones»
    дано name равно "x"
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "«x 3»" и «pure» равным "1",
      запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "«x»" и «pure» равным "0"]
    ожидается [запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "«x 3»" и «pure» равным "1"]
  пример «A function of the same name is not a variable»
    дано name равно "f"
    дано scope равно [
      запись «Binding» с «kind» равным "function" и «name» равным "f" и «body» равным "1" и «pure» равным ""]
    ожидается []
  пусть named равно (отфильтровать scope где binding → (binding.«name») равен name)
  пусть found равно (отфильтровать named где binding → «Variable kind» от (binding.«kind»))
  разбор found
    случай пусто
      то пустой список
    случай голова и хвост
      то [голова]

тотальная функция «Of binding kind»
  принимает kind: строка, scope: список «Binding»
  возвращает список «Binding»
  пример «Only the functions»
    дано kind равно "function"
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "«x»" и «pure» равным "«x»",
      запись «Binding» с «kind» равным "function" и «name» равным "f" и «body» равным "1" и «pure» равным ""]
    ожидается [запись «Binding» с «kind» равным "function" и «name» равным "f" и «body» равным "1" и «pure» равным ""]
  отфильтровать scope где binding → (binding.«kind») равен kind

тотальная функция «Self name»
  принимает scope: список «Binding»
  возвращает строка
  пример «The function being translated»
    дано scope равно [
      запись «Binding» с «kind» равным "self" и «name» равным "factorial" и «body» равным "" и «pure» равным ""]
    ожидается "factorial"
  пример «Outside a function»
    дано scope равно []
    ожидается ""
  разбор («Of binding kind» от "self" и scope)
    случай пусто
      то ""
    случай голова и хвост
      то голова.«name»

тотальная функция «Context of»
  принимает scope: список «Binding»
  возвращает список «Binding»
  пример «What a loop body sees besides its own variables»
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "«x»" и «pure» равным "«x»",
      запись «Binding» с «kind» равным "self" и «name» равным "f" и «body» равным "" и «pure» равным ""]
    ожидается [запись «Binding» с «kind» равным "self" и «name» равным "f" и «body» равным "" и «pure» равным ""]
  отфильтровать scope где binding → не («Variable kind» от (binding.«kind»))

тотальная функция «Fresh name»
  принимает name: строка, scope: список «Binding»
  возвращает строка
  пример «A name seen for the first time keeps its C spelling»
    дано name равно "sum"
    дано scope равно []
    ожидается "«sum»"
  пример «A name bound before gets a new one, numbered by the size of the scope»
    дано name равно "sum"
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "sum" и «body» равным "«sum»" и «pure» равным "0"]
    ожидается "«sum 2»"
  если пусто («Newest» от name и scope)
    то соединить ["«", name, "»"] по ""
    иначе соединить ["«", name, " ", (к строке ((длина scope) плюс 1)), "»"] по ""

тотальная функция «Record»
  принимает value: «Value»
  возвращает признак
  пример «A record parameter is marked third»
    дано value равно запись «Value» с «texts» равным ["«r»", "«r»", "r"] и «marks» равным [нет, нет,
      да] и «duties» равным [
      ] и «refusals» равным []
    ожидается да
  «Mark at» от 3 и (value.«marks»)

тотальная функция «Bound value»
  принимает b: «Binding», place: строка
  возвращает «Value»
  пример «A local reads as its latest flang name»
    дано b равно запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "y" и «pure» равным "p"
    дано place равно "строка 4: имя «x»"
    ожидается запись «Value» с «texts» равным ["y", "p", "x"] и «marks» равным [нет,
      нет] и «duties» равным [
      ] и «refusals» равным []
  пример «A local read before it got a value»
    дано b равно запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "" и «pure» равным ""
    дано place равно "строка 4: имя «x»"
    ожидается запись «Value» с «texts» равным ["0", "0", "?"] и «marks» равным [нет, нет] и «duties» равным [
      ] и «refusals» равным ["строка 4: имя «x» читается до присваивания"]
  пример «A record parameter»
    дано b равно запись «Binding» с «kind» равным "struct q" и «name» равным "r" и «body» равным "b" и «pure» равным "r"
    дано place равно "строка 4: имя «r»"
    ожидается запись «Value» с «texts» равным ["b", "r", "r"] и «marks» равным [нет, нет, да] и «duties» равным [
      ] и «refusals» равным []
  пусть kind равно (b.«kind»)
  пусть texts равно [(b.«body»), (b.«pure»), (b.«name»)]
  пусть value равно («Plain value» от (b.«body») и (b.«pure») и (b.«name») и нет)
  пусть whole равно (запись «Value» с «texts» равным texts и «marks» равным [нет, нет,
    да] и «duties» равным пустой список и «refusals» равным пустой список)
  пусть gone равно («Refused value» от (соединить [place, " вне своей области видимости"] по ""))
  пусть unset равно («Refused value» от (соединить [place, " читается до присваивания"] по ""))
  «Chosen» от [(«When» от (kind равен "gone") и gone), («When» от (kind начинается с "struct ") и whole),
    («When» от (пусто (b.«body»)) и unset)] и value

тотальная функция «Member»
  принимает rest: строка, base: «Value», line: число
  возвращает «Value»
  пример «A field of a record parameter»
    дано rest равно "0x1 <col:9, col:11> 'int' lvalue .width 0x2"
    дано base равно запись «Value» с «texts» равным ["«r»", "«r»", "r"] и «marks» равным [нет, нет,
      да] и «duties» равным [
      ] и «refusals» равным []
    дано line равно 3
    ожидается запись «Value» с «texts» равным ["(«r».«width»)", "(«r».«width»)", "r.width"] и «marks» равным [нет,
      нет] и «duties» равным [] и «refusals» равным []
  пример «A field reached through a pointer is outside the subset»
    дано rest равно "0x1 <col:9, col:12> 'int' lvalue ->width 0x2"
    дано base равно запись «Value» с «texts» равным ["«r»", "«r»", "r"] и «marks» равным [нет, нет] и «duties» равным [
      ] и «refusals» равным []
    дано line равно 3
    ожидается запись «Value» с «texts» равным ["0", "0", "?"] и «marks» равным [нет, нет] и «duties» равным [
      ] и «refusals» равным ["строка 3: поле через указатель вне подмножества"]
  пусть marked равно (отфильтровать («Words» от rest) где word → word начинается с ".")
  пусть word равно («Cell» от 1 и marked)
  пусть named равно (если (длина word) больше 1 то (подстрока word с 2 по (длина word)) иначе "")
  пусть place равно (соединить ["строка ", (к строке line), ": "] по "")
  пусть typed равно ((«Cell» от 1 и («Quoted» от rest)) равен "int")
  пусть body равно (соединить ["(", («Body» от base), ".«", named, "»)"] по "")
  пусть pure равно (соединить ["(", («Pure» от base), ".«", named, "»)"] по "")
  пусть c равно (соединить [(«C text» от base), ".", named] по "")
  пусть inner равно (base.«duties»)
  пусть value равно (запись «Value» с «texts» равным [body, pure, c] и «marks» равным [нет,
    нет] и «duties» равным inner и «refusals» равным (base.«refusals»))
  пусть arrow равно («Refused value» от (соединить [place, "поле через указатель вне подмножества"] по ""))
  пусть loose равно («Refused value» от (соединить [place, "поле не у записи-параметра"] по ""))
  пусть untyped равно («Refused value» от (соединить [place, "поле не типа int"] по ""))
  «Chosen» от [(«When» от (rest содержит "->") и arrow), («When» от (не («Record» от base)) и loose),
    («When» от (не typed) и untyped)] и value

тотальная функция «Callee»
  принимает kids: список «Node»
  возвращает строка
  пример «The name of the called function»
    дано kids равно [вариант «Tree» с words равным ["ImplicitCastExpr",
      "0x1 'int (*)(int, int)' <FunctionToPointerDecay>"] и line равным 3 и kids равным [вариант «Tree» с words равным [
      "DeclRefExpr", "0x2 'int (int, int)' Function 0x3 'width' 'int (int, int)'"] и line равным 3 и kids равным []]]
    ожидается "width"
  пример «No children, no callee»
    дано kids равно []
    ожидается ""
  разбор kids
    случай пусто
      то ""
    случай голова и хвост
      то «Function named» от («Targets» от голова и "DeclRefExpr")

тотальная функция «Function named»
  принимает rests: список строки
  возвращает строка
  пример «A reference to a function gives its name»
    дано rests равно ["0x2 'int (int, int)' Function 0x3 'width' 'int (int, int)'"]
    ожидается "width"
  пример «A reference to a variable gives nothing»
    дано rests равно ["0x2 'int' lvalue Var 0x3 'x' 'int'"]
    ожидается ""
  пусть functions равно (отфильтровать rests где rest → rest содержит " Function ")
  «Cell» от 2 и («Quoted» от («Cell» от 1 и functions))

тотальная функция «Argument»
  принимает value: «Value»
  возвращает «Value»
  пример «A record goes as it is»
    дано value равно запись «Value» с «texts» равным ["«r»", "«r»", "r"] и «marks» равным [нет, нет,
      да] и «duties» равным [
      ] и «refusals» равным []
    ожидается запись «Value» с «texts» равным ["«r»", "«r»", "r"] и «marks» равным [нет, нет, да] и «duties» равным [
      ] и «refusals» равным []
  если «Record» от value то value иначе («As number» от value)

тотальная функция «Call value»
  принимает callee: строка, arguments: список «Value», line: число, scope: список «Binding»
  возвращает «Value»
  пример «A call of a function translated above, with the duty that nothing inside it is undefined»
    дано callee равно "width"
    дано arguments равно [
      запись «Value» с «texts» равным ["«a»", "«a»", "a"] и «marks» равным [нет, нет] и «duties» равным [
      ] и «refusals» равным []]
    дано line равно 7
    дано scope равно [
      запись «Binding» с «kind» равным "function" и «name» равным "width" и «body» равным "1" и «pure» равным "«w»"]
    ожидается запись «Value» с «texts» равным ["(«width» от «a»)", "(«width» от «a»)",
      "width(a)"] и «marks» равным [нет,
      нет] и «duties» равным [
        запись «Duty» с «words» равным ["строка 7: вызов width(a) без неопределённого поведения внутри",
      "(«w» от «a»)"] и «line» равным 7] и «refusals» равным []
  пример «A function not translated above»
    дано callee равно "g"
    дано arguments равно []
    дано line равно 7
    дано scope равно []
    ожидается запись «Value» с «texts» равным ["0", "0", "?"] и «marks» равным [нет, нет] и «duties» равным [
      ] и «refusals» равным ["строка 7: вызов «g»: функция не переведена выше в этом файле"]
  пусть values равно (отобразить arguments как argument → «Argument» от argument)
  пусть place равно (соединить ["строка ", (к строке line), ": вызов «", callee, "»"] по "")
  пусть functions равно («Of binding kind» от "function" и scope)
  пусть found равно (отфильтровать functions где binding → (binding.«name») равен callee)
  пусть own равно (callee равен («Self name» от scope))
  пусть stranger равно (если own то "рекурсия вне подмножества" иначе "функция не переведена выше в этом файле")
  разбор found
    случай пусто
      то «Refused value» от (соединить [place, ": ", stranger] по "")
    случай голова и хвост
      то «Called» от голова и values и line и place

тотальная функция «Called»
  принимает b: «Binding», values: список «Value», line: число, place: строка
  возвращает «Value»
  пример «A call without a duty when nothing in the callee is undefined»
    дано b равно запись «Binding» с «kind» равным "function" и «name» равным "m" и «pure» равным "" и «body» равным "2"
    дано values равно [
      запись «Value» с «texts» равным ["«a»", "«a»", "a"] и «marks» равным [нет, нет] и «duties» равным [
      ] и «refusals» равным [],
        запись «Value» с «texts» равным ["0", "0", "0"] и «marks» равным [нет, да] и «duties» равным [
      ] и «refusals» равным []]
    дано line равно 7
    дано place равно "строка 7: вызов «m»"
    ожидается запись «Value» с «texts» равным ["(«m» от «a» и 0)", "(«m» от «a» и 0)",
      "m(a, 0)"] и «marks» равным [нет,
      нет] и «duties» равным [] и «refusals» равным []
  пусть name равно (b.«name»)
  пусть bodies равно (отобразить values как value → «Body» от value)
  пусть pures равно (отобразить values как value → «Pure» от value)
  пусть cs равно (отобразить values как value → «C text» от value)
  пусть body равно (соединить ["(«", name, "» от ", (соединить bodies по " и "), ")"] по "")
  пусть pure равно (соединить ["(«", name, "» от ", (соединить pures по " и "), ")"] по "")
  пусть c равно (соединить [name, "(", (соединить cs по ", "), ")"] по "")
  пусть checked равно (соединить ["(", (b.«pure»), " от ", (соединить pures по " и "), ")"] по "")
  пусть said равно (соединить ["строка ", (к строке line), ": вызов ", c,
    " без неопределённого поведения внутри"] по "")
  пусть inside равно (если пусто (b.«pure») то пустой список иначе [(запись «Duty» с «words» равным [said,
    checked] и «line» равным line)])
  пусть inner равно («Joined duties» от (отобразить values как value → value.«duties»))
  пусть duties равно («Соединить списки» от inner и inside)
  пусть refusals равно («Joined lists» от [] и (отобразить values как value → value.«refusals»))
  пусть arity равно (к строке (длина values))
  пусть made равно (запись «Value» с «texts» равным [body, pure, c] и «marks» равным [нет,
    нет] и «duties» равным duties и «refusals» равным refusals)
  если arity равен (b.«body»)
    то made
    иначе «Refused value» от (соединить [place, ": число аргументов не совпадает"] по "")

тотальная функция «Expression kind»
  принимает words: список строки, line: число, parts: список «Value», scope: список «Binding», callee: строка
  возвращает «Value»
  пример «A cast that is not a read is outside the subset»
    дано words равно ["ImplicitCastExpr", "0x1 'long' <IntegralCast>"]
    дано line равно 7
    дано parts равно []
    дано scope равно []
    дано callee равно ""
    ожидается запись «Value» с «texts» равным ["0", "0", "?"] и «marks» равным [нет, нет] и «duties» равным [
      ] и «refusals» равным ["строка 7: неявное приведение типа вне подмножества: 0x1 'long' <IntegralCast>"]
  пусть kind равно («Cell» от 1 и words)
  пусть rest равно («Cell» от 2 и words)
  пусть sign равно («Last word» от («Quoted» от rest))
  пусть ctype равно («Cell» от 1 и («Quoted» от rest))
  пусть place равно (соединить ["строка ", (к строке line), ": "] по "")
  пусть badtype равно («Refused value» от (соединить [place, "операция над типом «", ctype,
    "» вне подмножества"] по ""))
  пусть badcast равно («Refused value» от (соединить [place, "неявное приведение типа вне подмножества: ", rest] по ""))
  пусть outside равно («Refused value» от (соединить [place, "выражение «", kind, "» вне подмножества"] по ""))
  пусть leading равно («Part» от 1 и parts)
  пусть trailing равно («Part» от 2 и parts)
  разбор kind
    случай "IntegerLiteral"
      то «Literal value» от rest и line
    случай "ImplicitCastExpr"
      то если rest содержит "<LValueToRValue>" то leading иначе badcast
    случай "ParenExpr"
      то leading
    случай "DeclRefExpr"
      то «Reference» от rest и line и scope
    случай "MemberExpr"
      то «Member» от rest и leading и line
    случай "CallExpr"
      то «Call value» от callee и («Without first» от parts) и line и scope
    случай "BinaryOperator"
      то если ctype равен "int" то («Binary operation» от sign и leading и trailing и line) иначе badtype
    случай "UnaryOperator"
      то если ctype равен "int" то («Unary» от sign и leading и line) иначе badtype
    случай "ConditionalOperator"
      то «Choice» от leading и trailing и («Part» от 3 и parts)
    случай любое
      то outside

тотальная функция «Stored value»
  принимает node: «Node», scope: список «Binding»
  возвращает «Value»
  пример «An increment adds one, and the sum must fit in int»
    дано node равно вариант «Tree» с words равным ["UnaryOperator",
      "0x1 'int' postfix '++'"] и line равным 5 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'i' 'int'"] и line равным 5 и kids равным []]
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "i" и «body» равным "«i»" и «pure» равным "0"]
    ожидается запись «Value» с «texts» равным ["(«i» плюс 1)", "(0 плюс 1)",
      "(i + 1)"] и «marks» равным [нет, нет] и «duties» равным [
      запись «Duty» с «words» равным ["строка 5: (i + 1) не выше INT_MAX",
      "(0 плюс 1) не больше 2147483647"] и «line» равным 5,
      запись «Duty» с «words» равным ["строка 5: (i + 1) не ниже INT_MIN",
      "(0 плюс 1) не меньше -2147483648"] и «line» равным 5] и «refusals» равным []
  пример «An assignment stores its right side»
    дано node равно вариант «Tree» с words равным ["BinaryOperator", "0x1 'int' '='"] и line равным 5 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'i' 'int'"] и line равным 5 и kids равным [],
      вариант «Tree» с words равным ["IntegerLiteral", "0x4 'int' 7"] и line равным 5 и kids равным []]
    дано scope равно []
    ожидается запись «Value» с «texts» равным ["7", "7", "7"] и «marks» равным [нет, да] и «duties» равным [
      ] и «refusals» равным []
  пусть kind равно («Kind» от node)
  пусть line равно («Line» от node)
  пусть quoted равно («Quoted» от («Rest» от node))
  пусть sign равно (если kind равен "CompoundAssignOperator" то («Cell» от 2 и quoted) иначе («Last word» от quoted))
  пусть current равно («Expression» от («Kid» от 1 и node) и scope)
  пусть stored равно («As number» от («Expression» от («Kid» от 2 и node) и scope))
  пусть one равно («Plain value» от "1" и "1" и "1" и нет)
  пусть arith равно («Compound sign» от sign)
  пусть place равно (соединить ["строка ", (к строке line), ": "] по "")
  пусть idle равно («Refused value» от (соединить [place, "выражение «", sign,
    "» без присваивания вне подмножества"] по ""))
  «Chosen» от [(«When» от ((kind равен "BinaryOperator") и притом (sign равен "=")) и stored),
    («When» от (kind равен "CompoundAssignOperator") и («Binary operation» от arith и current и stored и line)),
    («When» от (sign равен "++") и («Binary operation» от "+" и current и one и line)),
    («When» от (sign равен "--") и («Binary operation» от "-" и current и one и line))] и idle

тотальная функция «Compound sign»
  принимает sign: строка
  возвращает строка
  пример «Plus-assign adds»
    дано sign равно "+="
    ожидается "+"
  пример «A shift-assign keeps its shift, which is outside the subset»
    дано sign равно "<<="
    ожидается "<<"
  если «Ends with» от sign и "=" то (подстрока sign с 1 по ((длина sign) минус 1)) иначе sign

функция «Assigned»
  принимает assignment: «Node», others: список «Node», scope: список «Binding», turns: список «Turn», indent: строка
  возвращает «Flow»
  пример «An assignment binds a new flang name, and what follows reads it»
    дано assignment равно вариант «Tree» с words равным ["BinaryOperator",
      "0x1 'int' '='"] и line равным 4 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
        "0x2 'int' lvalue Var 0x3 'x' 'int'"] и line равным 4 и kids равным [
      ], вариант «Tree» с words равным ["IntegerLiteral", "0x4 'int' 7"] и line равным 4 и kids равным []]
    дано others равно [
      вариант «Tree» с words равным ["ReturnStmt", ""] и line равным 5 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x4 'int' lvalue Var 0x3 'x' 'int'"] и line равным 5 и kids равным []]]
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "«x»" и «pure» равным "0"]
    дано turns равно []
    дано indent равно "  "
    ожидается запись «Flow» с «lines» равным ["  пусть «x 2» равно 7", "  «x 2»"] и «duties» равным [
      ] и «refusals» равным [] и «helpers» равным [] и «leaves» равным [запись «Leaf» с «turns» равным [
      ] и «value» равным "7" и «literal» равным нет]
  пусть target равно («Kid» от 1 и assignment)
  пусть value равно («Stored value» от assignment и scope)
  пусть line равно («Line» от target)
  пусть name равно (если («Kind» от target) равен "DeclRefExpr" то («Cell» от 2 и («Quoted» от («Rest» от target)))
    иначе "")
  пусть place равно (соединить ["строка ", (к строке line), ": присваивание «", name, "»"] по "")
  пусть found равно («Newest» от name и scope)
  пусть kinds равно (отобразить found как binding → binding.«kind»)
  пусть local равно («Holds» от "int" и kinds)
  пусть fresh равно («Fresh name» от name и scope)
  пусть bound равно («Bound» от "int" и name и fresh и («Pure» от value))
  пусть later равно («Statements» от others и (приписать bound к scope) и turns и indent)
  пусть head равно (соединить [indent, "пусть ", fresh, " равно ", («Body» от value)] по "")
  пусть duties равно («Соединить списки» от («Under path» от turns и (value.«duties»)) и (later.«duties»))
  пусть refusals равно («Соединить списки» от (value.«refusals») и (later.«refusals»))
  пусть lines равно (приписать head к (later.«lines»))
  пусть made равно («Flow of» от lines и duties и refusals и (later.«helpers») и (later.«leaves»))
  пусть stranger равно («Refused flow» от (соединить [place, ": цель не локальная переменная int"] по ""))
  если local то made иначе stranger

тотальная функция «Out of reach»
  принимает names: список строки, scope: список «Binding»
  возвращает список «Binding»
  пример «The counter of a for loop is out of reach after the loop»
    дано names равно ["i"]
    дано scope равно []
    ожидается [запись «Binding» с «kind» равным "gone" и «name» равным "i" и «body» равным "" и «pure» равным ""]
  свёртка names начиная с scope как reached и name → приписать («Bound» от "gone" и name и "" и "") к reached

тотальная функция «Refused node»
  принимает reason: строка, line: число
  возвращает «Node»
  пример «A refusal placed among statements»
    дано reason равно "строка 3: цикл без условия вне подмножества"
    дано line равно 3
    ожидается вариант «Tree» с words равным ["Refused",
      "строка 3: цикл без условия вне подмножества"] и line равным 3 и kids равным []
  вариант «Tree» с words равным ["Refused", reason] и line равным line и kids равным пустой список

тотальная функция «Present»
  принимает node: «Node»
  возвращает список «Node»
  пример «An empty slot of a for loop is nothing»
    дано node равно вариант «Tree» с words равным ["<<<NULL>>>", ""] и line равным 3 и kids равным []
    ожидается []
  если («Kind» от node) равен "<<<NULL>>>" то пустой список иначе [node]

тотальная функция «Loop node»
  принимает condition: «Node», statements: список «Node», line: число, names: строка
  возвращает «Node»
  пример «A loop is its condition and the statements of one turn»
    дано condition равно вариант «Tree» с words равным ["IntegerLiteral", "0x1 'int' 1"] и line равным 3 и kids равным [
      ]
    дано statements равно []
    дано line равно 3
    дано names равно ""
    ожидается вариант «Tree» с words равным ["Loop", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["IntegerLiteral", "0x1 'int' 1"] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["CompoundStmt", ""] и line равным 3 и kids равным []]
  пусть block равно (вариант «Tree» с words равным ["CompoundStmt", ""] и line равным line и kids равным statements)
  вариант «Tree» с words равным ["Loop", names] и line равным line и kids равным [condition, block]

тотальная функция «For parts»
  принимает node: «Node»
  возвращает список «Node»
  пример «A for loop is its start, the loop with the step last in its body, and the end of reach of its counter»
    дано node равно вариант «Tree» с words равным ["ForStmt", "0x1"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclStmt", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["VarDecl", "0x2 col:14 used i 'int' cinit"] и line равным 3 и kids равным []],
      вариант «Tree» с words равным ["<<<NULL>>>", ""] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["C", ""] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["S", ""] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["B", ""] и line равным 4 и kids равным []]
    ожидается [
      вариант «Tree» с words равным ["DeclStmt", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["VarDecl", "0x2 col:14 used i 'int' cinit"] и line равным 3 и kids равным []],
      вариант «Tree» с words равным ["Loop", "i"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["C", ""] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["CompoundStmt", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["B", ""] и line равным 4 и kids равным [],
      вариант «Tree» с words равным ["S", ""] и line равным 3 и kids равным []]],
      вариант «Tree» с words равным ["Ended", "i"] и line равным 3 и kids равным []]
  пусть line равно («Line» от node)
  пусть start равно («Kid» от 1 и node)
  пусть condition равно («Kid» от 3 и node)
  пусть stepping равно («Present» от («Kid» от 4 и node))
  пусть statements равно («Соединить списки» от («Statement list» от («Kid» от 5 и node)) и stepping)
  пусть names равно (отобразить («Targets» от start и "VarDecl") как rest → «Declared name» от rest)
  пусть ended равно (вариант «Tree» с words равным ["Ended",
    (соединить names по " ")] и line равным line и kids равным пустой список)
  пусть loop равно («Loop node» от condition и statements и line и (соединить names по " "))
  пусть bare равно ((«Kind» от condition) равен "<<<NULL>>>")
  пусть declared равно (не ((«Kind» от («Kid» от 2 и node)) равен "<<<NULL>>>"))
  пусть place равно (соединить ["строка ", (к строке line), ": "] по "")
  пусть endless равно («Refused node» от (соединить [place, "цикл for без условия вне подмножества"] по "") и line)
  пусть inside равно («Refused node» от (соединить [place, "объявление в условии цикла вне подмножества"] по "") и line)
  пусть made равно («Соединить списки» от («Present» от start) и [loop, ended])
  «Chosen» от [(«When» от bare и [endless]), («When» от declared и [inside])] и made

тотальная функция «While parts»
  принимает node: «Node»
  возвращает список «Node»
  пример «A while loop is the loop alone»
    дано node равно вариант «Tree» с words равным ["WhileStmt", "0x1"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["C", ""] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["B", ""] и line равным 4 и kids равным []]
    ожидается [
      вариант «Tree» с words равным ["Loop", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["C", ""] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["CompoundStmt", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["B", ""] и line равным 4 и kids равным []]]]
  пусть line равно («Line» от node)
  пусть place равно (соединить ["строка ", (к строке line), ": объявление в условии цикла вне подмножества"] по "")
  пусть loop равно («Loop node» от («Kid» от 1 и node) и («Statement list» от («Kid» от 2 и node)) и line и "")
  если («Rest» от node) содержит "has_var" то [(«Refused node» от place и line)] иначе [loop]

объект «Step»
  «name»: строка
  «amount»: число

объект «Count»
  «bound»: «Node»
  «counter»: строка
  «relation»: строка
  «amount»: число
  «reason»: строка

объект «Grown»
  «scope»: список «Binding»
  «lines»: список строки

тотальная функция «Variable named»
  принимает rest: строка
  возвращает строка
  пример «A variable»
    дано rest равно "0x2 'int' lvalue Var 0x3 'i' 'int'"
    ожидается "i"
  пример «A function is not a variable»
    дано rest равно "0x2 'int (int)' Function 0x3 'f' 'int (int)'"
    ожидается ""
  если rest содержит " Function " то "" иначе («Cell» от 2 и («Quoted» от rest))

тотальная функция «Plain name»
  принимает node: «Node»
  возвращает строка
  пример «A read of a variable through its cast»
    дано node равно вариант «Tree» с words равным ["ImplicitCastExpr",
      "0x1 'int' <LValueToRValue>"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'i' 'int'"] и line равным 3 и kids равным []]
    ожидается "i"
  пример «A literal names nothing»
    дано node равно вариант «Tree» с words равным ["IntegerLiteral", "0x1 'int' 3"] и line равным 3 и kids равным []
    ожидается ""
  разбор node
    случай вариант «Tree» с words как words и line как line и kids как kids
      то «Name of node» от words и (отобразить kids как kid → «Plain name» от kid)

тотальная функция «Name of node»
  принимает words: список строки, inner: список строки
  возвращает строка
  пример «A parenthesis passes the name inside»
    дано words равно ["ParenExpr", "0x1 'int'"]
    дано inner равно ["i"]
    ожидается "i"
  пусть kind равно («Cell» от 1 и words)
  пусть wrapper равно (kind равен "ImplicitCastExpr") или (kind равен "ParenExpr")
  «Chosen» от [(«When» от (kind равен "DeclRefExpr") и («Variable named» от («Cell» от 2 и words))),
    («When» от wrapper и («Cell» от 1 и inner))] и ""

тотальная функция «Assigned names»
  принимает node: «Node»
  возвращает список строки
  пример «Every variable written in a tree»
    дано node равно вариант «Tree» с words равным ["CompoundStmt", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["UnaryOperator", "0x1 'int' postfix '++'"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'i' 'int'"] и line равным 3 и kids равным []]]
    ожидается ["i"]
  разбор node
    случай вариант «Tree» с words как words и line как line и kids как kids
      то «Joined lists» от («Own write» от words и kids) и (отобразить kids как kid → «Assigned names» от kid)

тотальная функция «Own write»
  принимает words: список строки, kids: список «Node»
  возвращает список строки
  пример «A compound assignment writes its left side»
    дано words равно ["CompoundAssignOperator", "0x1 'int' '+=' ComputeLHSTy='int' ComputeResultTy='int'"]
    дано kids равно [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'sum' 'int'"] и line равным 3 и kids равным []]
    ожидается ["sum"]
  пусть kind равно («Cell» от 1 и words)
  пусть sign равно («Last word» от («Quoted» от («Cell» от 2 и words)))
  пусть counted равно ((sign равен "++") или (sign равен "--"))
  пусть stored равно ((kind равен "BinaryOperator") и притом (sign равен "="))
  пусть moved равно ((kind равен "UnaryOperator") и притом counted)
  пусть writes равно ((kind равен "CompoundAssignOperator") или (stored или moved))
  пусть target равно (свёртка kids начиная с "" как found и kid → если пусто found то («Plain name» от kid) иначе found)
  если writes то [target] иначе пустой список

тотальная функция «Referenced names»
  принимает node: «Node»
  возвращает список строки
  пример «Variables read or written, each once, in order»
    дано node равно вариант «Tree» с words равным ["BinaryOperator", "0x1 'int' '<'"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'i' 'int'"] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x4 'int' lvalue ParmVar 0x5 'n' 'int'"] и line равным 3 и kids равным []]
    ожидается ["i", "n"]
  пусть names равно (отобразить («Targets» от node и "DeclRefExpr") как rest → «Variable named» от rest)
  «Distinct» от (отфильтровать names где name → не (пусто name))

тотальная функция «Literal amount»
  принимает node: «Node»
  возвращает число
  пример «A positive int literal»
    дано node равно вариант «Tree» с words равным ["IntegerLiteral", "0x1 'int' 2"] и line равным 3 и kids равным []
    ожидается 2
  пример «Anything else is no step»
    дано node равно вариант «Tree» с words равным ["DeclRefExpr",
      "0x1 'int' lvalue Var 0x3 'k' 'int'"] и line равным 3 и kids равным []
    ожидается 0
  пусть digits равно («Last word» от («Words» от («Rest» от node)))
  пусть literal равно (((«Kind» от node) равен "IntegerLiteral") и притом («Digits» от digits))
  если literal то (к числу digits) иначе 0

тотальная функция «Step of»
  принимает node: «Node»
  возвращает «Step»
  пример «An increment»
    дано node равно вариант «Tree» с words равным ["UnaryOperator",
      "0x1 'int' postfix '++'"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'i' 'int'"] и line равным 3 и kids равным []]
    ожидается запись «Step» с «name» равным "i" и «amount» равным 1
  пример «A step written out»
    дано node равно вариант «Tree» с words равным ["BinaryOperator", "0x1 'int' '='"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'i' 'int'"] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["BinaryOperator", "0x4 'int' '-'"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["ImplicitCastExpr", "0x5 'int' <LValueToRValue>"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x6 'int' lvalue Var 0x3 'i' 'int'"] и line равным 3 и kids равным []],
      вариант «Tree» с words равным ["IntegerLiteral", "0x7 'int' 2"] и line равным 3 и kids равным []]]
    ожидается запись «Step» с «name» равным "i" и «amount» равным -2
  пусть kind равно («Kind» от node)
  пусть quoted равно («Quoted» от («Rest» от node))
  пусть sign равно (если kind равен "CompoundAssignOperator" то («Cell» от 2 и quoted) иначе («Last word» от quoted))
  пусть target равно («Plain name» от («Kid» от 1 и node))
  пусть right равно («Kid» от 2 и node)
  пусть size равно («Literal amount» от right)
  пусть inner равно («Last word» от («Quoted» от («Rest» от right)))
  пусть leftname равно («Plain name» от («Kid» от 1 и right))
  пусть same равно (((«Kind» от right) равен "BinaryOperator") и притом (leftname равен target))
  пусть written равно ((kind равен "BinaryOperator") и притом (sign равен "="))
  пусть spelled равно (если same то («Literal amount» от («Kid» от 2 и right)) иначе 0)
  пусть amount равно («Chosen» от [
    («When» от ((kind равен "CompoundAssignOperator") и притом (sign равен "-=")) и (0 минус size)),
    («When» от ((kind равен "UnaryOperator") и притом (sign равен "++")) и 1),
    («When» от ((kind равен "UnaryOperator") и притом (sign равен "--")) и -1),
    («When» от ((kind равен "CompoundAssignOperator") и притом (sign равен "+=")) и size),
    («When» от (written и притом (inner равен "+")) и spelled),
    («When» от (written и притом (inner равен "-")) и (0 минус spelled))] и 0)
  запись «Step» с «name» равным target и «amount» равным amount

тотальная функция «Flipped»
  принимает sign: строка
  возвращает строка
  пример «A bound on the left reads the other way»
    дано sign равно "<"
    ожидается ">"
  разбор sign
    случай "<"
      то ">"
    случай ">"
      то "<"
    случай "<="
      то ">="
    случай ">="
      то "<="
    случай любое
      то sign

тотальная функция «Last node»
  принимает nodes: список «Node»
  возвращает «Node»
  пример «Nothing gives a missing node»
    дано nodes равно []
    ожидается вариант «Tree» с words равным ["Missing", ""] и line равным 0 и kids равным []
  свёртка nodes начиная с («Missing node») как last и node → node

тотальная функция «Counted»
  принимает loop: «Node»
  возвращает «Count»
  пример «A counter that climbs to its bound»
    дано loop равно вариант «Tree» с words равным ["Loop", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["BinaryOperator", "0x1 'int' '<='"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'i' 'int'"] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x4 'int' lvalue ParmVar 0x5 'n' 'int'"] и line равным 3 и kids равным []],
      вариант «Tree» с words равным ["CompoundStmt", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["UnaryOperator", "0x6 'int' postfix '++'"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x7 'int' lvalue Var 0x3 'i' 'int'"] и line равным 3 и kids равным []]]]
    ожидается запись «Count» с «bound» равным (вариант «Tree» с words равным ["DeclRefExpr",
      "0x4 'int' lvalue ParmVar 0x5 'n' 'int'"] и line равным 3 и kids равным [
      ]) и «counter» равным "i" и «relation» равным "<=" и «amount» равным 1 и «reason» равным ""
  пусть condition равно («Kid» от 1 и loop)
  пусть body равно («Kid» от 2 и loop)
  пусть stepped равно («Step of» от («Last node» от («Kids» от body)))
  пусть counter равно (stepped.«name»)
  пусть amount равно (stepped.«amount»)
  пусть sign равно («Last word» от («Quoted» от («Rest» от condition)))
  пусть left равно («Kid» от 1 и condition)
  пусть right равно («Kid» от 2 и condition)
  пусть onleft равно ((«Plain name» от left) равен counter)
  пусть onright равно ((«Plain name» от right) равен counter)
  пусть bound равно (если onleft то right иначе left)
  пусть relation равно (если onleft то sign иначе («Flipped» от sign))
  пусть writes равно («Assigned names» от body)
  пусть repeats равно (длина (отфильтровать writes где name → name равен counter))
  пусть moved равно (отфильтровать («Referenced names» от bound) где name → «Holds» от name и writes)
  пусть up равно ((amount больше 0) и притом ((relation равен "<") или (relation равен "<=")))
  пусть down равно ((amount меньше 0) и притом ((relation равен ">") или (relation равен ">=")))
  пусть named равно (соединить ["«", counter, "»"] по "")
  пусть reason равно («Chosen» от [
    («When» от (не ((«Kind» от condition) равен "BinaryOperator")) и "условие не сравнение"),
    («When» от (amount равен 0) и "последний оператор тела не сдвигает счётчик на постоянное число"),
    («When» от (не (onleft или onright)) и (соединить ["условие не сравнивает счётчик ", named] по "")),
    («When» от (не (repeats равен 1)) и (соединить ["счётчик ", named, " меняется не только шагом"] по "")),
    («When» от (не (пусто moved)) и "граница меняется в теле цикла"),
    («When» от (не (up или down)) и (соединить ["сравнение «", sign, "» не ведёт счётчик к границе"] по ""))] и "")
  пусть c равно counter
  пусть r равно relation
  пусть a равно amount
  пусть b равно bound
  пусть w равно reason
  запись «Count» с «bound» равным b и «counter» равным c и «relation» равным r и «amount» равным a и «reason» равным w

тотальная функция «Measure»
  принимает count: «Count», scope: список «Binding»
  возвращает строка
  пример «A counter climbing to an inclusive bound has one more turn than the distance»
    дано count равно запись «Count» с «bound» равным (вариант «Tree» с words равным ["DeclRefExpr",
      "0x4 'int' lvalue ParmVar 0x5 'n' 'int'"] и line равным 3 и kids равным [
      ]) и «counter» равным "i" и «relation» равным "<=" и «amount» равным 1 и «reason» равным ""
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "n" и «body» равным "«n»" и «pure» равным "«n»"]
    ожидается "((«n» минус «i») плюс 1)"
  пусть bound равно («Pure» от («As number» от («Expression» от (count.«bound») и scope)))
  пусть counter равно (соединить ["«", (count.«counter»), "»"] по "")
  пусть amount равно (count.«amount»)
  пусть size равно (если amount меньше 0 то (0 минус amount) иначе amount)
  пусть strict равно (((count.«relation») равен "<") или ((count.«relation») равен ">"))
  пусть extra равно (к строке (если strict то (size минус 1) иначе size))
  если amount больше 0
    то соединить ["((", bound, " минус ", counter, ") плюс ", extra, ")"] по ""
    иначе соединить ["((", counter, " минус ", bound, ") плюс ", extra, ")"] по ""

тотальная функция «Usable»
  принимает name: строка, scope: список «Binding»
  возвращает признак
  пример «A local with a value can be carried into a loop»
    дано name равно "x"
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "«x»" и «pure» равным "0"]
    ожидается да
  пример «A local without a value cannot»
    дано name равно "x"
    дано scope равно [запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "" и «pure» равным ""]
    ожидается нет
  пусть found равно (отфильтровать («Newest» от name и scope) где binding → не (пусто (binding.«body»)))
  пусть kinds равно (отобразить found как binding → binding.«kind»)
  не (пусто (отфильтровать kinds где kind → (kind равен "int") или (kind начинается с "struct ")))

тотальная функция «State names»
  принимает loop: «Node», scope: список «Binding»
  возвращает список строки
  пример «What a loop reads and writes, besides its own locals»
    дано loop равно вариант «Tree» с words равным ["Loop", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int' lvalue Var 0x3 'i' 'int'"] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["CompoundStmt", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["VarDecl", "0x4 col:9 used t 'int' cinit"] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x5 'int' lvalue Var 0x4 't' 'int'"] и line равным 3 и kids равным []]]
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "i" и «body» равным "«i»" и «pure» равным "0"]
    ожидается ["i"]
  пусть inner равно (отобразить («Targets» от loop и "VarDecl") как rest → «Declared name» от rest)
  пусть outer равно (отфильтровать («Referenced names» от loop) где name → не («Holds» от name и inner))
  отфильтровать outer где name → «Usable» от name и scope

тотальная функция «Current»
  принимает name: строка, scope: список «Binding», pure: признак
  возвращает строка
  пример «The latest flang name of a variable»
    дано name равно "x"
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "x" и «body» равным "«x 4»" и «pure» равным "7"]
    дано pure равно нет
    ожидается "«x 4»"
  разбор («Newest» от name и scope)
    случай пусто
      то "0"
    случай голова и хвост
      то если pure то (голова.«pure») иначе (голова.«body»)

тотальная функция «Call text»
  принимает name: строка, arguments: список строки
  возвращает строка
  пример «A call of a helper»
    дано name равно "f loop 3 sum"
    дано arguments равно ["«i»", "0"]
    ожидается "(«f loop 3 sum» от «i» и 0)"
  соединить ["(«", name, "» от ", (соединить arguments по " и "), ")"] по ""

функция «Stepped»
  принимает following: «Node», scope: список «Binding», turns: список «Turn», indent: строка
  возвращает «Flow»
  пример «The end of one turn calls the next turn with the latest names»
    дано following равно вариант «Tree» с words равным ["Next", "i sum"] и line равным 3 и kids равным []
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "sum" и «body» равным "«sum 3»" и «pure» равным "q",
      запись «Binding» с «kind» равным "int" и «name» равным "i" и «body» равным "«i»" и «pure» равным "«i»"]
    дано turns равно []
    дано indent равно "      "
    ожидается запись «Flow» с «lines» равным ["      («@NEXT@» от «i» и «sum 3»)"] и «duties» равным [
      ] и «refusals» равным [] и «helpers» равным [] и «leaves» равным [запись «Leaf» с «turns» равным [
      ] и «value» равным "(«@NEXT@» от «i» и q)" и «literal» равным нет]
  пусть names равно («Words» от («Rest» от following))
  пусть bodies равно (отобразить names как name → «Current» от name и scope и нет)
  пусть pures равно (отобразить names как name → «Current» от name и scope и да)
  пусть leaf равно («Leaf of» от turns и («Call text» от "@NEXT@" и pures) и нет)
  «Flow of» от [
    (соединить [indent,
    («Call text» от "@NEXT@" и bodies)] по "")] и пустой список и пустой список и пустой список и [leaf]

тотальная функция «Replaced»
  принимает text: строка, name: строка
  возвращает строка
  пример «The placeholder of the next turn becomes the helper»
    дано text равно "(«@NEXT@» от «i»)"
    дано name равно "f loop 3 sum"
    ожидается "(«f loop 3 sum» от «i»)"
  соединить (разделить text по "«@NEXT@»") по (соединить ["«", name, "»"] по "")

тотальная функция «Parameter type»
  принимает kind: строка
  возвращает строка
  пример «A record parameter keeps its record type»
    дано kind равно "struct rect left width"
    ожидается "«struct rect»"
  пример «An int is a number inside a helper»
    дано kind равно "int"
    ожидается "число"
  пусть words равно («Words» от kind)
  если kind начинается с "struct " то (соединить ["«struct ", («Cell» от 2 и words), "»"] по "") иначе "число"

тотальная функция «State parameters»
  принимает carried: список строки, scope: список «Binding»
  возвращает строка
  пример «The parameters of a helper»
    дано carried равно ["i", "r"]
    дано scope равно [
      запись «Binding» с «kind» равным "struct rect left" и «name» равным "r" и «body» равным "«r»" и «pure» равным "r",
      запись «Binding» с «kind» равным "int" и «name» равным "i" и «body» равным "«i»" и «pure» равным "0"]
    ожидается "«i»: число, «r»: «struct rect»"
  соединить (отобразить carried как name → «State parameter» от name и scope) по ", "

тотальная функция «State parameter»
  принимает name: строка, scope: список «Binding»
  возвращает строка
  пример «An int»
    дано name равно "i"
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "i" и «body» равным "«i»" и «pure» равным "0"]
    ожидается "«i»: число"
  пусть kinds равно (отобразить («Newest» от name и scope) как binding → binding.«kind»)
  соединить ["«", name, "»: ", («Parameter type» от («Cell» от 1 и kinds))] по ""

тотальная функция «Inner scope»
  принимает carried: список строки, scope: список «Binding»
  возвращает список «Binding»
  пример «Inside a helper each variable is its own parameter»
    дано carried равно ["i"]
    дано scope равно [
      запись «Binding» с «kind» равным "int" и «name» равным "i" и «body» равным "«i 4»" и «pure» равным "0",
      запись «Binding» с «kind» равным "self" и «name» равным "f" и «body» равным "" и «pure» равным ""]
    ожидается [запись «Binding» с «kind» равным "int" и «name» равным "i" и «body» равным "«i»" и «pure» равным "«i»",
      запись «Binding» с «kind» равным "self" и «name» равным "f" и «body» равным "" и «pure» равным ""]
  пусть own равно (отобразить carried как name → «Own parameter» от name и scope)
  «Соединить списки» от own и («Context of» от scope)

тотальная функция «Own parameter»
  принимает name: строка, scope: список «Binding»
  возвращает «Binding»
  пример «A parameter of a helper»
    дано name равно "i"
    дано scope равно []
    ожидается запись «Binding» с «kind» равным "int" и «name» равным "i" и «body» равным "«i»" и «pure» равным "«i»"
  пусть kinds равно (отобразить («Newest» от name и scope) как binding → binding.«kind»)
  пусть kind равно (если пусто kinds то "int" иначе («Cell» от 1 и kinds))
  пусть quoted равно (соединить ["«", name, "»"] по "")
  «Bound» от kind и name и quoted и quoted

тотальная функция «Helper head»
  принимает name: строка, parameters: строка, returned: строка, measure: строка
  возвращает список строки
  пример «The head of a helper»
    дано name равно "f loop 3 sum"
    дано parameters равно "«i»: число"
    дано returned равно "число"
    дано measure равно "((«n» минус «i») плюс 1)"
    ожидается ["тотальная функция «f loop 3 sum»", "  принимает «i»: число", "  возвращает число",
      "  убывает ((«n» минус «i») плюс 1)"]
  [(соединить ["тотальная функция «", name, "»"] по ""), (соединить ["  принимает ", parameters] по ""),
    (соединить ["  возвращает ", returned] по ""), (соединить ["  убывает ", measure] по "")]

тотальная функция «Value helper»
  принимает prefix: строка, name: строка, head: список строки, test: строка, lines: список строки
  возвращает список строки
  пример «A helper gives the value of one variable when the loop ends»
    дано prefix равно "f loop 3"
    дано name равно "sum"
    дано head равно ["h"]
    дано test равно "(«i» меньше «n»)"
    дано lines равно ["      («@NEXT@» от «i»)"]
    ожидается ["h", "  если («i» меньше «n»)", "    то", "      («f loop 3 sum» от «i»)", "    иначе", "      «sum»"]
  пусть helper равно (соединить [prefix, " ", name] по "")
  пусть body равно (отобразить lines как line → «Replaced» от line и helper)
  «Joined lists» от head и [[(соединить ["  если ", test] по ""), "    то"], body,
    ["    иначе", (соединить ["      «", name, "»"] по "")]]

тотальная функция «Next check»
  принимает leaves: список «Leaf», helper: строка
  возвращает строка
  пример «The next turn is checked on the path that reaches it»
    дано leaves равно [запись «Leaf» с «turns» равным [
      запись «Turn» с «test» равным "c" и «taken» равным да] и «literal» равным нет и «value» равным "(«@NEXT@» от i)"]
    дано helper равно "f loop 3 duty 1"
    ожидается "(да) и притом (если c то ((«f loop 3 duty 1» от i)) иначе да)"
  свёртка leaves начиная с "да" как joined и leaf → соединить ["(", joined, ") и притом (",
    («Last duty claim» от (leaf.«turns») и («Replaced» от (leaf.«value») и helper)), ")"] по ""

тотальная функция «Duty helper»
  принимает head: список строки, test: строка, duty: «Duty», following: строка, guarded: признак
  возвращает список строки
  пример «A duty inside the body holds on every turn»
    дано head равно ["h"]
    дано test равно "(«i» меньше «n»)"
    дано duty равно запись «Duty» с «words» равным ["d", "(«s» плюс «i») не больше 2147483647"] и «line» равным 4
    дано following равно "(«h» от «i»)"
    дано guarded равно да
    ожидается ["h",
      "  если («i» меньше «n») то (((«s» плюс «i») не больше 2147483647) и притом ((«h» от «i»))) иначе да"]
  пусть promise равно («Duty claim» от duty)
  пусть inside равно (соединить ["  если ", test, " то ((", promise, ") и притом (", following, ")) иначе да"] по "")
  пусть always равно (соединить ["  (", promise, ") и притом (если ", test, " то (", following, ") иначе да)"] по "")
  добавить (если guarded то inside иначе always) к head

объект «Turned duty»
  «guarded»: признак
  «duty»: «Duty»

тотальная функция «Turned duties»
  принимает condition: список «Duty», body: список «Duty»
  возвращает список «Turned duty»
  пример «Duties of the condition come first and hold on every check»
    дано condition равно [запись «Duty» с «words» равным ["c", "да"] и «line» равным 3]
    дано body равно [запись «Duty» с «words» равным ["b", "да"] и «line» равным 4]
    ожидается [запись «Turned duty» с «guarded» равным нет и «duty» равным (запись «Duty» с «words» равным ["c",
      "да"] и «line» равным 3),
      запись «Turned duty» с «guarded» равным да и «duty» равным (запись «Duty» с «words» равным ["b",
        "да"] и «line» равным 4)]
  пусть checked равно (отобразить condition как duty → запись «Turned duty» с «guarded» равным нет и «duty» равным duty)
  пусть inside равно (отобразить body как duty → запись «Turned duty» с «guarded» равным да и «duty» равным duty)
  «Соединить списки» от checked и inside

объект «Loop duty»
  «at»: число
  «guarded»: признак
  «duty»: «Duty»

тотальная функция «Numbered duties»
  принимает duties: список «Turned duty»
  возвращает список «Loop duty»
  пример «Duties counted from one»
    дано duties равно [запись «Turned duty» с «guarded» равным нет и «duty» равным (запись «Duty» с «words» равным ["c",
      "да"] и «line» равным 3)]
    ожидается [
      запись «Loop duty» с «duty» равным (запись «Duty» с «words» равным [
      "c", "да"] и «line» равным 3) и «at» равным 1 и «guarded» равным нет]
  свёртка duties начиная с (пустой список) как m и each → добавить («Loop duty of» от ((длина m) плюс 1) и each) к m

тотальная функция «Loop duty block»
  принимает prefix: строка, taking: строка, measure: строка, test: строка, leaves: список «Leaf», numbered: «Loop duty»
  возвращает список строки
  пример «The helper that checks one duty on every turn»
    дано prefix равно "f loop 3"
    дано taking равно "«i»: число"
    дано measure равно "«i»"
    дано test равно "(«i» больше 0)"
    дано leaves равно []
    дано numbered равно запись «Loop duty» с «duty» равным (запись «Duty» с «words» равным [
      "c", "да"] и «line» равным 3) и «at» равным 1 и «guarded» равным нет
    ожидается ["тотальная функция «f loop 3 duty 1»", "  принимает «i»: число", "  возвращает признак", "  убывает «i»",
      "  (да) и притом (если («i» больше 0) то (да) иначе да)"]
  пусть helper равно (соединить [prefix, " duty ", (к строке (numbered.«at»))] по "")
  пусть head равно («Helper head» от helper и taking и "признак" и measure)
  «Duty helper» от head и test и (numbered.«duty») и («Next check» от leaves и helper) и (numbered.«guarded»)

тотальная функция «Loop duty claim»
  принимает prefix: строка, arguments: список строки, numbered: «Loop duty», line: число
  возвращает «Duty»
  пример «Outside the loop a duty is the call of its helper on the values at the start»
    дано prefix равно "f loop 3"
    дано arguments равно ["1", "«n»"]
    дано numbered равно запись «Loop duty» с «duty» равным (запись «Duty» с «words» равным [
      "строка 4: (s + i) не выше INT_MAX", "да"] и «line» равным 4) и «at» равным 2 и «guarded» равным да
    дано line равно 3
    ожидается запись «Duty» с «words» равным ["строка 4: (s + i) не выше INT_MAX",
      "(«f loop 3 duty 2» от 1 и «n»)"] и «line» равным 4
  пусть helper равно (соединить [prefix, " duty ", (к строке (numbered.«at»))] по "")
  пусть duty равно (numbered.«duty»)
  запись «Duty» с «words» равным [(«Duty name» от duty),
    («Call text» от helper и arguments)] и «line» равным (duty.«line»)

тотальная функция «After loop»
  принимает grown: «Grown», name: строка, prefix: строка, bodies: список строки, pures: список строки, indent: строка
  возвращает «Grown»
  пример «After the loop a changed variable is the value its helper gives»
    дано grown равно запись «Grown» с «scope» равным [] и «lines» равным []
    дано name равно "s"
    дано prefix равно "g"
    дано bodies равно ["«n»"]
    дано pures равно ["«n»"]
    дано indent равно "  "
    ожидается запись «Grown» с «lines» равным ["  пусть «s» равно («g s» от «n»)"] и «scope» равным [
      запись «Binding» с «kind» равным "int" и «name» равным "s" и «body» равным "«s»" и «pure» равным "(«g s» от «n»)"]
  пусть helper равно (соединить [prefix, " ", name] по "")
  пусть fresh равно («Fresh name» от name и (grown.«scope»))
  пусть line равно (соединить [indent, "пусть ", fresh, " равно ", («Call text» от helper и bodies)] по "")
  пусть bound равно («Bound» от "int" и name и fresh и («Call text» от helper и pures))
  запись «Grown» с «scope» равным (приписать bound к (grown.«scope»)) и «lines» равным (добавить line к (grown.«lines»))

тотальная функция «Foreign leaves»
  принимает leaves: список «Leaf»
  возвращает число
  пример «A return inside the body is not a step to the next turn»
    дано leaves равно [запись «Leaf» с «turns» равным [] и «value» равным "0" и «literal» равным да]
    ожидается 1
  длина (отфильтровать leaves где leaf → не ((leaf.«value») начинается с "(«@NEXT@»"))

функция «Cycled»
  принимает loop: «Node», others: список «Node», scope: список «Binding», turns: список «Turn», indent: строка
  возвращает «Flow»
  пример «A loop whose counter does not move is refused»
    дано loop равно вариант «Tree» с words равным ["Loop", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["IntegerLiteral", "0x1 'int' 1"] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["CompoundStmt", ""] и line равным 3 и kids равным []]
    дано others равно []
    дано scope равно []
    дано turns равно []
    дано indent равно "  "
    ожидается запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      "строка 3: цикл без выводимой меры: условие не сравнение"] и «helpers» равным [] и «leaves» равным []
  пусть line равно («Line» от loop)
  пусть count равно («Counted» от loop)
  пусть block равно («Kid» от 2 и loop)
  пусть carried равно («State names» от loop и scope)
  пусть written равно («Assigned names» от block)
  пусть scoped равно («Words» от («Rest» от loop))
  пусть touched равно (отфильтровать carried где name → «Holds» от name и written)
  пусть changed равно (отфильтровать touched где name → не («Holds» от name и scoped))
  пусть inner равно («Inner scope» от carried и scope)
  пусть following равно (вариант «Tree» с words равным ["Next",
    (соединить carried по " ")] и line равным line и kids равным пустой список)
  пусть body равно («Statements» от (добавить following к («Kids» от block)) и inner и пустой список и "      ")
  пусть condition равно («As truth» от («Expression» от («Kid» от 1 и loop) и inner))
  пусть measure равно («Measure» от count и inner)
  пусть prefix равно (соединить [(«Self name» от scope), " loop ", (к строке line)] по "")
  пусть parameters равно («State parameters» от carried и scope)
  пусть values равно (отобразить changed как name → «Value helper» от prefix и name и («Helper head» от (соединить [
    prefix, " ", name] по "") и parameters и "число" и measure) и («Body» от condition) и (body.«lines»))
  пусть numbered равно («Numbered duties» от («Turned duties» от (condition.«duties») и (body.«duties»)))
  пусть test равно («Pure» от condition)
  пусть ends равно (body.«leaves»)
  пусть checks равно (отобразить numbered как e → «Loop duty block» от prefix и parameters и measure и test и ends и e)
  пусть bodies равно (отобразить carried как name → «Current» от name и scope и нет)
  пусть pures равно (отобразить carried как name → «Current» от name и scope и да)
  пусть claims равно (отобразить numbered как each → «Loop duty claim» от prefix и pures и each и line)
  пусть g0 равно (запись «Grown» с «scope» равным scope и «lines» равным пустой список)
  пусть grown равно (свёртка changed начиная с g0 как m и n → «After loop» от m и n и prefix и bodies и pures и indent)
  пусть later равно («Statements» от others и (grown.«scope») и turns и indent)
  пусть lines равно («Соединить списки» от (grown.«lines») и (later.«lines»))
  пусть duties равно («Соединить списки» от («Under path» от turns и claims) и (later.«duties»))
  пусть refusals равно («Joined lists» от (condition.«refusals») и [(body.«refusals»), (later.«refusals»)])
  пусть helpers равно («Joined blocks» от [values, checks, (body.«helpers»), (later.«helpers»)])
  пусть made равно («Flow of» от lines и duties и refusals и helpers и (later.«leaves»))
  пусть place равно (соединить ["строка ", (к строке line), ": "] по "")
  пусть unmeasured равно («Refused flow» от (соединить [place, "цикл без выводимой меры: ", (count.«reason»)] по ""))
  пусть returning равно («Refused flow» от (соединить [place, "return внутри цикла вне подмножества"] по ""))
  «Chosen» от [(«When» от (не (пусто (count.«reason»))) и unmeasured),
    («When» от ((«Foreign leaves» от (body.«leaves»)) больше 0) и returning)] и made

тотальная функция «Joined blocks»
  принимает parts: список список список строки
  возвращает список список строки
  пример «Blocks of every part, once each»
    дано parts равно [[["a"]], [["a"], ["b"]]]
    ожидается [["a"], ["b"]]
  свёртка parts начиная с (пустой список) как made и part → «Blocks kept» от made и part

тотальная функция «Block kept»
  принимает kept: список список строки, block: список строки
  возвращает список список строки
  пример «A block seen before is not added again»
    дано kept равно [["a"]]
    дано block равно ["a"]
    ожидается [["a"]]
  пусть text равно (соединить block по "\n")
  пусть same равно (отфильтровать kept где other → (соединить other по "\n") равен text)
  если пусто same то (добавить block к kept) иначе kept

тотальная функция «Record name»
  принимает rest: строка
  возвращает строка
  пример «The tag of a structure»
    дано rest равно "0x1 <s.c:1:1, line:4:1> line:1:8 struct rect definition"
    ожидается "rect"
  «Cell» от 1 и («Words» от («Cell» от 2 и (разделить rest по " struct ")))

тотальная функция «Record of»
  принимает node: «Node»
  возвращает список «Binding»
  пример «A structure of int fields becomes a record»
    дано node равно вариант «Tree» с words равным ["RecordDecl",
      "0x1 <s.c:1:1, line:4:1> line:1:8 struct pt definition"] и line равным 1 и kids равным [
      вариант «Tree» с words равным ["FieldDecl",
      "0x2 <line:2:5, col:9> col:9 x 'int'"] и line равным 2 и kids равным [],
      вариант «Tree» с words равным ["FieldDecl",
      "0x3 <line:3:5, col:9> col:9 y 'int'"] и line равным 3 и kids равным []]
    ожидается [
      запись «Binding» с «kind» равным "record" и «name» равным "struct pt" и «body» равным "x y" и «pure» равным ""]
  пусть rest равно («Rest» от node)
  пусть fields равно («Of kind» от "FieldDecl" и («Kids» от node))
  пусть names равно (отобразить fields как each → «Declared name» от («Rest» от each))
  пусть odd равно (отфильтровать fields где each → не («Int typed» от each))
  пусть name равно («Record name» от rest)
  пусть filled равно ((не (пусто fields)) и притом (не (пусто name)))
  пусть whole равно ((rest содержит " definition") и притом ((пусто odd) и притом filled))
  если whole
    то [(«Bound» от "record" и (соединить ["struct ", name] по "") и (соединить names по " ") и "")]
    иначе пустой список

тотальная функция «Parameter kind»
  принимает parameter: «Node», known: список «Binding»
  возвращает строка
  пример «A structure passed by value whose fields are known»
    дано parameter равно вариант «Tree» с words равным ["ParmVarDecl",
      "0x1 <col:10, col:22> col:22 used r 'struct pt'"] и line равным 1 и kids равным []
    дано known равно [
      запись «Binding» с «kind» равным "record" и «name» равным "struct pt" и «body» равным "x y" и «pure» равным ""]
    ожидается "struct pt x y"
  пример «A pointer is not a parameter of the subset»
    дано parameter равно вариант «Tree» с words равным ["ParmVarDecl",
      "0x1 <col:10, col:22> col:22 used s 'char *'"] и line равным 1 и kids равным []
    дано known равно []
    ожидается ""
  пусть ctype равно («Cell» от 1 и («Quoted» от («Rest» от parameter)))
  пусть records равно (отфильтровать («Of binding kind» от "record" и known) где binding → (binding.«name») равен ctype)
  пусть fields равно (отобразить records как binding → binding.«body»)
  пусть shaped равно (если пусто fields то "" иначе (соединить [ctype, " ", («Cell» от 1 и fields)] по ""))
  если ctype равен "int" то "int" иначе shaped

тотальная функция «Parameter bound»
  принимает parameter: «Node», known: список «Binding»
  возвращает «Binding»
  пример «An int parameter is bound to its own name»
    дано parameter равно вариант «Tree» с words равным ["ParmVarDecl",
      "0x2 col:11 used a 'int'"] и line равным 1 и kids равным []
    дано known равно []
    ожидается запись «Binding» с «kind» равным "int" и «name» равным "a" и «body» равным "«a»" и «pure» равным "«a»"
  пусть name равно («Declared name» от («Rest» от parameter))
  пусть quoted равно (соединить ["«", name, "»"] по "")
  «Bound» от («Parameter kind» от parameter и known) и name и quoted и quoted

тотальная функция «Callees of»
  принимает node: «Node», known: список «Binding»
  возвращает список строки
  пример «Functions called that were translated above»
    дано node равно вариант «Tree» с words равным ["CallExpr", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["DeclRefExpr",
      "0x2 'int (int, int)' Function 0x3 'width' 'int (int, int)'"] и line равным 3 и kids равным []]
    дано known равно [
      запись «Binding» с «kind» равным "function" и «name» равным "width" и «body» равным "2" и «pure» равным ""]
    ожидается ["width"]
  пусть functions равно (отфильтровать («Targets» от node и "DeclRefExpr") где rest → rest содержит " Function ")
  пусть names равно («Distinct» от (отобразить functions как rest → «Cell» от 2 и («Quoted» от rest)))
  пусть bound равно (отобразить («Of binding kind» от "function" и known) как binding → binding.«name»)
  отфильтровать names где name → «Holds» от name и bound

функция «Function in»
  принимает node: «Node», known: список «Binding»
  возвращает «Function»
  пример «A pointer parameter is outside the subset»
    дано node равно вариант «Tree» с words равным ["FunctionDecl",
      "0x1 line:1:5 length 'int (char *)'"] и line равным 1 и kids равным [
      вариант «Tree» с words равным ["ParmVarDecl", "0x2 col:24 s 'char *'"] и line равным 1 и kids равным [],
      вариант «Tree» с words равным ["CompoundStmt", ""] и line равным 2 и kids равным []]
    дано known равно []
    ожидается запись «Function» с «name» равным "length" и «line» равным 1 и «parameters» равным [
      "s"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «helpers» равным [] и «leaves» равным []) и «literals» равным [] и «refusals» равным [
      "строка 1: функция «length»: сигнатура «int (char *)» вне подмножества"] и «support» равным [
      ] и «defined» равным да и «calls» равным [] и «types» равным [""]
  пусть rest равно («Rest» от node)
  пусть name равно («Declared name» от rest)
  пусть signature равно («Cell» от 1 и («Quoted» от rest))
  пусть parameters равно («Of kind» от "ParmVarDecl" и («Kids» от node))
  пусть bodies равно («Of kind» от "CompoundStmt" и («Kids» от node))
  пусть names равно (отобразить parameters как parameter → «Declared name» от («Rest» от parameter))
  пусть kinds равно (отобразить parameters как parameter → «Parameter kind» от parameter и known)
  пусть unknown равно (отфильтровать kinds где kind → пусто kind)
  пусть plain равно ((не (signature содержит "...")) и притом ((пусто unknown) и притом ((длина parameters) больше 0)))
  пусть fits равно ((signature начинается с "int (") и притом plain)
  пусть own равно (отобразить parameters как parameter → «Parameter bound» от parameter и known)
  пусть scope равно («Соединить списки» от own и (приписать («Bound» от "self" и name и "" и "") к known))
  пусть statements равно («Joined nodes» от (отобразить bodies как body → «Kids» от body))
  пусть flow равно (если fits то («Statements» от statements и scope и [] и "  ") иначе («Empty flow»))
  пусть place равно (соединить ["строка ", (к строке («Line» от node)), ": функция «", name, "»"] по "")
  пусть refusal равно (соединить [place, ": сигнатура «", signature, "» вне подмножества"] по "")
  пусть refusals равно (если fits то (flow.«refusals») иначе [refusal])
  «Function made» от node и flow и refusals и kinds и («Callees of» от node и known)

тотальная функция «Ok name»
  принимает translated: «Function»
  возвращает строка
  пример «A function without duties needs no check of its own»
    дано translated равно запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      "x"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «helpers» равным [] и «leaves» равным []) и «literals» равным [] и «refusals» равным [
      ] и «defined» равным да и «support» равным [] и «calls» равным [] и «types» равным []
    ожидается ""
  если пусто ((translated.«flow»).«duties») то "" иначе (соединить ["«", (translated.«name»), " ok»"] по "")

тотальная функция «Ok blocks»
  принимает translated: «Function»
  возвращает список список строки
  пример «The duties of a callee joined into one check»
    дано translated равно запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      "x"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [запись «Duty» с «words» равным ["d",
      "(«x» плюс 1) не больше 2147483647"] и «line» равным 2] и «refusals» равным [] и «helpers» равным [
      ] и «leaves» равным []) и «literals» равным [] и «refusals» равным [] и «defined» равным да и «support» равным [
      ] и «calls» равным [] и «types» равным ["int"]
    ожидается [
      ["тотальная функция «f ok»", "  принимает «x»: число", "  возвращает признак",
      "  (да) и притом ((«x» плюс 1) не больше 2147483647)"]]
  пусть claims равно («Duty claims» от ((translated.«flow»).«duties»))
  пусть parameters равно («Parameter text» от (translated.«parameters») и (translated.«types») и пустой список и да)
  пусть block равно [(соединить ["тотальная функция «", (translated.«name»), " ok»"] по ""),
    (соединить ["  принимает ", parameters] по ""), "  возвращает признак",
    (соединить ["  ", («Conjunction» от claims)] по "")]
  если пусто claims то пустой список иначе [block]

тотальная функция «Callee blocks»
  принимает callee: «Function»
  возвращает список список строки
  пример «A callee brings its own support, its plain text and its check»
    дано callee равно запись «Function» с «name» равным "g" и «line» равным 1 и «parameters» равным [
      "x"] и «flow» равным (запись «Flow» с «lines» равным ["  «x»"] и «duties» равным [] и «refusals» равным [
      ] и «helpers» равным [] и «leaves» равным []) и «literals» равным [] и «refusals» равным [
      ] и «defined» равным да и «support» равным [] и «calls» равным [] и «types» равным ["int"]
    ожидается [["тотальная функция «g»", "  принимает «x»: число", "  возвращает число", "  «x»"]]
  «Joined blocks» от [(callee.«support»), [(«Function text» от callee и пустой список и пустой список и да)],
    («Ok blocks» от callee)]

тотальная функция «Record block»
  принимает kind: строка
