  [(соединить ["  требует «", named, " — значение int, не ниже INT_MIN» ", read, " не меньше -2147483648"] по ""),
    (соединить ["  требует «", named, " — значение int, не выше INT_MAX» ", read, " не больше 2147483647"] по "")]

