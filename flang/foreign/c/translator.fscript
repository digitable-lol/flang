        "  обеспечивает «выведено 1» результат не меньше «x»", "  «x»"]
  пусть naturals равно («Natural» от (translated.«parameters») и claims)
  пусть ranges равно («Range lines» от (translated.«parameters») и naturals)
  пусть promised равно («Соединить списки» от («Of role» от "requires" и claims) и candidates)
  «Module text» от (соединить ["Выведено ", (translated.«name»)] по "") и [
    («Function text» от translated и ranges и promised и нет)]

тотальная функция «Call»
  принимает translated: «Function»
  возвращает строка
  пример «A call of the translated function by its parameters»
    дано translated равно запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным ["a",
      "b"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «leaves» равным []) и «literals» равным [] и «refusals» равным [] и «defined» равным да
    ожидается "(«f» от «a» и «b»)"
  пусть quoted равно (отобразить (translated.«parameters») как parameter → соединить ["«", parameter, "»"] по "")
  соединить ["(«", (translated.«name»), "» от ", (соединить quoted по " и "), ")"] по ""

тотальная функция «Predicate text»
  принимает translated: «Function», name: строка, body: строка
  возвращает список строки
  пример «A predicate over the same parameters»
    дано translated равно запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      "a"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «leaves» равным []) и «literals» равным [] и «refusals» равным [] и «defined» равным да
    дано name равно "f admissible"
    дано body равно "да"
    ожидается ["тотальная функция «f admissible»", "  принимает «a»: целое", "  возвращает признак", "  да"]
  пусть parameters равно («Parameter text» от (translated.«parameters») и пустой список и да)
  [(соединить ["тотальная функция «", name, "»"] по ""), (соединить ["  принимает ", parameters] по ""),
    "  возвращает признак", (соединить ["  ", body] по "")]

тотальная функция «With result»
  принимает text: строка, call: строка
  возвращает строка
  пример «The result of a claim is the call of the function»
    дано text равно "результат не меньше «lo»"
    дано call равно "(«midpoint» от «lo» и «hi»)"
    ожидается "(«midpoint» от «lo» и «hi») не меньше «lo»"
  соединить (разделить text по "результат") по call

тотальная функция «Conjunction»
  принимает claims: список «Claim»
  возвращает строка
  пример «Requirements joined»
    дано claims равно [запись «Claim» с «role» равным "requires" и «words» равным ["a", "«lo» не меньше 0", "человек"]]
    ожидается "(да) и притом («lo» не меньше 0)"
  свёртка claims начиная с "да" как joined и said → соединить ["(", joined, ") и притом (", («Claim text» от said),
    ")"] по ""

тотальная функция «Probe text»
  принимает translated: «Function», claims: список «Claim», checked: список «Claim»
  возвращает список список строки
  пример «The pure function, its admissibility and one predicate per claim»
    дано translated равно запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      "a"] и «flow» равным (запись «Flow» с «lines» равным ["  «a»"] и «duties» равным [] и «refusals» равным [
      ] и «leaves» равным []) и «literals» равным [] и «refusals» равным [] и «defined» равным да
    дано claims равно []
    дано checked равно [запись «Claim» с «role» равным "ensures" и «words» равным ["c", "результат не меньше 0",
      "человек"]]
    ожидается [["тотальная функция «f»", "  принимает «a»: целое", "  возвращает число", "  «a»"], [
      "тотальная функция «f admissible»", "  принимает «a»: целое", "  возвращает признак", "  да"], [
      "тотальная функция «f claim 1»", "  принимает «a»: целое", "  возвращает признак", "  («f» от «a») не меньше 0"]]
  пусть name равно (translated.«name»)
  пусть call равно («Call» от translated)
  пусть pure равно («Function text» от translated и пустой список и пустой список и да)
  пусть admissible равно («Predicate text» от translated и (соединить [name,
    " admissible"] по "") и («Conjunction» от («Of role» от "requires" и claims)))
  пусть numbered равно («Numbered claims of» от checked)
  пусть predicates равно (отобразить numbered как each → «Predicate text» от translated и (соединить [name, " claim ",
    (к строке (each.«at»))] по "") и («With result» от («Claim text» от (each.«it»)) и call))
  приписать pure к (приписать admissible к predicates)

тотальная функция «Without first» от «А»
  принимает items: список «А»
  возвращает список «А»
  пример «The tail of three»
    дано items равно ["a", "b", "c"]
    ожидается ["b", "c"]
  разбор items
    случай пусто
      то пустой список
    случай голова и хвост
      то хвост

тотальная функция «Least»
  принимает values: список строки
  возвращает строка
  пример «The least of literals»
    дано values равно ["3", "-1", "2"]
    ожидается "-1"
  разбор values
    случай пусто
      то ""
    случай голова и хвост
      то свёртка хвост начиная с голова как least и value → «Smaller» от least и value


тотальная функция «Greatest»
  принимает values: список строки
  возвращает строка
  пример «The greatest of literals»
    дано values равно ["3", "-1", "2"]
    ожидается "3"
  разбор values
    случай пусто
      то ""
    случай голова и хвост
      то свёртка хвост начиная с голова как greatest и value → «Larger» от greatest и value


тотальная функция «Candidate»
  принимает text: строка, origin: строка
  возвращает «Claim»
  пример «A candidate is a promise with its origin»
    дано text равно "результат не меньше 0"
    дано origin равно "знак результата"
    ожидается запись «Claim» с «role» равным "ensures" и «words» равным ["", "результат не меньше 0", "знак результата"]
  запись «Claim» с «role» равным "ensures" и «words» равным ["", text, origin]

тотальная функция «Candidates»
  принимает translated: «Function»
  возвращает список «Claim»
  пример «A function of one parameter that returns one of two literals»
    дано translated равно запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      "x"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «leaves» равным [запись «Leaf» с «turns» равным [
      запись «Turn» с «test» равным "c" и «taken» равным да] и «value» равным "1" и «literal» равным да,
      запись «Leaf» с «turns» равным [] и «value» равным "0" и «literal» равным да]) и «literals» равным [
      ] и «refusals» равным [] и «defined» равным да
    ожидается [запись «Claim» с «role» равным "ensures" и «words» равным ["выведено 1", "результат не меньше 0",
      "знак результата"], запись «Claim» с «role» равным "ensures" и «words» равным ["выведено 2",
      "результат не меньше «x»", "сравнение с параметром «x»"],
      запись «Claim» с «role» равным "ensures" и «words» равным ["выведено 3", "результат не больше «x»",
      "сравнение с параметром «x»"], запись «Claim» с «role» равным "ensures" и «words» равным ["выведено 4",
      "результат не меньше 0", "наименьшая константа return"],
      запись «Claim» с «role» равным "ensures" и «words» равным ["выведено 5", "результат не больше 1",
      "наибольшая константа return"], запись «Claim» с «role» равным "ensures" и «words» равным ["выведено 6",
      "если c то (результат равен 1) иначе да", "ветвь кода"]]
  пусть leaves равно ((translated.«flow»).«leaves»)
  пусть constants равно (отобразить (отфильтровать leaves где leaf → (leaf.«literal»)) как leaf → leaf.«value»)
  пусть bounded равно ((не (пусто leaves)) и притом ((длина constants) равен (длина leaves)))
  пусть signed равно [(«Candidate» от "результат не меньше 0" и "знак результата")]
  пусть parameters равно (translated.«parameters»)
  пусть compared равно («Joined claims» от (отобразить parameters как parameter → «Compared candidates» от parameter))
  пусть low равно («Candidate» от (соединить ["результат не меньше ",
    («Least» от constants)] по "") и "наименьшая константа return")
  пусть high равно («Candidate» от (соединить ["результат не больше ",
    («Greatest» от constants)] по "") и "наибольшая константа return")
  пусть bounds равно (если bounded то [low, high] иначе пустой список)
  пусть turned равно (отфильтровать leaves где leaf → не (пусто (leaf.«turns»)))
  пусть branches равно (отобразить turned как leaf → «Branch candidate» от leaf)
  пусть found равно («Joined claims» от [signed, compared, bounds, branches])
  свёртка found начиная с (пустой список) как named и said → «Candidate added» от named и said


тотальная функция «Last duty claim»
  принимает turns: список «Turn», wanted: строка
  возвращает строка
  пример «A claim under one turn»
    дано turns равно [запись «Turn» с «test» равным "(x больше 0)" и «taken» равным да]
    дано wanted равно "результат равен 1"
    ожидается "если (x больше 0) то (результат равен 1) иначе да"
  свёртка («Under path» от turns и [(запись «Duty» с «words» равным ["",
    wanted] и «line» равным 0)]) начиная с wanted как last и duty → «Duty claim» от duty

тотальная функция «Accepted»
  принимает functions: список «Function»
  возвращает список «Function»
  пример «A refused function is left out»
    дано functions равно [запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      "x"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «leaves» равным []) и «literals» равным [] и «refusals» равным ["нет"] и «defined» равным да]
    ожидается []
  отфильтровать functions где translated → пусто (translated.«refusals»)

тотальная функция «Targets»
  принимает node: «Node», wanted: строка
  возвращает список строки
  пример «The texts of every node of a kind, in the order of the source»
    дано node равно вариант «Tree» с words равным ["ReturnStmt", ""] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["IntegerLiteral", "0x1 'int' 30"] и line равным 3 и kids равным []]
    дано wanted равно "IntegerLiteral"
    ожидается ["0x1 'int' 30"]
  разбор node
    случай вариант «Tree» с words как words и line как line и kids как kids
      то «Joined lists» от («Own target» от words и wanted) и (отобразить kids как kid → «Targets» от kid и wanted)


тотальная функция «Shifted»
  принимает rest: строка
  возвращает строка
  пример «A literal one larger»
    дано rest равно "0x1 <col:18> 'int' 4"
    ожидается "0x1 <col:18> 'int' 5"
  пусть words равно («Words» от rest)
  если «Integer word» от («Last word» от words)
    то соединить («Соединить списки» от («Reversed» от («Without first» от («Reversed» от words))) и [
      (к строке ((к числу («Last word» от words)) плюс 1))]) по " "
    иначе rest

тотальная функция «Mutated»
  принимает node: «Node», target: строка
  возвращает «Node»
  пример «The chosen if loses its then branch and keeps its else branch»
    дано node равно вариант «Tree» с words равным ["IfStmt", "0x1 has_else"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["IntegerLiteral", "0x2 'int' 1"] и line равным 3 и kids равным [],
      вариант «Tree» с words равным ["NullStmt", "a"] и line равным 3 и kids равным [], вариант «Tree» с words равным [
      "NullStmt", "b"] и line равным 4 и kids равным []]
    дано target равно "0x1 has_else"
    ожидается вариант «Tree» с words равным ["NullStmt", "b"] и line равным 4 и kids равным []
  пример «The chosen literal grows by one»
    дано node равно вариант «Tree» с words равным ["IntegerLiteral", "0x2 'int' 1"] и line равным 3 и kids равным []
    дано target равно "0x2 'int' 1"
    ожидается вариант «Tree» с words равным ["IntegerLiteral", "0x2 'int' 2"] и line равным 3 и kids равным []
  разбор node
    случай вариант «Tree» с words как words и line как line и kids как kids
      то «Mutation of» от words и line и kids и (отобразить kids как kid → «Mutated» от kid и target) и target


тотальная функция «Without then»
  принимает rest: строка, line: число, kids: список «Node»
  возвращает «Node»
  пример «An if without else becomes an empty statement»
    дано rest равно "0x1"
    дано line равно 3
    дано kids равно []
    ожидается вариант «Tree» с words равным ["NullStmt", ""] и line равным 3 и kids равным []
  если (rest содержит "has_else") и притом ((длина kids) больше 2)
    то элемент 3 в kids
    иначе вариант «Tree» с words равным ["NullStmt", ""] и line равным line и kids равным пустой список

тотальная функция «Forgery places»
  принимает node: «Node», mode: строка
  возвращает список строки
  пример «Only operations where the order of operands matters»
    дано node равно вариант «Tree» с words равным ["BinaryOperator", "0x1 'int' '*'"] и line равным 3 и kids равным []
    дано mode равно "swap-operands"
    ожидается []
  пусть ordered равно ["-", "/", "%", "<", "<=", ">", ">="]
  пусть operations равно («Targets» от node и "BinaryOperator")
  разбор mode
    случай "drop-branch"
      то «Targets» от node и "IfStmt"
    случай "shift-constant"
      то «Targets» от node и "IntegerLiteral"
    случай любое
      то отфильтровать operations где rest → «Holds» от («Last word» от («Quoted» от rest)) и ordered


тотальная функция «Forgery target»
  принимает node: «Node», mode: строка
  возвращает строка
  пример «A forger that drops a branch picks the first if»
    дано node равно вариант «Tree» с words равным ["IfStmt", "0x1"] и line равным 3 и kids равным []
    дано mode равно "drop-branch"
    ожидается "0x1"
  пример «Nothing to forge»
    дано node равно вариант «Tree» с words равным ["ReturnStmt", "0x1"] и line равным 3 и kids равным []
    дано mode равно "shift-constant"
    ожидается ""
  пример «A forger that swaps operands skips the ones where order does not matter»
    дано node равно вариант «Tree» с words равным ["BinaryOperator", "0x1 'int' '+'"] и line равным 3 и kids равным [
      вариант «Tree» с words равным ["BinaryOperator", "0x2 'int' '-'"] и line равным 3 и kids равным []]
    дано mode равно "swap-operands"
    ожидается "0x2 'int' '-'"
  разбор («Forgery places» от node и mode)
    случай пусто
      то ""
    случай голова и хвост
      то голова

тотальная функция «Base values»
  возвращает список строки
  пример «The edges of int and a few small numbers»
    ожидается ["-2147483648", "-2147483647", "-1000", "-1", "0", "1", "2", "7", "1000", "1073741824", "2147483646",
      "2147483647"]
  ["-2147483648", "-2147483647", "-1000", "-1", "0", "1", "2", "7", "1000", "1073741824", "2147483646", "2147483647"]

тотальная функция «Few values»
  возвращает список строки
  пример «The edges of int and the smallest numbers»
    ожидается ["-2147483648", "-1", "0", "1", "2", "2147483647"]
  ["-2147483648", "-1", "0", "1", "2", "2147483647"]

тотальная функция «Integer word»
  принимает word: строка
  возвращает признак
  пример «A negative number»
    дано word равно "-12"
    ожидается да
  пример «A name»
    дано word равно "«lo»"
    ожидается нет
  («Digits» от word) или ((word начинается с "-") и притом («Digits» от (подстрока word с 2 по (длина word))))

тотальная функция «Neighbours»
  принимает numbers: список строки
  возвращает список строки
  пример «Each constant with the numbers right before and after it, inside int»
    дано numbers равно ["100", "2147483647"]
    ожидается ["99", "100", "101", "2147483646", "2147483647"]
  пусть near равно («Joined lists» от [] и (отобразить numbers как number → «Near number» от number))
  отфильтровать near где number → «In int» от number


тотальная функция «Distinct»
  принимает words: список строки
  возвращает список строки
  пример «Every word once, in the order of first sight»
    дано words равно ["1", "2", "1", "3"]
    ожидается ["1", "2", "3"]
  свёртка words начиная с (пустой список) как seen и word → «Seen once» от seen и word


тотальная функция «Claim numbers»
  принимает claims: список «Claim»
  возвращает список строки
  пример «Numbers written in claims enter the grid»
    дано claims равно [запись «Claim» с «role» равным "ensures" и «words» равным ["a",
      "если «month» равно 2 то результат не больше 29 иначе да", "человек"]]
    ожидается ["2", "29"]
  «Joined lists» от [] и (отобразить claims как said → «Numbers in» от («Claim text» от said))


тотальная функция «Product»
  принимает rows: список список строки, values: список строки
  возвращает список список строки
  пример «Every row grows by every value»
    дано rows равно [["1"], ["2"]]
    дано values равно ["a", "b"]
    ожидается [["1", "a"], ["1", "b"], ["2", "a"], ["2", "b"]]
  «Reversed» от (свёртка rows начиная с (пустой список) как grown и row → «Grown rows» от grown и row и values)


тотальная функция «Grid of»
  принимает translated: «Function», claims: список «Claim»
  возвращает список список строки
  пример «One parameter and one constant»
    дано translated равно запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      "x"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «leaves» равным []) и «literals» равным ["5"] и «refusals» равным [] и «defined» равным да
    дано claims равно []
    ожидается [["-2147483648"], ["-2147483647"], ["-1000"], ["-1"], ["0"], ["1"], ["2"], ["7"], ["1000"], [
      "1073741824"], ["2147483646"], ["2147483647"], ["4"], ["5"], ["6"]]
  пусть near равно («Neighbours» от («Соединить списки» от (translated.«literals») и («Claim numbers» от claims)))
  пусть wide равно («Distinct» от («Соединить списки» от («Base values») и near))
  пусть narrow равно («Distinct» от («Соединить списки» от («Few values») и near))
  пусть parameters равно (translated.«parameters»)
  пусть size равно (свёртка parameters начиная с 1 как total и parameter → total умножить на (длина wide))
  пусть values равно (если size больше 4000 то narrow иначе wide)
  свёртка parameters начиная с [пустой список] как rows и parameter → «Product» от rows и values


объект «Probe»
  «name»: строка
  «parameters»: список строки
  «inputs»: список список строки
  «checked»: список «Claim»

объект «Outcome»
  «arguments»: список строки
  «c»: строка
  «value»: строка
  «admissible»: признак
  «said»: список строки

тотальная функция «Harness text»
  принимает source: строка, probes: список «Probe»
  возвращает список строки
  пример «A harness calls each function in a child process and reports a trap as undefined»
    дано source равно "ranges.c"
    дано probes равно [запись «Probe» с «name» равным "midpoint" и «parameters» равным ["lo", "hi"] и «inputs» равным [
      ] и «checked» равным []]
    ожидается ["#define _POSIX_C_SOURCE 200809L", "#include <stdio.h>", "#include <string.h>", "#include <unistd.h>",
      "#include <sys/wait.h>", "#include \"ranges.c\"", "static int call(const char *f, const long *a) {",
      "  if (strcmp(f, \"midpoint\") == 0) return midpoint((int)a[0], (int)a[1]);", "  return 0;", "}",
      "int main(void) {", "  char f[256];", "  long a[4];",
      "  while (scanf(\"%255s %ld %ld %ld %ld\", f, &a[0], &a[1], &a[2], &a[3]) == 5) {", "    fflush(stdout);",
      "    pid_t p = fork();", "    if (p == 0) { printf(\"ok %d\\n\", call(f, a)); fflush(stdout); _exit(0); }",
      "    int s = 0;", "    waitpid(p, &s, 0);", "    if (!(WIFEXITED(s) && WEXITSTATUS(s) == 0)) printf(\"ub\\n\");",
      "    fflush(stdout);", "  }", "  return 0;", "}"]
  пусть head равно ["#define _POSIX_C_SOURCE 200809L", "#include <stdio.h>", "#include <string.h>",
    "#include <unistd.h>", "#include <sys/wait.h>", (соединить ["#include \"", source, "\""] по ""),
    "static int call(const char *f, const long *a) {"]
  пусть calls равно (отобразить probes как probe → «Call line» от probe)
  пусть scan равно "  while (scanf(\"%255s %ld %ld %ld %ld\", f, &a[0], &a[1], &a[2], &a[3]) == 5) {"
  пусть child равно "    if (p == 0) { printf(\"ok %d\\n\", call(f, a)); fflush(stdout); _exit(0); }"
  пусть trapped равно "    if (!(WIFEXITED(s) && WEXITSTATUS(s) == 0)) printf(\"ub\\n\");"
  пусть tail равно ["  return 0;", "}", "int main(void) {", "  char f[256];", "  long a[4];", scan,
    "    fflush(stdout);", "    pid_t p = fork();", child, "    int s = 0;", "    waitpid(p, &s, 0);", trapped,
    "    fflush(stdout);", "  }", "  return 0;", "}"]
  «Joined lists» от head и [calls, tail]


тотальная функция «Padded»
  принимает arguments: список строки
  возвращает список строки
  пример «Four numbers for the harness»
    дано arguments равно ["5", "7"]
    ожидается ["5", "7", "0", "0"]
  свёртка ["0", "0", "0",
    "0"] начиная с arguments как padded и zero → если (длина padded) меньше 4 то (добавить zero к padded) иначе padded

тотальная функция «Harness input»
  принимает probe: «Probe»
  возвращает строка
  пример «One line per input»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [["-1"], [
      "2"]] и «checked» равным []
    ожидается "sign -1 0 0 0\nsign 2 0 0 0\n"
  соединить (отобразить (probe.«inputs») как arguments → соединить [(probe.«name»), " ",
    (соединить («Padded» от arguments) по " "), "\n"] по "") по ""

тотальная функция «Request»
  принимает called: строка, arguments: список строки
  возвращает строка
  пример «A request of the printed runner»
    дано called равно "sign claim 1"
    дано arguments равно ["-1"]
    ожидается "{\"fn\":\"sign claim 1\",\"args\":[{\"n\":\"-1\"}]}\n"
  соединить ["{\"fn\":\"", called, "\",\"args\":[", (соединить (отобразить arguments как argument → соединить [
    "{\"n\":\"", argument, "\"}"] по "") по ","), "]}\n"] по ""

тотальная функция «Called names»
  принимает probe: «Probe»
  возвращает список строки
  пример «The value, the admissibility, then each claim»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [
      ] и «checked» равным [запись «Claim» с «role» равным "ensures" и «words» равным ["a", "да", "человек"]]
    ожидается ["sign", "sign admissible", "sign claim 1"]
  свёртка (probe.«checked») начиная с [(probe.«name»), (соединить [(probe.«name»),
    " admissible"] по "")] как names и said → добавить (соединить [(probe.«name»), " claim ",
    (к строке ((длина names) минус 1))] по "") к names

тотальная функция «Requests»
  принимает probe: «Probe», names: список строки
  возвращает строка
  пример «Every name for every input»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [[
      "0"]] и «checked» равным []
    дано names равно ["sign", "sign admissible"]
    ожидается "{\"fn\":\"sign\",\"args\":[{\"n\":\"0\"}]}\n{\"fn\":\"sign admissible\",\"args\":[{\"n\":\"0\"}]}\n"
  соединить (отобразить (probe.«inputs») как arguments → «Requests of input» от names и arguments) по ""


тотальная функция «Between»
  принимает start: строка, stop: строка, text: строка
  возвращает строка
  пример «The text between two marks»
    дано start равно "{\"n\":\""
    дано stop равно "\""
    дано text равно "{\"ok\":true,\"value\":{\"n\":\"-4\"}}"
    ожидается "-4"
  пусть pieces равно (разделить text по start)
  если (длина pieces) больше 1 то («Cell» от 1 и (разделить (элемент 2 в pieces) по stop)) иначе ""

тотальная функция «Reply value»
  принимает line: строка
  возвращает строка
  пример «A number»
    дано line равно "{\"ok\":true,\"value\":{\"n\":\"-0\"}}"
    ожидается "0"
  пример «A truth»
    дано line равно "{\"ok\":true,\"value\":false}"
    ожидается "нет"
  пример «A refusal»
    дано line равно "{\"ok\":false,\"code\":\"FLANG_TYPE\",\"message\":\"x\"}"
    ожидается "отказ"
  пусть number равно («Between» от "{\"n\":\"" и "\"" и line)
  пусть rules равно [(«When» от (не (line содержит "\"ok\":true")) и "отказ"),
    («When» от (line содержит "\"value\":true") и "да"), («When» от (line содержит "\"value\":false") и "нет"),
    («When» от (number равен "-0") и "0")]
  «Chosen» от rules и number


объект «Chunking»
  «open»: список строки
  «done»: список список строки

тотальная функция «Chunks»
  принимает lines: список строки, size: число
  возвращает список список строки
  пример «Lines cut into groups of a size»
    дано lines равно ["a", "b", "c", "d"]
    дано size равно 2
    ожидается [["a", "b"], ["c", "d"]]
  пусть start равно (запись «Chunking» с «open» равным пустой список и «done» равным пустой список)
  «Reversed» от ((свёртка lines начиная с start как cut и line → «Cut» от cut и line и size).«done»)


тотальная функция «Outcomes»
  принимает probe: «Probe», c: строка, replies: строка, size: число
  возвращает список «Outcome»
  пример «An input, what C did and what the printed translation said»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [[
      "0"]] и «checked» равным []
    дано c равно "ok 0\n"
    дано replies равно "{\"ok\":true,\"value\":{\"n\":\"0\"}}\n{\"ok\":true,\"value\":true}\n"
    дано size равно 2
    ожидается [запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ok 0" и «value» равным "0" и «admissible» равным да и «said» равным []]
  пусть cs равно («Lines» от c)
  пусть groups равно («Chunks» от (отобразить («Lines» от replies) как line → «Reply value» от line) и size)
  пусть made равно («Outcomes made» от (probe.«inputs») и cs и groups)
  «Reversed» от made


тотальная функция «Outcome of»
  принимает arguments: список строки, c: строка, group: список строки
  возвращает «Outcome»
  пример «A group without replies is not admissible»
    дано arguments равно ["1"]
    дано c равно "ok 1"
    дано group равно []
    ожидается запись «Outcome» с «arguments» равным [
      "1"] и «c» равным "ok 1" и «value» равным "" и «admissible» равным нет и «said» равным []
  пусть admissible равно (((длина group) равен 1) или ((«Cell» от 2 и group) равен "да"))
  пусть said равно («Without first» от («Without first» от group))
  пусть value равно («Cell» от 1 и group)
  запись «Outcome» с «arguments» равным («Соединить списки» от arguments и [
    ]) и «c» равным c и «value» равным value и «admissible» равным admissible и «said» равным said


объект «Mark»
  «claim»: «Claim»
  «said»: строка

тотальная функция «Paired»
  принимает probe: «Probe», outcome: «Outcome»
  возвращает список «Mark»
  пример «Each claim with what the printed translation said about it on this input»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [
      ] и «checked» равным [запись «Claim» с «role» равным "ensures" и «words» равным ["a", "да", "человек"]]
    дано outcome равно запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ok 0" и «value» равным "0" и «admissible» равным да и «said» равным ["нет"]
    ожидается [запись «Mark» с «claim» равным (запись «Claim» с «role» равным "ensures" и «words» равным ["a", "да",
      "человек"]) и «said» равным "нет"]
  пусть said равно (outcome.«said»)
  свёртка (probe.«checked») начиная с (пустой список) как marks и stated → «Mark added» от marks и stated и said


тотальная функция «Undefined»
  принимает probe: «Probe», outcome: «Outcome»
  возвращает признак
  пример «A broken duty means C is undefined on this input»
    дано probe равно запись «Probe» с «name» равным "f" и «parameters» равным ["x"] и «inputs» равным [
      ] и «checked» равным [запись «Claim» с «role» равным "ensures" и «words» равным ["d", "да", "обязательство C"]]
    дано outcome равно запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ub" и «value» равным "0" и «admissible» равным да и «said» равным ["нет"]
    ожидается да
  пусть broken равно (отфильтровать («Paired» от probe и outcome) где mark → «Broken duty» от mark)
  не (пусто broken)


тотальная функция «Class»
  принимает probe: «Probe», outcome: «Outcome», value: строка
  возвращает строка
  пример «C and the printed translation agree»
    дано probe равно запись «Probe» с «name» равным "f" и «parameters» равным ["x"] и «inputs» равным [
      ] и «checked» равным []
    дано outcome равно запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ok 4" и «value» равным "4" и «admissible» равным да и «said» равным []
    дано value равно "4"
    ожидается "сошлось"
  пример «A forged constant»
    дано probe равно запись «Probe» с «name» равным "f" и «parameters» равным ["x"] и «inputs» равным [
      ] и «checked» равным []
    дано outcome равно запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ok 4" и «value» равным "4" и «admissible» равным да и «said» равным []
    дано value равно "5"
    ожидается "РАЗОШЛОСЬ"
  пусть undefined равно («Undefined» от probe и outcome)
  пусть trapped равно ((outcome.«c») равен "ub")
  «Chosen» от [(«When» от (не (outcome.«admissible»)) и "вне требований"),
    («When» от (trapped и притом undefined) и "UB у C, названо обязательством"),
    («When» от trapped и "UB у C, обязательства молчат"),
    («When» от undefined и "обязательство нарушено, C вернул значение"),
    («When» от ((«After» от "ok " и (outcome.«c»)) равен value) и "сошлось")] и "РАЗОШЛОСЬ"

тотальная функция «Wrong class»
  принимает class: строка
  возвращает признак
  пример «A silent trap is wrong»
    дано class равно "UB у C, обязательства молчат"
    ожидается да
  (class равен "РАЗОШЛОСЬ") или (class равен "UB у C, обязательства молчат")

тотальная функция «Arguments text»
  принимает parameters: список строки, arguments: список строки
  возвращает строка
  пример «Names with values»
    дано parameters равно ["lo", "hi"]
    дано arguments равно ["1", "2"]
    ожидается "lo = 1, hi = 2"
  соединить («Without first» от (свёртка parameters начиная с [""] как made и parameter → добавить (соединить [
    parameter, " = ", («Cell» от (длина made) и arguments)] по "") к made)) по ", "

тотальная функция «Arguments json»
  принимает parameters: список строки, arguments: список строки
  возвращает строка
  пример «Arguments for flang run»
    дано parameters равно ["lo", "hi"]
    дано arguments равно ["1", "2"]
    ожидается "{\"lo\": 1, \"hi\": 2}"
  соединить ["{", (соединить («Without first» от (свёртка parameters начиная с [
    ""] как made и parameter → добавить (соединить ["\"", parameter, "\": ",
    («Cell» от (длина made) и arguments)] по "") к made)) по ", "), "}"] по ""

тотальная функция «Kernel word»
  принимает output: строка, owner: строка, name: строка
  возвращает строка
  пример «A proved promise»
    дано output равно "  постусловие «a» функции «f» — доказано правилом\n"
    дано owner равно "f"
    дано name равно "a"
    ожидается "доказано ядром"
  пример «A promise the kernel could not prove»
    дано output равно "  постусловие «a» функции «f» — объявлено, не доказано\n"
    дано owner равно "f"
    дано name равно "a"
    ожидается "не доказано ядром"
  пусть mark равно (соединить ["  постусловие «", name, "» функции «", owner, "» — "] по "")
  пусть line равно («Beginning with» от mark и («Lines» от output))
  пусть refuted равно (не (пусто (отфильтровать («Lines» от output) где text → (text содержит (соединить ["«", name,
    "»"] по "")) и притом (text содержит "ЛОЖНО"))))
  «Chosen» от [(«When» от refuted и "ядро опровергло"), («When» от (пусто line) и "ядро не судило"),
    («When» от ((«After» от mark и line) начинается с "доказано") и "доказано ядром")] и "не доказано ядром"

тотальная функция «Under turn»
  принимает turn: «Turn», duties: список «Duty»
  возвращает список «Duty»
  пример «One turn wraps a duty»
    дано turn равно запись «Turn» с «test» равным "(x больше hi)" и «taken» равным да
    дано duties равно [запись «Duty» с «words» равным ["d", "нет"] и «line» равным 9]
    ожидается [запись «Duty» с «words» равным ["d", "если (x больше hi) то (нет) иначе да"] и «line» равным 9]
  «Under» от (turn.«test») и (turn.«taken») и duties

