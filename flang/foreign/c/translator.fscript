тотальная функция «Product»
  принимает rows: список список строки, values: список строки
  возвращает список список строки
  пример «Every row grows by every value»
    дано rows равно [["1"], ["2"]]
    дано values равно ["a", "b"]
    ожидается [["1", "a"], ["1", "b"], ["2", "a"], ["2", "b"]]
  «Reversed» от (свёртка rows начиная с (пустой список) как grown и row → «Grown rows» от grown и row и values)


тотальная функция «Grid of»
  принимает translated: «Function», claims: список «Claim»
  возвращает список список строки
  пример «One parameter and one constant»
    дано translated равно запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      "x"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «helpers» равным [] и «leaves» равным []) и «literals» равным ["5"] и «refusals» равным [
      ] и «defined» равным да и «support» равным [] и «calls» равным [] и «types» равным []
    дано claims равно []
    ожидается [["-2147483648"], ["-2147483647"], ["-1000"], ["-1"], ["0"], ["1"], ["2"], ["7"], ["1000"],
      ["1073741824"], ["2147483646"], ["2147483647"], ["4"], ["5"], ["6"]]
  пример «A loop keeps the grid small enough to walk»
    дано translated равно запись «Function» с «name» равным "f" и «line» равным 1 и «parameters» равным [
      "x"] и «flow» равным (запись «Flow» с «lines» равным [] и «duties» равным [] и «refusals» равным [
      ] и «helpers» равным [] и «leaves» равным []) и «literals» равным ["5"] и «refusals» равным [
      ] и «defined» равным да и «support» равным [["тотальная функция «f loop 3 x»"]] и «calls» равным [
      ] и «types» равным []
    дано claims равно []
    ожидается [["-1000"], ["-1"], ["0"], ["1"], ["2"], ["7"], ["1000"], ["4"], ["5"], ["6"]]
  пусть near равно («Neighbours» от («Соединить списки» от (translated.«literals») и («Claim numbers» от claims)))
  пусть looping равно («Looping» от translated)
  пусть wide равно («Distinct» от («Соединить списки» от («Base values») и near))
  пусть narrow равно («Distinct» от («Соединить списки» от («Few values») и near))
  пусть parameters равно («Flat names» от (translated.«parameters») и (translated.«types»))
  пусть size равно (свёртка parameters начиная с 1 как total и parameter → total умножить на (длина wide))
  пусть chosen равно (если size больше 4000 то narrow иначе wide)
  пусть values равно (если looping то (отфильтровать chosen где word → «Small» от word) иначе chosen)
  свёртка parameters начиная с [пустой список] как rows и parameter → «Product» от rows и values


объект «Probe»
  «name»: строка
  «parameters»: список строки
  «inputs»: список список строки
  «shapes»: список строки
  «checked»: список «Claim»

объект «Outcome»
  «arguments»: список строки
  «c»: строка
  «value»: строка
  «admissible»: признак
  «said»: список строки

тотальная функция «Harness text»
  принимает source: строка, probes: список «Probe»
  возвращает список строки
  пример «A harness calls each function in a child process and reports a trap as undefined»
    дано source равно "ranges.c"
    дано probes равно [запись «Probe» с «name» равным "midpoint" и «parameters» равным ["lo", "hi"] и «inputs» равным [
      ] и «shapes» равным [] и «checked» равным []]
    ожидается ["#define _POSIX_C_SOURCE 200809L", "#include <stdio.h>", "#include <string.h>", "#include <unistd.h>",
      "#include <sys/wait.h>", "#include \"ranges.c\"", "static int call(const char *f, const long *a) {",
        "  if (strcmp(f, \"midpoint\") == 0) return midpoint((int)a[0], (int)a[1]);", "  return 0;", "}",
        "int main(void) {", "  char f[256];", "  long a[8];",
        "  while (scanf(\"%255s %ld %ld %ld %ld %ld %ld %ld %ld\", f, &a[0], &a[1], &a[2], &a[3],",
        "      &a[4], &a[5], &a[6], &a[7]) == 9) {", "    fflush(stdout);", "    pid_t p = fork();",
        "    if (p == 0) { printf(\"ok %d\\n\", call(f, a)); fflush(stdout); _exit(0); }", "    int s = 0;",
        "    waitpid(p, &s, 0);", "    if (!(WIFEXITED(s) && WEXITSTATUS(s) == 0)) printf(\"ub\\n\");",
        "    fflush(stdout);", "  }", "  return 0;", "}"]
  пусть head равно ["#define _POSIX_C_SOURCE 200809L", "#include <stdio.h>", "#include <string.h>",
    "#include <unistd.h>", "#include <sys/wait.h>", (соединить ["#include \"", source, "\""] по ""),
    "static int call(const char *f, const long *a) {"]
  пусть calls равно (отобразить probes как probe → «Call line» от probe)
  пусть scan равно "  while (scanf(\"%255s %ld %ld %ld %ld %ld %ld %ld %ld\", f, &a[0], &a[1], &a[2], &a[3],"
  пусть more равно "      &a[4], &a[5], &a[6], &a[7]) == 9) {"
  пусть child равно "    if (p == 0) { printf(\"ok %d\\n\", call(f, a)); fflush(stdout); _exit(0); }"
  пусть trapped равно "    if (!(WIFEXITED(s) && WEXITSTATUS(s) == 0)) printf(\"ub\\n\");"
  пусть tail равно ["  return 0;", "}", "int main(void) {", "  char f[256];", "  long a[8];", scan, more,
    "    fflush(stdout);", "    pid_t p = fork();", child, "    int s = 0;", "    waitpid(p, &s, 0);", trapped,
    "    fflush(stdout);", "  }", "  return 0;", "}"]
  «Joined lists» от head и [calls, tail]


тотальная функция «Padded»
  принимает arguments: список строки
  возвращает список строки
  пример «Eight numbers for the harness»
    дано arguments равно ["5", "7"]
    ожидается ["5", "7", "0", "0", "0", "0", "0", "0"]
  свёртка ["0", "0", "0", "0", "0", "0", "0",
    "0"] начиная с arguments как padded и zero → если (длина padded) меньше 8 то (добавить zero к padded) иначе padded

тотальная функция «Harness input»
  принимает probe: «Probe»
  возвращает строка
  пример «One line per input»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [["-1"], [
      "2"]] и «shapes» равным [] и «checked» равным []
    ожидается "sign -1 0 0 0 0 0 0 0\nsign 2 0 0 0 0 0 0 0\n"
  соединить (отобразить (probe.«inputs») как arguments → соединить [(probe.«name»), " ",
    (соединить («Padded» от arguments) по " "), "\n"] по "") по ""

тотальная функция «Request»
  принимает called: строка, values: список строки
  возвращает строка
  пример «A request of the printed runner»
    дано called равно "sign claim 1"
    дано values равно ["{\"n\":\"-1\"}"]
    ожидается "{\"fn\":\"sign claim 1\",\"args\":[{\"n\":\"-1\"}]}\n"
  соединить ["{\"fn\":\"", called, "\",\"args\":[", (соединить values по ","), "]}\n"] по ""

тотальная функция «Called names»
  принимает probe: «Probe»
  возвращает список строки
  пример «The value, the admissibility, then each claim»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [
      ] и «shapes» равным [] и «checked» равным [
        запись «Claim» с «role» равным "ensures" и «words» равным ["a", "да", "человек"]]
    ожидается ["sign", "sign admissible", "sign claim 1"]
  свёртка (probe.«checked») начиная с [(probe.«name»), (соединить [(probe.«name»),
    " admissible"] по "")] как names и said → добавить (соединить [(probe.«name»), " claim ",
    (к строке ((длина names) минус 1))] по "") к names

тотальная функция «Requests»
  принимает probe: «Probe», names: список строки
  возвращает строка
  пример «Every name for every input»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [[
      "0"]] и «shapes» равным [] и «checked» равным []
    дано names равно ["sign", "sign admissible"]
    ожидается "{\"fn\":\"sign\",\"args\":[{\"n\":\"0\"}]}\n{\"fn\":\"sign admissible\",\"args\":[{\"n\":\"0\"}]}\n"
  пусть shapes равно («Shapes of» от probe)
  пусть valued равно (отобразить (probe.«inputs») как arguments → «Argument values» от shapes и arguments)
  соединить (отобразить valued как values → «Requests of input» от names и values) по ""


тотальная функция «Between»
  принимает start: строка, stop: строка, text: строка
  возвращает строка
  пример «The text between two marks»
    дано start равно "{\"n\":\""
    дано stop равно "\""
    дано text равно "{\"ok\":true,\"value\":{\"n\":\"-4\"}}"
    ожидается "-4"
  пусть pieces равно (разделить text по start)
  если (длина pieces) больше 1 то («Cell» от 1 и (разделить (элемент 2 в pieces) по stop)) иначе ""

тотальная функция «Reply value»
  принимает line: строка
  возвращает строка
  пример «A number»
    дано line равно "{\"ok\":true,\"value\":{\"n\":\"-0\"}}"
    ожидается "0"
  пример «A truth»
    дано line равно "{\"ok\":true,\"value\":false}"
    ожидается "нет"
  пример «A refusal»
    дано line равно "{\"ok\":false,\"code\":\"FLANG_TYPE\",\"message\":\"x\"}"
    ожидается "отказ"
  пусть number равно («Between» от "{\"n\":\"" и "\"" и line)
  пусть rules равно [(«When» от (не (line содержит "\"ok\":true")) и "отказ"),
    («When» от (line содержит "\"value\":true") и "да"), («When» от (line содержит "\"value\":false") и "нет"),
    («When» от (number равен "-0") и "0")]
  «Chosen» от rules и number


объект «Chunking»
  «open»: список строки
  «done»: список список строки

тотальная функция «Chunks»
  принимает lines: список строки, size: число
  возвращает список список строки
  пример «Lines cut into groups of a size»
    дано lines равно ["a", "b", "c", "d"]
    дано size равно 2
    ожидается [["a", "b"], ["c", "d"]]
  пусть start равно (запись «Chunking» с «open» равным пустой список и «done» равным пустой список)
  «Reversed» от ((свёртка lines начиная с start как cut и line → «Cut» от cut и line и size).«done»)


тотальная функция «Outcomes»
  принимает probe: «Probe», c: строка, replies: строка, size: число
  возвращает список «Outcome»
  пример «An input, what C did and what the printed translation said»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [[
      "0"]] и «shapes» равным [] и «checked» равным []
    дано c равно "ok 0\n"
    дано replies равно "{\"ok\":true,\"value\":{\"n\":\"0\"}}\n{\"ok\":true,\"value\":true}\n"
    дано size равно 2
    ожидается [запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ok 0" и «value» равным "0" и «admissible» равным да и «said» равным []]
  пусть cs равно («Lines» от c)
  пусть groups равно («Chunks» от (отобразить («Lines» от replies) как line → «Reply value» от line) и size)
  пусть made равно («Outcomes made» от (probe.«inputs») и cs и groups)
  «Reversed» от made


тотальная функция «Outcome of»
  принимает arguments: список строки, c: строка, group: список строки
  возвращает «Outcome»
  пример «A group without replies is not admissible»
    дано arguments равно ["1"]
    дано c равно "ok 1"
    дано group равно []
    ожидается запись «Outcome» с «arguments» равным [
      "1"] и «c» равным "ok 1" и «value» равным "" и «admissible» равным нет и «said» равным []
  пусть admissible равно (((длина group) равен 1) или ((«Cell» от 2 и group) равен "да"))
  пусть said равно («Without first» от («Without first» от group))
  пусть value равно («Cell» от 1 и group)
  запись «Outcome» с «arguments» равным («Соединить списки» от arguments и [
    ]) и «c» равным c и «value» равным value и «admissible» равным admissible и «said» равным said


объект «Mark»
  «claim»: «Claim»
  «said»: строка

тотальная функция «Paired»
  принимает probe: «Probe», outcome: «Outcome»
  возвращает список «Mark»
  пример «Each claim with what the printed translation said about it on this input»
    дано probe равно запись «Probe» с «name» равным "sign" и «parameters» равным ["x"] и «inputs» равным [
      ] и «shapes» равным [] и «checked» равным [
        запись «Claim» с «role» равным "ensures" и «words» равным ["a", "да", "человек"]]
    дано outcome равно запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ok 0" и «value» равным "0" и «admissible» равным да и «said» равным ["нет"]
    ожидается [запись «Mark» с «claim» равным (запись «Claim» с «role» равным "ensures" и «words» равным ["a", "да",
      "человек"]) и «said» равным "нет"]
  пусть said равно (outcome.«said»)
  свёртка (probe.«checked») начиная с (пустой список) как marks и stated → «Mark added» от marks и stated и said


тотальная функция «Undefined»
  принимает probe: «Probe», outcome: «Outcome»
  возвращает признак
  пример «A broken duty means C is undefined on this input»
    дано probe равно запись «Probe» с «name» равным "f" и «parameters» равным ["x"] и «inputs» равным [
      ] и «shapes» равным [] и «checked» равным [
        запись «Claim» с «role» равным "ensures" и «words» равным ["d", "да", "обязательство C"]]
    дано outcome равно запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ub" и «value» равным "0" и «admissible» равным да и «said» равным ["нет"]
    ожидается да
  пусть broken равно (отфильтровать («Paired» от probe и outcome) где mark → «Broken duty» от mark)
  не (пусто broken)


тотальная функция «Class»
  принимает probe: «Probe», outcome: «Outcome», value: строка
  возвращает строка
  пример «C and the printed translation agree»
    дано probe равно запись «Probe» с «name» равным "f" и «parameters» равным ["x"] и «inputs» равным [
      ] и «shapes» равным [] и «checked» равным []
    дано outcome равно запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ok 4" и «value» равным "4" и «admissible» равным да и «said» равным []
    дано value равно "4"
    ожидается "сошлось"
  пример «A forged constant»
    дано probe равно запись «Probe» с «name» равным "f" и «parameters» равным ["x"] и «inputs» равным [
      ] и «shapes» равным [] и «checked» равным []
    дано outcome равно запись «Outcome» с «arguments» равным [
      "0"] и «c» равным "ok 4" и «value» равным "4" и «admissible» равным да и «said» равным []
    дано value равно "5"
    ожидается "РАЗОШЛОСЬ"
  пусть undefined равно («Undefined» от probe и outcome)
  пусть trapped равно ((outcome.«c») равен "ub")
  «Chosen» от [(«When» от (не (outcome.«admissible»)) и "вне требований"),
    («When» от (trapped и притом undefined) и "UB у C, названо обязательством"),
    («When» от trapped и "UB у C, обязательства молчат"),
    («When» от undefined и "обязательство нарушено, C вернул значение"),
    («When» от ((«After» от "ok " и (outcome.«c»)) равен value) и "сошлось")] и "РАЗОШЛОСЬ"

тотальная функция «Wrong class»
  принимает class: строка
  возвращает признак
  пример «A silent trap is wrong»
    дано class равно "UB у C, обязательства молчат"
    ожидается да
  (class равен "РАЗОШЛОСЬ") или (class равен "UB у C, обязательства молчат")

тотальная функция «Arguments text»
  принимает parameters: список строки, arguments: список строки
  возвращает строка
  пример «Names with values»
    дано parameters равно ["lo", "hi"]
    дано arguments равно ["1", "2"]
    ожидается "lo = 1, hi = 2"
  соединить («Without first» от (свёртка parameters начиная с [""] как made и parameter → добавить (соединить [
    parameter, " = ", («Cell» от (длина made) и arguments)] по "") к made)) по ", "

тотальная функция «Arguments json»
  принимает parameters: список строки, arguments: список строки
  возвращает строка
  пример «Arguments for flang run»
    дано parameters равно ["lo", "hi"]
    дано arguments равно ["1", "2"]
    ожидается "{\"lo\": 1, \"hi\": 2}"
  соединить ["{", (соединить («Without first» от (свёртка parameters начиная с [
    ""] как made и parameter → добавить (соединить ["\"", parameter, "\": ",
    («Cell» от (длина made) и arguments)] по "") к made)) по ", "), "}"] по ""

тотальная функция «Kernel word»
  принимает output: строка, owner: строка, name: строка
  возвращает строка
  пример «A proved promise»
    дано output равно "  постусловие «a» функции «f» — доказано правилом\n"
    дано owner равно "f"
    дано name равно "a"
    ожидается "доказано ядром"
  пример «A promise the kernel could not prove»
    дано output равно "  постусловие «a» функции «f» — объявлено, не доказано\n"
    дано owner равно "f"
    дано name равно "a"
    ожидается "не доказано ядром"
  пусть mark равно (соединить ["  постусловие «", name, "» функции «", owner, "» — "] по "")
  пусть line равно («Beginning with» от mark и («Lines» от output))
  пусть refuted равно (не (пусто (отфильтровать («Lines» от output) где text → (text содержит (соединить ["«", name,
    "»"] по "")) и притом (text содержит "ЛОЖНО"))))
  «Chosen» от [(«When» от refuted и "ядро опровергло"), («When» от (пусто line) и "ядро не судило"),
    («When» от ((«After» от mark и line) начинается с "доказано") и "доказано ядром")] и "не доказано ядром"

тотальная функция «Under turn»
  принимает turn: «Turn», duties: список «Duty»
  возвращает список «Duty»
