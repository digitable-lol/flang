import Goals

open «Разбор»

namespace «Второй»

/-!
# Законы ядра о цели: ход «закон» (ADR-0220)

Ход `ход N закон «Имя»` заменяет первую цель посылками закона (`«законЦели»`). Ход
состоятелен, если каждый закон списка верен в языке: из верности посылок следует цель.
Законы — поля `«ЗаконыЦели»`, посылки теоремы, а не аксиомы Lean, как законы толкования
(`Goals.lean`, ADR-0202). Каждое поле говорит о формуле той формы, которую закон берёт, и
читает её разрезами текста, как сам сверщик.

Три закона верны, только когда сравнение — корень формулы (`«кореньСравнения»`): у
`не -1 плюс 5 не меньше 0` разрез по `не меньше` даёт посылки `не -1 не меньше 0` и
`5 не меньше 0`, обе верные, а формула читается `не (4 не меньше 0)` и ложна. Поэтому
`сумма неотрицательных`, `начало склейки` и `пустая приставка` берутся только над корнем
(подделки `flang/proof/checker/tests/families/sum-law/`).
-/

structure «ЗаконыЦели» (I : «Толкование») : Prop where
  /-- `А плюс Б не меньше 0` следует из `А не меньше 0` и `Б не меньше 0`. -/
  «сумма-неотрицательных» : ∀ g : String,
    «кореньСравнения» g = true → («разрез» g "не меньше").«есть» = true →
    («разрез» g "не меньше").«право» = "0" →
    («разрез» («разрез» g "не меньше").«лево» "плюс").«есть» = true →
    («сверху» («ужатьТ» («разрез» g "не меньше").«лево») "плюс").length = 2 →
    I.«истинно» («т» s!"{(«разрез» («разрез» g "не меньше").«лево» "плюс").«лево»} не меньше 0") →
    I.«истинно» («т» s!"{(«разрез» («разрез» g "не меньше").«лево» "плюс").«право»} не меньше 0") →
    I.«истинно» g
  /-- `Л не меньше 0` верно, когда `Л` — неотрицательный числовой литерал. -/
  «литерал-неотрицателен» : ∀ (g : String) (x : Float),
    («разрез» g "не меньше").«есть» = true → «ужатьТ» («разрез» g "не меньше").«право» = "0" →
    «литералЧисла?» («ужатьТ» («разрез» g "не меньше").«лево») = some x → decide (x ≥ 0) = true →
    I.«истинно» g
  /-- `длина Т не меньше 0` верно при простом `Т`. -/
  «мера-неотрицательна» : ∀ g : String,
    («разрез» g "не меньше").«есть» = true → («сверху» («ужатьТ» g) "не меньше").length = 2 →
    «ужатьТ» («разрез» g "не меньше").«право» = "0" →
    («ужатьТ» («разрез» g "не меньше").«лево»).startsWith "длина " = true →
    «простойТ» («словаС» («ужатьТ» («разрез» g "не меньше").«лево») 1) = true →
    I.«истинно» g
  /-- `не ( Т минус Т ) равен 0 или Т умножить на Т не меньше 0` верно при простом `Т`:
      у конечного `Т` квадрат не меньше нуля, у бесконечного и не-числа `Т минус Т` не 0. -/
  «квадрат-под-оговоркой» : ∀ g : String,
    («разрез» g "или").«есть» = true → («сверху» («ужатьТ» g) "или").length = 2 →
    («ужатьТ» («разрез» g "или").«лево»).startsWith "не " = true →
    («разрез» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").«есть» = true →
    («сверху» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").length = 2 →
    «ужатьТ» («разрез» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").«право» = "0" →
    («разрез» («разрез» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").«лево» "минус").«есть» = true →
    («сверху» («ужатьТ» («разрез» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").«лево») "минус").length = 2 →
    «ужатьТ» («разрез» («разрез» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").«лево» "минус").«лево» =
      «ужатьТ» («разрез» («разрез» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").«лево» "минус").«право» →
    «простойТ» («ужатьТ» («разрез» («разрез» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").«лево» "минус").«лево») = true →
    («разрез» («разрез» g "или").«право» "не меньше").«есть» = true →
    («сверху» («ужатьТ» («разрез» g "или").«право») "не меньше").length = 2 →
    «ужатьТ» («разрез» («разрез» g "или").«право» "не меньше").«право» = "0" →
    («разрез» («разрез» («разрез» g "или").«право» "не меньше").«лево» "умножить на").«есть» = true →
    («сверху» («ужатьТ» («разрез» («разрез» g "или").«право» "не меньше").«лево») "умножить на").length = 2 →
    «ужатьТ» («разрез» («разрез» («разрез» g "или").«право» "не меньше").«лево» "умножить на").«лево» =
      «ужатьТ» («разрез» («разрез» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").«лево» "минус").«лево» →
    «ужатьТ» («разрез» («разрез» («разрез» g "или").«право» "не меньше").«лево» "умножить на").«право» =
      «ужатьТ» («разрез» («разрез» («ужатьТ» ((«ужатьТ» («разрез» g "или").«лево»).«сн» 3)) "равен").«лево» "минус").«лево» →
    I.«истинно» g
  /-- `соединить Л с Б начинается с Л` верно: склейка начинается своим первым куском. -/
  «начало-склейки-своё» : ∀ g : String,
    («разрез» g "начинается с").«есть» = true → («сверху» («ужатьТ» g) "начинается с").length = 2 →
    («ужатьТ» («разрез» g "начинается с").«лево»).startsWith "соединить " = true →
    («разрез» («словаС» («ужатьТ» («разрез» g "начинается с").«лево») 1) "с").«есть» = true →
    («сверху» («ужатьТ» («словаС» («ужатьТ» («разрез» g "начинается с").«лево») 1)) "с").length = 2 →
    «кореньСравнения» g = true →
    «ужатьТ» («разрез» («словаС» («ужатьТ» («разрез» g "начинается с").«лево») 1) "с").«лево» =
      «ужатьТ» («разрез» g "начинается с").«право» →
    I.«истинно» g
  /-- `соединить Л с Б начинается с П` следует из `Л начинается с П`. -/
  «начало-склейки» : ∀ g : String,
    («разрез» g "начинается с").«есть» = true → («сверху» («ужатьТ» g) "начинается с").length = 2 →
    («ужатьТ» («разрез» g "начинается с").«лево»).startsWith "соединить " = true →
    («разрез» («словаС» («ужатьТ» («разрез» g "начинается с").«лево») 1) "с").«есть» = true →
    («сверху» («ужатьТ» («словаС» («ужатьТ» («разрез» g "начинается с").«лево») 1)) "с").length = 2 →
    «кореньСравнения» g = true →
    I.«истинно» («т» s!"{«вСкобки» («ужатьТ» («разрез» («словаС» («ужатьТ» («разрез» g "начинается с").«лево») 1) "с").«лево»)} начинается с {«вСкобки» («ужатьТ» («разрез» g "начинается с").«право»)}") →
    I.«истинно» g
  /-- `Т начинается с ""` верно. -/
  «пустая-приставка» : ∀ g : String,
    («разрез» g "начинается с").«есть» = true → («сверху» («ужатьТ» g) "начинается с").length = 2 →
    «ужатьТ» («разрез» g "начинается с").«право» = "\"\"" → «кореньСравнения» g = true →
    I.«истинно» g

/-- **Закон списка верен**: если `«законЦели»` дал посылки и каждая посылка верна, цель
    верна. -/
theorem «законЦели-верен» (I : «Толкование») (L : «ЗаконыЦели» I) («имя» g : String) (ps : List String)
    (h : «законЦели» «имя» g = .ok ps) (hps : ∀ x ∈ ps, I.«истинно» («т» x)) : I.«истинно» g := by
  unfold «законЦели» at h
  dsimp only at h
  split at h
  · -- сумма неотрицательных
    split at h
    · simp at h
    rename_i hA
    split at h
    · simp at h
    rename_i hB
    split at h
    · simp at h
    rename_i hC
    simp only [Except.ok.injEq] at h
    subst h
    have hA' : («разрез» g "не меньше").«есть» = true ∧ («разрез» g "не меньше").«право» = "0" := by
      simpa using hA
    have hB' : («разрез» («разрез» g "не меньше").«лево» "плюс").«есть» = true ∧
        («сверху» («ужатьТ» («разрез» g "не меньше").«лево») "плюс").length = 2 := by
      simpa using hB
    have hC' : «кореньСравнения» g = true := by simpa using hC
    exact L.«сумма-неотрицательных» g hC' hA'.1 hA'.2 hB'.1 hB'.2 (hps _ (by simp)) (hps _ (by simp))
  · -- литерал неотрицателен
    split at h
    · rename_i x hx
      split at h
      · rename_i hc
        simp only [Bool.and_eq_true] at hc
        obtain ⟨⟨h1, h2⟩, h3⟩ := hc
        exact L.«литерал-неотрицателен» g x h1 (of_decide_eq_true h2) hx h3
      · simp at h
    · split at h
      · rename_i hc; simp at hc
      · simp at h
  · -- мера неотрицательна
    split at h
    · rename_i hc
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hc
      obtain ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩ := hc
      exact L.«мера-неотрицательна» g h1 h2 h3 h4 h5
    · simp at h
  · -- квадрат под оговоркой
    split at h
    · rename_i hc
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hc
      obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩, h9⟩, h10⟩, h11⟩, h12⟩, h13⟩, h14⟩, h15⟩, h16⟩, h17⟩ := hc
      exact L.«квадрат-под-оговоркой» g h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15 h16 h17
    · simp at h
  · -- начало склейки
    split at h
    · simp at h
    rename_i hA
    split at h
    · simp at h
    rename_i hB
    split at h
    · simp at h
    rename_i hC
    split at h
    · simp at h
    rename_i hD
    have hA' : («разрез» g "начинается с").«есть» = true ∧ («сверху» («ужатьТ» g) "начинается с").length = 2 := by
      simpa using hA
    have hB' : («ужатьТ» («разрез» g "начинается с").«лево»).startsWith "соединить " = true := by simpa using hB
    have hC' : («разрез» («словаС» («ужатьТ» («разрез» g "начинается с").«лево») 1) "с").«есть» = true ∧
        («сверху» («ужатьТ» («словаС» («ужатьТ» («разрез» g "начинается с").«лево») 1)) "с").length = 2 := by
      simpa using hC
    have hD' : «кореньСравнения» g = true := by simpa using hD
    split at h
    · rename_i he
      exact L.«начало-склейки-своё» g hA'.1 hA'.2 hB' hC'.1 hC'.2 hD' he
    · simp only [Except.ok.injEq] at h
      subst h
      exact L.«начало-склейки» g hA'.1 hA'.2 hB' hC'.1 hC'.2 hD' (hps _ (by simp))
  · -- пустая приставка
    split at h
    · rename_i hc
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hc
      obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := hc
      exact L.«пустая-приставка» g h1 h2 h3 h4
    · simp at h
  · simp at h

/-- **Ход «закон» состоятелен** при законах ядра (`«ЗаконыЦели»`): первая цель
    заменяется посылками закона, и из их верности при условиях цели следует цель. -/
theorem «ход-закон-состоятелен» (I : «Толкование») (L : «ЗаконыЦели» I) (p : «Прогон») (l : String) (o : «Обст»)
    (hw : «слово» l 3 = "закон") (hok : («ходШага» p l o).«оборван» = false)
    (hv : I.«верен» («ходШага» p l o)) : I.«верен» p := by
  obtain ⟨h1, h2, h3⟩ := «шаг-допущен» p l o hok
  have e : «ходШага» p l o = «ходЗакона» p l := by simp [«ходШага», h1, h2, h3, hw]
  rw [e] at hok hv
  generalize hq : «ходЗакона» p l = q at hok hv
  unfold «ходЗакона» at hq
  dsimp only at hq
  split at hq
  · rename_i ps hps
    subst hq
    apply «заменитьСУсловиями-верен» I p _ _ h3 _ hv
    intro _ hm hall
    apply «законЦели-верен» I L _ _ ps hps
    intro x hx
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
    have := hall i (by simpa using hi) (by simpa [List.getD_eq_getElem?_getD, hi] using hm)
    simpa [List.getD_eq_getElem?_getD, hi] using this
  · subst hq; simp [«беда-оборвана»] at hok


/-! ## Ход «переписать» (ADR-0220)

Четыре формы. `формой … законом «Имя»` и `законом «Порядок рефлексивен»` — законы ядра,
по полю на закон. `по свойству` и `по постусловию` — экземпляр доказанного равенства без
обязательств: он верен при любых значениях имён, и переписка верна и под связывателем;
экземпляр с ограничением «таких что» постусловием не переписывает (`«отказ»`).
-/

structure «ЗаконыПереписки» (I : «Толкование») : Prop where
  /-- Снятие внешних скобок и пробелов терма не меняет. -/
  «тожд-ужать» : ∀ a b a' b' : String, «ужатьТ» a = «ужатьТ» a' → «ужатьТ» b = «ужатьТ» b' →
    I.«тожд» a b → I.«тожд» a' b'
  «тожд-т» : ∀ a b : String, I.«тожд» a b → I.«тожд» («т» a) («т» b)
  /-- Экземпляр доказанного утверждения либо постусловия без обязательств, голое равенство,
      верен при любых значениях имён: тождество. -/
  «факт-тождество» : ∀ (p : «Прогон») (l : String) (o : «Обст») (i a b : String),
    «расчётФакта» p l o = .ok (i, []) → «голоеРавенство» («т» i) = some (a, b) → I.«тожд» a b
  /-- Переписка постусловием одним проходом по тексту — подстановка тождества (посылка о
      чтении, как `«подстановка-тождества»`). -/
  «перепись-тождества» : ∀ g a b : String, I.«тожд» a b →
    I.«истинно» («т» («переписьПостусловием» g a b)) → I.«истинно» g
  /-- `Т не больше Т` у целого литерала `Т` есть `да`. -/
  «порядок-литерал» : ∀ «лево» : String,
    («разрезРефлексивности» «лево»).«есть» = true →
    «ужатьТ» («разрезРефлексивности» «лево»).«лево» = «ужатьТ» («разрезРефлексивности» «лево»).«право» →
    «целыйЛитерал» («ужатьТ» («разрезРефлексивности» «лево»).«лево») = true →
    I.«тожд» «лево» "да"
  /-- `Т не больше Т` у `Т`, не меньшего нуля, при текущем значении есть `да`. -/
  «порядок-имя» : ∀ «лево» : String,
    («разрезРефлексивности» «лево»).«есть» = true →
    «ужатьТ» («разрезРефлексивности» «лево»).«лево» = «ужатьТ» («разрезРефлексивности» «лево»).«право» →
    I.«истинно» s!"{«ужатьТ» («разрезРефлексивности» «лево»).«лево»} не меньше 0" →
    I.«здесь» «лево» "да"
  /-- Закон формы списка (`«формаЗаконом»`) — тождество: мера прибавления, склейки,
      разложения и построения, элемент по номеру, поле выписанной записи, закон признака,
      вхождение в выписанный список, склейка разложения, пустая склейка слева и справа,
      склейка ассоциативна, тождественное отображение, слияние отображений (ADR-0220 §2.5). -/
  «форма-тождество» : ∀ t z r : String, «формаЗаконом» t z = some r → I.«тожд» t r

/-- Переписка формой законом списка. -/
theorem «переписка-формой» (I : «Толкование») (L : «ЗаконыПереписки» I) (p : «Прогон») (l : String)
    (hne : p.«цели» ≠ []) (hok : («ходПерепискиФормой» p l).«оборван» = false)
    (hv : I.«верен» («ходПерепискиФормой» p l)) : I.«верен» p := by
  generalize hq : «ходПерепискиФормой» p l = q at hok hv
  unfold «ходПерепискиФормой» at hq
  dsimp only at hq
  generalize hf : «формаЗаконом» («т» («уголок» l 1)) («ёлочка» («после» l "законом ") 1) = f at hq
  split at hq
  · subst hq; simp [«беда-оборвана»] at hok
  split at hq
  · subst hq; simp [«беда-оборвана»] at hok
  split at hq
  · subst hq; simp [«беда-оборвана»] at hok
  cases f with
  | none => subst hq; simp [«беда-оборвана»] at hok
  | some r =>
    dsimp only at hq
    split at hq
    · subst hq; simp [«беда-оборвана»] at hok
    rename_i heq
    subst hq
    have heq' : r = «т» («уголок» l 2) := by simpa using heq
    have ht := L.«форма-тождество» _ _ _ hf
    rw [heq'] at ht
    apply «одна-верна» I p _ hne _ hv
    intro _ h
    exact I.«подстановка-тождества» _ _ _ ht (I.«т-верно» _ h)

/-- Переписка законом «Порядок рефлексивен»: у целого литерала — тождество, у имени с дном —
    равенство при текущем значении, вне связывателя. -/
theorem «переписка-рефлексивностью» (I : «Толкование») (L : «ЗаконыПереписки» I) (p : «Прогон»)
    (l : String) (o : «Обст») (hdno : ∀ y, «дноОбъявлением» o y = true → I.«истинно» y)
    (hne : p.«цели» ≠ []) (hok : («ходРефлексивности» p l o).«оборван» = false)
    (hv : I.«верен» («ходРефлексивности» p l o)) : I.«верен» p := by
  generalize hq : «ходРефлексивности» p l o = q at hok hv
  unfold «ходРефлексивности» at hq
  dsimp only at hq
  generalize hc : «целыйЛитерал» («ужатьТ» («разрезРефлексивности» («т» («уголок» l 1))).«лево») = c at hq
  split at hq
  · subst hq; simp [«беда-оборвана»] at hok
  split at hq
  · subst hq; simp [«беда-оборвана»] at hok
  rename_i hB
  split at hq
  · subst hq; simp [«беда-оборвана»] at hok
  rename_i hC
  split at hq
  · subst hq; simp [«отказ-оборван»] at hok
  rename_i hD
  split at hq
  · subst hq; simp [«беда-оборвана»] at hok
  subst hq
  have hB' : («разрезРефлексивности» («т» («уголок» l 1))).«есть» = true ∧
      «ужатьТ» («разрезРефлексивности» («т» («уголок» l 1))).«лево» =
        «ужатьТ» («разрезРефлексивности» («т» («уголок» l 1))).«право» := by
    simpa using hB
  apply «одна-верна» I p _ hne _ hv
  intro _ h
  have h' := I.«т-верно» _ h
  cases c with
  | true => exact I.«подстановка-тождества» _ _ _ (L.«порядок-литерал» _ hB'.1 hB'.2 hc) h'
  | false =>
    have hd : «дноОбъявлением» o s!"{«ужатьТ» («разрезРефлексивности» («т» («уголок» l 1))).«лево»} не меньше 0" = true := by
      simpa using hC
    have hf : «подСвязывателем» p.«первая» = false := by simpa using hD
    exact I.«подстановка-равенства» _ _ _ hf (L.«порядок-имя» _ hB'.1 hB'.2 (hdno _ hd)) h'

set_option hygiene false in
/-- Ветвь `беда` либо `отказ` (возможно, за `match` или `if`) не оборванным прогоном быть не может. -/
macro "close_broken" : tactic => `(tactic| first
  | (subst hq; simp [pure, «беда-оборвана», «отказ-оборван»] at hok; done)
  | (split at hq <;> (subst hq; simp [pure, «беда-оборвана», «отказ-оборван»] at hok)))

theorem «верен-без-факта» (I : «Толкование») (p : «Прогон») (x : String) :
    I.«верен» { p with «факт» := x } ↔ I.«верен» p := Iff.rfl

/-- Переписка по свойству: экземпляр доказанного утверждения без обязательств — тождество. -/
theorem «переписка-свойством» (I : «Толкование») (L : «ЗаконыПереписки» I) (p : «Прогон»)
    (l : String) (o : «Обст») (hne : p.«цели» ≠ [])
    (hok : («ходПерепискиСвойством» p l o).«оборван» = false)
    (hv : I.«верен» («ходПерепискиСвойством» p l o)) : I.«верен» p := by
  generalize hq : «ходПерепискиСвойством» p l o = q at hok hv
  unfold «ходПерепискиСвойством» at hq
  simp only [Id.run] at hq
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · close_broken
  rename_i i ob hr
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i hob
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i a b hg
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i hu
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  simp only [pure] at hq
  subst hq
  have hob' : ob = [] := by simpa using hob
  subst hob'
  have hu' : «ужатьТ» a = «ужатьТ» («т» («уголок» l 1)) ∧ «ужатьТ» b = «ужатьТ» («т» («уголок» l 2)) := by
    simpa using hu
  have ht := L.«тожд-ужать» _ _ _ _ hu'.1 hu'.2 (L.«факт-тождество» p l o i a b hr hg)
  rw [← «верен-без-факта» I p ""]
  apply «одна-верна» I _ _ hne _ hv
  intro _ h
  exact I.«подстановка-тождества» _ _ _ ht (I.«т-верно» _ h)

/-- Переписка по постусловию: экземпляр постусловия без ограничения — тождество; замена одним
    проходом (`«перепись-тождества»`). -/
theorem «переписка-постусловием» (I : «Толкование») (L : «ЗаконыПереписки» I) (p : «Прогон»)
    (l : String) (o : «Обст») (hne : p.«цели» ≠ [])
    (hok : («ходПерепискиПостусловием» p l o).«оборван» = false)
    (hv : I.«верен» («ходПерепискиПостусловием» p l o)) : I.«верен» p := by
  generalize hq : «ходПерепискиПостусловием» p l o = q at hok hv
  unfold «ходПерепискиПостусловием» at hq
  simp only [Id.run] at hq
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · close_broken
  rename_i i ob hr
  split at hq
  · close_broken
  rename_i hob
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i a b hg
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i hu
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  simp only [pure] at hq
  subst hq
  have hob' : ob = [] := by simpa using hob
  subst hob'
  have hu' : «ужатьТ» («т» a) = «ужатьТ» («т» («уголок» l 1)) ∧ «ужатьТ» («т» b) = «ужатьТ» («т» («уголок» l 2)) := by
    simpa using hu
  have ht := L.«тожд-ужать» _ _ _ _ hu'.1 hu'.2 (L.«тожд-т» _ _ (L.«факт-тождество» p _ o i a b hr hg))
  rw [← «верен-без-факта» I p ""]
  apply «одна-верна» I _ _ hne _ hv
  intro _ h
  exact L.«перепись-тождества» _ _ _ ht h

/-- **Ход «переписать» состоятелен** во всех четырёх формах при законах ядра
    (`«ЗаконыПереписки»`) и верных типах доводов (дно объявленного типа). -/
theorem «ход-переписать-состоятелен» (I : «Толкование») (L : «ЗаконыПереписки» I) (p : «Прогон»)
    (l : String) (o : «Обст») (hdno : ∀ y, «дноОбъявлением» o y = true → I.«истинно» y)
    (hw : «слово» l 3 = "переписать") (hok : («ходШага» p l o).«оборван» = false)
    (hv : I.«верен» («ходШага» p l o)) : I.«верен» p := by
  obtain ⟨h1, h2, h3⟩ := «шаг-допущен» p l o hok
  by_cases hp : «слово» l 4 = "по" ∧ «слово» l 5 = "постусловию"
  · have e : «ходШага» p l o = «ходПерепискиПостусловием» p l o := by
      simp [«ходШага», h1, h2, h3, hw, hp.1, hp.2]
    rw [e] at hok hv
    exact «переписка-постусловием» I L p l o h3 hok hv
  by_cases hs : «слово» l 4 = "по"
  · have e : «ходШага» p l o = «ходПерепискиСвойством» p l o := by
      simp [«ходШага», h1, h2, h3, hw, hs]
      intro h5; exact absurd ⟨hs, h5⟩ hp
    rw [e] at hok hv
    exact «переписка-свойством» I L p l o h3 hok hv
  by_cases hr : (l.splitOn " законом «Порядок рефлексивен»").length > 1
  · have e : «ходШага» p l o = «ходРефлексивности» p l o := by
      simp [«ходШага», h1, h2, h3, hw, hs, hr]
    rw [e] at hok hv
    exact «переписка-рефлексивностью» I L p l o hdno h3 hok hv
  · have e : «ходШага» p l o = «ходПерепискиФормой» p l := by
      simp [«ходШага», h1, h2, h3, hw, hs, hr]
    rw [e] at hok hv
    exact «переписка-формой» I L p l h3 hok hv


/-! ## Ход «поля» (ADR-0220 §2.6)

Тело доказываемой функции — одна строка, выписанная запись; вызов на своих параметрах при
текущих значениях имён равен телу, и поле выписанной записи равно значению, с которым оно
выписано. Вне связывателей поле результата подставляется значением.
-/

structure «ЗаконыПолей» (I : «Толкование») : Prop where
  /-- Вызов доказываемой функции на своих параметрах равен её телу — выписанной записи, —
      и поле записи есть значение, с которым оно выписано; `результат` — тот же вызов. -/
  «поле-выписанной» : ∀ (o : «Обст») («что» : String) («где» : Nat) (nms vs : List String),
    «ёлочка» «что» 1 = o.«функция» →
    («что».startsWith s!"«{«ёлочка» «что» 1}» от " = true ∨ «что» = s!"«{«ёлочка» «что» 1}»") →
    «доводыСвои» («доводыЗова» «что» («ёлочка» «что» 1)) (o.«исх».«доводы» («ёлочка» «что» 1)).«голые» = true →
    («доводыЗова» «что» («ёлочка» «что» 1)).length = (o.«исх».«доводы» («ёлочка» «что» 1)).«голые».length →
    o.«исх».«однаСтрокаТела» («ёлочка» «что» 1) «где» = true →
    «поляВыписанной» («т» («какЧитаетЯзык» (o.«исх».«сырая» «где»))) = some (nms, vs) →
    ∀ q ∈ nms.zip vs, I.«здесь» s!"{«вСкобки» «что»} .{q.1}" («вСкобки» («т» q.2)) ∧
      I.«здесь» s!"результат.{q.1}" («вСкобки» («т» q.2))
  /-- Замена полей результата равными значениями в цели без связывателей сохраняет цель
      (посылка о чтении, как `«подстановка-равенства»`). -/
  «замена-полей» : ∀ (g «вз» : String) (ps : List (String × String)),
    «связыватьПоля».any (fun k => ((" " ++ g ++ " ").splitOn k).length > 1) = false →
    (∀ q ∈ ps, I.«здесь» s!"{«вз»} .{q.1}" («вСкобки» («т» q.2)) ∧
      I.«здесь» s!"результат.{q.1}" («вСкобки» («т» q.2))) →
    I.«истинно» («т» («заменаПолей» g «вз» ps).1) → I.«истинно» g

/-- **Ход «поля» состоятелен** при законах полей (`«ЗаконыПолей»`). -/
theorem «ход-поля-состоятелен» (I : «Толкование») (L : «ЗаконыПолей» I) (p : «Прогон»)
    (l : String) (o : «Обст»)
    (hw : «слово» l 3 = "поля") (hok : («ходШага» p l o).«оборван» = false)
    (hv : I.«верен» («ходШага» p l o)) : I.«верен» p := by
  obtain ⟨h1, h2, h3⟩ := «шаг-допущен» p l o hok
  have e : «ходШага» p l o = «ходПолей» p l o := by simp [«ходШага», h1, h2, h3, hw]
  rw [e] at hok hv
  generalize hq : «ходПолей» p l o = q at hok hv
  unfold «ходПолей» at hq
  simp only [Id.run] at hq
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i hA
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i hB
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i hC
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i hD
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i hE
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i nms vs hF
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  rename_i hG
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  split at hq
  · subst hq; simp [pure, «беда-оборвана»] at hok
  simp only [pure] at hq
  subst hq
  have hA' : «ёлочка» («т» («уголок» l 1)) 1 = o.«функция» := by simpa using hA
  have hB' : («т» («уголок» l 1)).startsWith s!"«{«ёлочка» («т» («уголок» l 1)) 1}» от " = true ∨
      «т» («уголок» l 1) = s!"«{«ёлочка» («т» («уголок» l 1)) 1}»" := by
    by_cases hs : («т» («уголок» l 1)).startsWith s!"«{«ёлочка» («т» («уголок» l 1)) 1}» от " = true
    · exact Or.inl hs
    · exact Or.inr (by simpa [hs] using hB)
  have hC' : («доводыЗова» («т» («уголок» l 1)) («ёлочка» («т» («уголок» l 1)) 1)).length =
      (o.«исх».«доводы» («ёлочка» («т» («уголок» l 1)) 1)).«голые».length := by simpa using hC
  have hD' : «доводыСвои» («доводыЗова» («т» («уголок» l 1)) («ёлочка» («т» («уголок» l 1)) 1))
      (o.«исх».«доводы» («ёлочка» («т» («уголок» l 1)) 1)).«голые» = true := by simpa using hD
  have hE' : o.«исх».«однаСтрокаТела» («ёлочка» («т» («уголок» l 1)) 1) («номерПосле» l "строка ") = true := by
    simpa using hE
  have hG' : «связыватьПоля».any (fun k => ((" " ++ p.«первая» ++ " ").splitOn k).length > 1) = false := by
    simpa using hG
  have hpairs := L.«поле-выписанной» o _ _ nms vs hA' hB' hD' hC' hE' hF
  apply «одна-верна» I p _ h3 _ hv
  intro _ h
  exact L.«замена-полей» _ _ _ hG' hpairs h


/-! ## Ход «развернуть» (ADR-0220 §2.7)

Вызов тотальной функции равен её телу при доводах: у формы без разбора — тело строки с
доводами вместо параметров (`«телоПриДоводах»`), у разбора первого параметра на конструкторе
списка либо варианта — ветвь этого конструктора с полями вместо имён образца. Это тождество
языка, и подстановка тождества сохраняет цель и под связывателем. Что текстовая подстановка
— подстановка в терме, — посылка о чтении, как у `«подстановка-тождества»`.
-/

structure «ЗаконыРазвёртки» (I : «Толкование») : Prop where
  /-- Тело, которое даёт развёртка по строке исходника, тождественно вызову. -/
  «развёртка-тождество» : ∀ (p : «Прогон») (l : String) (o : «Обст») (b : String),
    «телоРазвёртки» p l o = .ok b → I.«тожд» («т» («уголок» l 1)) b

/-- **Ход «развернуть» состоятелен** при законе развёртки (`«ЗаконыРазвёртки»`). -/
theorem «ход-развернуть-состоятелен» (I : «Толкование») (L : «ЗаконыРазвёртки» I) (p : «Прогон»)
    (l : String) (o : «Обст»)
    (hw : «слово» l 3 = "развернуть") (hok : («ходШага» p l o).«оборван» = false)
    (hv : I.«верен» («ходШага» p l o)) : I.«верен» p := by
  obtain ⟨h1, h2, h3⟩ := «шаг-допущен» p l o hok
  have e : «ходШага» p l o = «ходРазвёртки» p l o := by simp [«ходШага», h1, h2, h3, hw]
  rw [e] at hok hv
  generalize hq : «ходРазвёртки» p l o = q at hok hv
  unfold «ходРазвёртки» at hq
  split at hq
  · split at hq <;> (subst hq; simp [«беда-оборвана», «отказ-оборван»] at hok)
  · rename_i b hb
    subst hq
    apply «одна-верна» I p _ h3 _ hv
    intro _ h
    exact I.«подстановка-тождества» _ _ _ (L.«развёртка-тождество» p l o b hb) (I.«т-верно» _ h)

end «Второй»
