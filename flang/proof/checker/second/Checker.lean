def «частиПути» (p : String) : List String := (p.splitOn "/").filter (fun x => x ≠ "" && x ≠ ".")

def «путьСовпал» (a b : String) : Bool :=
  let pa := «частиПути» a
  let pb := «частиПути» b
  let fa := a.startsWith "/"
  let fb := b.startsWith "/"
  if fa == fb then pa == pb
  else
    let (k, d) := if fa then (pb, pa) else (pa, pb)
    k.length ≤ d.length && d.drop (d.length - k.length) == k

