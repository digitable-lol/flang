def «сВписаннымСвидетелем» («цель» : String) («обр» : List String) : String :=
  let t := «обрезать» «цель»
  if («существование» t).isSome || !t.startsWith "есть такой " then «цель» else
  match «обр».find? (·.startsWith "свидетель ") with
  | none => «цель»
  | some «св» =>
    let «м» := «ёлочка» «св» 1
    let «тт» := «уголок» «св» 1
    match (t.«сн» 11).splitOn ", что " with
    | «имя» :: «у» :: rest =>
      if «обрезать» «имя» = «м» && «м» ≠ "" && «тт» ≠ "" then
        s!"есть такой {«м»}, а именно {«тт»}, что {", что ".intercalate («у» :: rest)}"
      else «цель»
    | _ => «цель»

def «цельРазбором» (s : «Исх») («чья» : String) («где» : Nat) («цель0» : String) : String :=
  -- ADR-0105: «цель0» уже дочитана до закрытия скобок; случаи идут со строки за последней взятой
  let «где» := (s.«доЗакрытия» «где» («обрезать» («какЧитаетЯзык» (s.«сырая» «где»)))).1
  let «цель» := «цель0»
  let u := «ужатьТ» «цель»
  let «ниже» := u.startsWith "разбор " || (u.startsWith "если " && (u.splitOn " иначе ").length = 1)
  if !«ниже» then «цель» else
  match s.«блок» «чья» with
  | none => «цель»
  | some (_, e) =>
    let «хв» := ((List.range' («где» + 1) (e - «где» - 1)).takeWhile (fun i => (s.«сырая» i).startsWith "   ")).map (fun i => «обрезать» («какЧитаетЯзык» (s.«сырая» i)))
    " ".intercalate («цель» :: «хв»)

