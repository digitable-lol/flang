def «H0» : Array UInt32 :=
  #[0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]

def «вращ» (x n : UInt32) : UInt32 := (x >>> n) ||| (x <<< (32 - n))

def «дополнить» (m : ByteArray) : ByteArray :=
  let l := m.size
  let k := if l % 64 ≤ 55 then 55 - l % 64 else 119 - l % 64
  let bits := l * 8
  let «хв» := (List.range 8).reverse.map (fun i => UInt8.ofNat ((bits >>> (8 * i)) % 256))
  (m.push 0x80) ++ ⟨(List.replicate k (0 : UInt8)).toArray⟩ ++ ⟨«хв».toArray⟩

def «словоШ» (b : ByteArray) (i : Nat) : UInt32 :=
  ((b.get! i).toUInt32 <<< 24) ||| ((b.get! (i + 1)).toUInt32 <<< 16) |||
  ((b.get! (i + 2)).toUInt32 <<< 8) ||| (b.get! (i + 3)).toUInt32

def «сжатьШ» (h : Array UInt32) (b : ByteArray) (o : Nat) : Array UInt32 := Id.run do
  let mut w : Array UInt32 := #[]
  for i in [0:16] do
    w := w.push («словоШ» b (o + 4 * i))
  for i in [16:64] do
    let x := w[i - 15]!
    let y := w[i - 2]!
    let s0 := «вращ» x 7 ^^^ «вращ» x 18 ^^^ (x >>> 3)
    let s1 := «вращ» y 17 ^^^ «вращ» y 19 ^^^ (y >>> 10)
    w := w.push (w[i - 16]! + s0 + w[i - 7]! + s1)
  let mut a := h[0]!
  let mut bb := h[1]!
  let mut c := h[2]!
  let mut d := h[3]!
  let mut e := h[4]!
  let mut f := h[5]!
  let mut g := h[6]!
  let mut hh := h[7]!
  for i in [0:64] do
    let s1 := «вращ» e 6 ^^^ «вращ» e 11 ^^^ «вращ» e 25
    let ch := (e &&& f) ^^^ ((~~~ e) &&& g)
    let t1 := hh + s1 + ch + «K»[i]! + w[i]!
    let s0 := «вращ» a 2 ^^^ «вращ» a 13 ^^^ «вращ» a 22
    let maj := (a &&& bb) ^^^ (a &&& c) ^^^ (bb &&& c)
    let t2 := s0 + maj
    hh := g
    g := f
    f := e
    e := d + t1
    d := c
    c := bb
    bb := a
    a := t1 + t2
  return #[h[0]! + a, h[1]! + bb, h[2]! + c, h[3]! + d, h[4]! + e, h[5]! + f, h[6]! + g, h[7]! + hh]

def «шестн» (x : UInt32) : String :=
  let s := String.ofList (Nat.toDigits 16 x.toNat)
  String.ofList (List.replicate (8 - s.length) '0') ++ s

def «sha256» (m : ByteArray) : String :=
  let p := «дополнить» m
  let h := (List.range (p.size / 64)).foldl (fun h i => «сжатьШ» h p (64 * i)) «H0»
  String.join (h.toList.map «шестн»)

def «отпечаток» (s : String) («множ» «модуль» : Nat) : Nat :=
