def «функцияЦели» («цель» : String) («имена» : List String) : String :=
  let t := «т» «цель»
  («имена».findSome? fun x =>
    [s!"» от {x}", s!"» от ( {x} )"].findSome? fun w =>
      let «ч» := t.splitOn w
      (List.range («ч».length - 1)).findSome? fun i =>
        let «за» := "".intercalate («ч».drop (i + 1) |>.take 1)
        if «за» = "" || «за».startsWith " " then
          let «пред» := «ч».getD i ""
          match («пред».splitOn "«").getLast? with
          | some n => if n ≠ "" then some n else none
          | none => none
        else none).getD ""

def «Исх».«типЗаписиПоРусски» (s : «Исх») (l : String) : String :=
  match s.«язык» with
  | none => l
  | some y =>
    if !(«обрезать» l).startsWith "для всех «" then l else
    match l.splitOn "⟨" with
    | pre :: rest =>
      let «хв» := "⟨".intercalate rest
      match «хв».splitOn "⟩" with
      | inner :: post => if rest.isEmpty || post.isEmpty then l else pre ++ "⟨" ++ «поРусски» inner y ++ "⟩" ++ "⟩".intercalate post
      | [] => l
    | [] => l

/-- Прочитанное утверждение: строки блока, заголовок, имя, вердикт, правило, место,
    цель и функция — всё, что решению нужно от формы. -/
structure «ФормаУтв» where
  «свои» : List String
  «обр» : List String
  «заг» : String
  «имя» : String
  «доказано» : Bool
  «вердикт» : String
  «пр» : Option String
  «место» : String
  «цель0» : String
  «чья» : String
  «функц» : Bool
  «где» : Nat

def «ФормаУтв».«есть» (u : «ФормаУтв») (p : String) : Bool := u.«обр».any (·.startsWith p)

/-- Теорема исходника утверждения, если запись её называет. -/
def «ФормаУтв».«теорема» (u : «ФормаУтв») («к» : «Контекст») : «Теорема» :=
  { «исх» := «к».«исх», «обр» := u.«обр», «имя» := u.«имя», «имяТ» := «ёлочка» ((u.«обр».find? (·.startsWith "теорема «")).getD "") 1,
    «чья» := u.«чья», «место» := u.«место», «вердикт» := u.«вердикт», «огл» := «к».«огл»,
    «доказанные» := «к».«доказанные», «объявленные» := «к».«объявленные» }

def «ФормаУтв».«выводСуд» (u : «ФормаУтв») («к» : «Контекст») : «Суд» :=
  ({} : «Суд»).«выводом» u.«имя» ("утверждение " ++ u.«заг») ((u.«обр».drop 1).filter (· ≠ "")) «к».«строки» «к».«опр» «к».«исх» «к».«доказанные»

def «ФормаУтв».«обстХодов» (u : «ФормаУтв») («к» : «Контекст») : «Обст» :=
  let s := «к».«исх»
  let «д» := s.«доводы» u.«чья»
  let o : «Обст» := { «исх» := s }
  let o := { o with «свои» := u.«обр», «цель» := «т» u.«цель0», «функция» := u.«чья» }
  let o := { o with «по» := («д».«имена».headD ""), «хвост» := «д».«хвост», «обяз» := u.«имя» }
  { o with «доказанные» := «к».«доказанные», «объявленные» := «к».«объявленные», «ограничения» := s.«ограничения» u.«место» }

def «ФормаУтв».«местоКрюков» (u : «ФормаУтв») («к» : «Контекст») : «Место» :=
  { «свои» := u.«обр», «имя» := u.«имя», «чья» := u.«чья», «цель» := u.«цель0»,
    «высказывание» := if u.«функц» then none else some («какЧитаетЯзык» («к».«исх».«сырая» u.«где»)),
    «доказанные» := «к».«доказанные», «объявленные» := «к».«объявленные» }

def «ФормаУтв».«естьХоды» (u : «ФормаУтв») : Bool := u.«обр».contains "ход цель"

def «ФормаУтв».«ходыПосылок» (u : «ФормаУтв») («к» : «Контекст») : «Прогон» :=
  «ходыПодПосылками» «к».«исх» u.«обр» u.«цель0» u.«чья» u.«имя» u.«место» «к».«доказанные» «к».«объявленные»

def «ФормаУтв».«ходамиСписка» (u : «ФормаУтв») («к» : «Контекст») : Bool :=
  u.«есть» "ход " && (u.«ходыПосылок» «к»).«беды».isEmpty && «посылкиПокрываютСписок» u.«обр» &&
    decide ((u.«ходыПосылок» «к»).«проиграно» = («посылкиБлока» u.«обр»).length)

/-- Ходы ведут утверждение: есть «ход цель», и либо принципа нет, либо первая строка ходов
    стоит выше первой посылки. -/
def «ФормаУтв».«ходамиВерх» (u : «ФормаУтв») : Bool :=
  let «верхний» := match u.«обр».find? (fun l => l.startsWith "посылка " || l = "ход цель") with
    | some l => l = "ход цель"
    | none => false
  u.«естьХоды» && (!u.«есть» "принцип " || «верхний»)

/-- Суд о линейной арифметике: сертификат записи складывается заново (ADR-0192, ADR-0194). -/
def «судЛинейный» (u : «ФормаУтв») («к» : «Контекст») (r : «Суд») : «Суд» :=
  match «линейнаяАрифметика» «к».«исх» u.«обр» u.«чья» u.«место» u.«цель0» with
  | .ok (true, _) => r
  | .ok (false, e) => r.«слово» s!"утверждение «{u.«имя»}»: правило «линейная арифметика» — {e} — место на слове ядра"
  | .error e =>
    if e.startsWith "НЕВЗЯЛСЯ " then r.«слово» s!"утверждение «{u.«имя»}»: правило «линейная арифметика» — {e.drop 9} — место на слове ядра"
    else r.«беда» s!"утверждение «{u.«имя»}»: правило «линейная арифметика» не сходится — {e}"

/-- Суд о доказанном утверждении вне линейной арифметики. -/
def «судДоказанногоБезЛинейного» (u : «ФормаУтв») («к» : «Контекст») («нечем» : Nat) (r : «Суд») : «Суд» :=
  let s := «к».«исх»
  let «посылки» := u.«есть» "посылка "
  if u.«доказано» && u.«есть» "вывод " then
    let r := (r.«еслиНе» (!«посылки») s!"утверждение «{u.«имя»}»: под блоком вывода стоят посылки").«еслиНе» (!u.«естьХоды»)
      s!"утверждение «{u.«имя»}»: и ходы, и вывод"
    if !«посылки» && !u.«естьХоды» then
      let r := r.«и» (u.«выводСуд» «к»)
      if «нечем» > 0 then r.«слово» s!"утверждение «{u.«имя»}»: вывод стоит на обязательстве входа, которое закрыть нечем" else r
    else r
  else if u.«ходамиВерх» then
    if u.«доказано» then
      let p := «проигратьБлок» (u.«обстХодов» «к»)
      let r := r.«еслиНе» p.«беды».isEmpty s!"утверждение «{u.«имя»}», сведение: {"; ".intercalate p.«беды»}"
      let r := { r with «наСлово» := r.«наСлово» ++ p.«неВзялся».map (fun x => s!"утверждение «{u.«имя»}», сведение: {x}") }
      if p.«беды».isEmpty && p.«проиграно» = 0 && p.«неВзялся».isEmpty then
        r.«слово» s!"утверждение «{u.«имя»}»: ходы ничего не свели" else r
    else r
  else if u.«доказано» && u.«пр» = some "правило «кольцо точного целого»" then
    match «кольцоТочногоЦелого» s u.«обр» u.«чья» u.«цель0» with
    | .ok () => r
    | .error e => r.«беда» s!"утверждение «{u.«имя»}»: правило «кольцо точного целого» не сходится — {e}"
  else if u.«доказано» then
    let h := «крюкиПоТелу» { «исх» := s, «огл» := «к».«огл» } (u.«местоКрюков» «к»)
    let r := { r with «беды» := r.«беды» ++ h.«беды» }
    let r := if h.«снял» = "" && !u.«ходамиСписка» «к» then
      r.«слово» s!"утверждение «{u.«имя»}»: вердикт «доказано», а за место не взялся ни один приём по телу функции — место на слове ядра" else r
    if u.«есть» "ход " then
      let p := u.«ходыПосылок» «к»
      r.«еслиНе» p.«беды».isEmpty s!"утверждение «{u.«имя»}»: ход под посылкой не сходится — {"; ".intercalate p.«беды»}"
    else r
  else r

/-- Суд о доказанном утверждении: линейная арифметика — сертификат, блок вывода — модель,
    ходы — прогон ходов, правило кольца — кольцо точного целого, иначе — крюки по телу. -/
def «судДоказанного» (u : «ФормаУтв») («к» : «Контекст») («нечем» : Nat) (r : «Суд») : «Суд» :=
  if u.«доказано» && u.«пр» = some "правило «линейная арифметика»" then «судЛинейный» u «к» r else
  «судДоказанногоБезЛинейного» u «к» «нечем» r

/-- Проиграно ли доказанное утверждение: принял путь решения (для посылок индукции). -/
def «проигранДоказанного» (u : «ФормаУтв») («к» : «Контекст») («нечем» : Nat) : Bool :=
  let s := «к».«исх»
  if u.«доказано» && u.«пр» = some "правило «линейная арифметика»" then
    match «линейнаяАрифметика» s u.«обр» u.«чья» u.«место» u.«цель0» with
    | .ok (true, _) => true
    | _ => false
  else if u.«доказано» && u.«есть» "вывод " then
    if !u.«есть» "посылка " && !u.«естьХоды» then
      let q := u.«выводСуд» «к»
      q.«беды».isEmpty && q.«непонято».isEmpty && «нечем» = 0
    else false
  else if u.«ходамиВерх» then
    if u.«доказано» then
      let p := «проигратьБлок» (u.«обстХодов» «к»)
      p.«беды».isEmpty && p.«проиграно» > 0
    else false
  else if u.«доказано» && u.«пр» = some "правило «кольцо точного целого»" then
    match «кольцоТочногоЦелого» s u.«обр» u.«чья» u.«цель0» with
    | .ok () => true
    | .error _ => false
  else if u.«доказано» then
    («крюкиПоТелу» { «исх» := s, «огл» := «к».«огл» } (u.«местоКрюков» «к»)).«снял» ≠ "" || u.«ходамиСписка» «к»
  else false

/-- Решение об утверждении после формы: теорема исходника, если она названа, иначе
    обязательства входа, путь доказанного (`«решениеДоказанного»`) и посылки. -/
def «решениеУтверждения» («к» : «Контекст») (u : «ФормаУтв») (r : «Суд») : «Суд» :=
  let s := «к».«исх»
  let r := r.«и» («судитьОбъявлениеПравила» u.«обр» s!"утверждение «{u.«имя»}»")
  let r := r.«и» («судитьСтрокиПосылок» u.«свои» s!"утверждение «{u.«имя»}»")
  if u.«есть» "теорема «" then r.«и» («судитьТеорему» (u.«теорема» «к») u.«заг» «к».«строки» «к».«опр») else
  let «спрятана» := s.«номера».any (fun i => let t := «обрезать» («безПримечания» (s.«сырая» i)); t = s!"теорема «{u.«имя»}»" || t = s!"следует «{u.«имя»}»")
  let r := r.«еслиНе» (!«спрятана») s!"в записи сказано «теоремы нет», а в исходнике теорема «{u.«имя»}» написана"
  let r := r.«еслиНе» (!u.«обр».any (fun l => l.startsWith "случай строка" || l.startsWith "индукция по ")) s!"утверждение «{u.«имя»}»: в записи сказано «теоремы нет», а строка теоремы в записи стоит — случаю без теоремы взяться неоткуда"
  let (o, «нечем») := «судитьОбязательства» s «к».«строки» u.«обр» u.«имя» u.«чья»
  let r := r.«и» o
  («судДоказанного» u «к» «нечем» r).«и» («судитьПосылки» s u.«обр» u.«имя» u.«чья» u.«вердикт» u.«место» s!"утверждение «{u.«имя»}»"
    («проигранДоказанного» u «к» «нечем») false)

/-- Форма утверждения: прочитанное утверждение и беды его формы. -/
def «формаУтверждения» («к» : «Контекст») («блок» : String) : «ФормаУтв» × «Суд» := Id.run do
  let s := «к».«исх»
  let «свои» := («блок».splitOn "\n").map s.«типЗаписиПоРусски»
  let «заг» := «свои».headD ""
  let «обр» := «свои».map «обрезать»
  let «имя» := «ёлочка» «заг» 1
  let «функц» := ((«заг».splitOn " функции «").length > 1)
  let «чья0» := if «функц» then «ёлочка» «заг» 2 else ""
  let «где» := «номерПосле» «заг» "строка "
  let «вл» := ((«обр».find? (·.startsWith "вердикт ")).getD "")
  let «вердикт» := «слово» «вл» 2
  let «доказано» := «вердикт» = "доказано"
  let «сколько» := fun (p : String → Bool) => («обр».filter p).length
  let mut r : «Суд» := {}
  r := r.«еслиНе» («сколько» (·.startsWith "вид ") = 1 && «сколько» (·.startsWith "вердикт ") = 1 &&
      «сколько» (fun l => l.startsWith "теорема «" || l = "теоремы нет") = 1 && «сколько» (· = "конец утверждения") = 1)
    s!"утверждение «{«имя»}» записано не целиком"
  let «пр» := «обр».find? (·.startsWith "правило «")
  let «по» := «обр».find? (·.startsWith "по объявлению ")
  r := r.«еслиНе» («пр».isSome == «по».isSome) s!"утверждение «{«имя»}»: правило и «по объявлению» не парой"
  for l in «обр».filter (·.startsWith "правило «") do
    r := r.«еслиНе» («правилаЯдра».contains («ёлочка» l 1)) s!"утверждение «{«имя»}»: правило «{«ёлочка» l 1}» ядру неизвестно"
  for l in «обр».filter (·.startsWith "по объявлению ") do
    r := r.«еслиНе» (l = "по объявлению да" || l = "по объявлению нет") s!"утверждение «{«имя»}»: «{l}» — не да и не нет"
  for l in («обр».drop 1) do
    if !«знакомая?» l then r := r.«беда» s!"утверждение «{«имя»}»: строка «{l}» не узнана"
  if «вл» = "вердикт доказано при условии" then r := r.«слово» s!"утверждение «{«имя»}»: доказано при условии"
  let mut «место» := ""
  let mut «цель0» := ""
  let mut «чья» := «чья0»
  if !«функц» then
    «место» := s!"утверждение «{«имя»}»"
    r := r.«еслиНе» («какЧитаетЯзык» (s.«сырая» «где») = «место») s!"строка {«где»} исходника не «{«место»}» от края"
    r := r.«еслиНе» («обр».contains "вид statement") s!"утверждение «{«имя»}» без функции не «вид statement»"
    let «кв» := «обр».filter (·.startsWith "для всех ")
    let «тч» := «обр».filter (·.startsWith "таких что ")
    let mut k := 0
    let mut tt := 0
    let mut «целей» := 0
    let mut «гц» := 0
    for i in List.range' («где» + 1) (s.«число» - «где») do
      let «сыр» := s.«сырая» i
      if «сыр» ≠ "" && !«сыр».startsWith " " && !«сыр».startsWith "//" then break
      let l := «какЧитаетЯзык» («обрезать» («безПримечания» «сыр»))
      if l.startsWith "утверждаем " then «цель0» := s.«доЗакрытияСкобок» i («после» l "утверждаем "); «гц» := i; «целей» := «целей» + 1; continue
      if !l.startsWith "для всех " then continue
      let «л2» := s.«доЗакрытияСкобок» i l
      let mut «св» := «л2».«сн» 9
      let mut «огр» := ""
      if («св».splitOn " таких что ").length > 1 then
        «огр» := «после» «св» " таких что "
        «св» := («св».splitOn " таких что ").headD «св»
      let «связ» := let x := «сверху» «св» "и"; if x.isEmpty then [«св»] else x
      for «одно0» in «связ» do
        let «одно» := «обрезать» «одно0»
        let «пара» := «одно».splitOn ":"
        let «ждём» := s!"для всех «{«голо» («пара».headD "")}» ⟨{«обрезать» («пара».getD 1 "")}⟩ строка {i}"
        r := r.«еслиНе» («пара».length = 2) s!"утверждение «{«имя»}»: связывание строки {i} не «имя: тип»"
        r := r.«еслиНе» («кв».getD k "" = «ждём») s!"утверждение «{«имя»}»: ждём «{«ждём»}», в записи «{«кв».getD k ""}»"
        k := k + 1
      if «огр» ≠ "" then
        let x := «тч».getD tt ""
        r := r.«еслиНе» («т» («уголок» x 1) = «т» «огр» && «номерПосле» x "строка " = i) s!"утверждение «{«имя»}»: ограничение строки {i} не то"
        tt := tt + 1
    r := r.«еслиНе» (k = «кв».length) s!"утверждение «{«имя»}»: связываний {k}, строк «для всех» {«кв».length}"
    r := r.«еслиНе» (tt = «тч».length) s!"утверждение «{«имя»}»: ограничений {tt}, строк «таких что» {«тч».length}"
    r := r.«еслиНе» («целей» = 1) s!"утверждение «{«имя»}»: строк утверждаем {«целей»}"
    «цель0» := «сВписаннымСвидетелем» «цель0» «обр»
    r := «свидетель» r «обр» «имя» «цель0» «гц»
    match «обр».find? (·.startsWith "прогон «") with
    | some «пр» =>
      let «ф» := «ёлочка» «пр» 1; let «ш» := «ёлочка» «пр» 2; let n := «номерПосле» «пр» "строка "
      let «объ» := «какЧитаетЯзык» (s.«сырая» n)
      r := r.«еслиНе» («объ» = s!"тотальная функция «{«ф»}»" || «объ» = s!"функция «{«ф»}»") s!"утверждение «{«имя»}»: прогон «{«ф»}» не объявлен на строке {n}"
      let «тело» := (s.«внутри» «ф»).filter (fun j => (s.«сырая» j).startsWith "  свёртка ")
      r := r.«еслиНе» (!«тело».isEmpty) s!"утверждение «{«имя»}»: прогон «{«ф»}» — тело не свёртка"
      r := r.«еслиНе» («тело».isEmpty || «тело».any (fun j => ((s.«строка» j).splitOn s!"«{«ш»}» от").length > 1)) s!"утверждение «{«имя»}»: свёртка не зовёт «{«ш»}»"
      r := r.«еслиНе» ((«цель0».splitOn s!"«{«ф»}» от").length > 1) s!"утверждение «{«имя»}»: цель не зовёт прогон «{«ф»}»"
    | none => pure ()
    «чья» := «функцияЦели» «цель0» (s.«именаВысказывания» «где»)
    «цель0» := «обещанная» «цель0»
  else
    let «м» := s.«сырая» «где»
    «место» := «обрезать» («безПримечания» «м»)
    let ml := s.«доЗакрытияСкобок» «где» («какЧитаетЯзык» «м»)
    r := r.«еслиНе» («обр».contains "вид postcondition") s!"утверждение «{«имя»}» не «вид postcondition»"
    r := r.«еслиНе» ((ml.splitOn s!"обеспечивает «{«имя»}»").length > 1) s!"строка {«где»} исходника не несёт «обеспечивает «{«имя»}»»"
    r := r.«еслиНе» (s.«хозяин» «где» = «чья0») s!"утверждение «{«имя»}» записано за «{«чья0»}», а строка {«где»} в «{s.«хозяин» «где»}»"
    let «имена» := «именаКвантора» «м»
    let «кв» := «обр».filter (·.startsWith "для всех ")
    let «ждём» := s!"для всех «{"» «".intercalate «имена»}» строка {«где»}"
    r := r.«еслиНе» («кв».length ≤ 1) s!"утверждение «{«имя»}»: строк «для всех» больше одной"
    r := r.«еслиНе» (!«кв».isEmpty || «имена».isEmpty) s!"утверждение «{«имя»}»: квантор постусловия не записан"
    r := r.«еслиНе» («кв».isEmpty || !«имена».isEmpty) s!"утверждение «{«имя»}»: в записи квантор, которого нет"
    r := r.«еслиНе» («кв».isEmpty || «имена».isEmpty || «кв».headD "" = «ждём») s!"утверждение «{«имя»}»: квантор «{«кв».headD ""}», ждём «{«ждём»}»"
    let P := match ml.splitOn " таких что " with
      | _ :: x :: _ => if (x.splitOn " обеспечивает ").length > 1 then «обрезать» ((x.splitOn " обеспечивает ").headD "") else ""
      | _ => ""
    let «тч» := «обр».filter (·.startsWith "таких что ")
    r := r.«еслиНе» (!«тч».isEmpty || P = "") s!"утверждение «{«имя»}»: ограничение «{P}» потеряно"
    r := r.«еслиНе» («тч».isEmpty || P ≠ "") s!"утверждение «{«имя»}»: ограничение без источника"
    r := r.«еслиНе» («тч».isEmpty || P = "" || «тч».all (fun x => «т» («уголок» x 1) = «т» P && «номерПосле» x "строка " = «где»)) s!"утверждение «{«имя»}»: ограничение не то"
    let «хв» := «сВписаннымСвидетелем» (s.«доЗакрытияСкобок» «где» («после» «место» s!"обеспечивает «{«имя»}» ")) «обр»
    r := «свидетель» r «обр» «имя» «хв» «где»
    «цель0» := «обещанная» («цельРазбором» s «чья0» «где» «хв»)
  return (⟨«свои», «обр», «заг», «имя», «доказано», «вердикт», «пр», «место», «цель0», «чья», «функц», «где»⟩, r)
where
  «свидетель» (r : «Суд») («обр» : List String) («имя» «цель» : String) («где» : Nat) : «Суд» :=
    let «св» := («обр».find? (·.startsWith "свидетель ")).getD ""
    let «пп» := («обр».find? (·.startsWith "после подстановки ")).getD ""
    match «существование» «цель» with
    | none => r.«еслиНе» («св» = "" && «пп» = "") s!"утверждение «{«имя»}»: свидетель при цели без существования"
    | some («м», «тт», _) =>
      if «св» = "" || «пп» = "" then r.«беда» s!"утверждение «{«имя»}»: цель с существованием без строк свидетеля"
      else
        let r := r.«еслиНе» («ёлочка» «св» 1 = «м» && «т» («уголок» «св» 1) = «т» «тт» && «номерПосле» «св» "строка " = «где») s!"утверждение «{«имя»}»: свидетель не тот"
        r.«еслиНе» («т» («уголок» «пп» 1) = «обещанная» «цель») s!"утверждение «{«имя»}»: после подстановки не то"

def «судитьУтверждение» («к» : «Контекст») («блок» : String) : «Суд» :=
  let (u, r) := «формаУтверждения» «к» «блок»
  «решениеУтверждения» «к» u r

def «местаСтрок» : List (String × List String) :=
  [("для всех ", ["вид postcondition", "вид statement", "для всех ", "таких что "]),
   ("таких что ", ["для всех ", "таких что "]),
   ("свидетель ", ["вид postcondition", "вид statement", "для всех ", "таких что "]),
   ("после подстановки ", ["свидетель "]),
   ("прогон «", ["для всех ", "таких что ", "вид statement"])]

def «судитьМеста» («зап» : String) : «Суд» :=
  let v := («зап».splitOn "\n").map «обрезать»
  { «беды» := (List.range v.length).flatMap fun i =>
      let l := v.getD i ""
      let «над» := if i > 0 then v.getD (i - 1) "" else ""
      «местаСтрок».flatMap fun (p, «можно») =>
        if l.startsWith p && !(i > 0 && «можно».any («над».startsWith ·)) then
          [s!"строка записи {i + 1} «{l}» стоит не на своём месте"] else [] }

/-- Вердикт блока утверждения: второе слово строки «вердикт …». -/
def «вердиктБлока» (b : String) : String :=
  «слово» (((b.splitOn "\n").map «обрезать»).find? (·.startsWith "вердикт ") |>.getD "") 2

/-- Имя блока утверждения: первая ёлочка первой строки. -/
def «имяБлока» (b : String) : String := «ёлочка» (b.splitOn "\n" |>.headD "") 1

/-- Суд принял — разрешимо: ни беды, ни непонятого, ни места на слове. -/
def «Суд».«принял?» (q : «Суд») : Bool := q.«беды».isEmpty && q.«непонято».isEmpty && q.«наСлово».isEmpty

/-- Реестр растёт, пока шаг находит новые имена, и не дольше запаса. -/
def «нарастить» (f : List String → List String) : Nat → List String → List String
  | 0, «реестр» => «реестр»
  | n + 1, «реестр» =>
    let «новые» := f «реестр»
    if «новые».isEmpty then «реестр» else «нарастить» f n («реестр» ++ «новые»)

/-- Нарезка записи и исходника: всё, что `«сверить»` читает до суда. Чистая функция
    текста; суда в ней нет. Что она режет запись так, как её пишет печать, — сверка
    на корпусе (доверенная база), а не теорема. -/
structure «Нарезка» where
  «строки» : List String
  «кблоки» : List String
  «кисх» : «Исх»
  «катИмена» : List String
  «планы» : List (List String)
  «тблоки» : List (List String)
  «снятия» : List (List String)
  «шапка» : List String
  «блоки» : List String
  «законов» : Option Nat
  «развёртка» : List String
  «строкиП» : List String
  «опр» : List «Определение»
  «исхМ» : «Исх»
  «объявл» : List String
  «оглав» : List String

def «нарезать» («исх» «зап» : String) : «Нарезка» :=
  let «строки» := «строкиПоРусски» («исх».splitOn "\n")
  let «кр» := «зап».splitOn "\nкатегорная теорема "
  let «основа» := if «кр».length > 1 then «часть» «кр» 1 ++ "\nконец записи\n" else «зап»
  let «кблоки» := («кр».drop 1).map (fun x =>
    "категорная теорема " ++ ((x.splitOn "\nконец категорной теоремы").getD 0 "") ++ "\nконец категорной теоремы")
  let «кисх» := («исходник» «исх»).«сМногострочными»
  let «катИмена» := «кисх».«номера».filterMap (fun i =>
    if («кисх».«сырая» i).startsWith "теорема «" && «Категории».«теоремаОКатегориях?» «кисх» i
    then some («Категории».«вЁлочке» («кисх».«строка» i)) else none)
  let «п» := «основа».splitOn "\nплан "
  let «т» := («часть» «п» 1).splitOn "\nтотальность "
  let «с» := («часть» «т» 1).splitOn "\nснятие "
  let «части» := («часть» «с» 1).splitOn "\nутверждение "
  let «шапка» := («часть» «части» 1).splitOn "\n"
  let «блоки» := «части».filter (fun x => !(x.startsWith "запись доказательства"))
  -- ADR-0121: строка шапки `законов N` — к исходнику приписана развёртка законов,
  -- и порождает её сверщик сам; без строки (запись ядра до ADR-0121) развёртки нет.
  let «законов» := («шапка».find? (·.startsWith "законов ")).bind (fun l => «целое?» (l.«сн» 8))
  -- ADR-0196 §5: запись, напечатанная двоичным без законов монады, несёт их меньше
  -- ровно на законы монад; её развёртка — без них.
  let «счётЗаконов» := fun (d : List String) => (d.filter (·.startsWith "утверждение «")).length
  let «полная» := if «законов».isSome then «законыТекстом» «строки» else []
  let «развёртка» := match «законов» with
    | some n =>
      if n = «счётЗаконов» «полная» then «полная» else
      let «база» := «законыТекстомВида» «строки» false
      if n = «счётЗаконов» «база» then «база» else «полная»
    | none => []
  let «строкиП» := «строки» ++ «развёртка»
  { «строки» := «строки», «кблоки» := «кблоки», «кисх» := «кисх», «катИмена» := «катИмена»,
    «планы» := («п».drop 1).map (fun x => ("план " ++ x).splitOn "\n"),
    «тблоки» := («т».drop 1).map (fun x => ("тотальность " ++ x).splitOn "\n"),
    «снятия» := («с».drop 1).map (fun x => ("снятие " ++ x).splitOn "\n"),
    «шапка» := «шапка», «блоки» := «блоки», «законов» := «законов», «развёртка» := «развёртка»,
    «строкиП» := «строкиП»,
    «опр» := «определения» «строкиП» («строкиРазв3» «зап»),
    «исхМ» := ({ «исходник» «исх» with «сырые» := «строкиП».toArray } : «Исх»).«сМногострочными»,
    «объявл» := («блоки».filter (fun b => «вердиктБлока» b = "доказано")).map «имяБлока»,
    «оглав» := («шапка».map «обрезать»).filter (·.startsWith "таблица «") }

/-- Свои строки блока тотальности: до «конец тотальности» включительно. -/
def «Нарезка».«тсобств» («н» : «Нарезка») : List (List String) :=
  «н».«тблоки».map (fun b => (b.takeWhile (· ≠ "  конец тотальности")) ++
    (if b.contains "  конец тотальности" then ["  конец тотальности"] else []))

/-- Строки после блоков тотальности: печать оставляет там только пустую и «конец записи». -/
def «Нарезка».«тхвосты» («н» : «Нарезка») : List String :=
  «н».«тблоки».flatMap (fun b => (b.dropWhile (· ≠ "  конец тотальности")).drop 1)

def «Нарезка».«контекст» («н» : «Нарезка») («реестр» : List String) : «Контекст» :=
  ⟨«н».«исхМ», «н».«строкиП», «н».«опр», «реестр», «н».«объявл», «н».«оглав»⟩

/-- Имена доказанных блоков, которых в реестре ещё нет и которые суд с этим реестром принял. -/
def «Нарезка».«новыеВРеестр» («н» : «Нарезка») («реестр» : List String) : List String :=
  («н».«блоки».filter (fun b =>
    !«реестр».contains («имяБлока» b) && «вердиктБлока» b = "доказано" &&
      («судитьУтверждение» («н».«контекст» «реестр») b).«принял?»)).map «имяБлока»

/-- Реестр доказанных утверждений записи: неподвижная точка либо запас «блоков плюс один». -/
def «Нарезка».«реестр» («н» : «Нарезка») : List String :=
  «нарастить» «н».«новыеВРеестр» («н».«блоки».length + 1) []

/-- Привязка записи к исходнику криптографическая: строка «отпечаток256» есть и её
    отпечаток — SHA-256 байтов исходника. -/
def «Нарезка».«крипто» («н» : «Нарезка») («исх» : String) : Bool :=
  match «н».«шапка».find? (·.startsWith "отпечаток256 ") with
  | some l => ((l.splitOn " ").getD 1 "") = «sha256» «исх».toUTF8
  | none => false

/-- Путь, которым запись зовёт свой исходник, — тот, с которым её сверяют. -/
def «Нарезка».«путьТот» («н» : «Нарезка») («путь» «каталог» : String) : Bool :=
  «путьСовпал» ((«часть» «н».«шапка» 2).«сн» 9) (if «путь».startsWith "/" then «путь» else «каталог» ++ "/" ++ «путь»)

/-- Теоремы и следствия исходника, о которых запись молчит. -/
def «Нарезка».«замолчано» («н» : «Нарезка») : List String :=
  let «имена» := «н».«блоки».map (fun b => «ёлочка» («часть» (b.splitOn "\n") 1) 1)
  «н».«строкиП».flatMap fun l =>
    let t := «какЧитаетЯзык» l
    if (l.startsWith "теорема" && t.startsWith "теорема «") || l.startsWith "следует «" then
      let n := «ёлочка» t 1
      if !(«имена».contains n) && !(l.startsWith "теорема «" && «н».«катИмена».contains n) then [n] else []
    else []

/-- Сколько в исходнике постусловий: строк кода со словом «обеспечивает «». -/
def «Нарезка».«постусловий» («н» : «Нарезка») : Nat :=
  let «кодИсх» := «кодИсходника» ("\n".intercalate «н».«строкиП»)
  ((List.range' 1 «н».«строкиП».length).filter (fun i =>
    ((«кодСтроки» «кодИсх» i).splitOn "обеспечивает «").length > 1)).length

/-- Сколько в исходнике высказываний: строк «утверждение «…»», с развёрткой законов. -/
def «Нарезка».«высказываний» («н» : «Нарезка») : Nat :=
  («н».«строкиП».filter (·.startsWith "утверждение «")).length

/-- Беды привязки записи к исходнику и полноты: шапка, счёт строк и знаков, отпечатки,
    путь, число утверждений, конец записи, законы, умолчания. Пусто — запись от этой
    программы и говорит обо всех её постусловиях, высказываниях и теоремах. -/
def «Нарезка».«бедыПривязки» («н» : «Нарезка») («исх» «путь» «зап» «каталог» : String) : List String :=
  let «отп» := (((«часть» «н».«шапка» 5).splitOn " ").drop 1).map String.toNat?
  let «ш256» := «sha256» «исх».toUTF8
  let «порождено» := («н».«развёртка».filter (·.startsWith "утверждение «")).length
  «если» («часть» «н».«шапка» 1 = "запись доказательства 1")
      "шапка не та: первой строкой обязано стоять «запись доказательства 1»" ++
    «если» («номерПослеМ» («часть» «н».«шапка» 3) "строк " = some «н».«строки».length)
      s!"в записи строк не {«н».«строки».length} — запись не от этой программы" ++
    «если» («номерПослеМ» («часть» «н».«шапка» 4) "знаков " = some «исх».length)
      s!"в записи знаков не {«исх».length} — запись не от этой программы" ++
    «если» («отп».head? = some (some («отпечаток» «исх» 131 1000000007)))
      "первый отпечаток не сошёлся — запись не от этой программы" ++
    «если» («отп»[1]? = some (some («отпечаток» «исх» 137 998244353)))
      "второй отпечаток не сошёлся — запись не от этой программы" ++
    «если» (!(«н».«шапка».any (·.startsWith "отпечаток256 ")) || «н».«крипто» «исх»)
      s!"отпечаток256 записи не сошёлся с исходником «{«ш256»}»" ++
    «если» («н».«путьТот» «путь» «каталог» || «н».«крипто» «исх»)
      s!"запись зовёт своим исходником «{(«часть» «н».«шапка» 2).«сн» 9}», а сверяется с «{«путь»}»" ++
    «если» («номерПослеМ» («часть» «н».«шапка» 7) "утверждений " = some «н».«блоки».length)
      "шапка обещает не столько утверждений, сколько в записи" ++
    «если» (((«зап».splitOn "\n").map String.«обр»).any (· = "конец записи"))
      "запись не кончается словами «конец записи» — она обрублена" ++
    (match «н».«законов» with
      | some n => «если» (n = «порождено») s!"шапка обещает законов {n}, а объявления исходника порождают {«порождено»}"
      | none => []) ++
    «если» «н».«замолчано».isEmpty
      s!"в исходнике есть теоремы, о которых запись молчит: {", ".intercalate «н».«замолчано»}" ++
    «если» («н».«постусловий» + «н».«высказываний» = «н».«блоки».length)
      s!"в исходнике постусловий {«н».«постусловий»}, а в записи утверждений {«н».«блоки».length} — запись говорит не обо всей программе"

/-- Суды записи по порядку печати бед: планы, хвосты тотальностей, тотальности, шапка,
    чтение шапки, привязка, утверждения, круги, места строк, снятия, категорные теоремы,
    их полнота. `«сверить»` только склеивает их; теорема «проверено-по-частям»
    (`Verified.lean`) читает этот список. -/
def «Нарезка».«суды» («н» : «Нарезка») («исх» «путь» «зап» «каталог» : String) : List «Суд» :=
  let «к» := «н».«контекст» «н».«реестр»
  [«судитьПланы» («исходник» «исх»).«сМногострочными» «н».«планы»,
   { «беды» := «н».«тхвосты».flatMap (fun l =>
       «если» (l = "" || l = "конец записи") s!"строка «{l}» после блока тотальности не узнана") },
   «судитьТотальности» («исходник» ("\n".intercalate «н».«строкиП»)).«сМногострочными»
     ((«н».«шапка».find? (·.startsWith "тотальностей ")).bind (fun l => «целое?» (l.«сн» 13))) «н».«тсобств»,
   «судитьШапку» («исходник» «исх»).«сМногострочными» «н».«шапка»,
   { «непонято» := «н».«шапка».flatMap (fun l =>
       if «шапкаПонятна» l.«обр» then [] else [s!"строка шапки «{l.«обр»}»"]) },
   { «беды» := «н».«бедыПривязки» «исх» «путь» «зап» «каталог» }] ++
  «н».«блоки».map («судитьУтверждение» «к») ++
  [«кругиЗаписи» («н».«блоки».map (·.splitOn "\n")),
   «судитьМеста» «зап»,
   «судитьСнятия» «н».«исхМ» «н».«строкиП» «н».«опр» «правилаЯдра» «н».«реестр» «н».«объявл» «н».«снятия»] ++
  «н».«кблоки».map (fun b => { «беды» := («Категории».«судить» «н».«кисх» b).«беды» }) ++
  [{ «беды» := «Категории».«полнота» «н».«кисх» «н».«кблоки» }]

def «сверить» («исх» : String) («путь» : String) («зап» : String) («каталог» : String) : «Итог» :=
  let «н» := «нарезать» «исх» «зап»
  let «суды» := «н».«суды» «исх» «путь» «зап» «каталог»
  { «беды» := «суды».flatMap (·.«беды»),
    «непонято» := «суды».flatMap (·.«непонято»),
    «наСлово» := «суды».flatMap (·.«наСлово»),
    «утверждений» := «н».«блоки».length + «н».«кблоки».length,
    «доказанных» := («н».«блоки».filter (fun b => «вердиктБлока» b = "доказано")).length +
      («н».«кблоки».filter (fun b => («Категории».«судить» «н».«кисх» b).«доказано»)).length,
    «крипто» := «н».«крипто» «исх»,
    «приметы» := if !(«н».«путьТот» «путь» «каталог») && «н».«крипто» «исх» then ["поле исходник — примета"] else [],
    «секций» := «н».«планы».length + «н».«тблоки».length }

def «исход» (r : «Итог») : String × UInt32 :=
  if !r.«беды».isEmpty then (s!"НЕ СОШЛОСЬ: {"; ".intercalate r.«беды»}", 1)
  else if !r.«непонято».isEmpty then
    let n := r.«непонято».length
    (s!"НЕ ВЗЯЛСЯ ЦЕЛИКОМ — мест вне чтения {n}: {"; ".intercalate r.«непонято»}", 4)
  else if !r.«крипто» then ("НЕ ПРОВЕРЕНО — привязка к программе не криптографическая: строки отпечаток256 в записи нет", 3)
  else if !r.«наСлово».isEmpty then (s!"НЕ ПРОВЕРЕНО — на слово взято мест {r.«наСлово».length}: {"; ".intercalate r.«наСлово»}", 3)
  else if r.«утверждений» = 0 && r.«секций» > 0 then ("ПРОВЕРЕНО — утверждений в записи нет, тотальности и план сверены с исходником", 0)
  else if r.«доказанных» = 0 then ("НЕ ПРОВЕРЕНО — ВПУСТУЮ: доказанным в записи не числится ничего", 3)
  else (s!"ПРОВЕРЕНО — утверждений {r.«утверждений»}, доказанных {r.«доказанных»}, блоки вывода приняты", 0)

end «Второй»

def main (args : List String) : IO UInt32 := do
  match args with
  | ["--перебор", «зап»] =>
    let «тз» ← IO.FS.readFile «зап»
    let (s, k) := «Перебор».«сверить» «тз»
    IO.println s
    pure k
  | [«исх», «зап»] =>
    let «б» ← IO.FS.readBinFile «исх»
    let «тз» ← IO.FS.readFile «зап»
    match String.fromUTF8? «б» with
    | none =>
      IO.println "НЕ ВЗЯЛСЯ ЦЕЛИКОМ: исходник не в UTF-8"
      pure 4
    | some «т» =>
      let «кат» ← IO.currentDir
      let (s, k) := «Второй».«исход» («Второй».«сверить» «т» «исх» «тз» «кат».toString)
      IO.println s
      pure k
  | _ =>
    IO.eprintln "звать: второй-сверщик <исходник.flang> <запись>"
    pure 2
