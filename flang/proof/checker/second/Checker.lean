    return r.«и» («судитьТеорему» t «заг» «к».«строки» «к».«опр»)
  let «спрятана» := s.«номера».any (fun i => let t := «обрезать» («безПримечания» (s.«сырая» i)); t = s!"теорема «{«имя»}»" || t = s!"следует «{«имя»}»")
  r := r.«еслиНе» (!«спрятана») s!"в записи сказано «теоремы нет», а в исходнике теорема «{«имя»}» написана"
  let («обязательства», «нечем») := «судитьОбязательства» s «к».«строки» «обр» «имя» «чья»
  r := r.«и» «обязательства»
  let «естьХоды» := «обр».contains "ход цель"
  let «естьПринцип» := «есть» "принцип "
  let «верхний» := match «обр».find? (fun l => l.startsWith "посылка " || l = "ход цель") with
    | some l => l = "ход цель"
    | none => false
  let «посылки» := «есть» "посылка "
  let mut «проигран» := false
  if «доказано» && «есть» "вывод " then
    r := r.«еслиНе» (!«посылки») s!"утверждение «{«имя»}»: под блоком вывода стоят посылки"
    r := r.«еслиНе» (!«естьХоды») s!"утверждение «{«имя»}»: и ходы, и вывод"
    if !«посылки» && !«естьХоды» then
      let q := ({} : «Суд»).«выводом» «имя» ("утверждение " ++ «заг») ((«обр».drop 1).filter (· ≠ "")) «к».«строки» «к».«опр» s «к».«доказанные»
      r := r.«и» q
      if «нечем» > 0 then r := r.«слово» s!"утверждение «{«имя»}»: вывод стоит на обязательстве входа, которое закрыть нечем"
      «проигран» := q.«беды».isEmpty && q.«непонято».isEmpty && «нечем» = 0
  else if «естьХоды» && (!«естьПринцип» || «верхний») then
    if «доказано» then
      let «д» := s.«доводы» «чья»
      let o : «Обст» := { «исх» := s }
      let o := { o with «свои» := «обр», «цель» := «т» «цель0», «функция» := «чья» }
      let o := { o with «по» := («д».«имена».headD ""), «хвост» := «д».«хвост», «обяз» := «имя» }
      let o := { o with «доказанные» := «к».«доказанные», «объявленные» := «к».«объявленные», «ограничения» := s.«ограничения» «место» }
      let p := «проигратьБлок» o
      r := r.«еслиНе» p.«беды».isEmpty s!"утверждение «{«имя»}», сведение: {"; ".intercalate p.«беды»}"
      for x in p.«неВзялся» do r := r.«слово» s!"утверждение «{«имя»}», сведение: {x}"
      «проигран» := p.«беды».isEmpty && p.«проиграно» > 0
      if p.«беды».isEmpty && p.«проиграно» = 0 && p.«неВзялся».isEmpty then
        r := r.«слово» s!"утверждение «{«имя»}»: ходы ничего не свели"
  else if «доказано» then
    let m : «Место» := { «свои» := «обр», «имя» := «имя», «чья» := «чья», «цель» := «цель0»,
                         «высказывание» := if «функц» then none else some («какЧитаетЯзык» (s.«сырая» «где»)),
                         «доказанные» := «к».«доказанные», «объявленные» := «к».«объявленные» }
    let h := «крюкиПоТелу» ⟨s, «к».«огл»⟩ m
    for b in h.«беды» do r := r.«беда» b
    «проигран» := h.«снял» ≠ ""
    if h.«снял» = "" then
      r := r.«слово» s!"утверждение «{«имя»}»: вердикт «доказано», а за место не взялся ни один приём по телу функции — место на слове ядра"
    if «есть» "ход " && h.«снял» = "" then
      let p := «ходыПодПосылками» s «обр» «цель0» «чья» «имя» «место» «к».«доказанные» «к».«объявленные»
      for b in p.«беды» do
        r := r.«слово» s!"утверждение «{«имя»}»: ход под посылкой не сходится — {b}; место и так на слове ядра"
  r := r.«и» («судитьПосылки» s «обр» «имя» «чья» «вердикт» «место» s!"утверждение «{«имя»}»" «проигран» false)
  return r
where
  «свидетель» (r : «Суд») («обр» : List String) («имя» «цель» : String) («где» : Nat) : «Суд» :=
    let «св» := («обр».find? (·.startsWith "свидетель ")).getD ""
    let «пп» := («обр».find? (·.startsWith "после подстановки ")).getD ""
    match «существование» «цель» with
    | none => r.«еслиНе» («св» = "" && «пп» = "") s!"утверждение «{«имя»}»: свидетель при цели без существования"
    | some («м», «тт», _) =>
      if «св» = "" || «пп» = "" then r.«беда» s!"утверждение «{«имя»}»: цель с существованием без строк свидетеля"
      else
        let r := r.«еслиНе» («ёлочка» «св» 1 = «м» && «т» («уголок» «св» 1) = «т» «тт» && «номерПосле» «св» "строка " = «где») s!"утверждение «{«имя»}»: свидетель не тот"
        r.«еслиНе» («т» («уголок» «пп» 1) = «обещанная» «цель») s!"утверждение «{«имя»}»: после подстановки не то"

def «местаСтрок» : List (String × List String) :=
  [("для всех ", ["вид postcondition", "вид statement", "для всех ", "таких что "]),
   ("таких что ", ["для всех "]),
   ("свидетель ", ["вид postcondition", "вид statement", "для всех ", "таких что "]),
   ("после подстановки ", ["свидетель "]),
   ("прогон «", ["для всех ", "таких что ", "вид statement"])]

def «судитьМеста» («зап» : String) : «Суд» := Id.run do
  let v := («зап».splitOn "\n").map «обрезать»
  let mut r : «Суд» := {}
  for i in List.range v.length do
    let l := v.getD i ""
    let «над» := if i > 0 then v.getD (i - 1) "" else ""
    for (p, «можно») in «местаСтрок» do
      if l.startsWith p && !(i > 0 && «можно».any («над».startsWith ·)) then
        if p = "таких что " && «над».startsWith "таких что " then
          r := r.«не» s!"строка записи {i + 1} «{l}» стоит под другой «таких что», как ставит печать, а checker.c ждёт над ней «для всех»"
        else
          r := r.«беда» s!"строка записи {i + 1} «{l}» стоит не на своём месте"
  return r

def «сверить» («исх» : String) («путь» : String) («зап» : String) («каталог» : String) : «Итог» := Id.run do
  let «строки» := «исх».splitOn "\n"
  let «п» := «зап».splitOn "\nплан "
  let «т» := («часть» «п» 1).splitOn "\nтотальность "
  let «с» := («часть» «т» 1).splitOn "\nснятие "
  let «голова» := «часть» «с» 1
  let «части» := «голова».splitOn "\nутверждение "
  let «шапка» := («часть» «части» 1).splitOn "\n"
  let «блоки» := «части».filter (fun x => !(x.startsWith "запись доказательства"))
  let mut r : «Итог» := {}
  r := r.«сСудом» («судитьПланы» («исходник» «исх») ((«п».drop 1).map (fun x => ("план " ++ x).splitOn "\n")))
  r := { r with «секций» := r.«секций» + («п».length - 1) }
  let «тблоки» := («т».drop 1).map (fun x => ("тотальность " ++ x).splitOn "\n")
  let «тсобств» := «тблоки».map (fun b => (b.takeWhile (· ≠ "  конец тотальности")) ++ (if b.contains "  конец тотальности" then ["  конец тотальности"] else []))
  let «тхвосты» := «тблоки».flatMap (fun b => (b.dropWhile (· ≠ "  конец тотальности")).drop 1)
  for l in «тхвосты» do
    if !(l = "" || l = "конец записи") then r := «беда» r s!"строка «{l}» после блока тотальности не узнана"
  let «тсуд» := «судитьТотальности» («исходник» «исх») ((«шапка».find? (·.startsWith "тотальностей ")).bind (fun l => «целое?» (l.«сн» 13))) «тсобств»
  r := { r with «беды» := r.«беды» ++ «тсуд».«беды», «непонято» := r.«непонято» ++ «тсуд».«непонято»,
                «наСлово» := r.«наСлово» ++ «тсуд».«наСлово», «секций» := r.«секций» + «тблоки».length }
  r := r.«сСудом» («судитьШапку» («исходник» «исх») «шапка»)
  for l in «шапка» do
    if !(«шапкаПонятна» l.«обр») then r := «непонятно» r s!"строка шапки «{l.«обр»}»"
  let «ш256» := «sha256» «исх».toUTF8
  r := «еслиНе» r («часть» «шапка» 1 = "запись доказательства 1")
    "шапка не та: первой строкой обязано стоять «запись доказательства 1»"
  r := «еслиНе» r («номерПослеМ» («часть» «шапка» 3) "строк " = some «строки».length)
    s!"в записи строк не {«строки».length} — запись не от этой программы"
  r := «еслиНе» r («номерПослеМ» («часть» «шапка» 4) "знаков " = some «исх».length)
    s!"в записи знаков не {«исх».length} — запись не от этой программы"
  let «отп» := (((«часть» «шапка» 5).splitOn " ").drop 1).map String.toNat?
  r := «еслиНе» r («отп».head? = some (some («отпечаток» «исх» 131 1000000007)))
    "первый отпечаток не сошёлся — запись не от этой программы"
  r := «еслиНе» r («отп»[1]? = some (some («отпечаток» «исх» 137 998244353)))
    "второй отпечаток не сошёлся — запись не от этой программы"
  match «шапка».find? (·.startsWith "отпечаток256 ") with
  | some l =>
    if ((l.splitOn " ").getD 1 "") = «ш256» then r := { r with «крипто» := true }
    else r := «беда» r s!"отпечаток256 записи не сошёлся с исходником «{«ш256»}»"
  | none => pure ()
  let «заявлен» := («часть» «шапка» 2).«сн» 9
  let «полный» := if «путь».startsWith "/" then «путь» else «каталог» ++ "/" ++ «путь»
  if !(«путьСовпал» «заявлен» «полный») then
    if r.«крипто» then r := { r with «приметы» := r.«приметы» ++ ["поле исходник — примета"] }
    else r := «беда» r s!"запись зовёт своим исходником «{«заявлен»}», а сверяется с «{«путь»}»"
  r := «еслиНе» r («номерПослеМ» («часть» «шапка» 7) "утверждений " = some «блоки».length)
    "шапка обещает не столько утверждений, сколько в записи"
  r := «еслиНе» r (((«зап».splitOn "\n").map String.«обр»).any (· = "конец записи"))
    "запись не кончается словами «конец записи» — она обрублена"
  let «имена» := «блоки».map (fun b => «ёлочка» («часть» (b.splitOn "\n") 1) 1)
  let mut «замолчано» : List String := []
  let mut «постусловий» := 0
  let mut «высказываний» := 0
  for l in «строки» do
    let t := «какЧитаетЯзык» l
    if (l.startsWith "теорема" && t.startsWith "теорема «") || l.startsWith "следует «" then
      let n := «ёлочка» t 1
      if !(«имена».contains n) then «замолчано» := «замолчано» ++ [n]
    if (t.splitOn "обеспечивает «").length > 1 then «постусловий» := «постусловий» + 1
    if l.startsWith "утверждение «" then «высказываний» := «высказываний» + 1
  r := «еслиНе» r «замолчано».isEmpty
    s!"в исходнике есть теоремы, о которых запись молчит: {", ".intercalate «замолчано»}"
  r := «еслиНе» r («постусловий» + «высказываний» = «блоки».length)
    s!"в исходнике постусловий {«постусловий»}, а в записи утверждений {«блоки».length} — запись говорит не обо всей программе"
  let «опр» := «определения» «строки» («строкиРазв3» «зап»)
  let «исхМ» := «исходник» «исх»
  let «вердиктБлока» := fun (b : String) => «слово» (((b.splitOn "\n").map «обрезать»).find? (·.startsWith "вердикт ") |>.getD "") 2
  let «объявл» := («блоки».filter (fun b => «вердиктБлока» b = "доказано")).map (fun b => «ёлочка» (b.splitOn "\n" |>.headD "") 1)
  let mut «реестр» : List String := []
  let «оглав» := («шапка».map «обрезать»).filter (·.startsWith "таблица «")
  for _ in [0:«блоки».length + 1] do
    let «к» : «Контекст» := ⟨«исхМ», «строки», «опр», «реестр», «объявл», «оглав»⟩
    let «новые» := «блоки».filter (fun b =>
      let n := «ёлочка» (b.splitOn "\n" |>.headD "") 1
      !«реестр».contains n && «вердиктБлока» b = "доказано" &&
        (let q := «судитьУтверждение» «к» b; q.«беды».isEmpty && q.«непонято».isEmpty && q.«наСлово».isEmpty))
    if «новые».isEmpty then break
    «реестр» := «реестр» ++ «новые».map (fun b => «ёлочка» (b.splitOn "\n" |>.headD "") 1)
  let «к» : «Контекст» := ⟨«исхМ», «строки», «опр», «реестр», «объявл», «оглав»⟩
  for b in «блоки» do
    let q := «судитьУтверждение» «к» b
    r := { r with «беды» := r.«беды» ++ q.«беды», «непонято» := r.«непонято» ++ q.«непонято», «наСлово» := r.«наСлово» ++ q.«наСлово»,
                  «утверждений» := r.«утверждений» + 1, «доказанных» := r.«доказанных» + (if «вердиктБлока» b = "доказано" then 1 else 0) }
  r := r.«сСудом» («кругиЗаписи» («блоки».map (·.splitOn "\n")))
  r := r.«сСудом» («судитьМеста» «зап»)
  r := r.«сСудом» («судитьСнятия» «исхМ» «строки» «опр» «правилаЯдра» «реестр» «объявл» ((«с».drop 1).map (fun x => ("снятие " ++ x).splitOn "\n")))
  return r

def «исход» (r : «Итог») : String × UInt32 :=
  if !r.«беды».isEmpty then (s!"НЕ СОШЛОСЬ: {"; ".intercalate r.«беды»}", 1)
  else if !r.«непонято».isEmpty then
    let n := r.«непонято».length
    (s!"НЕ ВЗЯЛСЯ ЦЕЛИКОМ — мест вне чтения {n}: {"; ".intercalate r.«непонято»}", 4)
  else if !r.«крипто» then ("НЕ ПРОВЕРЕНО — привязка к программе не криптографическая: строки отпечаток256 в записи нет", 3)
  else if !r.«наСлово».isEmpty then (s!"НЕ ПРОВЕРЕНО — на слово взято мест {r.«наСлово».length}: {"; ".intercalate r.«наСлово»}", 3)
  else if r.«утверждений» = 0 && r.«секций» > 0 then ("ПРОВЕРЕНО — утверждений в записи нет, тотальности и план сверены с исходником", 0)
  else if r.«доказанных» = 0 then ("НЕ ПРОВЕРЕНО — ВПУСТУЮ: доказанным в записи не числится ничего", 3)
  else (s!"ПРОВЕРЕНО — утверждений {r.«утверждений»}, доказанных {r.«доказанных»}, блоки вывода приняты", 0)

end «Второй»

def main (args : List String) : IO UInt32 := do
  match args with
  | [«исх», «зап»] =>
    let «б» ← IO.FS.readBinFile «исх»
    let «тз» ← IO.FS.readFile «зап»
    match String.fromUTF8? «б» with
    | none =>
      IO.println "НЕ ВЗЯЛСЯ ЦЕЛИКОМ: исходник не в UTF-8"
      pure 4
    | some «т» =>
      let «кат» ← IO.currentDir
      let (s, k) := «Второй».«исход» («Второй».«сверить» «т» «исх» «тз» «кат».toString)
      IO.println s
      pure k
  | _ =>
    IO.eprintln "звать: второй-сверщик <исходник.flang> <запись>"
    pure 2
