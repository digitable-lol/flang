import Terms

open «Разбор»

namespace «Второй»

/-!
Законы категорной поверхности как утверждения за концом файла (ADR-0121).

Запись со строкой шапки `законов N` несёт N утверждений, которых в файле не
написано: их текст порождён из объявлений моноида, свойств «коммутативность» и
«дистрибутивность», изоморфизма, функтора и преобразования и приписан к исходнику
после перевода строки. Сверщик текста из записи не берёт — он порождает его сам,
по описанию правила в ADR-0121, §2, а не по коду сверщика на C, и приписывает к
строкам исходника. Закон о другом носителе, пропущенный или лишний закон не
сойдутся с порождённым, и сверка скажет это так же, как о любом утверждении.
-/

structure «ОбъявлениеЗакона» where
  «заголовок» : String
  «поля» : List String
  «годно» : Bool

def «годнаЗаконам» (l : String) : Bool :=
  !((l.splitOn "//").length > 1) && !((l.splitOn "\t").length > 1) && !((l.splitOn "\r").length > 1)

def «заголовокЗаконов» (l : String) : Bool :=
  l.startsWith "моноид «" || l.startsWith "свойство «" || l.startsWith "изоморфизм «" ||
  l.startsWith "функтор «" || l.startsWith "морфизм «"

/-- Поле — строка блока с отступом ровно в два пробела; глубже — не поле. -/
def «полеСтроки» (l : String) : Option String :=
  if l.startsWith "  " then
    let r := (l.drop 2).toString
    if r = "" || r.startsWith " " then none else some r
  else none

def «объявленияЗаконов» («строки» : List String) : List «ОбъявлениеЗакона» :=
  let rec «идти» : List String → List «ОбъявлениеЗакона»
    | [] => []
    | g :: rest =>
      if «заголовокЗаконов» g then
        let «блок» := rest.takeWhile (fun l => l.startsWith " ")
        ⟨g, «блок».filterMap «полеСтроки», «годнаЗаконам» g && «блок».all «годнаЗаконам»⟩ :: «идти» rest
      else «идти» rest
  «идти» «строки»

def «полеЗакона» (o : «ОбъявлениеЗакона») («начало» : String) : String :=
  match o.«поля».find? (·.startsWith «начало») with
  | some p => (p.drop «начало».length).toString
  | none => ""

def «имяПоляЗакона» (o : «ОбъявлениеЗакона») («начало» : String) : String :=
  let x := «полеЗакона» o «начало»
  let n := «ёлочка» x 1
  if x = s!"«{n}»" then n else ""

def «видЗакона» (o : «ОбъявлениеЗакона») : String :=
  let z := o.«заголовок»
  let p := «ёлочка» z 1
  let b := «ёлочка» z 2
  let c := «ёлочка» z 3
  let izv := s!"{p}» из «{b}» в «{c}»"
  if !o.«годно» then ""
  else if z = s!"моноид «{p}»" then "моноид"
  else if z = "свойство «коммутативность»" || z = "свойство «дистрибутивность»" then p
  else if z = s!"изоморфизм «{izv}" then "изоморфизм"
  else if z = s!"функтор «{izv}" then "функтор"
  else if z = s!"морфизм «{p}» из функтора «{b}» в функтор «{c}»" then "преобразование"
  else if z = s!"морфизм «{izv}" then "морфизм"
  else ""

def «скобкиЗакона» (t : String) : Bool :=
  (t.splitOn "(").length = (t.splitOn ")").length && (t.splitOn "[").length = (t.splitOn "]").length &&
  (t.splitOn "{").length = (t.splitOn "}").length

def «вызовЗакона» (f d : String) : String := s!"(«{f}» от {d})"

def «связкиЗакона» (t : String) (n : Nat) : String :=
  " и ".intercalate ((["а", "б", "ц"].take n).map (fun x => s!"{x}: {t}"))

def «закон» («имя» «вид» «связки» l r : String) : List String :=
  [s!"утверждение «{«имя»} — {«вид»}»", s!"  для всех {«связки»}", s!"  утверждаем {l} равен {r}"]

def «законыМоноида» (o : «ОбъявлениеЗакона») : List String :=
  let n := «ёлочка» o.«заголовок» 1
  let t := «полеЗакона» o "носитель "
  let op := «имяПоляЗакона» o "операция "
  let e := «полеЗакона» o "единица "
  let inv := «имяПоляЗакона» o "обратный элемент "
  let ed := s!"({e})"
  let one := «связкиЗакона» t 1
  if t = "" || op = "" || !«скобкиЗакона» t then [] else
  let assoc := «закон» n "ассоциативность" («связкиЗакона» t 3)
    («вызовЗакона» op s!"{«вызовЗакона» op "а и б"} и ц") («вызовЗакона» op s!"а и {«вызовЗакона» op "б и ц"}")
  if e = "" || !«скобкиЗакона» e then assoc else
  let units := «закон» n "единица слева" one («вызовЗакона» op s!"{ed} и а") "а" ++
    «закон» n "единица справа" one («вызовЗакона» op s!"а и {ed}") "а"
  if inv = "" then assoc ++ units else
  assoc ++ units ++
    «закон» n "обратный слева" one («вызовЗакона» op s!"{«вызовЗакона» inv "а"} и а") ed ++
    «закон» n "обратный справа" one («вызовЗакона» op s!"а и {«вызовЗакона» inv "а"}") ed

def «законыСвойства» (o : «ОбъявлениеЗакона») («вид» : String) : List String :=
  let t := «полеЗакона» o "носитель "
  let op := «имяПоляЗакона» o "операция "
  let po := «имяПоляЗакона» o "по "
  if t = "" || op = "" || !«скобкиЗакона» t then []
  else if «вид» = "коммутативность" then
    «закон» op "коммутативность" («связкиЗакона» t 2) («вызовЗакона» op "а и б") («вызовЗакона» op "б и а")
  else if po = "" then []
  else
    «закон» op "дистрибутивность слева" («связкиЗакона» t 3) («вызовЗакона» op s!"а и {«вызовЗакона» po "б и ц"}")
      («вызовЗакона» po s!"{«вызовЗакона» op "а и б"} и {«вызовЗакона» op "а и ц"}") ++
    «закон» op "дистрибутивность справа" («связкиЗакона» t 3) («вызовЗакона» op s!"{«вызовЗакона» po "а и б"} и ц")
      («вызовЗакона» po s!"{«вызовЗакона» op "а и ц"} и {«вызовЗакона» op "б и ц"}")

def «объявлениеЗакона» («все» : List «ОбъявлениеЗакона») («вид» «имя» : String) : Option «ОбъявлениеЗакона» :=
  «все».find? (fun o => «видЗакона» o = «вид» && «ёлочка» o.«заголовок» 1 = «имя»)

def «конецСтрелки» («все» : List «ОбъявлениеЗакона») (m : String) (k : Nat) : String :=
  match «объявлениеЗакона» «все» "морфизм" m with
  | some o => «ёлочка» o.«заголовок» k
  | none => ""

def «даётСтрелки» («все» : List «ОбъявлениеЗакона») (m a b : String) : String :=
  match «все».find? (fun o => «видЗакона» o = "морфизм" && «ёлочка» o.«заголовок» 1 = m &&
      «ёлочка» o.«заголовок» 2 = a && «ёлочка» o.«заголовок» 3 = b) with
  | some o => «имяПоляЗакона» o "даёт "
  | none => ""

def «даётПоИмени» («все» : List «ОбъявлениеЗакона») (m : String) : String :=
  «даётСтрелки» «все» m («конецСтрелки» «все» m 2) («конецСтрелки» «все» m 3)

def «законыИзоморфизма» (o : «ОбъявлениеЗакона») («все» : List «ОбъявлениеЗакона») : List String :=
  let n := «ёлочка» o.«заголовок» 1
  let a := «ёлочка» o.«заголовок» 2
  let b := «ёлочка» o.«заголовок» 3
  let f := «даётСтрелки» «все» («имяПоляЗакона» o "прямой морфизм ") a b
  let g := «даётСтрелки» «все» («имяПоляЗакона» o "обратный морфизм ") b a
  if f = "" || g = "" then [] else
  «закон» n "обратный после прямого" s!"х: «{a}»" («вызовЗакона» g («вызовЗакона» f "х")) "х" ++
  «закон» n "прямой после обратного" s!"х: «{b}»" («вызовЗакона» f («вызовЗакона» g "х")) "х"

/-- Образ объекта у функтора: `объект «А» отображается в «Б»` либо с хвостом
    ` даёт «Т»`; номер 2 — образ, 3 — перевод. -/
def «образОбъекта» (f : «ОбъявлениеЗакона») («объект» : String) (k : Nat) : String :=
  let ok := fun (p : String) =>
    let st := s!"объект «{«ёлочка» p 1}» отображается в «{«ёлочка» p 2}»"
    «ёлочка» p 1 = «объект» && (p = st || p = s!"{st} даёт «{«ёлочка» p 3}»")
  match f.«поля».find? ok with
  | some p => «ёлочка» p k
  | none => ""

def «образСтрелки» (f : «ОбъявлениеЗакона») (m : String) : String :=
  match f.«поля».find? (fun p => p = s!"морфизм «{m}» отображается в морфизм «{«ёлочка» p 2}»") with
  | some p => «ёлочка» p 2
  | none => ""

def «стрелкиФунктора» (f : «ОбъявлениеЗакона») : List String :=
  (f.«поля».filter (fun p => p = s!"морфизм «{«ёлочка» p 1}» отображается в морфизм «{«ёлочка» p 2}»")).map («ёлочка» · 1)

def «законыФунктора» (f : «ОбъявлениеЗакона») («все» : List «ОбъявлениеЗакона») : List String :=
  («стрелкиФунктора» f).flatMap fun m =>
    let a := «конецСтрелки» «все» m 2
    let b := «конецСтрелки» «все» m 3
    let body := «даётПоИмени» «все» m
    let img := «даётПоИмени» «все» («образСтрелки» f m)
    let pa := «образОбъекта» f a 3
    let pb := «образОбъекта» f b 3
    if body = "" || img = "" || pa = "" || pb = "" then [] else
    «закон» («ёлочка» f.«заголовок» 1) s!"квадрат на {m}" s!"х: «{a}»"
      («вызовЗакона» pb («вызовЗакона» body "х")) («вызовЗакона» img («вызовЗакона» pa "х"))

def «компонента» (p : «ОбъявлениеЗакона») («объект» : String) : String :=
  match p.«поля».find? (fun l => l = s!"объект «{«объект»}» отображается в морфизм «{«ёлочка» l 2}»") with
  | some l => «ёлочка» l 2
  | none => ""

def «законыПреобразования» (p : «ОбъявлениеЗакона») («все» : List «ОбъявлениеЗакона») : List String :=
  match «объявлениеЗакона» «все» "функтор" («ёлочка» p.«заголовок» 2),
        «объявлениеЗакона» «все» "функтор" («ёлочка» p.«заголовок» 3) with
  | some f, some g =>
    («стрелкиФунктора» f).flatMap fun m =>
      let a := «конецСтрелки» «все» m 2
      let b := «конецСтрелки» «все» m 3
      let fa := «образОбъекта» f a 2
      let pf := «даётПоИмени» «все» («образСтрелки» f m)
      let pg := «даётПоИмени» «все» («образСтрелки» g m)
      let na := «даётПоИмени» «все» («компонента» p a)
      let nb := «даётПоИмени» «все» («компонента» p b)
      if fa = "" || pf = "" || pg = "" || na = "" || nb = "" then [] else
      «закон» («ёлочка» p.«заголовок» 1) s!"естественность на {m}" s!"х: «{fa}»"
        («вызовЗакона» nb («вызовЗакона» pf "х")) («вызовЗакона» pg («вызовЗакона» na "х"))
  | _, _ => []

/-- Строки развёртки законов: утверждения по три строки, между ними пустая. -/
def «законыТекстом» («строки» : List String) : List String :=
  let «есть» := («строки».drop 1).any (fun l => l.startsWith "моноид «" || l.startsWith "свойство «" ||
    l.startsWith "изоморфизм «" || l.startsWith "функтор «")
  if !«есть» then [] else
  let «все» := «объявленияЗаконов» «строки»
  let «группы» := «все».map fun o =>
    let v := «видЗакона» o
    if v = "моноид" then «законыМоноида» o
    else if v = "коммутативность" || v = "дистрибутивность" then «законыСвойства» o v
    else if v = "изоморфизм" then «законыИзоморфизма» o «все»
    else if v = "функтор" then «законыФунктора» o «все»
    else if v = "преобразование" then «законыПреобразования» o «все»
    else []
  let «строкиЗаконов» := «группы».flatten
  ((List.range «строкиЗаконов».length).zip «строкиЗаконов»).flatMap fun (i, l) =>
    if i > 0 && i % 3 = 0 then ["", l] else [l]

end «Второй»
