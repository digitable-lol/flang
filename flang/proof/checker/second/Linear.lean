import Ring

open «Разбор»

namespace «Второй»

/-!
Правило «линейная арифметика» (ADR-0192), переигранное по описанию формата
(`docs/flang/proof/record-format.md`, §3.6), а не по коду сверщика на C.

Запись несёт сертификат Фаркаша: на каждую цель `Л не больше П` (`меньше`,
`не меньше`, `больше`) — допущения исходника, границы листьев по типу и отрицание
цели с целыми множителями больше нуля. Формы «≥ 0» складываются с множителями;
сумма обязана быть числом меньше нуля без листьев. Носитель, допущения и цели,
которые обязаны быть доказаны, сверщик читает из исходника сам. Над
«неотрицательное» он ещё пересчитывает точность каждого узла суммы и знак нуля у
равенства. Числа — целые Lean без округления.
-/

/-- Линейная форма: моном (листья через « · », пустой — свободный член) и множитель. -/
abbrev «ЛФ» := List (String × Int)

def «лфК» (f : «ЛФ») (k : String) (c : Int) : «ЛФ» :=
  if f.any (·.1 = k) then f.map (fun (a, b) => if a = k then (a, b + c) else (a, b)) else f ++ [(k, c)]

def «лфСумма» (a b : «ЛФ») (m : Int) : «ЛФ» := b.foldl (fun acc (k, c) => «лфК» acc k (m * c)) a

def «лфЧисло» (c : Int) : «ЛФ» := [("", c)]

def «лфКонстанта» (f : «ЛФ») : Option Int :=
  if f.any (fun (k, c) => k ≠ "" && c ≠ 0) then none else some ((f.filter (·.1 = "")).foldl (fun s (_, c) => s + c) 0)

def «лфРавны» (a b : «ЛФ») : Bool := «лфКонстанта» («лфСумма» a b (-1)) = some 0

def «моном» (a b : String) : String :=
  " · ".intercalate («сортСтрок» (((a.splitOn " · ") ++ (b.splitOn " · ")).filter (· ≠ "")))

def «лфПроизведение» (a b : «ЛФ») : «ЛФ» :=
  a.foldl (fun acc (ka, ca) => b.foldl (fun acc2 (kb, cb) => «лфК» acc2 («моном» ka kb) (ca * cb)) acc) («лфЧисло» 0)

def «лаПотолок» : Int := 9007199254740991
def «лаКрай» : Int := 9007199254740992

def «лфМера» (f : «ЛФ») : Int := f.foldl (fun s (_, c) => s + c.natAbs) 0

structure «ЛК» where
  «исх» : «Исх»
  «свои» : List String
  «чья» : String
  «режим» : String

def «типВызова» (s : «Исх») (f : String) : String :=
  match (s.«внутри» f).find? (fun i => (s.«по» i).startsWith "возвращает ") with
  | some i => «обрезать» («после» (s.«по» i) "возвращает ")
  | none => ""

def «типГоден» (t r : String) : Bool :=
  if r = "number" then «обрезать» t = "число" || «обрезать» t = "целое"
  else if r = "exact" then «обрезать» t = "точное целое" else «названоНатуральным» t

def «лаЛитерал» (t : String) : Option Int :=
  if t ≠ "" && t.all Char.isDigit && t.length ≤ 10 then
    let n := t.toNat!
    if n ≤ 2147483648 then some (Int.ofNat n) else none
  else none

def «лаЛист» (k : «ЛК») (t : String) : Bool :=
  if t = "" || (t.splitOn "(").length > 1 || t.startsWith "[" || (t.all Char.isDigit) then false
  else if t.startsWith "«" then
    let f := «ёлочка» t 1
    (t = s!"«{f}»" || t.startsWith s!"«{f}» от ") && «типГоден» («типВызова» k.«исх» f) k.«режим»
  else !((t.splitOn " ").length > 1) && «типГоден» ((«типЛистаКольца» k.«исх» k.«свои» k.«чья» t).getD "") k.«режим»

/-- Форма терма; `none` — терм не читается; второе — формы вычитаний (над точным целым
    каждое `X минус Y` обязано быть доказано не ниже нуля). -/
partial def «лаФорма» (k : «ЛК») (t0 : String) : Option («ЛФ» × List «ЛФ») := do
  let t := «ужатьТ» t0
  let «сл» := «сверху» t "плюс"
  if «сл».length ≥ 2 then
    if («сверху» t "минус").length ≥ 2 then none
    let mut f := «лфЧисло» 0
    let mut v : List «ЛФ» := []
    for x in «сл» do
      let (g, w) ← «лаФорма» k x
      f := «лфСумма» f g 1
      v := v ++ w
    return (f, v)
  let «мн» := «сверху» t "минус"
  if «мн».length ≥ 2 then
    let (f0, v0) ← «лаФорма» k («мн».headD "")
    let mut f := f0
    let mut v := v0
    for x in «мн».drop 1 do
      let (g, w) ← «лаФорма» k x
      v := v ++ w
      if k.«режим» = "exact" then v := v ++ [«лфСумма» f g (-1)]
      f := «лфСумма» f g (-1)
    return (f, v)
  let «пр» := «сверху» t "умножить на"
  if «пр».length > 2 then none
  if «пр».length = 2 then
    let (l, vl) ← «лаФорма» k («пр».headD "")
    let (p, vp) ← «лаФорма» k («пр».getD 1 "")
    match «лфКонстанта» l, «лфКонстанта» p with
    | some c, _ => return («лфСумма» («лфЧисло» 0) p c, vl ++ vp)
    | _, some c => return («лфСумма» («лфЧисло» 0) l c, vl ++ vp)
    | _, _ =>
      if k.«режим» = "exact" then return («лфПроизведение» l p, vl ++ vp)
      let a := «ужатьТ» («пр».headD ""); let b := «ужатьТ» («пр».getD 1 "")
      if «лаЛист» k a && «лаЛист» k b then return ([(«моном» a b, 1)], []) else none
  if k.«режим» ≠ "exact" then
    if let some c := «лаЛитерал» t then return («лфЧисло» c, [])
  if k.«режим» = "exact" && t.startsWith "[" then
    let w := «заменить» t " " ""
    if w = "[]" then return («лфЧисло» 0, [])
    if let some c := «лаЛитерал» («безКраёвТ» w) then return («лфЧисло» c, [])
  if «лаЛист» k t then return ([(t, 1)], []) else none

/-- Отрезок значений над двоичным носителем: (годен, низ, верх). -/
partial def «лаОтрезок» (k : «ЛК») (t0 : String) : Bool × Int × Int :=
  let t := «ужатьТ» t0
  let «точен» := fun (o : Bool × Int × Int) => o.1 && o.2.1 ≥ -«лаКрай» && o.2.2 ≤ «лаКрай»
  let «сл» := «сверху» t "плюс"
  let («ч», «минус») := if «сл».length ≥ 2 then («сл», false) else («сверху» t "минус", true)
  if «ч».length ≥ 2 then
    («ч».drop 1).foldl (fun o x =>
      let p := «лаОтрезок» k x
      let g := «точен» o && «точен» p
      if «минус» then (g, o.2.1 - p.2.2, o.2.2 - p.2.1) else (g, o.2.1 + p.2.1, o.2.2 + p.2.2)) («лаОтрезок» k («ч».headD ""))
  else
    let «пр» := «сверху» t "умножить на"
    if «пр».length = 2 then
      let a := «ужатьТ» («пр».headD ""); let b := «ужатьТ» («пр».getD 1 "")
      if «лаЛист» k a && «лаЛист» k b then (true, 0, «лаКрай» * «лаКрай») else
      match «лаЛитерал» a, «лаЛитерал» b with
      | some c, _ => let p := «лаОтрезок» k b; («точен» p, c * p.2.1, c * p.2.2)
      | _, some c => let p := «лаОтрезок» k a; («точен» p, c * p.2.1, c * p.2.2)
      | _, _ => (false, 0, 0)
    else match «лаЛитерал» t with
      | some c => (true, c, c)
      | none => if «лаЛист» k t then (true, 0, «лаПотолок») else (false, 0, 0)

def «лаАтомарно» (k : «ЛК») (t0 : String) : Bool :=
  let t := «ужатьТ» t0
  let «пр» := «сверху» t "умножить на"
  «лаЛист» k t || («пр».length = 2 && «лаЛист» k («ужатьТ» («пр».headD "")) && «лаЛист» k («ужатьТ» («пр».getD 1 "")))

def «стороныТочны» (k : «ЛК») (t : String) («мягко» : Bool) : Bool :=
  if k.«режим» ≠ "nat" || «лаАтомарно» k t then true else
  let o := «лаОтрезок» k t
  if «мягко» then o.1 else o.1 && o.2.1 ≥ -«лаКрай» && o.2.2 ≤ «лаКрай»

/-- Положительный терм: (листья, нуль терма всегда плюс); `none` — не положителен. Нуль всегда плюс
    у слагаемого литерала и у произведения: нулевое произведение язык отдаёт плюс нулём. -/
partial def «лаПоложителен» (k : «ЛК») (t0 : String) : Option (List String × Bool) := do
  let t := «ужатьТ» t0
  let «сл» := «сверху» t "плюс"
  if «сл».length ≥ 2 then
    let ps ← «сл».mapM («лаПоложителен» k)
    return (ps.foldl (fun a p => a ++ p.1) [], ps.any (·.2))
  if («сверху» t "минус").length ≥ 2 then none
  let «пр» := «сверху» t "умножить на"
  if «пр».length = 2 then
    let a := «ужатьТ» («пр».headD ""); let b := «ужатьТ» («пр».getD 1 "")
    match «лаЛитерал» a, «лаЛитерал» b with
    | some c, _ => if c > 0 then («лаПоложителен» k b).map (fun p => (p.1, true)) else none
    | _, some c => if c > 0 then («лаПоложителен» k a).map (fun p => (p.1, true)) else none
    | _, _ => none
  else if («лаЛитерал» t).isSome then return ([], true)
  else if «лаЛист» k t then return ([t], false)
  else none

/-- Сравнение → (вид, левое, правое, форма «≥ 0»); `обратно` — правое минус левое у равенства. -/
def «лаСравнение» (k : «ЛК») (t0 : String) («обратно» : Bool) : Option (String × String × String × «ЛФ» × List «ЛФ») := do
  let t := «ужатьТ» t0
  let ops := [("не больше", "lte"), ("не меньше", "gte"), ("меньше", "lt"), ("больше", "gt"), ("равен", "eq")]
  let some (w, n) := ops.find? (fun (w, _) => («сверху» t w).length = 2) | none
  let «ч» := «сверху» t w
  let l := «обрезать» («ч».headD ""); let r := «обрезать» («ч».getD 1 "")
  if n = "eq" && (r.startsWith "не " || l = "не") then none
  let (fl, vl) ← «лаФорма» k l
  let (fr, vr) ← «лаФорма» k r
  let f := match n with
    | "lte" => «лфСумма» fr fl (-1)
    | "gte" => «лфСумма» fl fr (-1)
    | "lt" => «лфСумма» («лфСумма» fr fl (-1)) («лфЧисло» 1) (-1)
    | "gt" => «лфСумма» («лфСумма» fl fr (-1)) («лфЧисло» 1) (-1)
    | _ => if «обратно» then «лфСумма» fr fl (-1) else «лфСумма» fl fr (-1)
  return (n, l, r, f, vl ++ vr)

def «допущениеГодно» (k : «ЛК») (l r : String) : Bool :=
  if k.«режим» = "exact" then !«естьТ» l "минус" && !«естьТ» r "минус"
  else «стороныТочны» k l false && «стороныТочны» k r false

partial def «лаКонъюнкты» (t0 : String) : List String :=
  let t := «ужатьТ» t0
  let «ч» := «сверху» t "и притом"
  if «ч».length < 2 then [t] else «ч».foldl (fun a x => a ++ «лаКонъюнкты» x) []

def «естьДопущение» (k : «ЛК») («допущения» : List String) (f : «ЛФ») : Bool :=
  «допущения».any fun d => [false, true].any fun o =>
    match «лаСравнение» k d o with
    | some (_, l, r, g, _) => «допущениеГодно» k l r && «лфРавны» g f
    | none => false

def «одинЛист» (f : «ЛФ») : Bool :=
  let «листья» := f.filter (fun (m, c) => m ≠ "" && c ≠ 0)
  f.all (fun (m, c) => m ≠ "" || c = 0) && «листья».length = 1 && «листья».all (·.2 = 1)

/-- Блоки «доказать … противоречие»: доказанные цели формами и тексты «положительно ⟨…⟩».
    Ошибка с приставкой «НЕВЗЯЛСЯ » — место на слове ядра; прочая — беда. -/
def «лаБлоки» (k : «ЛК») («свои» «допущения» : List String) : Except String (List «ЛФ» × List String) := do
  let mut «номер» : Nat := 0
  let mut «вБлоке» := false
  let mut «целиФ» : «ЛФ» := []
  let mut «сумма» : «ЛФ» := «лфЧисло» 0
  let mut «доказанные» : List «ЛФ» := []
  let mut «положительно» : List String := []
  for x in «свои».filter (·.startsWith "ход ") do
    if x = "ход цель" || x = "ход конец" then continue
    «номер» := «номер» + 1
    if «номерПосле» x "ход " ≠ «номер» then throw s!"ход «{x}» стоит не по порядку"
    let «текст» := «уголок» x 1
    let mut m : Int := 1
    if (x.splitOn " множитель ").length > 1 then
      let w := «слово» («после» x " множитель ") 1
      if w = "" || !w.all Char.isDigit || w.toNat! = 0 then throw s!"множитель в «{x}» не целое больше нуля"
      m := Int.ofNat w.toNat!
    let «вид» := «слово» x 3
    if «вид» = "носитель" || «вид» = "произведение" then continue
    if «вид» = "положительно" then
      if «вБлоке» then throw "«положительно» внутри незакрытой цели"
      «положительно» := «положительно» ++ [«т» «текст»]
      continue
    if «вид» = "доказать" then
      if «вБлоке» then throw "«доказать» внутри незакрытой цели"
      match «лаСравнение» k «текст» false with
      | some (o, _, _, f, _) =>
        if o = "eq" then throw s!"НЕВЗЯЛСЯ цели ⟨{«текст»}⟩ сверщик не читает"
        «целиФ» := f; «сумма» := «лфЧисло» 0; «вБлоке» := true
      | none => throw s!"НЕВЗЯЛСЯ цели ⟨{«текст»}⟩ сверщик не читает"
      continue
    if !«вБлоке» then throw s!"ход «{x}» стоит вне «доказать»"
    if «вид» = "противоречие" then
      match «лфКонстанта» «сумма» with
      | some c => if c ≥ 0 then throw "ЛЖЁТ — сумма ходов цели не меньше нуля"
      | none => throw "ЛЖЁТ — в сумме ходов цели остались листья"
      «доказанные» := «доказанные» ++ [«целиФ»]
      «вБлоке» := false
      continue
    let f ← (if «вид» = "отрицание" then pure («лфСумма» («лфЧисло» (-1)) «целиФ» (-1))
      else if «вид» = "допущение" then
        match «лаСравнение» k «текст» ((x.splitOn "⟩ обратно ").length > 1) with
        | some (_, l, r, g, _) =>
          if «допущениеГодно» k l r && «естьДопущение» k «допущения» g then pure g
          else throw s!"НЕВЗЯЛСЯ допущения ⟨{«текст»}⟩ среди допущений исходника нет"
        | none => throw s!"НЕВЗЯЛСЯ допущения ⟨{«текст»}⟩ сверщик не читает"
      else if «вид» = "дно" || «вид» = "потолок" then
        match «лаФорма» k «текст» with
        | some (a, _) =>
          let «лист» := «лаЛист» k («ужатьТ» «текст»)
          if !«одинЛист» a || (k.«режим» = "nat" && !«лаАтомарно» k «текст») || («вид» = "потолок" && (k.«режим» ≠ "nat" || !«лист»)) then
            throw s!"граница «{x}» не граница листа носителя"
          else pure (if «вид» = "дно" then a else «лфСумма» («лфЧисло» «лаПотолок») a (-1))
        | none => throw s!"граница «{x}» не читается"
      else throw s!"хода «{x}» сверщик не знает")
    if «лфМера» «сумма» + m * «лфМера» f ≥ «лаКрай» then
      throw "сумма ходов вышла за предел: мера множителей не меньше 2⁵³, сумма двоичных множителей там не точна"
    «сумма» := «лфСумма» «сумма» f m
  if «вБлоке» then throw "последняя цель не закрыта «противоречием»"
  return («доказанные», «положительно»)

def «режимЦели» (k0 : «ЛК») («цель» : String) : String :=
  if («лаСравнение» k0 «цель» false).isSome then "exact"
  else if («лаСравнение» { k0 with «режим» := "nat" } «цель» false).isSome then "nat" else ""

def «лаНоль» (t : String) : Bool := let w := «заменить» («ужатьТ» t) " " ""; w = "0" || w = "[]"

def «сверитьНоситель» («свои» : List String) («режим» : String) : Except String Unit := do
  let «имяНосителя» := if «режим» = "exact" then "точное целое" else "неотрицательное"
  let «носитель» := «ёлочка» ((«свои».find? (·.startsWith "ход 1 носитель «")).getD "") 1
  if «носитель» ≠ «имяНосителя» then throw s!"запись называет носитель «{«носитель»}», а листья цели объявлены «{«имяНосителя»}»"

/-- Строгий порядок произведения: `X умножить на Y больше 0`; X доказан не меньше единицы,
    Y — тоже или стоит в допущениях как `Y больше 0`. -/
def «лаПроизведение» (k0 : «ЛК») («свои» «допущения» : List String) («цель» : String) : Except String (Bool × String) := do
  let «п» := «ужатьТ» («уголок» ((«свои».find? (·.startsWith "ход 2 произведение ⟨")).getD "") 1)
  let «ч» := «сверху» «п» "умножить на"
  let «б» := «сверху» («ужатьТ» «цель») "больше"
  let «м» := «сверху» («ужатьТ» «цель») "меньше"
  let «сторона» := if «б».length = 2 && «лаНоль» («б».getD 1 "") then «ужатьТ» («б».headD "")
    else if «м».length = 2 && «лаНоль» («м».headD "") then «ужатьТ» («м».getD 1 "") else ""
  if «ч».length ≠ 2 || «т» «сторона» ≠ «т» «п» then return (false, s!"произведение ⟨{«п»}⟩ не цель ⟨{«цель»}⟩")
  let x := «ужатьТ» («ч».headD ""); let y := «ужатьТ» («ч».getD 1 "")
  let «режим» := «режимЦели» k0 s!"1 не больше {«вСкобки» x}"
  if «режим» = "" then return (false, s!"множитель ⟨{x}⟩ не читается носителем")
  «сверитьНоситель» «свои» «режим»
  let k := { k0 with «режим» := «режим» }
  if !«стороныТочны» k x true then throw s!"множитель ⟨{x}⟩ округляет больше одного раза"
  let («доказанные», «положительно») ← «лаБлоки» k «свои» «допущения»
  let «нужно» := fun (z : String) => match «лаСравнение» k s!"1 не больше {«вСкобки» z}" false with
    | some (_, _, _, f, _) => «доказанные».any («лфРавны» f)
    | none => false
  if !«нужно» x then return (false, s!"⟨1 не больше {x}⟩ в записи не доказано")
  let «поФакту» := «положительно».any fun t =>
    let «бб» := «сверху» t "больше"; let «мм» := «сверху» t "меньше"
    let «кто» := if «бб».length = 2 && «лаНоль» («бб».getD 1 "") then «т» («бб».headD "")
      else if «мм».length = 2 && «лаНоль» («мм».headD "") then «т» («мм».getD 1 "") else ""
    «кто» = «т» y && «допущения».any (fun d => «т» d = t)
  if «поФакту» || ((k.«режим» = "exact" || «стороныТочны» k y true) && «нужно» y) then return (true, "")
  return (false, s!"множитель ⟨{y}⟩ не доказан ни блоком, ни допущением")

/-- Раскрытие вызова перед линейной арифметикой — то же, что `ла_раскрыть` сверщика на C,
    по описанию ядра («Развёртка плоского определения»): вызов тотальной функции, чьё тело
    без вызовов, ветвлений и связывателей, заменяется телом с доводами на местах всех
    параметров; доводы — атомы или скобки. Раскрыть нельзя — вызов остаётся листом. -/
def «лаПараметры» (s : «Исх») (a b : Nat) : List String :=
  (s.«меж» a b).foldl (fun acc i =>
    let l := s.«по» i
    if l.startsWith "принимает " then acc ++ ((«именаДоводовС» l).map fun d =>
      let d := «обрезать» d; if d.startsWith "«" then «ёлочка» d 1 else d) else acc) []

def «лаТелоПлоско» («тело» : String) : Bool :=
  «тело» ≠ "" && !((«тело».splitOn "» от ").length > 1) && !«естьСвязыватель» «тело» &&
  !(["если", "то", "иначе", "разбор", "случай", "пусть", "свёртка", "отобразить", "отфильтровать",
     "для", "есть", "→", "применить", "результат"].any («естьТ» «тело» ·))

def «лаДоводПрост» (d : String) : Bool := !((d.splitOn " ").length > 1) || «однаПараТ» d

partial def «лаРаскрыть» (s : «Исх») (t0 : String) («гл» : Nat) : String := Id.run do
  let t := «ужатьТ» t0
  if «гл» > 16 then return t
  let f := «ёлочка» t 1
  if f ≠ "" && t.startsWith s!"«{f}» от " then
    let «арги» := «сверху» («обрезать» («после» t s!"«{f}» от ")) "и"
    let some (a, b) := s.«блокС» f | return t
    if !(s.«по» a).startsWith "тотальная функция «" then return t
    let «тело» := s.«телоТекстом» a b
    let «пар» := «лаПараметры» s a b
    if !«лаТелоПлоско» «тело» || «пар».isEmpty || «пар».length ≠ «арги».length then return t
    if !«арги».all (fun d => «лаДоводПрост» («обрезать» d)) then return t
    let mut u := «т» «тело»
    for (p, k) in «пар».zip (List.range «пар».length) do u := «вместоИмени» u p s!"%ла{k}%"
    for (d, k) in «арги».zip (List.range «арги».length) do
      u := «вместо» u s!"%ла{k}%" («лаРаскрыть» s («обрезать» d) («гл» + 1))
    return «лаРаскрыть» s («т» u) («гл» + 1)
  for op in ["и притом", "не больше", "не меньше", "меньше", "больше", "равен", "плюс", "минус", "умножить на"] do
    let «ч» := «сверху» t op
    if «ч».length < 2 then continue
    if op = "равен" && (t.splitOn " не равен ").length > 1 then return t
    let «н» := «ч».map fun x => «лаРаскрыть» s x («гл» + 1)
    if («ч».zip «н»).all (fun (x, y) => «ужатьТ» x = y) then return t
    return «т» ((" " ++ op ++ " ").intercalate («н».map «вСкобки»))
  return t

/-- Переиграть место: `ok true` — снято; `ok false` — место на слове ядра (причина
    вторым); `error` — беда записи (с приставкой «НЕВЗЯЛСЯ » — тоже слово ядра). -/
def «линейнаяАрифметика» (s : «Исх») («свои» : List String) («чья» «место» «цель0» : String) : Except String (Bool × String) := do
  let «цель» := Id.run do
    let g := «т» «цель0»
    if «чья» = "" || !«естьТ» g "результат" then return g
    let some (a, b) := s.«блокС» «чья» | return g
    let «тело» := s.«телоТекстом» a b
    if «тело» = "" || «естьСвязыватель» «тело» then return g
    return «т» («вместо» g "результат" («вСкобки» («т» «тело»)))
  let «цель» := «т» («лаРаскрыть» s «цель» 0)
  let «сРаскрытием» := fun (xs : List String) => xs.foldl (fun a d => a ++ [d, «т» («лаРаскрыть» s d 0)]) []
  let k0 : «ЛК» := { «исх» := s, «свои» := «свои», «чья» := «чья», «режим» := "exact" }
  let «допущения» := if «чья» ≠ "" then
      (s.«требования» «чья»).foldl (fun a l => a ++ «сРаскрытием» («лаКонъюнкты» («т» («формулаТребования» l)))) []
    else (s.«ограничения» «место»).foldl (fun a l => a ++ «сРаскрытием» («лаКонъюнкты» l)) []
  if «свои».any (·.startsWith "ход 2 произведение ") then return (← «лаПроизведение» k0 «свои» «допущения» «цель»)
  let «режим» := «режимЦели» k0 «цель»
  if «режим» = "" && («лаСравнение» { k0 with «режим» := "number" } «цель» false).isSome then
    throw s!"цель ⟨{«цель»}⟩: листья объявлены «число» или «целое», а на двоичном носителе без порога законы целых ложны"
  if «режим» = "" then return (false, s!"листья цели ⟨{«цель»}⟩ не читаются носителем «точное целое» или «неотрицательное»")
  «сверитьНоситель» «свои» «режим»
  let k := { k0 with «режим» := «режим» }
  let some («оп», «лс», «пс», «цф», «выч») := «лаСравнение» k «цель» false | return (false, s!"цель ⟨{«цель»}⟩ не сравнение")
  if «режим» = "nat" then
    let «строго» := «оп» = "lt" || «оп» = "gt"
    if !(«стороныТочны» k «лс» (!«строго») && «стороныТочны» k «пс» (!«строго»)) then
      throw s!"над «неотрицательное» цель ⟨{«цель»}⟩ выходит за 2⁵³ и округляет"
    if «оп» = "eq" then
      if «лаАтомарно» k «лс» || «лаАтомарно» k «пс» then throw s!"у равенства ⟨{«цель»}⟩ знак нуля сторон может разойтись"
      match «лаПоложителен» k «лс», «лаПоложителен» k «пс» with
      | some (a, x), some (b, y) =>
        if !(x == y && a.all (b.contains ·) && b.all (a.contains ·)) then throw s!"у равенства ⟨{«цель»}⟩ знак нуля сторон может разойтись"
      | _, _ => throw s!"у равенства ⟨{«цель»}⟩ знак нуля сторон может разойтись"
  else if «естьТ» «цель» "минус" && ((«лс».splitOn "» от").length > 1 || («пс».splitOn "» от").length > 1) then
    return (false, "вычитание рядом с вызовом")
  let «обязательные» := (if «оп» = "eq" then [«цф», «лфСумма» («лфЧисло» 0) «цф» (-1)] else [«цф»]) ++ «выч»
  let («доказанные», _) ← «лаБлоки» k «свои» «допущения»
  if !«обязательные».all (fun o => «доказанные».any («лфРавны» o)) then
    return (false, "одна из целей (или её вычитание) в записи не доказана")
  return (true, "")

end «Второй»
