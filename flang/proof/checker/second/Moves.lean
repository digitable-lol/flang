namespace «Второй»

def «Исх».«по» (s : «Исх») (n : Nat) : String := «обрезать» («безПримечания» (s.«сырая» n))

def «Исх».«хозяин» (s : «Исх») (n : Nat) : String :=
  ((List.range' 1 (min n s.«число»)).filterMap (fun i => «заголовокФункции» (s.«сырая» i))).getLastD ""

structure «Доводы» where
  «имена» : List String := []
  «типы» : List String := []
  «голые» : List String := []
  «хвост» : String := ""

def «доводыСтроки» (l : String) : «Доводы» :=
  let t := «обрезать» l
  if !t.startsWith "принимает " then {} else
  let «ч» := («после» t "принимает ").splitOn ","
  let «пары» := «ч».map (fun k => match k.splitOn ":" with
    | a :: b :: _ => («обрезать» a, «обрезать» b)
    | [a] => («обрезать» a, "")
    | [] => ("", ""))
  { «имена» := «пары».map (·.1), «типы» := «пары».map (·.2),
    «голые» := («пары».map (·.1)).filter (· ≠ "") |>.map «голо»,
    «хвост» := String.join ((«пары».drop 1).filterMap (fun (a, _) => if a = "" then none else some (" и " ++ a))) }

def «Исх».«доводы» (s : «Исх») (f : String) : «Доводы» :=
  match (s.«внутри» f).find? (fun i => (s.«по» i).startsWith "принимает ") with
  | some i => «доводыСтроки» (s.«по» i)
  | none => {}

def «Исх».«требования» (s : «Исх») (f : String) : List String :=
  if f = "" then [] else (s.«внутри» f).filterMap (fun i => let l := s.«по» i; if l.startsWith "требует " then some l else none)

def «формулаТребования» (l : String) : String := «обрезать» («после» l s!"требует «{«ёлочка» l 1}» ")

def «Исх».«свойство» (s : «Исх») («имя» : String) : Nat :=
  (s.«номера».find? fun i =>
    let z := s.«по» i
    (z.startsWith "обеспечивает «" || z.startsWith "для всех ") && (z.splitOn s!"обеспечивает «{«имя»}»").length > 1).getD 0

def «Исх».«высказывание» (s : «Исх») («место» : String) : Nat :=
  if !«место».startsWith "утверждение «" then 0 else
  (s.«номера».find? (fun i => «какЧитаетЯзык» (s.«сырая» i) = «место»)).getD 0

def «Исх».«подВысказыванием» (s : «Исх») («где» : Nat) : List String :=
  if «где» = 0 then [] else
  let rec go (i : Nat) (fuel : Nat) (acc : List String) : List String :=
    match fuel with
    | 0 => acc
    | fuel + 1 =>
      let «сыр» := s.«сырая» i
      if i > s.«число» || («сыр» ≠ "" && !«сыр».startsWith " " && !«сыр».startsWith "//") then acc
      else go (i + 1) fuel (acc ++ [«какЧитаетЯзык» («обрезать» («безПримечания» «сыр»))])
  go («где» + 1) s.«число» []

def «связанные» (l : String) : List (String × String) :=
  if !l.startsWith "для всех " then [] else
  let «св» := l.«сн» 9
  let «без» := («св».splitOn " таких что ").headD «св»
  let «ч» := «сверху» «без» "и"
  let «ч» := if «ч».isEmpty then [«без»] else «ч»
  «ч».map fun k => match («обрезать» k).splitOn ":" with
    | a :: b :: _ => («голо» a, «обрезать» b)
    | [a] => («голо» a, "")
    | [] => ("", "")

def «Исх».«цельВысказывания» (s : «Исх») («где» : Nat) : String :=
  ((s.«подВысказыванием» «где»).filter (·.startsWith "утверждаем ")).foldl (fun _ l => «после» l "утверждаем ") ""

def «Исх».«именаВысказывания» (s : «Исх») («где» : Nat) : List String :=
  (s.«подВысказыванием» «где»).flatMap (fun l => («связанные» l).map (·.1))

def «Исх».«типВысказывания» (s : «Исх») («где» : Nat) (x : String) : String :=
  (s.«подВысказыванием» «где»).foldl (fun acc l => match («связанные» l).find? (·.1 = x) with
    | some p => p.2
    | none => acc) ""

def «Исх».«ограничения» (s : «Исх») («место» : String) : List String :=
  (s.«подВысказыванием» (s.«высказывание» «место»)).filterMap fun l =>
    if l.startsWith "для всех " && (l.splitOn " таких что ").length > 1 then some («т» («после» l " таких что ")) else none

def «существование» («ц» : String) : Option (String × String × String) :=
  let t := «обрезать» «ц»
  if !t.startsWith "есть такой " then none else
  match (t.«сн» 11).splitOn ", а именно " with
  | «м» :: r :: _ => match r.splitOn ", что " with
    | «т» :: «у» :: rest => let «у» := ", что ".intercalate («у» :: rest)
      if «обрезать» «м» ≠ "" && «обрезать» «т» ≠ "" && «обрезать» «у» ≠ "" then some («обрезать» «м», «обрезать» «т», «обрезать» «у») else none
    | _ => none
  | _ => none

def «обещанная» («ц» : String) : String :=
  match «существование» «ц» with
  | some («м», «тт», «у») => «т» («вместо» («т» «у») «м» («т» «тт»))
  | none => «ц»

def «совпали» (a b : String) : Bool :=
  «ужатьТ» a = «ужатьТ» b ||
  (let «ра» := «разрез» a "не меньше"; let «рб» := «разрез» b "не меньше"
   «ра».«есть» && «рб».«есть» && «ужатьТ» «ра».«лево» = «ужатьТ» «рб».«лево» && «ужатьТ» «ра».«право» = «ужатьТ» «рб».«право»)

def «безСкобок» (t : String) : String := «сжать» («заменить» («заменить» («расставить» t) "(" " ") ")" " ")

def «имяВариантаТ» (s : String) : String := if s.startsWith "вариант «" then «ёлочка» s 1 else «слово» s 2

structure «Обст» where
  «исх» : «Исх»
  «свои» : List String := []
  «цель» : String := ""
  «функция» : String := ""
  «по» : String := ""
  «тип» : String := ""
  «хвост» : String := ""
  «обяз» : String := ""
  «доказанные» : List String := []
  «объявленные» : List String := []
  «ограничения» : List String := []

structure «Прогон» where
  «цели» : List String := []
  «дано» : List String := []
  «беды» : List String := []
  «неВзялся» : List String := []
  «ходов» : Nat := 0
  «проиграно» : Nat := 0
  «безПривязки» : Nat := 0
  «идёт» : Bool := false
  «оборван» : Bool := false
  «вариант» : String := ""
  «факт» : String := ""

def «Прогон».«беда» (p : «Прогон») (t : String) : «Прогон» :=
  { p with «беды» := p.«беды» ++ [t], «идёт» := false, «оборван» := true }
def «Прогон».«отказ» (p : «Прогон») (t : String) : «Прогон» :=
  { p with «неВзялся» := p.«неВзялся» ++ [t], «идёт» := false, «оборван» := true }
def «Прогон».«первая» (p : «Прогон») : String := p.«цели».headD ""
def «Прогон».«заменить» (p : «Прогон») («новые» : List String) : «Прогон» :=
  { p with «цели» := «новые» ++ p.«цели».drop 1, «ходов» := p.«ходов» + 1 }
def «Прогон».«одна» (p : «Прогон») (c : String) : «Прогон» := p.«заменить» [c]

def «Обст».«случай» (o : «Обст») («вариант» : String) : String :=
  let v := (o.«свои».filter (·.startsWith "случай строка")).map (fun l => o.«исх».«по» («номерПослеМетки» l "строка "))
  (v.find? (fun l => «имяВариантаТ» («словаС» l 1) = «вариант»)).getD ""
where «номерПослеМетки» (l m : String) : Nat := ((«после» l m).splitOn " ").headD "" |>.toNat?.getD 0

def «конструкторСлучая» («сл» : String) : String := «заменить» («словаС» «сл» 1) " как " " равным "

def «полеОбразца» («сл» «имя» : String) : String :=
  let «ч» := «сверху» («разрез» («словаС» «сл» 1) "с").«право» "и"
  match «ч».find? (fun k => «обрезать» («разрез» k "как").«право» = «имя») with
  | some k => «обрезать» («разрез» k "как").«лево»
  | none => ""

def «Обст».«рекурсивно» (o : «Обст») («вариант» «поле» : String) : Bool :=
  match o.«исх».«строкаВарианта» o.«тип» «вариант» with
  | some l => («поляВарианта» l).any (fun q => q.1 = «поле» && q.2 = s!"«{o.«тип»}»")
  | none => false

def «Обст».«приЗначении» (o : «Обст») («знач» : String) : String :=
  let «вызов» := «т» (s!"«{o.«функция»}» от " ++ «вСкобки» «знач» ++ o.«хвост»)
  «т» («вместо» («вместо» o.«цель» "результат" «вызов») o.«по» «знач»)

def «Обст».«начальная» (o : «Обст») («вариант» : String) : String :=
  let «сл» := o.«случай» «вариант»
  if «сл» ≠ "" then o.«приЗначении» («т» («конструкторСлучая» «сл»))
  else if «вариант» = "" && o.«тип» = "" then
    let «вызов» := if o.«по» ≠ "" then s!"«{o.«функция»}» от ( {o.«по»} ){o.«хвост»}" else s!"«{o.«функция»}»{o.«хвост»}"
    «т» («вместо» o.«цель» "результат" «вызов»)
  else match o.«исх».«строкаВарианта» o.«тип» «вариант» with
    | some v => if (v.splitOn " содержит ").length > 1 then "" else o.«приЗначении» («т» v)
    | none => ""

inductive «Знач» where
  | «ч» (x : Float)
  | «с» (s : String)
  | «п» (b : Bool)
  | «л» (n : Nat)

def «Знач».«вид» : «Знач» → Nat
  | .«ч» _ => 1 | .«с» _ => 2 | .«п» _ => 3 | .«л» _ => 4

def «строковыйЛитерал?» (t : String) : Option String :=
  if t.length < 2 || !t.startsWith "\"" || !t.endsWith "\"" then none else
  let rec go : List Char → List Char → Option (List Char)
    | [], acc => some acc.reverse
    | '\\' :: c :: r, acc => go r ((match c with | 'n' => '\n' | 't' => '\t' | x => x) :: acc)
    | '"' :: _, _ => none
    | c :: r, acc => go r (c :: acc)
  (go («безКраёвТ» t).toList []).map String.ofList

def «отношения» : List String :=
  [" содержит ", " начинается с ", " не равен ", " равен ", " не меньше ", " не больше ", " меньше ", " больше ",
   " плюс ", " минус ", " и притом ", " равно "]

def «первоеОтношение» (t : String) : Option (Nat × String) :=
  «отношения».foldl (fun best r =>
    let k := «найтиСверху» t r
    if k = 0 then best else match best with
      | some (b, _) => if k < b then some (k, r) else best
      | none => some (k, r)) none

partial def «значение» («сыр» : String) («топливо» : Nat) : Option «Знач» := do
  if «топливо» = 0 then none
  let t := «ужатьТ» «сыр»
  if t = "" then none
  match «первоеОтношение» t with
  | some (k, r) =>
    let cs := t.toList
    let a ← «значение» (String.ofList (cs.take (k - 1))) («топливо» - 1)
    let b ← «значение» (String.ofList (cs.drop (k - 1 + r.length))) («топливо» - 1)
    match r, a, b with
    | " содержит ", .«с» x, .«с» y => pure (.«п» ((x.splitOn y).length > 1 || y = ""))
    | " начинается с ", .«с» x, .«с» y => pure (.«п» (x.startsWith y))
    | " равен ", x, y => «равны» x y |>.map .«п»
    | " равно ", x, y => «равны» x y |>.map .«п»
    | " не равен ", x, y => «равны» x y |>.map (fun v => .«п» (!v))
    | " и притом ", .«п» x, .«п» y => pure (.«п» (x && y))
    | " не меньше ", .«ч» x, .«ч» y => pure (.«п» (x ≥ y))
    | " не больше ", .«ч» x, .«ч» y => pure (.«п» (x ≤ y))
    | " меньше ", .«ч» x, .«ч» y => pure (.«п» (x < y))
    | " больше ", .«ч» x, .«ч» y => pure (.«п» (x > y))
    | " плюс ", .«ч» x, .«ч» y => pure (.«ч» (x + y))
    | " минус ", .«ч» x, .«ч» y => pure (.«ч» (x - y))
    | _, _, _ => none
  | none =>
    if t = "да" then pure (.«п» true)
    else if t = "нет" then pure (.«п» false)
    else if t = "пустой список" then pure (.«л» 0)
    else if t.startsWith "не " && «простойТ» (t.«сн» 3) then
      match ← «значение» (t.«сн» 3) («топливо» - 1) with
      | .«п» b => pure (.«п» (!b))
      | _ => none
    else match «строковыйЛитерал?» t with
    | some s => pure (.«с» s)
    | none => match «литералЧисла?» t with
      | some x => pure (.«ч» x)
      | none =>
        let «ч» := «членыСписка» t
        if !«ч».isEmpty then pure (.«л» «ч».length)
        else if t.startsWith "длина " then
          match ← «значение» (t.«сн» 6) («топливо» - 1) with
          | .«с» s => pure (.«ч» s.length.toFloat)
          | .«л» n => pure (.«ч» n.toFloat)
          | _ => none
        else none
where «равны» : «Знач» → «Знач» → Option Bool
  | .«ч» x, .«ч» y => some (x == y)
  | .«с» x, .«с» y => some (x == y)
  | .«п» x, .«п» y => some (x == y)
  | _, _ => none

def «Знач».«текст» : «Знач» → String
  | .«ч» x => if x == x.round && x.abs < 1e15 then
      (if x < 0 then "-" ++ toString (-x).toUInt64.toNat else toString x.toUInt64.toNat) else toString x
  | .«с» s => s
  | .«п» b => if b then "да" else "нет"
  | .«л» n => s!"список из {n}"

def «законПризнака» («внутри» : String) : String :=
  let t := «обрезать» «внутри»
  let «подНе» := «ужатьТ» («словаС» t 1)
  let «пои» := «разрезСловом» t " и притом "
  let «поили» := «разрезСловом» t " или "
  let «свИ» := «пои».«есть» && «найтиСверху» t " или " = 0
  let «ли» := «ужатьТ» «пои».«лево»; let «пи» := «ужатьТ» «пои».«право»
  let «лили» := «ужатьТ» «поили».«лево»; let «пили» := «ужатьТ» «поили».«право»
  if t.startsWith "не " && «простойТ» («словаС» t 1) then
    (if «подНе» = "да" then "нет" else if «подНе» = "нет" then "да" else "")
  else if «свИ» && «простойТ» «пои».«лево» && «простойТ» «пои».«право» then
    (if «ли» = "да" then «пи» else if «пи» = "да" then «ли» else if «ли» = "нет" || «пи» = "нет" then "нет" else "")
  else if «поили».«есть» && «простойТ» «поили».«лево» && «простойТ» «поили».«право» then
    (if «лили» = "нет" then «пили» else if «пили» = "нет" then «лили» else if «лили» = "да" || «пили» = "да" then "да" else "")
  else ""

def «целоеТ?» (t : String) : Option Nat := if t ≠ "" && t.all Char.isDigit then t.toNat? else none

def «формаЗаконом» («лево» «закон» : String) : Option String :=
  let t := «т» «лево»
  match «закон» with
  | "Мера прибавления" | "Мера склейки" | "Мера разложения" | "Мера построения" =>
    if !t.startsWith "длина " then none else
    let a := «ужатьТ» (t.«сн» 6)
    let «пок» := «разрезСловом» a " к "; let «пос» := «разрезСловом» a " с "
    let «пон» := «разрезСловом» a " на "; let «покак» := «разрезСловом» a " как "
    match «закон» with
    | "Мера прибавления" =>
      if «пок».«есть» && («пок».«лево».startsWith "добавить " || «пок».«лево».startsWith "приписать ") then
        some («т» s!"( длина {«вСкобки» «пок».«право»} ) плюс 1") else none
    | "Мера склейки" =>
      if «пос».«есть» && «пос».«лево».startsWith "соединить " then
        some («т» s!"( длина {«вСкобки» («словаС» «пос».«лево» 1)} ) плюс ( длина {«вСкобки» «пос».«право»} )") else none
    | "Мера разложения" =>
      if «пон».«есть» && «пон».«лево».startsWith "разложить " && «пон».«право» = "символы" then
        some («т» s!"длина {«вСкобки» («словаС» «пон».«лево» 1)}") else none
    | _ =>
      if «покак».«есть» && «покак».«лево».startsWith "отобразить " then
        some («т» s!"длина {«вСкобки» («словаС» «покак».«лево» 1)}") else none
  | "Развернуть элемент по номеру" =>
    if !t.startsWith "элемент " then none else
    let «р» := «разрезСловом» («ужатьТ» («словаС» t 1)) " в "
    if !«р».«есть» then none else
    let «ном» := «ужатьТ» «р».«лево»; let «сп» := «ужатьТ» «р».«право»
    let «пок» := «разрезСловом» «сп» " к "
    let «мх» := «вСкобки» «пок».«право»
    let «члены» := «членыСписка» «сп»
    match «целоеТ?» «ном» with
    | some v =>
      if «пок».«есть» && «пок».«лево».startsWith "приписать " && v = 1 then some («т» («словаС» «пок».«лево» 1))
      else if «пок».«есть» && «пок».«лево».startsWith "приписать " && v ≥ 2 then some («т» s!"элемент {v - 1} в {«мх»}")
      else if v ≥ 1 && v ≤ «члены».length then some («т» («члены».getD (v - 1) ""))
      else none
    | none =>
      if «пок».«есть» && «пок».«лево».startsWith "добавить " &&
         («ном» = s!"( длина {«мх»} ) плюс 1" || «ном» = s!"1 плюс ( длина {«мх»} )") then some («т» («словаС» «пок».«лево» 1))
      else none
  | "Закон признака" => let r := «законПризнака» t; if r = "" then none else some («т» r)
  | "Вхождение в выписанный список" =>
    let «р» := «разрез» t "содержит"
    if «р».«есть» && («сверху» t "содержит").length = 2 &&
       («членыСписка» («ужатьТ» «р».«лево»)).any (fun m => «ужатьТ» m = «ужатьТ» «р».«право») then some "да" else none
  | "Склейка разложения" =>
    if !t.startsWith "соединить " then none else
    let «пс» := «разрезСловом» t " по "
    let «части» := «ужатьТ» («словаС» «пс».«лево» 1)
    let «нс» := «разрезСловом» «части» " на "
    let «стр» := «ужатьТ» («словаС» «нс».«лево» 1)
    if «пс».«есть» && «обрезать» «пс».«право» = "\"\"" && «части».startsWith "разложить " && «нс».«есть» && «нс».«право» = "символы" && «стр» ≠ ""
    then some («т» «стр») else none
  | "Пустая склейка слева" | "Пустая склейка справа" | "Склейка ассоциативна" =>
    let «р» := «разрезСловом» t " с "
    if !«р».«есть» || !«р».«лево».startsWith "соединить " then none else
    let «л» := «ужатьТ» («словаС» «р».«лево» 1); let «п» := «ужатьТ» «р».«право»
    match «закон» with
    | "Пустая склейка слева" => if «л» = "\"\"" then some («т» «п») else none
    | "Пустая склейка справа" => if «п» = "\"\"" then some («т» «л») else none
    | _ =>
      let «р2» := «разрезСловом» «л» " с "
      if «р2».«есть» && «р2».«лево».startsWith "соединить " then
        some («т» s!"соединить {«вСкобки» («ужатьТ» («словаС» «р2».«лево» 1))} с ( соединить {«вСкобки» («ужатьТ» «р2».«право»)} с {«вСкобки» «п»} )")
      else none
  | _ => none

def «законЦели» («имя» «цель» : String) : Except String (List String) :=
  let «нм» := «разрез» «цель» "не меньше"
  match «имя» with
  | "сумма неотрицательных" =>
    let s := «разрез» «нм».«лево» "плюс"
    if !(«нм».«есть» && «нм».«право» = "0") then .error "закон суммы берёт только «Е не меньше 0»"
    else if !(s.«есть» && («сверху» («ужатьТ» «нм».«лево») "плюс").length = 2) then .error "не сумма ровно двух слагаемых"
    else .ok [s!"{s.«лево»} не меньше 0", s!"{s.«право»} не меньше 0"]
  | "литерал неотрицателен" =>
    if «нм».«есть» && «ужатьТ» «нм».«право» = "0" && (match «литералЧисла?» («ужатьТ» «нм».«лево») with | some x => x ≥ 0 | none => false)
    then .ok [] else .error "не неотрицательный литерал"
  | "мера неотрицательна" =>
    let l := «ужатьТ» «нм».«лево»
    if «нм».«есть» && («сверху» («ужатьТ» «цель») "не меньше").length = 2 && «ужатьТ» «нм».«право» = "0" &&
       l.startsWith "длина " && «простойТ» («словаС» l 1) then .ok [] else .error "не «длина Т не меньше 0» с простым Т"
  | "квадрат под оговоркой" =>
    let «или» := «разрез» «цель» "или"
    let «лев» := «ужатьТ» «или».«лево»
    let «под» := «ужатьТ» («лев».«сн» 3)
    let «рав» := «разрез» «под» "равен"
    let «мин» := «разрез» «рав».«лево» "минус"
    let «т0» := «ужатьТ» «мин».«лево»
    let «нм2» := «разрез» «или».«право» "не меньше"
    let «умн» := «разрез» «нм2».«лево» "умножить на"
    if «или».«есть» && («сверху» («ужатьТ» «цель») "или").length = 2 && «лев».startsWith "не " &&
       «рав».«есть» && («сверху» («ужатьТ» («лев».«сн» 3)) "равен").length = 2 && «ужатьТ» «рав».«право» = "0" &&
       «мин».«есть» && («сверху» («ужатьТ» «рав».«лево») "минус").length = 2 && «ужатьТ» «мин».«лево» = «ужатьТ» «мин».«право» &&
       «нм2».«есть» && («сверху» («ужатьТ» «или».«право») "не меньше").length = 2 && «ужатьТ» «нм2».«право» = "0" &&
       «умн».«есть» && («сверху» («ужатьТ» «нм2».«лево») "умножить на").length = 2 &&
       «ужатьТ» «умн».«лево» = «т0» && «ужатьТ» «умн».«право» = «т0» then .ok [] else .error "не квадрат под оговоркой"
  | "начало склейки" =>
    let r := «разрез» «цель» "начинается с"
    let «лев» := «ужатьТ» r.«лево»; let «п» := «ужатьТ» r.«право»
    let «с» := «разрез» («словаС» «лев» 1) "с"
    if !(r.«есть» && («сверху» («ужатьТ» «цель») "начинается с").length = 2) then .error "не «Т начинается с П»"
    else if !«лев».startsWith "соединить " then .error "слева не склейка"
    else if !(«с».«есть» && («сверху» («ужатьТ» («словаС» «лев» 1)) "с").length = 2) then .error "у склейки не два куска"
    else
      let «л» := «ужатьТ» «с».«лево»
      if «л» = «п» then .ok [] else .ok [s!"{«вСкобки» «л»} начинается с {«вСкобки» «п»}"]
  | "пустая приставка" =>
    let r := «разрез» «цель» "начинается с"
    if r.«есть» && («сверху» («ужатьТ» «цель») "начинается с").length = 2 && «ужатьТ» r.«право» = "\"\"" then .ok []
    else .error "не «Т начинается с \"\"»"
  | _ => .error s!"закона «{«имя»}» нет в списке"


def «номерПосле» (s m : String) : Nat :=
  let «ч» := s.splitOn m
  ((«ч».drop 1).findSome? (fun x => ((x.splitOn " ").headD "").toNat?)).getD 0

def «Исх».«телоСоСтроки» (s : «Исх») («где» : Nat) («чья» : String) : String :=
  match s.«блок» «чья» with
  | none => ""
  | some (_, e) =>
    let ls := ((List.range' «где» (e - «где»)).map (fun i => «какЧитаетЯзык» (s.«сырая» i))).map «обрезать» |>.filter (· ≠ "")
    if ls.length > 1 then " ".intercalate ls else ""

def «развернутьПоТелу» (p : «Прогон») («что» «образец» «тело» «довод» : String) : «Прогон» :=
  let «имена» := «сверху» («разрез» («словаС» «образец» 1) "с").«право» "и"
  let «знач» := «сверху» («разрез» «довод» "с").«право» "и"
  let «тело» := (List.range «имена».length).foldl (fun «т» i =>
    let «имя» := «обрезать» («разрез» («имена».getD i "") "как").«право»
    let z := «обрезать» («разрез» («знач».getD i "") "равным").«право»
    if «имя» ≠ "" && z ≠ "" then «вместо» «т» «имя» z else «т») «тело»
  p.«одна» («т» («вместо» p.«первая» «что» «тело»))

def «ходРазвёртки» (p : «Прогон») (l : String) (o : «Обст») : «Прогон» := Id.run do
  let «что» := «т» («уголок» l 1)
  let «где» := «номерПосле» l "строка "
  let «имя» := «ёлочка» «что» 1
  let mut «довод» := «обрезать» («после» «что» s!"«{«имя»}» от ")
  if o.«хвост» ≠ "" && «довод».endsWith o.«хвост» then «довод» := («довод».dropEnd o.«хвост».length).toString
  «довод» := «ужатьТ» («обрезать» «довод»)
  let «вариант» := «имяВариантаТ» «довод»
  if !«естьТ» p.«первая» «что» then return p.«беда» s!"развёртка: в цели «{p.«первая»}» нет терма «{«что»}»"
  let «написано» := «уголок» l 2
  if «где» = 0 then
    if «написано» = "" then return p.«беда» "развёртка: ни номера строки, ни тела"
    let p := { p with «безПривязки» := p.«безПривязки» + 1 }
    return «развернутьПоТелу» p «что» (o.«случай» «вариант») («т» «написано») «довод»
  let «тело» := o.«исх».«по» «где»
  let «образец» := o.«исх».«по» («где» - 1)
  let «хоз» := o.«исх».«хозяин» «где»
  if «вариант» = "" then
    let mut «тт» := «т» «тело»
    if «написано» ≠ "" && «тт».startsWith "если " && «безСкобок» «написано» ≠ «безСкобок» «тт» then
      let «цел» := o.«исх».«телоСоСтроки» «где» «хоз»
      if «цел» ≠ "" && «безСкобок» «написано» = «безСкобок» «цел» then «тт» := «цел»
    if «написано» ≠ "" && «безСкобок» «написано» ≠ «безСкобок» «тт» then
      return p.«беда» s!"развёртка «{«имя»}»: запись несёт тело ⟨{«написано»}⟩, а в строке {«где»} написано «{«тт»}»"
    if «хоз» ≠ «имя» then return p.«беда» s!"развёртка «{«имя»}»: строка {«где»} стоит в функции «{«хоз»}»"
    return «развернутьПоТелу» p «что» "" (if «написано» ≠ "" then «т» «написано» else «тт») «довод»
  let mut «тело» := «тело»
  if «написано» ≠ "" then
    if «безСкобок» «написано» ≠ «безСкобок» («т» («словаС» «тело» 1)) then
      return p.«беда» s!"развёртка «{«имя»}»: запись несёт тело ⟨{«написано»}⟩, а в строке {«где»} другое"
    «тело» := "то " ++ «написано»
  if «хоз» ≠ «имя» then return p.«беда» s!"развёртка «{«имя»}»: строка {«где»} стоит в функции «{«хоз»}»"
  if !«тело».startsWith "то " then return p.«беда» s!"развёртка «{«имя»}»: строка {«где»} не начинается словом то"
  if !(«образец».startsWith "случай " && «имяВариантаТ» («словаС» «образец» 1) = «вариант») then
    return p.«беда» s!"развёртка «{«имя»}»: над строкой {«где»} не случай варианта «{«вариант»}»"
  return «развернутьПоТелу» p «что» «образец» («т» («словаС» «тело» 1)) «довод»

def «ходЗамены» (p : «Прогон») (l : String) : «Прогон» :=
  let n := «номерПосле» l "по дано "
  let «наоборот» := (l.splitOn " обратно").length > 1
  let r := «разрез» (p.«дано».getD (n - 1) "") "равно"
  let («что», «на») := if «наоборот» then (r.«право», r.«лево») else (r.«лево», r.«право»)
  if !r.«есть» then p.«беда» s!"замена по дано {n}: допущения-равенства нет"
  else if !«естьТ» p.«первая» «что» then p.«беда» s!"замена по дано {n}: в цели нет терма «{«что»}»"
  else p.«одна» («т» («вместо» p.«первая» «что» «на»))

def «ходСоседей» (p : «Прогон») (l : String) : «Прогон» :=
  let «что» := «т» («уголок» l 1)
  let op := if («сверху» «что» "плюс").length = 2 then "плюс" else if («сверху» «что» "умножить на").length = 2 then "умножить на" else ""
  let r := «разрез» «что» op
  if op = "" then p.«беда» s!"соседи: «{«что»}» не два соседа"
  else if !«естьТ» p.«первая» «что» then p.«беда» s!"соседи: в цели нет терма «{«что»}»"
  else p.«одна» («т» («вместо» p.«первая» «что» s!"{r.«право»} {op} {r.«лево»}"))

def «ходВыбора» (p : «Прогон») (l : String) : «Прогон» :=
  let «что» := «т» («уголок» l 1)
  let «пт» := «разрез» «что» "то"
  let «в» := «разрез» «пт».«право» "иначе"
  let «усл» := «словаС» «пт».«лево» 1
  if !(«пт».«есть» && «в».«есть» && «пт».«лево».startsWith "если ") then p.«беда» s!"выбор: «{«что»}» не «если У то А иначе Б»"
  else if !(«усл» = "да" || «усл» = "нет") then p.«беда» s!"выбор: условие «{«усл»}» не литерал"
  else if !«естьТ» p.«первая» «что» then p.«беда» s!"выбор: в цели нет терма «{«что»}»"
  else p.«одна» («т» («вместо» p.«первая» «что» (if «усл» = "да" then «в».«лево» else «в».«право»)))

def «ходДеления» (p : «Прогон») (l : String) : «Прогон» :=
  let «что» := «т» («уголок» l 1)
  let «ц» := p.«первая»
  if !((«ц».splitOn s!"если {«что»} то ").length > 1 || («ц».splitOn s!"если ( {«что»} ) то ").length > 1) then
    p.«беда» s!"деление: «{«что»}» не стоит условием в цели"
  else p.«заменить» [«т» («вместо» «ц» «что» "да"), «т» («вместо» «ц» «что» "нет")]

def «ходЗакона» (p : «Прогон») (l : String) : «Прогон» :=
  let «имя» := «ёлочка» l 1
  match «законЦели» «имя» p.«первая» with
  | .ok «посылки» => p.«заменить» («посылки».map «т»)
  | .error e => p.«беда» s!"закон «{«имя»}» к цели «{p.«первая»}» не подошёл: {e}"

def «сторона» (t : String) («а» «б» : String) : «Разрез» :=
  let r := «разрез» t «а»
  if r.«есть» then r else «разрез» t «б»

def «неравРазрез» (t : String) : Option (Nat × «Разрез») :=
  (["не меньше", "не больше", "больше", "меньше"].zip [0, 1, 2, 3]).findSome? fun (op, i) =>
    let r := «разрез» t op
    if r.«есть» then some (i, r) else none

def «модусПоненс» (p : «Прогон») («цельДа» «факт» «равенство» : String) : «Прогон» :=
  if «ужатьТ» («т» «цельДа») = «ужатьТ» («т» «равенство») then { p.«заменить» [] with «факт» := "" }
  else
    let «фр» := «сторона» «равенство» "равен" "равно"
    if «фр».«есть» then
      let «после» := «т» («вместо» «цельДа» «фр».«лево» «фр».«право»)
      let g := «сторона» «после» "равно" "равен"
      if g.«есть» && «ужатьТ» g.«лево» = «ужатьТ» g.«право» then { p.«заменить» [] with «факт» := "" }
      else p.«беда» s!"закрыть по свойству: факт «{«факт»}» цель не закрывает"
    else match «неравРазрез» «равенство», «неравРазрез» «цельДа» with
      | none, _ => p.«беда» s!"закрыть по свойству: факт «{«факт»}» ни равенство, ни порядок"
      | some («фи», «фн»), some («ци», «цн») =>
        if «фи» = «ци» && «ужатьТ» «фн».«лево» = «ужатьТ» «цн».«лево» && «ужатьТ» «фн».«право» = «ужатьТ» «цн».«право»
        then { p.«заменить» [] with «факт» := "" }
        else p.«беда» s!"закрыть по свойству: факт «{«факт»}» цель не замыкает"
      | some _, none => p.«беда» s!"закрыть по свойству: факт «{«факт»}» цель не замыкает"

def «закрытьПоСвойству» (p : «Прогон») (l : String) : «Прогон» := Id.run do
  let «охрана» := «обрезать» («уголок» l 1)
  let «факт» := p.«факт»
  let «ц» := p.«первая»
  if «факт» = "" then return p.«беда» "закрыть по свойству: факта не внесено"
  if «охрана» = "" then return «модусПоненс» p «ц» «факт» «факт»
  let «цт» := «разрез» «ц» "то"; let «цв» := «разрез» «цт».«право» "иначе"
  let «фт» := «разрез» «факт» "то"; let «фв» := «разрез» «фт».«право» "иначе"
  if !(«цт».«есть» && «цв».«есть» && «цт».«лево».startsWith "если " && «ужатьТ» («словаС» «цт».«лево» 1) = «ужатьТ» «охрана») then
    return p.«беда» s!"закрыть по свойству по охране ⟨{«охрана»}⟩: цель не под этой охраной"
  if «ужатьТ» «цв».«право» ≠ "да" then return p.«беда» "закрыть по свойству: ветвь иначе цели не да"
  if «фт».«есть» && «фв».«есть» && «фт».«лево».startsWith "если " then
    if «ужатьТ» («словаС» «фт».«лево» 1) ≠ «ужатьТ» «охрана» then return p.«беда» "закрыть по свойству: факт под другой охраной"
    return «модусПоненс» p «цв».«лево» «факт» «фв».«лево»
  return «модусПоненс» p «цв».«лево» «факт» «факт»

def «ходЗакрытия» (p : «Прогон») (l : String) (o : «Обст») : «Прогон» :=
  let «ц» := p.«первая»
  match «слово» l 4 with
  | "дано" =>
    let n := «номерПосле» l "закрыть дано "
    let «ф» := p.«дано».getD (n - 1) ""
    if «ужатьТ» «ф» = «ужатьТ» «ц» && n ≥ 1 then p.«заменить» [] else p.«беда» s!"закрыть дано {n}: цель «{«ц»}» не допущение «{«ф»}»"
  | "тождеством" =>
    let r := «сторона» «ц» "равно" "равен"
    if r.«есть» && «ужатьТ» r.«лево» = «ужатьТ» r.«право» then p.«заменить» [] else p.«беда» s!"закрыть тождеством: у цели «{«ц»}» стороны разные"
  | "истиной" => if «ц» = "да" then p.«заменить» [] else p.«беда» s!"закрыть истиной: цель «{«ц»}» не да"
  | "требованием" =>
    let «имя» := «ёлочка» l 1
    let «где» := «номерПосле» l "строка "
    let «ви» := o.«исх».«по» «где»
    let «ф» := «после» «ви» s!"требует «{«имя»}» "
    if !«ви».startsWith s!"требует «{«имя»}» " then p.«беда» s!"закрыть требованием «{«имя»}»: в строке {«где»} стоит «{«ви»}»"
    else if o.«исх».«хозяин» «где» ≠ o.«функция» then p.«беда» s!"закрыть требованием «{«имя»}»: строка {«где»} не в функции «{o.«функция»}»"
    else if !«совпали» («т» «ф») («т» «ц») then p.«беда» s!"закрыть требованием «{«имя»}»: требование не цель"
    else p.«заменить» []
  | "по" => «закрытьПоСвойству» p l
  | w => p.«беда» s!"закрыть «{w}» неизвестно"

def «ходВычисления» (p : «Прогон») (l : String) : «Прогон» :=
  let «что» := «т» («уголок» l 1)
  let «зап» := «т» («уголок» l 2)
  if «зап» = "" then p.«беда» s!"вычислить «{«что»}»: нет значения"
  else if !«естьТ» p.«первая» «что» then p.«беда» s!"вычислить: в цели нет терма «{«что»}»"
  else if «что» = «зап» then p.«одна» p.«первая»
  else match «значение» «что» 64 with
    | none => p.«отказ» s!"вычислить «{«что»}»: терм не замкнут — считать нечего"
    | some v =>
      match «значение» s!"( {«что»} ) равен ( {«зап»} )" 64 with
      | some (.«п» true) => p.«одна» («т» («вместо» p.«первая» «что» «зап»))
      | _ => p.«беда» s!"вычислить «{«что»}»: посчитано {v.«текст»}, а запись несёт ⟨{«зап»}⟩"

def «ходПерепискиФормой» (p : «Прогон») (l : String) : «Прогон» :=
  let «лево» := «т» («уголок» l 1)
  let «право» := «т» («уголок» l 2)
  let «закон» := «ёлочка» («после» l "законом ") 1
  if «слово» l 4 ≠ "формой" then p.«беда» s!"ход «переписать {«слово» l 4}» неизвестен"
  else if «право» = "" then p.«беда» "переписать формой: нет правой стороны"
  else if !«естьТ» p.«первая» «лево» then p.«беда» s!"переписать формой: в цели нет терма «{«лево»}»"
  else match «формаЗаконом» «лево» «закон» with
    | none => p.«беда» s!"переписать формой законом «{«закон»}»: левая «{«лево»}» не той формы"
    | some «собрано» =>
      if «собрано» ≠ «право» then p.«беда» s!"переписать формой законом «{«закон»}»: правая — «{«собрано»}», а записано «{«право»}»"
      else p.«одна» («т» («вместо» p.«первая» «лево» «право»))

def «снятоВТочке» (p : «Прогон») (o : «Обст») («инст» : String) : Bool :=
  let «и» := «т» «инст»
  let «цт» := «разрез» p.«первая» "то"; let «цв» := «разрез» «цт».«право» "иначе"
  (o.«исх».«требования» o.«функция»).any (fun l => «совпали» «и» («т» («формулаТребования» l))) ||
  («цт».«есть» && «цв».«есть» && «цт».«лево».startsWith "если " && «ужатьТ» «цв».«право» = "да" && «совпали» «и» («т» («словаС» «цт».«лево» 1)))
  || p.«дано».any (fun d => «совпали» «и» («т» d))

def «фактУтверждения» (p : «Прогон») (l : String) (o : «Обст») («имяП» : String) («где» : Nat) : «Прогон» := Id.run do
  let s := o.«исх»
  let «имена» := s.«именаВысказывания» «где»
  let mut «инст» := «т» (s.«цельВысказывания» «где»)
  if s.«высказывание» s!"утверждение «{«имяП»}»" ≠ «где» then return p.«беда» s!"факт по свойству «{«имяП»}»: строка {«где»} не заголовок утверждения"
  if s.«свойство» «имяП» ≠ 0 then return p.«беда» s!"факт по свойству: имя «{«имяП»}» и у постусловия, и у утверждения"
  let «хв» := «после» l " подстановка "
  let «пары» := ((«хв».splitOn "»").dropLast).map (fun x => x)
  let mut «пн» : List String := []
  let mut «пт» : List String := []
  let mut q := «хв»
  let mut ok := true
  for _ in [0:64] do
    q := «обрезать» q
    if q = "" then break
    if !q.startsWith "«" then ok := false; break
    match (q.«сн» 1).splitOn "» ⟨" with
    | n :: r :: rest =>
      let r := "» ⟨".intercalate (r :: rest)
      match r.splitOn "⟩" with
      | t :: rest2 => «пн» := «пн» ++ [n]; «пт» := «пт» ++ [t]; q := "⟩".intercalate rest2
      | [] => ok := false; break
    | _ => ok := false; break
  let _ := «пары»
  if !ok || «пн».length ≠ «имена».length then return p.«беда» s!"факт по свойству «{«имяП»}»: подстановка не пары на каждое связанное имя"
  for i in [0:«имена».length] do
    if «пн».getD i "" ≠ «имена».getD i "" then return p.«беда» s!"факт по свойству «{«имяП»}»: чужая подстановка"
    for j in [i+1:«имена».length] do
      if «естьТ» («т» («пт».getD i "")) («имена».getD j "") then return p.«беда» s!"факт по свойству «{«имяП»}»: подстановка захватила бы имя"
  let «огр» := (s.«подВысказыванием» «где»).filterMap (fun x => if (x.splitOn " таких что ").length > 1 then some («после» x " таких что ") else none)
  for i in [0:«имена».length] do «инст» := «вместо» «инст» («имена».getD i "") («т» («пт».getD i ""))
  for «ог0» in «огр» do
    let mut «ог» := «т» «ог0»
    for i in [0:«имена».length] do «ог» := «вместо» «ог» («имена».getD i "") («т» («пт».getD i ""))
    if !«снятоВТочке» p o «ог» then return p.«беда» s!"факт по свойству «{«имяП»}»: ограничение «{«ог0»}» не снято"
  return { p with «факт» := «т» «инст», «ходов» := p.«ходов» + 1 }

def «ходФакта» (p : «Прогон») (l : String) (o : «Обст») : «Прогон» := Id.run do
  let «имяП» := «ёлочка» l 1
  let «где» := «номерПосле» l "строка "
  let «вызов» := «т» («уголок» l 1)
  let «имяГ» := «ёлочка» «вызов» 1
  let «подст» := (l.splitOn " подстановка ").length > 1
  let s := o.«исх»
  if «имяП» = "" || «где» = 0 || («имяГ» = "" && !«подст») then return p.«беда» s!"факт по свойству: ход неполон"
  if o.«обяз» ≠ "" && «имяП» = o.«обяз» then return p.«беда» s!"факт по свойству «{«имяП»}»: круг — ссылается на себя"
  if !o.«доказанные».contains «имяП» then
    let «чужое» := s.«свойство» «имяП» = 0 && s.«высказывание» s!"утверждение «{«имяП»}»" = 0 && s.«ввозит?»
    if o.«объявленные».contains «имяП» then return p.«отказ» s!"факт по свойству «{«имяП»}»: не проверено по существу раньше"
    if «чужое» then return p.«отказ» s!"факт по свойству «{«имяП»}»: из другого модуля без набора"
    return p.«беда» s!"факт по свойству «{«имяП»}»: не доказано раньше этой цели"
  if «подст» then return «фактУтверждения» p l o «имяП» «где»
  let mut «ви» := s.«по» «где»
  if «ви».startsWith "для всех " && !((«ви».splitOn " таких что ").length > 1) && («ви».splitOn " обеспечивает «").length > 1 then
    «ви» := "обеспечивает «" ++ "обеспечивает «".intercalate ((«ви».splitOn " обеспечивает «").drop 1)
  if !«ви».startsWith s!"обеспечивает «{«имяП»}» " then return p.«беда» s!"факт по свойству «{«имяП»}»: строка {«где»} не несёт его"
  if s.«хозяин» «где» ≠ «имяГ» then return p.«беда» s!"факт по свойству «{«имяП»}»: привязка не по ребру"
  if s.«свойство» «имяП» ≠ «где» then return p.«беда» s!"факт по свойству «{«имяП»}»: строка {«где»} не первое объявление"
  let «телоП» := «обещанная» («обрезать» («после» «ви» s!"обеспечивает «{«имяП»}» "))
  let param := (s.«доводы» «имяГ»).«голые»
  let «арги» := «доводыВызова» («после» «вызов» s!"«{«имяГ»}» от ")
  if param.length ≠ «арги».length then return p.«беда» s!"факт по свойству «{«имяП»}»: арность не совпала"
  for i in [0:param.length] do
    for j in [i+1:param.length] do
      if «естьТ» («арги».getD i "") (param.getD j "") then return p.«беда» s!"факт по свойству «{«имяП»}»: захват имени"
  for «тр» in s.«требования» «имяГ» do
    let mut «пи» := «формулаТребования» «тр»
    for j in [0:param.length] do «пи» := «вместо» «пи» (param.getD j "") («т» («арги».getD j ""))
    if !«снятоВТочке» p o «пи» then return p.«беда» s!"факт по свойству «{«имяП»}»: предусловие вызванной не снято"
  let mut «инст» := «телоП»
  for i in [0:param.length] do «инст» := «вместо» «инст» (param.getD i "") («т» («арги».getD i ""))
  «инст» := «вместо» «инст» "результат" («вСкобки» «вызов»)
  return { p with «факт» := «т» «инст», «ходов» := p.«ходов» + 1 }

def «голоеРавенство» («факт» : String) : Option (String × String) :=
  let t := «ужатьТ» «факт»
  if [" или ", " и притом ", " то ", " иначе "].any (fun w => «найтиСверху» t w > 0) then none
  else if t.startsWith "не " || t.startsWith "если " then none
  else
    let r := «сторона» t "равен" "равно"
    if r.«есть» && !r.«лево».endsWith " не" then some (r.«лево», r.«право») else none

def «ходПерепискиСвойством» (p : «Прогон») (l : String) (o : «Обст») : «Прогон» := Id.run do
  let «имя» := «ёлочка» l 1
  let «лево» := «т» («уголок» l 1)
  let «право» := «т» («уголок» l 2)
  let «где» := «номерПосле» l "строка "
  if !((l.splitOn " подстановка ").length > 1) || «право» = "" then return p.«беда» s!"переписать по свойству «{«имя»}»: ход неполон"
  if (o.«исх».«подВысказыванием» «где»).any (fun x => (x.splitOn " таких что ").length > 1) then
    return p.«беда» s!"переписать по свойству «{«имя»}»: у утверждения есть «таких что»"
  let «было» := p.«ходов»
  let p := «ходФакта» p l o
  if p.«ходов» = «было» then return p
  let p := { p with «ходов» := «было» }
  match «голоеРавенство» p.«факт» with
  | none => return p.«беда» s!"переписать по свойству «{«имя»}»: не голое равенство"
  | some («л», «п») =>
    let p := { p with «факт» := "" }
    if «ужатьТ» «л» ≠ «ужатьТ» «лево» || «ужатьТ» «п» ≠ «ужатьТ» «право» then return p.«беда» s!"переписать по свойству «{«имя»}»: инстанция не та"
    if !«естьТ» p.«первая» «лево» then return p.«беда» s!"переписать по свойству «{«имя»}»: в цели нет терма"
    return p.«одна» («т» («вместо» p.«первая» «лево» «право»))

def «ходСвязки» (p : «Прогон») (l : String) : «Прогон» :=
  let «св» := «обрезать» («уголок» l 1)
  let «какая» := «слово» («обрезать» («после» l "⟩")) 1
  let «ц» := p.«первая»
  let r := «разрез» «ц» «св»
  if «св» ≠ "и притом" && «св» ≠ "или" then p.«беда» s!"связка ⟨{«св»}⟩ неизвестна"
  else if !r.«есть» || («сверху» («ужатьТ» «ц») «св»).length ≠ 2 then p.«беда» s!"связка ⟨{«св»}⟩: цель не две половины"
  else if !«простойТ» r.«лево» || !«простойТ» r.«право» then p.«беда» s!"связка ⟨{«св»}⟩: половины не в скобках"
  else if «св» = "и притом" then
    if «какая» ≠ "" then p.«беда» "связка ⟨и притом⟩ половину не выбирает" else p.«заменить» [«т» r.«лево», «т» r.«право»]
  else if «какая» = "левая" then p.«одна» («т» r.«лево»)
  else if «какая» = "правая" then p.«одна» («т» r.«право»)
  else p.«беда» "связка ⟨или⟩: половина не названа"

def «ходПусть» (p : «Прогон») (l : String) (o : «Обст») : «Прогон» := Id.run do
  let «где» := «номерПосле» l "строка "
  let x := «какЧитаетЯзык» (o.«исх».«по» «где»)
  if «слово» l 4 ≠ "пусть" then return p.«беда» s!"ход «подставить {«слово» l 4}» неизвестен"
  if «где» = 0 then return p.«беда» "подставить пусть: номер строки не назван"
  if !x.startsWith "пусть " || «слово» x 3 ≠ "равно" then return p.«беда» s!"подставить пусть: строка {«где»} не «пусть имя равно значение»"
  let «имя» := «слово» x 2
  let «знач» := «т» («словаС» x 3)
  if «имя» = "" || («имя».splitOn "(").length > 1 || («имя».splitOn "«").length > 1 || «знач» = "" then return p.«беда» "подставить пусть: имя не одно слово"
  if o.«исх».«хозяин» «где» ≠ o.«функция» then return p.«беда» s!"подставить пусть: строка {«где»} не в функции «{o.«функция»}»"
  let «д» := o.«исх».«доводы» o.«функция»
  if «имя» = «д».«имена».headD "" || «естьТ» «д».«хвост» «имя» then return p.«беда» s!"подставить пусть: «{«имя»}» — довод функции"
  if «естьТ» «знач» «имя» then return p.«беда» s!"подставить пусть: значение зовёт своё имя"
  if !«естьТ» p.«первая» «имя» then return p.«беда» s!"подставить пусть: в цели нет имени «{«имя»}»"
  return p.«одна» («т» («вместо» p.«первая» «имя» «знач»))

def «ходНуля» (p : «Прогон») (l : String) (o : «Обст») : «Прогон» := Id.run do
  let «что» := «т» («уголок» l 1)
  if «слово» l 4 ≠ "ноль" then return p.«беда» s!"ход «нейтральный {«слово» l 4}» неизвестен"
  let r := «разрез» «что» "плюс"
  if !r.«есть» || («сверху» («ужатьТ» «что») "плюс").length ≠ 2 then return p.«беда» "нейтральный ноль: не сумма двух"
  let «т0» := if «ужатьТ» r.«право» = "0" then «ужатьТ» r.«лево» else if «ужатьТ» r.«лево» = "0" then «ужатьТ» r.«право» else ""
  if «т0» = "" then return p.«беда» "нейтральный ноль: нет слагаемого 0"
  let «есть» := o.«ограничения».any fun «ог» =>
    let «б» := «разрез» «ог» "больше"; let «м» := «разрез» «ог» "меньше"
    («б».«есть» && «ужатьТ» «б».«лево» = «т0» && (match «литералЧисла?» («ужатьТ» «б».«право») with | some x => x ≥ 0 | none => false)) ||
    («м».«есть» && «ужатьТ» «м».«право» = «т0» && (match «литералЧисла?» («ужатьТ» «м».«лево») with | some x => x ≥ 0 | none => false))
  if !«есть» then return p.«беда» s!"нейтральный ноль: посылки «{«т0»} больше К» нет"
  if !«естьТ» p.«первая» «что» then return p.«беда» "нейтральный ноль: в цели нет терма"
  return p.«одна» («т» («вместо» p.«первая» «что» «т0»))

def «ходШага» (p : «Прогон») (l : String) (o : «Обст») : «Прогон» :=
  let «род» := «слово» l 3
  let «номер» := («слово» l 2).toNat?.getD 0
  if !p.«идёт» then (if p.«оборван» then p else p.«беда» s!"ход «{l}» стоит до «ход цель»")
  else if «номер» ≠ p.«ходов» + 1 then p.«беда» s!"ход {«номер»} стоит {p.«ходов» + 1}-м"
  else if p.«цели».isEmpty then p.«беда» s!"ход {«номер»}: целей не осталось"
  else match «род» with
    | "развернуть" => «ходРазвёртки» p l o
    | "замена" => «ходЗамены» p l
    | "соседи" => «ходСоседей» p l
    | "выбор" => «ходВыбора» p l
    | "деление" => «ходДеления» p l
    | "закон" => «ходЗакона» p l
    | "закрыть" => «ходЗакрытия» p l o
    | "вычислить" => «ходВычисления» p l
    | "переписать" => if «слово» l 4 = "по" then «ходПерепискиСвойством» p l o else «ходПерепискиФормой» p l
    | "факт" => «ходФакта» p l o
    | "связка" => «ходСвязки» p l
    | "подставить" => «ходПусть» p l o
    | "нейтральный" => «ходНуля» p l o
    | r => p.«беда» s!"ход «{r}» неизвестен"

def «ходДопущения» (p : «Прогон») (l : String) (o : «Обст») : «Прогон» :=
  let «имя» := «ёлочка» l 1
  let «сл» := o.«случай» p.«вариант»
  let «поле» := «полеОбразца» «сл» «имя»
  if !((l.splitOn " предположение по ").length > 1) then p.«беда» "ход дано: источник допущения один — «предположение по»"
  else if «поле» = "" then p.«беда» s!"допущение по «{«имя»}»: образец не связывает"
  else if !o.«рекурсивно» p.«вариант» «поле» then p.«беда» s!"допущение по «{«имя»}»: поле не того же типа"
  else { p with «дано» := p.«дано» ++ [o.«приЗначении» «имя»] }

def «проигратьБлок» (o : «Обст») : «Прогон» := Id.run do
  let mut p : «Прогон» := {}
  for s0 in o.«свои» do
    let s := «обрезать» s0
    if s.startsWith "посылка " then
      if p.«идёт» then p := p.«беда» s!"сведение посылки «{p.«вариант»}» оборвано"
      p := { p with «цели» := [], «дано» := [], «ходов» := 0, «идёт» := false, «оборван» := false, «вариант» := «ёлочка» s 1, «факт» := "" }
      continue
    if !s.startsWith "ход " then continue
    match «слово» s 2 with
    | "цель" =>
      let «н» := o.«начальная» p.«вариант»
      if «н» = "" then p := p.«беда» s!"ход цель: случая варианта «{p.«вариант»}» нет"
      else p := { p with «цели» := [«н»], «дано» := [], «ходов» := 0, «идёт» := true, «оборван» := false, «факт» := "" }
    | "дано" => p := «ходДопущения» p s o
    | "конец" =>
      if !p.«идёт» then
        if !p.«оборван» then p := p.«беда» "ход конец без «ход цель»"
      else if !p.«цели».isEmpty then p := p.«беда» s!"сведение «{p.«вариант»}» не доведено: первая цель «{p.«первая»}»"
      else p := { p with «проиграно» := p.«проиграно» + 1, «идёт» := false }
    | _ => p := «ходШага» p s o
  if p.«идёт» then p := p.«беда» s!"сведение «{p.«вариант»}» оборвано на конце блока"
  return p

end «Второй»
