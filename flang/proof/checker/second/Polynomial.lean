import Ring

open «Разбор»

namespace «Второй»

/-!
# Модель правила «кольцо точного целого»

Сверщик раскрывает обе стороны равенства в многочлены — списки одночленов, одночлен —
список листьев — и принимает место, когда многочлены равны как многомножества одночленов
(`«многочленыРавны»`). Здесь многочлену дано значение: сумма по одночленам произведений
значений листьев. Доказано: принятое равенство верно при любых значениях листьев.

Что терм-текст читается в многочлен верно (`«многочленКольца»` — разбор текста с
развёрткой плоских вызовов) — посылка толкования (`«многочлен-читает»`), как чтение
текста у ходов теоремы: сверено на корпусе, не доказано. Запасной приём «сумма над
отрезком» (сторона не читается многочленом, носитель — «неотрицательное») моделью не
покрыт: теорема называет его вторым исходом, а не выдаёт за доказанный.
-/

/-- Значение одночлена: произведение значений его листьев; пустой одночлен — единица. -/
def «значениеОдночлена» (v : String → Int) : List String → Int
  | [] => 1
  | x :: r => v x * «значениеОдночлена» v r

/-- Значение многочлена: сумма значений одночленов; пустой многочлен — ноль. -/
def «значениеМногочлена» (v : String → Int) : «Многочлен» → Int
  | [] => 0
  | m :: r => «значениеОдночлена» v m + «значениеМногочлена» v r

theorem «одночлен-склейка» (v : String → Int) (a b : List String) :
    «значениеОдночлена» v (a ++ b) = «значениеОдночлена» v a * «значениеОдночлена» v b := by
  induction a with
  | nil => simp [«значениеОдночлена»]
  | cons x r ih => simp [«значениеОдночлена», ih, Int.mul_assoc]

theorem «одночлен-перестановка» (v : String → Int) {a b : List String} (h : a.Perm b) :
    «значениеОдночлена» v a = «значениеОдночлена» v b := by
  induction h with
  | nil => rfl
  | cons x _ ih => simp [«значениеОдночлена», ih]
  | swap x y l => simp [«значениеОдночлена», Int.mul_left_comm]
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

/-- Сортировка листьев одночлена значения не меняет. -/
theorem «одночлен-сортировка» (v : String → Int) (a : List String) :
    «значениеОдночлена» v («сортСтрок» a) = «значениеОдночлена» v a :=
  «одночлен-перестановка» v (List.mergeSort_perm a _)

/-- Сумма: многочлен суммы — склейка многочленов слагаемых. -/
theorem «многочлен-сумма» (v : String → Int) (a b : «Многочлен») :
    «значениеМногочлена» v (a ++ b) = «значениеМногочлена» v a + «значениеМногочлена» v b := by
  induction a with
  | nil => simp [«значениеМногочлена»]
  | cons x r ih => simp [«значениеМногочлена», ih, Int.add_assoc]

theorem «многочлен-на-одночлен» (v : String → Int) (a : List String) (p : «Многочлен») :
    «значениеМногочлена» v (p.map (fun b => «сортСтрок» (a ++ b))) =
      «значениеОдночлена» v a * «значениеМногочлена» v p := by
  induction p with
  | nil => simp [«значениеМногочлена»]
  | cons x r ih =>
    simp [«значениеМногочлена», ih, «одночлен-сортировка», «одночлен-склейка», Int.mul_add]

/-- Произведение: многочлен произведения — попарные произведения одночленов множителей. -/
theorem «многочлен-произведение» (v : String → Int) (a p : «Многочлен») :
    «значениеМногочлена» v (a.flatMap (fun x => p.map (fun b => «сортСтрок» (x ++ b)))) =
      «значениеМногочлена» v a * «значениеМногочлена» v p := by
  induction a with
  | nil => simp [«значениеМногочлена»]
  | cons x r ih =>
    simp [«значениеМногочлена», «многочлен-сумма», «многочлен-на-одночлен», ih, Int.add_mul]

theorem «многочлен-перестановка» (v : String → Int) {a b : «Многочлен»} (h : a.Perm b) :
    «значениеМногочлена» v a = «значениеМногочлена» v b := by
  induction h with
  | nil => rfl
  | cons x _ ih => simp [«значениеМногочлена», ih]
  | swap x y l => simp [«значениеМногочлена», Int.add_left_comm]
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

/-- Многочлены, которые сверщик счёл равными, равны значением при любых значениях листьев. -/
theorem «равные-многочлены-значением» (v : String → Int) (a b : «Многочлен»)
    (h : «многочленыРавны» a b = true) : «значениеМногочлена» v a = «значениеМногочлена» v b :=
  «многочлен-перестановка» v (List.isPerm_iff.mp h)

/-- Ноль и единица — разные многочлены: печать их больше не склеивает. -/
theorem «ноль-не-единица» : «многочленыРавны» [] [[]] = false := by decide

/-- Толкование правила над исходником `s` и местом (`«свои»`, `«чья»`): миры — значения имён,
    у листа и у терма-текста в мире целое значение, у формулы — истинность. Посылки — законы
    чтения текста: терм, прочитанный многочленом, равен значению многочлена; равенство двух
    сторон с равными значениями верно; подстановка тела функции вместо слова «результат»
    цель не меняет. -/
structure «ТолкованиеКольца» (s : «Исх») («свои» : List String) («чья» : String) where
  «Мир» : Type
  «лист» : «Мир» → String → Int
  «терм» : «Мир» → String → Int
  «верно» : «Мир» → String → Prop
  «многочлен-читает» : ∀ w t p, «многочленКольца» s «свои» «чья» t = .ok p →
    «терм» w t = «значениеМногочлена» («лист» w) p
  «равенство-верно» : ∀ w g, («кольцоРазрез» g).«есть» = true →
    «терм» w («кольцоРазрез» g).«лево» = «терм» w («кольцоРазрез» g).«право» → «верно» w g
  «тело-результата» : ∀ w g, «верно» w («цельСТелом» s «чья» g) → «верно» w g

/-- **Путь «кольцо точного целого» состоятелен.** Если `«кольцоТочногоЦелого»` приняло
    место, то цель верна в каждом мире толкования — либо место принято запасным приёмом
    «сумма над отрезком» (одна из сторон многочленом не читается), которого модель не
    покрывает. -/
theorem «кольцо-состоятельно» {s : «Исх»} {«свои» : List String} {«чья» : String}
    (I : «ТолкованиеКольца» s «свои» «чья») («цель0» : String)
    (h : «кольцоТочногоЦелого» s «свои» «чья» «цель0» = .ok ()) :
    (∀ w, I.«верно» w «цель0») ∨
    («суммаНадОтрезком» s «свои» «чья» («кольцоРазрез» («цельСТелом» s «чья» «цель0»)).«лево»
        («кольцоРазрез» («цельСТелом» s «чья» «цель0»)).«право» = true ∧
      ((«многочленКольца» s «свои» «чья» («кольцоРазрез» («цельСТелом» s «чья» «цель0»)).«лево»).isOk = false ∨
       («многочленКольца» s «свои» «чья» («кольцоРазрез» («цельСТелом» s «чья» «цель0»)).«право»).isOk = false)) := by
  unfold «кольцоТочногоЦелого» at h
  dsimp only at h
  generalize hr : «кольцоРазрез» («цельСТелом» s «чья» «цель0») = r at h ⊢
  split at h
  · simp [throw, throwThe, MonadExceptOf.throw] at h
  · rename_i hcut
    simp at hcut
    split at h
    · rename_i pl pr hl hp
      split at h
      · rename_i heq
        left
        intro w
        apply I.«тело-результата»
        apply I.«равенство-верно» w _ (by rw [hr]; exact hcut)
        rw [hr, I.«многочлен-читает» w _ _ hl, I.«многочлен-читает» w _ _ hp]
        exact «равные-многочлены-значением» _ _ _ heq
      · simp [throw, throwThe, MonadExceptOf.throw] at h
    · rename_i e _ hl
      split at h
      · rename_i hsum
        right
        exact ⟨hsum, Or.inl (by rw [hl]; rfl)⟩
      · simp [throw, throwThe, MonadExceptOf.throw] at h
    · rename_i e hp _
      split at h
      · rename_i hsum
        right
        exact ⟨hsum, Or.inr (by rw [hp]; rfl)⟩
      · simp [throw, throwThe, MonadExceptOf.throw] at h

end «Второй»
