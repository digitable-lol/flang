def «именаКвантора» («место» : String) : List String :=
  let l := «какЧитаетЯзык» «место»
  match l.splitOn "для всех " with
  | «до» :: «после» :: «ещё» =>
    if («до».splitOn "обеспечивает ").length > 1 then [] else
    let t := «заменить» ("для всех ".intercalate («после» :: «ещё»)) " для всех " " и "
    let t := (t.splitOn " обеспечивает ").headD t
    let t := (t.splitOn " таких что ").headD t
    (t.splitOn " и ").map «голо»
  | _ => []

inductive «Носитель» where
  | «алгебра»
  | «отрезок»
  | «отрезокФормой»
  | «свёртка»
  | «чужой» (w : String)
  deriving BEq

def «носительСлова» (w : String) : «Носитель» :=
  match w with
  | "algebra" => .«алгебра»
  | "segment" => .«отрезок»
  | "segment-form" => .«отрезокФормой»
  | "fold" => .«свёртка»
  | _ => .«чужой» w

structure «Принцип» where
  «тип» : String
  «по» : String
  «носитель» : «Носитель»

def «принципБлока» («свои» : List String) : Option «Принцип» :=
  («свои».map «обрезать»).find? (·.startsWith "принцип тип ") |>.map fun l =>
    { «тип» := «ёлочка» l 1, «по» := «ёлочка» l 2, «носитель» := «носительСлова» («слово» («после» l "носитель ") 1) }

structure «Посылка» where
  «строка» : String
  «имя» : String
  «вариант» : String
  «правило» : String
  «вид» : String
  «вердикт» : String
  «закрыта» : String
  «шагов» : Nat

def «прочестьПосылку» (l : String) : «Посылка» :=
  { «строка» := l, «имя» := «ёлочка» l 1, «вариант» := «ёлочка» l 2, «правило» := «ёлочка» l 3,
    «вид» := «слово» («после» l "вид ") 1,
    «вердикт» := «слово» («после» l "вердикт ") 1,
    «закрыта» := «слово» («после» l "закрыта ") 1,
    «шагов» := «номерПосле» l "шагов " }

def «посылкиБлока» («свои» : List String) : List «Посылка» :=
  («свои».map «обрезать»).filter (·.startsWith "посылка ") |>.map «прочестьПосылку»

inductive «ВидОбъявления» where
  | «сумма»
  | «встроеннаяСумма»
  | «запись»
  | «отрезок»
  | «нет»
  deriving BEq

def «ВидОбъявления».«слово» : «ВидОбъявления» → String
  | .«сумма» => "сумма"
  | .«встроеннаяСумма» => "встроенная-сумма"
  | .«запись» => "запись"
  | .«отрезок» => "отрезок"
  | .«нет» => ""

structure «ОбъявлениеТипа» where
  «вид» : «ВидОбъявления» := .«нет»
  «варианты» : List String := []
  «основа» : String := ""
  «откуда» : String := ""
  «арности» : String := ""

def «заголовокСуммы?» (l t : String) : Bool :=
  l = s!"тип «{t}»" || (l.startsWith s!"тип «{t}» от " && !((l.splitOn "» это ").length > 1))

def «рекурсивныхЧастей» («вариант» «тип» : String) : Nat :=
  let «хв» := match «вариант».splitOn " содержит " with
    | _ :: r => " содержит ".intercalate r
    | [] => ""
  ((«хв».splitOn ",").filter fun k =>
    let t := «обрезать» ((k.splitOn ":").getD 1 "")
    t = s!"«{«тип»}»" || t.startsWith s!"«{«тип»}» от ").length

def «Исх».«вариантыПодЗаголовком» (s : «Исх») (h : Nat) : List String :=
  ((List.range' (h + 1) (s.«число» - h)).map s.«по»).filter (· ≠ "") |>.takeWhile (·.startsWith "вариант ")

def «Исх».«объявлениеТипаС» (s : «Исх») («имя» : String) : Nat → «ОбъявлениеТипа»
  | 0 => { «основа» := «обрезать» «имя» }
  | fuel + 1 =>
    let g := «обрезать» «имя»
    let base : «ОбъявлениеТипа» := { «основа» := g }
    if g = "" then base
    else if g = "список" || g = "строка" then
      { base with «вид» := .«встроеннаяСумма», «откуда» := s!"встроенный «{g}»",
                  «арности» := "«пусто» 0 «голова и хвост» 1", «варианты» := ["пусто", "голова и хвост"] }
    else if «натуральноеИмя» g then { base with «вид» := .«отрезок», «откуда» := s!"встроенный «{g}»" }
    else
      let «псевдоним» := s!"тип «{g}» это "
      match s.«номера».find? (fun i => let l := s.«по» i; «заголовокСуммы?» l g || l.startsWith «псевдоним» || l = s!"объект «{g}»") with
      | none => base
      | some i =>
        let l := s.«по» i
        if «заголовокСуммы?» l g then
          let vs := s.«вариантыПодЗаголовком» i
          if vs.isEmpty then base else
          { base with «вид» := .«сумма», «откуда» := s!"сумма «{g}» строка {i}", «варианты» := vs.map «имяВарианта»,
                      «арности» := " ".intercalate (vs.map fun v => s!"«{«имяВарианта» v}» {«рекурсивныхЧастей» v g}") }
        else if l.startsWith «псевдоним» then
          let k := s.«объявлениеТипаС» («имяТипа» («после» l "» это ")) fuel
          { k with «откуда» := if k.«откуда» = "" then "" else s!"псевдоним «{g}» строка {i} → {k.«откуда»}" }
        else { base with «вид» := .«запись», «варианты» := [g], «откуда» := s!"запись «{g}» строка {i}", «арности» := s!"«{g}» 0" }

def «Исх».«объявлениеТипа» (s : «Исх») («имя» : String) : «ОбъявлениеТипа» := s.«объявлениеТипаС» «имя» 9

def «Исх».«вариантыТипаПринципа» (s : «Исх») («тип» : String) : List String :=
  let o := s.«объявлениеТипа» «тип»
  if o.«вид» == .«сумма» || o.«вид» == .«встроеннаяСумма» then o.«варианты» else []

def «Исх».«строкаВариантаТипа» (s : «Исх») («тип» «вариант» : String) : String := Id.run do
  let «заг» := (s.«объявлениеТипа» «тип»).«основа»
  let mut «внутри» := false
  let mut r := ""
  for i in s.«номера» do
    let l := s.«по» i
    if «заголовокСуммы?» l «заг» then «внутри» := true; continue
    if !«внутри» then continue
    if l.startsWith "вариант " then
      if «имяВарианта» l = «вариант» then r := l
      continue
    if l = "" then continue
    «внутри» := false
  return r

def «видПоИмени» («имя» : String) : Option String :=
  if «имя» = "дно" || «имя» = "начало свёртки" then some "base"
  else if «имя» = "спуск" || «имя» = "шаг свёртки" then some "step"
  else none

def «Исх».«видПоВарианту» (s : «Исх») («тип» «вариант» : String) : Option String :=
  if «тип» = "список" || «тип» = "строка" then
    if «вариант» = "пусто" then some "base" else if «вариант» = "голова и хвост" then some "step" else none
  else
    let l := s.«строкаВариантаТипа» «тип» «вариант»
    if l = "" then none
    else if !((l.splitOn "содержит ").length > 1) then some "base"
    else if ((«после» l "содержит ").splitOn s!"«{«тип»}»").length > 1 then some "step" else some "base"

def «Исх».«естьВетвьВарианта» (s : «Исх») («функция» «вариант» : String) : Bool :=
  match s.«блок» «функция» with
  | none => true
  | some (a, b) => (List.range' a (b - a)).any fun i =>
      let l := s.«по» i
      l.startsWith "случай " && «вариантСлучая» («словаС» l 1) = «вариант»

def «Исх».«свёрткаПоДоводу» (s : «Исх») («чья» «по» «вариант» : String) : Bool :=
  «вариант» = "пусто" &&
  match s.«блок» «чья» with
  | none => false
  | some (a, b) =>
    let d := (s.«доводы» «чья»).«голые»
    let t := s.«телоТекстом» a b
    d.any fun x => (x = «по» || d.length = 1) && t.startsWith s!"свёртка {x} начиная с "

def «шаговСлучая» (s : «Исх») («свои» : List String) («вариант» : String) : Option Nat :=
  («свои».map «обрезать»).foldl (fun acc z =>
    if z.startsWith "случай строка" && «имяВарианта» («словаС» (s.«по» («номерПосле» z "строка ")) 1) = «вариант»
    then some («номерПосле» z "шагов ") else acc) none

def «Исх».«типДоводаУМеста» (s : «Исх») («место» «имя» : String) : String := Id.run do
  let w := s.«высказывание» «место»
  if w ≠ 0 then return s.«типВысказывания» w «имя»
  let mut t := ""
  let mut «внутри» := false
  for i in s.«номера» do
    let «сыр» := s.«сырая» i
    let l := s.«по» i
    if «сыр».startsWith "функция «" || «сыр».startsWith "тотальная функция «" then «внутри» := true; t := ""
    else if «внутри» && l.startsWith "принимает " then t := s.«типДоводаВСтроке» l «имя»
    if l = «место» then return t
  return ""

def «Исх».«доводФункцииДо» (s : «Исх») («место» «имя» : String) : Bool := Id.run do
  let mut «внутри» := false
  for i in s.«номера» do
    let «сыр» := s.«сырая» i
    let l := «обрезать» «сыр»
    if «сыр».startsWith "функция «" || «сыр».startsWith "тотальная функция «" then «внутри» := true
    else if «внутри» && l.startsWith "принимает " then
      let «имена» := ((«словаС» («какЧитаетЯзык» l) 1).splitOn ",").map fun k => «голо» ((k.splitOn ":").headD "")
      if «имена».contains «имя» then return true
    if l = «место» then return false
  return false

def «скелет» (l : String) : String := Id.run do
  let cs := l.toList.toArray
  let mut r : Array Char := #[]
  let mut i := 0
  while i < cs.size do
    let c := cs[i]!
    let «закр» := if c = '«' then some '»' else if c = '⟨' then some '⟩' else none
    match «закр» with
    | some z =>
      match ((List.range' (i + 1) (cs.size - i - 1)).find? (fun j => cs[j]! = z)) with
      | some j => r := (r.push c).push z; i := j + 1
      | none => r := r.push c; i := i + 1
    | none => r := r.push c; i := i + 1
  return String.ofList r.toList

def «числоСлова?» (w : String) : Bool :=
  w ≠ "" && (w.toList.headD ' ').isDigit && w.toList.all (fun c => c.isDigit || c = '.' || c = 'e' || c = 'E' || c = '+' || c = '-')

def «поОбразцу» (l «образец» : String) : Bool :=
  let a := («скелет» l).splitOn " "
  let b := «образец».splitOn " "
  let rec go : List String → List String → Bool
    | [], [] => true
    | [], _ => false
    | "…" :: _, _ => true
    | _ :: _, [] => false
    | "#" :: bs, x :: xs => «числоСлова?» x && go bs xs
    | "." :: bs, x :: xs => x ≠ "" && go bs xs
    | w :: bs, x :: xs => w = x && go bs xs
  go b a

def «образцыПосылок» : List (String × List String) :=
  [("принцип ", ["принцип тип «» по «» носитель . база # шаг #"]),
   ("сведение ", ["сведение «»"]),
   ("объявление", ["объявление …"]),
   ("посылка ", ["посылка «» вид . вариант «» вердикт доказано закрыта . шагов # правило «»",
                 "посылка «» вид . вариант «» вердикт нет вердикта закрыта . шагов # правило «»",
                 "посылка «» вид . вариант «» вердикт доказано при условии закрыта . шагов # правило «»",
                 "посылка «» вид . вариант «» вердикт сетка закрыта . шагов # правило «»",
                 "посылка «» вид . вариант «» вердикт отвергнуто закрыта . шагов # правило «»"])]

def «судитьСтрокиПосылок» («свои» : List String) («о_чём» : String) : «Суд» := Id.run do
  let «обр» := («свои».map «обрезать»).toArray
  let mut r : «Суд» := {}
  for i in [0:«обр».size] do
    let l := «обр»[i]!
    for (n, os) in «образцыПосылок» do
      if l.startsWith n then
        r := r.«еслиНе» (os.any («поОбразцу» l)) s!"{«о_чём»}: строка «{l}» не узнана"
    if l.startsWith "объявление" then
      r := r.«еслиНе» (i > 0 && («обр»[i - 1]!).startsWith "принцип тип ") s!"{«о_чём»}: строка «{l}» стоит не сразу под строкой «принцип»"
  return r

def «судитьОбъявлениеПравила» («свои» : List String) («о_чём» : String) : «Суд» :=
  let «обр» := «свои».map «обрезать»
  let r : «Суд» := {}
  if !(«обр».any (·.startsWith "правило «") || «обр».any (·.startsWith "по объявлению ")) then r else
  let r := r.«еслиНе» (!«обр».any (·.startsWith "посылка ")) s!"{«о_чём»}: вердикт по объявлению стоит рядом с посылками"
  r.«еслиНе» (!«обр».any (·.startsWith "принцип тип ")) s!"{«о_чём»}: вердикт по объявлению стоит рядом с принципом"

def «судитьПравилаПосылок» («свои» : List String) («о_чём» : String) : «Суд» :=
  let «чужие» := ((«посылкиБлока» «свои»).map (·.«правило»)).filter (!«правилаЯдра».contains ·)
  ({} : «Суд»).«еслиНе» «чужие».isEmpty s!"{«о_чём»}: правило сведения сверщику неизвестно: {", ".intercalate «чужие»}"

def «судитьПоляПосылок» (s : «Исх») («свои» : List String) («имя_т» «чья» : String) : «Суд» := Id.run do
  let pr := «принципБлока» «свои»
  let «алг» := match pr with | some p => p.«носитель» == .«алгебра» | none => false
  let «типП» := if «алг» then (pr.map (fun (x : «Принцип») => x.«тип»)).getD "" else ""
  let mut r : «Суд» := {}
  for q in «посылкиБлока» «свои» do
    let «ждём» := match «видПоИмени» q.«имя» with
      | some k => some k
      | none => if «алг» then s.«видПоВарианту» «типП» q.«вариант» else none
    r := r.«еслиНе» (q.«вид» = "base" || q.«вид» = "step") s!"теорема «{«имя_т»}»: посылка «вид {q.«вид»}» — известны только «base» и «step»"
    r := r.«еслиНе» («ждём».all (· = q.«вид»)) s!"теорема «{«имя_т»}», посылка «{q.«имя»}»: объявлена «вид {q.«вид»}», а ждём «вид {«ждём».getD ""}»"
    match q.«закрыта» with
    | "reduction" =>
      r := r.«еслиНе» (q.«шагов» = 0) s!"теорема «{«имя_т»}», посылка «{q.«вариант»}»: закрыта сведением, а шагов объявлено {q.«шагов»}"
      r := r.«еслиНе» (!«алг» || q.«вариант» = "" || s.«естьВетвьВарианта» «чья» q.«вариант» ||
          («типП» = "список" && s.«свёрткаПоДоводу» «чья» ((pr.map (fun (x : «Принцип») => x.«по»)).getD "") q.«вариант»))
        s!"теорема «{«имя_т»}», посылка «{q.«вариант»}»: закрыта сведением, а случая на вариант «{q.«вариант»}» в функции «{«чья»}» нет"
    | "term" =>
      let «вСлучае» := «шаговСлучая» s «свои» q.«вариант»
      r := r.«еслиНе» (q.«шагов» ≥ 1 && «вСлучае».all (q.«шагов» ≤ ·)) s!"теорема «{«имя_т»}», посылка «{q.«вариант»}»: объявлено шагов {q.«шагов»}, а в случае того же варианта {«вСлучае».getD 0}"
    | w => r := r.«беда» s!"теорема «{«имя_т»}», посылка «{q.«вариант»}»: «закрыта {w}» — известны только «term» и «reduction»"
  return r

def «судитьСведение» («свои» : List String) («имя_т» : String) : «Суд» := Id.run do
  let «правила» := («посылкиБлока» «свои»).map (·.«правило»)
  let «сведения» := («свои».map «обрезать»).filter (·.startsWith "сведение «") |>.map (fun l => «ёлочка» l 1)
  let mut r : «Суд» := {}
  match «сведения» with
  | [] => pure ()
  | x :: «ещё» =>
    r := r.«еслиНе» («правила».contains x) s!"теорема «{«имя_т»}»: сведение названо «{x}», а ни одна посылка этим правилом не закрыта"
    for y in «ещё» do
      r := r.«еслиНе» («правила».contains y) s!"теорема «{«имя_т»}»: сведение названо «{y}», а ни одна посылка этим правилом не закрыта"
  return r

def «посылкиВДолгу» («свои» : List String) («ходыСчитаются» : Bool) : List «Посылка» := Id.run do
  let mut «долг» : List «Посылка» := []
  let mut «тек» : Option «Посылка» := none
  let mut «ходы» := false
  for z0 in «свои» do
    let z := «обрезать» z0
    if z.startsWith "посылка " then
      if let some p := «тек» then
        if (p.«правило» ≠ "" || p.«закрыта» = "reduction") && !«ходы» then «долг» := «долг» ++ [p]
      «тек» := some («прочестьПосылку» z)
      «ходы» := false
    else if «ходыСчитаются» && z.startsWith "ход " && z ≠ "ход конец" then «ходы» := true
  if let some p := «тек» then
    if (p.«правило» ≠ "" || p.«закрыта» = "reduction") && !«ходы» then «долг» := «долг» ++ [p]
  return «долг»

def «судитьПринцип» (s : «Исх») («свои» : List String) («имя_т» «место» : String) (p : «Принцип») : «Суд» := Id.run do
  let «обр» := «свои».map «обрезать»
  let mut r : «Суд» := {}
  let «объявлено» := s.«типДоводаУМеста» «место» p.«по»
  let «имяОб» := «имяТипа» «объявлено»
  let «об» := s.«объявлениеТипа» «имяОб»
  if «объявлено» ≠ "" && «об».«откуда» = "" && s.«ввозит?» then
    return r.«слово» s!"теорема «{«имя_т»}»: тип «{«имяОб»}» довода «{p.«по»}» объявлен не в этом файле — сверять объявление не с чем"
  let «сумма» := «об».«вид» == .«сумма» || «об».«вид» == .«встроеннаяСумма» || «об».«вид» == .«запись»
  let «ладно» := match p.«носитель» with
    | .«отрезок» | .«отрезокФормой» => «об».«вид» == .«отрезок»
    | .«алгебра» | .«свёртка» => «сумма»
    | .«чужой» _ => false
  if «объявлено» ≠ "" then
    r := r.«еслиНе» («об».«вид» != .«нет») s!"теорема «{«имя_т»}»: довод «{p.«по»}» объявлен типом «{«имяОб»}» — принципа индукции по нему нет"
    r := r.«еслиНе» («об».«вид» == .«нет» || «ладно») s!"теорема «{«имя_т»}»: носитель не следует из объявления «{«об».«вид».«слово»} «{«об».«основа»}»»"
    r := r.«еслиНе» (p.«тип» = «имяОб») s!"теорема «{«имя_т»}»: принцип назван над типом «{p.«тип»}», а довод «{p.«по»}» объявлен типом «{«имяОб»}»"
  let «обСтроки» := «обр».filter (·.startsWith "объявление")
  r := r.«еслиНе» (!«обСтроки».isEmpty) s!"теорема «{«имя_т»}»: под принципом нет строки «объявление»"
  if !«обСтроки».isEmpty then
    let «хв» := match p.«носитель» with
      | .«алгебра» => s!" варианты {«об».«арности»}"
      | .«отрезок» | .«отрезокФормой» => s!" дно 0 потолок {«Кпредст»}"
      | _ => ""
    let «ждём» := s!"объявление {«об».«откуда»}{«хв»}"
    r := r.«еслиНе» («обСтроки».length = 1) s!"теорема «{«имя_т»}»: строк «объявление» {«обСтроки».length}, а принцип один"
    r := r.«еслиНе» («об».«откуда» ≠ "") s!"теорема «{«имя_т»}»: у довода «{p.«по»}» объявления типа в исходнике нет"
    r := r.«еслиНе» («об».«откуда» = "" || «обСтроки».headD "" = «ждём») s!"теорема «{«имя_т»}»: строка «{«обСтроки».headD ""}», а исходник даёт «{«ждём»}»"
  return r

def «судитьПокрытие» (s : «Исх») («свои» : List String) («имя_т» «вердикт» «место» : String)
    («проигран» «ходыСчитаются» : Bool) : «Суд» := Id.run do
  let «обр» := «свои».map «обрезать»
  let «посылки» := «посылкиБлока» «свои»
  let mut r : «Суд» := {}
  if !«проигран» then
    for p in «посылкиВДолгу» «свои» «ходыСчитаются» do
      r := r.«слово» s!"утверждение «{«имя_т»}»: посылка «{p.«имя»}» сведена правилом «{p.«правило»}» и ни одного хода не записано — место на слове ядра"
  let «слабых» := («посылки».filter (·.«вердикт» ≠ "доказано")).length
  r := r.«еслиНе» («вердикт» ≠ "доказано" || «слабых» = 0) s!"теорема «{«имя_т»}»: вердикт «доказано», а посылок не доказано {«слабых»}"
  let some p := «принципБлока» «свои» | return r
  match p.«носитель» with
  | .«чужой» w => r := r.«беда» s!"теорема «{«имя_т»}»: носитель принципа «{w}» — известны только «algebra», «segment», «segment-form» и «fold»"
  | _ => pure ()
  let «свободное» := s.«высказывание» «место» ≠ 0
  let «формой» := p.«носитель» == .«отрезокФормой»
  if «формой» || p.«носитель» == .«отрезок» then
    r := r.«еслиНе» («формой» == «свободное») s!"теорема «{«имя_т»}»: носитель «{if «формой» then "segment-form" else "segment"}» у {if «свободное» then "свободного утверждения" else "постусловия"} — спуск с тела берёт постусловие, спуск формой — свободное утверждение"
  if «формой» then
    let «дно» := («посылки».filter (fun q => q.«имя» = "дно" && q.«вид» = "base")).length
    let «спуск» := («посылки».filter (fun q => q.«имя» = "спуск" && q.«вид» = "step")).length
    r := r.«еслиНе» («посылки».length = 2 && «дно» = 1 && «спуск» = 1) s!"теорема «{«имя_т»}»: спуск формой: посылки «дно» base и «спуск» step, а в записи {«посылки».length} (дно {«дно»}, спуск {«спуск»})"
  let «пс» := «судитьПринцип» s «свои» «имя_т» «место» p
  r := r.«и» «пс»
  if !«пс».«наСлово».isEmpty then return r
  let «инд» := «обр».find? (·.startsWith "индукция по «")
  r := r.«еслиНе» («инд».all (fun l => «ёлочка» l 1 = p.«по»)) s!"теорема «{«имя_т»}»: принцип ведёт индукцию по «{p.«по»}», а запись говорит иначе"
  let w := s.«высказывание» «место»
  let «имена» := if w ≠ 0 then s.«именаВысказывания» w else «именаКвантора» «место»
  if !«имена».isEmpty then
    r := r.«еслиНе» («имена».contains p.«по») s!"теорема «{«имя_т»}»: принцип ведёт индукцию по «{p.«по»}», а постусловие — по «{"», «".intercalate «имена»}»"
  else
    r := r.«еслиНе» (s.«доводФункцииДо» «место» p.«по») s!"теорема «{«имя_т»}»: принцип ведёт индукцию по «{p.«по»}», а такого довода у функции нет"
  for q in «посылки» do
    let «ладно» := match p.«носитель» with
      | .«алгебра» => q.«имя» = q.«вариант»
      | .«отрезок» | .«отрезокФормой» => q.«имя» = "дно" || q.«имя» = "спуск"
      | _ => q.«имя» = "начало свёртки" || q.«имя» = "шаг свёртки"
    r := r.«еслиНе» «ладно» s!"теорема «{«имя_т»}»: посылка «{q.«имя»}» названа не своим именем"
  if p.«носитель» != .«алгебра» then return r
  let «вар» := s.«вариантыТипаПринципа» p.«тип»
  let «непокр» := «вар».filter (fun v => !«посылки».any (·.«вариант» = v))
  r := r.«еслиНе» («вар».length = «посылки».length) s!"теорема «{«имя_т»}»: у типа «{p.«тип»}» вариантов {«вар».length}, а посылок {«посылки».length}"
  r := r.«еслиНе» «непокр».isEmpty s!"теорема «{«имя_т»}»: посылки не покрывают варианты {", ".intercalate «непокр»}"
  return r

def «судитьПосылки» (s : «Исх») («свои» : List String) («имя_т» «чья» «вердикт» «место» : String)
    («о_чём» : String) («проигран» «ходыСчитаются» : Bool) : «Суд» :=
  («судитьПравилаПосылок» «свои» «о_чём»).«и» («судитьПоляПосылок» s «свои» «имя_т» «чья»)
    |>.«и» («судитьСведение» «свои» «имя_т»)
    |>.«и» («судитьПокрытие» s «свои» «имя_т» «вердикт» «место» «проигран» «ходыСчитаются»)

def «ходыПодПосылками» (s : «Исх») («свои» : List String) («цель» «чья» «обяз» «место» : String)
    («доказанные» «объявленные» : List String) : «Прогон» :=
  let pr := «принципБлока» «свои»
  let o : «Обст» := { «исх» := s }
  let o := { o with «свои» := «свои».map «обрезать», «цель» := «т» «цель», «функция» := «чья» }
  let o := { o with «по» := (pr.map (fun (x : «Принцип») => x.«по»)).getD "", «тип» := (pr.map (fun (x : «Принцип») => x.«тип»)).getD "", «хвост» := (s.«доводы» «чья»).«хвост» }
  let o := { o with «обяз» := «обяз», «доказанные» := «доказанные», «объявленные» := «объявленные», «ограничения» := s.«ограничения» «место» }
  «проигратьБлок» o

def «словаШага» (l : String) : String :=
  match l.splitOn "⟨" with
  | x :: y :: z =>
    match ("⟨".intercalate (y :: z)).splitOn "⟩" with
    | _ :: a :: b => «сжать» (x ++ " " ++ "⟩".intercalate (a :: b))
    | _ => l
  | _ => l

def «рёбраБлока» («свои» : List String) : List (String × String) :=
  let «обр» := «свои».map «обрезать»
  let «имя» := «ёлочка» («свои».headD "") 1
  let «шаги» := («обр».filter (·.startsWith "шаг ")).filterMap fun l =>
    let w := «словаШага» l
    let «об» := «словаС» w (if «номерПосле» l "строка " ≥ 1 then 5 else 3)
    if «об».startsWith "по свойству " then some («имя», «ёлочка» w 1) else none
  let «ходы» := («обр».filter (·.startsWith "ход ")).filterMap fun l =>
    if (l.splitOn "факт по свойству «").length > 1 || (l.splitOn "переписать по свойству «").length > 1 then some («имя», «ёлочка» l 1) else none
  «шаги» ++ «ходы»

def «кругиЗаписи» («блоки» : List (List String)) : «Суд» := Id.run do
  let mut e := «блоки».flatMap «рёбраБлока»
  let mut «росла» := true
  let mut fuel := e.length * e.length + 2
  while «росла» && fuel > 0 do
    fuel := fuel - 1
    «росла» := false
    for (a, b) in e do
      for (c, d) in e do
        if b = c && !e.contains (a, d) then
          e := e ++ [(a, d)]
          «росла» := true
  let k := (e.filter (fun (a, b) => a = b)).map (·.1)
  return ({} : «Суд»).«еслиНе» k.isEmpty s!"утверждения обосновывают сами себя по кругу: {", ".intercalate k}"

end «Второй»
