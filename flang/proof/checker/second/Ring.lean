import Body

open «Разбор»

namespace «Второй»

/-!
Правило «кольцо точного целого» (ADR-0095), переигранное по описанию формата
(`docs/flang/proof/record-format.md`, §3.11), а не по коду сверщика на C.

Цель режется по `равен` верхнего уровня; каждая сторона раскрывается в многочлен:
сумма — склейка одночленов слагаемых, произведение — попарные произведения
одночленов множителей, лист — одночлен из одного листа. Канон: одночлен с нулём
вычёркивается, единица вычёркивается из одночлена. Лист — имя, объявленное
`точное целое`, либо вызов нульместной функции типа `точное целое`, чьё тело —
одна строка `[]` (ноль) или `[1]` (единица). Иначе — беда: запись назвала
правило, которого на этом носителе нет.
-/

/-- Лист после канона: имя, ноль или единица. -/
inductive «ЛистКольца» where
  | «имя» (x : String)
  | «ноль»
  | «единица»

/-- Снять все внешние пары скобок, обнимающие терм целиком. -/
def «безОбёрток» (t : String) : String := Id.run do
  let mut u := «т» t
  for _ in [0:u.length] do
    let v := «снятьПару» u
    if v = u then break
    u := «т» v
  return u

/-- Тип имени `x`: строка записи `для всех «x» ⟨Т⟩` либо `принимает` функции `чья`. -/
def «типЛистаКольца» (s : «Исх») («свои» : List String) («чья» x : String) : Option String :=
  let «кв» := «свои».find? (fun l => l.startsWith s!"для всех «{x}» ⟨")
  match «кв» with
  | some l => some («обрезать» («уголок» l 1))
  | none =>
    if «чья» = "" then none else
    ((s.«подпись» «чья»).find? (fun p => «голо» p.1 = x)).map (fun p => «обрезать» p.2)

/-- Нульместная функция `f` типа `точное целое` с телом из одной строки `[]` или `[1]`. -/
def «литералКанона» (s : «Исх») (f : String) : Option «ЛистКольца» :=
  let «стр» := (s.«внутри» f).map (fun i => s.«строка» i) |>.filter (· ≠ "")
  if «стр».any (·.startsWith "принимает ") then none else
  if !«стр».contains "возвращает точное целое" then none else
  match «стр».filter (fun l => !(«словаКонтракта».any (l.startsWith ·))) with
  | ["[]"] => some .«ноль»
  | ["[1]"] => some .«единица»
  | _ => none

/-- Многочлен: список одночленов, одночлен — отсортированный список имён. -/
abbrev «Многочлен» := List (List String)

def «сортСтрок» (v : List String) : List String := v.mergeSort (fun a b => decide (a ≤ b))

def «печатьМногочлена» (p : «Многочлен») : String :=
  " + ".intercalate («сортСтрок» (p.map (fun m => " ".intercalate m)))

/-- ADR-0121: лист `«Ф» от д1 и … и дN` — вызов функции этого исходника с плоским
    телом и ровно N входами — раскрывается подстановкой доводов вместо входов разом
    (через заглушки) и снова идёт в многочлен: развёртка тела — равенство по
    определению, а не новое правило. -/
def «развернутьЛистКольца» (s : «Исх») (t : String) : Option String :=
  let f := «ёлочка» t 1
  if f = "" || !t.startsWith s!"«{f}» от " then none else
  match s.«блокС» f with
  | none => none
  | some (a, b) =>
    let body := s.«телоРазбора» a b
    let ps := s.«именаДоводовФункции» f
    let args := «сверху» ((t.drop s!"«{f}» от ".length).toString) "и"
    if body = "" || ps.isEmpty || ps.length ≠ args.length then none else
    let marked := ((List.range ps.length).zip ps).foldl (fun acc (i, p) => «вместо» acc p s!"ЗАГЛУШКАДОВОДА{i}") body
    some (((List.range args.length).zip args).foldl (fun acc (i, x) => «вместо» acc s!"ЗАГЛУШКАДОВОДА{i}" («т» («обрезать» x))) marked)

partial def «многочленКольца» (s : «Исх») («свои» : List String) («чья» : String) (t0 : String) («гл» : Nat := 0) : Except String «Многочлен» := do
  let t := «безОбёрток» t0
  if t.startsWith "«" && (t.splitOn "» от ").length > 1 && «гл» < 64 then
    if let some r := «развернутьЛистКольца» s t then
      return (← «многочленКольца» s «свои» «чья» r («гл» + 1))
  let «сл» := «сверху» t "плюс"
  let «мн» := «сверху» t "умножить на"
  if «сл».length > 1 && «мн».length > 1 then
    throw s!"в ⟨{t}⟩ «плюс» и «умножить на» стоят рядом без скобок"
  if «сл».length > 1 then
    let mut acc : «Многочлен» := []
    for x in «сл» do acc := acc ++ (← «многочленКольца» s «свои» «чья» x «гл»)
    return acc
  if «мн».length > 1 then
    let mut acc : «Многочлен» := [[]]
    for x in «мн» do
      let p ← «многочленКольца» s «свои» «чья» x «гл»
      acc := acc.flatMap (fun a => p.map (fun b => «сортСтрок» (a ++ b)))
    return acc
  -- Литерал канона прямо в цели (закон моноида с `единица []`, ADR-0121): `[]` —
  -- ноль, `[1]` — единица, как у сверщика на C.
  if t = "[]" || t = "[ ]" then return []
  if t = "[1]" || t = "[ 1 ]" then return [[]]
  if t.startsWith "«" && t.endsWith "»" && (t.splitOn "«").length = 2 && (t.splitOn "»").length = 2 then
    match «литералКанона» s («голо» t) with
    | some .«ноль» => return []
    | some .«единица» => return [[]]
    | _ => throw s!"лист ⟨{t}⟩ — не нульместная функция «точное целое» с телом [] или [1]"
  if (t.splitOn " ").length > 1 || t = "" then
    throw s!"лист ⟨{t}⟩ — не имя и не литерал канона"
  match «типЛистаКольца» s «свои» «чья» t with
  | none => throw s!"лист «{t}» ничем не объявлен"
  | some "точное целое" => return [[t]]
  | some w => throw s!"лист «{t}» объявлен «{w}», а законы кольца ядро выводит только над «точное целое»"

/-- Переиграть место: `ok ()` — многочлены сошлись, `error` — беда. -/
def «кольцоТочногоЦелого» (s : «Исх») («свои» : List String) («чья» «цель» : String) : Except String Unit := do
  let r := «разрезСловом» («т» «цель») " равен "
  if !r.«есть» then throw s!"цель ⟨{«т» «цель»}⟩ не равенство двух сторон"
  let «л» ← «многочленКольца» s «свои» «чья» r.«лево»
  let «п» ← «многочленКольца» s «свои» «чья» r.«право»
  let («пл», «пп») := («печатьМногочлена» «л», «печатьМногочлена» «п»)
  if «пл» ≠ «пп» then
    throw s!"многочлены сторон разные: слева ⟨{«пл»}⟩, справа ⟨{«пп»}⟩"

end «Второй»
