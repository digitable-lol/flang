def «строкаБлокаПонятна» (l : String) : Bool :=
  l = "" || l = "вид postcondition" || l = "вердикт доказано" || l = "вердикт нет вердикта" ||
  l = "теоремы нет" || l = "конец утверждения" || l = "конец записи" || l.startsWith "вывод " ||
  l.startsWith "правило «" || l = "по объявлению да" || l = "по объявлению нет"

def «первыйОтказ» (u : «Утверждение») : List «Шаг» → List «Принятый» → Option «Шаг»
  | [], _ => none
  | «ш» :: «хв», «преж» =>
    if «ш».«номер» = «преж».length + 1 then
      match «шаг?» u «преж» «ш» with
      | some p => «первыйОтказ» u «хв» («преж» ++ [p])
      | none => some «ш»
    else some «ш»

def «блокВывода» (r : «Итог») («имя» : String) (h : String) (b : List String) («исходник» : List String)
    («опр» : List «Определение») : «Итог» :=
  match «утверждение» h b «исходник» «опр» with
  | .error e => «непонятно» r s!"утверждение «{«имя»}»: блок вывода не прочтён ({e})"
  | .ok u =>
    if «принят?» u then r
    else match u.«вывод» with
      | none => «непонятно» r s!"утверждение «{«имя»}»: блок вывода не прочтён"
      | some v =>
        match «первыйОтказ» u v.«шаги» [] with
        | some «ш» =>
          if «внеМодели» u «ш» then «непонятно» r s!"утверждение «{«имя»}», вывод: шаг {«ш».«номер»} {«ш».«правило»} вне модели"
          else «беда» r s!"утверждение «{«имя»}», вывод: шаг {«ш».«номер»} {«ш».«правило»} не принят"
        | none => «беда» r s!"утверждение «{«имя»}», вывод: итог блока не цель утверждения либо гипотеза не снята"

def «блок» (r0 : «Итог») («блок» : String) («строки» : List String) («опр» : List «Определение») : «Итог» :=
  let «свои» := «блок».splitOn "\n"
  let «заг» := «часть» «свои» 1
  let «имя» := «ёлочка» «заг» 1
  let «чья» := «ёлочка» «заг» 2
  let «где» := «номерСтроки» «заг»
  let «обр» := «свои».map String.«обр»
  let «вердикт» := ((«обр».find? (·.startsWith "вердикт ")).getD "").«сн» 8
  let r := { r0 with «утверждений» := r0.«утверждений» + 1,
                     «доказанных» := r0.«доказанных» + (if «вердикт» = "доказано" then 1 else 0) }
  let «сколько» := fun (p : String → Bool) => («обр».filter p).length
  let r := «еслиНе» r («сколько» (·.startsWith "вид ") = 1 && «сколько» (·.startsWith "вердикт ") = 1 &&
      «сколько» (fun l => l.startsWith "теорема «" || l = "теоремы нет") = 1 && «сколько» (· = "конец утверждения") = 1)
    s!"утверждение «{«имя»}» записано не целиком"
  let «пр» := «обр».find? (·.startsWith "правило «")
  let «по» := «обр».find? (·.startsWith "по объявлению ")
  let r := «еслиНе» r («пр».isSome == «по».isSome)
    s!"утверждение «{«имя»}»: «правило» и «по объявлению» печатаются парой, а здесь одна без другой"
  let r := match «пр» with
    | some l => «еслиНе» r («правилаЯдра».contains («ёлочка» l 1))
        s!"утверждение «{«имя»}»: правило «{«ёлочка» l 1}» ядру неизвестно"
    | none => r
  let «чужие» := («обр».drop 1).filter (fun l => !(«строкаБлокаПонятна» l))
  let r := «чужие».foldl (fun r l => «непонятно» r s!"утверждение «{«имя»}»: строка «{l}»") r
  if !(((«заг».splitOn " функции «").length) > 1) then
    «непонятно» r s!"утверждение «{«имя»}» без функции"
  else
    let «место» := «какЧитаетЯзык» («часть» «строки» «где»)
    let r := «еслиНе» r ((«обр».find? (·.startsWith "вид ")) = some "вид postcondition")
      s!"утверждение «{«имя»}» функции «{«чья»}» записано не как «вид postcondition»"
    let r := «еслиНе» r ((«место».splitOn s!"обеспечивает «{«имя»}»").length > 1)
      s!"строка {«где»} исходника не несёт «обеспечивает «{«имя»}»»"
    let r := «еслиНе» r («хозяин» «строки» «где» = «чья»)
      s!"утверждение «{«имя»}» записано за функцией «{«чья»}», а строка {«где»} исходника стоит в функции «{«хозяин» «строки» «где»}»"
    let «спрятана» := «строки».any (fun l =>
      let t := («безПримечания» l).«обр»
      t = s!"теорема «{«имя»}»" || t = s!"следует «{«имя»}»")
    let r := «еслиНе» r (!(«обр».any (· = "теоремы нет")) || !«спрятана»)
      s!"в записи сказано «теоремы нет», а в исходнике теорема «{«имя»}» написана"
    let r := if ["для всех ", "таких что", "есть такой"].any (fun w => («место».splitOn w).length > 1)
      then «непонятно» r s!"утверждение «{«имя»}»: постусловие с квантором, ограничением или свидетелем"
      else r
    let «выводы» := «обр».filter (·.startsWith "вывод ")
    if «вердикт» = "доказано" then
      if «выводы».isEmpty then «непонятно» r s!"утверждение «{«имя»}»: «доказано» без блока вывода"
      else «блокВывода» r «имя» ("утверждение " ++ «заг») ((«обр».drop 1).filter (· ≠ "")) «строки» «опр»
    else r

def «сверить» («исх» : String) («путь» : String) («зап» : String) («каталог» : String) : «Итог» := Id.run do
  let «строки» := «исх».splitOn "\n"
  let «п» := «зап».splitOn "\nплан "
  let «т» := («часть» «п» 1).splitOn "\nтотальность "
  let «с» := («часть» «т» 1).splitOn "\nснятие "
  let «голова» := «часть» «с» 1
  let «части» := «голова».splitOn "\nутверждение "
  let «шапка» := («часть» «части» 1).splitOn "\n"
  let «блоки» := «части».filter (fun x => !(x.startsWith "запись доказательства"))
  let mut r : «Итог» := {}
  if «п».length > 1 then r := «непонятно» r "секция плана"
  if «т».length > 1 then r := «непонятно» r "секция тотальности"
  if «с».length > 1 then r := «непонятно» r "секция снятий"
  for l in «шапка» do
    if !(«шапкаПонятна» l.«обр») then r := «непонятно» r s!"строка шапки «{l.«обр»}»"
  let «ш256» := «sha256» «исх».toUTF8
  r := «еслиНе» r («часть» «шапка» 1 = "запись доказательства 1")
    "шапка не та: первой строкой обязано стоять «запись доказательства 1»"
  r := «еслиНе» r («номерПосле» («часть» «шапка» 3) "строк " = some «строки».length)
    s!"в записи строк не {«строки».length} — запись не от этой программы"
  r := «еслиНе» r («номерПосле» («часть» «шапка» 4) "знаков " = some «исх».length)
    s!"в записи знаков не {«исх».length} — запись не от этой программы"
  let «отп» := (((«часть» «шапка» 5).splitOn " ").drop 1).map String.toNat?
  r := «еслиНе» r («отп».head? = some (some («отпечаток» «исх» 131 1000000007)))
    "первый отпечаток не сошёлся — запись не от этой программы"
  r := «еслиНе» r («отп»[1]? = some (some («отпечаток» «исх» 137 998244353)))
    "второй отпечаток не сошёлся — запись не от этой программы"
  match «шапка».find? (·.startsWith "отпечаток256 ") with
  | some l =>
    if ((l.splitOn " ").getD 1 "") = «ш256» then r := { r with «крипто» := true }
    else r := «беда» r s!"отпечаток256 записи не сошёлся с исходником «{«ш256»}»"
  | none => pure ()
  let «заявлен» := («часть» «шапка» 2).«сн» 9
  let «полный» := if «путь».startsWith "/" then «путь» else «каталог» ++ "/" ++ «путь»
  if !(«путьСовпал» «заявлен» «полный») then
    if r.«крипто» then r := { r with «приметы» := r.«приметы» ++ ["поле «исходник» — примета"] }
    else r := «беда» r s!"запись зовёт своим исходником «{«заявлен»}», а сверяется с «{«путь»}»"
  r := «еслиНе» r («номерПосле» («часть» «шапка» 7) "утверждений " = some «блоки».length)
    "шапка обещает не столько утверждений, сколько в записи"
  r := «еслиНе» r (((«зап».splitOn "\n").map String.«обр»).any (· = "конец записи"))
    "запись не кончается словами «конец записи» — она обрублена"
  let «имена» := «блоки».map (fun b => «ёлочка» («часть» (b.splitOn "\n") 1) 1)
  let mut «замолчано» : List String := []
  let mut «постусловий» := 0
  let mut «высказываний» := 0
  for l in «строки» do
    let t := «какЧитаетЯзык» l
    if (l.startsWith "теорема" && t.startsWith "теорема «") || l.startsWith "следует «" then
      let n := «ёлочка» t 1
      if !(«имена».contains n) then «замолчано» := «замолчано» ++ [n]
    if (t.splitOn "обеспечивает «").length > 1 then «постусловий» := «постусловий» + 1
    if l.startsWith "утверждение «" then «высказываний» := «высказываний» + 1
  r := «еслиНе» r «замолчано».isEmpty
    s!"в исходнике есть теоремы, о которых запись молчит: {", ".intercalate «замолчано»}"
  r := «еслиНе» r («постусловий» + «высказываний» = «блоки».length)
    s!"в исходнике постусловий {«постусловий»}, а в записи утверждений {«блоки».length} — запись говорит не обо всей программе"
  let «опр» := «определения» «строки» («строкиРазв3» «зап»)
  for b in «блоки» do
    r := «блок» r b «строки» «опр»
  return r

def «исход» (r : «Итог») : String × UInt32 :=
  if !r.«беды».isEmpty then (s!"НЕ СОШЛОСЬ: {"; ".intercalate r.«беды»}", 1)
  else if !r.«непонято».isEmpty then
    let n := r.«непонято».length
    let «три» := "; ".intercalate (r.«непонято».take 3)
    (s!"НЕ ВЗЯЛСЯ ЦЕЛИКОМ — мест вне чтения {n}: {«три»}{if n > 3 then "; …" else ""}", 4)
  else if !r.«крипто» then ("НЕ ПРОВЕРЕНО — привязка к программе не криптографическая: строки «отпечаток256» в записи нет", 3)
  else if r.«доказанных» = 0 then ("НЕ ПРОВЕРЕНО — ВПУСТУЮ: доказанным в записи не числится ничего", 3)
  else (s!"ПРОВЕРЕНО — утверждений {r.«утверждений»}, доказанных {r.«доказанных»}, блоки вывода приняты", 0)

end «Второй»

def main (args : List String) : IO UInt32 := do
  match args with
  | [«исх», «зап»] =>
    let «б» ← IO.FS.readBinFile «исх»
    let «тз» ← IO.FS.readFile «зап»
    match String.fromUTF8? «б» with
    | none =>
      IO.println "НЕ ВЗЯЛСЯ ЦЕЛИКОМ: исходник не в UTF-8"
      pure 4
    | some «т» =>
      let «кат» ← IO.currentDir
      let (s, k) := «Второй».«исход» («Второй».«сверить» «т» «исх» «тз» «кат».toString)
      IO.println s
      pure k
  | _ =>
    IO.eprintln "звать: второй-сверщик <исходник.flang> <запись>"
    pure 2
