def «H0» : Array UInt32 :=
  #[0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]

def «вращ» (x n : UInt32) : UInt32 := (x >>> n) ||| (x <<< (32 - n))

def «дополнить» (m : ByteArray) : ByteArray :=
  let l := m.size
  let k := if l % 64 ≤ 55 then 55 - l % 64 else 119 - l % 64
  let bits := l * 8
  let «хв» := (List.range 8).reverse.map (fun i => UInt8.ofNat ((bits >>> (8 * i)) % 256))
  (m.push 0x80) ++ ⟨(List.replicate k (0 : UInt8)).toArray⟩ ++ ⟨«хв».toArray⟩

def «слово» (b : ByteArray) (i : Nat) : UInt32 :=
  ((b.get! i).toUInt32 <<< 24) ||| ((b.get! (i + 1)).toUInt32 <<< 16) |||
  ((b.get! (i + 2)).toUInt32 <<< 8) ||| (b.get! (i + 3)).toUInt32

def «сжать» (h : Array UInt32) (b : ByteArray) (o : Nat) : Array UInt32 := Id.run do
  let mut w : Array UInt32 := #[]
  for i in [0:16] do
    w := w.push («слово» b (o + 4 * i))
  for i in [16:64] do
    let x := w[i - 15]!
    let y := w[i - 2]!
    let s0 := «вращ» x 7 ^^^ «вращ» x 18 ^^^ (x >>> 3)
    let s1 := «вращ» y 17 ^^^ «вращ» y 19 ^^^ (y >>> 10)
    w := w.push (w[i - 16]! + s0 + w[i - 7]! + s1)
  let mut a := h[0]!
  let mut bb := h[1]!
  let mut c := h[2]!
  let mut d := h[3]!
  let mut e := h[4]!
  let mut f := h[5]!
  let mut g := h[6]!
  let mut hh := h[7]!
  for i in [0:64] do
    let s1 := «вращ» e 6 ^^^ «вращ» e 11 ^^^ «вращ» e 25
    let ch := (e &&& f) ^^^ ((~~~ e) &&& g)
    let t1 := hh + s1 + ch + «K»[i]! + w[i]!
    let s0 := «вращ» a 2 ^^^ «вращ» a 13 ^^^ «вращ» a 22
    let maj := (a &&& bb) ^^^ (a &&& c) ^^^ (bb &&& c)
    let t2 := s0 + maj
    hh := g
    g := f
    f := e
    e := d + t1
    d := c
    c := bb
    bb := a
    a := t1 + t2
  return #[h[0]! + a, h[1]! + bb, h[2]! + c, h[3]! + d, h[4]! + e, h[5]! + f, h[6]! + g, h[7]! + hh]

def «шестн» (x : UInt32) : String :=
  let s := String.ofList (Nat.toDigits 16 x.toNat)
  String.ofList (List.replicate (8 - s.length) '0') ++ s

def «sha256» (m : ByteArray) : String :=
  let p := «дополнить» m
  let h := (List.range (p.size / 64)).foldl (fun h i => «сжать» h p (64 * i)) «H0»
  String.join (h.toList.map «шестн»)

def «отпечаток» (s : String) («множ» «модуль» : Nat) : Nat :=
  s.foldl (fun h c => (h * «множ» + c.toNat) % «модуль») 7


def «часть» (xs : List String) (n : Nat) : String := xs.getD (n - 1) ""

def «номерПосле» (s : String) («метка» : String) : Option Nat :=
  if s.startsWith «метка» then ((s.«сн» «метка».length).«обр».splitOn " ").head?.bind String.toNat?
  else none

def «ёлочка» (s : String) (n : Nat) : String :=
  match (s.splitOn "«")[n]? with
  | some «хв» => («хв».splitOn "»").headD ""
  | none => ""

def «номерСтроки» (s : String) : Nat :=
  match (s.splitOn "строка ").getLast? with
  | some «хв» => ((«хв».«обр».splitOn " ").headD "").toNat?.getD 0
  | none => 0

def «имяФункцииСтроки» (s : String) : String := «имяФункции» s

def «хозяин» («строки» : List String) (n : Nat) : String :=
  ((«строки».take n).map «имяФункцииСтроки»).foldl (fun acc x => if x = "" then acc else x) ""

def «частиПути» (p : String) : List String := (p.splitOn "/").filter (fun x => x ≠ "" && x ≠ ".")

def «путьСовпал» (a b : String) : Bool :=
  let pa := «частиПути» a
  let pb := «частиПути» b
  let fa := a.startsWith "/"
  let fb := b.startsWith "/"
  if fa == fb then pa == pb
  else
    let (k, d) := if fa then (pb, pa) else (pa, pb)
    k.length ≤ d.length && d.drop (d.length - k.length) == k

structure «Итог» where
  «беды» : List String := []
  «непонято» : List String := []
  «утверждений» : Nat := 0
  «доказанных» : Nat := 0
  «крипто» : Bool := false
  «приметы» : List String := []

def «беда» (r : «Итог») (s : String) : «Итог» := { r with «беды» := r.«беды» ++ [s] }
def «непонятно» (r : «Итог») (s : String) : «Итог» := { r with «непонято» := r.«непонято» ++ [s] }
def «еслиНе» (r : «Итог») (c : Bool) (s : String) : «Итог» := if c then r else «беда» r s

def «шапкаПонятна» (l : String) : Bool :=
  l = "" || l = "запись доказательства 1" || l = "ядро 2" || l.startsWith "исходник " ||
  l.startsWith "строк " || l.startsWith "знаков " || l.startsWith "отпечаток " ||
  l.startsWith "отпечаток256 " || l.startsWith "утверждений " || l = "тотальностей 0"

def «правилаЯдра» : List String :=
  ["", "неотрицательность по построению", "ограниченность точным потолком по построению",
