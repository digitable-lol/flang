import «Состоятельность»
import Totality
import Moves

open «Разбор»

namespace «Второй»

def «Исх».«хозяева» (s : «Исх») : Array String :=
  (s.«номера».foldl (fun (acc : Array String × String) i =>
    let x := «имяФункции» (s.«сырая» i)
    let h := if x = "" then acc.2 else x
    (acc.1.push h, h)) (#[], "")).1

def «хозяинИз» (h : Array String) (n : Nat) : String := if n = 0 then "" else h.getD (n - 1) ""

def «сколькоРаз» (xs : List String) (x : String) : Nat := (xs.filter (· = x)).length

structure «Таблица» where
  «имя» : String
  «открыта» : Nat
  «закрыта» : Nat

structure «Обход» where
  «имя» : String := ""
  «доводы» : Bool := false
  «открыта» : Nat := 0
  «закрыта» : Nat := 0
  «найдено» : List «Таблица» := []

def «Обход».«закрыть» (o : «Обход») : List «Таблица» :=
  if !o.«доводы» && o.«имя» ≠ "" && o.«открыта» > 0 && o.«закрыта» > o.«открыта» + 1 then
    o.«найдено» ++ [⟨o.«имя», o.«открыта», o.«закрыта»⟩]
  else o.«найдено»

def «таблицыИсходника» (s : «Исх») : List «Таблица» :=
  let o := s.«номера».foldl (fun (o : «Обход») i =>
    let raw := s.«сырая» i
    let l := «обрезать» raw
    if raw.startsWith "функция «" || raw.startsWith "тотальная функция «" then
      { «имя» := «ёлочка» raw 1, «найдено» := o.«закрыть» }
    else if l.startsWith "принимает " then { o with «доводы» := true }
    else if l = "[" then { o with «открыта» := i, «закрыта» := 0 }
    else if l = "]" then { o with «закрыта» := i }
    else o) {}
  o.«закрыть»

def «строкаТаблицы» (t : «Таблица») : String :=
  s!"таблица «{t.«имя»}» открыта {t.«открыта»} закрыта {t.«закрыта»} звеньев {t.«закрыта» - t.«открыта» - 1}"

/-- Беды оглавления таблиц, когда оглавление в шапке есть. Последний кусок — каждая
    таблица исходника записана своей строкой печати: это же следует из кусков выше,
    если имена таблиц в исходнике разные, и сказано отдельно, чтобы теорема
    «оглавление-по-исходнику» не зависела от этого. -/
def «бедыОглавления» («счёт» «стр» : List String) («печать» : List «Таблица») : List String :=
  «если» («счёт».length = 1) s!"строк «таблиц N» в шапке {«счёт».length}, а не одна" ++
  «счёт».flatMap (fun l => «если» («целое?» (l.«сн» 7) = some «стр».length)
    s!"оглавление обещает «{l}», а строк таблиц в нём {«стр».length}") ++
  «стр».flatMap (fun l =>
    let n := «ёлочка» l 1
    (match «печать».find? (·.«имя» = n) with
     | some t => «если» (l = «строкаТаблицы» t) s!"оглавление: «{l}», а по исходнику «{«строкаТаблицы» t}»"
     | none => [s!"оглавление зовёт таблицей «{n}», а списочного тела без доводов с таким именем в исходнике нет"]) ++
    «если» ((«стр».filter (fun x => «ёлочка» x 1 = n)).length = 1) s!"оглавление называет «{n}» не один раз") ++
  «печать».flatMap (fun t => «если» («стр».any (fun l => «ёлочка» l 1 = t.«имя»))
    s!"оглавление молчит о таблице «{t.«имя»}»") ++
  «печать».flatMap (fun t => «если» («стр».contains («строкаТаблицы» t))
    s!"оглавление не записало таблицу исходника строкой «{«строкаТаблицы» t}»")

def «судитьОглавление» (s : «Исх») («шапка» : List String) : «Суд» :=
  let «обр» := «шапка».map «обрезать»
  let «счёт» := «обр».filter (·.startsWith "таблиц ")
  let «стр» := «обр».filter (·.startsWith "таблица «")
  let «печать» := «таблицыИсходника» s
  if «счёт».isEmpty && «стр».isEmpty then
    { «наСлово» := «печать».map (fun t => s!"оглавления таблиц в записи нет, а печать назвала бы «{«строкаТаблицы» t}»") }
  else { «беды» := «бедыОглавления» «счёт» «стр» «печать» }

def «числоСтроки?» (s : String) : Bool := s ≠ "" && s.all Char.isDigit

def «формаШапки?» (l : String) : Bool :=
  let w := l.splitOn " "
  match w with
  | ["строк", n] | ["знаков", n] | ["утверждений", n] | ["тотальностей", n] | ["таблиц", n] => «числоСтроки?» n
  | ["отпечаток", a, b] => «числоСтроки?» a && «числоСтроки?» b
  | ["отпечаток256", h] => h ≠ ""
  | _ => !(["строк ", "знаков ", "утверждений ", "тотальностей ", "таблиц ", "отпечаток "].any (fun p => l.startsWith p))

def «судитьШапку» (s : «Исх») («шапка» : List String) : «Суд» :=
  ({ «беды» := («шапка».map «обрезать»).flatMap (fun l => «если» («формаШапки?» l) s!"строка шапки «{l}» не по форме печати") } : «Суд»).«и»
    («судитьОглавление» s «шапка»)

def «Исх».«блокПлана» (s : «Исх») («где» : Nat) : List Nat :=
  (List.range' («где» + 1) (s.«число» - «где»)).takeWhile (fun k => (s.«сырая» k).startsWith " ")

def «Исх».«зовомыеПлана» (s : «Исх») (h : Array String) («где» : Nat) : List String := Id.run do
  let «свои» := s.«функции»
  let mut «зов» : List String := (s.«блокПлана» «где»).filterMap fun k =>
    let l := s.«строка» k
    if l.startsWith "обрабатывает «" || l.startsWith "начинает с «" then some («ёлочка» l 1) else none
  for _ in [0:«свои».length + 1] do
    let «было» := «зов».length
    for k in s.«номера» do
      if «зов».contains («хозяинИз» h k) then
        for u in «упоминания» (s.«строка» k) do
          let «вызов» := u.«после».startsWith "от " || u.«после» = "от" || («свои».contains u.«имя» && !«конструктор?» u)
          if «вызов» && !«зов».contains u.«имя» then «зов» := «зов» ++ [u.«имя»]
    if «зов».length = «было» then break
  return «зов»

def «поручения» (l : String) : List String :=
  ((l.splitOn "поручение равным (вариант ").drop 1).map (fun x => «ёлочка» x 1)

/-- Разобранный блок плана: заголовок, строки «разрешено» и строки «поручение». -/
structure «БлокПлана» where
  «заг» : String
  «имя» : String
  «где» : Nat
  «тело» : List String
  «хвост» : List String
  «разр» : List String
  «прочие» : List String

def «блокПланаИз» («блок» : List String) : «БлокПлана» :=
  let «свои» := «блок».map «обрезать»
  let «заг» := «свои».headD ""
  let «тело» := «свои».drop 1
  let «внутри» := «тело».takeWhile (· ≠ "конец плана")
  let «разр» := «внутри».takeWhile (·.startsWith "разрешено «")
  { «заг» := «заг», «имя» := «ёлочка» «заг» 1, «где» := «номерПосле» «заг» "строка ", «тело» := «тело»,
    «хвост» := «тело».drop «внутри».length, «разр» := «разр», «прочие» := «внутри».drop «разр».length }

def «БлокПлана».«имена» (p : «БлокПлана») : List String := p.«разр».map (fun l => «ёлочка» l 1)
def «БлокПлана».«поручения» (p : «БлокПлана») : List String := p.«прочие».filter (·.startsWith "поручение «")

/-- Строка «разрешено «x» строка m» записи стоит на строке «разрешает» блока плана в
    исходнике, и та называет «x». -/
def «разрешеноВИсходнике» (s : «Исх») («где» : Nat) (l : String) : Bool :=
  let t := s.«строка» («номерПосле» l "строка ")
  (s.«блокПлана» «где»).contains («номерПосле» l "строка ") && t.startsWith "разрешает " &&
    (t.splitOn s!"«{«ёлочка» l 1}»").length > 1

/-- Беды блока плана; принятие — их пустота (теорема «план-по-исходнику»). Последний
    кусок, кроме того, что запись не молчит о выданном поручении, требует, чтобы
    разрешение на него стояло в плане исходника: это же следует из строки записи о нём и
    её проверок выше, и сказано отдельно, чтобы теорема не читала имя из строки записи
    по знакам. -/
def «бедыПлана» (s : «Исх») (h : Array String) (p : «БлокПлана») : List String :=
  let «имя» := p.«имя»
  let «где» := p.«где»
  let «зов» := s.«зовомыеПлана» h «где»
  «если» (p.«заг» = s!"план «{«имя»}» строка {«где»}") s!"заголовок плана «{p.«заг»}» не по форме" ++
  «если» («отКрая» (s.«сырая» «где») && s.«строка» «где» = s!"план «{«имя»}»")
    s!"строка {«где»} исходника не «план «{«имя»}»» от края — записанный план в исходнике не стоит" ++
  «если» («сколькоРаз» p.«тело» "конец плана" = 1) s!"план «{«имя»}» записан не целиком: строка «конец плана» обязана быть одна" ++
  p.«прочие».flatMap (fun l =>
    if l.startsWith "разрешено «" then [s!"план «{«имя»}»: строка «{l}» стоит не сразу под строкой «план»"]
    else if !l.startsWith "поручение «" then [s!"план «{«имя»}»: строка «{l}» не узнана"] else []) ++
  «если» (p.«прочие».isEmpty || !p.«разр».isEmpty) s!"план «{«имя»}»: поручения записаны без строк «разрешено»" ++
  p.«разр».flatMap (fun l =>
    let x := «ёлочка» l 1
    let m := «номерПосле» l "строка "
    «если» (l = s!"разрешено «{x}» строка {m}") s!"план «{«имя»}»: строка «{l}» не по форме" ++
    «если» («разрешеноВИсходнике» s «где» l) s!"план «{«имя»}»: разрешённого «{x}» на строке {m} исходника нет — там «{s.«строка» m}»") ++
  p.«поручения».flatMap (fun l =>
    let x := «ёлочка» l 1
    let f := «ёлочка» l 2
    let m := «номерПосле» l "строка "
    let t := s.«строка» m
    «если» (l = s!"поручение «{x}» функции «{f}» строка {m}") s!"план «{«имя»}»: строка «{l}» не по форме" ++
    «если» ((«поручения» t).contains x) s!"план «{«имя»}»: на строке {m} исходника поручения «{x}» нет — там «{t}»" ++
    «если» («хозяинИз» h m = f)
      s!"план «{«имя»}»: поручение записано за функцией «{f}», а строка {m} исходника стоит в функции «{«хозяинИз» h m}»" ++
    «если» («зов».contains f) s!"план «{«имя»}»: поручение записано за функцией «{f}», которой план не зовёт" ++
    «если» (p.«имена».contains x) s!"план «{«имя»}» разрешает {", ".intercalate p.«имена»}, а «{f}» строка {m} выдаёт «{x}»") ++
  s.«номера».flatMap (fun k =>
    let f := «хозяинИз» h k
    if «зов».contains f then
      («поручения» (s.«строка» k)).flatMap (fun x =>
        «если» (p.«поручения».contains s!"поручение «{x}» функции «{f}» строка {k}")
          s!"план «{«имя»}»: «{f}» строка {k} выдаёт «{x}», а строки об этом в записи нет — запись молчит о выданном" ++
        «если» (p.«разр».any (fun l => «ёлочка» l 1 = x && «разрешеноВИсходнике» s «где» l))
          s!"план «{«имя»}»: «{f}» строка {k} выдаёт «{x}», а разрешения на него в плане нет")
    else [])

def «судитьПлан» (s : «Исх») (h : Array String) («блок» : List String) : «Суд» :=
  let p := «блокПланаИз» «блок»
  { «беды» := «бедыПлана» s h p,
    «непонято» := (p.«хвост».drop 1).flatMap (fun l =>
      if !(l = "" || l = "конец записи" || l = "конец плана") then [s!"строка «{l}» после плана «{p.«имя»}» не прочтена"] else []) }

def «судитьПланы» (s : «Исх») («блоки» : List (List String)) : «Суд» :=
  let h := s.«хозяева»
  «блоки».foldl (fun r b => r.«и» («судитьПлан» s h b)) {}

def «Кпредст» : Nat := 9007199254740991

def «целыйЛитерал?» (t : String) : Option Nat :=
  let u := «обрезать» t
  if u ≠ "" && u.all Char.isDigit then u.toNat? else none

def «дробныйЛитерал?» (t : String) : Bool :=
  match («обрезать» t).splitOn "." with
  | [a, b] => a ≠ "" && a.all Char.isDigit && b ≠ "" && b.all Char.isDigit && b.any (· ≠ '0')
  | _ => false

def «имяВывода?» (t : String) : Bool :=
  let u := «т» t
  u ≠ "" && !(u.any (· = ' ')) && !(u.any (· = '(')) && («целыйЛитерал?» u).isNone

def «точныйВСтроке?» («строки» : List String) (l x : String) : Bool :=
  l.startsWith "принимает " &&
    ((l.«сн» 10).splitOn ",").any fun k =>
      match «доводСтроки» «строки» k with
      | some d => d.«имя» = x && d.«точный»
      | none => false

def «Исх».«точныйДовод?» (s : «Исх») («строки» : List String) (f x : String) : Bool :=
  match (s.«внутри» f).find? (fun i => (s.«строка» i).startsWith "принимает ") with
  | some i => «точныйВСтроке?» «строки» (s.«строка» i) x
  | none => false

def «закрытиеВхода» (s : «Исх») (h : Array String) («строки» : List String) («чья» x : String) («цел» : Bool) :
    Option (String × Bool) := Id.run do
  let «парам» := ((s.«подпись» «чья»).map (fun p => «голо» p.1)).filter (· ≠ "")
  let some k := «парам».idxOf? x | return some (s!"«{x}» не довод функции «{«чья»}»", true)
  let «метка» := s!"«{«чья»}» от "
  for i in s.«номера» do
    let l := «какЧитаетЯзык» (s.«сырая» i)
    let «зов» := «хозяинИз» h i
    for «хв» in (l.splitOn «метка»).drop 1 do
      let «дов» := «доводыВызова» «хв»
      if «дов».length ≤ k then
        return some (s!"вызов «{«чья»}» на строке {i} подаёт доводов {«дов».length}, а «{x}» стоит {k + 1}-м", false)
      let d := «т» («дов».getD k "")
      match «целыйЛитерал?» d with
      | some z =>
        if «цел» || z ≤ «Кпредст» then continue
        return some (s!"вызов «{«чья»}» на строке {i} подставляет на место «{x}» литерал «{d}» выше К_предст {«Кпредст»}", true)
      | none =>
        if «цел» && «дробныйЛитерал?» d then
          return some (s!"вызов «{«чья»}» на строке {i} подставляет на место «{x}» дробный литерал «{d}» — не целое", true)
        if «имяВывода?» d && «зов» ≠ "" && s.«точныйДовод?» «строки» «зов» d then continue
        return some (s!"вызов «{«чья»}» на строке {i} подставляет на место «{x}» «{d}» — ни литерал под К_предст, ни довод зовущей «{«зов»}» под своим обязательством; закрыть нечем", false)
  for i in s.«внутри» «чья» do
    let l := s.«строка» i
    if !(l.startsWith "дано " && «голо» («слово» l 2) = x && «слово» l 3 = "равно") then continue
    let v := «т» («словаС» l 3)
    if «цел» && «дробныйЛитерал?» v then
      return some (s!"пример на строке {i} даёт «{x}» дробное значение «{v}» — не целое", true)
    match «целыйЛитерал?» v with
    | none => return some (s!"пример на строке {i} даёт «{x}» значение «{v}» — не литерал; закрыть нечем", false)
    | some z =>
      if !«цел» && z > «Кпредст» then
        return some (s!"пример на строке {i} даёт «{x}» значение «{v}» выше К_предст {«Кпредст»}", true)
  return none

/-- Одна строка обязательства утверждения: её беды и признак «закрыть нечем» (зовущие
    не дают ни литерала под К_предст, ни довода под своим обязательством). -/
def «обязательствоВхода» (s : «Исх») (h : Array String) («строки» : List String) («имя» «чья» : String) (l : String) :
    List String × Bool :=
  if !l.startsWith "обязательство вход «" then ([s!"утверждение «{«имя»}»: «{l}» — обязательство не входа"], false) else
  let x := «ёлочка» l 1
  let «у» := «уголок» l 1
  let f := «т» «у»
  let k := «номерПосле» («после» l "⟩") "строка "
  let «где» := s!"утверждение «{«имя»}»: обязательство входа «{x}»"
  let «цел» := f = s!"{x} : цел"
  let «внутри» := k ≥ 1 && k ≤ s.«число» && «хозяинИз» h k = «чья»
  let «закр» := «закрытиеВхода» s h «строки» «чья» x «цел»
  («если» (l = s!"обязательство вход «{x}» ⟨{«у»}⟩ строка {k} на зовущем") s!"{«где»} записано не по форме" ++
   «если» («имяВывода?» x) s!"{«где»} названо не над именем довода" ++
   «если» («цел» || f = s!"{x} не больше {«Кпредст»}") s!"{«где»} заключает «{f}», а обязано «{x} не больше {«Кпредст»}» либо «{x} : цел»" ++
   «если» «внутри» s!"{«где»} указывает на строку {k}, а в функции «{«чья»}» её нет" ++
   «если» (!«внутри» || «точныйВСтроке?» «строки» (s.«строка» k) x) s!"{«где»}: строка {k} не объявляет «{x}» типом точной сетки" ++
   (match «закр» with
    | some (p, true) => [s!"{«где»} зовущим не закрыто — {p}"]
    | _ => []),
   match «закр» with
   | some (_, false) => true
   | _ => false)

def «судитьОбязательства» (s : «Исх») («строки» : List String) («обр» : List String) («имя» «чья» : String) :
    «Суд» × Nat :=
  let h := s.«хозяева»
  let rs := («обр».filter (·.startsWith "обязательство ")).map («обязательствоВхода» s h «строки» «имя» «чья»)
  ({ «беды» := rs.flatMap (·.1) }, (rs.filter (·.2)).length)

def «объявленияТелаСнятия» : List String :=
  ["принимает ", "возвращает ", "обеспечивает ", "требует ", "для всех ", "пример ", "дано ", "ожидается "]

def «местСнятия» (s : «Исх») : Nat := Id.run do
  let mut «внутри» := false
  let mut n := 0
  for k in s.«номера» do
    let raw := s.«сырая» k
    if «имяФункции» raw ≠ "" then «внутри» := true; continue
    let l := s.«строка» k
    if l ≠ "" && !raw.startsWith " " && !raw.startsWith "\t" then «внутри» := false
    if !«внутри» || «объявленияТелаСнятия».any (fun w => l.startsWith w) then continue
    for u in «упоминания» l do
      if u.«после».startsWith "от " then n := n + (s.«требования» u.«имя»).length
  return n

def «связаноВТеле» (s : «Исх») (h : Array String) (f : String) («до» : Nat) («цель» : String) : Bool :=
  (List.range' 1 (min «до» s.«число»)).any fun k =>
    «хозяинИз» h k = f &&
      let w := («т» (s.«строка» k)).splitOn " "
      (List.range (w.length - 1)).any fun i =>
        let a := w.getD i ""
        let b := w.getD (i + 1) ""
        (["пусть", "как", "где", "голова", "хвост"].contains a && «естьТ» «цель» («голо» b)) ||
          (b = "→" && «естьТ» «цель» («голо» a))

structure «Снятие» where
  «имя» : String
  «функция» : String
  «зовёт» : String
  «строка» : Nat
  «столбец» : Nat
  «свои» : List String

def «прочестьСнятие» («блок» : List String) : «Снятие» :=
  let «свои» := «блок».map «обрезать»
  let h := «свои».headD ""
  ⟨«ёлочка» h 1, «ёлочка» h 2, «ёлочка» h 3, «номерПосле» h "строка ", «номерПосле» h "столбец ", «свои»⟩

def «О8неТойФормы?» (e : String) : Bool :=
  match e.splitOn "»: формула не читается" with
  | a :: _ :: _ =>
    let l := «после» a "строка «"
    if «слово» l 3 ≠ "О8" then false else
    let p := «разрез» («т» («уголок» l 1)) "не больше"
    let «вн» := «ужатьТ» («словаС» («ужатьТ» p.«лево») 1)
    !(p.«есть» && («ужатьТ» p.«лево»).startsWith "длина " && («ужатьТ» p.«право»).startsWith "длина " &&
      «вн».startsWith "отфильтровать ")
  | _ => false

def «строемВывода?» (e : String) : Bool :=
  «О8неТойФормы?» e || ["шаг стоит до «вывод цель»", "строка «вывод цель» стоит дважды", "строка «вывод конец» стоит дважды",
   "блок вывода не закрыт строкой «вывод конец»", "в блоке вывода нет ни одного шага",
   "блок без строки «вывод цель»", "номер шага не число", "номер строки не число", ": основание"].any
    fun m => (e.splitOn m).length > 1

/-! ### Звенья разбора над вызовом снятия (Зв0, задача 4024) — зеркало `звено_строки_зв` сверщика -/

def «естьКусокЗв» (a b : String) : Bool := (a.splitOn b).length > 1

def «звеноСлучаяЗв» (t : String) : Option (String × String) :=
  if t = "случай голова и хвост" then some ("голова", "хвост") else
  match t.splitOn " " with
  | ["случай", "голова", g, "и", "хвост", x] =>
    if g = x || «естьКусокЗв» g "«" || «естьКусокЗв» x "«" then none else some (g, x)
  | _ => none

def «разбираемоеЗв» (t : String) : Option String :=
  let «п» : Option String :=
    if t.startsWith "разбор " then some ((t.drop "разбор ".length).toString)
    else match t.splitOn " разбор " with
      | _ :: «хв»@(_ :: _) => some (" разбор ".intercalate «хв»)
      | _ => none
  match «п» with
  | some x => if x = "" || «естьКусокЗв» x " " || «естьКусокЗв» x "(" || «естьКусокЗв» x ")" then none else some x
  | none => none

def «связываетСтрокаЗв» (t : String) : Bool :=
  t.startsWith "случай " || t.startsWith "пусть " || «естьКусокЗв» t " пусть " || «естьКусокЗв» t " как " ||
    «естьКусокЗв» t "→" || «естьКусокЗв» t "для всех " || «естьКусокЗв» t "есть такой" || «естьКусокЗв» t " где "

def «ближайшийРазборЗв» (s : «Исх») (h : Array String) («чья» : String) («ин» : Nat) : Nat → Nat → Option String
  | 0, _ => none
  | _, 0 => none
  | k + 1, «топливо» + 1 =>
    if «хозяинИз» h (k + 1) ≠ «чья» then none else
    let r := s.«сырая» (k + 1)
    if «обрезать» r = "" || «отступ» r ≥ «ин» then «ближайшийРазборЗв» s h «чья» «ин» k «топливо»
    else «разбираемоеЗв» («сжать» (s.«строка» (k + 1)))

def «звеноСтрокиЗв» (s : «Исх») (h : Array String) («чья» : String) («м» «вызов» : Nat) : Option «Звено» := do
  let (g, x) ← «звеноСлучаяЗв» («сжать» (s.«строка» «м»))
  let «ин» := «отступ» (s.«сырая» «м»)
  let l ← «ближайшийРазборЗв» s h «чья» «ин» («м» - 1) «м»
  if l = g || l = x then none
  if !(«вызов» > «м» && «хозяинИз» h «вызов» = «чья») then none
  let «чисто» := (List.range' («м» + 1) («вызов» - «м»)).all fun k =>
    let r := s.«сырая» k
    «обрезать» r = "" ||
      («отступ» r > «ин» && !(«связываетСтрокаЗв» (s.«строка» k) && [l, g, x].any (fun n => «естьТ» («т» (s.«строка» k)) n)))
  if !«чисто» then none
  pure ⟨«м», l, g, x⟩

def «звеньяВызоваЗв» (s : «Исх») (h : Array String) («чья» : String) («вызов» : Nat) : List «Звено» :=
  (List.range' 1 («вызов» - 1)).filterMap fun «м» =>
    if «хозяинИз» h «м» = «чья» then «звеноСтрокиЗв» s h «чья» «м» «вызов» else none

def «выводСнятия» (c : «Снятие») («цель» : String) («строки» : List String) («опр» : List «Определение»)
    («звенья» : List «Звено» := []) :
    Except String (Option String) :=
  match «утверждение» s!"утверждение «{c.«имя»}» функции «{c.«функция»}» строка {c.«строка»}"
      ((c.«свои».drop 1).filter (· ≠ "")) «строки» «опр» with
  | .error e => .error s!"блок вывода не прочтён ({e})"
  | .ok u =>
    match «форм» («терм» «цель») with
    | none => .error s!"цель «{«цель»}» моделью не читается"
    | some f =>
      let (sp, tk) := «сортаИмён» «строки» c.«функция»
      let u := { u with «цель» := «поСорту» sp tk f, «звенья» := «звенья» }
      if «принят?» u then .ok none else
      match u.«вывод» with
      | none => .error "блок вывода не прочтён"
      | some v =>
        match «первыйОтказВывода» u v.«шаги» [] with
        | some «ш» =>
          if «внеМодели» u «ш» then .error s!"шаг {«ш».«номер»} {«ш».«правило»} вне модели"
          else .ok (some s!"шаг {«ш».«номер»} {«ш».«правило»} не принят")
        | none => .ok (some "итог блока не цель снятия либо гипотеза не снята")
where
  «первыйОтказВывода» (u : «Утверждение») : List «Шаг» → List «Принятый» → Option «Шаг»
    | [], _ => none
    | «ш» :: «хв», «преж» =>
      if «ш».«номер» = «преж».length + 1 then
        match «шаг?» u «преж» «ш» with
        | some p => «первыйОтказВывода» u «хв» («преж» ++ [p])
        | none => some «ш»
      else some «ш»

/-- **Снятие блоком `вывод` судит модель (ADR-0193, задача 4572).** Если суд снятия
    блоком `вывод` дал «принято» (`.ok none`), то читатель прочёл утверждение снятия, его
    цель — прочтённая моделью формула снимаемого условия, приёмка модели приняла блок
    (`«Принят»`: каждый шаг — правило модели) и цель следует из окружения. Иного пути к
    `.ok none` у `«выводСнятия»` нет. -/
theorem «выводСнятия-по-модели» (c : «Снятие») («цель» : String) («строки» : List String)
    («опр» : List «Определение») («звенья» : List «Звено»)
    (h : «выводСнятия» c «цель» «строки» «опр» «звенья» = .ok none) :
    ∃ u f, «форм» («терм» «цель») = some f ∧
      u.«цель» = «поСорту» («сортаИмён» «строки» c.«функция»).1 («сортаИмён» «строки» c.«функция»).2 f ∧
      «Принят» u ∧ «Судим» («окружение» u) («Факт-из» u.«цель») := by
  unfold «выводСнятия» at h
  split at h
  · cases h
  · rename_i u0 _
    split at h
    · cases h
    · rename_i f hf
      simp only at h
      split at h
      · rename_i hp
        exact ⟨_, f, hf, rfl, «принят?-верно» _ hp, «состоятельность-разрешимо» _ hp⟩
      · split at h
        · cases h
        · split at h
          · split at h <;> cases h
          · cases h

/-- Беды формы блока снятия: заголовок, строй, строки вердикта и правила; непонятое —
    строки после блока. Решение судит `«решениеСнятия»`, и только при пустых бедах формы. -/
def «формаСнятия» («правила» : List String) (c : «Снятие») : «Суд» :=
  let «место» := s!"снятие «{c.«имя»}» функции «{c.«функция»}» строка {c.«строка»}"
  let «тело» := c.«свои».drop 1
  let «внутри» := «тело».takeWhile (· ≠ "конец снятия")
  let «хвост» := «тело».drop «внутри».length
  let «вл» := «внутри».filter (fun l => l.startsWith "вердикт " || l = "вердикт")
  let «пл» := «внутри».filter (·.startsWith "правило «")
  let «пр» := «ёлочка» («пл».headD "") 1
  { «беды» :=
      «если» (c.«свои».headD "" = s!"снятие «{c.«имя»}» функции «{c.«функция»}» зовёт «{c.«зовёт»}» строка {c.«строка»} столбец {c.«столбец»}")
        s!"{«место»}: заголовок не по форме" ++
      «если» («сколькоРаз» «тело» "конец снятия" = 1) s!"{«место»}: записано не целиком — строка «конец снятия» обязана быть одна" ++
      «если» («сколькоРаз» «внутри» "вид precondition-at-call" = 1) s!"{«место»}: строка «вид precondition-at-call» не одна" ++
      «если» («вл».length = 1 && «пл».length = 1) s!"{«место»}: строк вердикта {«вл».length}, правила {«пл».length} — обязано по одной" ++
      «внутри».flatMap (fun l =>
        if !(l = "вид precondition-at-call" || l.startsWith "вердикт " || l = "вердикт" || l.startsWith "правило «" || l.startsWith "вывод " || l.startsWith "ход ") then
          [s!"{«место»}: строка «{l}» не узнана"] else []) ++
      «если» (!(«внутри».any (·.startsWith "вывод ") && «внутри».any (·.startsWith "ход "))) s!"{«место»}: и блок вывода, и ходы" ++
      «если» («пл».all (fun l => l = s!"правило «{«пр»}»") && «правила».contains «пр») s!"{«место»}: правила «{«пр»}» ядро не знает",
    «непонято» := («хвост».drop 1).flatMap (fun l =>
      if !(l = "" || l = "конец записи" || l = "конец снятия") then [s!"строка «{l}» после снятия не прочтена"] else []) }

/-- Строки блока снятия между заголовком и «конец снятия». -/
def «Снятие».«внутри» (c : «Снятие») : List String := (c.«свои».drop 1).takeWhile (· ≠ "конец снятия")

/-- Вызов, о котором снятие: требования зовомой, её параметры, строка вызова с его
    столбца, снимаемое требование и доводы вызова. -/
structure «ВызовСнятия» where
  «треб» : List String
  «парам» : List String
  «с» : String
  «у» : Option String
  «арги» : List String

def «вызовСнятия» (s : «Исх») (c : «Снятие») : «ВызовСнятия» :=
  let «треб» := s.«требования» c.«зовёт»
  let «с0» := ((if s.«язык».isSome then s.«подлинная» c.«строка» else s.«сырая» c.«строка»).drop (c.«столбец» - 1)).toString
  let «с» := match s.«язык» with
    | some y => «поРусски» «с0» y
    | none => «с0»
  let «зов» := s!"«{c.«зовёт»}» от "
  { «треб» := «треб», «парам» := ((s.«подпись» c.«зовёт»).map (fun p => «голо» p.1)).filter (· ≠ ""), «с» := «с»,
    «у» := ((«треб».filter (fun l => «ёлочка» l 1 = c.«имя»)).getLast?).map «формулаТребования»,
    «арги» := if «с».startsWith «зов» then «доводыВызова» («с».«сн» «зов».length) else [] }

/-- Требование зовомой, где параметры заменены доводами вызова — разом, через метки. -/
def «подставитьДоводы» («у» : String) («парам» «арги» : List String) : String :=
  let «пары» := «парам».zip «арги»
  let «меченые» := ((List.range «парам».length).zip «пары»).foldl (fun t (i, (p, _)) => «вместо» t p s!"%п{i}%") («т» «у»)
  «т» (((List.range «парам».length).zip «пары»).foldl (fun t (i, (_, a)) => «вместо» t s!"%п{i}%" («т» a)) «меченые»)

/-- Цель снятия: снимаемое требование зовомой на доводах этого вызова. -/
def «цельСнятия» (s : «Исх») (c : «Снятие») : Option String :=
  let v := «вызовСнятия» s c
  match v.«у» with
  | some «у» => if v.«арги».length = v.«парам».length then some («подставитьДоводы» «у» v.«парам» v.«арги») else none
  | none => none

/-- Обстоятельства прогона ходов снятия. -/
def «обстСнятия» (s : «Исх») (c : «Снятие») («цель» : String) («доказанные» «объявленные» : List String) : «Обст» :=
  let o : «Обст» := { «исх» := s }
  let o := { o with «свои» := c.«внутри», «цель» := «цель», «функция» := c.«функция» }
  { o with «доказанные» := «доказанные», «объявленные» := «объявленные» }

/-- Решение о снятии с принятой формой: блок вывода судит модель (`«выводСнятия»`),
    ходы — прогон `«проигратьБлок»`. -/
def «решениеСнятия» (s : «Исх») (h : Array String) («строки» : List String) («опр» : List «Определение»)
    («доказанные» «объявленные» : List String) (c : «Снятие») (r : «Суд») : «Суд» :=
  let «место» := s!"снятие «{c.«имя»}» функции «{c.«функция»}» строка {c.«строка»}"
  let «внутри» := c.«внутри»
  let «вл» := «внутри».filter (fun l => l.startsWith "вердикт " || l = "вердикт")
  let v := «вызовСнятия» s c
  if «хозяинИз» h c.«строка» ≠ c.«функция» then r.«беда» s!"{«место»}: строка {c.«строка»} стоит не в функции «{c.«функция»}»"
  else if !v.«с».startsWith s!"«{c.«зовёт»}»" then r.«беда» s!"{«место»}: в строке {c.«строка»} со столбца {c.«столбец»} вызова «{c.«зовёт»}» нет"
  else if v.«треб».isEmpty then r.«слово» s!"{«место»}: у «{c.«зовёт»}» нет «требует» — предусловие прочесть негде"
  else match v.«у» with
  | none => r.«беда» s!"{«место»}: у «{c.«зовёт»}» нет требования «{c.«имя»}»"
  | some «у» =>
    if v.«арги».length ≠ v.«парам».length then
      r.«беда» s!"{«место»}: у «{c.«зовёт»}» параметров {v.«парам».length}, а в вызове доводов {v.«арги».length}"
    else if «вл» ≠ ["вердикт доказано"] then r.«слово» s!"{«место»}: «{«вл».headD ""}» — снятие не доказано"
    else
      let «цель» := «подставитьДоводы» «у» v.«парам» v.«арги»
      if «связаноВТеле» s h c.«функция» c.«строка» «цель» then
        r.«слово» s!"{«место»}: имя цели «{«цель»}» связано в теле «{c.«функция»}»"
      else if «внутри».any (·.startsWith "вывод ") then
        match «выводСнятия» c «цель» «строки» «опр» («звеньяВызоваЗв» s h c.«функция» c.«строка») with
        | .error e => if «строемВывода?» e then r.«беда» s!"{«место»}, вывод: {e}" else r.«не» s!"{«место»}, вывод: {e}"
        | .ok none => r
        | .ok (some e) => r.«беда» s!"{«место»}, вывод: {e}"
      else
        let «факт» := match «внутри».find? (·.startsWith "ход 1 факт по свойству «") with
          | some l => «ёлочка» l 1
          | none => ""
        if «факт» ≠ "" && !«доказанные».contains «факт» then
          r.«слово» s!"{«место»}: обещание «{«факт»}» не проверено по существу"
        else if !«внутри».any (·.startsWith "ход ") then r.«слово» s!"{«место»}: вывода нет"
        else
          let p := «проигратьБлок» («обстСнятия» s c «цель» «доказанные» «объявленные»)
          let r := r.«еслиНе» p.«беды».isEmpty s!"{«место»}, сведение: {"; ".intercalate p.«беды»}"
          let r := { r with «наСлово» := r.«наСлово» ++ p.«неВзялся».map (fun x => s!"{«место»}, сведение: {x}") }
          if p.«беды».isEmpty && p.«неВзялся».isEmpty && p.«проиграно» = 0 then
            r.«слово» s!"{«место»}: ходы ничего не свели"
          else r

def «судитьСнятие» (s : «Исх») (h : Array String) («строки» : List String) («опр» : List «Определение»)
    («правила» «доказанные» «объявленные» : List String) («блок» : List String) : «Суд» :=
  let c := «прочестьСнятие» «блок»
  let r := «формаСнятия» «правила» c
  if !r.«беды».isEmpty then r else «решениеСнятия» s h «строки» «опр» «доказанные» «объявленные» c r

def «судитьСнятия» (s : «Исх») («строки» : List String) («опр» : List «Определение»)
    («правила» «доказанные» «объявленные» : List String) («блоки» : List (List String)) : «Суд» := Id.run do
  if «блоки».isEmpty then return {}
  let h := s.«хозяева»
  let mut r : «Суд» := {}
  let mut «ключи» : List String := []
  let mut «блоков» := 0
  for b in «блоки» do
    let c := «прочестьСнятие» b
    let «ключ» := s!"{c.«строка»} {c.«столбец»} {c.«имя»}"
    r := r.«еслиНе» (!«ключи».contains «ключ») s!"снятие «{c.«имя»}» на строке {c.«строка»} записано дважды"
    «ключи» := «ключи» ++ [«ключ»]
    if !(s.«требования» c.«зовёт»).isEmpty then «блоков» := «блоков» + 1
    r := r.«и» («судитьСнятие» s h «строки» «опр» «правила» «доказанные» «объявленные» b)
  let «мест» := «местСнятия» s
  r := r.«еслиНе» («мест» = «блоков»)
    s!"в телах исходника мест вызова под «требует» {«мест»}, а в записи снятий о них {«блоков»} — запись говорит не обо всей программе"
  return r

end «Второй»
