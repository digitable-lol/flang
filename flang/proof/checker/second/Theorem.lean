import Premises

open «Разбор»

namespace «Второй»

inductive «Мера» where
  | «есть» (w : String)
  | «ложь»
  | «неясно»

def «шагРастит» (s : «Исх») («дк» : List String) (a «ш» : String) : «Мера» := Id.run do
  if «ш».startsWith "добавить " || «ш».startsWith "приписать " then
    match «надвоеВ» («словаС» «ш» 1) "к" with
    | some (_, x) => return if x = a then .«есть» "" else .«ложь»
    | none => return .«неясно»
  if !«ш».startsWith "«" then return .«неясно»
  let g := «ёлочка» «ш» 1
  let some (h, e) := s.«блокС» g | return .«неясно»
  let «пар» := (s.«доводы» g).«голые»
  let «арг» := «сверху» («ужатьТ» («после» «ш» s!"«{g}» от ")) "и"
  let some k := «арг».findIdx? (fun x => «ужатьТ» x = a) | return .«ложь»
  if «пар».length ≠ «арг».length then return .«ложь»
  let «ждёмП» := «т» s!"( длина результат ) равен ( ( длина {«пар».getD k ""} ) плюс 1 )"
  let ok := (List.range' h (e - h)).any fun i =>
    let l := s.«строка» i
    l.startsWith "обеспечивает «" && «дк».contains («ёлочка» l 1) && «т» («после» l "» ") = «ждёмП»
  return if ok then .«есть» "" else .«ложь»

def «мераСвёртки» (s : «Исх») («дк» : List String) («вн» : String) : «Мера» :=
  if !«вн».startsWith "свёртка " then .«неясно» else
  let «как» := «разрез» («словаС» «вн» 1) "как"
  let «нач» := «разрез» «как».«лево» "начиная с"
  let «стр» := «разрез» «как».«право» "→"
  let «им» := «разрез» «стр».«лево» "и"
  if !(«как».«есть» && «нач».«есть» && «стр».«есть» && «им».«есть») then .«неясно» else
  match «шагРастит» s «дк» («ужатьТ» «им».«лево») («ужатьТ» «стр».«право») with
  | .«есть» _ =>
    let x := «ужатьТ» «нач».«право»
    let «л» := «вСкобки» («ужатьТ» «нач».«лево»)
    .«есть» (if x = "пустой список" then s!"длина {«л»}" else s!"( длина {«вСкобки» x} ) плюс ( длина {«л»} )")
  | m => m

def «М2реестром?» (s : «Исх») («дк» : List String) (o f : String) : Option Bool := Id.run do
  for op in ["не меньше", "не больше", "не равен", "меньше", "больше", "равен"] do
    match «надвоеВ» o op with
    | none => continue
    | some (ol, op1) =>
      let some (zl, zp) := «надвоеВ» f op | return none
      let («было», «стало») :=
        if ol = zl && op1 ≠ zp then (op1, zp) else if op1 = zp && ol ≠ zl then (ol, zl) else ("", "")
      if !«стало».startsWith "длина " then return none
      match «мераСвёртки» s «дк» («ужатьТ» («словаС» «стало» 1)) with
      | .«есть» w => return some («т» w = «т» «было»)
      | .«ложь» => return some false
      | .«неясно» => return none
  return none

def «списокИзПустоты» (o : String) : Option String :=
  if o.startsWith "пусто " then some («ужатьТ» («словаС» o 1)) else
  match «надвоеВ» o "равен" with
  | some (l, x) =>
    if x = "пустой список" || x = "\"\"" then some l
    else if x = "0" && l.startsWith "длина " then some («ужатьТ» («словаС» l 1)) else none
  | none => none

def «Р5телом?» (s : «Исх») («чья» : String) (o f : String) (m : Nat) : Bool := Id.run do
  let some (l, x) := «надвоеВ» f "равен" | return false
  if l ≠ "результат" then return false
  let some «пуст» := «списокИзПустоты» o | return false
  let some (a, b) := s.«блокС» «чья» | return false
  let some (g, «что») := s.«строкаРазбора» a b | return false
  if g ≠ m || «т» («голо» «что») ≠ «пуст» then return false
  let some ci := s.«найтиСлучай» m b "пусто" | return false
  let «тело» := s.«телоСлучая» ci b
  return «тело» ≠ "" && «тело» = x

def «прогонР» (s : «Исх») («дк» : List String) (u : «Утверждение») : List «Шаг» → List «Принятый» → Except («Шаг» × Bool) (List «Принятый»)
  | [], «преж» => .ok «преж»
  | «ш» :: «хв», «преж» =>
    if «ш».«номер» ≠ «преж».length + 1 then .error («ш», false) else
    match «шаг?» u «преж» «ш» with
    | some p => «прогонР» s «дк» u «хв» («преж» ++ [p])
    | none =>
      if «ш».«правило» = "М2" && «внеМодели» u «ш» then
        match «из1?» «преж» «ш» with
        | some p =>
          match «М2реестром?» s «дк» («т» p.«текст») («т» «ш».«текст») with
          | some true => «прогонР» s «дк» u «хв» («преж» ++ [«итог» «ш» p.«откр»])
          | some false => .error («ш», true)
          | none => .error («ш», false)
        | none => .error («ш», false)
      else if «ш».«правило» = "Р5" && «внеМодели» u «ш» then
        match «изСтрока?» «преж» «ш» with
        | some (p, m) =>
          if «Р5телом?» s («голо» u.«функция».«имя») («т» p.«текст») («т» «ш».«текст») m then «прогонР» s «дк» u «хв» («преж» ++ [«итог» «ш» p.«откр»])
          else .error («ш», false)
        | none => .error («ш», false)
      else .error («ш», false)

def «Суд».«выводом» (r : «Суд») («имя» : String) (h : String) (b : List String) («исходник» : List String)
    («опр» : List «Определение») (s : «Исх») («дк» : List String) : «Суд» :=
  match «утверждение» h b «исходник» «опр» with
  | .error e =>
    if «строемВывода?» e then r.«беда» s!"утверждение «{«имя»}»: блок вывода не по строю записи ({e})"
    else r.«не» s!"утверждение «{«имя»}»: блок вывода не прочтён ({e})"
  | .ok u =>
    if «принят?» u then r
    else match u.«вывод» with
      | none => r.«не» s!"утверждение «{«имя»}»: блок вывода не прочтён"
      | some v =>
        match «прогонР» s «дк» u v.«шаги» [] with
        | .error («ш», «ложь») =>
          if «ложь» then r.«беда» s!"утверждение «{«имя»}», вывод: шаг {«ш».«номер»} М2 — мера не та или шаг свёртки растит не ровно на один"
          else if «внеМодели» u «ш» then r.«не» s!"утверждение «{«имя»}», вывод: шаг {«ш».«номер»} {«ш».«правило»} вне модели"
          else r.«беда» s!"утверждение «{«имя»}», вывод: шаг {«ш».«номер»} {«ш».«правило»} не принят"
        | .ok «итог» =>
          let ok := match «итог».getLast? with
            | some «посл» => decide (v.«цель» = u.«цель» ∧ «посл».«формула» = u.«цель» ∧ «посл».«откр» = []) && «гипотезыСняты» «итог»
            | none => false
          if ok then r else r.«беда» s!"утверждение «{«имя»}», вывод: итог блока не цель утверждения либо гипотеза не снята"

structure «Теорема» where
  «исх» : «Исх»
  «обр» : List String
  «имя» : String
  «имяТ» : String
  «чья» : String
  «место» : String
  «вердикт» : String
  «огл» : List String := []
  «доказанные» : List String := []
  «объявленные» : List String := []

def «Теорема».«первая» (t : «Теорема») (p : String) : String := (t.«обр».find? (·.startsWith p)).getD ""
def «Теорема».«все» (t : «Теорема») (p : String) : List String := t.«обр».filter (·.startsWith p)
def «Теорема».«гв» (t : «Теорема») : Nat := t.«исх».«высказывание» t.«место»
def «Теорема».«счёт» (t : «Теорема») : «Счёт» := ⟨t.«исх», t.«огл»⟩

def «безТо» (s : String) : String := if s.startsWith "то " then «словаС» s 1 else s

def «сПродолжением» (s : «Исх») (n0 : Nat) (t0 : String) : String := Id.run do
  let mut n := n0
  let mut t := t0
  for _ in [0:s.«число»] do
    if n ≥ 1 && n < s.«число» && (s.«сырая» (n + 1)).startsWith "   " then
      n := n + 1
      t := t ++ " " ++ s.«строка» n
    else break
  return t

def «соСвидетелем» («ц» : String) : String :=
  match «существование» «ц» with
  | none => «т» «ц»
  | some («м», «тт», «у») =>
    let x := «заменить» («заменить» s!" {«т» «у»} " s!" {«голо» «м»}." s!" {«тт»}.") s!" «{«голо» «м»}»." s!" {«тт»}."
    «т» («вместо» x «м» «тт»)

def «правилоШага» («ш» : String) : Option String :=
  match («ш».splitOn " правило «").getLast? with
  | none => none
  | some x =>
    if («ш».splitOn " правило «").length < 2 then none
    else if x.endsWith "»" && (x.splitOn "»").length = 2 && !((x.splitOn "«").length > 1) then some (x.dropEnd 1).toString
    else none

def «безПравилаЯдра» («ш» : String) : String :=
  match «правилоШага» «ш» with
  | some p => («ш».dropEnd (s!" правило «{p}»").length).toString
  | none => «ш»

def «шагСловами» («ш» : String) : String := «словаШага» («безПравилаЯдра» «ш»)

def «безПривязкиМеткой» («ш» «метка» : String) : String :=
  let «ч» := «ш».splitOn «метка»
  match «ч».getLast? with
  | some x => if «ч».length ≥ 2 && x ≠ "" && x.all Char.isDigit then «метка».intercalate «ч».dropLast else «ш»
  | none => «ш»

def «меткаПримера» : String := " пример строка "
def «меткаСвойства» : String := " свойство строка "

def «шагВид» («ш» : String) : String := «слово» («шагСловами» «ш») (if «номерПосле» «ш» "строка " ≥ 1 then 5 else 3)

def «шагОбоснование» («ш» : String) : String :=
  «словаС» («безПривязкиМеткой» («безПривязкиМеткой» («шагСловами» «ш») «меткаПримера») «меткаСвойства»)
    (if «номерПосле» «ш» "строка " ≥ 1 then 5 else 3)

def «естьУголки» (s : String) : Bool :=
  match s.splitOn "⟨" with
  | _ :: r => (("⟨".intercalate r).splitOn "⟩").length > 1
  | [] => false

def «видСтрокиТеоремы» (s : String) : String :=
  let g := «безТо» s
  if ["по предположению", "по свойству", "по примеру", "по закону", "затем "].any (g.startsWith ·) then "шаг"
  else if g.startsWith "случай " then "случай"
  else if g.startsWith "дано " then "дано"
  else if g.startsWith "утверждаем" then "утверждаем"
  else if g.startsWith "индукция по" then "индукция"
  else if g = "следовательно доказано" then "доказано" else ""

def «Исх».«разметкаТеоремы» (s : «Исх») («начало» : Nat) : List String := Id.run do
  let «следует» := (s.«по» «начало»).startsWith "следует «"
  let mut m : List String := []
  let mut «утв» := 0
  for i in List.range' «начало» (s.«число» + 1 - «начало») do
    let «сыр» := s.«сырая» i
    let t := s.«по» i
    if i > «начало» && «сыр» ≠ "" && !«сыр».startsWith " " then break
    if t.startsWith "//" || t = "" then continue
    if «утв» > 0 && «отступ» «сыр» > «утв» then continue
    «утв» := 0
    let mut «вид» := ""
    if t.startsWith "теорема " || (i = «начало» && «следует») then «вид» := "теорема"
    else
      «вид» := «видСтрокиТеоремы» t
      if «вид» = "утверждаем" then «утв» := «отступ» «сыр»
      if «вид» = "" || («следует» && «вид» = "доказано") then continue
    if «вид» = "дано" && (!((t.splitOn ":").length > 1) || (t.splitOn " таких что ").length > 1) then
      if (t.splitOn ":").length > 1 then m := m ++ [s!"дано {i}"]
      m := m ++ [s!"допущение {i}"]
      continue
    m := m ++ [if «вид» = "доказано" then "доказано" else s!"{«вид»} {i}"]
  if «следует» then m := m ++ ["доказано"]
  return m

def «видСтрокиЗаписи» (s : String) : String :=
  if s = "следовательно доказано да" then "доказано"
  else if s.startsWith "дано «" then "дано"
  else if s.startsWith "допущение ⟨" then "допущение"
  else if s.startsWith "цель строка" || s.startsWith "цель ⟨" then "утверждаем"
  else if s.startsWith "индукция по " then "индукция"
  else if s.startsWith "случай строка" then "случай"
  else if s.startsWith "шаг " then "шаг" else ""

def «разметкаЗаписи» («обр» : List String) («начало» : Nat) : List String × Bool := Id.run do
  let mut m := [s!"теорема {«начало»}"]
  let mut «без» := false
  for s in «обр» do
    let v := «видСтрокиЗаписи» s
    if v = "" then continue
    if v = "доказано" then
      m := m ++ ["доказано"]
      continue
    let g := «номерПосле» s "строка "
    if g < 1 then «без» := true
    m := m ++ [s!"{v} {g}"]
  return (m, «без»)

def «Исх».«именаДано» (s : «Исх») (i : Nat) : List String :=
  let l := «после» (s.«по» i) "дано "
  let b := (l.splitOn " таких что ").headD l
  let ps := «сверху» b "и"
  let ps := if ps.isEmpty then [b] else ps
  ps.filterMap fun p => match p.splitOn ":" with
    | a :: _ :: _ => some («голо» a)
    | _ => none

def «Исх».«разметкаПечати» (s : «Исх») (m : List String) : List String :=
  match m with
  | [] => []
  | h :: r =>
    let «гр» := r.takeWhile (fun x => x.startsWith "дано " || x.startsWith "допущение ")
    let «хв» := r.drop «гр».length
    let «дано» := («гр».filter (·.startsWith "дано ")).flatMap fun x =>
      let i := («слово» x 2).toNat?.getD 0
      List.replicate (max 1 (s.«именаДано» i).length) x
    h :: «дано» ++ «гр».filter (·.startsWith "допущение ") ++ «хв»

def «судитьРазметку» (t : «Теорема») («начало» : Nat) : «Суд» := Id.run do
  let s := t.«исх»
  let mut r : «Суд» := {}
  r := r.«еслиНе» (s.«по» «начало» = s!"теорема «{t.«имяТ»}»" || s.«по» «начало» = s!"следует «{t.«имяТ»}»")
    s!"строка {«начало»} исходника — не «теорема «{t.«имяТ»}»»"
  let (e, «без») := «разметкаЗаписи» t.«обр» «начало»
  let n := s.«разметкаПечати» (s.«разметкаТеоремы» «начало»)
  let «вид» := fun (v : List String) => if «без» then v.map (fun x => «слово» x 1) else v
  r := r.«еслиНе» («вид» e = «вид» n)
    s!"теорема «{t.«имяТ»}»: запись говорит о строках [{", ".intercalate («вид» e)}], а в исходнике стоят [{", ".intercalate («вид» n)}]"
  let mut j := 0
  for d in t.«все» "допущение " do
    j := j + 1
    let g := «номерПосле» d "строка "
    let l := s.«строка» g
    let P := if (l.splitOn " таких что ").length > 1 then «после» l " таких что " else «после» l "дано "
    r := r.«еслиНе» («т» («уголок» d 1) = «т» P) s!"теорема «{t.«имяТ»}»: допущение {j} — в записи ⟨{«уголок» d 1}⟩, а в исходнике на строке {g} — «{P}»"
  return r

partial def «среди_конъюнктов» («г» «огр» : String) : Bool :=
  let «ч» := «сверху» («т» «огр») "и притом"
  if «ч».length < 2 then «совпали» «г» («т» «огр») else «ч».any («среди_конъюнктов» «г» ·)

def «Теорема».«типПеременной» (t : «Теорема») (x : String) : String :=
  let s := t.«исх»
  if t.«гв» ≠ 0 then s.«типВысказывания» t.«гв» x
  else
    let d := s.«доводы» t.«чья»
    ((d.«имена».zip d.«типы»).find? (fun (n, _) => «голо» n = x)).map (·.2) |>.getD ""

def «Теорема».«фактТипа» (t : «Теорема») («г» : String) : Bool :=
  let r := «разрез» «г» "не меньше"
  r.«есть» && «ужатьТ» r.«право» = "0" && «натуральноеИмя» («имяТипа» (t.«типПеременной» («голо» («ужатьТ» r.«лево»))))

def «судитьСнятиеГипотез» (t : «Теорема») : «Суд» := Id.run do
  let s := t.«исх»
  let «треб» := if t.«гв» ≠ 0 then [] else s.«всеТребования» t.«чья»
  let «огр» := (t.«все» "таких что ").map («уголок» · 1) ++ «треб».map «формулаТребования»
  let mut r : «Суд» := {}
  for d in t.«все» "допущение " do
    let g := «т» («уголок» d 1)
    let «снята» := t.«фактТипа» g || «огр».any («среди_конъюнктов» g ·)
    r := r.«еслиНе» «снята» s!"теорема «{t.«имяТ»}»: гипотеза ⟨{«уголок» d 1}⟩ строки {«номерПосле» d "строка "} не является допущением утверждения"
  return r

def «сверитьТермИНомер» (r : «Суд») («зап» «вИсх» : String) («где» : Nat) («имяТ» «что» : String) : «Суд» :=
  if «где» < 1 || !«естьУголки» «зап» then r
  else r.«еслиНе» («т» («уголок» «зап» 1) = «т» «вИсх») s!"теорема «{«имяТ»}», {«что»}, строка {«где»}: термин записи и исходник говорят о разном"

def «сверитьТермБезНомера» (r : «Суд») («зап» «обосн» : String) («имяТ» «что» : String) : «Суд» :=
  if !«естьУголки» «зап» then r.«беда» s!"теорема «{«имяТ»}», {«что»}: ни номера строки, ни термина в уголках"
  else
    let x := «т» («уголок» «зап» 1)
    if x = "" then r.«беда» s!"теорема «{«имяТ»}», {«что»}: термин в уголках пуст"
    else r.«еслиНе» (x = «т» «обосн») s!"теорема «{«имяТ»}», {«что»}: термин в уголках и обоснование расходятся"

def «Теорема».«цельСтроки» (t : «Теорема») : String :=
  let l := t.«первая» "цель "
  let g := «номерПосле» l "строка "
  if g < 1 then «уголок» l 1 else «после» (t.«исх».«строка» g) "утверждаем "

def «судитьЦель» (t : «Теорема») («где» : Nat) : «Суд» := Id.run do
  let s := t.«исх»
  let «гв» := t.«гв»
  let «сырое» := if «гв» ≠ 0 then s.«цельВысказывания» «гв»
    else «сПродолжением» s «где» («после» («какЧитаетЯзык» t.«место») s!"обеспечивает «{t.«имя»}» ")
  let l := t.«первая» "цель "
  let g := «номерПосле» l "строка "
  let mut r : «Суд» := {}
  let mut «утв» := ""
  if g < 1 then «утв» := «уголок» l 1
  else
    «утв» := «после» (s.«строка» g) "утверждаем "
    r := «сверитьТермИНомер» r l «утв» g t.«имяТ» "цель"
    «утв» := «сПродолжением» s g «утв»
  let «сошлось» :=
    if «гв» ≠ 0 then «соСвидетелем» «сырое» == «соСвидетелем» «утв»
    else match «существование» «сырое» with
      | none => «сырое» == «утв»
      | some _ => «обещанная» «сырое» == «т» «утв»
  return r.«еслиНе» «сошлось» s!"теорема «{t.«имяТ»}» утверждает «{«утв»}», а обещано «{«сырое»}» — доказывается не то, что обещано"

def «судитьИмена» (t : «Теорема») : «Суд» := Id.run do
  let s := t.«исх»
  let mut r : «Суд» := {}
  for z in t.«обр» do
    let «что» := if z.startsWith "дано «" then "дано " else if z.startsWith "индукция по «" then "индукция по " else ""
    if «что» = "" then continue
    let n := «ёлочка» z 1
    let g := «номерПосле» z "строка "
    if g < 1 then continue
    let v := s.«по» g
    let b := «после» v «что»
    let «было» := if «что» = "дано " then «голо» ((b.splitOn ":").headD "")
      else if b.startsWith "«" then «ёлочка» b 1 else «слово» b 1
    if !(v.startsWith «что» && («было» = n || («что» = "дано " && (s.«именаДано» g).contains n))) then
      r := r.«беда» s!"теорема «{t.«имяТ»}», строка {g}: запись зовёт «{«что»}{n}», а в исходнике стоит «{v}»"
  return r

def «судитьЧислоШагов» (t : «Теорема») : «Суд» := Id.run do
  let mut r : «Суд» := {}
  let mut «объявлено» : Option Nat := none
  let mut «факт» := 0
  let mut «где» := 0
  for z in t.«обр» ++ ["случай строка"] do
    if z.startsWith "случай строка" then
      if let some k := «объявлено» then
        r := r.«еслиНе» (k = «факт») s!"теорема «{t.«имяТ»}», случай на строке {«где»}: объявлено шагов {k}, а написано {«факт»}"
      «объявлено» := some («номерПосле» z "шагов ")
      «где» := «номерПосле» z "строка "
      «факт» := 0
    else if z.startsWith "шаг " && «объявлено».isSome then «факт» := «факт» + 1
  return r

def «незакрытыеСлучаи» («обр» : List String) : Nat := Id.run do
  let mut «в» := false
  let mut «закрыт» := false
  let mut «долг» := 0
  for s in «обр» do
    if s.startsWith "случай строка" then
      if «в» && !«закрыт» then «долг» := «долг» + 1
      «в» := true
      «закрыт» := false
    else if s.startsWith "шаг " && «шагВид» s = "закрывающий" then «закрыт» := true
  return if «в» && !«закрыт» then «долг» + 1 else «долг»

def «судитьЗакрытие» (t : «Теорема») : «Суд» :=
  let «шаги» := t.«все» "шаг "
  let «закрыв» := («шаги».filter (fun x => «шагВид» x = "закрывающий")).length
  let «случаев» := (t.«все» "случай строка").length
  let «нужно» := if «случаев» > 0 then «случаев» else 1
  let qed := «слово» («после» (t.«первая» "следовательно доказано ") "доказано ") 1
  let d := t.«вердикт» = "доказано"
  let r : «Суд» := {}
  let r := r.«еслиНе» (!d || qed = "да") s!"теорема «{t.«имяТ»}»: вердикт «доказано», а «следовательно доказано» не стоит"
  let r := r.«еслиНе» (!d || «закрыв» ≥ «нужно») s!"теорема «{t.«имяТ»}»: закрывающих шагов {«закрыв»} на {«случаев»} случаев"
  r.«еслиНе» (!d || «незакрытыеСлучаи» t.«обр» = 0) s!"теорема «{t.«имяТ»}»: есть случаи без закрывающего шага"

def «правилаНеотр» : List String :=
  ["неотрицательность по построению", "цель есть допущение", "несовместимые допущения", "вычисление замкнутой цели",
   "разбор цели по условию", "разбор случаев по внутреннему условию цели", "разбор случаев по дизъюнкции в допущении"]

structure «Логика» where
  «имена» : List String := []
  «атомы» : List String := []
  «набор» : Nat := 0

def «связка» (t op : String) : List String :=
  let «ч» := «сверху» t op
  if «ч».length > 1 && «ч».any (fun x => («обрезать» x).startsWith "если ") then [] else «ч»

partial def «конъюнкты» («сырой» : String) : List String :=
  let t := «т» «сырой»
  let «ч» := «связка» t "и притом"
  if «ч».length < 2 || («связка» t "или").length ≠ 1 then [t] else «ч».flatMap «конъюнкты»

def «Теорема».«признак?» (t : «Теорема») (p : «Логика») («атом» : String) : Bool :=
  let s := t.«исх»
  p.«имена».any fun x =>
    let «тип» := «голо» (s.«типВысказывания» t.«гв» x)
    match s.«номера».find? (fun j => s.«по» j = s!"объект «{«тип»}»") with
    | none => false
    | some j =>
      let ls := (List.range' (j + 1) (s.«число» - j)).takeWhile (fun k => (s.«сырая» k).startsWith "  ")
      ls.any fun k =>
        let z := s.«по» k
        let «поле» := «голо» ((z.splitOn ":").headD "")
        «обрезать» («после» z ":") = "признак" && («атом» = s!"«{x}».«{«поле»}»" || «атом» = s!"{x}.«{«поле»}»")

partial def «истинно» (t : «Теорема») («сырой» : String) : StateM «Логика» (Option Bool) := do
  let u := «т» «сырой»
  let «или» := «связка» u "или"
  let «ч» := if «или».length = 1 then «связка» u "и притом" else «или»
  if u = "да" then return some true
  if u = "нет" then return some false
  let mut «итог» := «или».length == 1
  if «ч».length > 1 then
    for x in «ч» do
      match ← «истинно» t x with
      | none => return none
      | some a => «итог» := if «или».length = 1 then «итог» && a else «итог» || a
  if «ч».length ≠ 1 then return (if «ч».isEmpty then none else some «итог»)
  if u.startsWith "не " then
    match ← «истинно» t (u.«сн» 3) with
    | none => return none
    | some a => return some !a
  if u.startsWith "если " then
    let «то» := «сверху» (u.«сн» 5) "то"
    let «ин» := «сверху» («то».getD 1 "") "иначе"
    if «то».length ≠ 2 || «ин».length ≠ 2 then return none
    let some a ← «истинно» t («то».getD 0 "") | return none
    let some b ← «истинно» t («ин».getD 0 "") | return none
    let some c ← «истинно» t («ин».getD 1 "") | return none
    return some (if a then b else c)
  let p ← get
  match p.«атомы».findIdx? (· = u) with
  | some i => return some ((p.«набор» >>> i) % 2 = 1)
  | none =>
    if p.«атомы».length ≥ 16 || !t.«признак?» p u then return none
    set { p with «атомы» := p.«атомы» ++ [u] }
    return some ((p.«набор» >>> p.«атомы».length) % 2 = 1)

def «Теорема».«контрпример» (t : «Теорема») (K : List String) («ф» : String) («имена» : List String) : Option (Option Nat × List String) := Id.run do
  let mut p : «Логика» := { «имена» := «имена» }
  for x in K ++ [«ф»] do
    let (v, p2) := («истинно» t x).run p
    p := p2
    if v.isNone then return none
  let n := p.«атомы».length
  for m in List.range (2 ^ n) do
    let q := { p with «набор» := m }
    let ok := K.all (fun x => ((«истинно» t x).run q).1 = some true)
    if ok && ((«истинно» t «ф»).run q).1 = some false then return some (some m, p.«атомы»)
  return some (none, p.«атомы»)

def «естьВ» (K : List String) (x : String) : Bool := K.contains («т» x)

def «выводится» (K : List String) («ф» : String) : Bool :=
  («конъюнкты» «ф»).all fun c =>
    «естьВ» K c || K.any fun k =>
      let «то» := «сверху» («после» k "если ") "то"
      let «ин» := «сверху» («то».getD 1 "") "иначе"
      (k.startsWith "если " && «то».length = 2 && «ин».length = 2 && «т» («ин».getD 1 "") = "да" &&
        «т» («ин».getD 0 "") = c && «естьВ» K («то».getD 0 "")) ||
      (c = "нет" && k.startsWith "не " && «естьВ» K (k.«сн» 3))

def «Теорема».«формулаШага» (t : «Теорема») («ш» : String) : String :=
  let s := t.«исх»
  let g := «номерПосле» «ш» "строка "
  let l := if g < 1 then "" else «безТо» («сПродолжением» s g (s.«строка» g))
  if !l.startsWith "затем " || !((l.splitOn " по предположению").length > 1) then ""
  else «обрезать» (((l.«сн» 6).splitOn " по предположению").headD "")

def «Теорема».«изПосылок» (t : «Теорема») : «Суд» × Bool := Id.run do
  let s := t.«исх»
  let «гв» := t.«гв»
  let gc := «номерПосле» (t.«первая» "цель ") "строка "
  let r : «Суд» := {}
  if «гв» = 0 || gc < 1 || t.«первая» "случай " ≠ "" then return (r, false)
  let «шаги» := t.«все» "шаг "
  if !«шаги».all (fun x => («шагОбоснование» x).startsWith "по предположению") then return (r, false)
  let «цель» := «сПродолжением» s gc («после» (s.«строка» gc) "утверждаем ")
  let «имена» := s.«именаВысказывания» «гв»
  let mut K : List String := []
  for i in List.range' («гв» + 1) (s.«число» - «гв») do
    let «сыр» := s.«сырая» i
    if «сыр» ≠ "" && !«сыр».startsWith " " && !«сыр».startsWith "//" then break
    let l := «сПродолжением» s i («какЧитаетЯзык» («обрезать» («безПримечания» «сыр»)))
    if l.startsWith "для всех " && (l.splitOn " таких что ").length > 1 then K := K ++ «конъюнкты» («после» l " таких что ")
  for «ш» in «шаги» do
    let «ф» := if «шагВид» «ш» = "промежуточный" then t.«формулаШага» «ш» else «соСвидетелем» «цель»
    if «ф» = "" then return (r, false)
    match t.«контрпример» K «ф» «имена» with
    | none => return (r, false)
    | some (some m, a) =>
      let «при» := (List.range a.length).map (fun j => s!"{a.getD j ""} {if (m >>> j) % 2 = 1 then "да" else "нет"}")
      return (r.«беда» s!"теорема «{t.«имяТ»}»: шаг {«слово» «ш» 2} ⟨{«т» «ф»}⟩ из посылок утверждения не следует — при {", ".intercalate «при»} посылки верны, а он ложен", false)
    | some (none, _) =>
      if !«выводится» K «ф» then return (r, false)
      K := K ++ [«т» «ф»]
  return (r, true)

def «знач» (c : «Счёт») (e : «Среда») (t : String) : «Зн» := ((«оценить» c e t 0).run 0).1

def «сошлисьЗн» (a b : «Зн») : Bool :=
  match a, b with
  | .«стр» x, .«стр» y => x == y
  | .«спис» x _, .«спис» y _ => x == y
  | .«тег» x, .«тег» y => x == y
  | .«чис» x, .«чис» y => x == y
  | .«приз» x, .«приз» y => x == y
  | .«зап» _, .«зап» _ => true
  | _, _ => false

def «Исх».«ожидается» (s : «Исх») (p b : Nat) : String := Id.run do
  for i in s.«меж» p b do
    let z := s.«по» i
    if z.startsWith "ожидается " then return «после» z "ожидается "
    if !z.startsWith "дано " && z ≠ "" then return ""
  return ""

def «Исх».«даноПримера» (s : «Исх») (p b : Nat) («довод» : String) : String := Id.run do
  for i in s.«меж» p b do
    let z := s.«по» i
    if z.startsWith s!"дано {«довод»} равно " || z.startsWith s!"дано «{«довод»}» равно " then return «после» z "равно "
    if z.startsWith "ожидается " then return ""
    if !z.startsWith "дано " && z ≠ "" then return ""
  return ""

def «образецСовпал» («образец» «значение» : String) : Bool × Bool :=
  if «образец».startsWith "вариант «" then («образец» = «значение», true)
  else if «образец» = "пусто" then («значение» = "пустой список" || «значение» = "\"\"", true)
  else match «числоТочно» «образец», «числоТочно» «значение» with
    | some a, some b => if a == b then (true, true) else (false, false)
    | _, _ => (false, false)

def «Исх».«ветвьЕсли» (s : «Исх») (c : «Счёт») (a b : Nat) («по» «дано» : String) : String := Id.run do
  if «по» = "" || «дано» = "" then return ""
  let ls := (List.range' a (b - a)).map (s.«строка» ·)
  let e := ls.filter (·.startsWith "если ")
  let tt := ls.filter (·.startsWith "то ")
  let ii := ls.filter (·.startsWith "иначе ")
  if e.length ≠ 1 || tt.length ≠ 1 || ii.length ≠ 1 then return ""
  match «знач» c {} («вместо» («после» (e.headD "") "если ") «по» «дано») with
  | .«приз» v => return «т» (if v then «после» (tt.headD "") "то " else «после» (ii.headD "") "иначе ")
  | _ => return ""

inductive «Шагом» where
  | «да»
  | «нет»
  | «ложь» (m : String)
  | «вне» (m : String)

def «Теорема».«цельНаЗначении» (t : «Теорема») (e : «Среда») («цель» : String) : «Шагом» :=
  match «знач» t.«счёт» e «цель» with
  | .«приз» true => .«да»
  | .«приз» false => .«ложь» s!"теорема «{t.«имяТ»}»: цель «{«цель»}» на значении примера НЕ держится"
  | _ => .«нет»


def «Теорема».«шагВнеСлучая» (t : «Теорема») («имяП» «ож» «цель» : String) («свободные» : Bool) : «Шагом» :=
  let s := t.«исх»
  if «свободные» then .«нет» else
  let «сыр» := s.«телоТаблицы» t.«чья»
  match (if «сыр» = "" then none else «литерал?» «сыр») with
  | some v =>
    match «литерал?» «ож» with
      | none => .«нет»
      | some z =>
        if v ≠ z then .«ложь» s!"теорема «{t.«имяТ»}»: пример «{«имяП»}» ждёт «{«ож»}», а тело функции «{t.«чья»}» даёт другое значение"
        else t.«цельНаЗначении» { «рез» := .«стр» v } «цель»
  | none =>
    let «сп» := s.«таблицаСписком» t.«огл» t.«чья»
    let «ожН» := «безПробеловВнеКавычек» «ож»
    match «сп» with
    | .«спис» st _ =>
      if «ожН» = "" then .«нет»
      else if st ≠ «ожН» then .«ложь» s!"теорема «{t.«имяТ»}»: пример «{«имяП»}» ждёт другой список, чем тело функции «{t.«чья»}»"
      else t.«цельНаЗначении» { «рез» := «сп» } «цель»
    | _ => .«нет»

def «Теорема».«шагПримером» (t : «Теорема») («ш» «по» : String) («случайГде» : Nat) («цель» : String) («свободные» : Bool) : «Шагом» := Id.run do
  let s := t.«исх»
  let c := t.«счёт»
  let «имяП» := «ёлочка» («шагСловами» «ш») 1
  let p := «номерПосле» «ш» «меткаПримера»
  if p < 1 then return .«нет»
  let some (a, b) := s.«блокС» t.«чья» | return .«ложь» s!"теорема «{t.«имяТ»}»: функции «{t.«чья»}» в исходнике нет, а пример «{«имяП»}» записан за ней"
  if s.«по» p ≠ s!"пример «{«имяП»}»" then return .«ложь» s!"теорема «{t.«имяТ»}»: запись привязывает пример «{«имяП»}» к строке {p}, а там написано «{s.«по» p}»"
  if p < a || p ≥ b then return .«ложь» s!"теорема «{t.«имяТ»}»: пример «{«имяП»}» записан на строке {p} — вне блока функции «{t.«чья»}»"
  let «ож» := s.«ожидается» p b
  if «ож» = "" then return .«нет»
  if «случайГде» < 1 then return t.«шагВнеСлучая» «имяП» «ож» «цель» «свободные»
  let «образец» := «после» (s.«по» «случайГде») "случай "
  let «дано» := s.«даноПримера» p b «по»
  if «дано» = "" || «образец» = "" then return .«нет»
  let «обрС» := if «образец».startsWith "«" && !«образец».startsWith "вариант «" then "вариант " ++ «образец» else «образец»
  let («совпал», «знаком») := «образецСовпал» «обрС» «дано»
  if !«совпал» then
    return if «знаком» then .«ложь» s!"теорема «{t.«имяТ»}»: случай разбирает «{«образец»}», а пример «{«имяП»}» задаёт «{«по»}» как «{«дано»}»" else .«нет»
  let mut «ветвь» := s.«ветвьТела» a b «образец»
  if «ветвь» = "" && «образец».startsWith "вариант «" then «ветвь» := s.«ветвьТела» a b («образец».«сн» 8)
  if «ветвь» = "" then «ветвь» := s.«ветвьЕсли» c a b «по» «дано»
  let «дз» := «знач» c {} «дано»
  let «связ» : «Среда» := if «дз».«есть» then (({} : «Среда»).«связатьОба» «по» «дз»).1 else {}
  if «ветвь» = "" && «дз».«есть» then
    let «тз» := (((«тела» c «связ» a b 0).run 0).1)
    let «ожЗ» := «знач» c «связ» «ож»
    if «тз».«есть» && «ожЗ».«есть» && «тз».«вид» = «ожЗ».«вид» && !«тз».«мера?» then
      if !«сошлисьЗн» «тз» «ожЗ» then
        return .«ложь» s!"теорема «{t.«имяТ»}»: пример «{«имяП»}» ждёт «{«ож»}», а тело функции «{t.«чья»}» на этом доводе даёт «{«тз».«текст»}»"
      return t.«цельНаЗначении» { «связ» with «рез» := «тз» } «цель»
  if «ветвь» = "" then return .«нет»
  if «ветвь» ≠ «ож» then
    return .«ложь» s!"теорема «{t.«имяТ»}»: пример «{«имяП»}» ждёт «{«ож»}», а ветвь тела на «{«образец»}» даёт «{«ветвь»}»"
  let «рез» := «знач» c {} «ож»
  if !«рез».«есть» then return .«нет»
  let e := { «связ» with «рез» := «рез», «сосед» := some («по», «обрС», s.«строкаПринимает» a b) }
  return t.«цельНаЗначении» e «цель»

def «вызовДоводами» (x : String) : String × List String :=
  let u := «ужатьТ» («т» x)
  let g := «ёлочка» u 1
  if g ≠ "" && u.startsWith s!"«{g}» от " then (g, «доводыВызова» («после» u s!"«{g}» от ")) else ("", [])

def «Теорема».«шагУтверждением» (t : «Теорема») («имяП» : String) (p «ут» : Nat) («цель» : String) («закр» : Bool) : «Шагом» := Id.run do
  let s := t.«исх»
  if p ≠ «ут» then return .«ложь» s!"теорема «{t.«имяТ»}»: свойство «{«имяП»}» привязано к строке {p}, а заголовок утверждения — строка {«ут»}"
  let «раньше» := t.«доказанные».contains «имяП»
  let «огр» := ((List.range' («ут» + 1) (s.«число» - «ут»)).takeWhile (fun k => (s.«сырая» k).startsWith " ")).any
    (fun k => ((s.«сырая» k).splitOn " таких что ").length > 1)
  let «цУ» := «т» (s.«цельВысказывания» «ут»)
  let «имена» := s.«именаВысказывания» «ут»
  let d0 := s.«доводы» t.«чья»
  let «тело» := match s.«блокС» t.«чья» with | some (a, b) => s.«телоТекстом» a b | none => ""
  let «цШ» := «т» («вместо» («т» «цель») "результат" «тело»)
  let «читается» := «тело» ≠ "" && !«естьСвязыватель» «цШ» && «имена».length ≤ 3
  let mut «дим» := d0.«имена»
  let mut «дтип» := d0.«типы»
  if t.«гв» ≠ 0 then
    for x in s.«именаВысказывания» t.«гв» do
      «дим» := «дим» ++ [x]
      «дтип» := «дтип» ++ [«обрезать» (s.«типВысказывания» t.«гв» x)]
  let n := «дим».length
  let «всего» := if «читается» then n ^ «имена».length else 0
  if «раньше» && !«огр» && «читается» then
    for k in List.range «всего» do
      let mut «инст» := «цУ»
      let mut r := k
      let mut «годен» := true
      for i in List.range «имена».length do
        let j := r % n
        let «довод» := «голо» («дим».getD j "")
        «годен» := «годен» && «довод» ≠ "" && «обрезать» (s.«типВысказывания» «ут» («имена».getD i "")) = «обрезать» («дтип».getD j "")
        for q in List.range' (i + 1) («имена».length - i - 1) do
          «годен» := «годен» && «довод» ≠ «имена».getD q ""
        «инст» := «вместо» «инст» («имена».getD i "") «довод»
        r := r / n
      if «годен» && «т» «инст» = «цШ» then return .«да»
  let (gu, du) := «вызовДоводами» «цУ»
  let (gs, ds) := «вызовДоводами» «цШ»
  if t.«гв» ≠ 0 && «закр» && «раньше» && !«огр» && «читается» && gu ≠ "" && gs ≠ "" && !«естьТ» («т» «цель») "результат" &&
     (gu ≠ gs || du.length ≠ ds.length) then
    return .«ложь» s!"теорема «{t.«имяТ»}»: шаг «по свойству «{«имяП»}»» закрывающим не вывелся бы — вызов «{gu}» против «{gs}»"
  return .«нет»

def «Теорема».«шагПостусловием» (t : «Теорема») («имяП» : String) («где» : Nat) («цель» : String) : «Шагом» := Id.run do
  let s := t.«исх»
  let g := s.«хозяин» «где»
  let «зов» := s!"«{g}» от "
  let «тело» := match s.«блокС» t.«чья» with | some (a, b) => s.«телоТекстом» a b | none => ""
  let «ц» := «т» («вместо» («т» «цель») "результат" («вСкобки» («т» «тело»)))
  if «тело» = "" || g = "" || «естьСвязыватель» «ц» then return .«нет»
  let o0 : «Обст» := { «исх» := s }
  let o := { o0 with «функция» := t.«чья», «цель» := «т» «цель», «обяз» := t.«имяТ», «доказанные» := t.«доказанные», «объявленные» := t.«объявленные» }
  let «ч» := «тело».splitOn «зов»
  for i in List.range' 1 («ч».length - 1) do
    let q := «зов».intercalate («ч».drop i)
    let «арги» := «доводыВызова» q
    let p0 : «Прогон» := { «цели» := [«ц»], «идёт» := true }
    let p := «ходФакта» p0 s!"ход 1 факт по свойству «{«имяП»}» строка {«где»} вызов ⟨«{g}» от {" и ".intercalate «арги»}⟩" o
    if !p.«беды».isEmpty || !p.«неВзялся».isEmpty || p.«факт» = "" then continue
    match «разрезСл» («ужатьТ» «ц») " не меньше ", «разрезСл» («ужатьТ» p.«факт») " не меньше " with
    | some (l, pr), some (lf, pf) =>
      if «ужатьТ» pr = "0" && «ужатьТ» pf = "0" && «неотр?» s l t.«чья» [«ужатьТ» lf] then return .«да»
    | _, _ => pure ()
    let «охр» := match «разрезЦепочкой» «ц» with
      | some (u, _, b) => if «ужатьТ» b = "да" then s!"ход 2 закрыть по свойству по охране ⟨{u}⟩" else "ход 2 закрыть по свойству"
      | none => "ход 2 закрыть по свойству"
    let p := «закрытьПоСвойству» p «охр»
    if p.«беды».isEmpty && p.«цели».isEmpty then return .«да»
  return .«нет»

def «Теорема».«шагСвойством» (t : «Теорема») («ш» «цель» : String) : «Шагом» :=
  let s := t.«исх»
  let «имяП» := «ёлочка» («шагСловами» «ш») 1
  let p := «номерПосле» «ш» «меткаСвойства»
  let «закр» := «шагВид» «ш» = "закрывающий"
  if p < 1 then .«нет» else
  let «настоящий» := s.«свойство» «имяП»
  let «ут» := s.«высказывание» s!"утверждение «{«имяП»}»"
  if «ут» ≠ 0 && «настоящий» ≠ 0 then .«ложь» s!"теорема «{t.«имяТ»}»: имя «{«имяП»}» носят и постусловие, и утверждение"
  else if «ут» ≠ 0 then t.«шагУтверждением» «имяП» p «ут» «цель» «закр»
  else if «настоящий» < 1 then .«ложь» s!"теорема «{t.«имяТ»}»: свойство «{«имяП»}» привязано к строке {p}, а объявления нет"
  else if p ≠ «настоящий» then .«ложь» s!"теорема «{t.«имяТ»}»: свойство «{«имяП»}» привязано к строке {p}, а первое объявление — строка {«настоящий»}"
  else t.«шагПостусловием» «имяП» p «цель»

structure «Счёты» where
  «суд» : «Суд» := {}
  «закон» : List String := []
  «тело» : List String := []

def «Теорема».«судитьШаги» (t : «Теорема») («цель» : String) : «Счёты» := Id.run do
  let s := t.«исх»
  let «по» := «ёлочка» (t.«первая» "индукция по ") 1
  let «свободные» := t.«первая» "дано «" ≠ "" || «по» ≠ ""
  let «гв» := t.«гв»
  let (q0, «посылками») : «Суд» × Bool := if «по» = "" then t.«изПосылок» else ({}, false)
  let mut a : «Счёты» := { «суд» := q0 }
  let mut «случайГде» := 0
  for «ш» in t.«обр» do
    if «ш».startsWith "случай строка" then
      «случайГде» := «номерПосле» «ш» "строка "
      continue
    if !«ш».startsWith "шаг " then continue
    let «где» := «номерПосле» «ш» "строка "
    let «вид» := «шагВид» «ш»
    let mut «об» := «шагОбоснование» «ш»
    let «н» := «слово» «ш» 2
    if «об».startsWith "по предположению допущение " then
      let J := «номерПосле» «об» "допущение "
      let «всего» := (t.«все» "допущение ").length + (if «гв» ≠ 0 then (s.«ограничения» t.«место»).length else 0)
      a := { a with «суд» := a.«суд».«еслиНе» (J ≥ 1 && J ≤ «всего») s!"теорема «{t.«имяТ»}»: шаг {«н»} закрыт допущением {J}, а допущений в записи {«всего»}" }
      «об» := "по предположению"
    match «правилоШага» «ш» with
    | some pr =>
      if «об».startsWith "по примеру" || «об».startsWith "по закону" then
        a := { a with «суд» := a.«суд».«беда» s!"теорема «{t.«имяТ»}»: шаг {«н»} «{«об»}» назван правилом «{pr}», а шаг этого вида ядро правилом сведения не закрывает" }
      else if !«правилаЯдра».contains pr then
        a := { a with «суд» := a.«суд».«слово» s!"теорема «{t.«имяТ»}»: шаг {«н»} назван правилом «{pr}», которого сверщик не знает" }
    | none => pure ()
    let «наСлово» := fun (x : «Счёты») => { x with «суд» := x.«суд».«слово» s!"теорема «{t.«имяТ»}»: шаг {«н»} «{«об»}» не проверен по существу" }
    let «итог» := fun (x : «Счёты») (h : «Шагом») => match h with
      | .«да» => x
      | .«нет» => «наСлово» x
      | .«ложь» m => let y := «наСлово» x; { y with «суд» := y.«суд».«беда» m }
      | .«вне» m => { x with «суд» := x.«суд».«не» m }
    if «об».startsWith "по примеру" then
      a := «итог» a (t.«шагПримером» «ш» «по» «случайГде» «цель» «свободные»)
    else if «об».startsWith "по свойству" then
      a := «итог» a (t.«шагСвойством» «ш» «цель»)
    else if «об».startsWith "по закону" then
      a := { a with «закон» := a.«закон» ++ [s!"теорема «{t.«имяТ»}»: шаг «{«об»}» обоснован законом — место на слове ядра"] }
    else if «об» = "по предположению" && «по» = "" && «т» «цель» = "результат не меньше 0" && s.«прямаяПоПредположению» t.«чья» then
      match «правилоШага» «ш» with
      | some pr =>
        let q := a.«суд».«еслиНе» (!«правилаЯдра».contains pr || «правилаНеотр».contains pr)
          s!"теорема «{t.«имяТ»}»: шаг {«н»} выведен неотрицательностью по построению, а запись зовёт правило «{pr}»"
        a := { a with «суд» := q }
      | none => pure ()
    else if «посылками» && «об» = "по предположению" then pure ()
    else
      a := { a with «тело» := a.«тело» ++ [s!"теорема «{t.«имяТ»}»: шаг «{if «об» ≠ "" then «об» else «н»}» сверщик по существу не проигрывает"] }
    if «где» < 1 then
      a := { a with «суд» := «сверитьТермБезНомера» a.«суд» «ш» «об» t.«имяТ» s!"шаг {«н»}" }
      continue
    let «вИсх» := «безТо» (s.«строка» «где»)
    a := { a with «суд» := «сверитьТермИНомер» a.«суд» «ш» (if «вИсх».startsWith "затем " then «словаС» «вИсх» 1 else «вИсх») «где» t.«имяТ» s!"шаг {«н»}" }
    if «вид» = "промежуточный" then
      let q := a.«суд».«еслиНе» («вИсх».startsWith "затем " && («вИсх».splitOn «об»).length > 1)
        s!"теорема «{t.«имяТ»}», строка {«где»}: запись зовёт шаг промежуточным и обоснованным «{«об»}», а в исходнике стоит «{«вИсх»}»"
      a := { a with «суд» := q }
    else
      a := { a with «суд» := a.«суд».«еслиНе» («вИсх» = «об») s!"теорема «{t.«имяТ»}», строка {«где»}: запись говорит «{«об»}», а в исходнике написано «{«вИсх»}»" }
  return a

def «судитьТеорему» (t : «Теорема») («заг» : String) («строки» : List String) («опр» : List «Определение») : «Суд» := Id.run do
  let s := t.«исх»
  let «строкаТ» := t.«первая» "теорема «"
  let «начало» := «номерПосле» «строкаТ» "строка "
  let «где» := «номерПосле» «заг» "строка "
  let mut r : «Суд» := {}
  r := r.«и» («судитьРазметку» t «начало»)
  r := r.«и» («судитьСнятиеГипотез» t)
  r := r.«и» («судитьЦель» t «где»)
  r := r.«и» («судитьИмена» t)
  r := r.«и» («судитьЧислоШагов» t)
  let «цель» := t.«цельСтроки»
  let a := t.«судитьШаги» «цель»
  r := r.«и» a.«суд»
  r := r.«и» («судитьЗакрытие» t)
  let mut «закон» := a.«закон»
  let mut «тело» := a.«тело»
  if t.«вердикт» = "доказано" && t.«первая» "вывод " ≠ "" && !«закон».isEmpty then
    let q := ({} : «Суд»).«выводом» t.«имяТ» ("утверждение " ++ «заг») ((t.«обр».drop 1).filter (· ≠ "")) «строки» «опр» s t.«доказанные»
    r := r.«и» q
    if q.«беды».isEmpty && q.«непонято».isEmpty then «закон» := []
  let pr := t.«первая» "принцип тип "
  let d := s.«доводы» t.«чья»
  let o0 : «Обст» := { «исх» := s }
  let o := { o0 with «свои» := t.«обр», «цель» := «т» «цель», «функция» := t.«чья» }
  let o := { o with «по» := (if pr ≠ "" then «ёлочка» pr 2 else «ёлочка» (t.«первая» "дано «") 1), «тип» := «ёлочка» pr 1 }
  let o := { o with «хвост» := d.«хвост», «обяз» := t.«имя», «доказанные» := t.«доказанные», «объявленные» := t.«объявленные» }
  let o := { o with «ограничения» := s.«ограничения» t.«место» }
  let p := «проигратьБлок» o
  r := r.«еслиНе» p.«беды».isEmpty s!"теорема «{t.«имяТ»}», сведение: {"; ".intercalate p.«беды»}"
  for x in p.«неВзялся» do r := r.«слово» s!"теорема «{t.«имяТ»}», сведение: {x}"
  let m : «Место» := { «свои» := t.«обр», «имя» := t.«имяТ», «чья» := t.«чья», «цель» := «цель»,
                       «высказывание» := if t.«гв» ≠ 0 then some t.«место» else none,
                       «доказанные» := t.«доказанные», «объявленные» := t.«объявленные» }
  let mut «проигран» := false
  if t.«вердикт» = "доказано" then
    match «проигратьУзел» t.«счёт» m with
    | .«проигран» _ => «проигран» := true
    | .«ложь» bs => for b in bs do r := r.«беда» b
    | _ => pure ()
  if «проигран» then «тело» := []
  r := r.«и» («судитьПосылки» s t.«обр» t.«имяТ» t.«чья» t.«вердикт» t.«место» s!"теорема «{t.«имяТ»}»" «проигран» true)
  for x in «закон» ++ «тело» do r := r.«слово» x
  return r

end «Второй»
