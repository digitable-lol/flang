import Paths

open «Разбор»

namespace «Второй»

/-!
# Ответ «ПРОВЕРЕНО» второго сверщика — о записи целиком

`Paths.lean` судит теоремой каждый путь приёмки врозь: «если путь принял, то …». Здесь
пути собраны под ответ программы: если `«исход» («сверить» …)` дал код 0, то принят
каждый суд записи (`«Нарезка».«суды»`), и к каждому приложена теорема его пути.

Что доказано выводом — решение сверщика: какие суды обязаны быть приняты, чтобы
программа ответила «ПРОВЕРЕНО», и что из принятого суда следует. Что стоит вне теоремы
и названо доверенной базой (`docs/flang/proof/checker/trusted-base.md`):

- нарезка текста записи и исходника (`«нарезать»`, `«исходник»`, чтение формул
  `RecordReader.lean`): что они читают текст так, как его понимает язык, — сверка на
  корпусе;
- `main`: чтение файлов, UTF-8, печать ответа и код выхода;
- SHA-256 (`«sha256»`): сверен с опорными значениями, не доказан;
- печать Lean в C и сборка `leanc`;
- пути без модели — строки «нет модели» таблицы
  `flang/proof/tables/lean-soundness-debt.tsv`: их приёмка названа в заключении
  теоремы «проверено-утверждения» как есть, без истинности цели.
-/

/-- Ответ второго сверщика на записи `«зап»` об исходнике `«исх»` — «ПРОВЕРЕНО», код 0. -/
def «Проверено» («исх» «путь» «зап» «каталог» : String) : Prop :=
  («исход» («сверить» «исх» «путь» «зап» «каталог»)).2 = 0

/-- Код 0 программа даёт только итогу без бед, без непонятого, без мест на слове и с
    криптографической привязкой; и либо утверждений нет, а секции есть, либо хоть одно
    доказано. -/
theorem «исход-ноль» (r : «Итог») (h : («исход» r).2 = 0) :
    r.«беды» = [] ∧ r.«непонято» = [] ∧ r.«крипто» = true ∧ r.«наСлово» = [] ∧
    ((r.«утверждений» = 0 ∧ r.«секций» > 0) ∨ r.«доказанных» ≠ 0) := by
  unfold «исход» at h
  split at h
  · exact absurd (show (1 : UInt32) = 0 from h) (by decide)
  · rename_i h1
    split at h
    · exact absurd (show (4 : UInt32) = 0 from h) (by decide)
    · rename_i h2
      split at h
      · exact absurd (show (3 : UInt32) = 0 from h) (by decide)
      · rename_i h3
        split at h
        · exact absurd (show (3 : UInt32) = 0 from h) (by decide)
        · rename_i h4
          refine ⟨by simpa using h1, by simpa using h2, by simpa using h3, by simpa using h4, ?_⟩
          split at h
          · rename_i h5
            exact Or.inl (by simpa using h5)
          · split at h
            · exact absurd (show (3 : UInt32) = 0 from h) (by decide)
            · rename_i h6
              exact Or.inr (by simpa using h6)

/-- **Проверено — принят каждый суд записи.** Беды, непонятое и места на слове итога —
    склейка по списку судов; пусты все три — чист каждый суд. -/
theorem «суды-чисты» («исх» «путь» «зап» «каталог» : String) (h : «Проверено» «исх» «путь» «зап» «каталог») :
    ∀ q ∈ («нарезать» «исх» «зап»).«суды» «исх» «путь» «зап» «каталог», q.«чист» := by
  obtain ⟨hb, hn, _, hw, _⟩ := «исход-ноль» _ h
  simp only [«сверить», List.flatMap_eq_nil_iff] at hb hn hw
  exact fun q hq => ⟨hb q hq, hn q hq, hw q hq⟩

/-- Привязка криптографическая: в шапке есть строка «отпечаток256», и её отпечаток —
    SHA-256 байтов исходника, с которым запись сверяют. -/
theorem «крипто-строкой» («н» : «Нарезка») («исх» : String) (h : «н».«крипто» «исх» = true) :
    ∃ l ∈ «н».«шапка», l.startsWith "отпечаток256 " = true ∧ (l.splitOn " ").getD 1 "" = «sha256» «исх».toUTF8 := by
  unfold «Нарезка».«крипто» at h
  split at h
  · rename_i l hl
    exact ⟨l, List.mem_of_find?_eq_some hl, by simpa using List.find?_some hl, by simpa using h⟩
  · exact absurd h (by decide)

/-- **Проверено — по частям.** Если второй сверщик ответил «ПРОВЕРЕНО», то для нарезки
    `«н»` записи: привязка к исходнику криптографическая; беды привязки и полноты нет;
    приняты планы, тотальности, шапка, каждое утверждение записи (с итоговым реестром),
    круги ссылок, места строк и снятия; у каждой категорной теоремы бед нет, и набор их
    полон. -/
theorem «проверено-по-частям» («исх» «путь» «зап» «каталог» : String)
    (h : «Проверено» «исх» «путь» «зап» «каталог») («н» : «Нарезка») (hn : «н» = «нарезать» «исх» «зап») :
    «н».«крипто» «исх» = true ∧
    «н».«бедыПривязки» «исх» «путь» «зап» «каталог» = [] ∧
    («судитьПланы» («исходник» «исх»).«сМногострочными» «н».«планы»).«чист» ∧
    («судитьТотальности» («исходник» ("\n".intercalate «н».«строкиП»)).«сМногострочными»
      ((«н».«шапка».find? (·.startsWith "тотальностей ")).bind (fun l => «целое?» (l.«сн» 13))) «н».«тсобств»).«чист» ∧
    («судитьШапку» («исходник» «исх»).«сМногострочными» «н».«шапка»).«чист» ∧
    (∀ b ∈ «н».«блоки», («судитьУтверждение» («н».«контекст» «н».«реестр») b).«чист») ∧
    («кругиЗаписи» («н».«блоки».map (·.splitOn "\n"))).«чист» ∧
    («судитьМеста» «зап»).«чист» ∧
    («судитьСнятия» «н».«исхМ» «н».«строкиП» «н».«опр» «правилаЯдра» «н».«реестр» «н».«объявл» «н».«снятия»).«чист» ∧
    (∀ b ∈ «н».«кблоки», («Категории».«судить» «н».«кисх» b).«беды» = []) ∧
    «Категории».«полнота» «н».«кисх» «н».«кблоки» = [] := by
  subst hn
  have hs := «суды-чисты» «исх» «путь» «зап» «каталог» h
  have hk : («нарезать» «исх» «зап»).«крипто» «исх» = true := («исход-ноль» _ h).2.2.1
  generalize «нарезать» «исх» «зап» = «н» at hs hk ⊢
  have hin : ∀ q : «Суд»,
      (q = «судитьПланы» («исходник» «исх»).«сМногострочными» «н».«планы» ∨
       q = «судитьТотальности» («исходник» ("\n".intercalate «н».«строкиП»)).«сМногострочными»
          ((«н».«шапка».find? (·.startsWith "тотальностей ")).bind (fun l => «целое?» (l.«сн» 13))) «н».«тсобств» ∨
       q = «судитьШапку» («исходник» «исх»).«сМногострочными» «н».«шапка» ∨
       q = { «беды» := «н».«бедыПривязки» «исх» «путь» «зап» «каталог» } ∨
       (∃ b ∈ «н».«блоки», «судитьУтверждение» («н».«контекст» «н».«реестр») b = q) ∨
       q = «кругиЗаписи» («н».«блоки».map (·.splitOn "\n")) ∨
       q = «судитьМеста» «зап» ∨
       q = «судитьСнятия» «н».«исхМ» «н».«строкиП» «н».«опр» «правилаЯдра» «н».«реестр» «н».«объявл» «н».«снятия» ∨
       (∃ b ∈ «н».«кблоки», ({ «беды» := («Категории».«судить» «н».«кисх» b).«беды» } : «Суд») = q) ∨
       q = { «беды» := «Категории».«полнота» «н».«кисх» «н».«кблоки» }) →
      q ∈ «н».«суды» «исх» «путь» «зап» «каталог» := by
    intro q hq
    simp only [«Нарезка».«суды», List.mem_append, List.mem_cons, List.mem_map, List.not_mem_nil, or_false]
    rcases hq with h | h | h | h | h | h | h | h | h | h
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inl h))))
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inr (Or.inr (Or.inl h))))))
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h))))))))
    · exact Or.inl (Or.inl (Or.inl (Or.inr h)))
    · exact Or.inl (Or.inl (Or.inr (Or.inl h)))
    · exact Or.inl (Or.inl (Or.inr (Or.inr (Or.inl h))))
    · exact Or.inl (Or.inl (Or.inr (Or.inr (Or.inr h))))
    · exact Or.inl (Or.inr h)
    · exact Or.inr h
  refine ⟨hk, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (hs { «беды» := «н».«бедыПривязки» «исх» «путь» «зап» «каталог» }
      (hin _ (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))).1
  · exact hs _ (hin _ (Or.inl rfl))
  · exact hs _ (hin _ (Or.inr (Or.inl rfl)))
  · exact hs _ (hin _ (Or.inr (Or.inr (Or.inl rfl))))
  · exact fun b hb => hs _ (hin _ (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨b, hb, rfl⟩))))))
  · exact hs _ (hin _ (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))))
  · exact hs _ (hin _ (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))))))
  · exact hs _ (hin _ (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))))))
  · exact fun b hb => (hs { «беды» := («Категории».«судить» «н».«кисх» b).«беды» }
      (hin _ (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨b, hb, rfl⟩))))))))))).1
  · exact (hs { «беды» := «Категории».«полнота» «н».«кисх» «н».«кблоки» }
      (hin _ (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))))))))).1

/-- **Проверено — запись от этой программы и обо всей программе.** Строк и знаков в
    шапке столько, сколько в исходнике; строка «отпечаток256» шапки несёт SHA-256
    байтов исходника; утверждений в записи столько, сколько обещает шапка и сколько в
    исходнике постусловий и высказываний вместе; ни об одной теореме исходника запись
    не молчит. -/
theorem «проверено-привязка» («исх» «путь» «зап» «каталог» : String)
    (h : «Проверено» «исх» «путь» «зап» «каталог») («н» : «Нарезка») (hn : «н» = «нарезать» «исх» «зап») :
    (∃ l ∈ «н».«шапка», l.startsWith "отпечаток256 " = true ∧ (l.splitOn " ").getD 1 "" = «sha256» «исх».toUTF8) ∧
    «номерПослеМ» («часть» «н».«шапка» 3) "строк " = some «н».«строки».length ∧
    «номерПослеМ» («часть» «н».«шапка» 4) "знаков " = some «исх».length ∧
    «номерПослеМ» («часть» «н».«шапка» 7) "утверждений " = some «н».«блоки».length ∧
    «н».«замолчано» = [] ∧
    «н».«постусловий» + «н».«высказываний» = «н».«блоки».length := by
  obtain ⟨hk, hb, _⟩ := «проверено-по-частям» «исх» «путь» «зап» «каталог» h «н» hn
  refine ⟨«крипто-строкой» _ _ hk, ?_⟩
  simp only [«Нарезка».«бедыПривязки», List.append_eq_nil_iff, «если-пусто»] at hb
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨_, h3⟩, h4⟩, _⟩, _⟩, _⟩, _⟩, h7⟩, _⟩, _⟩, hz⟩, hp⟩ := hb
  exact ⟨of_decide_eq_true h3, of_decide_eq_true h4, of_decide_eq_true h7, List.isEmpty_iff.mp hz,
    of_decide_eq_true hp⟩

/-- **Проверено — шапка, оглавление и планы по исходнику.** Каждая строка шапки — по
    форме печати; оглавление таблиц — ровно таблицы исходника; каждый блок плана принят
    путём `«судитьПлан»` (теорема «план-по-исходнику»: план выдаёт только разрешённое). -/
theorem «проверено-шапка-и-планы» («исх» «путь» «зап» «каталог» : String)
    (h : «Проверено» «исх» «путь» «зап» «каталог») («н» : «Нарезка») (hn : «н» = «нарезать» «исх» «зап») :
    let s := («исходник» «исх»).«сМногострочными»
    (∀ l ∈ «н».«шапка», «формаШапки?» («обрезать» l) = true) ∧
    (let «стр» := («н».«шапка».map «обрезать»).filter (·.startsWith "таблица «")
     (∀ t ∈ «таблицыИсходника» s, «строкаТаблицы» t ∈ «стр») ∧
     (∀ l ∈ «стр», ∃ t ∈ «таблицыИсходника» s, l = «строкаТаблицы» t)) ∧
    (∀ b ∈ «н».«планы», («судитьПлан» s s.«хозяева» b).«чист») := by
  intro s
  obtain ⟨_, _, hp, _, hh, _⟩ := «проверено-по-частям» «исх» «путь» «зап» «каталог» h «н» hn
  obtain ⟨h1, h2⟩ := «шапка-по-исходнику» s «н».«шапка» hh
  exact ⟨h1, h2, «планы-по-исходнику» s «н».«планы» hp⟩

/-- **Проверено — тотальности по блокам и по рангу.** Каждый разобранный блок
    тотальности принят путём `«судитьБлок»`, и у каждой функции с блоком считается ранг
    зовов; при двух посылках о языке теоремы «тотальность-фундирована» зовы между
    функциями с блоками фундированы. -/
theorem «проверено-тотальности» («исх» «путь» «зап» «каталог» : String)
    (h : «Проверено» «исх» «путь» «зап» «каталог») («н» : «Нарезка») (hn : «н» = «нарезать» «исх» «зап») :
    let s := («исходник» ("\n".intercalate «н».«строкиП»)).«сМногострочными»
    let «все» := «н».«тсобств».filterMap «разобратьБлок»
    (∀ t ∈ «все», («судитьБлок» s «все» t).«чист») ∧
    (∀ t ∈ «все», («ранг» «все» («все».length + 1) t.«имя»).isSome) ∧
    ∀ {α : Type} («зов» : String × α → String × α → Prop) (μ : α → Nat),
      (∀ g b f a, «зов» (g, b) (f, a) → ∃ i, (g, i) ∈ s.«зовы» f) →
      (∀ f a b, «зов» (f, b) (f, a) → (∀ t ∈ «все», t.«имя» = f → «убывающийБлок» s t) → μ b < μ a) →
      WellFounded (fun (q p : String × α) =>
        «зов» q p ∧ «все».any (·.«имя» = q.1) = true ∧ «все».any (·.«имя» = p.1) = true) := by
  intro s «все»
  obtain ⟨_, _, _, ht, _⟩ := «проверено-по-частям» «исх» «путь» «зап» «каталог» h «н» hn
  obtain ⟨h1, h2⟩ := «тотальности-по-блокам» s _ «н».«тсобств» ht
  exact ⟨h1, h2, fun «зов» μ hcall hmeasure => «тотальность-фундирована» s _ «н».«тсобств» ht «зов» μ hcall hmeasure⟩

/-- Истинность цели блока `вывод` в модели: читатель прочёл утверждение, и либо приёмка
    модели приняла блок — тогда цель верна в каждом мире, где держится окружение
    (`«Судим»`), — либо принял запасной прогон по тексту (строка «прогонР» долга). -/
def «ВыводИстинен» (u : «ФормаУтв») («к» : «Контекст») : Prop :=
  ∃ v, «утверждение» ("утверждение " ++ u.«заг») ((u.«обр».drop 1).filter (· ≠ "")) «к».«строки» «к».«опр»
      («постусловия» «к».«строки» «к».«доказанные») = .ok v ∧
    ((«Принят» v ∧ «Судим» («окружение» v) («Факт-из» v.«цель»)) ∨
     («принят?» v = false ∧ ∃ w, v.«вывод» = some w ∧ ∃ «итог», «прогонР» «к».«исх» «к».«доказанные» v w.«шаги» [] = .ok «итог»))

theorem «вывод-истинен» (u : «ФормаУтв») («к» : «Контекст») (hc : (u.«выводСуд» «к»).«чист») :
    «ВыводИстинен» u «к» :=
  «выводом-по-модели» {} u.«имя» _ _ «к».«строки» «к».«опр» «к».«исх» «к».«доказанные» ⟨hc.1, hc.2.1⟩

/-- **Проверено — каждое доказанное утверждение принято названным путём.** Для
    каждого блока утверждения записи с вердиктом «доказано»: либо запись назвала теорему
    исходника и её принял путь `«судитьТеорему»` (теорема «теорема-по-частям»), либо
    приняты обязательства входа и посылки и принял один из путей решения. Путь блоком
    `вывод` несёт истинность цели в модели (`«ВыводИстинен»`); остальные пути названы
    своей приёмкой — их модель в таблице долга. -/
theorem «проверено-утверждения» («исх» «путь» «зап» «каталог» : String)
    (h : «Проверено» «исх» «путь» «зап» «каталог») («н» : «Нарезка») (hn : «н» = «нарезать» «исх» «зап»)
    («к» : «Контекст») (hctx : «к» = «н».«контекст» «н».«реестр») :
    ∀ b ∈ «н».«блоки»,
      let u := («формаУтверждения» «к» b).1
      let o := «судитьОбязательства» «к».«исх» «к».«строки» u.«обр» u.«имя» u.«чья»
      u.«доказано» = true →
      (u.«есть» "теорема «" = true ∧ («судитьТеорему» (u.«теорема» «к») u.«заг» «к».«строки» «к».«опр»).«чист») ∨
      (u.«есть» "теорема «" = false ∧ o.1.«чист» ∧
        («судитьПосылки» «к».«исх» u.«обр» u.«имя» u.«чья» u.«вердикт» u.«место» s!"утверждение «{u.«имя»}»"
          («проигранДоказанного» u «к» o.2) false).«чист» ∧
        ((u.«пр» = some "правило «линейная арифметика»" ∧
           ∃ e, «линейнаяАрифметика» «к».«исх» u.«обр» u.«чья» u.«место» u.«цель0» = .ok (true, e)) ∨
         (u.«есть» "вывод " = true ∧ «ВыводИстинен» u «к» ∧ o.2 = 0) ∨
         (u.«ходамиВерх» = true ∧ («проигратьБлок» (u.«обстХодов» «к»)).«беды» = [] ∧
            («проигратьБлок» (u.«обстХодов» «к»)).«неВзялся» = [] ∧ («проигратьБлок» (u.«обстХодов» «к»)).«проиграно» > 0) ∨
         (u.«пр» = some "правило «кольцо точного целого»" ∧ «кольцоТочногоЦелого» «к».«исх» u.«обр» u.«чья» u.«цель0» = .ok ()) ∨
         (let k := «крюкиПоТелу» { «исх» := «к».«исх», «огл» := «к».«огл» } (u.«местоКрюков» «к»)
          k.«беды» = [] ∧ k.«снял» ≠ "") ∨
         (let k := «крюкиПоТелу» { «исх» := «к».«исх», «огл» := «к».«огл» } (u.«местоКрюков» «к»)
          k.«беды» = [] ∧ u.«ходамиСписка» «к» = true))) := by
  subst hctx
  intro b hb u o hd
  obtain ⟨_, _, _, _, _, hu, _⟩ := «проверено-по-частям» «исх» «путь» «зап» «каталог» h «н» hn
  rcases «утверждение-по-путям» _ b (hu b hb) hd with ht | ⟨ht, ho, hp, hr⟩
  · exact Or.inl ht
  · refine Or.inr ⟨ht, ho, hp, ?_⟩
    rcases hr with hl | hv | hrest
    · exact Or.inl hl
    · exact Or.inr (Or.inl ⟨hv.1, «вывод-истинен» _ _ hv.2.1, hv.2.2⟩)
    · exact Or.inr (Or.inr hrest)

/-- **Проверено — ни одно место не взято на слово.** Утверждений в итоге столько,
    сколько блоков утверждений и категорных теорем в записи; мест на слове нет; и либо
    доказано хоть одно утверждение, либо утверждений нет вовсе, а секции есть. -/
theorem «проверено-счёт» («исх» «путь» «зап» «каталог» : String)
    (h : «Проверено» «исх» «путь» «зап» «каталог») («н» : «Нарезка») (hn : «н» = «нарезать» «исх» «зап») :
    («сверить» «исх» «путь» «зап» «каталог»).«утверждений» = «н».«блоки».length + «н».«кблоки».length ∧
    («сверить» «исх» «путь» «зап» «каталог»).«наСлово» = [] ∧
    (((«сверить» «исх» «путь» «зап» «каталог»).«утверждений» = 0 ∧ «н».«планы».length + «н».«тблоки».length > 0) ∨
      («сверить» «исх» «путь» «зап» «каталог»).«доказанных» ≠ 0) := by
  subst hn
  obtain ⟨_, _, _, hw, hcount⟩ := «исход-ноль» _ h
  exact ⟨rfl, hw, hcount⟩

/-- **Проверено — места строк и снятия.** Каждая строка записи с местом по описанию
    формата стоит на своём месте; если блоки снятия есть, каждый принят путём
    `«судитьСнятие»` (теорема «снятие-по-модели-или-ходам»), место не записано дважды, и
    блоков с требованием столько, сколько мест вызова под «требует» в исходнике. -/
theorem «проверено-места-и-снятия» («исх» «путь» «зап» «каталог» : String)
    (h : «Проверено» «исх» «путь» «зап» «каталог») («н» : «Нарезка») (hn : «н» = «нарезать» «исх» «зап») :
    (let v := («зап».splitOn "\n").map «обрезать»
     ∀ i < v.length, ∀ pm ∈ «местаСтрок», (v.getD i "").startsWith pm.1 = true →
       i > 0 ∧ pm.2.any ((v.getD (i - 1) "").startsWith ·) = true) ∧
    («н».«снятия» ≠ [] →
      (∀ b ∈ «н».«снятия», («судитьСнятие» «н».«исхМ» «н».«исхМ».«хозяева» «н».«строкиП» «н».«опр» «правилаЯдра»
        «н».«реестр» «н».«объявл» b).«чист») ∧
      ((«н».«снятия».map «прочестьСнятие»).map «ключСнятия»).Nodup ∧
      «местСнятия» «н».«исхМ» = «снятийСТребованием» «н».«исхМ» («н».«снятия».map «прочестьСнятие»)) := by
  obtain ⟨_, _, _, _, _, _, _, hm, hs, _⟩ := «проверено-по-частям» «исх» «путь» «зап» «каталог» h «н» hn
  exact ⟨«места-по-форме» «зап» hm, fun hne => «снятия-полны» _ _ _ _ _ _ _ hne hs⟩

/-! ## Реестр доказанного: круга нет -/

theorem «принял-чист» {q : «Суд»} (h : q.«принял?» = true) : q.«чист» := by
  simp only [«Суд».«принял?», Bool.and_eq_true, List.isEmpty_iff] at h
  exact ⟨h.1.1, h.1.2, h.2⟩

/-- Свойство, которое шаг роста сохраняет, держится и на выросшем реестре. -/
theorem «нарастить-сохраняет» (f : List String → List String) (P : List String → Prop)
    (hstep : ∀ r, P r → P (r ++ f r)) : ∀ (n : Nat) (r : List String), P r → P («нарастить» f n r)
  | 0, _, h => h
  | n + 1, r, h => by
    simp only [«нарастить»]
    split
    · exact h
    · exact «нарастить-сохраняет» f P hstep n _ (hstep r h)

/-- **Реестр обоснован, и круга в нём нет.** Каждое имя реестра — имя блока записи с
    вердиктом «доказано», принятого судом с реестром-началом, в котором этого имени ещё
    не было. Утверждение не может попасть в реестр, сославшись на себя: суд, который его
    принял, видел только то, что вошло в реестр раньше. -/
theorem «реестр-обоснован» («н» : «Нарезка») :
    ∀ x ∈ «н».«реестр», ∃ r, r <+: «н».«реестр» ∧ x ∉ r ∧
      ∃ b ∈ «н».«блоки», «имяБлока» b = x ∧ «вердиктБлока» b = "доказано" ∧
        («судитьУтверждение» («н».«контекст» r) b).«чист» := by
  refine «нарастить-сохраняет» «н».«новыеВРеестр»
    (fun q => ∀ x ∈ q, ∃ r, r <+: q ∧ x ∉ r ∧
      ∃ b ∈ «н».«блоки», «имяБлока» b = x ∧ «вердиктБлока» b = "доказано" ∧
        («судитьУтверждение» («н».«контекст» r) b).«чист») ?_ _ [] (by simp)
  intro q hq x hx
  rcases List.mem_append.mp hx with h | h
  · obtain ⟨r, hr, rest⟩ := hq x h
    exact ⟨r, hr.trans (List.prefix_append _ _), rest⟩
  · unfold «Нарезка».«новыеВРеестр» at h
    obtain ⟨b, hb, rfl⟩ := List.mem_map.mp h
    obtain ⟨hbm, hc⟩ := List.mem_filter.mp hb
    simp only [Bool.and_eq_true] at hc
    refine ⟨q, List.prefix_append _ _, ?_, b, hbm, rfl, of_decide_eq_true hc.1.2, «принял-чист» hc.2⟩
    intro hin
    have hno := hc.1.1
    rw [List.contains_iff_mem.mpr hin] at hno
    exact absurd hno (by decide)

