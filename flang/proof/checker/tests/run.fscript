  принимает key: строка, work: строка
  возвращает строка
  пример «Every run of the checker keeps its output in its own file»
    дано key равно "p7"
    дано work равно "/w"
    ожидается "/w/p7.out"
  соединить [work, "/", key, ".out"] по ""

тотальная функция «Pattern of»
  принимает gauge: строка
  возвращает строка
  пример «The pattern that finds the count of places on the word of the kernel»
    дано gauge равно "word"
    ожидается "НА СЛОВО ЯДРА: посылок и утверждений [0-9]*"
  разбор gauge
    случай "steps"
      то "посылок и утверждений [0-9]*, шагов [0-9]*"
    случай любое
      то соединить [(«Mark of» от gauge), "[0-9]*"] по ""

тотальная функция «Gauges»
  принимает probe: «Probe», ground: «Ground»
  возвращает список строки
  пример «A probe others refer to reads every number»
    дано probe равно запись «Probe» с «index» равным 7 и «kind» равным "C" и «name» равным "а" и «source» равным "a.flang" и «record» равным "a.record" и «source edit» равным "-" и «record edit» равным "-" и «leading» равным пустой список и «trailing» равным "-" и «code» равным "0" и «reason» равным "-" и «absent» равным "-" и «measure» равным "-" и «forged» равным ""
    дано ground равно запись «Ground» с «units» равным пустой список и «forges» равным пустой список и «checker» равным "c" и «work» равным "/w" и «entries» равным пустой список и «heads» равным "" и «referenced» равным ["а"]
    ожидается ["word", "steps", "proved", "moves", "facts"]
  пример «A probe reads the numbers its measures name»
    дано probe равно запись «Probe» с «index» равным 7 и «kind» равным "C" и «name» равным "б" и «source» равным "a.flang" и «record» равным "a.record" и «source edit» равным "-" и «record edit» равным "-" и «leading» равным пустой список и «trailing» равным "-" и «code» равным "0" и «reason» равным "-" и «absent» равным "-" и «measure» равным "facts=2 ⋯ word=0" и «forged» равным ""
    дано ground равно запись «Ground» с «units» равным пустой список и «forges» равным пустой список и «checker» равным "c" и «work» равным "/w" и «entries» равным пустой список и «heads» равным "" и «referenced» равным пустой список
    ожидается ["facts", "word"]
  если (длина (отфильтровать (ground.«referenced») где name → name равен (probe.«name»))) больше 0
    то ["word", "steps", "proved", "moves", "facts"]
    иначе если (probe.«measure») равен "-"
      то пустой список
      иначе отфильтровать (отобразить (разделить (probe.«measure») по " ⋯ ") как spec → «Cell» от 1 и («Halves» от spec)) где gauge → не (gauge равен "output")

тотальная функция «Digest lines»
  принимает probe: «Probe», ground: «Ground»
  возвращает список строки
  пример «A forgery with a reason keeps the reason, the unread mark and nothing else»
    дано probe равно запись «Probe» с «index» равным 7 и «kind» равным "P" и «name» равным "б" и «source» равным "a.flang" и «record» равным "a.record" и «source edit» равным "-" и «record edit» равным "-" и «leading» равным пустой список и «trailing» равным "-" и «code» равным "1" и «reason» равным "нет терма" и «absent» равным "-" и «measure» равным "-" и «forged» равным ""
    дано ground равно запись «Ground» с «units» равным пустой список и «forges» равным пустой список и «checker» равным "c" и «work» равным "/w" и «entries» равным пустой список и «heads» равным "" и «referenced» равным пустой список
    ожидается ["'grep' '-o' '-F' '-e' 'нет терма' '/w/p7.out' | head -n 1", "'grep' '-o' '-F' '-e' 'не узнана' '/w/p7.out' | head -n 1"]
  пусть output равно («Quoted» от («Output file» от («Key» от probe) и (ground.«work»)))
  пусть parts равно (если (probe.«reason») равен "-" то (пустой список) иначе (разделить (probe.«reason») по " ⋯ "))
  «Gathered words» от [(отобразить parts как part → соединить [(«Command» от ["grep", "-o", "-F", "-e", part]), " ", output, " | head -n 1"] по ""),
    (если ((probe.«kind») равен "P") и притом (((probe.«code») равен "1") и притом ((длина parts) больше 0)) то [(соединить [(«Command» от ["grep", "-o", "-F", "-e", "не узнана"]), " ", output, " | head -n 1"] по "")] иначе пустой список),
    (если (probe.«absent») равен "-" то (пустой список) иначе [(соединить [(«Command» от ["grep", "-o", "-F", "-e", (probe.«absent»)]), " ", output, " | head -n 1"] по "")]),
    (отобразить («Gauges» от probe и ground) как gauge → соединить [(«Command» от ["grep", "-o", "-e", («Pattern of» от gauge)]), " ", output, " | tail -n 1"] по ""),
    (отобразить (отфильтровать (разделить (probe.«measure») по " ⋯ ") где spec → («Cell» от 1 и («Halves» от spec)) равен "output") как spec → соединить [(«Command» от ["cmp", "-s", («Output file» от («Same key» от (подстрока («Cell» от 2 и («Halves» от spec)) с 2 по (длина («Cell» от 2 и («Halves» от spec)))) и ground) и (ground.«work»)), («Output file» от («Key» от probe) и (ground.«work»))]), "; ", («Marker» от "same" и "\"$?\"")] по "")]

тотальная функция «Same key»
  принимает name: строка, ground: «Ground»
  возвращает строка
  пример «A name nobody carries has no key»
    дано name равно "а"
    дано ground равно запись «Ground» с «units» равным пустой список и «forges» равным пустой список и «checker» равным "c" и «work» равным "/w" и «entries» равным пустой список и «heads» равным "" и «referenced» равным пустой список
    ожидается ""
  соединить (отобразить (отфильтровать (ground.«units») где probe → (probe.«name») равен name) как probe → «Key» от probe) по ""

тотальная функция «Check lines»
  принимает probe: «Probe», ground: «Ground»
  возвращает список строки
  пример «A heading runs nothing»
    дано probe равно запись «Probe» с «index» равным 1 и «kind» равным "say" и «name» равным "а" и «source» равным "-" и «record» равным "-" и «source edit» равным "-" и «record edit» равным "-" и «leading» равным пустой список и «trailing» равным "-" и «code» равным "-" и «reason» равным "-" и «absent» равным "-" и «measure» равным "-" и «forged» равным ""
    дано ground равно запись «Ground» с «units» равным пустой список и «forges» равным пустой список и «checker» равным "c" и «work» равным "/w" и «entries» равным пустой список и «heads» равным "" и «referenced» равным пустой список
    ожидается пустой список
  пример «A line of the checker source is looked for»
    дано probe равно запись «Probe» с «index» равным 2 и «kind» равным "S" и «name» равным "приём" и «source» равным "-" и «record» равным "-" и «source edit» равным "-" и «record edit» равным "-" и «leading» равным пустой список и «trailing» равным "-" и «code» равным "-" и «reason» равным "строго" и «absent» равным "-" и «measure» равным "-" и «forged» равным ""
    дано ground равно запись «Ground» с «units» равным пустой список и «forges» равным пустой список и «checker» равным "c" и «work» равным "/w" и «entries» равным пустой список и «heads» равным "" и «referenced» равным пустой список
    ожидается ["printf '\\036 unit %s\\n' 'p2'", "'grep' '-q' '-F' '-e' 'строго' 'flang/proof/checker/checker.c'", "printf '\\n\\036 code %s\\n' \"$?\""]
  пусть key равно («Key» от probe)
  пусть said равно («Forged said» от probe и (ground.«forges»))
  пусть checker равно (ground.«checker»)
  разбор (probe.«kind»)
    случай "S"
      то [(«Unit header» от key), («Command» от ["grep", "-q", "-F", "-e", (probe.«reason»), "flang/proof/checker/checker.c"]), («Unit footer» от "\"$?\"")]
    случай "corpus record"
      то [(«Unit header» от key), (соединить [(«Command» от [checker, («Value after» от (соединить [(probe.«record»), ":исходник "] по "") и (ground.«heads»)), (probe.«record»)]), " > ", («Quoted» от («Output file» от key и (ground.«work»))), " 2>&1"] по ""), («Unit footer» от "\"$?\"")]
    случай "manifest"
      то «Соединить списки» от (приписать («Unit header» от key) к («Gathered words» от (отобразить (ground.«entries») как entry → [(«Command» от ["test", "-f", (entry.«source»)]), («Marker» от (соединить ["has-source-", (entry.«file»)] по "") и "\"$?\""), («Command» от ["test", "-f", (entry.«record»)]), («Marker» от (соединить ["has-record-", (entry.«file»)] по "") и "\"$?\"")]))) и [(«Unit footer» от "0")]
    случай любое
      то если («Runs the checker» от probe) и притом («Built» от probe и said)
        то «Соединить списки» от [(«Unit header» от key), (соединить [(«Command» от (приписать checker к («Checker arguments» от probe и (ground.«work») и said))), " > ", («Quoted» от («Output file» от key и (ground.«work»))), " 2>&1; code=$?"] по "")] и («Соединить списки» от («Digest lines» от probe и ground) и [(«Unit footer» от "\"$code\"")])
        иначе пустой список

