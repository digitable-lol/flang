модуль «Таблицы типов FTS»

объект «Перевод»
  «что»: список строки
  «чем»: список строки

тотальная функция «Слово имён списка»
  принимает «тексты»: список строки
  возвращает строка
  соединить «тексты» по " "

тотальная функция «Перевод слова»
  принимает «текст»: строка, «таблица»: список «Перевод»
  возвращает строка
  свёртка «таблица» начиная с "" как «акк» и «перевод»
    если (длина «акк») больше 0
      то «акк»
      иначе
        если («Слово имён списка» от («перевод».«что»)) равен «текст»
          то «Слово имён списка» от («перевод».«чем»)
          иначе «акк»

тотальная функция «Типы полей»
  возвращает список «Перевод»
  обеспечивает «у перевода непусты обе стороны» (свёртка результат начиная с да как акк и «перевод» → если акк то (((длина («перевод».«что»)) больше 0) и притом ((длина («перевод».«чем»)) больше 0)) иначе нет) равен да
  пример «шесть русских слов в четыре имени типа»
    ожидается [(запись «Перевод» с «что» равным ["строкой"] и «чем» равным ["Строка"]), (запись «Перевод» с «что» равным ["текстом"] и «чем» равным ["Строка"]), (запись «Перевод» с «что» равным ["числом"] и «чем» равным ["Число"]), (запись «Перевод» с «что» равным ["датой"] и «чем» равным ["Дата"]), (запись «Перевод» с «что» равным ["деньгами"] и «чем» равным ["Деньги"]), (запись «Перевод» с «что» равным ["признаком"] и «чем» равным ["Признак"])]
  [
    (запись «Перевод» с «что» равным ["строкой"] и «чем» равным ["Строка"]),
    (запись «Перевод» с «что» равным ["текстом"] и «чем» равным ["Строка"]),
    (запись «Перевод» с «что» равным ["числом"] и «чем» равным ["Число"]),
    (запись «Перевод» с «что» равным ["датой"] и «чем» равным ["Дата"]),
    (запись «Перевод» с «что» равным ["деньгами"] и «чем» равным ["Деньги"]),
    (запись «Перевод» с «что» равным ["признаком"] и «чем» равным ["Признак"])
  ]

тотальная функция «Английские типы полей»
  возвращает список «Перевод»
  обеспечивает «английский тип поля ведёт в известное слово» (свёртка результат начиная с да как акк и «перевод» → если акк то ((длина («Перевод слова» от («Слово имён списка» от («перевод».«чем»)) и («Типы полей»))) больше 0) иначе нет) равен да
  пример «пять базовых типов по-английски»
    ожидается [(запись «Перевод» с «что» равным ["string"] и «чем» равным ["строкой"]), (запись «Перевод» с «что» равным ["number"] и «чем» равным ["числом"]), (запись «Перевод» с «что» равным ["date"] и «чем» равным ["датой"]), (запись «Перевод» с «что» равным ["money"] и «чем» равным ["деньгами"]), (запись «Перевод» с «что» равным ["boolean"] и «чем» равным ["признаком"])]
  [
    (запись «Перевод» с «что» равным ["string"] и «чем» равным ["строкой"]),
    (запись «Перевод» с «что» равным ["number"] и «чем» равным ["числом"]),
    (запись «Перевод» с «что» равным ["date"] и «чем» равным ["датой"]),
    (запись «Перевод» с «что» равным ["money"] и «чем» равным ["деньгами"]),
    (запись «Перевод» с «что» равным ["boolean"] и «чем» равным ["признаком"])
  ]

тотальная функция «Английские типы результата»
  возвращает список «Перевод»
  обеспечивает «английские таблицы поля и возврата одной длины» (длина результат) равен (длина («Английские типы полей»))
  пример «те же пять типов в другом падеже»
    ожидается [(запись «Перевод» с «что» равным ["string"] и «чем» равным ["строку"]), (запись «Перевод» с «что» равным ["number"] и «чем» равным ["число"]), (запись «Перевод» с «что» равным ["date"] и «чем» равным ["дату"]), (запись «Перевод» с «что» равным ["money"] и «чем» равным ["деньги"]), (запись «Перевод» с «что» равным ["boolean"] и «чем» равным ["признак"])]
  [
    (запись «Перевод» с «что» равным ["string"] и «чем» равным ["строку"]),
    (запись «Перевод» с «что» равным ["number"] и «чем» равным ["число"]),
    (запись «Перевод» с «что» равным ["date"] и «чем» равным ["дату"]),
    (запись «Перевод» с «что» равным ["money"] и «чем» равным ["деньги"]),
    (запись «Перевод» с «что» равным ["boolean"] и «чем» равным ["признак"])
  ]

теорема «у перевода непусты обе стороны»
  утверждаем (свёртка результат начиная с да как акк и «перевод» → если акк то (((длина («перевод».«что»)) больше 0) и притом ((длина («перевод».«чем»)) больше 0)) иначе нет) равен да
  по примеру «шесть русских слов в четыре имени типа»
  следовательно доказано

теорема «английский тип поля ведёт в известное слово»
  утверждаем (свёртка результат начиная с да как акк и «перевод» → если акк то ((длина («Перевод слова» от («Слово имён списка» от («перевод».«чем»)) и («Типы полей»))) больше 0) иначе нет) равен да
  по примеру «пять базовых типов по-английски»
  следовательно доказано

теорема «английские таблицы поля и возврата одной длины»
  утверждаем (длина результат) равен (длина («Английские типы полей»))
  по примеру «те же пять типов в другом падеже»
  следовательно доказано
