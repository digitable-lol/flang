    ожидается [запись «Question» с «name» равным "temporary" и «order» равным (вариант «Прочитать переменную среды» с имя равным "FLANG_TMP"), запись «Question» с «name» равным "root" и «order» равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "cd ../.. && pwd"]), запись «Question» с «name» равным "source" и «order» равным (вариант «Прочитать файл» с путь равным "../../flang/proof/examples/corpus-natural.flang"), запись «Question» с «name» равным "record" и «order» равным (вариант «Прочитать файл» с путь равным "../../flang/proof/checker/tests/records/corpus/corpus-natural.record")]
  [(«Environment» от "temporary" и "FLANG_TMP"), («Run» от "root" и "sh" и ["-c", "cd ../.. && pwd"]), («Read» от "source" и (соединить [(«Root»), "/", («Source»)] по "")), («Read» от "record" и (соединить [(«Root»), "/", («Record»)] по ""))]

