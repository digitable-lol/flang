  [(«Temporary directory» от "work" и (соединить [(«Setting of» от "temporary" и "/srv/tmp" и answers), "/kernel-forgery."] по "")), («Run» от "kernel present" и "test" и ["-x", («Kernel» от answers)]), («Run» от "checker present" и "test" и ["-x", (соединить [(«Absolute root» от answers), "/flang/proof/checker/сверщик"] по "")])]

