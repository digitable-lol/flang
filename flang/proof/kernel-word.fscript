модуль «Kernel word»
  использует «Rules» из "../../scripts/rules.fscript"
  использует «Inquiry» из "../../scripts/inquiry.fscript"
  использует «Reading» из "../../scripts/reading.fscript"
  использует «Tables» из "../../scripts/tables.fscript"
  использует «Lists» только «Соединить списки»

объект «Pick»
  «waiting»: признак
  «found»: список строки

тотальная функция «Census pieces»
  возвращает список строки
  пример «The census command is kept in pieces that fit a line»
    ожидается ["cd \"$0\" || exit 2; w=\"$2\"; mkdir -p \"$w/r\" || exit 2; case \"$1\" in corpus) for z in fl",
      "ang/proof/checker/tests/records/corpus/*.record; do grep -a -m1 '^исходник ' \"$z\" | cut -d' ",
      "' -f2-; done | LC_ALL=C sort -u;; stdlib) ls flang/stdlib/*.flang;; probes) find flang/proof/p",
      "robes -name '*.flang' | LC_ALL=C sort;; *) exit 3;; esac > \"$w/list\" || exit 4; for f in fla",
      "ng/stdlib/*.flang; do printf '%s\\t%s\\n' \"$(sed -n 's/^модуль «\\(.*\\)»$/\\1/p' \"$f\" | he",
      "ad -n 1)\" \"$f\"; done > \"$w/modules\"; xargs -P \"$3\" -I{} sh -c 'k=$(printf %s \"$2\" | t",
      "r / _); ./bootstrap/flang check --proof \"$2\" --record \"$1/r/$k.record\" > /dev/null 2>&1; e",
      "cho $? > \"$1/r/$k.kernel\"' x \"$w\" {} < \"$w/list\"; while IFS= read -r f; do k=$(printf %s",
      " \"$f\" | tr / _); s=\"\"; t=\"$f\"; while [ -n \"$t\" ]; do g=${t%% *}; if [ \"$g\" = \"$t\" ",
      "]; then t=\"\"; else t=${t#* }; fi; for d in $(grep -h '^ *использует «' \"$g\" | sed 's/^ *ис",
      "пользует «\\([^»]*\\)».*/\\1/' | while IFS= read -r m; do awk -F '\\t' -v M=\"$m\" '$1==M{prin",
      "t $2}' \"$w/modules\"; done); do case \" $s $f \" in *\" $d \"*) ;; *) s=\"$s $d\"; t=\"${t:+$",
      "t }$d\";; esac; done; done; a=\"\"; for d in $s; do e=\"$w/r/$(printf %s \"$d\" | tr / _).reco",
      "rd\"; [ -s \"$e\" ] && a=\"$a --зависимость $d $e\"; done; printf '\\036 file %s\\t%s\\t%s\\n'",
      " \"$f\" \"$(cat \"$w/r/$k.kernel\" 2>/dev/null || echo -)\" \"$(echo $a | wc -w)\"; if [ -s \"",
      "$w/r/$k.record\" ]; then grep -a '^утверждение «\\|^  вердикт \\|^  правило «\\|^  посылка ' ",
      "\"$w/r/$k.record\"; printf '\\036 checker\\n'; ./flang/proof/checker/сверщик --по-утверждениям",
      " $a \"$f\" \"$w/r/$k.record\" > \"$w/r/$k.checker\" 2>&1; c=$?; grep -a '^  утверждение «' \"$",
      "w/r/$k.checker\"; printf '\\036 code %s\\n' \"$c\"; else printf '\\036 checker\\n\\036 code -",
      "\\n'; fi; done < \"$w/list\" > \"$w/census.txt\""]
  ["cd \"$0\" || exit 2; w=\"$2\"; mkdir -p \"$w/r\" || exit 2; case \"$1\" in corpus) for z in fl",
    "ang/proof/checker/tests/records/corpus/*.record; do grep -a -m1 '^исходник ' \"$z\" | cut -d' ",
    "' -f2-; done | LC_ALL=C sort -u;; stdlib) ls flang/stdlib/*.flang;; probes) find flang/proof/p",
    "robes -name '*.flang' | LC_ALL=C sort;; *) exit 3;; esac > \"$w/list\" || exit 4; for f in fla",
    "ng/stdlib/*.flang; do printf '%s\\t%s\\n' \"$(sed -n 's/^модуль «\\(.*\\)»$/\\1/p' \"$f\" | he",
    "ad -n 1)\" \"$f\"; done > \"$w/modules\"; xargs -P \"$3\" -I{} sh -c 'k=$(printf %s \"$2\" | t",
    "r / _); ./bootstrap/flang check --proof \"$2\" --record \"$1/r/$k.record\" > /dev/null 2>&1; e",
    "cho $? > \"$1/r/$k.kernel\"' x \"$w\" {} < \"$w/list\"; while IFS= read -r f; do k=$(printf %s",
    " \"$f\" | tr / _); s=\"\"; t=\"$f\"; while [ -n \"$t\" ]; do g=${t%% *}; if [ \"$g\" = \"$t\" ",
    "]; then t=\"\"; else t=${t#* }; fi; for d in $(grep -h '^ *использует «' \"$g\" | sed 's/^ *ис",
    "пользует «\\([^»]*\\)».*/\\1/' | while IFS= read -r m; do awk -F '\\t' -v M=\"$m\" '$1==M{prin",
    "t $2}' \"$w/modules\"; done); do case \" $s $f \" in *\" $d \"*) ;; *) s=\"$s $d\"; t=\"${t:+$",
    "t }$d\";; esac; done; done; a=\"\"; for d in $s; do e=\"$w/r/$(printf %s \"$d\" | tr / _).reco",
    "rd\"; [ -s \"$e\" ] && a=\"$a --зависимость $d $e\"; done; printf '\\036 file %s\\t%s\\t%s\\n'",
    " \"$f\" \"$(cat \"$w/r/$k.kernel\" 2>/dev/null || echo -)\" \"$(echo $a | wc -w)\"; if [ -s \"",
    "$w/r/$k.record\" ]; then grep -a '^утверждение «\\|^  вердикт \\|^  правило «\\|^  посылка ' ",
    "\"$w/r/$k.record\"; printf '\\036 checker\\n'; ./flang/proof/checker/сверщик --по-утверждениям",
    " $a \"$f\" \"$w/r/$k.record\" > \"$w/r/$k.checker\" 2>&1; c=$?; grep -a '^  утверждение «' \"$",
    "w/r/$k.checker\"; printf '\\036 code %s\\n' \"$c\"; else printf '\\036 checker\\n\\036 code -",
    "\\n'; fi; done < \"$w/list\" > \"$w/census.txt\""]

