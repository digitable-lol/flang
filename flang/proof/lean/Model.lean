import Binary64

set_option exponentiation.threshold 4200

/-!
# Модель значений и суждений — общая часть сверки правил вывода ядром Lean 4

Здесь НЕТ ни одного правила из перечня `flang/proof/tables/inference-rules.tsv`.
Здесь только то, ПРО ЧТО правила говорят: значения, порядок, арифметика,
списки, тексты и запись суждения «Γ ⊢ …». Правила лежат в `Rules.lean`.

## Почему модель — доверенная часть, и что именно ей доверено

Lean проверяет вывод из определений, а не соответствие определений языку.
Значит всё, что здесь написано, читатель обязан сверить глазами с языком.
Написано по возможности прямо и мелко, чтобы такая сверка была посильной.

## Как читать имена

Кириллица в именах Lean допустима только в кавычках-ёлочках, поэтому все
имена стоят в «…». Переменные короткие, латиницей, по такому соответствию:

    Л → l    П → p    Е → e    Г → g    Д → d    Т → t
    А → a    Б → b    Ц → c    У → u    Х → h    Ш → s    М → m    К → k

## Границы модели — названы вслух, а не спрятаны

1. Конечное значение здесь ЦЕЛОЕ (`Int`). Дробей модель не знает. Проверка
   правила поэтому идёт на подобласти настоящих чисел языка, а не на всей.
2. Округление задано ДВУМЯ свойствами (точность на малых целых и
   монотонность). Теоремы правил верны при любом таком округлении; экземпляр
   «Двойная» — округление двойной точности из `Binary64.lean`, им же стоят
   встречные примеры.
3. Переполнение в бесконечность есть у «Двойная»; теоремы правил на него не
   опираются.
4. Знак нуля у РЕЗУЛЬТАТА арифметики модель не различает: «минус ноль плюс
   минус ноль» даёт здесь плюс ноль, а IEEE-754 даёт минус ноль. Ни одно
   правило перечня о знаке нуля результата не говорит; знак нуля нужен
   только сравнениям, и там он различается (запрет С✗✗).
-/

/-- Значение числа. Отдельный «минус ноль» нужен затем, что язык считает
    «минус ноль равен 0» ложью при истинном «минус ноль не больше 0». -/
inductive «Знач» where
  /-- не число -/
  | «неЧисло»
  /-- минус бесконечность -/
  | «минусБеск»
  /-- плюс бесконечность -/
  | «плюсБеск»
  /-- минус ноль -/
  | «минусНоль»
  /-- конечное значение -/
  | «кон» (n : Int)
deriving DecidableEq, Repr

open «Знач»

/-- Число конечного значения. У неконечных здесь ноль: до этих случаев
    арифметика не доходит, они отсечены выше по разбору. -/
def «чис» : «Знач» → Int
  | «кон» n => n
  | _ => 0

/-- Т : неотр -/
def «неотр» : «Знач» → Bool
  | «неЧисло» => false
  | «минусБеск» => false
  | «плюсБеск» => true
  | «минусНоль» => true
  | «кон» n => decide (0 ≤ n)

/-- Т : кон — «ограничено сверху конечным числом». Ровно это и собирает ядро
    в список конечных термов (proof-kernel.flang:8138): ограниченность сверху
    допущением, оговорка цели и охрана. Минус бесконечность такой список НЕ
    отсекает, и это видно ниже на правиле О5. -/
def «конечно» : «Знач» → Bool
  | «плюсБеск» => false
  | «неЧисло» => false
  | _ => true

/-- Т — число: ни бесконечность, ни «не число». Столько даёт оговорка
    «(Т минус Т) равен 0» (proof-kernel.flang:1083). -/
def «числом» : «Знач» → Bool
  | «кон» _ => true
  | «минусНоль» => true
  | _ => false

/-- Е ≤ Г. На «не числе» сравнение ложно с обеих сторон. -/
def «неБольше» : «Знач» → «Знач» → Bool
  | «неЧисло», _ => false
  | _, «неЧисло» => false
  | «минусБеск», _ => true
  | _, «минусБеск» => false
  | _, «плюсБеск» => true
  | «плюсБеск», _ => false
  | «минусНоль», «минусНоль» => true
  | «минусНоль», «кон» n => decide (0 ≤ n)
  | «кон» n, «минусНоль» => decide (n ≤ 0)
  | «кон» a, «кон» b => decide (a ≤ b)

/-- Е ≥ Г — та же запись зеркалом знака, а НЕ перестановкой сторон. -/
def «неМеньше» (e g : «Знач») : Bool := «неБольше» g e

/-- Е < Г -/
def «меньше» : «Знач» → «Знач» → Bool
  | «неЧисло», _ => false
  | _, «неЧисло» => false
  | «минусБеск», «минусБеск» => false
  | «минусБеск», _ => true
  | _, «минусБеск» => false
  | «плюсБеск», «плюсБеск» => false
  | _, «плюсБеск» => true
  | «плюсБеск», _ => false
  | «минусНоль», «минусНоль» => false
  | «минусНоль», «кон» n => decide (0 < n)
  | «кон» n, «минусНоль» => decide (n < 0)
  | «кон» a, «кон» b => decide (a < b)

/-- Е равно Г — `Object.is` языка (`docs/flang/SPEC.md`, «равенство скаляров»):
    «не число» равно «не числу», «минус ноль равен 0» — ложь. -/
def «равен» (x y : «Знач») : Bool := decide (x = y)

/-- Наибольшее целое, представимое в двойной точности знак в знак: 2⁵³. -/
def «порог» : Int := 9007199254740992

/-- Округление результата арифметики. Предполагается РОВНО два свойства, и
    оба верны для округления IEEE-754 к ближайшему. -/
structure «Округление» where
  «ф» : Int → «Знач»
  /-- на малых целых округление ничего не меняет -/
  «точно» : ∀ n : Int, -«порог» ≤ n → n ≤ «порог» → «ф» n = «кон» n
  /-- округление не переставляет порядок -/
  «моно» : ∀ a b : Int, a ≤ b → «неБольше» («ф» a) («ф» b) = true

def «окр64» (n : Int) : «Знач» :=
  if «предел» ≤ «окрЕд» (n.natAbs * «шаг») 1 then (if n < 0 then «минусБеск» else «плюсБеск»)
  else «кон» (if n < 0 then -((«окрЕд» (n.natAbs * «шаг») 1 / «шаг» : Nat) : Int)
    else ((«окрЕд» (n.natAbs * «шаг») 1 / «шаг» : Nat) : Int))

theorem «окр64-модуль» {n : Int} (h1 : -«порог» ≤ n) (h2 : n ≤ «порог») : n.natAbs ≤ 2 ^ 53 := by
  unfold «порог» at h1 h2
  have : (2 : Nat) ^ 53 = 9007199254740992 := by decide
  omega

theorem «окр64-точно» (n : Int) (h1 : -«порог» ≤ n) (h2 : n ≤ «порог») : «окр64» n = «кон» n := by
  have hb := «окр64-модуль» h1 h2
  have hs := «шаг-сетка» hb
  have hl : ¬ «предел» ≤ n.natAbs * «шаг» := Nat.not_le_of_lt («шаг-запас» hb)
  unfold «окр64»
  rewrite [hs, «выбор-нет» hl, Nat.mul_div_cancel _ «шаг-полож»]
  by_cases hn : n < 0
  · rewrite [«выбор-да» hn]; exact congrArg «Знач».«кон» (by omega)
  · rewrite [«выбор-нет» hn]; exact congrArg «Знач».«кон» (by omega)

theorem «окр64-знак» (n : Int) :
    (0 ≤ n → ∃ k : Nat, «окр64» n = «кон» k ∨ «окр64» n = «плюсБеск») ∧
    (n < 0 → ∃ k : Nat, «окр64» n = «кон» (-(k : Int)) ∨ «окр64» n = «минусБеск») := by
  unfold «окр64»
  constructor
  · intro h
    have hn : ¬ n < 0 := by omega
    refine ⟨«окрЕд» (n.natAbs * «шаг») 1 / «шаг», ?_⟩
    by_cases p : «предел» ≤ «окрЕд» (n.natAbs * «шаг») 1
    · right; rw [«выбор-да» p, «выбор-нет» hn]
    · left; rw [«выбор-нет» p, «выбор-нет» hn]
  · intro h
    refine ⟨«окрЕд» (n.natAbs * «шаг») 1 / «шаг», ?_⟩
    by_cases p : «предел» ≤ «окрЕд» (n.natAbs * «шаг») 1
    · right; rw [«выбор-да» p, «выбор-да» h]
    · left; rw [«выбор-нет» p, «выбор-да» h]

theorem «окр64-моноНат» {a b : Nat} (h : a ≤ b) :
    «окрЕд» (a * «шаг») 1 ≤ «окрЕд» (b * «шаг») 1 := by
  apply «окрЕд-моно» (by decide) (by decide)
  rw [Nat.mul_one, Nat.mul_one]
  exact Nat.mul_le_mul_right _ h

theorem «окр64-моно» (a b : Int) (h : a ≤ b) : «неБольше» («окр64» a) («окр64» b) = true := by
  by_cases ha : 0 ≤ a
  · have hb : 0 ≤ b := by omega
    have hm := «окр64-моноНат» (a := a.natAbs) (b := b.natAbs) (by omega)
    unfold «окр64»
    have na : ¬ a < 0 := by omega
    have nb : ¬ b < 0 := by omega
    rw [«выбор-нет» na, «выбор-нет» na, «выбор-нет» nb, «выбор-нет» nb]
    by_cases pb : «предел» ≤ «окрЕд» (b.natAbs * «шаг») 1
    · rw [«выбор-да» pb]
      by_cases pa : «предел» ≤ «окрЕд» (a.natAbs * «шаг») 1
      · rw [«выбор-да» pa]; rfl
      · rw [«выбор-нет» pa]; rfl
    · have pa : ¬ «предел» ≤ «окрЕд» (a.natAbs * «шаг») 1 := by omega
      rw [«выбор-нет» pa, «выбор-нет» pb]
      simp only [«неБольше», decide_eq_true_eq]
      exact Int.ofNat_le.mpr (Nat.div_le_div_right hm)
  · by_cases hb : b < 0
    · have hm := «окр64-моноНат» (a := b.natAbs) (b := a.natAbs) (by omega)
      unfold «окр64»
      have na : a < 0 := by omega
      rw [«выбор-да» na, «выбор-да» na, «выбор-да» hb, «выбор-да» hb]
      by_cases pa : «предел» ≤ «окрЕд» (a.natAbs * «шаг») 1
      · rw [«выбор-да» pa]
        by_cases pb : «предел» ≤ «окрЕд» (b.natAbs * «шаг») 1
        · rw [«выбор-да» pb]; rfl
        · rw [«выбор-нет» pb]; rfl
      · have pb : ¬ «предел» ≤ «окрЕд» (b.natAbs * «шаг») 1 := by omega
        rw [«выбор-нет» pa, «выбор-нет» pb]
        simp only [«неБольше», decide_eq_true_eq]
        have := Nat.div_le_div_right (c := «шаг») hm
        omega
    · obtain ⟨ka, hka⟩ := («окр64-знак» a).2 (by omega)
      obtain ⟨kb, hkb⟩ := («окр64-знак» b).1 (by omega)
      rcases hka with hka | hka <;> rcases hkb with hkb | hkb <;> rw [hka, hkb] <;>
        simp only [«неБольше», decide_eq_true_eq] <;> omega

def «Двойная» : «Округление» :=
  { «ф» := «окр64», «точно» := «окр64-точно», «моно» := «окр64-моно» }

/-- Смена знака. Ноль меняет знак на «минус ноль» — так велит IEEE-754. -/
def «отр» : «Знач» → «Знач»
  | «неЧисло» => «неЧисло»
  | «минусБеск» => «плюсБеск»
  | «плюсБеск» => «минусБеск»
  | «минусНоль» => «кон» 0
  | «кон» n => if n = 0 then «минусНоль» else «кон» (-n)

/-- Л плюс П -/
def «плюс» («о» : «Округление») : «Знач» → «Знач» → «Знач»
  | «неЧисло», _ => «неЧисло»
  | _, «неЧисло» => «неЧисло»
  | «плюсБеск», «минусБеск» => «неЧисло»
  | «минусБеск», «плюсБеск» => «неЧисло»
  | «плюсБеск», _ => «плюсБеск»
  | _, «плюсБеск» => «плюсБеск»
  | «минусБеск», _ => «минусБеск»
  | _, «минусБеск» => «минусБеск»
  | x, y => «о».«ф» («чис» x + «чис» y)

/-- Л минус П -/
def «минус» («о» : «Округление») (x y : «Знач») : «Знач» := «плюс» «о» x («отр» y)

/-- Знак значения: −1, 0, +1. -/
def «знак» : «Знач» → Int
  | «неЧисло» => 0
  | «минусБеск» => -1
  | «плюсБеск» => 1
  | «минусНоль» => 0
  | «кон» n => if n < 0 then -1 else if 0 < n then 1 else 0

/-- Значение бесконечно. -/
def «беск» : «Знач» → Bool
  | «плюсБеск» => true
  | «минусБеск» => true
  | _ => false

/-- Л умножить на П. Ноль на бесконечность даёт «не число». -/
def «умножить» («о» : «Округление») (x y : «Знач») : «Знач» :=
  match x, y with
  | «неЧисло», _ => «неЧисло»
  | _, «неЧисло» => «неЧисло»
  | x, y =>
    if «беск» x || «беск» y then
      if «знак» x = 0 || «знак» y = 0 then «неЧисло»
      else if «знак» x * «знак» y = 1 then «плюсБеск» else «минусБеск»
    else «о».«ф» («чис» x * «чис» y)

/-- Т остаток от Д. Знак остатка — знак делимого, как у усечённого деления. -/
def «остаток» : «Знач» → «Знач» → «Знач»
  | «кон» a, «кон» d => if d = 0 then «неЧисло» else «кон» (Int.tmod a d)
  | «минусНоль», «кон» d => if d = 0 then «неЧисло» else «кон» 0
  | «кон» a, «плюсБеск» => «кон» a
  | «кон» a, «минусБеск» => «кон» a
  | «минусНоль», «плюсБеск» => «минусНоль»
  | «минусНоль», «минусБеск» => «минусНоль»
  | _, _ => «неЧисло»

/-- Если У то А иначе Б: значение выбора — значение одной из ветвей. -/
def «выбор» (u : Bool) (a b : «Знач») : «Знач» := if u then a else b

/-! ## Списки и тексты -/

abbrev «Список» := List «Знач»

/-- Список не убывает. -/
def «неубыв» : «Список» → Bool
  | [] => true
  | [_] => true
  | a :: b :: t => «неБольше» a b && «неубыв» (b :: t)

/-- Свёртка списка. -/
def «свёртка» (s : «Знач» → «Знач» → «Знач») (n : «Знач») : «Список» → «Знач»
  | [] => n
  | h :: t => «свёртка» s (s n h) t

/-- Разбор списка на «пусто» и «звено». -/
def «разборСписка» {α : Type} («пуст» : α) («звено» : «Знач» → «Список» → α) :
    «Список» → α
  | [] => «пуст»
  | h :: t => «звено» h t

/-! ## Объявленная сумма пользователя

Правило «Инд1» говорит о ТИПЕ, который объявил автор программы, а не о списке.
Здесь взят самый мелкий такой тип: один вариант без полей и один с полем того же
типа — ровно `тип «Нат»` с вариантами «Ноль» и «Следующий содержит пред: «Нат»».
Больше модели не нужно: правило не смотрит ни на число полей, ни на их типы,
кроме одного вопроса — «это поле того же типа или нет».
-/

inductive «Сумма» where
  /-- вариант без полей типа Т — им закрывается база -/
  | «База»
  /-- вариант с полем того же типа — им идёт шаг, и о поле есть допущение -/
  | «Шаг» (p : «Сумма»)

/-- «для всех э из Л: П» — свойство стоит у каждого элемента списка
    (ADR-0026 §11 п.14). На пустом списке истинно пусто — ровно так же
    считает вычислитель («Свёртка всех элементов», начало «да»). -/
def «всеЭ» (p : «Знач» → Bool) : «Список» → Bool
  | [] => true
  | h :: t => p h && «всеЭ» p t

/-- «отфильтровать Л где х → У»: остаются те и только те элементы, у которых У истинно. -/
def «отбор» (p : «Знач» → Bool) («л» : «Список») : «Список» := List.filter p «л»

/-- «отобразить Л как х → Ф»: на каждый элемент — ровно один образ, порядок тот же
    (вычислитель, `stepLoop` в режиме `map`). Заведено под Э6 (ADR-0037 §4.3, задача 4058). -/
def «отобр» (f : «Знач» → «Знач») («л» : «Список») : «Список» := List.map f «л»

abbrev «Текст» := List Char

/-- Т ▷ П: текст начинается приставкой. -/
def «начинается» (t p : «Текст») : Bool := p.isPrefixOf t

/-- Соединить части через разделитель. -/
def «соединитьПо» : List «Текст» → «Текст» → «Текст»
  | [], _ => []
  | [x], _ => x
  | x :: xs, r => x ++ r ++ «соединитьПо» xs r

/-- «разложить Т на символы»: по одному элементу на знак, порядок тот же
    (задача 7359; вычислитель — «Форма разложить»). -/
def «разложить» (t : «Текст») : List «Текст» := t.map (fun c => [c])

/-! ## Окружение и суждение

Суждение «Γ ⊢ P» читается так: в КАЖДОМ состоянии мира, где выполнены все
факты окружения Γ, выполнено P. Терм — это то, чем состояние мира становится
значением; синтаксиса терма модель не разбирает вовсе.
-/

/-- Терм: чем состояние мира становится значением. -/
abbrev «Терм» (W : Type) := W → «Знач»

/-- Факт о состоянии мира. -/
abbrev «Факт» (W : Type) := W → Prop

/-- Состояние мира выполняет всё окружение. -/
def «Выполняет» {W : Type} (Γ : List («Факт» W)) (w : W) : Prop := ∀ f ∈ Γ, f w

/-- Γ ⊢ P -/
def «Судим» {W : Type} (Γ : List («Факт» W)) (P : «Факт» W) : Prop :=
  ∀ w, «Выполняет» Γ w → P w

/-! ### Подъём: из правила о значениях — правило о суждениях

Правила перечня записаны как «Γ ⊢ посылки ⟹ Γ ⊢ заключение» при ОДНОМ и
том же Γ. Три леммы ниже показывают, что такой переход равносилен правилу о
значениях: окружение проходит сквозь и ничего не добавляет. Поэтому дальше
правила без условий на Γ записаны о значениях, а с условиями на Γ — о
суждениях.
-/

theorem «подъём0» {W : Type} {Γ : List («Факт» W)} {C : «Факт» W}
    (h : ∀ x, C x) : «Судим» Γ C := fun w _ => h w

theorem «подъём1» {W : Type} {Γ : List («Факт» W)} {A C : «Факт» W}
    (h : ∀ w, A w → C w) : «Судим» Γ A → «Судим» Γ C :=
  fun hA w hw => h w (hA w hw)

theorem «подъём2» {W : Type} {Γ : List («Факт» W)} {A B C : «Факт» W}
    (h : ∀ w, A w → B w → C w) : «Судим» Γ A → «Судим» Γ B → «Судим» Γ C :=
  fun hA hB w hw => h w (hA w hw) (hB w hw)

/-- Что стоит в окружении, то и выводится. -/
theorem «изΓ» {W : Type} {Γ : List («Факт» W)} {A : «Факт» W} (h : A ∈ Γ) :
    «Судим» Γ A := fun _ hw => hw A h

/-! ## Следствия двух предположений об округлении

Ниже НЕТ новых предположений: всё выводится из «точно» и «моно».
-/

theorem «нольПод» {x : «Знач»} (h : «неБольше» («кон» 0) x = true) :
    «неотр» x = true := by
  cases x <;> simp_all [«неБольше», «неотр»]

theorem «окр-нуль» («о» : «Округление») : «о».«ф» 0 = «кон» 0 :=
  «о».«точно» 0 (by unfold «порог»; omega) (by unfold «порог»; omega)

theorem «окр-неотр» («о» : «Округление») (n : Int) (h : 0 ≤ n) :
    «неотр» («о».«ф» n) = true := by
  have h0 := «окр-нуль» «о»
  have hm := «о».«моно» 0 n h
  rw [h0] at hm
  exact «нольПод» hm

/-- Значение представимо: округление его не двигает. У настоящих чисел языка
    это верно всегда — значением терма непредставимое число не бывает. -/
def «представимо» («о» : «Округление») : «Знач» → Prop
  | «кон» n => «о».«ф» n = «кон» n
  | _ => True

/-- Меньшее из двух. -/
def «мин» (x y : «Знач») : «Знач» := if «неБольше» x y then x else y

/-- Порядок переходен всюду, где обе ступени истинны. -/
theorem «переход» {x y z : «Знач»}
    (h1 : «неБольше» x y = true) (h2 : «неБольше» y z = true) :
    «неБольше» x z = true := by
  cases x <;> cases y <;> cases z <;> simp_all [«неБольше»] <;> omega

/-- Строгий порядок переходит сквозь нестрогий. -/
theorem «переходСтрого» {x y z : «Знач»}
    (h1 : «меньше» x y = true) (h2 : «неБольше» y z = true) :
    «меньше» x z = true := by
  cases x <;> cases y <;> cases z <;> simp_all [«меньше», «неБольше»] <;> omega

theorem «переходСтрого2» {x y z : «Знач»}
    (h1 : «неБольше» x y = true) (h2 : «меньше» y z = true) :
    «меньше» x z = true := by
  cases x <;> cases y <;> cases z <;> simp_all [«меньше», «неБольше»] <;> omega

theorem «окр-неNaN» («о» : «Округление») (n : Int) : «о».«ф» n ≠ «неЧисло» := by
  have h := «о».«моно» n n (Int.le_refl n)
  intro hn
  rw [hn] at h
  simp [«неБольше»] at h

theorem «неNaNлево» {x y : «Знач»} (h : «неБольше» x y = true) : x ≠ «неЧисло» := by
  cases x <;> simp_all [«неБольше»]

theorem «полнота» {x y : «Знач»} (hx : x ≠ «неЧисло») (hy : y ≠ «неЧисло»)
    (h : «неБольше» x y = false) : «неБольше» y x = true := by
  cases x <;> cases y <;> simp_all [«неБольше»] <;> omega

theorem «рефл» {x : «Знач»} (h : x ≠ «неЧисло») : «неБольше» x x = true := by
  cases x <;> simp_all [«неБольше»]

theorem «подЧислом» {y : «Знач»} (h : «числом» y = true) :
    «неБольше» «минусБеск» y = true := by
  cases y <;> simp_all [«числом», «неБольше»]

theorem «квадратНеотр» (n : Int) : 0 ≤ n * n := by
  by_cases h : 0 ≤ n
  · exact Int.mul_nonneg h h
  · have hq : 0 ≤ (-n) * (-n) := Int.mul_nonneg (by omega) (by omega)
    rw [Int.neg_mul_neg] at hq
    exact hq

@[simp] theorem «нольСправа» (x : «Знач») :
    «неБольше» x «минусНоль» = «неБольше» x («кон» 0) := by
  cases x <;> simp [«неБольше»]

@[simp] theorem «нольСлева» (x : «Знач») :
    «неБольше» «минусНоль» x = «неБольше» («кон» 0) x := by
  cases x <;> simp [«неБольше»]

theorem «подБеск» («о» : «Округление») (n : Int) :
    «неБольше» («о».«ф» n) «плюсБеск» = true := by
  have h := «окр-неNaN» «о» n
  cases hh : «о».«ф» n <;> simp_all [«неБольше»]

theorem «надМинусБеск» («о» : «Округление») (n : Int) :
    «неБольше» «минусБеск» («о».«ф» n) = true := by
  have h := «окр-неNaN» «о» n
  cases hh : «о».«ф» n <;> simp_all [«неБольше»]

theorem «надНулём» («о» : «Округление») (n : Int) (h : 0 ≤ n) :
    «неБольше» («кон» 0) («о».«ф» n) = true := by
  have h0 := «окр-нуль» «о»
  have hm := «о».«моно» 0 n h
  rwa [h0] at hm

theorem «надМинусНулём» («о» : «Округление») (n : Int) (h : 0 ≤ n) :
    «неБольше» «минусНоль» («о».«ф» n) = true := by
  rw [«нольСлева»]
  exact «надНулём» «о» n h
