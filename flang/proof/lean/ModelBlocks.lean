def main (args : List String) : IO UInt32 := do
  match args with
  | «список» :: «прочее» =>
    let «деревья» := «прочее».headD ""
    for l in ← IO.FS.lines «список» do
      match l.splitOn "\t" with
      | [«метка», «исх», «зап»] => «Перепись».«одна» «деревья» «метка» «исх» «зап»
      | _ => pure ()
    pure 0
  | _ =>
    IO.eprintln "перепись: нужен файл списка «метка<TAB>исходник<TAB>запись» и, вторым доводом, каталог деревьев программ"
    pure 2
