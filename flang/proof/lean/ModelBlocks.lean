/-!
# Перепись блоков записи: что из неё читает модель, что стоит вне модели

Прибор к условию 3 дороги до 1.0 («блоков „вне модели“ нет»). Читает список
`метка<TAB>исходник<TAB>запись` и печатает по каждому блоку записи строку

`метка<TAB>вид<TAB>имя<TAB>модель<TAB>вердикт<TAB>причина`

- `вид` — чем блок является в тексте записи: `утверждение-вывод` (под ним блок
  `вывод`), `утверждение-ходы` (ходы теоремы), `утверждение-посылки` (посылки
  индукции, ходы под каждой), `утверждение-посылки-без-ходов` (хотя бы под одной посылкой
  ходов нет: её закрывают узлы по телу, крюки либо шаги автора),`утверждение-на-слове` (вердикт «доказано» без блока: место на слове
  ядра либо на крюках по телу у второго сверщика), `утверждение-без-доказательства`
  (вердикт не «доказано»), `снятие`, `тотальность`, `категорная`, `таблица`, прочие —
  первым словом заголовка;
- `модель` — `ЧИТАЕТ`, когда блок судит приёмка `Acceptance.lean` (блоки `вывод`,
  которые сверщик проигрывает, — `«проигрывается»`) либо правило композиции
  `Semantics/Termination.lean` (блоки тотальности), иначе `НЕ ЧИТАЕТ`;
- `вердикт` и `причина` — у читаемых: `ПРИНЯЛ`, `ОТВЕРГ`, `ВНЕ` (шаг вне модели:
  тело не собрано в терм, реестр доказанных постусловий), `НЕ ПРОЧЁЛ`
  (`VerdictCheck.lean`); у прочих — пусто.

По каждой записи — ещё строка формы `метка<TAB>#форма<TAB>…`: сколько утверждений
объявляет шапка (`утверждений N`), сколько блоков утверждений нарезал читатель,
сколько шагов `вывод N …` стоит в тексте читаемых блоков и сколько прочитано. Это
сверка читателя с печатью на корпусе — не теорема (ADR-0041 §2.3), а прогон,
который краснеет, когда читатель отстаёт от формата.

Запись без исходника в дереве — строка `метка<TAB>#нет-исходника`: судить нечего.
-/

open «Разбор»

namespace «Перепись»

/-- Строки шапки записи — верхние строки, не открывающие блока. -/
def «шапка?» (l : String) : Bool :=
  ["запись ", "исходник ", "строк ", "знаков ", "отпечаток ", "ядро ", "утверждений ",
   "отпечаток256 ", "тотальностей ", "таблиц ", "законов ", "конец "].any (l.startsWith ·) ||
  l = "тотальностей" || l = "конец записи"

/-- Первое слово строки. -/
def «слово1» (l : String) : String := (l.splitOn " ").headD ""

/-- Имя в первых ёлочках заголовка. -/
def «имяБлока» (l : String) : String := «вЁлочках» l 1

/-- Блоки записи, кроме утверждений: вид (первое слово заголовка), имя, строки под
    заголовком (обрезанные) до следующего верхнего заголовка. Утверждения режет
    читатель (`«утвержденияТекстом»`), и здесь они пропускаются, чтобы счёт блоков
    утверждений был тот же, что у приёмки. Таблица — строка `  таблица «Ф» …` под
    `таблиц N`: блок в одну строку. -/
def «прочиеБлоки» («строки» : List String) : List (String × String × List String) :=
  let «шаг» := fun (acc : List (String × String × List String) × Option (String × String × List String)) (l : String) =>
    let «верх» := l ≠ "" && !(l.startsWith " ") && !(l.startsWith "\t")
    if l.startsWith "  таблица «" then
      let «закрыть» := match acc.2 with | some t => acc.1 ++ [t] | none => acc.1
      («закрыть» ++ [("таблица", «имяБлока» l, [l.«обр»])], none)
    else if «верх» then
      let «закрыть» := match acc.2 with
        | some (k, n, b) => acc.1 ++ [(k, n, if l = "конец снятия" && k = "снятие" then b ++ [l] else b)]
        | none => acc.1
      if «шапка?» l then («закрыть», none)
      else if l.startsWith "утверждение «" then («закрыть», none)
      else («закрыть», some («слово1» l, «имяБлока» l, [l]))
    else match acc.2 with
      | some (k, n, b) => (acc.1, some (k, n, b ++ [l.«обр»]))
      | none => acc
  let r := «строки».foldl «шаг» ([], none)
  match r.2 with | some t => r.1 ++ [t] | none => r.1

/-- Вид блока утверждения по его строкам. -/
def «видУтверждения» (b : List String) : String :=
  let «вердикт» := match b.find? (·.startsWith "вердикт") with | some l => l | none => ""
  let «верхний» := b.find? (fun l => l.startsWith "посылка " || l = "ход цель")
  if b.any (·.startsWith "вывод ") then "утверждение-вывод"
  else match «верхний» with
    | some l => if l = "ход цель" then "утверждение-ходы" else "утверждение-посылки"
    | none =>
      if b.any (·.startsWith "ход ") then "утверждение-ходы"
      else if «вердикт» = "вердикт доказано" then "утверждение-на-слове"
      else "утверждение-без-доказательства"

/-- Шаги `вывод N …` в тексте блока: без «вывод цель» и «вывод конец». -/
def «шаговВТексте» (b : List String) : Nat :=
  (b.filter (fun l => l.startsWith "вывод " && !(l.startsWith "вывод цель") && l ≠ "вывод конец")).length

def «числоШапки» («строки» : List String) («метка» : String) : Nat :=
  match «строки».find? (·.startsWith «метка») with
  | some l => ((l.«сн» «метка».length).«обр».toNat?).getD 0
  | none => 0

def «известныеФормы» : List String :=
  ["длина", "пусто", "голова", "хвост", "добавить", "приписать", "элемент", "символ", "символы",
   "код символа", "символ по коду", "подстрока", "соединить", "разделить", "содержит",
   "начинается с", "к строке", "к числу", "остаток от"]

def «внеЭталона» (P : «Эталон».«Программа») (g : «Эталон».«Функция») : List String :=
  («Эталон».«узлыФункции» g).filterMap (fun e =>
    match e with
    | .«применить» _ _ => some "применение значения-функции"
    | .«форма» n _ =>
      if n.startsWith "#отказ " || «известныеФормы».contains n then none else some s!"форма вне эталона: {n}"
    | .«вызов» f _ =>
      if («Эталон».«функцияПрограммы» P f).isSome then none else some s!"зов вне программы: {f}"
    | _ => none)

def «достижимые» (P : «Эталон».«Программа») : Nat → List String → List String
  | 0, S => S
  | k + 1, S =>
    let «новые» := (S.flatMap (fun f =>
      match «Эталон».«функцияПрограммы» P f with
      | some g => «Эталон».«зовыФункции» g
      | none => [])).filter (fun c => !S.contains c)
    if «новые».isEmpty then S else «достижимые» P k (S ++ «новые».eraseDups)

def «судТотальности» (P : Option «Эталон».«Программа») («имя» : String) (b : List String) : String × String × String :=
  let «строки» := (b.drop 1).filter (· ≠ "")
  let «чужие» := «строки».filter (fun l =>
    !(l = "вид composition" || l = "самовызова нет" || l = "конец тотальности" ||
      l.startsWith "зовёт примитив «" || (l.startsWith "зовёт «" && l.endsWith " тотальна")))
  let «названы» := ((«строки».filter (·.startsWith "зовёт «")).map (fun l => «вЁлочках» l 1)).eraseDups
  if !«строки».contains "вид composition" then ("тотальность-вне-модели", "", "вид блока не композиция")
  else match «чужие» with
  | l :: _ => ("тотальность-вне-модели", "", s!"строка блока вне модели: {l}")
  | [] =>
  match P with
  | none => ("тотальность-вне-модели", "", "дерева программы нет")
  | some P =>
  match «Эталон».«функцияПрограммы» P «имя» with
  | none => ("тотальность-вне-модели", "", "функции нет в дереве программы")
  | some g =>
  let «круг» := «достижимые» P (P.length + 1) [«имя»]
  let «вне» := «круг».flatMap (fun f =>
    match «Эталон».«функцияПрограммы» P f with
    | some h => «внеЭталона» P h
    | none => [])
  match «вне» with
  | w :: _ => ("тотальность-вне-модели", "", w)
  | [] =>
  let «все» := («Эталон».«зовыФункции» g).eraseDups
  let «изТела» := «достижимые» P (P.length + 1) («Эталон».«зовыТела» g).eraseDups
  let «изВсего» := «достижимые» P (P.length + 1) «все»
  let «рекурсивные» := «изВсего».filter (fun c =>
    match «Эталон».«функцияПрограммы» P c with
    | some h => («достижимые» P (P.length + 1) («Эталон».«зовыФункции» h).eraseDups).contains c
    | none => false)
  let «постусловий» := «все».filter (fun c => !«названы».contains c)
  if «Эталон».«принятьКомпозицию» P «имя» «названы» then
    ("тотальность", "ПРИНЯЛ",
      if «постусловий».isEmpty then "" else s!"зовы постусловий в блоке не названы: {«постусловий»}")
  else if «изТела».contains «имя» then ("тотальность", "ОТВЕРГ", "круг зовов через тело функции")
  else if «изВсего».contains «имя» then ("тотальность", "ОТВЕРГ", "круг зовов через постусловие функции")
  else if «Эталон».«принятьНадРекурсией» P «имя» «названы» then
    ("тотальность", "ПРИНЯЛ", s!"над рекурсией по части довода: {«рекурсивные»}")
  else if !(«Эталон».«конечные» P (P.length + 1)).contains «имя» then
    ("тотальность-вне-модели", "", s!"зовёт рекурсивную функцию: {«рекурсивные»}")
  else
    let «зовы» := («Эталон».«зовыТела» g).eraseDups
    let «лишние» := «названы».filter (fun c => !«зовы».contains c)
    let «неназванные» := «зовы».filter (fun c => !«названы».contains c)
    ("тотальность", "ОТВЕРГ",
      s!"зовы блока и тела разошлись: в блоке, но не в теле — {«лишние»}; в теле, но не в блоке — {«неназванные»}")

def «судСнятия» («исх» «зап» : String) («блок» : List String) : String × String × String :=
  if !(«блок».any (·.startsWith "вывод ")) then ("снятие-ходами", "", "блока вывода нет")
  else if («зап».splitOn "\n").any (·.startsWith "законов ") then ("снятие-вне-модели", "", "запись с развёрткой законов")
  else
    let «строки» := «Второй».«строкиПоРусски» («исх».splitOn "\n")
    let «опр» := «определения» «строки» («строкиРазв3» «зап»)
    let s : «Второй».«Исх» := ({ «Второй».«исходник» «исх» with «сырые» := «строки».toArray } : «Второй».«Исх»).«сМногострочными»
    let h := s.«хозяева»
    let c := «Второй».«прочестьСнятие» «блок»
    let q := «Второй».«судитьСнятие» s h «строки» «опр» «Второй».«правилаЯдра» [] [] «блок»
    match «Второй».«цельСнятия» s c with
    | none => ("снятие", "ОТВЕРГ", "цель снятия по исходнику не строится")
    | some «цель» =>
      match «Второй».«выводСнятия» c «цель» «строки» «опр» («Второй».«звеньяВызоваЗв» s h c.«функция» c.«строка») with
      | .ok none =>
        match q.«беды», q.«непонято», q.«наСлово» with
        | [], [], [] => ("снятие", "ПРИНЯЛ", "")
        | e :: _, _, _ => ("снятие", "ОТВЕРГ", e)
        | _, e :: _, _ => ("снятие-вне-модели", "", e)
        | _, _, e :: _ => ("снятие-вне-модели", "", e)
      | .ok (some e) => ("снятие", "ОТВЕРГ", e)
      | .error e => ("снятие-вне-модели", "", e)

def «судТаблицы» (P : Option «Эталон».«Программа») («исх» : String) («имя» : String) (b : List String) :
    String × String × String :=
  let l := b.headD ""
  let o := «Второй».«номерПосле» l "открыта "
  let c := «Второй».«номерПосле» l "закрыта "
  let n := «Второй».«номерПосле» l "звеньев "
  let «строки» := «исх».splitOn "\n"
  match P with
  | none => ("таблица-вне-модели", "", "дерева программы нет")
  | some P =>
    if «Эталон».«принятьТаблицу» P «строки» «имя» o c n then ("таблица", "ПРИНЯЛ", "")
    else if !«Эталон».«местоТаблицы» «строки» «имя» o c n then
      ("таблица", "ОТВЕРГ", "строки исходника не те, что названы в оглавлении")
    else ("таблица", "ОТВЕРГ", "тело функции в дереве программы — не список постоянных без доводов")

def «вУголках» (l : String) : List String :=
  ((l.splitOn "⟨").drop 1).map (fun p => (p.splitOn "⟩").headD "")

def «ходыБлока» (b : List String) : String :=
  let «ходы» := b.filter (fun l => l.startsWith "ход " && l ≠ "ход цель" && l ≠ "ход конец")
  let «роды» := («ходы».map (fun l => (l.splitOn " ").getD 2 "")).eraseDups
  let «формулы» := «ходы».flatMap «вУголках»
  let «читается» := «формулы».filter (fun t => («форм» («терм» t)).isSome)
  s!"роды: {" ".intercalate «роды»}; текстов в уголках {«формулы».length}, формулой читается {«читается».length}"

def «посылкиБезХодов» (b : List String) : List «Второй».«Посылка» :=
  let «шаг» := fun (acc : List «Второй».«Посылка» × Option («Второй».«Посылка» × Bool)) (l : String) =>
    if l.startsWith "посылка " then
      (match acc.2 with
       | some (p, false) => acc.1 ++ [p]
       | _ => acc.1, some («Второй».«прочестьПосылку» l, false))
    else if l.startsWith "ход " && l ≠ "ход цель" && l ≠ "ход конец" then
      (acc.1, acc.2.map (fun t => (t.1, true)))
    else acc
  let r := b.foldl «шаг» ([], none)
  match r.2 with
  | some (p, false) => r.1 ++ [p]
  | _ => r.1

def «запасПримера» : Nat := 256

def «чемЗакрыто» (b : List String) : String :=
  let «шаги» := b.filter (·.startsWith "шаг ")
  let «слова» := ["по примеру", "по свойству", "по предположению", "по закону"].filter (fun w =>
    «шаги».any (fun l => (l.splitOn s!" {w}").length > 1))
  if !(b.any (·.startsWith "теорема «")) then "теоремы нет"
  else if «слова».isEmpty then "шаги без обоснования" else ", ".intercalate «слова»

def «судПримера» (P : Option «Эталон».«Программа») («строки» : List String) (h : String) (b : List String) :
    String × String × String :=
  let «чем» := «чемЗакрыто» b
  let f := «вЁлочках» h 2
  let «имя» := «вЁлочках» h 1
  let «строка» := «Второй».«номерПосле» h "строка "
  if «чем» ≠ "по примеру" || b.any (·.startsWith "индукция по ") then ("утверждение-на-слове", "", «чем»)
  else match P with
  | none => ("утверждение-на-слове", "", "по примеру; дерева программы нет")
  | some P =>
    match «Эталон».«функцияПрограммы» P f with
    | none => ("утверждение-на-слове", "", "по примеру; функции нет в дереве программы")
    | some g =>
      if !g.«параметры».isEmpty then ("утверждение-на-слове", "", "по примеру у функции с доводами")
      else if «Эталон».«принятьПример» P «строки» f «имя» «строка» «запасПримера» then
        ("утверждение-примером", "ПРИНЯЛ", "")
      else match «Эталон».«вызватьТело» («Эталон».«выч» P «запасПримера») g [] with
        | .ok _ => ("утверждение-примером", "ОТВЕРГ", "строка исходника — не постусловие этой функции с этим именем")
        | .error (.«беда» k) => ("утверждение-примером", "ОТВЕРГ", s!"вызов в эталоне отказал: {k}")
        | .error (.«вне» k) => ("утверждение-на-слове", "", s!"по примеру; вне эталона: {k}")
        | .error .«топливо» => ("утверждение-на-слове", "", "по примеру; запаса глубины не хватило")

def «деревоJson» («деревья» «метка» : String) : IO (Option Lean.Json) := do
  if «деревья» = "" then return none
  let «путь» := s!"{«деревья»}/{«метка»}.json"
  if !(← System.FilePath.pathExists «путь») then return none
  match Lean.Json.parse (← IO.FS.readFile «путь») with
  | .ok j => return some j
  | .error _ => return none

def «дерево» («деревья» «метка» : String) : IO (Option «Эталон».«Программа») := do
  return (← «деревоJson» «деревья» «метка»).map «Эталон».«программаJson»

def «натИмена» : List String := ["неотрицательное", "нат", "натуральное", "nat", "naturo", "自然数"]

def «литералСДном?» (j : Lean.Json) : Bool :=
  «Эталон».«строка?» j "kind" = "literal" &&
    match «Эталон».«поле?» j "value" with
    | some (.num n) => decide (0 ≤ n.mantissa)
    | _ => false

def «доводыОтрезком» (g : Lean.Json) : List String :=
  («Эталон».«массив» g "params").filterMap (fun p =>
    match «Эталон».«поле?» p "type" with
    | some t =>
      if «Эталон».«строка?» t "kind" = "named" && «натИмена».contains («Эталон».«строка?» t "name") then
        some («Эталон».«строка?» p "name") else none
    | none => none)

def «конечныеДоводы» (j : Lean.Json) (f : String) : List String :=
  match («Эталон».«массив» j "functions").find? (fun g => «Эталон».«строка?» g "name" = f) with
  | none => []
  | some g => («доводыОтрезком» g).eraseDups

def «доводыСДном» (j : Lean.Json) (f : String) : List String :=
  match («Эталон».«массив» j "functions").find? (fun g => «Эталон».«строка?» g "name" = f) with
  | none => []
  | some g =>
    let «типом» := «доводыОтрезком» g
    let «требованием» := («Эталон».«массив» g "preconditions").filterMap (fun c =>
      match «Эталон».«поле?» c "expr" with
      | some e =>
        match «Эталон».«поле?» e "left", «Эталон».«поле?» e "right" with
        | some l, some r =>
          if «Эталон».«строка?» e "kind" = "binary" && ["gte", "gt"].contains («Эталон».«строка?» e "op") &&
              «Эталон».«строка?» l "kind" = "var" && «литералСДном?» r then some («Эталон».«строка?» l "name")
          else none
        | _, _ => none
      | none => none)
    («типом» ++ «требованием»).eraseDups

def «неотрицательныеПрограммы» (P : «Эталон».«Программа») (j : Lean.Json) : List String :=
  «Эталон».«неотрицательныеВместе» P («доводыСДном» j) («конечныеДоводы» j) (P.length + 1)
    ((P.filter (fun g => «Эталон».«постНН-функции?» P g.«имя»)).map (·.«имя»))

def «правилоПостроения» : String := "неотрицательность по построению"

def «правилоПотолка» : String := "ограниченность точным потолком по построению"

def «строковыеДоводы» (j : Lean.Json) (f : String) : List String :=
  match («Эталон».«массив» j "functions").find? (fun g => «Эталон».«строка?» g "name" = f) with
  | none => []
  | some g =>
    («Эталон».«массив» g "params").filterMap (fun p =>
      match «Эталон».«поле?» p "type" with
      | some t => if «Эталон».«строка?» t "kind" = "string" then some («Эталон».«строка?» p "name") else none
      | none => none)

def «наПравиле?» («правило» : String) (b : List String) : Bool :=
  let «шаги» := b.filter (·.startsWith "шаг ")
  let «своё» := s!"правило «{«правило»}»"
  let «голые» := «посылкиБезХодов» b
  b.contains "вид postcondition" &&
    (if !(b.any (·.startsWith "посылка ")) then
      (if «шаги».isEmpty then b.contains «своё» else «шаги».all (fun l => (l.splitOn «своё»).length > 1))
    else !«голые».isEmpty && «голые».all (·.«правило» = «правило»))

def «правилоПорядка» : String := "порядок по построению"

def «правилоРазбора» : String := "разбор цели по условию"

def «наРазборе?» (b : List String) : Bool :=
  let «голые» := «посылкиБезХодов» b
  let «шаги» := b.filter (·.startsWith "шаг ")
  «наПравиле?» «правилоРазбора» b ||
    (b.contains "вид postcondition" && !«голые».isEmpty &&
      «голые».all (fun p => p.«правило» = «правилоРазбора» || p.«правило» = "") &&
      «голые».any (·.«правило» = «правилоРазбора») &&
      «шаги».all (fun l => (l.splitOn " закрывающий по примеру «").length > 1 ||
        l.endsWith " закрывающий по предположению" || (l.splitOn s!"правило «{«правилоРазбора»}»").length > 1))

def «правилоТождества» : String := "тождество после переписки допущением"

def «наДлинах?» (b : List String) : Bool :=
  let «голые» := «посылкиБезХодов» b
  «наПравиле?» «правилоТождества» b ||
    (b.contains "вид postcondition" && !(b.any (·.startsWith "шаг ")) && !«голые».isEmpty &&
      «голые».all (fun p => p.«правило» = «правилоТождества» || p.«правило» = «правилоРазбора») &&
      «голые».any (·.«правило» = «правилоТождества»))

def «наПорядке?» (b : List String) : Bool :=
  let «голые» := «посылкиБезХодов» b
  b.contains "вид postcondition" && !(b.any (·.startsWith "шаг ")) && !«голые».isEmpty &&
    «голые».all (fun p => p.«правило» = «правилоПорядка» || p.«правило» = «правилоПотолка») &&
    «голые».any (·.«правило» = «правилоПорядка»)

def «строкаБлока» (b : List String) («начало» : String) : String :=
  (b.find? (·.startsWith «начало»)).getD ""

def «значениеВарианта» (b : List String) (p : «Второй».«Посылка») : Option «Эталон».«Зн» :=
  let «принцип» := «строкаБлока» b "принцип "
  let «объявление» := «строкаБлока» b "объявление "
  if p.«вид» ≠ "base" then none
  else if «принцип».startsWith "принцип тип «список» " && p.«вариант» = "пусто" then some (.«список» [])
  else if «принцип».startsWith "принцип тип «строка» " && p.«вариант» = "пусто" then some (.«строка» "")
  else if («принцип».splitOn " носитель segment ").length > 1 && («объявление».splitOn " дно 0 ").length > 1 &&
      p.«вариант» = "" then some (.«число» (.«кон» false 0))
  else if «объявление».startsWith "объявление сумма " && p.«вариант» ≠ "" &&
      ((«объявление».splitOn s!"«{p.«вариант»}» 0 ").length > 1 || «объявление».endsWith s!"«{p.«вариант»}» 0") then
    some (.«вариант» p.«вариант» [])
  else none

def «наВариантах?» (b : List String) : Bool :=
  let «голые» := «посылкиБезХодов» b
  let «объявление» := «строкаБлока» b "объявление "
  b.contains "вид postcondition" && «объявление».startsWith "объявление сумма " && !«голые».isEmpty &&
    «голые».length = («Второй».«посылкиБлока» b).length &&
    «голые».length + 2 = («объявление».splitOn "«").length &&
    («голые».map (·.«вариант»)).eraseDups.length = «голые».length &&
    «голые».all (fun p => («значениеВарианта» b p).isSome) &&
    (b.filter (·.startsWith "шаг ")).all (fun l => (l.splitOn " закрывающий по примеру «").length > 1)

def «вариантыВычислены» (P : «Эталон».«Программа») (f : String) (b : List String) : Bool :=
  let x := «вЁлочках» («строкаБлока» b "принцип ") 2
  («посылкиБезХодов» b).all (fun p =>
    match «значениеВарианта» b p with
    | some u => «Эталон».«вычислимоНа» P f [(x, u)] «запасПримера»
    | none => false)

def «наПримереВарианта?» (b : List String) : Bool :=
  let «голые» := «посылкиБезХодов» b
  let «шаги» := b.filter (·.startsWith "шаг ")
  b.contains "вид postcondition" && !«голые».isEmpty &&
    «голые».all (fun p => p.«правило» = «правилоПостроения» || (p.«правило» = "" && («значениеВарианта» b p).isSome)) &&
    «голые».any (·.«правило» = "") &&
    «шаги».all (fun l => (l.splitOn " закрывающий по примеру «").length > 1 ||
      l.endsWith " закрывающий по предположению")

def «базаНаПути» (P : «Эталон».«Программа») (f x : String) (u : «Эталон».«Зн») : Bool :=
  «Эталон».«пустой» u &&
    match «Эталон».«функцияПрограммы» P f with
    | some g => g.«параметры».contains x && (g.«постусловия».filter «Эталон».«постНН?»).all («Эталон».«базаПоПути?» P g x)
    | none => false

def «примерыВариантов» (P : «Эталон».«Программа») (f : String) (b : List String) : Bool :=
  let x := «вЁлочках» («строкаБлока» b "принцип ") 2
  («посылкиБезХодов» b).all (fun p =>
    p.«правило» ≠ "" || match «значениеВарианта» b p with
      | some u => «Эталон».«вычислимоНа» P f [(x, u)] «запасПримера» || «базаНаПути» P f x u
      | none => false)

def «вариантыВычислимы» (P : «Эталон».«Программа») (f : String) (b : List String) : Bool :=
  let x := «вЁлочках» («строкаБлока» b "принцип ") 2
  («посылкиБезХодов» b).all (fun p =>
    p.«правило» ≠ "" || match «значениеВарианта» b p with
      | some u => «Эталон».«вычислимоНа» P f [(x, u)] «запасПримера»
      | none => false)

def «судПостроения» (D : Option (Lean.Json)) («сырые» : List String) (h : String) (b : List String) :
    Option (String × String × String) :=
  match D with
  | none => none
  | some j =>
    let P := «Эталон».«программаJson» j
    let f := «вЁлочках» h 2
    let «имя» := «вЁлочках» h 1
    let «строка» := «Второй».«номерПосле» h "строка "
    let «примером» := «наПримереВарианта?» b
    if «наВариантах?» b then
      if «вариантыВычислены» P f b then
        some ("утверждение-примером", "ПРИНЯЛ", "каждый вариант без полей вычислен на своем значении")
      else none
    else if «наПравиле?» «правилоПостроения» b || «примером» then
      let K := «доводыСДном» j f
      let F := «конечныеДоводы» j f
      let S := «неотрицательныеПрограммы» P j
      if S.contains f && «Эталон».«принятьНеотрицательность» P «сырые» S f «имя» «строка» K F &&
          (!«примером» || «примерыВариантов» P f b) then
        some ("утверждение-по-построению", "ПРИНЯЛ",
          s!"{«правилоПостроения»}; доводы с дном: {K}; конечные: {F}{if !«примером» then "" else if «вариантыВычислимы» P f b then "; посылка шагом автора вычислена на значении варианта" else "; посылка шагом автора держится на пути варианта при любых прочих доводах"}")
      else none
    else if «наПорядке?» b then
      let T := «строковыеДоводы» j f
      match T.find? («Эталон».«принятьПорядок» P «сырые» f «имя» «строка» T) with
      | some t => some ("утверждение-по-построению", "ПРИНЯЛ",
          s!"{«правилоПорядка»} и {«правилоПотолка»}; длина результата не больше длины довода {t}")
      | none => none
    else if «наПравиле?» «правилоПотолка» b then
      let T := «строковыеДоводы» j f
      if «Эталон».«принятьПотолок» P «сырые» f «имя» «строка» T then
        some ("утверждение-по-построению", "ПРИНЯЛ", s!"{«правилоПотолка»}; строковые доводы: {T}")
      else none
    else if «наРазборе?» b then
      if «Эталон».«принятьРазборЦели» P «сырые» f «имя» «строка» then
        some ("утверждение-по-построению", "ПРИНЯЛ",
          s!"{«правилоРазбора»}; каждое постусловие держится на каждом пути дерева тела")
      else none
    else if «наДлинах?» b then
      if «Эталон».«принятьДлины» P false «сырые» f «имя» «строка» then
        some ("утверждение-по-построению", "ПРИНЯЛ",
          s!"{«правилоТождества»}; длины равны на каждом пути дерева тела, постусловия вызовов не нужны")
      else if «Эталон».«принятьДлины» P true «сырые» f «имя» «строка» then
        some ("утверждение-по-построению", "ПРИНЯЛ",
          s!"{«правилоТождества»}; длины равны на каждом пути дерева тела, длина вызова взята из его постусловия")
      else none
    else none

def «одна» («деревья» «метка» «исх» «зап» : String) : IO Unit := do
  if «исх» = "-" then
    IO.println s!"{«метка»}\t#нет-исходника"
    return
  let «исходник» := «историиФункциями» ((← IO.FS.readFile «исх»).splitOn "\n")
  let «текст» ← IO.FS.readFile «зап»
  let «строки» := «текст».splitOn "\n"
  let «суды» := «суждения» «исходник» «текст»
  let «утв» := «утвержденияТекстом» «текст»
  let mut «вТексте» := 0
  let mut «прочитано» := 0
  let mut «неПрочёл» := 0
  let D ← «деревоJson» «деревья» «метка»
  let P := D.map «Эталон».«программаJson»
  let «сырые» := (← IO.FS.readFile «исх»).splitOn "\n"
  for (h, b) in «утв» do
    let «имя» := «вЁлочках» h 1
    let «вид» := «видУтверждения» b
    let «построение» := if «вид» = "утверждение-посылки" || «вид» = "утверждение-на-слове" then
      «судПостроения» D «сырые» h b else none
    if let some («видП», «вердикт», «причина») := «построение» then
      IO.println s!"{«метка»}\t{«видП»}\t{«имя»}\tЧИТАЕТ\t{«вердикт»}\t{«причина»}"
    else if «вид» = "утверждение-вывод" && «проигрывается» b then
      match «суды».find? (·.«имя» = «имя») with
      | some s =>
        «вТексте» := «вТексте» + «шаговВТексте» b
        «прочитано» := «прочитано» + s.«шагов»
        if s.«вердикт» = "НЕ ПРОЧЁЛ" then «неПрочёл» := «неПрочёл» + 1
        IO.println s!"{«метка»}\t{«вид»}\t{«имя»}\tЧИТАЕТ\t{s.«вердикт»}\t{s.«почему»}"
      | none => IO.println s!"{«метка»}\t{«вид»}\t{«имя»}\tЧИТАЕТ\tНЕ ПРОЧЁЛ\tприёмка блока не нашла"
    else if «вид» = "утверждение-вывод" then
      IO.println s!"{«метка»}\tутверждение-вывод-не-проигрывается\t{«имя»}\tНЕ ЧИТАЕТ\t\t"
    else if «вид» = "утверждение-посылки" then
      let «сТеоремой» := b.any (·.startsWith "теорема «")
      let «голые» := «посылкиБезХодов» b
      let «видП» := if «голые».isEmpty then «вид» else "утверждение-посылки-без-ходов"
      let «чем» := if «голые».isEmpty then "" else
        s!"посылок без ходов {«голые».length} из {(«Второй».«посылкиБлока» b).length}, {if «сТеоремой» then "теорема есть" else "теоремы нет"}, закрыты: {", ".intercalate («голые».map (fun p => s!"{p.«закрыта»} «{p.«правило»}»")).eraseDups}; "
      IO.println s!"{«метка»}\t{«видП»}\t{«имя»}\tНЕ ЧИТАЕТ\t\t{«чем»}{«ходыБлока» b}"
    else if «вид» = "утверждение-ходы" then
      IO.println s!"{«метка»}\t{«вид»}\t{«имя»}\tНЕ ЧИТАЕТ\t\t{«ходыБлока» b}"
    else if «вид» = "утверждение-на-слове" then
      let («видС», «вердикт», «причина») := «судПримера» P «сырые» h b
      let «модель» := if «видС» = "утверждение-примером" then "ЧИТАЕТ" else "НЕ ЧИТАЕТ"
      IO.println s!"{«метка»}\t{«видС»}\t{«имя»}\t{«модель»}\t{«вердикт»}\t{«причина»}"
    else
      IO.println s!"{«метка»}\t{«вид»}\t{«имя»}\tНЕ ЧИТАЕТ\t\t"
  for (k, n, b) in «прочиеБлоки» «строки» do
    if k = "тотальность" then
      let («вид», «вердикт», «причина») := «судТотальности» P n b
      let «модель» := if «вид» = "тотальность" then "ЧИТАЕТ" else "НЕ ЧИТАЕТ"
      IO.println s!"{«метка»}\t{«вид»}\t{n}\t{«модель»}\t{«вердикт»}\t{«причина»}"
    else if k = "таблица" then
      let («вид», «вердикт», «причина») := «судТаблицы» P (← IO.FS.readFile «исх») n b
      let «модель» := if «вид» = "таблица" then "ЧИТАЕТ" else "НЕ ЧИТАЕТ"
      IO.println s!"{«метка»}\t{«вид»}\t{n}\t{«модель»}\t{«вердикт»}\t{«причина»}"
    else if k = "снятие" then
      let («вид», «вердикт», «причина») := «судСнятия» (← IO.FS.readFile «исх») «текст» b
      let «модель» := if «вид» = "снятие" then "ЧИТАЕТ" else "НЕ ЧИТАЕТ"
      IO.println s!"{«метка»}\t{«вид»}\t{n}\t{«модель»}\t{«вердикт»}\t{«причина»}"
    else
      IO.println s!"{«метка»}\t{k}\t{n}\tНЕ ЧИТАЕТ\t\t"
  let «путьВердикта» := s!"{«деревья»}/{«метка»}.verdict"
  if «деревья» ≠ "" && (← System.FilePath.pathExists «путьВердикта») then
    let «вердикт» := ((← IO.FS.readFile «путьВердикта»).splitOn "\n").headD ""
    if «вердикт» ≠ "" then IO.println s!"{«метка»}\t#вердикт\t{«вердикт»}"
  IO.println s!"{«метка»}\t#форма\tутверждений-по-шапке {«числоШапки» «строки» "утверждений "}\tблоков-утверждений {«утв».length}\tшагов-в-тексте {«вТексте»}\tшагов-прочитано {«прочитано»}\tне-прочёл {«неПрочёл»}"

theorem «принятый-блок-тотальности» (P : «Эталон».«Программа») (f : String) («названы» : List String)
    (h : «Эталон».«принятьКомпозицию» P f «названы» = true) :
    ∃ g, «Эталон».«функцияПрограммы» P f = some g ∧
      (∀ c, c ∈ «названы» ↔ c ∈ «Эталон».«зовыТела» g) ∧
      ∃ N, ∀ ρ, ∃ r, r ≠ .error .«топливо» ∧
        ∀ m, N ≤ m → «Эталон».«вызватьТело» («Эталон».«выч» P m) g ρ = r :=
  «Эталон».«композиция-завершается» P f «названы» h

theorem «принятый-блок-над-рекурсией» (P : «Эталон».«Программа») (f : String) («названы» : List String)
    (h : «Эталон».«принятьНадРекурсией» P f «названы» = true) :
    ∃ g, «Эталон».«функцияПрограммы» P f = some g ∧
      (∀ c, c ∈ «названы» ↔ c ∈ «Эталон».«зовыТела» g) ∧ f ∉ «Эталон».«зовыТела» g ∧
      ∀ ρ, ∃ N r, r ≠ .error .«топливо» ∧
        ∀ m, N ≤ m → «Эталон».«вызватьТело» («Эталон».«выч» P m) g ρ = r :=
  «Эталон».«композиция-над-рекурсией-завершается» P f «названы» h

theorem «принятый-пример» (P : «Эталон».«Программа») («строки» : List String) (f «имя» : String) («строка» N : Nat)
    (h : «Эталон».«принятьПример» P «строки» f «имя» «строка» N = true) :
    ∃ g v, «Эталон».«функцияПрограммы» P f = some g ∧ g.«параметры» = [] ∧
      «Эталон».«хозяинСтроки» «строки» «строка» = some f ∧
      («Эталон».«строкаИсходника» «строки» «строка»).startsWith ("обеспечивает «" ++ «имя» ++ "»") = true ∧
      ∀ m, N ≤ m →
        «Эталон».«вызватьТело» («Эталон».«выч» P m) g [] = .ok v ∧ «Эталон».«выч» P m [] g.«тело» = .ok v ∧
          ∀ q ∈ g.«постусловия», «Эталон».«выч» P m [(q.«связка», v)] q.«выражение» = .ok (.«признак» true) :=
  «Эталон».«пример-исчерпывает» P «строки» f «имя» «строка» N h

