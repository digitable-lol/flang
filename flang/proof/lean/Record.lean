import «Терм»

/-!
# Запись доказательства — данные Lean (ADR-0041 §2.1, веха 2)

Здесь то, что сверщик `flang/proof/checker/checker.c` читает из записи и из
исходника, когда переигрывает блок `вывод` (`проиграть_вывод`, `шаг_вывода`),
— и ТОЛЬКО это. Форма блока описана в
`docs/design/proof-object-blok-vyvoda.md` §2; `docs/flang/proof/checker/README.md`
о блоке не говорит (расхождение записано в задачу 1313 §3).

## Что моделируется и что нет — названо

Моделируется РАЗОБРАННАЯ запись: утверждение с именем, функцией, целью,
вердиктом, обязательствами входа и блоком вывода — шагами с именем правила,
формулой и основанием одного из пяти видов. Из исходника берётся то, на что
опираются основания «строка N»: допущения `требует`, объявления доводов и
тело функции одним термом.

НЕ моделируется: привязка записи к исходнику (строк, знаков, отпечатки,
SHA-256), тотальности, теоремы с ходами, посылки индукции, счёт «на слово
ядра». Соответствие ТЕКСТА записи и исходника разобранному — вне теоремы
(ADR-0041 §2.3): его делает разборщик `RecordReader.lean`, и он же — доверенная
часть наравне с моделью.

## Окружение

Γ утверждения — то, что дано: все допущения `требует` функции, дно каждого
довода, объявленного типом с дном («нат», «вес», …), обязательства входа
(6202: их несёт зовущий) и, если тело функции читается одним термом, факт
«результат равен телу». Ровно на эти факты и опираются шаги «строка N».
Сверх них — два факта языка: «числа-представимы» (О6): всякое имя, носящее число,
носит число двойной точности, и округление его не двигает; «списки-коротки» (О9):
всякое имя, носящее список, носит список короче 2⁵³ элементов.
-/

set_option linter.unusedVariables false

/-- Основание шага: «сам», «строка N», «из N», «из N M», «из N строка M»,
    «из N M K». -/
inductive «Основание» where
  | «сам»
  | «строка» (n : Nat)
  | «из» (n : Nat)
  | «из2» (n m : Nat)
  | «изСтрока» (n m : Nat)
  /-- «из N M K» — О5/О6 с прибавкой-именем: посылка порядка, дно и потолок
      прибавки (сверщик: `ОСН_ИЗ3`, задача 9616). -/
  | «из3» (n m k : Nat)
deriving DecidableEq, Repr

/-- Шаг блока: `вывод N ИМЯ ⟨Ф⟩ ОСНОВАНИЕ`. -/
structure «Шаг» where
  «номер» : Nat
  «правило» : String
  «формула» : «Форм»
  «основание» : «Основание»
  «текст» : String
deriving Repr

/-- Блок `вывод цель ⟨Ц⟩ … вывод конец`. -/
structure «Вывод» where
  «цель» : «Форм»
  «шаги» : List «Шаг»
deriving Repr

/-- Довод функции, как его читает сверщик: имя, «с дном» (Н3: «нат», «вес», …),
    «точной сетки» (Пред1: «нат», «сотых», «тысячных», …), ширина беззнакового
    слова (Сл1, Сл2: u8, u16, u32, u64 — 8, 16, 32, 64; иначе 0). -/
structure «Довод» where
  «имя» : String
  «сДном» : Bool
  «точный» : Bool
  «слово» : Nat
deriving DecidableEq, Repr

/-- Строка исходника — то, на что смотрит основание «строка N». -/
inductive «Строка» where
  /-- `требует «имя» Ф` -/
  | «требует» (f : «Форм»)
  /-- `принимает а: тип, б: тип` -/
  | «принимает» (d : List «Довод»)
  /-- строка тела (одним термом) -/
  | «тело» (t : «Тело»)
  | «иная»
deriving Repr

/-- Функция исходника, за которой записано утверждение. -/
structure «Функция» where
  «имя» : String
  /-- строки от заголовка функции до следующего заголовка, по номерам -/
  «строки» : List (Nat × «Строка»)
  /-- тело одним термом (любого сорта) и номер его строки — когда сверщик его так читает -/
  «тело» : Option (Nat × «Тело»)
deriving Repr

/-- Параметры функции по порядку — из строк `принимает` (реестр, задача 4572). -/
def «Функция».«параметры» (f : «Функция») : List String :=
  f.«строки».flatMap (fun p => match p.2 with | .«принимает» d => d.map (·.«имя») | _ => [])

/-- Функция исходника с телом одной строкой — для развёртки вызова (Разв3): имя,
    как его пишет вызов (в ёлочках), параметры по порядку, строка тела, тело. -/
structure «Определение» where
  «имя» : String
  «параметры» : List String
  «строка» : Nat
  «тело» : «Тело»
deriving Repr

/-- Постусловие, принятое РАНЬШЕ по этой же записи, — строка реестра доказанных
    постусловий (сверщик: `доказанные_свойства`, `доказано_раньше`; задача 4572):
    функция, как её пишет вызов (в ёлочках), её параметры по порядку и формула
    постусловия. Порядок записи линеен: в реестр утверждения входят только те, что
    стоят до него, — круг начаться не может. -/
structure «Постусловие» where
  «функция» : String
  «параметры» : List String
  «формула» : «Форм»
  /-- файл, в чьей записи постусловие принято: `""` — эта же запись; иначе — запись
      ввезённого модуля, проверенная раньше по порядку ввоза (`по свойству` из чужого
      модуля; сверщик: `свойство_набора`, `НАБОР_ДОКАЗАНО`). Факт от файла не зависит. -/
  «файл» : String := ""
deriving Repr

/-- `обязательство вход «Т» ⟨Ф⟩ строка N на зовущем` -/
structure «Обязательство» where
  «имя» : String
  «формула» : «Форм»
  «строка» : Nat
deriving Repr

/-- Звено разбора списка, под которым стоит вызов снятия (Зв0, задача 4024): строка
    случая «случай голова и хвост», разбираемое имя, имена головы и хвоста. -/
structure «Звено» where
  «строка» : Nat
  «список» : String
  «голова» : String
  «хвост» : String
deriving Repr

/-- Равенство звена: «Л равен приписать Г к Х». -/
def «Звено».«формула» (z : «Звено») : «Форм» :=
  .«равенС» (.«имяС» z.«список») (.«приписать» (.«имя» z.«голова») (.«имяС» z.«хвост»))

/-- Утверждение записи — постусловие функции. -/
structure «Утверждение» where
  «имя» : String
  «функция» : «Функция»
  /-- цель по исходнику: хвост `обеспечивает «имя» Ц` -/
  «цель» : «Форм»
  /-- `вердикт доказано` и прочие -/
  «вердикт» : String
  /-- есть ли под утверждением строки `посылка`/`ход` — тогда блок не проигрывается -/
  «естьПосылкиИлиХоды» : Bool
  «обязательства» : List «Обязательство»
  «вывод» : Option «Вывод»
  /-- функции исходника с телом одной строкой (Разв3) -/
  «определения» : List «Определение»
  /-- звенья разбора, охватывающие вызов снятия (Зв0); у постусловия — пусто -/
  «звенья» : List «Звено» := []
  /-- реестр доказанных постусловий: утверждения записи, принятые до этого (М2 по реестру) -/
  «реестр» : List «Постусловие» := []
deriving Repr

/-- Запись: исходник и утверждения. -/
structure «Запись» where
  «исходник» : String
  «утверждения» : List «Утверждение»
deriving Repr

/-! ## Чтение исходника из записи -/

/-- Строка N функции. -/
def «Функция».«строка» (f : «Функция») (n : Nat) : Option «Строка» :=
  (f.«строки».find? (fun p => p.1 = n)).map (·.2)

/-- Допущение строки N: `требует «имя» Ф`. -/
def «Утверждение».«допущение» (u : «Утверждение») (n : Nat) : Option «Форм» :=
  match u.«функция».«строка» n with
  | some (.«требует» f) => some f
  | _ => none

/-- Довод по имени на строке N (`принимает`). -/
def «Утверждение».«довод» (u : «Утверждение») (n : Nat) (x : String) : Option «Довод» :=
  match u.«функция».«строка» n with
  | some (.«принимает» d) => d.find? (fun v => v.«имя» = x)
  | _ => none

/-- Все допущения функции. -/
def «Утверждение».«допущения» (u : «Утверждение») : List «Форм» :=
  u.«функция».«строки».filterMap (fun p => match p.2 with | .«требует» f => some f | _ => none)

/-- Все доводы функции с дном. -/
def «Утверждение».«доводыСДном» (u : «Утверждение») : List String :=
  u.«функция».«строки».flatMap (fun p => match p.2 with
    | .«принимает» d => (d.filter (·.«сДном»)).map (·.«имя»)
    | _ => [])

/-- Все доводы функции, объявленные беззнаковым словом, с шириной слова. -/
def «Утверждение».«доводыСловом» (u : «Утверждение») : List (String × Nat) :=
  u.«функция».«строки».flatMap (fun p => match p.2 with
    | .«принимает» d => (d.filter (·.«слово» ≠ 0)).map (fun v => (v.«имя», v.«слово»))
    | _ => [])

/-! ## Окружение Γ -/

/-- Факт языка о слове (Сл1, Сл2, задача 4804): довод x объявлен беззнаковым
    словом ширины n, и «к числу x» отдаёт его значение — `toNat` некоторого
    `BitVec n`. -/
def «слово-есть» (x : String) (n : Nat) : «Факт» «Мир» :=
  fun w => ∃ b : BitVec n, «оценить» (.«кЧислу» (.«имя» x)) w = «Знач».«кон» (b.toNat : Int)

/-- Факт «результат равен телу». -/
def «результат-есть» (t : «Тело») : «Факт» «Мир» :=
  fun w => w.«имя» "результат" = «значение» t w

/-- Параметры, связанные доводами по порядку (первый заслоняет прочие). -/
def «связатьВсе» (w : «Мир») (ps : List String) (vs : List «Значение») : «Мир» :=
  (ps.zip vs).foldr (fun q w' => «связать» w' q.1 q.2) w

/-- Факт «функция равна своему телу» (Разв3): вызов с доводами числом параметров
    есть тело, где параметры носят доводы. -/
def «определение-есть» (d : «Определение») : «Факт» «Мир» :=
  fun w => ∀ vs : List «Значение», vs.length = d.«параметры».length →
    w.«функции» d.«имя» vs = «значение» d.«тело» («связатьВсе» w d.«параметры» vs)

/-- Факт языка (О6): всякое имя, носящее число, носит число двойной точности, и
    округление его не двигает (`«представимо»`). Без него модель шире языка:
    конечное значение модели — любое целое, и «Г плюс Б» могло бы округлиться
    ниже непредставимого Е. -/
def «числа-представимы» : «Факт» «Мир» :=
  fun w => ∀ x, «представимо» w.«о» («какЧисло» (w.«имя» x))

/-- Факт языка (О9, задача 1435): всякое имя, носящее список, носит список короче
    2⁵³ элементов. Счётчик «накопитель плюс 1» по такому списку не доходит до порога
    округления и потому точен на всём пути; без этого факта модель шире языка:
    список модели любой длины, и за порогом округление могло бы поднять накопитель
    выше числа пройденных элементов. -/
def «списки-коротки» : «Факт» «Мир» :=
  fun w => ∀ x, ((«какСписок» (w.«имя» x)).length : Int) < «порог»

/-- Факт реестра (задача 4572): постусловие функции держится на всяком её вызове —
    доводы по порядку на местах параметров, итог вызова на месте «результат». Факт
    берётся из записи: утверждение с этим постусловием принято РАНЬШЕ приёмкой
    модели. Что факт следует из состоятельности того утверждения, — теорема
    `«реестр-из-состоятельности»` (`Soundness.lean`) с посылкой о мире вызова. -/
def «постусловие-есть» (p : «Постусловие») : «Факт» «Мир» :=
  fun w => ∀ vs : List «Значение», vs.length = p.«параметры».length →
    «Факт-из» p.«формула» («связать» («связатьВсе» w p.«параметры» vs) "результат" (w.«функции» p.«функция» vs))

/-- Γ утверждения: допущения, дно объявленных доводов, обязательства входа,
    результат равен телу, функции исходника равны своим телам, факт языка о
    представимости чисел, слова объявленных беззнаковыми словами доводов. -/
def «окружение» (u : «Утверждение») : List («Факт» «Мир») :=
  u.«доводыСловом».map (fun q => «слово-есть» q.1 q.2) ++
  u.«допущения».map «Факт-из» ++
  u.«доводыСДном».map (fun x => «Факт-из» («≥0» (.«имя» x))) ++
  u.«обязательства».map (fun o => «Факт-из» o.«формула») ++
  (match u.«функция».«тело» with
   | some (_, t) => [«результат-есть» t]
   | none => []) ++
  u.«определения».map «определение-есть» ++
  [«числа-представимы», «списки-коротки»] ++
  (u.«звенья».map (fun z => «Факт-из» z.«формула») ++ u.«реестр».map «постусловие-есть»)

theorem «допущение-в-окружении» (u : «Утверждение») (n : Nat) (f : «Форм»)
    (h : u.«допущение» n = some f) : «Факт-из» f ∈ «окружение» u := by
  simp only [«окружение»]
  apply List.mem_append_left; apply List.mem_append_left
  apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_left
  apply List.mem_append_right
  unfold «Утверждение».«допущение» «Функция».«строка» at h
  simp only [«Утверждение».«допущения», List.mem_map, List.mem_filterMap]
  revert h
  cases hf : u.«функция».«строки».find? (fun p => p.1 = n) with
  | none => simp
  | some p =>
    simp only [Option.map_some]
    cases hp : p.2 with
    | «требует» g =>
      intro h; simp at h; subst h
      exact ⟨g, ⟨p, List.mem_of_find?_eq_some hf, by rw [hp]⟩, rfl⟩
    | «принимает» d => simp
    | «тело» t => simp
    | «иная» => simp

theorem «дно-в-окружении» (u : «Утверждение») (n : Nat) (x : String) (d : «Довод»)
    (h : u.«довод» n x = some d) (hd : d.«сДном» = true) :
    «Факт-из» («≥0» (.«имя» x)) ∈ «окружение» u := by
  simp only [«окружение»]
  apply List.mem_append_left; apply List.mem_append_left
  apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_right
  unfold «Утверждение».«довод» «Функция».«строка» at h
  simp only [«Утверждение».«доводыСДном», List.mem_map, List.mem_flatMap]
  revert h
  cases hf : u.«функция».«строки».find? (fun p => p.1 = n) with
  | none => simp
  | some p =>
    simp only [Option.map_some]
    cases hp : p.2 with
    | «принимает» ds =>
      intro h
      simp only at h
      have hdx : d.«имя» = x := by simpa using List.find?_some h
      have hmem : d ∈ ds := List.mem_of_find?_eq_some h
      refine ⟨x, ⟨p, List.mem_of_find?_eq_some hf, ?_⟩, rfl⟩
      rw [hp]
      simp only [List.mem_map, List.mem_filter]
      exact ⟨d, ⟨hmem, hd⟩, hdx⟩
    | «требует» g => simp
    | «тело» t => simp
    | «иная» => simp

theorem «обязательство-в-окружении» (u : «Утверждение») (o : «Обязательство»)
    (h : o ∈ u.«обязательства») : «Факт-из» o.«формула» ∈ «окружение» u := by
  simp only [«окружение»]
  apply List.mem_append_left; apply List.mem_append_left
  apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_right
  exact List.mem_map.mpr ⟨o, h, rfl⟩

theorem «результат-в-окружении» (u : «Утверждение») (n : Nat) (t : «Тело»)
    (h : u.«функция».«тело» = some (n, t)) : «результат-есть» t ∈ «окружение» u := by
  simp only [«окружение»]
  apply List.mem_append_left; apply List.mem_append_left
  apply List.mem_append_left; apply List.mem_append_right
  rw [h]; simp

theorem «определение-в-окружении» (u : «Утверждение») (d : «Определение»)
    (h : d ∈ u.«определения») : «определение-есть» d ∈ «окружение» u := by
  simp only [«окружение»]
  apply List.mem_append_left; apply List.mem_append_left
  apply List.mem_append_right
  exact List.mem_map.mpr ⟨d, h, rfl⟩

theorem «числа-в-окружении» (u : «Утверждение») : «числа-представимы» ∈ «окружение» u := by
  simp only [«окружение»]
  exact List.mem_append_left _ (List.mem_append_right _ List.mem_cons_self)

theorem «списки-в-окружении» (u : «Утверждение») : «списки-коротки» ∈ «окружение» u := by
  simp only [«окружение»]
  exact List.mem_append_left _ (List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_singleton.mpr rfl)))

theorem «звено-в-окружении» (u : «Утверждение») (z : «Звено») (h : z ∈ u.«звенья») :
    «Факт-из» z.«формула» ∈ «окружение» u := by
  simp only [«окружение»]
  exact List.mem_append_right _ (List.mem_append_left _ (List.mem_map.mpr ⟨z, h, rfl⟩))

theorem «постусловие-в-окружении» (u : «Утверждение») (p : «Постусловие»)
    (h : p ∈ u.«реестр») : «постусловие-есть» p ∈ «окружение» u := by
  simp only [«окружение»]
  exact List.mem_append_right _ (List.mem_append_right _ (List.mem_map.mpr ⟨p, h, rfl⟩))

theorem «слово-в-окружении» (u : «Утверждение») (n : Nat) (x : String) (d : «Довод»)
    (h : u.«довод» n x = some d) (hw : d.«слово» ≠ 0) :
    «слово-есть» x d.«слово» ∈ «окружение» u := by
  simp only [«окружение»]
  apply List.mem_append_left; apply List.mem_append_left
  apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_left
  apply List.mem_append_left
  unfold «Утверждение».«довод» «Функция».«строка» at h
  simp only [«Утверждение».«доводыСловом», List.mem_map, List.mem_flatMap]
  revert h
  cases hf : u.«функция».«строки».find? (fun p => p.1 = n) with
  | none => simp
  | some p =>
    simp only [Option.map_some]
    cases hp : p.2 with
    | «принимает» ds =>
      intro h
      simp only at h
      have hdx : d.«имя» = x := by simpa using List.find?_some h
      have hmem : d ∈ ds := List.mem_of_find?_eq_some h
      refine ⟨(x, d.«слово»), ⟨p, List.mem_of_find?_eq_some hf, ?_⟩, rfl⟩
      rw [hp]
      simp only [List.mem_map, List.mem_filter]
      exact ⟨d, ⟨hmem, by simpa using hw⟩, by rw [hdx]⟩
    | «требует» g => simp
    | «тело» t => simp
    | «иная» => simp
