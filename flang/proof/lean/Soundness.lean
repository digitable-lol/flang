import «Состоятельность»
import «RecordReader»

/-!
# Опорный сверщик состоятелен относительно модели (ADR-0193, задача 4572)

Опорная реализация сверщика — второй сверщик на Lean (`flang/proof/checker/second/`,
ADR-0076, ADR-0096): блок `вывод` он судит приёмкой модели `«принят?»`
(`Theorem.lean`, `«Суд».«выводом»`; `Sections.lean`, `«выводСнятия»`). Здесь — теоремы
о том, что это даёт:

- `«вывод-по-модели»`: принятый опорным сверщиком блок — вывод отношения `«Принят»`,
  то есть цепочка `«БлокПринят»`, где КАЖДЫЙ шаг — конструктор `«ШагПринят»` своего
  правила из закрытого списка `«правила»`, — и цель следует из окружения;
- `«запись-состоятельна»`: у записи, принятой по порядку с растущим реестром
  доказанных постусловий, цель каждого утверждения следует из его окружения;
- `«реестр-из-состоятельности»`: факт реестра о принятом утверждении следует из его
  состоятельности всюду, где окружение утверждения держится в мире вызова.

О самом коде второго сверщика — теоремы рядом с ним: `«выводом-по-модели»`
(`flang/proof/checker/second/Theorem.lean`: принятый судом блок `вывод` принят приёмкой
модели, либо — отдельной ветвью — запасным прогоном `«прогонР»`) и
`«выводСнятия-по-модели»` (`Sections.lean`: снятие блоком `вывод` принимает только
приёмка модели).

Что остаётся снаружи — не теоремой, а строкой таблицы
`flang/proof/tables/lean-soundness-debt.tsv` (сторож `lean-soundness:check`): пути
приёмки второго сверщика, у которых модели нет (ходы теорем, посылки индукции,
тотальности, снятия без блока вывода, категорные теоремы, кольцо точного целого,
крюки по телу, запасной прогон по тексту `«прогонР»`), и посылка `hcall` последней
теоремы — что окружение держится в мире вызова (допущения `требует` сняты в точке
вызова, результат равен телу): это свойство языка и записи, не приёмки. `sorry` в
модели нет: ложная или пустая формулировка под `sorry` хуже названной строки долга.
-/

namespace «Опора»

open «Разбор»

/-- Опорный сверщик принял блок вывода утверждения: приёмка модели дала «да». -/
def «принялБлок» (u : «Утверждение») : Bool := «принят?» u

/-- **Каждый шаг — применение правила модели.** Принятый опорным сверщиком блок —
    вывод отношения `«Принят»` (цепочка `«БлокПринят»` по конструкторам `«ШагПринят»`),
    и цель следует из окружения. -/
theorem «вывод-по-модели» (u : «Утверждение») (h : «принялБлок» u = true) :
    «Принят» u ∧ «Судим» («окружение» u) («Факт-из» u.«цель») :=
  ⟨«принят?-верно» u h, «состоятельность-разрешимо» u h⟩

/-- Запись принята опорным сверщиком по модели: утверждения по порядку, реестр
    каждого — постусловия принятых раньше, каждое принято приёмкой. -/
def «записьПоМодели» : List «Утверждение» → List «Постусловие» → Prop
  | [], _ => True
  | u :: r, R => u.«реестр» = R ∧ «принят?» u = true ∧ «записьПоМодели» r (R ++ [«постусловиеИз» u])

/-- Состоятельность записи: у каждого утверждения принятой записи цель следует из
    его окружения — допущений, фактов языка и реестра постусловий принятых раньше. -/
theorem «запись-состоятельна» : ∀ (us : List «Утверждение») (R : List «Постусловие»),
    «записьПоМодели» us R → ∀ u ∈ us, «Судим» («окружение» u) («Факт-из» u.«цель»)
  | [], _, _, u, hu => by simp at hu
  | v :: r, R, ⟨_, hv, hr⟩, u, hu => by
      rcases List.mem_cons.mp hu with rfl | hu'
      · exact «состоятельность-разрешимо» u hv
      · exact «запись-состоятельна» r _ hr u hu'

/-- Набор записей, принятый по модели в порядке ввоза: каждая запись принята по
    порядку (`«записьПоМодели»`), и её реестр начинается с постусловий, принятых в
    записях файлов, стоящих раньше, — с именем своего файла (`«файл»`). Так модель
    читает `по свойству` из чужого модуля: посылка «постусловие доказано в записи
    файла X» — строка реестра с `«файл» = X`, и она в реестре, только если запись X
    принята раньше. -/
def «наборПоМодели» : List (String × List «Утверждение») → List «Постусловие» → Prop
  | [], _ => True
  | (f, us) :: r, R =>
    «записьПоМодели» us R ∧ «наборПоМодели» r (R ++ us.map (fun u => { «постусловиеИз» u with «файл» := f }))

/-- **Набор записей состоятелен.** У каждого утверждения каждой записи набора, принятого
    по модели в порядке ввоза, цель следует из его окружения, куда входят и постусловия,
    принятые в записях других файлов раньше. -/
theorem «набор-состоятелен» : ∀ (fs : List (String × List «Утверждение»)) (R : List «Постусловие»),
    «наборПоМодели» fs R → ∀ fu ∈ fs, ∀ u ∈ fu.2, «Судим» («окружение» u) («Факт-из» u.«цель»)
  | [], _, _, fu, hfu => by simp at hfu
  | (f, us) :: r, R, ⟨hus, hr⟩, fu, hfu => by
      rcases List.mem_cons.mp hfu with rfl | hfu'
      · exact «запись-состоятельна» us R hus
      · exact «набор-состоятелен» r _ hr fu hfu'

/-- Факт реестра не зависит от файла, где постусловие принято. -/
theorem «постусловие-есть-без-файла» (p : «Постусловие») (f : String) :
    «постусловие-есть» { p with «файл» := f } = «постусловие-есть» p := rfl

/-- Замыкание реестра: факт реестра о принятом утверждении следует из его
    состоятельности всюду, где окружение утверждения держится в мире вызова —
    доводы на местах параметров, итог вызова на месте «результат». Посылка `hcall` —
    долг: допущения `требует` сняты в точке вызова (блоки снятия записи), результат
    равен телу (семантика вызова, `Semantics/`), дно типов доводов. -/
theorem «реестр-из-состоятельности» (u : «Утверждение») (h : «принят?» u = true) (w : «Мир»)
    (hcall : ∀ vs : List «Значение», vs.length = u.«функция».«параметры».length →
      «Выполняет» («окружение» u)
        («связать» («связатьВсе» w u.«функция».«параметры» vs) "результат"
          (w.«функции» ("«" ++ u.«функция».«имя» ++ "»") vs))) :
    «постусловие-есть» («постусловиеИз» u) w := by
  unfold «постусловие-есть» «постусловиеИз»
  intro vs hvs
  exact «состоятельность-разрешимо» u h _ (hcall vs hvs)

end «Опора»
