import «RecordReader»

/-!
# Сверка вердиктов: сверщик на C и приёмка Lean на одном наборе (ADR-0041 §2.2, веха 5)

Читает список `метка<TAB>исходник<TAB>запись`, разбирает запись (`RecordReader.lean`)
и для каждого утверждения, чей блок `вывод` сверщик проигрывает, печатает
строку `метка<TAB>утверждение<TAB>теорема<TAB>вердикт<TAB>причина`:

- `ПРИНЯЛ` — `«принят?»` дала `true`, и по теореме `«состоятельность»` цель
  следует из окружения;
- `ОТВЕРГ` — шаг, правило которого в приёмке есть, не принят, или не сошёлся
  итог блока (цель, последний шаг, гипотезы);
- `ВНЕ` — первым непринятым стоит шаг по правилу, которого в приёмке нет
  (либо Разв1 по строке тела, `«внеПриёмки»`): это непокрытость, а не расхождение;
- `НЕ ПРОЧЁЛ` — разбор не справился; это расхождение чтения, а не логики.

Сравнение с кодом сверщика делает `run.sh`. Сам этот файл вне теоремы:
он доверенный ровно настолько, насколько доверен разбор.
-/

open «Разбор»

/-- Первый непринятый шаг блока; `none` — все шаги приняты. -/
def «первыйОтказ» (u : «Утверждение») : List «Шаг» → List «Принятый» → Option «Шаг»
  | [], _ => none
  | «ш» :: «хв», «преж» =>
    if «ш».«номер» = «преж».length + 1 then
      match «шаг?» u «преж» «ш» with
      | some p => «первыйОтказ» u «хв» («преж» ++ [p])
      | none => some «ш»
    else some «ш»

def «вердикт» (u : «Утверждение») : String × String :=
  if «принят?» u then ("ПРИНЯЛ", "")
  else match u.«вывод» with
    | none => ("ОТВЕРГ", "блока нет")
    | some v =>
      match «первыйОтказ» u v.«шаги» [] with
      | some «ш» =>
        if «внеПриёмки» «ш».«правило» «ш».«основание» then ("ВНЕ", «ш».«правило»)
        else ("ОТВЕРГ", s!"шаг {«ш».«номер»} {«ш».«правило»}")
      | none =>
        if v.«цель» ≠ u.«цель» then ("ОТВЕРГ", "цель блока не та, что в исходнике")
        else ("ОТВЕРГ", "итог блока: последний шаг не цель либо гипотеза не снята")

def «одна» («метка» «исх» «зап» : String) : IO Unit := do
  let «исходник» := (← IO.FS.readFile «исх»).splitOn "\n"
  let «текст» ← IO.FS.readFile «зап»
  let «опр» := «определения» «исходник» («строкиРазв3» «текст»)
  for (h, b) in «утвержденияТекстом» «текст» do
    if !(«проигрывается» b) then continue
    let «имя» := «вЁлочках» h 1
    let «теорема» := match b.find? (·.startsWith "теорема «") with
      | some l => «вЁлочках» l 1
      | none => ""
    let (v, «почему») := match «утверждение» h b «исходник» «опр» with
      | .ok u => «вердикт» u
      | .error e => ("НЕ ПРОЧЁЛ", e)
    IO.println s!"{«метка»}\t{«имя»}\t{«теорема»}\t{v}\t{«почему»}"

def main (args : List String) : IO UInt32 := do
  match args with
  | [«список»] =>
    for l in ← IO.FS.lines «список» do
      match l.splitOn "\t" with
      | [«метка», «исх», «зап»] => «одна» «метка» «исх» «зап»
      | _ => pure ()
    pure 0
  | _ =>
    IO.eprintln "сверка: нужен один довод — файл списка «метка<TAB>исходник<TAB>запись»"
    pure 2
