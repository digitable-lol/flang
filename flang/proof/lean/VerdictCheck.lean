import «Verdicts»

/-!
# Сверка вердиктов: сверщик на C и приёмка Lean на одном наборе (ADR-0041 §2.2, веха 5)

Читает список `метка<TAB>исходник<TAB>запись`, разбирает запись (`RecordReader.lean`)
и для каждого утверждения, чей блок `вывод` сверщик проигрывает, печатает
строку `метка<TAB>утверждение<TAB>теорема<TAB>вердикт<TAB>причина`:

- `ПРИНЯЛ` — `«принят?»` дала `true`, и по теореме `«состоятельность»` цель
  следует из окружения;
- `ОТВЕРГ` — шаг не принят (правило вне закрытого списка приёмки — тоже отказ:
  список покрывает все приёмы сверщика, это стережёт `rules-guard.fscript`), или не
  сошёлся итог блока (цель, последний шаг, гипотезы);
- `ВНЕ` — первым непринятым стоит шаг вне модели (`«внеМодели»`): приём читает
  тело функции, которого читатель не собрал, либо М2 опирается на реестр доказанных
  постусловий других утверждений; это непокрытость, а не расхождение;
- `НЕ ПРОЧЁЛ` — разбор не справился; это расхождение чтения, а не логики.

Сравнение с кодом сверщика делает `run.fscript`. Сам этот файл вне теоремы:
он доверенный ровно настолько, насколько доверен разбор.
-/

open «Разбор»

def «одна» («метка» «исх» «зап» : String) : IO Unit := do
  let «исходник» := «историиФункциями» ((← IO.FS.readFile «исх»).splitOn "\n")
  let «текст» ← IO.FS.readFile «зап»
  for s in «суждения» «исходник» «текст» do
    IO.println s!"{«метка»}\t{s.«имя»}\t{s.«теорема»}\t{s.«вердикт»}\t{s.«почему»}"

def main (args : List String) : IO UInt32 := do
  match args with
  | [«список»] =>
    for l in ← IO.FS.lines «список» do
      match l.splitOn "\t" with
      | [«метка», «исх», «зап»] => «одна» «метка» «исх» «зап»
      | _ => pure ()
    pure 0
  | _ =>
    IO.eprintln "сверка: нужен один довод — файл списка «метка<TAB>исходник<TAB>запись»"
    pure 2
