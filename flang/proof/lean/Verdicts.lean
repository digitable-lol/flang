import «RecordReader»

/-!
# Вердикты приёмки по утверждениям записи

Общая точка сверки вердиктов (`VerdictCheck.lean`, `run.fscript`) и переписи блоков
(`ModelBlocks.lean`): обе читают запись одним читателем и судят одной приёмкой.
Вердикты — `ПРИНЯЛ`, `ОТВЕРГ`, `ВНЕ`, `НЕ ПРОЧЁЛ` (что они значат — шапка
`VerdictCheck.lean`). Сам этот файл вне теоремы: он доверенный ровно настолько,
насколько доверен разбор.
-/

open «Разбор»

/-- Первый непринятый шаг блока; `none` — все шаги приняты. -/
def «первыйОтказ» (u : «Утверждение») : List «Шаг» → List «Принятый» → Option «Шаг»
  | [], _ => none
  | «ш» :: «хв», «преж» =>
    if «ш».«номер» = «преж».length + 1 then
      match «шаг?» u «преж» «ш» with
      | some p => «первыйОтказ» u «хв» («преж» ++ [p])
      | none => some «ш»
    else some «ш»

def «вердикт» (u : «Утверждение») : String × String :=
  if «принят?» u then ("ПРИНЯЛ", "")
  else match u.«вывод» with
    | none => ("ОТВЕРГ", "блока нет")
    | some v =>
      match «первыйОтказ» u v.«шаги» [] with
      | some «ш» =>
        if «внеМодели» u «ш» then ("ВНЕ", «ш».«правило»)
        else ("ОТВЕРГ", s!"шаг {«ш».«номер»} {«ш».«правило»}")
      | none =>
        if v.«цель» ≠ u.«цель» then ("ОТВЕРГ", "цель блока не та, что в исходнике")
        else ("ОТВЕРГ", "итог блока: последний шаг не цель либо гипотеза не снята")

/-- Вердикт одного утверждения записи: имя, теорема, вердикт, причина, шагов
    прочитано (у непрочтённого — 0). -/
structure «Суждение» where
  «имя» : String
  «теорема» : String
  «вердикт» : String
  «почему» : String
  «шагов» : Nat

/-- Вердикты по утверждениям записи, чьи блоки `вывод` сверщик проигрывает, в
    порядке записи. Общая точка для сверки вердиктов (`run.fscript`) и переписи
    блоков (`ModelBlocks.lean`): обе читают одно и то же. -/
def «суждения» («исходник» : List String) («текст» : String) : List «Суждение» :=
  let «опр» := «определения» «исходник» («строкиРазв3» «текст»)
  -- реестр растёт по ходу записи, как в «запись»: принятое приёмкой входит в реестр следующих
  let «шаг» := fun (acc : List «Суждение» × List «Постусловие») (hb : String × List String) =>
    let (h, b) := hb
    if !(«проигрывается» b) then acc else
    let «имя» := «вЁлочках» h 1
    let «теорема» := match b.find? (·.startsWith "теорема «") with
      | some l => «вЁлочках» l 1
      | none => ""
    match «утверждение» h b «исходник» «опр» acc.2 with
    | .ok u =>
      let (v, «почему») := «вердикт» u
      (acc.1 ++ [⟨«имя», «теорема», v, «почему», (u.«вывод».map (·.«шаги».length)).getD 0⟩],
       if «принят?» u then acc.2 ++ [«постусловиеИз» u] else acc.2)
    | .error e => (acc.1 ++ [⟨«имя», «теорема», "НЕ ПРОЧЁЛ", e, 0⟩], acc.2)
  ((«утвержденияТекстом» «текст»).foldl «шаг» ([], [])).1

