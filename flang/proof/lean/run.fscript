модуль «Lean check»
  использует «Rules» из "../../../scripts/rules.fscript"
  использует «Inquiry» из "../../../scripts/inquiry.fscript"
  использует «Reading» из "../../../scripts/reading.fscript"
  использует «Tables» из "../../../scripts/tables.fscript"
  использует «Lists» только «Соединить списки»

объект «Split»
  «header»: строка
  «done»: список строки
  «current»: строка
  «started»: признак

объект «Visit»
  «dir»: строка
  «code»: строка
  «arguments»: список строки
  «kept»: список список строки

объект «Pair»
  «dir»: строка
  «source»: строка
  «proof»: строка
  «key»: строка

объект «Pairing»
  «pairs»: список «Pair»
  «keys»: список строки

объект «Section»
  «lines»: список строки
  «bad»: признак
  «fatal»: признак

объект «Report»
  «lines»: список строки
  «bad»: признак
  «stopped»: признак

объект «Tally»
  «blocks»: число
  «both»: число
  «both refused»: число
  «refused»: число
  «unread»: число
  «outside accepted»: число
  «outside refused»: число
  «outside rules»: список строки
  «disagreements»: список строки

тотальная функция «Modules»
  возвращает список список строки
  пример «Nine files in the order of their imports»
    ожидается [["Model", "Модель"], ["Rules", "Правила"], ["Term", "Терм"], ["Record", "Запись"],
      ["Acceptance", "Приёмка"], ["Consistency", "Состоятельность"], ["Half", "Половина"],
      ["RecordReader", "RecordReader"], ["VerdictCheck", "VerdictCheck"]]
  [["Model", "Модель"], ["Rules", "Правила"], ["Term", "Терм"], ["Record", "Запись"],
    ["Acceptance", "Приёмка"], ["Consistency", "Состоятельность"], ["Half", "Половина"],
    ["RecordReader", "RecordReader"], ["VerdictCheck", "VerdictCheck"]]

тотальная функция «Standard axioms»
  возвращает список строки
  пример «Three axioms every Lean proof may lean on»
    ожидается ["propext", "Classical.choice", "Quot.sound"]
  ["propext", "Classical.choice", "Quot.sound"]

тотальная функция «Wrapper»
  возвращает строка
  пример «The wrapper keeps every call of the checker»
    ожидается "d=$(mktemp -d \"$CALLS/call.XXXXXX\")\ni=0\nfor a in \"$@\"; do\n  i=$((i+1)); printf '%s\\n' \"$a\" >> \"$d/arguments\"\n  [ -f \"$a\" ] && cp \"$a\" \"$d/arg$i\"\ndone\n\"$REAL\" \"$@\" >\"$d/output\" 2>\"$d/errors\"; k=$?\necho \"$k\" > \"$d/code\"\ncat \"$d/output\"; cat \"$d/errors\" >&2\nexit $k\n"
  "d=$(mktemp -d \"$CALLS/call.XXXXXX\")\ni=0\nfor a in \"$@\"; do\n  i=$((i+1)); printf '%s\\n' \"$a\" >> \"$d/arguments\"\n  [ -f \"$a\" ] && cp \"$a\" \"$d/arg$i\"\ndone\n\"$REAL\" \"$@\" >\"$d/output\" 2>\"$d/errors\"; k=$?\necho \"$k\" > \"$d/code\"\ncat \"$d/output\"; cat \"$d/errors\" >&2\nexit $k\n"

тотальная функция «Calls script»
  возвращает строка
  пример «Every kept call is printed with its code, its arguments and its files»
    ожидается "for d in \"$1\"/call.*; do\n  [ -f \"$d/arguments\" ] || continue\n  printf '\\036 visit %s\\n' \"$d\"\n  printf '\\036 code %s\\n' \"$(cat \"$d/code\" 2>/dev/null)\"\n  cat \"$d/arguments\"\n  printf '\\036 kept\\n'\n  for f in \"$d\"/arg*; do\n    [ -f \"$f\" ] || continue\n    s=$(cksum < \"$f\" | tr ' ' _)\n    if grep -q '^ *вывод ' \"$f\"; then w=1; else w=0; fi\n    printf '%s %s %s\\n' \"${f##*/arg}\" \"$s\" \"$w\"\n  done\ndone > \"$2\"\n"
  "for d in \"$1\"/call.*; do\n  [ -f \"$d/arguments\" ] || continue\n  printf '\\036 visit %s\\n' \"$d\"\n  printf '\\036 code %s\\n' \"$(cat \"$d/code\" 2>/dev/null)\"\n  cat \"$d/arguments\"\n  printf '\\036 kept\\n'\n  for f in \"$d\"/arg*; do\n    [ -f \"$f\" ] || continue\n    s=$(cksum < \"$f\" | tr ' ' _)\n    if grep -q '^ *вывод ' \"$f\"; then w=1; else w=0; fi\n    printf '%s %s %s\\n' \"${f##*/arg}\" \"$s\" \"$w\"\n  done\ndone > \"$2\"\n"

тотальная функция «Refusals script»
  возвращает строка
  пример «The statements a checker call refused are printed with the call»
    ожидается "while IFS= read -r d; do\n  cat \"$d/output\" \"$d/errors\" | grep -o 'утверждение «[^»]*», вывод:' | sed 's/^утверждение «\\(.*\\)», вывод:$/\\1/' | sort -u | sed \"s|^|$d\t|\"\ndone < \"$1\" > \"$2\"\n"
  "while IFS= read -r d; do\n  cat \"$d/output\" \"$d/errors\" | grep -o 'утверждение «[^»]*», вывод:' | sed 's/^утверждение «\\(.*\\)», вывод:$/\\1/' | sort -u | sed \"s|^|$d\t|\"\ndone < \"$1\" > \"$2\"\n"

