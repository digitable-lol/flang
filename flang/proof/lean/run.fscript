    ожидается [запись «Question» с «name» равным "found" и «order» равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "command -v \"$0\"", "lean"]), запись «Question» с «name» равным "work" и «order» равным (вариант «Завести временный каталог» с образец равным "/srv/tmp/lean-check.")]
  [(«Run» от "found" и "sh" и ["-c", "command -v \"$0\"", («Lean» от answers)]), («Temporary directory» от "work" и (соединить [(«Setting of» от "temporary" и "/srv/tmp" и answers), "/lean-check."] по ""))]

тотальная функция «Building»
  принимает answers: список «Answer»
  возвращает список «Question»
  пример «Without a work directory nothing is built»
    дано answers равно пустой список
    ожидается пустой список
  если пусто («Work» от answers)
    то пустой список
    иначе приписать («Run» от "version" и («Lean» от answers) и ["--version"]) к (отобразить («Modules») как pair → «Run» от (соединить ["build ", («Cell» от 1 и pair)] по "") и "sh" и ["-c", "LEAN_PATH=\"$0\" exec \"$1\" -o \"$0/$2.olean\" \"$3.lean\" 2>&1", («Work» от answers), («Lean» от answers), («Cell» от 2 и pair), («Cell» от 1 и pair)])

тотальная функция «Built»
  принимает answers: список «Answer»
  возвращает признак
  пример «Nothing built is not built»
    дано answers равно пустой список
    ожидается нет
  пусто (отфильтровать («Modules») где pair → не ((«Exit code of» от (соединить ["build ", («Cell» от 1 и pair)] по "") и answers) равен 0))

тотальная функция «Trap files»
  принимает answers: список «Answer»
  возвращает список «Question»
  пример «No trap read, no trap written»
    дано answers равно пустой список
    ожидается пустой список
  пусть cutting равно («Split trap» от («Output of» от "trap" и answers))
  «Соединить списки» от (отобразить («Numbered» от (cutting.«done»)) как piece → «Write» от (соединить ["trap file ", («Cell» от 1 и piece)] по "") и («In work» от (соединить ["trap-", («Cell» от 1 и piece), ".lean"] по "") и answers) и (соединить [(cutting.«header»), («Cell» от 2 и piece)] по "")) и (отобразить («Numbered» от (cutting.«done»)) как piece → «Lean run» от (соединить ["trap ", («Cell» от 1 и piece)] по "") и (соединить ["trap-", («Cell» от 1 и piece), ".lean"] по "") и answers)

тотальная функция «Trapping»
  принимает answers: список «Answer»
  возвращает список «Question»
  пример «Nothing is tried until everything is built»
    дано answers равно пустой список
    ожидается пустой список
  пусть text равно "import «Половина»\n#print axioms «состоятельность»\n#print axioms «половина-верно»\n"
  пусть axioms равно [(«Write» от "axioms file" и («In work» от "axioms.lean" и answers) и text),
    («Lean run» от "axioms" и "axioms.lean" и answers)]
  пусть compiler равно («Setting of» от "compiler" и "cc" и answers)
  пусть build равно [(«Run» от "cc" и compiler и ["-std=c99", "-O2", "-o", («In work» от "checker" и answers),
    "../checker/checker.c"]), («Write» от "wrapper" и («In work» от "wrapper.sh" и answers) и («Wrapper»)),
    («Run» от "wrapper mode" и "chmod" и ["+x", («In work» от "wrapper.sh" и answers)])]
  пусть command равно (соединить ["mkdir -p \"$0/calls\" && CALLS=\"$0/calls\" REAL=\"$0/checker\"",
    "FLANG_CHECKER=\"$0/wrapper.sh\" FLANG_TMP=\"$0\" && export CALLS REAL FLANG_CHECKER FLANG_TMP &&",
    "exec \"$1\" io ../checker/tests/run.fscript --max-steps 4000000000 --timeout 600000 --",
    "\"$0/probes.report\" > \"$0/probes.out\" 2>&1"] по " ")
  пусть probes равно [(«Run» от "probes" и "sh" и ["-c", command, («Work» от answers), («Binary» от answers)]),
    («Read» от "report" и («In work» от "probes.report" и answers))]
  пусть calls равно [(«Write» от "calls script" и («In work» от "calls.sh" и answers) и («Calls script»)),
    («Run» от "calls" и "sh" и [(«In work» от "calls.sh" и answers), («In work» от "calls" и answers),
      («In work» от "calls.txt" и answers)]), («Read» от "calls text" и («In work» от "calls.txt" и answers))]
  пусть tail равно («Соединить списки» от build и («Соединить списки» от probes и calls))
  если не («Built» от answers)
    то пустой список
    иначе «Соединить списки» от axioms и («Соединить списки» от («Trap files» от answers) и tail)

тотальная функция «Visit of»
  принимает chunk: строка
  возвращает «Visit»
  пример «A call with its code, its arguments and its files»
    дано chunk равно "/w/calls/call.1\n\u001e code 1\na.flang\n--на-веру\nb.record\n\u001e kept\n1 7_9 0\n3 8_2 1\n"
    ожидается запись «Visit» с «dir» равным "/w/calls/call.1" и «code» равным "1" и «arguments» равным ["a.flang", "--на-веру", "b.record"] и «kept» равным [["1", "7_9", "0"], ["3", "8_2", "1"]]
  пусть halves равно (разделить chunk по "\u001e kept\n")
  пусть top равно (разделить («Cell» от 1 и halves) по "\n\u001e code ")
  пусть rest равно («Text lines» от («Cell» от 2 и top))
  запись «Visit» с «dir» равным («Cell» от 1 и top) и «code» равным («Cell» от 1 и rest) и «arguments» равным («Without first» от rest) и «kept» равным (отобразить («Text lines» от («Cell» от 2 и halves)) как line → разделить line по " ")

