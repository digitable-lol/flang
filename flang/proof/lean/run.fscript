    иначе [(«Write» от "dirs" и («In work» от "dirs" и answers) и (соединить (отобразить («Checked dirs» от («Tab rows» от («Output of» от "lean rows" и answers))) как dir → соединить [dir, "\n"] по "") по "")), («Write» от "refusals script" и («In work» от "refusals.sh" и answers) и («Refusals script»)), («Run» от "refusals" и "sh" и [(«In work» от "refusals.sh" и answers), («In work» от "dirs" и answers), («In work» от "refused.tsv" и answers)]), («Read» от "refused" и («In work» от "refused.tsv" и answers))]

