тотальная функция «In work»
  принимает name: строка, answers: список «Answer»
  возвращает строка
  пример «A file in the work directory»
    дано name равно "list"
    дано answers равно [запись «Answer» с «name» равным "work" и «reply» равным (вариант «Заведено» с путь равным "/w")]
    ожидается "/w/list"
  соединить [(«Work» от answers), "/", name] по ""

тотальная функция «Lean run»
  принимает name: строка, file: строка, answers: список «Answer»
  возвращает «Question»
  пример «Lean runs in the work directory with its modules at hand»
    дано name равно "axioms"
    дано file равно "axioms.lean"
    дано answers равно [запись «Answer» с «name» равным "work" и «reply» равным (вариант «Заведено» с путь равным "/w")]
    ожидается запись «Question» с «name» равным "axioms" и «order» равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "cd \"$0\" && LEAN_PATH=\"$0\" exec \"$1\" \"$2\" 2>&1", "/w", "lean", "axioms.lean"])
  «Run» от name и "sh" и ["-c", "cd \"$0\" && LEAN_PATH=\"$0\" exec \"$1\" \"$2\" 2>&1", («Work» от answers), («Lean» от answers), file]

тотальная функция «Split step»
  принимает cutting: «Split», line: строка
  возвращает «Split»
  пример «A marked line starts a new piece»
    дано cutting равно запись «Split» с «header» равным "h\n" и «done» равным пустой список и «current» равным "" и «started» равным нет
    дано line равно "/- ИСКАЖЕНИЕ 1"
    ожидается запись «Split» с «header» равным "h\n" и «done» равным пустой список и «current» равным "/- ИСКАЖЕНИЕ 1\n" и «started» равным да
  «Chosen» от [(«When» от ((line содержит "ИСКАЖЕНИЕ") и притом (cutting.«started»)) и (запись «Split» с «header» равным (cutting.«header») и «done» равным (добавить (cutting.«current») к (cutting.«done»)) и «current» равным (соединить [line, "\n"] по "") и «started» равным да)),
    («When» от (line содержит "ИСКАЖЕНИЕ") и (запись «Split» с «header» равным (cutting.«header») и «done» равным (cutting.«done») и «current» равным (соединить [line, "\n"] по "") и «started» равным да)),
    («When» от (cutting.«started») и (запись «Split» с «header» равным (cutting.«header») и «done» равным (cutting.«done») и «current» равным (соединить [(cutting.«current»), line, "\n"] по "") и «started» равным да))] и (запись «Split» с «header» равным (соединить [(cutting.«header»), line, "\n"] по "") и «done» равным (cutting.«done») и «current» равным "" и «started» равным нет)

тотальная функция «Text lines»
  принимает text: строка
  возвращает список строки
  пример «The line end after the last line opens no line»
    дано text равно "a\n\nb\n"
    ожидается ["a", "", "b"]
  пример «Nothing has no lines»
    дано text равно ""
    ожидается пустой список
  пусть parts равно (разделить text по "\n")
  если пусто text то пустой список иначе (если «Ends with» от text и "\n" то (свёртка parts начиная с (пустой список) как kept и part → если (длина kept) равен ((длина parts) минус 1) то kept иначе (добавить part к kept)) иначе parts)

тотальная функция «Split trap»
  принимает text: строка
  возвращает «Split»
  пример «The header and two pieces»
    дано text равно "import\n/- ИСКАЖЕНИЕ 1\nа\n/- ИСКАЖЕНИЕ 2\nб\n"
    ожидается запись «Split» с «header» равным "import\n" и «done» равным ["/- ИСКАЖЕНИЕ 1\nа\n", "/- ИСКАЖЕНИЕ 2\nб\n"] и «current» равным "" и «started» равным нет
  пусть cutting равно (свёртка («Text lines» от text) начиная с (запись «Split» с «header» равным "" и «done» равным пустой список и «current» равным "" и «started» равным нет) как cutting и line → «Split step» от cutting и line)
  запись «Split» с «header» равным (cutting.«header») и «done» равным (если cutting.«started» то (добавить (cutting.«current») к (cutting.«done»)) иначе (cutting.«done»)) и «current» равным "" и «started» равным нет

тотальная функция «Numbered»
  принимает items: список строки
  возвращает список список строки
  пример «Pieces are numbered from one»
    дано items равно ["а", "б"]
    ожидается [["1", "а"], ["2", "б"]]
  свёртка items начиная с (пустой список) как numbered и piece → добавить [(к строке ((длина numbered) плюс 1)), piece] к numbered

тотальная функция «Setup»
  возвращает список «Question»
  пример «The settings and the files read first»
    ожидается [запись «Question» с «name» равным "lean" и «order» равным (вариант «Прочитать переменную среды» с имя равным "LEAN"), запись «Question» с «name» равным "temporary" и «order» равным (вариант «Прочитать переменную среды» с имя равным "FLANG_TMP"), запись «Question» с «name» равным "compiler" и «order» равным (вариант «Прочитать переменную среды» с имя равным "CC"), запись «Question» с «name» равным "binary" и «order» равным (вариант «Прочитать переменную среды» с имя равным "FLANG_BIN"), запись «Question» с «name» равным "table" и «order» равным (вариант «Прочитать файл» с путь равным "../tables/inference-rules.tsv"), запись «Question» с «name» равным "trap" и «order» равным (вариант «Прочитать файл» с путь равным "Trap.lean"), запись «Question» с «name» равным "rules" и «order» равным (вариант «Прочитать файл» с путь равным "Rules.lean"), запись «Question» с «name» равным "term" и «order» равным (вариант «Прочитать файл» с путь равным "Term.lean")]
  [(«Environment» от "lean" и "LEAN"), («Environment» от "temporary" и "FLANG_TMP"), («Environment» от "compiler" и "CC"), («Environment» от "binary" и "FLANG_BIN"), («Read» от "table" и "../tables/inference-rules.tsv"), («Read» от "trap" и "Trap.lean"), («Read» от "rules" и "Rules.lean"), («Read» от "term" и "Term.lean")]

