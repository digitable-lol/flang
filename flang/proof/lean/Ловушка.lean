import «Модель»

/-!
# ЛОВУШКА: нарочно испорченные правила, которые Lean ОБЯЗАН отвергнуть

Этот файл НЕ ДОЛЖЕН собираться. Он и есть проверка проверки.

## Зачем он нужен

«Правила.lean» показывает, что Lean принял наши леммы. Само по себе это не
значит ничего: если перевод потерял смысл правила, Lean честно проверит не то,
что мы имели в виду, и зелёный ответ будет ложным спокойствием.

Поэтому здесь взяты те же самые определения из «Модель.lean» и записаны
испорченные правила — такие, что каждое из них ЛОЖНО. Если Lean хоть одно из
них примет, значит перевод ничего не проверяет и все подтверждения из
«Правила.lean» ничего не стоят.

Ждём РОВНО двадцать два отказа — по одному на каждую теорему ниже.

Встречные примеры ко всем одиннадцати доказаны в «Правила.lean»: там показано не
Встречные примеры ко всем двенадцати доказаны в «Правила.lean»: там показано не
только что испорченное не выводится, но и что оно ложно.
-/

open «Знач»

set_option linter.unusedVariables false

/- ИСКАЖЕНИЕ 1 — из запрета Н✗ сделано правило.
   Перечень правил: «Γ ⊢ Л минус П : неотр НЕ выводится».
   Здесь написано обратное. Ложно: 0 минус 1 отрицательно. -/
theorem «ловушка1» («о» : «Округление») (l p : «Знач»)
    (h1 : «неотр» l = true) (h2 : «неотр» p = true) :
    «неотр» («минус» «о» l p) = true := by
  cases l <;> cases p <;> simp_all [«минус», «плюс», «отр», «неотр», «чис»]

/- ИСКАЖЕНИЕ 2 — у О2 отброшена посылка.
   Перечень правил: «1) Г : неотр ЛИБО Г : кон» при заключении «Е ≤ Г» и Е = Г.
   Здесь посылки нет. Ложно: у «не числа» порядка нет вовсе. -/
theorem «ловушка2» (e : «Знач») : «неБольше» e e = true := by
  cases e <;> simp [«неБольше»]

/- ИСКАЖЕНИЕ 3 — у СС3 отброшена посылка ⟨2⟩ «Г ≤ голова Х».
   Перечень правил требует её у непустого хвоста.
   Ложно: приписать 5 к [1] — список убывает. -/
theorem «ловушка3» (g : «Знач») (x : «Список») (h1 : «неубыв» x = true) :
    «неубыв» (g :: x) = true := by
  cases x with
  | nil => rfl
  | cons b t => simp [«неубыв», h1]

/- ИСКАЖЕНИЕ 4 — у Р4 обе половины дизъюнкции положены в окружение РАЗОМ.
   Перечень правил: «половины кладутся допущением ПОРОЗНЬ, и ни одна не попадает в
   факты вместе с другой — иначе доказано было бы больше, чем дано».
   Здесь как раз вместе. -/
theorem «ловушка4» {W : Type} (Γ : List («Факт» W)) (a b c : «Факт» W)
    (h : «Судим» (a :: b :: Γ) c) :
    «Судим» ((fun w => a w ∨ b w) :: Γ) c := by
  intro w hw
  have hab : a w ∨ b w := hw (fun w => a w ∨ b w) List.mem_cons_self
  have hG : «Выполняет» Γ w := fun f hf => hw f (List.mem_cons_of_mem _ hf)
  apply h w
  intro f hf
  rcases List.mem_cons.mp hf with rfl | hf2
  · exact hab
  · rcases List.mem_cons.mp hf2 with rfl | hf3
    · exact hab
    · exact hG f hf3

/- ИСКАЖЕНИЕ 5 — у Р7 переставлены СТОРОНЫ, а не знак.
   Перечень правил: «переставляется знак, а не стороны — перестановка сторон была бы
   другим утверждением». Здесь именно она. -/
theorem «ловушка5» (g e : «Знач») (h : «неБольше» g e = true) :
    «неБольше» e g = true := by
  cases g <;> cases e <;> simp_all [«неБольше»]

/- ИСКАЖЕНИЕ 6 — у Р2 отброшена вторая посылка.
   Перечень правил требует ОБЕ: цель при У равном «да» и цель при У равном «нет».
   Здесь только первая. -/
theorem «ловушка6» {W : Type} (Γ : List («Факт» W)) (c : Bool → «Факт» W)
    (u : W → Bool) (h1 : «Судим» Γ (c true)) :
    «Судим» Γ (fun w => c (u w) w) := by
  intro w hw
  cases hb : u w
  · exact h1 w hw
  · exact h1 w hw

/- ИСКАЖЕНИЕ 7 — у О5 взята ПРЕЖНЯЯ запись перечня: у общей прибавки спрошен
   только потолок («Ш : кон»), а не число.
   Перечень правил после починки (задача 6134): «ЧИСЛОМ она быть ОБЯЗАНА, и
   одного «кон» тут мало». Ложно: при Е = −5, Г = +∞, Ш = −∞ правая сторона
   есть не-число. Встречный пример — «О5-прежняя-запись-ложна». -/
theorem «ловушка7» («о» : «Округление») (e g s : «Знач»)
    (h1 : «неБольше» e g = true) (h2 : «конечно» s = true) :
    «неБольше» («плюс» «о» e s) («плюс» «о» g s) = true := by
  cases e <;> cases g <;> cases s <;>
    simp_all [«плюс», «неБольше», «конечно», «чис»] <;>
    first
      | (apply «о».«моно»; omega)
      | (exact «подБеск» «о» _)
      | (exact «надМинусБеск» «о» _)

/- ИСКАЖЕНИЕ 8 — у Ч5 взята ПРЕЖНЯЯ запись перечня: спрошена только точность
   обоих текстов, а сама проверка начала не спрошена.
   Перечень правил после починки (задача 6134): «НАЧАЛО ПРОВЕРЯЕТСЯ, а не
   предполагается». Ложно уже на «а» и «б»; встречный пример —
   «Ч5-прежняя-запись-ложна». -/
theorem «ловушка8» (t p : «Текст») : «начинается» t p = true := by
  simp [«начинается»]

/- ИСКАЖЕНИЕ 9 — у Н12 отброшена посылка ⟨2⟩ «П ≤ К» (потолок вычитаемого).
   Перечень правил: обе посылки кладут П в [0, К], и без потолка П = Л = +∞
   проходит порядок и даёт не-число. Встречный пример — «Н12-без-потолка-ложна». -/
theorem «ловушка9» («о» : «Округление») (l p : «Знач»)
    (h1 : «неотр» p = true) (h3 : «неБольше» p l = true) :
    «неотр» («минус» «о» l p) = true := by
  unfold «минус»
  cases p <;> cases l <;> simp_all [«отр», «плюс», «неотр», «неБольше», «чис»] <;>
    exact «окр-неотр» «о» _ (by omega)

/- ИСКАЖЕНИЕ 10 — у Н12 посылка ⟨1⟩ «П : неотр» заменена на «П : кон», как
   писал ADR-0032 §2.5 («П конечно»). Ложно: «кон» модели пропускает минус
   бесконечность, и П = Л = −∞ даёт не-число. Встречный пример — «Н12-без-дна-ложна». -/
theorem «ловушка10» («о» : «Округление») (l p : «Знач») (k : Int)
    (h1 : «конечно» p = true) (h2 : «неБольше» p («кон» k) = true)
    (h3 : «неБольше» p l = true) :
    «неотр» («минус» «о» l p) = true := by
  unfold «минус»
  cases p <;> cases l <;> simp_all [«отр», «плюс», «неотр», «неБольше», «конечно», «чис»] <;>
    exact «окр-неотр» «о» _ (by omega)

/- ИСКАЖЕНИЕ 11 — у Инд1 отброшена посылка ⟨1⟩, база.
   Перечень правил: посылка ⟨1⟩ — цель на КАЖДОМ варианте без полей типа Т.
   Здесь её нет, и остался один шаг. Ложно: свойство «не есть «База»» шаг держит,
   а на «Базе» оно ложно. Встречный пример — «Инд1-без-базы-ложна». -/
theorem «ловушка11» (P : «Сумма» → Prop)
    (h2 : ∀ p, P p → P («Сумма».«Шаг» p)) : ∀ s, P s := by
  intro s; induction s with
  | «База» => skip
  | «Шаг» p ih => exact h2 p ih

/- ИСКАЖЕНИЕ 12 — у Тожд2 отброшена посылка ⟨1⟩ «0 < Т».
   Перечень правил требует строгой положительности слагаемого.
   Ложно: минус ноль плюс ноль есть плюс ноль, а «равен» их различает. -/
theorem «ловушка12» («о» : «Округление») (t : «Знач») (h2 : «представимо» «о» t) :
    «равен» («плюс» «о» t («кон» 0)) t = true := by
  cases t <;> simp_all [«плюс», «чис», «представимо», «равен»]

/- ИСКАЖЕНИЕ 13 — у Э2 свойство цели ЧУЖОЕ: отбор шёл по «p», а заключено «q».
   Перечень правил: «У и П совпадают с точностью до имени связанной».
   Здесь совпадения не спрошено. Ложно: отбор по «всегда да» оставляет элемент,
   у которого «всегда нет» ложно; встречный пример — «Э2-чужое-свойство-ложно». -/
theorem «ловушка13» (p q : «Знач» → Bool) (l : «Список») : «всеЭ» q («отбор» p l) = true := by
  rw [«всеЭ-каждый»]
  intro e he
  exact (List.mem_filter.mp he).2

/- ИСКАЖЕНИЕ 14 — у Св1 отброшена посылка У[м:=Т]: существование «выводится»
   из одного написанного свидетеля. Ложно: свойство «всегда ложь» никем не
   несётся; встречный пример — «Св1-без-посылки-ложно». -/
theorem «ловушка14» (P : «Знач» → Prop) (t : «Знач») : ∃ m, P m := ⟨t, trivial⟩

/- ИСКАЖЕНИЕ 15 — у Разв1 разбор на ЗВЕНЕ переписан ветвью «пусто».
   Перечень правил (побочные Разв1, форма выписанного списка): ветвь выбирается
   числом написанных членов — ноль даёт «пусто», иначе звено с головой и хвостом.
   Здесь звено отдано ветви «пусто». Ложно: у разбора на «h :: t» значение есть
   «звено h t», и с «пуст» оно совпадать не обязано (например, 0 против головы). -/
theorem «ловушка15» {α : Type} («пуст» : α) («звено» : «Знач» → «Список» → α)
    (h : «Знач») (t : «Список») :
    «разборСписка» «пуст» «звено» (h :: t) = «пуст» := rfl

/- ИСКАЖЕНИЕ 16 — у О6 с прибавкой-ИМЕНЕМ отброшена посылка K, потолок прибавки
   (задача 9616, `прибавка_числом` в сверщике). Одно дно конечности не даёт.
   Ложно: Е = Г = −∞, Б = +∞ — справа не-число, и сравнение с ним ложно. -/
theorem «ловушка16» («о» : «Округление») (e g b : «Знач»)
    (h1 : «неБольше» e g = true) (h2 : «неБольше» («кон» 0) b = true)
    (h4 : «представимо» «о» e) :
    «неБольше» e («плюс» «о» g b) = true := by
  cases e <;> cases g <;> cases b <;>
    simp_all [«плюс», «неБольше», «представимо», «чис»] <;>
    first
      | (exact «подБеск» «о» _)
      | (exact «надМинусБеск» «о» _)
      | (apply «о».«моно»; omega)

/- ИСКАЖЕНИЕ 17 — у Или1 правило обращено: из «Л или П» выведено Л.
   Перечень правил: посылка — половина, заключение — дизъюнкция, и никак
   иначе; дизъюнкт из дизъюнкции берётся только гипотезой ГипД, которую
   снимает Р4. Ложно: «нет или да» верно, «нет» — нет; встречный пример —
   «Или1-обращённое-ложно». -/
theorem «ловушка17» (l p : Bool) (h : (l || p) = true) : l = true := by
  simp only [Bool.or_eq_true] at h
  exact h.elim id (fun hp => by simp_all)

/- ИСКАЖЕНИЕ 18 — у Или2 разрез взят не по ВЕРХНЕМУ «или»: текст «не Л или П»
   (то есть «не ( Л или П )») разрезан по «или» внутри «не», и из П выведено
   «не ( Л или П )». Ложно при истинном П; встречный пример —
   «Или2-не-верхнее-ложно». -/
theorem «ловушка18» (l p : Bool) (h : p = true) : (!(l || p)) = true := by
  simp [h]

/- ИСКАЖЕНИЕ 19 — у И1 правило обращено: из А выведено «А и притом Б».
   Ложно: «да и притом нет» ложно; встречный пример — «И1-обращённое-ложно». -/
theorem «ловушка19» (a b : Bool) (h : a = true) : (a && b) = true := by
  simp [h]

/- ИСКАЖЕНИЕ 20 — у И2 разрез взят не по ВЕРХНЕМУ «и притом»: текст «А или Б
   и притом В» (то есть «А или ( Б и притом В )») разрезан по внутреннему «и
   притом», и выведено В. Ложно при истинном А и ложном В; встречный пример —
   «И2-не-верхнее-ложно». -/
theorem «ловушка20» (a b c : Bool) (h : (a || (b && c)) = true) : c = true := by
  simp only [Bool.or_eq_true, Bool.and_eq_true] at h
  exact h.elim (fun ha => by simp_all) And.right

/- ИСКАЖЕНИЕ 21 — у Цел1 не спрошено «Т знак в знак»: остаток от единицы взят
   от ДРУГОГО терма, а целость заключена о Т. Ложно: остаток от 0 — ноль, а Т
   — не число; встречный пример — «Цел1-чужой-терм-ложно». -/
theorem «ловушка21» (t t' : «Знач») (h : «равен» («остаток» t' («кон» 1)) («кон» 0) = true) :
    «числом» t = true := by
  cases t' <;> cases t <;> simp_all [«остаток», «равен», «числом»]

/- ИСКАЖЕНИЕ 22 — у Цел2 отброшено обязательство входа: целость выведена из
   одного имени типа. Перечень правил: «Тип целости во время работы не
   гарантирует, как не гарантирует потолка». Ложно: «не число» числом не
   бывает; встречный пример — «Цел2-без-обязательства-ложно». -/
theorem «ловушка22» (t : «Знач») : «числом» t = true := by
  cases t <;> simp [«числом»]
