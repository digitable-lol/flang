import «Приёмка»

/-!
# ЛОВУШКА: нарочно испорченные правила, которые Lean ОБЯЗАН отвергнуть

Этот файл НЕ ДОЛЖЕН собираться. Он и есть проверка проверки.

С задачи 8836 шапка берёт «Приёмка», а не одну «Модель»: искажение 23 говорит
о проверке плоскости тела у Разв2, а она живёт в приёмке. Ложное от лишнего
импорта истинным не становится.

## Зачем он нужен

«Правила.lean» показывает, что Lean принял наши леммы. Само по себе это не
значит ничего: если перевод потерял смысл правила, Lean честно проверит не то,
что мы имели в виду, и зелёный ответ будет ложным спокойствием.

Поэтому здесь взяты те же самые определения из «Модель.lean» и записаны
испорченные правила — такие, что каждое из них ЛОЖНО. Если Lean хоть одно из
них примет, значит перевод ничего не проверяет и все подтверждения из
«Правила.lean» ничего не стоят.

Ждём по отказу на каждую теорему ниже; сколько их, печатает `прогон.sh`
(«ловушка — искажений N, Lean отверг N»), а не эта строка.

Встречные примеры ко всем восемнадцати доказаны в «Правила.lean»: там показано не
только что испорченное не выводится, но и что оно ложно.
-/

open «Знач»

set_option linter.unusedVariables false

/- ИСКАЖЕНИЕ 1 — из запрета Н✗ сделано правило.
   Перечень правил: «Γ ⊢ Л минус П : неотр НЕ выводится».
   Здесь написано обратное. Ложно: 0 минус 1 отрицательно. -/
theorem «ловушка1» («о» : «Округление») (l p : «Знач»)
    (h1 : «неотр» l = true) (h2 : «неотр» p = true) :
    «неотр» («минус» «о» l p) = true := by
  cases l <;> cases p <;> simp_all [«минус», «плюс», «отр», «неотр», «чис»]

/- ИСКАЖЕНИЕ 2 — у О2 отброшена посылка.
   Перечень правил: «1) Г : неотр ЛИБО Г : кон» при заключении «Е ≤ Г» и Е = Г.
   Здесь посылки нет. Ложно: у «не числа» порядка нет вовсе. -/
theorem «ловушка2» (e : «Знач») : «неБольше» e e = true := by
  cases e <;> simp [«неБольше»]

/- ИСКАЖЕНИЕ 3 — у СС3 отброшена посылка ⟨2⟩ «Г ≤ голова Х».
   Перечень правил требует её у непустого хвоста.
   Ложно: приписать 5 к [1] — список убывает. -/
theorem «ловушка3» (g : «Знач») (x : «Список») (h1 : «неубыв» x = true) :
    «неубыв» (g :: x) = true := by
  cases x with
  | nil => rfl
  | cons b t => simp [«неубыв», h1]

/- ИСКАЖЕНИЕ 4 — у Р4 обе половины дизъюнкции положены в окружение РАЗОМ.
   Перечень правил: «половины кладутся допущением ПОРОЗНЬ, и ни одна не попадает в
   факты вместе с другой — иначе доказано было бы больше, чем дано».
   Здесь как раз вместе. -/
theorem «ловушка4» {W : Type} (Γ : List («Факт» W)) (a b c : «Факт» W)
    (h : «Судим» (a :: b :: Γ) c) :
    «Судим» ((fun w => a w ∨ b w) :: Γ) c := by
  intro w hw
  have hab : a w ∨ b w := hw (fun w => a w ∨ b w) List.mem_cons_self
  have hG : «Выполняет» Γ w := fun f hf => hw f (List.mem_cons_of_mem _ hf)
  apply h w
  intro f hf
  rcases List.mem_cons.mp hf with rfl | hf2
  · exact hab
  · rcases List.mem_cons.mp hf2 with rfl | hf3
    · exact hab
    · exact hG f hf3

/- ИСКАЖЕНИЕ 5 — у Р7 переставлены СТОРОНЫ, а не знак.
   Перечень правил: «переставляется знак, а не стороны — перестановка сторон была бы
   другим утверждением». Здесь именно она. -/
theorem «ловушка5» (g e : «Знач») (h : «неБольше» g e = true) :
    «неБольше» e g = true := by
  cases g <;> cases e <;> simp_all [«неБольше»]

/- ИСКАЖЕНИЕ 6 — у Р2 отброшена вторая посылка.
   Перечень правил требует ОБЕ: цель при У равном «да» и цель при У равном «нет».
   Здесь только первая. -/
theorem «ловушка6» {W : Type} (Γ : List («Факт» W)) (c : Bool → «Факт» W)
    (u : W → Bool) (h1 : «Судим» Γ (c true)) :
    «Судим» Γ (fun w => c (u w) w) := by
  intro w hw
  cases hb : u w
  · exact h1 w hw
  · exact h1 w hw

/- ИСКАЖЕНИЕ 7 — у О5 взята ПРЕЖНЯЯ запись перечня: у общей прибавки спрошен
   только потолок («Ш : кон»), а не число.
   Перечень правил после починки (задача 6134): «ЧИСЛОМ она быть ОБЯЗАНА, и
   одного «кон» тут мало». Ложно: при Е = −5, Г = +∞, Ш = −∞ правая сторона
   есть не-число. Встречный пример — «О5-прежняя-запись-ложна». -/
theorem «ловушка7» («о» : «Округление») (e g s : «Знач»)
    (h1 : «неБольше» e g = true) (h2 : «конечно» s = true) :
    «неБольше» («плюс» «о» e s) («плюс» «о» g s) = true := by
  cases e <;> cases g <;> cases s <;>
    simp_all [«плюс», «неБольше», «конечно», «чис»] <;>
    first
      | (apply «о».«моно»; omega)
      | (exact «подБеск» «о» _)
      | (exact «надМинусБеск» «о» _)

/- ИСКАЖЕНИЕ 8 — у Ч5 взята ПРЕЖНЯЯ запись перечня: спрошена только точность
   обоих текстов, а сама проверка начала не спрошена.
   Перечень правил после починки (задача 6134): «НАЧАЛО ПРОВЕРЯЕТСЯ, а не
   предполагается». Ложно уже на «а» и «б»; встречный пример —
   «Ч5-прежняя-запись-ложна». -/
theorem «ловушка8» (t p : «Текст») : «начинается» t p = true := by
  simp [«начинается»]

/- ИСКАЖЕНИЕ 9 — у Н12 отброшена посылка ⟨2⟩ «П ≤ К» (потолок вычитаемого).
   Перечень правил: обе посылки кладут П в [0, К], и без потолка П = Л = +∞
   проходит порядок и даёт не-число. Встречный пример — «Н12-без-потолка-ложна». -/
theorem «ловушка9» («о» : «Округление») (l p : «Знач»)
    (h1 : «неотр» p = true) (h3 : «неБольше» p l = true) :
    «неотр» («минус» «о» l p) = true := by
  unfold «минус»
  cases p <;> cases l <;> simp_all [«отр», «плюс», «неотр», «неБольше», «чис»] <;>
    exact «окр-неотр» «о» _ (by omega)

/- ИСКАЖЕНИЕ 10 — у Н12 посылка ⟨1⟩ «П : неотр» заменена на «П : кон», как
   писал ADR-0032 §2.5 («П конечно»). Ложно: «кон» модели пропускает минус
   бесконечность, и П = Л = −∞ даёт не-число. Встречный пример — «Н12-без-дна-ложна». -/
theorem «ловушка10» («о» : «Округление») (l p : «Знач») (k : Int)
    (h1 : «конечно» p = true) (h2 : «неБольше» p («кон» k) = true)
    (h3 : «неБольше» p l = true) :
    «неотр» («минус» «о» l p) = true := by
  unfold «минус»
  cases p <;> cases l <;> simp_all [«отр», «плюс», «неотр», «неБольше», «конечно», «чис»] <;>
    exact «окр-неотр» «о» _ (by omega)

/- ИСКАЖЕНИЕ 11 — у Инд1 отброшена посылка ⟨1⟩, база.
   Перечень правил: посылка ⟨1⟩ — цель на КАЖДОМ варианте без полей типа Т.
   Здесь её нет, и остался один шаг. Ложно: свойство «не есть «База»» шаг держит,
   а на «Базе» оно ложно. Встречный пример — «Инд1-без-базы-ложна». -/
theorem «ловушка11» (P : «Сумма» → Prop)
    (h2 : ∀ p, P p → P («Сумма».«Шаг» p)) : ∀ s, P s := by
  intro s; induction s with
  | «База» => skip
  | «Шаг» p ih => exact h2 p ih

/- ИСКАЖЕНИЕ 12 — у Тожд2 отброшена посылка ⟨1⟩ «0 < Т».
   Перечень правил требует строгой положительности слагаемого.
   Ложно: минус ноль плюс ноль есть плюс ноль, а «равен» их различает. -/
theorem «ловушка12» («о» : «Округление») (t : «Знач») (h2 : «представимо» «о» t) :
    «равен» («плюс» «о» t («кон» 0)) t = true := by
  cases t <;> simp_all [«плюс», «чис», «представимо», «равен»]

/- ИСКАЖЕНИЕ 13 — у Э2 свойство цели ЧУЖОЕ: отбор шёл по «p», а заключено «q».
   Перечень правил: «У и П совпадают с точностью до имени связанной».
   Здесь совпадения не спрошено. Ложно: отбор по «всегда да» оставляет элемент,
   у которого «всегда нет» ложно; встречный пример — «Э2-чужое-свойство-ложно». -/
theorem «ловушка13» (p q : «Знач» → Bool) (l : «Список») : «всеЭ» q («отбор» p l) = true := by
  rw [«всеЭ-каждый»]
  intro e he
  exact (List.mem_filter.mp he).2

/- ИСКАЖЕНИЕ 14 — у Св1 отброшена посылка У[м:=Т]: существование «выводится»
   из одного написанного свидетеля. Ложно: свойство «всегда ложь» никем не
   несётся; встречный пример — «Св1-без-посылки-ложно». -/
theorem «ловушка14» (P : «Знач» → Prop) (t : «Знач») : ∃ m, P m := ⟨t, trivial⟩

/- ИСКАЖЕНИЕ 15 — у Разв1 разбор на ЗВЕНЕ переписан ветвью «пусто».
   Перечень правил (побочные Разв1, форма выписанного списка): ветвь выбирается
   числом написанных членов — ноль даёт «пусто», иначе звено с головой и хвостом.
   Здесь звено отдано ветви «пусто». Ложно: у разбора на «h :: t» значение есть
   «звено h t», и с «пуст» оно совпадать не обязано (например, 0 против головы). -/
theorem «ловушка15» {α : Type} («пуст» : α) («звено» : «Знач» → «Список» → α)
    (h : «Знач») (t : «Список») :
    «разборСписка» «пуст» «звено» (h :: t) = «пуст» := rfl

/- ИСКАЖЕНИЕ 16 — у О6 с прибавкой-ИМЕНЕМ отброшена посылка K, потолок прибавки
   (задача 9616, `прибавка_числом` в сверщике). Одно дно конечности не даёт.
   Ложно: Е = Г = −∞, Б = +∞ — справа не-число, и сравнение с ним ложно. -/
theorem «ловушка16» («о» : «Округление») (e g b : «Знач»)
    (h1 : «неБольше» e g = true) (h2 : «неБольше» («кон» 0) b = true)
    (h4 : «представимо» «о» e) :
    «неБольше» e («плюс» «о» g b) = true := by
  cases e <;> cases g <;> cases b <;>
    simp_all [«плюс», «неБольше», «представимо», «чис»] <;>
    first
      | (exact «подБеск» «о» _)
      | (exact «надМинусБеск» «о» _)
      | (apply «о».«моно»; omega)

/- ИСКАЖЕНИЕ 17 — у Или1 правило обращено: из «Л или П» выведено Л.
   Перечень правил: посылка — половина, заключение — дизъюнкция, и никак
   иначе; дизъюнкт из дизъюнкции берётся только гипотезой ГипД, которую
   снимает Р4. Ложно: «нет или да» верно, «нет» — нет; встречный пример —
   «Или1-обращённое-ложно». -/
theorem «ловушка17» (l p : Bool) (h : (l || p) = true) : l = true := by
  simp only [Bool.or_eq_true] at h
  exact h.elim id (fun hp => by simp_all)

/- ИСКАЖЕНИЕ 18 — у Или2 разрез взят не по ВЕРХНЕМУ «или»: текст «не Л или П»
   (то есть «не ( Л или П )») разрезан по «или» внутри «не», и из П выведено
   «не ( Л или П )». Ложно при истинном П; встречный пример —
   «Или2-не-верхнее-ложно». -/
theorem «ловушка18» (l p : Bool) (h : p = true) : (!(l || p)) = true := by
  simp [h]

/- ИСКАЖЕНИЕ 19 — у И1 правило обращено: из А выведено «А и притом Б».
   Ложно: «да и притом нет» ложно; встречный пример — «И1-обращённое-ложно». -/
theorem «ловушка19» (a b : Bool) (h : a = true) : (a && b) = true := by
  simp [h]

/- ИСКАЖЕНИЕ 20 — у И2 разрез взят не по ВЕРХНЕМУ «и притом»: текст «А или Б
   и притом В» (то есть «А или ( Б и притом В )») разрезан по внутреннему «и
   притом», и выведено В. Ложно при истинном А и ложном В; встречный пример —
   «И2-не-верхнее-ложно». -/
theorem «ловушка20» (a b c : Bool) (h : (a || (b && c)) = true) : c = true := by
  simp only [Bool.or_eq_true, Bool.and_eq_true] at h
  exact h.elim (fun ha => by simp_all) And.right

/- ИСКАЖЕНИЕ 21 — у Цел1 не спрошено «Т знак в знак»: остаток от единицы взят
   от ДРУГОГО терма, а целость заключена о Т. Ложно: остаток от 0 — ноль, а Т
   — не число; встречный пример — «Цел1-чужой-терм-ложно». -/
theorem «ловушка21» (t t' : «Знач») (h : «равен» («остаток» t' («кон» 1)) («кон» 0) = true) :
    «числом» t = true := by
  cases t' <;> cases t <;> simp_all [«остаток», «равен», «числом»]

/- ИСКАЖЕНИЕ 22 — у Цел2 отброшено обязательство входа: целость выведена из
   одного имени типа. Перечень правил: «Тип целости во время работы не
   гарантирует, как не гарантирует потолка». Ложно: «не число» числом не
   бывает; встречный пример — «Цел2-без-обязательства-ложно». -/
theorem «ловушка22» (t : «Знач») : «числом» t = true := by
  cases t <;> simp [«числом»]

/- ИСКАЖЕНИЕ 23 — у Разв2 вызов ОБЪЯВЛЕННОЙ функции назван плоским телом.
   Перечень правил, строка Разв2 после задачи 8836: в теле нет вызова
   объявленной функции (имя в ёлочках с доводами, запись «» от »); разрешён
   только вызов довода-функции. Здесь «Ф» от … объявлено плоским. Ложно: при
   имени в ёлочках и непустых доводах проверка плоскости даёт «нет». -/
theorem «ловушка23» (f : String) (h : f.startsWith "«" = true) (d : «Доводы»)
    (hd : (d matches .«нет») = false) :
    «безВызоваОбъявленнойТело» (.«число» (.«вызов» f d)) = true := by
  simp [«безВызоваОбъявленнойТело», «безВызоваОбъявленной», «объявленная», h, hd]
/- ИСКАЖЕНИЕ 24 — у Э5 отброшена посылка ⟨1⟩ о голове выписанного списка.
   Перечень правил: свойство обязано быть выведено и для Х₁, и для хвоста.
   Здесь только хвост. Ложно: хвост пуст и свойство несёт, голова — нет;
   встречный пример — «Э5-без-головы-ложно». -/
theorem «ловушка24» (p : «Знач» → Bool) (x : «Знач») (t : «Список»)
    (h2 : «всеЭ» p t = true) : «всеЭ» p (x :: t) = true := by
  simp [«всеЭ», h2]

/- ИСКАЖЕНИЕ 25 — у Э6 посылка взята с ТЕМ ЖЕ предикатом, а не с П∘Ф:
   «все элементы прообраза несут П» вместо «все элементы прообраза несут П[э:=Ф]».
   Перечень правил: свойство образа берётся из свойства прообраза под ДРУГИМ
   предикатом. Ложно: неотрицательные под сменой знака дают отрицательные;
   встречный пример — «Э6-тот-же-предикат-ложно». -/
theorem «ловушка25» (p : «Знач» → Bool) (f : «Знач» → «Знач») (l : «Список»)
    (h1 : «всеЭ» p l = true) : «всеЭ» p («отобр» f l) = true := by
  rw [«всеЭ-отобр»]; exact h1

/- ИСКАЖЕНИЕ 26 — у Яр1 посылка взята о ЧУЖОЙ функции: из обещания о `g а`
   выведено обещание о `(функция «f») от а`. Перечень правил: обещание берётся у
   той функции, чей ярлык применён. Ложно: единица неотрицательна, её отрицание —
   нет; встречный пример — «Яр1-чужое-имя-ложно». -/
theorem «ловушка26» (c : «Знач» → Bool) (f g : «Знач» → «Знач») (a : «Знач»)
    (h1 : c (g a) = true) : c ((fun x => f x) a) = true := h1

/- ИСКАЖЕНИЕ 27 — у Пр1 стороны второй посылки не переставлены (ADR-0042 §2,
   задача 6812). Перечень правил: из «А меньше Б» и «Б не больше А» — что угодно.
   Здесь вторая посылка — «А не больше Б», о том же порядке, что и первая, и пара
   совместна. Ложно: «1 меньше 2» и «1 не больше 2» истинны обе — встречный
   пример «Пр1-без-перестановки-совместна» в «Правила.lean». -/
theorem «ловушка27» (a b : «Знач») (h1 : «меньше» a b = true) (h2 : «неБольше» a b = true) : False := by
  cases a <;> cases b <;> simp_all [«меньше», «неБольше»] <;> omega

/- ИСКАЖЕНИЕ 28 — у М1 отброшена единица (ADR-0042 §2, задача 6432): мера
   прибавленного списка названа мерой самого списка. Ложно на любом списке. -/
theorem «ловушка28» (e : «Знач») (l : «Список») : ((l ++ [e]).length : Int) = l.length := by
  simp

/- ИСКАЖЕНИЕ 29 — у М2 отброшена посылка «шаг растит ровно на один». Ложно:
   шаг, удваивающий накопитель, растит его на длину, а не на единицу. -/
def «свёрткаС» (s : «Список» → «Знач» → «Список») (n : «Список») : «Список» → «Список»
  | [] => n
  | h :: t => «свёрткаС» s (s n h) t
theorem «ловушка29» (s : «Список» → «Знач» → «Список») :
    ∀ l n : «Список», («свёрткаС» s n l).length = n.length + l.length := by
  intro l
  induction l with
  | nil => intro n; simp [«свёрткаС»]
  | cons h t ih => intro n; simp [«свёрткаС», ih]

/- ИСКАЖЕНИЕ 30 — у К↑ проекция отдаёт чужое поле: из пары взято второе вместо
   первого. Ложно, как только поля разные. -/
theorem «ловушка30» {α : Type} (a b : α) : (a, b).1 = b := rfl

/- ИСКАЖЕНИЕ 31 — у Разв3 довод не встал на место параметра: тело вызванной взято
   с чужим значением параметра. Ложно при любом доводе, кроме нуля. -/
def «плоское» (x : «Знач») : «Знач» := «плюс» «Грубо» x («кон» 1)
theorem «ловушка31» (d : «Знач») : «плоское» d = «плюс» «Грубо» («кон» 0) («кон» 1) := rfl

/- ИСКАЖЕНИЕ 32 — у Разв1 для суммы разбор на «Шаг» отдан ветви «База». Ложно:
   ветви разные, и значение звена с базой совпадать не обязано.
   Определение — то же, что в «Правила.lean» (видно через «Приёмка»): второе
   объявление роняло пробу раньше утверждения, и ловушка отвергалась бы и на истинном. -/
theorem «ловушка32» {α : Type} (b : α) (s : «Сумма» → α) (p : «Сумма») :
    «разборСуммы» b s (.«Шаг» p) = b := rfl

/- ИСКАЖЕНИЕ 50 — у «Выч-звено» пустой список отдан ветви звена (задача 3449). Ложно:
   у пустого списка головы нет, и ветвь звена с ветвью «пусто» совпадать не обязана;
   встречный пример — «Выч-встречный» в «Правила.lean». -/
theorem «ловушка50» {α : Type} («пуст» : α) («звено» : «Знач» → «Список» → α)
    (h : «Знач») (t : «Список») :
    «разборСписка» «пуст» «звено» [] = «звено» h t := rfl

/- ИСКАЖЕНИЕ 51 — у «Выч-звено» хвост звена потерян: ветви отдан пустой остаток. Ложно,
   как только в хвосте есть звено. -/
theorem «ловушка51» {α : Type} («пуст» : α) («звено» : «Знач» → «Список» → α)
    (h : «Знач») (t : «Список») :
    «разборСписка» «пуст» «звено» (h :: t) = «звено» h [] := rfl

/- ИСКАЖЕНИЕ 52 — у «Выч-вариант» вариант «Есть» с полем отдан ветви «Нет». Ложно:
   ветвь «Нет» поля не видит, и её значение с полем совпадать не обязано. -/
theorem «ловушка52» {α : Type} (e : «Знач» → α) (n : α) (v : «Знач») :
    «разборМожет» e n (.«Есть» v) = n := rfl

/- ИСКАЖЕНИЕ 60 — у Тожд3 связка любая, а не пустая строка (задача 7359).
   Перечень правил: склейка разложения есть сама строка ТОЛЬКО без связки.
   Ложно: «a-b» не «ab»; встречный пример — «Тожд3-со-связкой-ложна». -/
theorem «ловушка60» (t r : «Текст») : «соединитьПо» («разложить» t) r = t := by
  induction t <;> simp_all [«разложить», «соединитьПо»]

/- ИСКАЖЕНИЕ 61 — у Инд4 свёртка идёт по разложению ДРУГОЙ строки, а вывод
   сделан о Т (задача 7359). Перечень правил: список свёртки — разложение
   самой переменной индукции. Ложно: счёт знаков «Т ++ a» на пустом Т —
   единица, а не ноль; встречный пример — «Инд4-чужой-список-ложна». -/
theorem «ловушка61» {α : Type} (P : α → «Текст» → Prop) (s : α → «Текст» → α) (n : α)
    (h1 : P n []) (h2 : ∀ a p c, P a p → P (s a [c]) (p ++ [c])) (t : «Текст») :
    P ((«разложить» (t ++ ['a'])).foldl s n) t := by
  simpa using «Инд4» P s n h1 h2 t

/- ИСКАЖЕНИЕ 33 — у Т2 не спрошена свежесть имени цели (задача 3123, приёмка —
   «Т2» в «Приёмка.lean»). Перечень правил: цель — допущение с точностью до
   ИМЕНИ связывателя; переименование не смеет захватить свободное имя. Здесь
   имя цели e может стоять в свойстве допущения свободным. Ложно: «для всех э
   из [3] : э больше у» при у = 1 истинно, «для всех у из [3] : у больше у» —
   нет; встречный пример — «Т2-без-свежести-ложно» в «Терм.lean». -/
theorem «ловушка33» (Γ : List («Факт» «Мир»)) (a e : String) (l : «ТермС») (b : «Форм»)
    (hc : «Чисто» («связанныеФ» b) a (.«число» (.«имя» e)))
    (h : «Факт-из» («∀э» a l b) ∈ Γ) :
    «Выводится» Γ («∀э» e l («подстФ» b a (.«число» (.«имя» e)))) :=
  «подъём1» (fun w ha => («факт-всех» _ _ _ w).mpr (by
    rw [«всеЭ-конгр» _ (fun v => «оценитьФ» b («обновить» w a v)) _ (fun v => by
      rw [«подстановкаФ» b a (.«число» (.«имя» e)) _ hc]
      simp [«мир-с», «значение», «оценить»])]
    exact («факт-всех» _ _ _ w).mp ha)) («Т1» Γ _ h)

/- ИСКАЖЕНИЕ 34 — у Э5 посылка ⟨1⟩ взята о ЧУЖОМ члене (задача 4058, приёмка —
   «Э5»). Перечень правил: свойство выведено о ПЕРВОМ члене выписанного списка.
   Здесь — о любом y, а первым стоит x. Ложно: «0 больше 0» не следует из
   «1 больше 0»; встречный пример — «Э5-чужой-член-ложно» в «Терм.lean». -/
theorem «ловушка34» (Γ : List («Факт» «Мир»)) (e : String) (x y : «ТермЧ») (r : «Члены») (b : «Форм»)
    (hc : «Чисто» («связанныеФ» b) e (.«число» y))
    (h1 : «Выводится» Γ («подстФ» b e (.«число» y))) (h2 : «Выводится» Γ («∀э» e («хвостЧл» r) b)) :
    «Выводится» Γ («∀э» e (.«выписан» (.«ещё» x r)) b) :=
  «подъём2» (fun w ha hb => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС», «оценитьЧл»]
    have ha' : «оценитьФ» b («обновить» w e («оценить» x w)) = true := by
      have := ha; simp only [«Факт-из»] at this; rw [«подстановкаФ» b e (.«число» y) w hc] at this; exact this
    have hb' := («факт-всех» _ _ _ w).mp hb
    rw [«хвостЧл-значение»] at hb'
    exact «Э5» _ _ _ ha' hb')) h1 h2

/- ИСКАЖЕНИЕ 35 — у Э6 не спрошено, свободно ли имя элемента х в свойстве
   (задача 4058, приёмка — «Э6»). Перечень правил: подстановка заперта, если П
   упоминает х. Здесь х может стоять в свойстве свободным, и квантор посылки
   его связывает. Ложно: «для всех х из [5] : х больше 0» истинно, а «для всех
   э из ( отобразить [5] как х → х ) : х больше 0» при х = −1 — нет; встречный
   пример — «Э6-имя-элемента-в-свойстве-ложно» в «Терм.lean». -/
theorem «ловушка35» (Γ : List («Факт» «Мир»)) (e x : String) (l : «ТермС») (f : «ТермЧ») (b : «Форм»)
    (hc : «Чисто» («связанныеФ» b) e (.«число» f))
    (h : «Выводится» Γ («∀э» x l («подстФ» b e (.«число» f)))) :
    «Выводится» Γ («∀э» e (.«отобразить» l x f) b) :=
  «подъём1» (fun w ha => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    rw [«всеЭ-отобр»]
    have key : ∀ v, «оценитьФ» («подстФ» b e (.«число» f)) («обновить» w x v) =
        ((fun r => «оценитьФ» b («обновить» w e r)) ∘ (fun v => «оценить» f («обновить» w x v))) v := by
      intro v
      rw [«подстановкаФ» b e (.«число» f) _ hc]
      simp only [«мир-с», «значение», Function.comp]
      apply «согласиеФ»
      refine ⟨rfl, rfl, fun y hy => ?_⟩
      simp
    rw [← «всеЭ-конгр» _ _ _ key]
    exact («факт-всех» _ _ _ w).mp ha)) h
