/- flang/proof/ПРАВИЛА-ВЫВОДА.tsv, строка «Н12» — дословно:
   имя           Н12
   семейство     Н
   вид           правило
   правило_ядра  неотрицательность по построению
   посылки       1) П : неотр; 2) П ≤ К
   заключение    Γ ⊢ Л минус П : неотр
   побочные      в Γ стоит порядок «П не больше Л» (зеркало «Л не меньше П» приводится к нему «Зеркалом факта»), сличаемый знак в знак; К — конечный литерал; обе посылки вместе кладут П в [0, К], и обе нужны: без потолка П = Л = +∞ проходит порядок и даёт не-число, без дна — П = Л = −∞; конечность Л не спрашивается: при П в [0, К] случай Л = −∞ порядок не проходит (ADR-0032 §2.5, задача 1403)
   категорно     «минус» поднимается односторонне при записанном порядке: [0,К] × {Л : П ≤ Л} → Неотр, где вычитаемое даёт ⟨1⟩ и ⟨2⟩, а уменьшаемое приходит проекцией порядка из Γ
   конструкции   подобъект+произведение+стрелка
   входов        2
   опора         proof-kernel.flang:5910 «Разность по порядку»
   сверено       код
   ПЕРЕВОД: порядок из Γ — гипотеза h3, как у Н2 допущение; посылки — h1 и h2.
   Две леммы-соседки показывают, что каждая из посылок несёт вес: без потолка
   ложно на П = Л = +∞, без дна (при одном «кон», которое −∞ не отсекает) —
   на П = Л = −∞. ADR-0032 §2.5 писал «П конечно», но «кон» модели минус
   бесконечность пропускает (см. «конечно»), и посылкой взято дно с потолком. -/
theorem «Н12» («о» : «Округление») (l p : «Знач») (k : Int)
    (h1 : «неотр» p = true) (h2 : «неБольше» p («кон» k) = true)
    (h3 : «неБольше» p l = true) :
    «неотр» («минус» «о» l p) = true := by
  unfold «минус»
  cases p with
  | «неЧисло» => simp [«неотр»] at h1
  | «минусБеск» => simp [«неотр»] at h1
  | «плюсБеск» => simp [«неБольше»] at h2
  | «минусНоль» =>
    cases l <;> simp_all [«отр», «плюс», «неотр», «неБольше», «чис»] <;>
      exact «окр-неотр» «о» _ (by omega)
  | «кон» b =>
    have hb : 0 ≤ b := by simpa [«неотр»] using h1
    simp only [«отр»]
    split <;> cases l <;> simp_all [«плюс», «неотр», «неБольше», «чис»] <;>
      exact «окр-неотр» «о» _ (by omega)

theorem «Н12-без-потолка-ложна» : ∃ l p : «Знач»,
    «неотр» p = true ∧ «неБольше» p l = true ∧
    «неотр» («минус» «Грубо» l p) = false := by
  refine ⟨«плюсБеск», «плюсБеск», ?_, ?_, ?_⟩ <;> decide

theorem «Н12-без-дна-ложна» : ∃ l p : «Знач»,
    «конечно» p = true ∧ «неБольше» p l = true ∧
    «неотр» («минус» «Грубо» l p) = false := by
  refine ⟨«минусБеск», «минусБеск», ?_, ?_, ?_⟩ <;> decide

