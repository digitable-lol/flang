theorem «О9-шаг» (s : «Знач» → «Знач» → «Знач») (l : «Список»)
    (hs : ∀ (m : Int) x, 0 ≤ m →
      ∃ m2 : Int, s («кон» m) x = «кон» m2 ∧ 0 ≤ m2 ∧ m2 ≤ m + 1)
    (m0 : Int) (h0 : 0 ≤ m0) :
    ∃ k : Int, «свёртка» s («кон» m0) l = «кон» k ∧ 0 ≤ k ∧ k ≤ m0 + l.length := by
  induction l generalizing m0 with
  | nil => exact ⟨m0, rfl, h0, by simp⟩
  | cons hd tl ih =>
    obtain ⟨m2, he, hn, hle⟩ := hs m0 hd h0
    obtain ⟨k, hk, hk0, hk1⟩ := ih m2 hn
    refine ⟨k, ?_, hk0, ?_⟩
    · simp only [«свёртка», he]; exact hk
    · simp only [List.length_cons]; omega

