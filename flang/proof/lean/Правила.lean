theorem «СС3» (g : «Знач») (x : «Список»)
    (h1 : «неубыв» x = true)
    (h2 : ∀ b t, x = b :: t → «неБольше» g b = true) :
    «неубыв» (g :: x) = true := by
  cases x with
  | nil => rfl
  | cons b t => simp [«неубыв», h1, h2 b t rfl]

