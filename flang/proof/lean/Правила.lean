/- flang/proof/ПРАВИЛА-ВЫВОДА.tsv, строка «Ч3» — дословно:
   имя           Ч3
   семейство     Ч
   вид           правило
   правило_ядра  начало по построению
   посылки       1) Л ▷ П
   заключение    Γ ⊢ (соединить Л с Р) ▷ П
   побочные      правый кусок Р не читается вовсе — и это следствие закона, а не отдельное решение
   категорно     ассоциативность моноида: (Л·Р) = ((П·Х)·Р) = П·(Х·Р), где ⟨1⟩ даёт разложение Л = П·Х
   конструкции   объект+стрелка
   входов        1
   опора         proof-kernel.flang:6481 «Начинается по построению», случай "concat"
   сверено       код
-/
theorem «Ч3» (l r p : «Текст») (h : «начинается» l p = true) :
    «начинается» (l ++ r) p = true := by
  induction p generalizing l with
  | nil => rfl
  | cons c cs ih =>
    cases l with
    | nil => simp only [«начинается», List.isPrefixOf] at h; exact absurd h (by simp)
    | cons d ds =>
      simp only [«начинается», List.isPrefixOf, List.cons_append,
        Bool.and_eq_true] at h ⊢
      exact ⟨h.1, ih ds h.2⟩

