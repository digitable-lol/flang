theorem «Н2» {W : Type} (Γ : List («Факт» W)) (t : «Терм» W)
    (h : (fun w => «неотр» (t w) = true) ∈ Γ) :
    «Судим» Γ (fun w => «неотр» (t w) = true) := «изΓ» h

