theorem «П6» (t : «Знач») (d k : Int)
    (h1 : «неотр» t = true) (h2 : «числом» t = true) (h3 : 0 < d) (h4 : d - 1 ≤ k) :
    «неБольше» («остаток» t («кон» d)) («кон» k) = true := by
  have hd : d ≠ 0 := by omega
  cases t with
  | «неЧисло» => simp [«неотр»] at h1
  | «минусБеск» => simp [«неотр»] at h1
  | «плюсБеск» => simp [«числом»] at h2
  | «минусНоль» => simp [«остаток», hd, «неБольше»]; omega
  | «кон» a =>
    have ha : 0 ≤ a := by simpa [«неотр»] using h1
    have hlt := Int.tmod_lt_of_pos a h3
    have hge := Int.tmod_nonneg (a := a) d ha
    simp [«остаток», hd, «неБольше»]
    omega

