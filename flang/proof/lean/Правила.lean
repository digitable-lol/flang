theorem «Э4» (u : Bool) (p : «Знач» → Bool) (a b : «Список»)
    (h1 : «всеЭ» p a = true) (h2 : «всеЭ» p b = true) :
    «всеЭ» p (if u then a else b) = true := by
  cases u <;> simp [h1, h2]

