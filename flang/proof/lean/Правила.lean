/- flang/proof/ПРАВИЛА-ВЫВОДА.tsv, строка «Н5» — дословно:
   имя           Н5
   семейство     Н
   вид           правило
   правило_ядра  неотрицательность по построению
   посылки       1) Л : неотр; 2) П : неотр
   заключение    Γ ⊢ Л плюс П : неотр
   побочные      —
   категорно     «плюс» ПОДНИМАЕТСЯ на подобъект: ⁺ : Неотр×Неотр → Неотр, где левый вход даёт ⟨1⟩, правый ⟨2⟩, и i∘⁺ = плюс∘(i×i)
   конструкции   подобъект+произведение+стрелка
   входов        2
   опора         proof-kernel.flang:2325 «Обе неотрицательны»
   сверено       код
-/
theorem «Н5» («о» : «Округление») (l p : «Знач»)
    (h1 : «неотр» l = true) (h2 : «неотр» p = true) :
    «неотр» («плюс» «о» l p) = true := by
  cases l <;> cases p <;>
    simp_all [«плюс», «неотр», «чис»] <;>
    exact «окр-неотр» «о» _ (by omega)

/- flang/proof/ПРАВИЛА-ВЫВОДА.tsv, строка «Н6» — дословно:
   имя           Н6
   семейство     Н
   вид           правило
   правило_ядра  неотрицательность по построению
   посылки       1) А : неотр; 2) Б : неотр
   заключение    Γ ⊢ (если У то А иначе Б) : неотр
   побочные      —
   категорно     копара [⟨1⟩,⟨2⟩] : Γ×У + Γ×¬У → Неотр
   конструкции   копроизведение+подобъект
   входов        2
