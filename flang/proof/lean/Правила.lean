theorem «пустотаДлиной» (l : «Список») (h : l.length = 0) : l = [] := by
  cases l <;> simp_all

theorem «Р5» {α : Type} («пуст» : α) («звено» : «Знач» → «Список» → α) (l : «Список»)
    (h : l = []) : «разборСписка» «пуст» «звено» l = «пуст» := by
  subst h; rfl

