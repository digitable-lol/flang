theorem «Н6» (u : Bool) (a b : «Знач»)
    (h1 : «неотр» a = true) (h2 : «неотр» b = true) :
    «неотр» («выбор» u a b) = true := by
  cases u <;> simp [«выбор», h1, h2]

/- flang/proof/ПРАВИЛА-ВЫВОДА.tsv, строка «Н7» — дословно:
   имя           Н7
   семейство     Н
   вид           правило
   правило_ядра  неотрицательность по построению
   посылки       1) начало : неотр; 2) тело шага : неотр при неотрицательном накопителе
   заключение    Γ ⊢ (свёртка Л начиная с Н шагом Ш) : неотр
   побочные      имена накопителя и элемента непусты и различны; известное о пересвязанных именах вычёркивается («Снаружи свёртки»); список «целые» внутрь свёртки не едет вовсе
   категорно     катаморфизм в Неотр: ⟨1⟩ — база алгебры, ⟨2⟩ — её шаг
   конструкции   начальная-алгебра+подобъект
   входов        2
   опора         proof-kernel.flang:2590 «Свёртка неотрицательна»
   сверено       код
   ПЕРЕВОД: побочные условия о непустых и различных именах накопителя и
   элемента и о вычёркивании известного — о связывании имён; модель имён не
   разбирает, и эти условия в лемму не входят (см. «Чего не выразилось»).
-/
theorem «Н7» (s : «Знач» → «Знач» → «Знач») (n : «Знач») (l : «Список»)
    (h1 : «неотр» n = true)
    (h2 : ∀ a x, «неотр» a = true → «неотр» (s a x) = true) :
    «неотр» («свёртка» s n l) = true := by
  induction l generalizing n with
  | nil => simpa [«свёртка»] using h1
  | cons hd tl ih => simp only [«свёртка»]; exact ih (s n hd) (h2 n hd h1)

/- flang/proof/ПРАВИЛА-ВЫВОДА.tsv, строка «Н8» — дословно:
   имя           Н8
   семейство     Н
   вид           правило
   правило_ядра  неотрицательность по построению
   посылки       1) оба сомножителя в отрезке [0,кон]; 2) ЛИБО один сомножитель в (0,кон], а другой : неотр
   заключение    Γ ⊢ Л умножить на П : неотр
   побочные      строгую положительность не даёт ни один объявленный тип (ноль лежит и в «неотрицательное») — только названный факт «терм больше К» при К не меньше нуля; второй способ ищется в обеих позициях
   категорно     «умножить» НЕ поднимается на Неотр×Неотр: 0·∞ = не число. Поднимается ровно двумя стрелками — ⟨1⟩ на [0,кон]×[0,кон] → Неотр и ⟨2⟩ на (0,кон]×Неотр → Неотр
   конструкции   подобъект+произведение+стрелка
   входов        2
   опора         proof-kernel.flang:2516 «Умножение неотрицательно»
   сверено       код
   ПЕРЕВОД: одна строка перечня названа двумя способами — так она и
   записана («ЛИБО»), и каждый способ проверен отдельной леммой.
-/
theorem «Н8-первый» («о» : «Округление») (l p : «Знач»)
    (h1 : «неотр» l = true) (h2 : «конечно» l = true)
    (h3 : «неотр» p = true) (h4 : «конечно» p = true) :
    «неотр» («умножить» «о» l p) = true := by
  cases l <;> cases p <;>
    simp_all [«умножить», «беск», «неотр», «конечно», «чис»] <;>
    first
      | (exact «окр-неотр» «о» _ (by omega))
      | (exact «окр-неотр» «о» _ (Int.mul_nonneg (by omega) (by omega)))

theorem «Н8-второй» («о» : «Округление») (l p : «Знач»)
    (h1 : «меньше» («кон» 0) l = true) (h2 : «конечно» l = true)
    (h3 : «неотр» p = true) :
    «неотр» («умножить» «о» l p) = true := by
  obtain ⟨a, rfl, ha⟩ : ∃ a : Int, l = «кон» a ∧ 0 < a := by
    cases l <;> simp_all [«меньше», «конечно»]
  cases p with
  | «неЧисло» => simp [«неотр»] at h3
  | «минусБеск» => simp [«неотр»] at h3
  | «плюсБеск» =>
    have h0 : ¬ (a < 0) := by omega
    simp [«умножить», «беск», «знак», h0, ha, «неотр»]
  | «минусНоль» =>
    simp [«умножить», «беск», «чис»]
    exact «окр-неотр» «о» _ (by omega)
  | «кон» b =>
    have hb : 0 ≤ b := by simpa [«неотр»] using h3
    simp [«умножить», «беск», «чис»]
    exact «окр-неотр» «о» _ (Int.mul_nonneg (by omega) hb)

