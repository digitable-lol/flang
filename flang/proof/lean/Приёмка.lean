/-- Приём одного шага: имя правила выбирает проверку; имя вне списка — отказ. -/
def «шаг?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  match «имяПравила» «ш».«правило» with
  | some r => «приём» r u «преж» «ш»
  | none => none

/-- Прогон блока по шагам: номера подряд с единицы. -/
def «прогон» (u : «Утверждение») : List «Шаг» → List «Принятый» → Option (List «Принятый»)
  | [], «преж» => some «преж»
  | «ш» :: «хв», «преж» =>
    if «ш».«номер» = «преж».length + 1 then
      («шаг?» u «преж» «ш»).bind fun p => «прогон» u «хв» («преж» ++ [p])
    else none

/-- Гипотезы сняты — как у сверщика: у каждого ГипО/ГипД в блоке есть Р1/Р4/Кон2
    ниже. Для состоятельности важно другое — последний шаг без открытых
    гипотез; это условие — верность сверщику. -/
def «гипотезыСняты» («итог» : List «Принятый») : Bool :=
  «итог».all fun p =>
    if p.«правило» = "ГипО" ∨ p.«правило» = "ГипД" then
      «итог».any fun q => (q.«правило» = "Р1" ∨ q.«правило» = "Р4" ∨ q.«правило» = "Кон2") ∧ q.«номер» > p.«номер»
    else true

/-- Разрешимая приёмка утверждения. -/
def «принят?» (u : «Утверждение») : Bool :=
  match u.«вывод» with
  | none => false
  | some v =>
    match «прогон» u v.«шаги» [] with
    | none => false
    | some «итог» =>
      match «итог».getLast? with
      | none => false
      | some «посл» =>
        v.«цель» = u.«цель» ∧ «посл».«формула» = u.«цель» ∧ «посл».«откр» = [] ∧
        «гипотезыСняты» «итог» = true

/-! ## Разрешимая приёмка даёт вывод отношения -/

theorem «из1?-верно» {«преж» : List «Принятый»} {«ш» : «Шаг»} {p : «Принятый»}
    (h : «из1?» «преж» «ш» = some p) : ∃ n, «ш».«основание» = .«из» n ∧ «шагПо» «преж» n = some p := by
  unfold «из1?» at h
  split at h
  · exact ⟨_, ‹_›, h⟩
  · cases h

theorem «из2?-верно» {«преж» : List «Принятый»} {«ш» : «Шаг»} {p1 p2 : «Принятый»}
    (h : «из2?» «преж» «ш» = some (p1, p2)) :
    ∃ n m, «ш».«основание» = .«из2» n m ∧ «шагПо» «преж» n = some p1 ∧ «шагПо» «преж» m = some p2 := by
  unfold «из2?» at h
  split at h
  · rename_i n m ho
    simp only [Option.bind_eq_some_iff, Option.map_eq_some_iff] at h
    obtain ⟨q1, h1, q2, h2, hq⟩ := h
    cases hq
    exact ⟨n, m, ho, h1, h2⟩
  · cases h

theorem «строка?-верно» {«ш» : «Шаг»} {n : Nat} (h : «строка?» «ш» = some n) :
    «ш».«основание» = .«строка» n := by
  unfold «строка?» at h
  split at h
  · cases h; assumption
  · cases h

theorem «изСтрока?-верно» {«преж» : List «Принятый»} {«ш» : «Шаг»} {p : «Принятый»} {m : Nat}
    (h : «изСтрока?» «преж» «ш» = some (p, m)) :
    ∃ n, «ш».«основание» = .«изСтрока» n m ∧ «шагПо» «преж» n = some p := by
  unfold «изСтрока?» at h
  split at h
  · rename_i n m' ho
    simp only [Option.map_eq_some_iff] at h
    obtain ⟨q, hq, hqm⟩ := h
    cases hqm
    exact ⟨n, ho, hq⟩
  · cases h

section «леммы-приёмов»
variable (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») (p : «Принятый»)

theorem «Т1?-верно» (h : «Т1?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Т1") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Т1?», Option.bind_eq_some_iff, «при-some»] at h
  obtain ⟨n, hsn, f, hf, ⟨hff, hsk⟩, rfl⟩ := h
  exact .«Т1» n («строка?-верно» hsn) hn (hff ▸ hf) hsk

theorem «Кон1?-верно» (h : «Кон1?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Кон1") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Кон1?», Option.bind_eq_some_iff] at h
  obtain ⟨n, hsn, h⟩ := h
  split at h <;> try cases h
  rename_i hf1 hd
  rw [«при-some»] at h
  obtain ⟨rfl, rfl⟩ := h
  exact .«Кон1» n _ _ («строка?-верно» hsn) hn hf1 hd

theorem «Кон3?-верно» (h : «Кон3?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Кон3") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Кон3?», Option.bind_eq_some_iff] at h
  obtain ⟨q, hq, h⟩ := h
  split at h <;> try cases h
  rename_i t hf
  rw [«при-some»] at h
  obtain ⟨h1, rfl⟩ := h
  obtain ⟨n, ho, hsn⟩ := «из1?-верно» hq
  exact .«Кон3» n q t ho hn hsn hf h1

theorem «Цел1?-верно» (h : «Цел1?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Цел1") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Цел1?», Option.bind_eq_some_iff] at h
  obtain ⟨q, hq, h⟩ := h
  split at h <;> try cases h
  rename_i t a b hf hpf
  rw [«при-some»] at h
  obtain ⟨hc, rfl⟩ := h
  obtain ⟨n, ho, hsn⟩ := «из1?-верно» hq
  rcases hc with ⟨rfl, hm⟩ | ⟨rfl, hm⟩
  · exact .«Цел1» n q t a ho hn hsn hf hm (Or.inl hpf)
  · exact .«Цел1» n q t b ho hn hsn hf hm (Or.inr hpf)

theorem «Цел2?-верно» (h : «Цел2?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Цел2") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Цел2?», Option.bind_eq_some_iff] at h
  obtain ⟨n, hsn, h⟩ := h
  split at h <;> try cases h
  rename_i x hf
  simp only [Option.bind_eq_some_iff, «при-some»] at h
  obtain ⟨d, hd, ⟨ht, hob⟩, rfl⟩ := h
  exact .«Цел2» n x d («строка?-верно» hsn) hn hf hd ht hob

theorem «Св1?-верно» (h : «Св1?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Св1") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Св1?», Option.bind_eq_some_iff] at h
  obtain ⟨q, hq, h⟩ := h
  split at h <;> try cases h
  rename_i m t b hf
  rw [«при-some»] at h
  obtain ⟨⟨hz, h1⟩, rfl⟩ := h
  obtain ⟨n, ho, hsn⟩ := «из1?-верно» hq
  exact .«Св1» n q m t b ho hn hsn hf hz h1

theorem «Или1?-верно» (h : «Или1?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Или1") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Или1?», Option.bind_eq_some_iff] at h
  obtain ⟨q, hq, h⟩ := h
