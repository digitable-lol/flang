theorem «имяПравила-верно» {s : String} {r : «Правило»} (h : «имяПравила» s = some r) : r.«имя» = s := by
  have := List.find?_some h; simpa using this

/-- Шаг вне приёмки: правила нет в списке, либо Разв1 по строке тела — разбор списка
    в теле функции. Приёмка берёт Разв1 «из N» (разбор выписанного конструктора в
    самой формуле); на Разв1 «из N строка M» прогон останавливается, как на правиле
    вне списка, — это непокрытость, а не отказ (`VerdictCheck.lean`). -/
def «внеПриёмки» («правило» : String) («осн» : «Основание») : Bool :=
  («имяПравила» «правило»).isNone || («правило» == "Разв1" && «осн» matches .«изСтрока» _ _)

