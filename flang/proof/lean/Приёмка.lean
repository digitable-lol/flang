theorem «ГипД?-верно» (h : «ГипД?» u «преж» «ш» = some p) (hn : «ш».«правило» = "ГипД") : «ШагПринят» u «преж» «ш» p := by
  simp only [«ГипД?», Option.bind_eq_some_iff] at h
  obtain ⟨n, hsn, h⟩ := h
