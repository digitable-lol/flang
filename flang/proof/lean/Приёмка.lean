/-- Шаг, прошедший приём: формула, правило, номер, строка исходника (для ГипД)
    и открытые гипотезы — номер шага-гипотезы и её формула. -/
structure «Принятый» where
  «номер» : Nat
  «правило» : String
  «формула» : «Форм»
  «строка» : Nat
  «откр» : List (Nat × «Форм»)
deriving Repr

/-- К_предст = 2⁵³ − 1: постоянная представления (сверщик: `К_ПРЕДСТ`). -/
def «К-предст» : Int := «порог» - 1

/-- Гипотезы шага как факты. -/
def «гип» (o : List (Nat × «Форм»)) : List («Факт» «Мир») := o.map (fun p => «Факт-из» p.2)

/-- Формула-скаляр: сверщик не сличает скаляр с допущением (Т1). -/
def «скаляр» : «Форм» → Bool
  | .«да» => true
  | .«нет» => true
  | _ => false

/-- Вызов ОБЪЯВЛЕННОЙ функции с доводами: имя в ёлочках и хотя бы один довод —
    запись «» от » (сверщик: `содержит(тело, "» от ")`). Вызов довода-функции
    (`условие от эл`, имя без ёлочек) сюда не входит: это непрозрачное значение,
    и развёртка его не трогает (решение по задаче 8836). -/
def «объявленная» (f : String) (d : «Доводы») : Bool :=
  f.startsWith "«" && !(d matches .«нет»)

