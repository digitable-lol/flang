/-- Сколько правил покрыто приёмкой — число из шапки задачи 2907. -/
def «покрыто» : Nat := «правила».length

def «имяПравила» (s : String) : Option «Правило» := «правила».find? (fun r => r.«имя» = s)

theorem «имяПравила-верно» {s : String} {r : «Правило»} (h : «имяПравила» s = some r) : r.«имя» = s := by
  have := List.find?_some h; simpa using this

/- Приёмы по правилам. Каждый — зеркало одноимённой ветви `шаг_вывода`. -/

def «Т1?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («строка?» «ш»).bind fun n => (u.«допущение» n).bind fun f =>
    «при» (f = «ш».«формула» ∧ «скаляр» «ш».«формула» = false) («итог» «ш» [])

def «Кон1?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («строка?» «ш»).bind fun n =>
    match «ш».«формула», u.«допущение» n with
    | .«кон» t, some (.«неБольше» t' (.«лит» k)) => «при» (t = t') («итог» «ш» [])
    | _, _ => none

def «Кон3?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («из1?» «преж» «ш»).bind fun p =>
    match «ш».«формула» with
    | .«кон» t => «при» (p.«формула» = .«равен» (.«минус» t t) (.«лит» 0)) («итог» «ш» p.«откр»)
    | _ => none

/-- Мера Цел1: «Т остаток от 1» с прибавкой «плюс 0» или без. -/
def «мераЦел» (t m : «ТермЧ») : Prop :=
  m = .«остаток» t (.«лит» 1) ∨ m = .«плюс» (.«остаток» t (.«лит» 1)) (.«лит» 0)

instance (t m : «ТермЧ») : Decidable («мераЦел» t m) := by unfold «мераЦел»; infer_instance

def «Цел1?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («из1?» «преж» «ш»).bind fun p =>
    match «ш».«формула», p.«формула» with
    | .«цел» t, .«равен» a b =>
      «при» ((b = .«лит» 0 ∧ «мераЦел» t a) ∨ (a = .«лит» 0 ∧ «мераЦел» t b)) («итог» «ш» p.«откр»)
    | _, _ => none

def «Цел2?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («строка?» «ш»).bind fun n =>
    match «ш».«формула» with
    | .«цел» (.«имя» x) =>
      (u.«довод» n x).bind fun d =>
        «при» (d.«точный» = true ∧ «естьОбязательство» u x (.«цел» (.«имя» x)) n) («итог» «ш» [])
    | _ => none

