def «ГипО?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  «при» («ш».«основание» = .«сам») («итог» «ш» [(«ш».«номер», «ш».«формула»)])

def «ГипД?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («строка?» «ш»).bind fun n =>
    match u.«допущение» n with
    | some (.«или» l r) => «при» («ш».«формула» = l ∨ «ш».«формула» = r)
        ⟨«ш».«номер», «ш».«правило», «ш».«формула», n, [(«ш».«номер», «ш».«формула»)]⟩
    | _ => none

def «Р1?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («из2?» «преж» «ш»).bind fun (ph, pm) =>
    match «ш».«формула» with
    | .«еслиФ» c q .«да» =>
      «при» (ph.«правило» = "ГипО" ∧ ph.«формула» = c ∧ pm.«формула» = q ∧
             ∀ p ∈ pm.«откр», p.1 = ph.«номер» ∧ p.2 = c) («итог» «ш» [])
    | _ => none

def «Р4?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («из2?» «преж» «ш»).bind fun (p1, p2) =>
    («единственная» p1.«откр»).bind fun a => («единственная» p2.«откр»).bind fun b =>
    («шагПо» «преж» a.1).bind fun pa => («шагПо» «преж» b.1).bind fun pb =>
    match u.«допущение» pa.«строка» with
    | some (.«или» l r) =>
      «при» (p1.«формула» = «ш».«формула» ∧ p2.«формула» = «ш».«формула» ∧ a.1 ≠ b.1 ∧
             pa.«правило» = "ГипД" ∧ pb.«правило» = "ГипД" ∧ pb.«строка» = pa.«строка» ∧
             a.2 = pa.«формула» ∧ b.2 = pb.«формула» ∧
             ((pa.«формула» = l ∧ pb.«формула» = r) ∨ (pa.«формула» = r ∧ pb.«формула» = l)))
        («итог» «ш» [])
    | _ => none

