theorem «Н7?-верно» (h : «Н7?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Н7") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Н7?», Option.bind_eq_some_iff] at h
  obtain ⟨q, hq, h⟩ := h
  split at h <;> try cases h
  rename_i l n0 a e s hf
  rw [«при-some»] at h
  obtain ⟨⟨hae, hs, hp1⟩, rfl⟩ := h
  obtain ⟨n, ho, hsn⟩ := «из1?-верно» hq
  exact .«Н7» n q l n0 a e s ho hn hsn hf hae hs hp1

end «леммы-приёмов»

