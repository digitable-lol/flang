import «Запись»

/-!
# Приёмка: «Принят» и разрешимая «принят?» (ADR-0041 §2.1–2.2, веха 3)

Отношение `«ШагПринят»` — по конструктору на правило, и у каждого те же
побочные условия, что у одноимённого приёма в `шаг_вывода`
(`flang/proof/чекер/сверщик.c`): вид основания, сличение формул, подстановка
без захвата. Функция `«шаг?»` — разрешимая проверка тех же условий; лемма
«шаг?-верно» показывает, что она даёт вывод отношения. На весь блок: `«Принят»`
и `«принят?»`, теорема «принят?-верно».

## Что покрыто — считано, а не сказано

Из тринадцати именованных приёмов `шаг_вывода` (ГипД ГипО И1 И2 Или1 Или2 Кон1
Кон3 Разв2 Св1 Т1 Цел1 Цел2) здесь **все 13**. Цел1 и Цел2 — с задачи 3855:
«Т : цел» в модели есть «числом» (`Терм.lean`, граница 3), и лемма проверяет
правило на бесконечностях и не-числе, а на дробях — нет. Из семейных
приёмов — Р1, Р4, Н1–Н5, Н9, Н12, Пред1, П1, П2, П3, П5, Э1–Э4: ещё **18**.
Итого правил в приёмке **31** из 70 приёмов `шаг_вывода`; список закрыт — имя вне списка даёт отказ, как и
в сверщике имя вне его списка.

Чего нет и почему: Выч, Р2, Р3 — вычислитель половин (`половина_закрыта`),
модель его не воспроизводит; Р5, Р6 и О7–О9 читают тело; Н7, Н8, Н10, П6 и
семейства Д, О, С, СС, В, Ч — леммы в `Правила.lean` есть, приём здесь ещё не
написан (число растёт по одному, ADR-0041 §2.4 п.3).

## Где модель СТРОЖЕ сверщика — названо, а не спрятано

1. Разв2: подстановка тела вместо «результат» спрашивает захват
   (`захват?`), как у Св1/Э3; сверщик у Разв2 захвата не спрашивает.
2. Э2: имя цели E не должно быть свободным в условии отбора (или совпадать с
   X); сверщик этого не спрашивает.
3. П5: потолок K не выше 2⁵³ — так требует лемма «П5» (округление не двигает
   K); сверщик берёт любой целый литерал.
Каждое место — кандидат в расхождение сверки вердиктов (`прогон.sh`); на
наборе проб сверщика (1291 блок, 14 сентября 2026) ни одно вердикта не развело.

## Сличение

Сверщик сличает ТЕКСТ формул знак в знак; здесь сличаются РАЗОБРАННЫЕ формулы
(равенство термов). Два текста с одним деревом («( а ) не больше б» и
«а не больше б») здесь равны, у сверщика — нет. Это делает модель мягче
сверщика ровно на лишних скобках и ничему не вредит: теорема состоятельности
говорит о дереве.
-/

set_option linter.unusedVariables false

open «Знач»

/-- Шаг, прошедший приём: формула, правило, номер, строка исходника (для ГипД)
    и открытые гипотезы — номер шага-гипотезы и её формула. -/
structure «Принятый» where
  «номер» : Nat
  «правило» : String
  «формула» : «Форм»
  «строка» : Nat
  «откр» : List (Nat × «Форм»)
deriving Repr

/-- К_предст = 2⁵³ − 1: постоянная представления (сверщик: `К_ПРЕДСТ`). -/
def «К-предст» : Int := «порог» - 1

/-- Гипотезы шага как факты. -/
def «гип» (o : List (Nat × «Форм»)) : List («Факт» «Мир») := o.map (fun p => «Факт-из» p.2)

/-- Формула-скаляр: сверщик не сличает скаляр с допущением (Т1). -/
def «скаляр» : «Форм» → Bool
  | .«да» => true
  | .«нет» => true
  | _ => false

/- В терме нет вызова (Разв2 берёт ПЛОСКОЕ тело). -/
mutual
def «безВызова» : «ТермЧ» → Bool
  | .«лит» _ => true
  | .«имя» _ => true
  | .«плюс» a b => «безВызова» a && «безВызова» b
  | .«минус» a b => «безВызова» a && «безВызова» b
  | .«умножить» a b => «безВызова» a && «безВызова» b
  | .«остаток» a b => «безВызова» a && «безВызова» b
  | .«если» u a b => «безВызоваФ» u && «безВызова» a && «безВызова» b
  | .«длина» l => «безВызоваС» l
  | .«кодСимвола» t => «безВызоваТ» t
  | .«свёртка» l n _ _ s => «безВызоваС» l && «безВызова» n && «безВызова» s
  | .«разбор» l p _ _ z => «безВызоваС» l && «безВызова» p && «безВызова» z
  | .«вызов» _ _ => false
def «безВызоваС» : «ТермС» → Bool
  | .«пустой» => true
  | .«имяС» _ => true
  | .«выписан» d => «безВызоваЧл» d
  | .«приписать» e l => «безВызова» e && «безВызоваС» l
  | .«добавить» e l => «безВызова» e && «безВызоваС» l
  | .«отбор» l _ u => «безВызоваС» l && «безВызоваФ» u
  | .«еслиС» u a b => «безВызоваФ» u && «безВызоваС» a && «безВызоваС» b
  | .«вызовС» _ _ => false
def «безВызоваТ» : «ТермТ» → Bool
  | .«литТ» _ => true
  | .«имяТ» _ => true
  | .«склейка» l r => «безВызоваТ» l && «безВызоваТ» r
  | .«еслиТ» u a b => «безВызоваФ» u && «безВызоваТ» a && «безВызоваТ» b
  | .«вызовТ» _ _ => false
def «безВызоваФ» : «Форм» → Bool
  | .«да» => true
  | .«нет» => true
  | .«имяФ» _ => true
  | .«неБольше» a b => «безВызова» a && «безВызова» b
  | .«неМеньше» a b => «безВызова» a && «безВызова» b
  | .«меньше» a b => «безВызова» a && «безВызова» b
  | .«больше» a b => «безВызова» a && «безВызова» b
  | .«равен» a b => «безВызова» a && «безВызова» b
  | .«равенС» a b => «безВызоваС» a && «безВызоваС» b
  | .«равенТ» a b => «безВызоваТ» a && «безВызоваТ» b
  | .«содержит» l e => «безВызоваС» l && «безВызова» e
  | .«неУбывает» l => «безВызоваС» l
  | .«пусто» l => «безВызоваС» l
  | .«пустоТ» t => «безВызоваТ» t
  | .«начинается» t p => «безВызоваТ» t && «безВызоваТ» p
  | .«кон» t => «безВызова» t
  | .«цел» t => «безВызова» t
  | .«помещается» t => «безВызова» t
  | .«всех» _ l u => «безВызоваС» l && «безВызоваФ» u
  | .«есть» _ t u => «безВызова» t && «безВызоваФ» u
  | .«и» a b => «безВызоваФ» a && «безВызоваФ» b
  | .«или» a b => «безВызоваФ» a && «безВызоваФ» b
  | .«не» a => «безВызоваФ» a
  | .«еслиФ» u a b => «безВызоваФ» u && «безВызоваФ» a && «безВызоваФ» b
  | .«вызовФ» _ _ => false
def «безВызоваТело» : «Тело» → Bool
  | .«число» t => «безВызова» t
  | .«список» l => «безВызоваС» l
  | .«текст» t => «безВызоваТ» t
  | .«признак» u => «безВызоваФ» u
def «безВызоваД» : «Доводы» → Bool
  | .«нет» => true
  | .«ещё» t r => «безВызоваТело» t && «безВызоваД» r
def «безВызоваЧл» : «Члены» → Bool
  | .«нет» => true
  | .«ещё» t r => «безВызова» t && «безВызоваЧл» r
end

/-- Единственная гипотеза списка (Р4: случай стоит на ОДНОЙ гипотезе). -/
def «единственная» : List (Nat × «Форм») → Option (Nat × «Форм»)
  | [] => none
  | p :: r => if r.all (fun q => q.1 = p.1 ∧ q.2 = p.2) then some p else none

theorem «единственная-все» {o : List (Nat × «Форм»)} {p : Nat × «Форм»}
    (h : «единственная» o = some p) : o ≠ [] ∧ ∀ q ∈ o, q.2 = p.2 := by
  cases o with
  | nil => simp [«единственная»] at h
  | cons a r =>
    simp only [«единственная»] at h
    split at h
    · rename_i hall
      cases h
      refine ⟨by simp, fun q hq => ?_⟩
      rcases List.mem_cons.mp hq with rfl | hq
      · rfl
      · exact (List.all_eq_true.mp hall q hq |> of_decide_eq_true).2
    · cases h

/-- Выписанный список без пар соседей: пустой либо из одного члена (СС1,
    сверщик: `члены_списка_вывода`, членов не больше одного). -/
def «безСоседей» : «ТермС» → Bool
  | .«пустой» => true
  | .«выписан» .«нет» => true
  | .«выписан» (.«ещё» _ .«нет») => true
  | _ => false

theorem «безСоседей-верно» {l : «ТермС»} (h : «безСоседей» l = true) :
    l = .«пустой» ∨ l = .«выписан» .«нет» ∨ ∃ t, l = .«выписан» (.«ещё» t .«нет») := by
  cases l with
  | «пустой» => exact Or.inl rfl
  | «выписан» d =>
    cases d with
    | «нет» => exact Or.inr (Or.inl rfl)
    | «ещё» t r =>
      cases r with
      | «нет» => exact Or.inr (Or.inr ⟨t, rfl⟩)
      | «ещё» _ _ => simp [«безСоседей»] at h
  | _ => simp [«безСоседей»] at h

/-- Порядок формулы: «Е не больше Г» либо «Г не меньше Е» — одна форма, пара
    (Е, Г) (сверщик: `порядок_вывода`). -/
def «порядок?» : «Форм» → Option («ТермЧ» × «ТермЧ»)
  | .«неБольше» e g => some (e, g)
  | .«неМеньше» g e => some (e, g)
  | _ => none

/-- Терм — член выписанного списка знак в знак (В1). -/
def «вЧленах» (e : «ТермЧ») : «Члены» → Bool
  | .«нет» => false
  | .«ещё» t r => decide (t = e) || «вЧленах» e r

/-- Строгий порядок формулы: «Е меньше Г» либо «Г больше Е» — одна форма, пара
    (Е, Г) (сверщик: `строгий_вывода`). -/
def «строгий?» : «Форм» → Option («ТермЧ» × «ТермЧ»)
  | .«меньше» e g => some (e, g)
  | .«больше» g e => some (e, g)
  | _ => none

/-- Посылка О2: «Г не меньше 0», «Г не больше ⟨литерал⟩» либо «Г : кон» шагом
    Кон3 (сверщик: `шаг_дна`, «не больше» с литералом, «: кон» при Кон3). -/
def «посылкаО2» (g : «ТермЧ») (p : «Принятый») : Bool :=
  match p.«формула» with
  | .«неМеньше» g' (.«лит» 0) => decide (g' = g)
  | .«неБольше» g' (.«лит» _) => decide (g' = g)
  | .«кон» g' => decide (g' = g) && p.«правило» == "Кон3"
  | _ => false

/-- Голова списка по построению (СС3, сверщик: `голова_списка_вывода`): `some none`
    — список пуст (пустой либо выписанный без членов), `some (some Г)` — первый член
    выписанного либо приписанный элемент, `none` — головы не видно. -/
def «голова?» : «ТермС» → Option (Option «ТермЧ»)
  | .«пустой» => some none
  | .«выписан» .«нет» => some none
  | .«выписан» (.«ещё» h _) => some (some h)
  | .«приписать» h _ => some (some h)
  | _ => none

/-- Ветвь шага свёртки для Н7 (сверщик: `ветвь_счёта`): накопитель сам либо
    накопитель плюс неотрицательный литерал в любой позиции. -/
def «ветвьСчёта» (s : «ТермЧ») (a : String) : Bool :=
  match s with
  | .«имя» x => x == a
  | .«плюс» (.«имя» x) (.«лит» k) => x == a && decide (0 ≤ k)
  | .«плюс» (.«лит» k) (.«имя» x) => x == a && decide (0 ≤ k)
  | _ => false

/-- Шаг свёртки для Н7 (сверщик: `шаг_счёта`): такая ветвь либо выбор из двух таких. -/
def «шагСчёта» (s : «ТермЧ») (a : String) : Bool :=
  «ветвьСчёта» s a || (match s with | .«если» _ b c => «ветвьСчёта» b a && «ветвьСчёта» c a | _ => false)

/-! ## Отношение «шаг принят» — по конструктору на правило -/

/-- Шаг `k` среди прежних. -/
def «шагПо» («преж» : List «Принятый») (k : Nat) : Option «Принятый» :=
  if k = 0 then none else «преж»[k - 1]?

/-- Итог шага без своих гипотез. -/
def «итог» («ш» : «Шаг») (o : List (Nat × «Форм»)) : «Принятый» :=
  ⟨«ш».«номер», «ш».«правило», «ш».«формула», 0, o⟩

/-- Порядок «П не больше Л» допущением функции — прямо либо зеркалом (Н12). -/
def «порядокДопущением» (u : «Утверждение») (p l : «ТермЧ») : Prop :=
  «Форм».«неБольше» p l ∈ u.«допущения» ∨ «Форм».«неМеньше» l p ∈ u.«допущения»

instance (u : «Утверждение») (p l : «ТермЧ») : Decidable («порядокДопущением» u p l) := by
  unfold «порядокДопущением»; infer_instance

/-- Обязательство входа под утверждением: имя, формула, строка знак в знак (Пред1). -/
def «естьОбязательство» (u : «Утверждение») (x : String) (f : «Форм») (n : Nat) : Prop :=
  ∃ o ∈ u.«обязательства», o.«имя» = x ∧ o.«формула» = f ∧ o.«строка» = n

instance (u : «Утверждение») (x : String) (f : «Форм») (n : Nat) :
    Decidable («естьОбязательство» u x f n) := by
  unfold «естьОбязательство»; infer_instance

inductive «ШагПринят» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : «Принятый» → Prop
  /-- Т1: цель есть допущение — строка N несёт `требует` с той же формулой; скаляр не сличается. -/
  | «Т1» (n : Nat) (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "Т1")
      (hd : u.«допущение» n = some «ш».«формула») (hs : «скаляр» «ш».«формула» = false) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Кон1: «Т : кон» из допущения «Т не больше ⟨литерал⟩». -/
  | «Кон1» (n : Nat) (t : «ТермЧ») (k : Int) (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "Кон1")
      (hf : «ш».«формула» = .«кон» t) (hd : u.«допущение» n = some (.«неБольше» t (.«лит» k))) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Кон3: «Т : кон» из «( Т минус Т ) равен 0». -/
  | «Кон3» (n : Nat) (p : «Принятый») (t : «ТермЧ») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Кон3")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = .«кон» t)
      (hp1 : p.«формула» = .«равен» (.«минус» t t) (.«лит» 0)) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- Цел1: «Т : цел» из «( Т остаток от 1 ) равен 0» — ноль справа или слева,
      прибавка «плюс 0» справа или без, Т знак в знак. -/
  | «Цел1» (n : Nat) (p : «Принятый») (t m : «ТермЧ») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Цел1")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = .«цел» t)
      (hm : m = .«остаток» t (.«лит» 1) ∨ m = .«плюс» (.«остаток» t (.«лит» 1)) (.«лит» 0))
      (hp1 : p.«формула» = .«равен» m (.«лит» 0) ∨ p.«формула» = .«равен» (.«лит» 0) m) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- Цел2: целость довода точной сетки — по обязательству входа «Т : цел» (как Пред1). -/
  | «Цел2» (n : Nat) (x : String) (d : «Довод») (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "Цел2")
      (hf : «ш».«формула» = .«цел» (.«имя» x)) (hd : u.«довод» n x = some d) (ht : d.«точный» = true)
      (hob : «естьОбязательство» u x (.«цел» (.«имя» x)) n) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Св1: существование свидетелем — посылка У[м:=Т], подстановка без захвата. -/
  | «Св1» (n : Nat) (p : «Принятый») (m : String) (t : «ТермЧ») (b : «Форм»)
      (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Св1") (h1 : «шагПо» «преж» n = some p)
      (hf : «ш».«формула» = .«есть» m t b) (hz : «захват?» («связанныеФ» b) m (.«число» t) = false)
      (hp1 : p.«формула» = «подстФ» b m (.«число» t)) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- Или1: «Л или П» из Л. -/
  | «Или1» (n : Nat) (p : «Принятый») (l r : «Форм») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Или1")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = .«или» l r) (hp1 : p.«формула» = l) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- Или2: «Л или П» из П. -/
  | «Или2» (n : Nat) (p : «Принятый») (l r : «Форм») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Или2")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = .«или» l r) (hp1 : p.«формула» = r) :
