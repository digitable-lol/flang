/-- Блок принят: шаги приняты по одному, каждый над прежними. -/
inductive «БлокПринят» (u : «Утверждение») : List «Шаг» → List «Принятый» → List «Принятый» → Prop
  | «конец» («преж» : List «Принятый») : «БлокПринят» u [] «преж» «преж»
  | «шаг» {«ш» : «Шаг»} {«хв» : List «Шаг»} {«преж» «итог» : List «Принятый»} {p : «Принятый»}
      (h : «ШагПринят» u «преж» «ш» p) (hhv : «БлокПринят» u «хв» («преж» ++ [p]) «итог») :
      «БлокПринят» u («ш» :: «хв») «преж» «итог»

/-- Утверждение ПРИНЯТО: блок вывода есть, его цель — цель утверждения по
    исходнику, каждый шаг принят, последний заключает цель и стоит без
    открытых гипотез. -/
def «Принят» (u : «Утверждение») : Prop :=
  ∃ (v : «Вывод») («итог» : List «Принятый») («посл» : «Принятый»),
    u.«вывод» = some v ∧ v.«цель» = u.«цель» ∧
    «БлокПринят» u v.«шаги» [] «итог» ∧ «итог».getLast? = some «посл» ∧
    «посл».«формула» = u.«цель» ∧ «посл».«откр» = []

/-! ## Разрешимая приёмка -/

/-- Условие, взятое как фильтр: `при c x` есть `some x`, когда c. -/
def «при» {α : Type} (c : Prop) [Decidable c] (x : α) : Option α := if c then some x else none

theorem «при-some» {α : Type} {c : Prop} [Decidable c] {x y : α} :
    «при» c x = some y ↔ c ∧ x = y := by
  unfold «при»; split <;> simp_all

def «из1?» («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  match «ш».«основание» with
  | .«из» n => «шагПо» «преж» n
  | _ => none

def «из2?» («преж» : List «Принятый») («ш» : «Шаг») : Option («Принятый» × «Принятый») :=
  match «ш».«основание» with
  | .«из2» n m => («шагПо» «преж» n).bind fun p1 => («шагПо» «преж» m).map fun p2 => (p1, p2)
  | _ => none

def «строка?» («ш» : «Шаг») : Option Nat :=
  match «ш».«основание» with
  | .«строка» n => some n
  | _ => none

def «изСтрока?» («преж» : List «Принятый») («ш» : «Шаг») : Option («Принятый» × Nat) :=
  match «ш».«основание» with
  | .«изСтрока» n m => («шагПо» «преж» n).map fun p => (p, m)
  | _ => none

