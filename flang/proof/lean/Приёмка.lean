theorem «Или2?-верно» (h : «Или2?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Или2") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Или2?», Option.bind_eq_some_iff] at h
