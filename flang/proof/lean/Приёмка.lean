  rw [«при-some»] at h
  obtain ⟨hf1, rfl⟩ := h
  exact .«ГипД» n _ _ («строка?-верно» hsn) hn hd hf1

theorem «Р1?-верно» (h : «Р1?» u «преж» «ш» = some p) (hn : «ш».«правило» = "Р1") : «ШагПринят» u «преж» «ш» p := by
  simp only [«Р1?», Option.bind_eq_some_iff] at h
  obtain ⟨⟨ph, pm⟩, hq, h⟩ := h
  split at h <;> try cases h
  rename_i c q hf
  rw [«при-some»] at h
  obtain ⟨⟨hg, hc, hq', hotkr⟩, rfl⟩ := h
  obtain ⟨hh', m, ho, hh, hm⟩ := «из2?-верно» hq
