/-- Каждый шаг, принятый функцией, принят отношением. -/
theorem «шаг?-верно» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») (p : «Принятый»)
    (h : «шаг?» u «преж» «ш» = some p) : «ШагПринят» u «преж» «ш» p := by
  unfold «шаг?» at h
  split at h
  · rename_i r hr
    exact «приём-верно» u «преж» «ш» p r h («имяПравила-верно» hr).symm
  · cases h

theorem «прогон-верно» (u : «Утверждение») : ∀ («шаги» : List «Шаг») («преж» «итог» : List «Принятый»),
    «прогон» u «шаги» «преж» = some «итог» → «БлокПринят» u «шаги» «преж» «итог»
  | [], «преж», «итог», h => by
      simp only [«прогон», Option.some.injEq] at h; subst h; exact .«конец» _
  | «ш» :: «хв», «преж», «итог», h => by
      simp only [«прогон»] at h
      split at h
      · simp only [Option.bind_eq_some_iff] at h
        obtain ⟨p, hp, h⟩ := h
        exact .«шаг» («шаг?-верно» u «преж» «ш» p hp) («прогон-верно» u «хв» _ _ h)
      · cases h

/-- Теорема ADR-0041 §2.2: `принят? з = true → Принят з`. -/
theorem «принят?-верно» (u : «Утверждение») (h : «принят?» u = true) : «Принят» u := by
  unfold «принят?» at h
  split at h
  · cases h
  · rename_i hv
    split at h
    · cases h
    · rename_i hi
      split at h
      · cases h
      · rename_i hpo
        simp only [decide_eq_true_eq] at h
        obtain ⟨hc, hf, ho, _⟩ := h
        exact ⟨_, _, _, hv, hc, «прогон-верно» u _ _ _ hi, hpo, hf, ho⟩
