  | .«СС4» => «СС4?»
  | .«Кон2» => «Кон2?»
  | .«Н7» => «Н7?»

/-- Приём одного шага: имя правила выбирает проверку; имя вне списка — отказ. -/
def «шаг?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  match «имяПравила» «ш».«правило» with
  | some r => «приём» r u «преж» «ш»
  | none => none

/-- Прогон блока по шагам: номера подряд с единицы. -/
def «прогон» (u : «Утверждение») : List «Шаг» → List «Принятый» → Option (List «Принятый»)
  | [], «преж» => some «преж»
  | «ш» :: «хв», «преж» =>
    if «ш».«номер» = «преж».length + 1 then
      («шаг?» u «преж» «ш»).bind fun p => «прогон» u «хв» («преж» ++ [p])
    else none

/-- Гипотезы сняты — как у сверщика: у каждого ГипО/ГипД в блоке есть Р1/Р4/Кон2
    ниже. Для состоятельности важно другое — последний шаг без открытых
    гипотез; это условие — верность сверщику. -/
def «гипотезыСняты» («итог» : List «Принятый») : Bool :=
  «итог».all fun p =>
    if p.«правило» = "ГипО" ∨ p.«правило» = "ГипД" then
      «итог».any fun q => (q.«правило» = "Р1" ∨ q.«правило» = "Р4" ∨ q.«правило» = "Кон2") ∧ q.«номер» > p.«номер»
    else true

/-- Разрешимая приёмка утверждения. -/
def «принят?» (u : «Утверждение») : Bool :=
  match u.«вывод» with
  | none => false
  | some v =>
    match «прогон» u v.«шаги» [] with
    | none => false
    | some «итог» =>
      match «итог».getLast? with
      | none => false
      | some «посл» =>
        v.«цель» = u.«цель» ∧ «посл».«формула» = u.«цель» ∧ «посл».«откр» = [] ∧
        «гипотезыСняты» «итог» = true

/-! ## Разрешимая приёмка даёт вывод отношения -/

theorem «из1?-верно» {«преж» : List «Принятый»} {«ш» : «Шаг»} {p : «Принятый»}
    (h : «из1?» «преж» «ш» = some p) : ∃ n, «ш».«основание» = .«из» n ∧ «шагПо» «преж» n = some p := by
  unfold «из1?» at h
  split at h
  · exact ⟨_, ‹_›, h⟩
  · cases h

theorem «из2?-верно» {«преж» : List «Принятый»} {«ш» : «Шаг»} {p1 p2 : «Принятый»}
    (h : «из2?» «преж» «ш» = some (p1, p2)) :
    ∃ n m, «ш».«основание» = .«из2» n m ∧ «шагПо» «преж» n = some p1 ∧ «шагПо» «преж» m = some p2 := by
  unfold «из2?» at h
  split at h
  · rename_i n m ho
    simp only [Option.bind_eq_some_iff, Option.map_eq_some_iff] at h
    obtain ⟨q1, h1, q2, h2, hq⟩ := h
    cases hq
    exact ⟨n, m, ho, h1, h2⟩
  · cases h

theorem «строка?-верно» {«ш» : «Шаг»} {n : Nat} (h : «строка?» «ш» = some n) :
    «ш».«основание» = .«строка» n := by
  unfold «строка?» at h
  split at h
  · cases h; assumption
  · cases h

theorem «изСтрока?-верно» {«преж» : List «Принятый»} {«ш» : «Шаг»} {p : «Принятый»} {m : Nat}
    (h : «изСтрока?» «преж» «ш» = some (p, m)) :
    ∃ n, «ш».«основание» = .«изСтрока» n m ∧ «шагПо» «преж» n = some p := by
  unfold «изСтрока?» at h
  split at h
  · rename_i n m' ho
    simp only [Option.map_eq_some_iff] at h
    obtain ⟨q, hq, hqm⟩ := h
    cases hqm
    exact ⟨n, ho, hq⟩
  · cases h

