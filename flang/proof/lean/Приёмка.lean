/-- Единственная гипотеза списка (Р4: случай стоит на ОДНОЙ гипотезе). -/
def «единственная» : List (Nat × «Форм») → Option (Nat × «Форм»)
  | [] => none
  | p :: r => if r.all (fun q => q.1 = p.1 ∧ q.2 = p.2) then some p else none

theorem «единственная-все» {o : List (Nat × «Форм»)} {p : Nat × «Форм»}
    (h : «единственная» o = some p) : o ≠ [] ∧ ∀ q ∈ o, q.2 = p.2 := by
  cases o with
  | nil => simp [«единственная»] at h
  | cons a r =>
    simp only [«единственная»] at h
    split at h
    · rename_i hall
      cases h
      refine ⟨by simp, fun q hq => ?_⟩
      rcases List.mem_cons.mp hq with rfl | hq
      · rfl
      · exact (List.all_eq_true.mp hall q hq |> of_decide_eq_true).2
    · cases h

/-- Выписанный список без пар соседей: пустой либо из одного члена (СС1,
    сверщик: `члены_списка_вывода`, членов не больше одного). -/
def «безСоседей» : «ТермС» → Bool
  | .«пустой» => true
  | .«выписан» .«нет» => true
  | .«выписан» (.«ещё» _ .«нет») => true
  | _ => false

theorem «безСоседей-верно» {l : «ТермС»} (h : «безСоседей» l = true) :
    l = .«пустой» ∨ l = .«выписан» .«нет» ∨ ∃ t, l = .«выписан» (.«ещё» t .«нет») := by
  cases l with
  | «пустой» => exact Or.inl rfl
  | «выписан» d =>
    cases d with
    | «нет» => exact Or.inr (Or.inl rfl)
    | «ещё» t r =>
      cases r with
      | «нет» => exact Or.inr (Or.inr ⟨t, rfl⟩)
      | «ещё» _ _ => simp [«безСоседей»] at h
  | _ => simp [«безСоседей»] at h

/-- Порядок формулы: «Е не больше Г» либо «Г не меньше Е» — одна форма, пара
    (Е, Г) (сверщик: `порядок_вывода`). -/
def «порядок?» : «Форм» → Option («ТермЧ» × «ТермЧ»)
  | .«неБольше» e g => some (e, g)
  | .«неМеньше» g e => some (e, g)
  | _ => none

/-- Терм — член выписанного списка знак в знак (В1). -/
def «вЧленах» (e : «ТермЧ») : «Члены» → Bool
  | .«нет» => false
  | .«ещё» t r => decide (t = e) || «вЧленах» e r

/-- Строгий порядок формулы: «Е меньше Г» либо «Г больше Е» — одна форма, пара
    (Е, Г) (сверщик: `строгий_вывода`). -/
def «строгий?» : «Форм» → Option («ТермЧ» × «ТермЧ»)
  | .«меньше» e g => some (e, g)
  | .«больше» g e => some (e, g)
  | _ => none

/-- М1 (ADR-0042 §2): вид отношения, у которого одна сторона — целый литерал;
    «…Л» — литерал слева. Посылка и заключение М1 — один вид и один литерал. -/
inductive «ОтнЛит» where
  | «нб» | «нбЛ» | «нм» | «нмЛ» | «мн» | «мнЛ» | «бо» | «боЛ» | «рв» | «рвЛ»
deriving DecidableEq, Repr

def «собрать» : «ОтнЛит» → «ТермЧ» → Int → «Форм»
  | .«нб», x, k => .«неБольше» x (.«лит» k)  | .«нбЛ», x, k => .«неБольше» (.«лит» k) x
  | .«нм», x, k => .«неМеньше» x (.«лит» k)  | .«нмЛ», x, k => .«неМеньше» (.«лит» k) x
  | .«мн», x, k => .«меньше» x (.«лит» k)    | .«мнЛ», x, k => .«меньше» (.«лит» k) x
  | .«бо», x, k => .«больше» x (.«лит» k)    | .«боЛ», x, k => .«больше» (.«лит» k) x
  | .«рв», x, k => .«равен» x (.«лит» k)     | .«рвЛ», x, k => .«равен» (.«лит» k) x

def «разобратьОтн?» : «Форм» → Option («ОтнЛит» × «ТермЧ» × Int)
  | .«неБольше» x (.«лит» k) => some (.«нб», x, k) | .«неБольше» (.«лит» k) x => some (.«нбЛ», x, k)
  | .«неМеньше» x (.«лит» k) => some (.«нм», x, k) | .«неМеньше» (.«лит» k) x => some (.«нмЛ», x, k)
  | .«меньше» x (.«лит» k) => some (.«мн», x, k)   | .«меньше» (.«лит» k) x => some (.«мнЛ», x, k)
  | .«больше» x (.«лит» k) => some (.«бо», x, k)   | .«больше» (.«лит» k) x => some (.«боЛ», x, k)
  | .«равен» x (.«лит» k) => some (.«рв», x, k)    | .«равен» (.«лит» k) x => some (.«рвЛ», x, k)
  | _ => none

theorem «разобратьОтн?-верно» {f : «Форм»} {r : «ОтнЛит»} {x : «ТермЧ»} {k : Int}
    (h : «разобратьОтн?» f = some (r, x, k)) : «собрать» r x k = f := by
  unfold «разобратьОтн?» at h
  split at h <;> (try cases h) <;> rfl

/-- М2 (ADR-0042 §2): вид отношения двух числовых сторон. -/
inductive «Отн2» where
  | «нб» | «нм» | «мн» | «бо» | «рв»
deriving DecidableEq, Repr

def «собрать2» : «Отн2» → «ТермЧ» → «ТермЧ» → «Форм»
  | .«нб», x, y => .«неБольше» x y | .«нм», x, y => .«неМеньше» x y | .«мн», x, y => .«меньше» x y
  | .«бо», x, y => .«больше» x y   | .«рв», x, y => .«равен» x y

def «разобрать2?» : «Форм» → Option («Отн2» × «ТермЧ» × «ТермЧ»)
  | .«неБольше» x y => some (.«нб», x, y) | .«неМеньше» x y => some (.«нм», x, y)
  | .«меньше» x y => some (.«мн», x, y)   | .«больше» x y => some (.«бо», x, y)
  | .«равен» x y => some (.«рв», x, y)
  | _ => none

theorem «разобрать2?-верно» {f : «Форм»} {c : «Отн2»} {x y : «ТермЧ»}
    (h : «разобрать2?» f = some (c, x, y)) : «собрать2» c x y = f := by
  unfold «разобрать2?» at h
  split at h <;> (try cases h) <;> rfl

/-- Мера свёртки с пустого начала, чей шаг приписывает к накопителю ровно одно
    звено: «длина Л» (x) и «длина ( свёртка Л начиная с пустой список как а и э
    → добавить|приписать Х к а )» (y), а ≠ э. Шаг-вызов с доказанным «плюс 1»
    модель не берёт — реестра доказанного у неё нет (строже сверщика). -/
def «мера2» : «ТермЧ» → «ТермЧ» → Bool
  | .«длина» l, .«длина» (.«свёрткаС» l' .«пустой» a e (.«добавить» _ (.«имяС» a'))) => decide (l = l' ∧ a = a' ∧ a ≠ e)
  | .«длина» l, .«длина» (.«свёрткаС» l' .«пустой» a e (.«приписать» _ (.«имяС» a'))) => decide (l = l' ∧ a = a' ∧ a ≠ e)
  | _, _ => false

/-- Мера прибавления: «( длина Л ) плюс 1» (s) и «длина ( добавить|приписать Э к Л )» (t). -/
def «мера1» : «ТермЧ» → «ТермЧ» → Bool
  | .«плюс» (.«длина» l) (.«лит» 1), .«длина» (.«добавить» _ l') => decide (l = l')
  | .«плюс» (.«длина» l) (.«лит» 1), .«длина» (.«приписать» _ l') => decide (l = l')
  | _, _ => false

/-- Поле выписанного конструктора по имени — первое с этим именем (сверщик: первое
    поле, чьё имя совпало, `как_слово`). -/
def «полеП?» (p : String) : «Поля» → Option «Тело»
  | .«нет» => none
  | .«ещё» q t r => if q = p then some t else «полеП?» p r

/-- К↑: сторона — поле выписанного конструктора; на её месте в посылке — тело
    поля, прочитанное числом. -/
def «полеСтороны?» : «ТермЧ» → Option «ТермЧ»
  | .«поле» (.«вариант» _ fs) p => («полеП?» p fs).map (·.«числом»)
  | _ => none

/-- Разв1 для суммы: ветвь своего варианта — первая с этим вариантом (сверщик:
    первый «случай вариант «В»» с тем же именем). -/
def «ветвь?» (k : String) : «Случаи» → Option (List (String × String) × «Форм»)
  | .«нет» => none
  | .«ещё» k' bs u r => if k' = k then some (bs, u) else «ветвь?» k r

/-- Пары (имя ветви, тело поля): у каждого имени ветви поле обязано быть. -/
def «поляИмён» (fs : «Поля») : List (String × String) → Option (List (String × «Тело»))
  | [] => some []
  | b :: r => match «полеП?» b.1 fs, «поляИмён» fs r with
    | some t, some rest => some ((b.2, t) :: rest)
    | _, _ => none

/-- Подстановка пар по порядку — как у сверщика: первая пара первой. -/
def «подстПар» (u : «Форм») : List (String × «Тело») → «Форм»
  | [] => u
  | q :: r => «подстПар» («подстФ» u q.1 q.2) r

/-- Доводы вызова по порядку. -/
def «доводыСписком» : «Доводы» → List «Тело»
  | .«нет» => []
  | .«ещё» t r => t :: «доводыСписком» r

/-- Подстановка пар в тело по порядку — как у сверщика (Разв3). -/
def «подстПарТ» (b : «Тело») : List (String × «Тело») → «Тело»
  | [] => b
  | q :: r => «подстПарТ» («подстТело» b q.1 q.2) r

/-- Цепь подстановок в тело чиста — как `«цепьЧиста»` у формулы. -/
def «цепьЧистаТ» (b : «Тело») : List (String × «Тело») → Bool
  | [] => true
  | q :: r => !(«захват?» («связанныеТело» b) q.1 q.2) && r.all (fun q' => !((«свободныеТело» q.2).contains q'.1)) &&
              «цепьЧистаТ» («подстТело» b q.1 q.2) r

/-- Разв3: тело функции `d` с доводами на местах параметров — когда вызов её,
    доводов столько, сколько параметров, и пары чисты. -/
def «развёртка?» (d : «Определение») (f : String) (ds : «Доводы») : Option «Тело» :=
  if f = d.«имя» ∧ («доводыСписком» ds).length = d.«параметры».length ∧
     «цепьЧистаТ» d.«тело» (d.«параметры».zip («доводыСписком» ds)) = true
  then some («подстПарТ» d.«тело» (d.«параметры».zip («доводыСписком» ds))) else none

/-- Узел-вызов любого сорта: имя и доводы. -/
def «вызовТела?» : «Тело» → Option (String × «Доводы»)
  | .«число» (.«вызов» f ds) => some (f, ds)
  | .«список» (.«вызовС» f ds) => some (f, ds)
  | .«текст» (.«вызовТ» f ds) => some (f, ds)
  | .«признак» (.«вызовФ» f ds) => some (f, ds)
  | .«сумма» (.«вызовСм» f ds) => some (f, ds)
  | .«вызов» f ds => some (f, ds)
  | _ => none

/-- Тело R, прочитанное сортом узла A. -/
def «сортом» (A R : «Тело») : «Тело» :=
  match A with
  | .«число» _ => .«число» R.«числом»
  | .«список» _ => .«список» R.«списком»
  | .«текст» _ => .«текст» R.«текстом»
  | .«признак» _ => .«признак» R.«признаком»
  | .«сумма» _ => .«сумма» R.«суммой»
  | .«вызов» _ _ => R

/-- Разв3: узел A — вызов функции `d`, на его месте B — её развёртка тем же сортом. -/
def «развёрнут?» (d : «Определение») (A B : «Тело») : Bool :=
  match «вызовТела?» A with
  | some (f, ds) =>
    match «развёртка?» d f ds with
    | some R => decide (B = «сортом» A R)
    | none => false
  | none => false

/- Два терма одинаковы, кроме узлов, где у первого стоит то, что `H` велит
    заменить, а у второго — замена (Разв3). Под связывателями — только знак в знак. -/
mutual
def «замЧ» (H : «Тело» → «Тело» → Bool) (a b : «ТермЧ») : Bool :=
  H (.«число» a) (.«число» b) || decide (a = b) ||
  match a, b with
  | .«плюс» a1 a2, .«плюс» b1 b2 => «замЧ» H a1 b1 && «замЧ» H a2 b2
  | .«минус» a1 a2, .«минус» b1 b2 => «замЧ» H a1 b1 && «замЧ» H a2 b2
  | .«умножить» a1 a2, .«умножить» b1 b2 => «замЧ» H a1 b1 && «замЧ» H a2 b2
  | .«остаток» a1 a2, .«остаток» b1 b2 => «замЧ» H a1 b1 && «замЧ» H a2 b2
  | .«если» a1 a2 a3, .«если» b1 b2 b3 => «замФ» H a1 b1 && «замЧ» H a2 b2 && «замЧ» H a3 b3
  | .«длина» a1, .«длина» b1 => «замС» H a1 b1
  | .«кодСимвола» a1, .«кодСимвола» b1 => «замТ» H a1 b1
  | .«вызов» a1 a2, .«вызов» b1 b2 => decide (a1 = b1) && «замД» H a2 b2
  | .«поле» a1 a2, .«поле» b1 b2 => «замСм» H a1 b1 && decide (a2 = b2)
  | _, _ => false
def «замС» (H : «Тело» → «Тело» → Bool) (a b : «ТермС») : Bool :=
  H (.«список» a) (.«список» b) || decide (a = b) ||
  match a, b with
  | .«выписан» a1, .«выписан» b1 => «замЧл» H a1 b1
  | .«приписать» a1 a2, .«приписать» b1 b2 => «замЧ» H a1 b1 && «замС» H a2 b2
  | .«добавить» a1 a2, .«добавить» b1 b2 => «замЧ» H a1 b1 && «замС» H a2 b2
  | .«еслиС» a1 a2 a3, .«еслиС» b1 b2 b3 => «замФ» H a1 b1 && «замС» H a2 b2 && «замС» H a3 b3
  | .«вызовС» a1 a2, .«вызовС» b1 b2 => decide (a1 = b1) && «замД» H a2 b2
  | _, _ => false
def «замТ» (H : «Тело» → «Тело» → Bool) (a b : «ТермТ») : Bool :=
  H (.«текст» a) (.«текст» b) || decide (a = b) ||
  match a, b with
  | .«склейка» a1 a2, .«склейка» b1 b2 => «замТ» H a1 b1 && «замТ» H a2 b2
  | .«еслиТ» a1 a2 a3, .«еслиТ» b1 b2 b3 => «замФ» H a1 b1 && «замТ» H a2 b2 && «замТ» H a3 b3
  | .«вызовТ» a1 a2, .«вызовТ» b1 b2 => decide (a1 = b1) && «замД» H a2 b2
  | _, _ => false
def «замФ» (H : «Тело» → «Тело» → Bool) (a b : «Форм») : Bool :=
  H (.«признак» a) (.«признак» b) || decide (a = b) ||
  match a, b with
  | .«неБольше» a1 a2, .«неБольше» b1 b2 => «замЧ» H a1 b1 && «замЧ» H a2 b2
  | .«неМеньше» a1 a2, .«неМеньше» b1 b2 => «замЧ» H a1 b1 && «замЧ» H a2 b2
  | .«меньше» a1 a2, .«меньше» b1 b2 => «замЧ» H a1 b1 && «замЧ» H a2 b2
  | .«больше» a1 a2, .«больше» b1 b2 => «замЧ» H a1 b1 && «замЧ» H a2 b2
  | .«равен» a1 a2, .«равен» b1 b2 => «замЧ» H a1 b1 && «замЧ» H a2 b2
  | .«равенС» a1 a2, .«равенС» b1 b2 => «замС» H a1 b1 && «замС» H a2 b2
  | .«равенТ» a1 a2, .«равенТ» b1 b2 => «замТ» H a1 b1 && «замТ» H a2 b2
  | .«содержит» a1 a2, .«содержит» b1 b2 => «замС» H a1 b1 && «замЧ» H a2 b2
  | .«неУбывает» a1, .«неУбывает» b1 => «замС» H a1 b1
  | .«пусто» a1, .«пусто» b1 => «замС» H a1 b1
  | .«пустоТ» a1, .«пустоТ» b1 => «замТ» H a1 b1
  | .«начинается» a1 a2, .«начинается» b1 b2 => «замТ» H a1 b1 && «замТ» H a2 b2
  | .«кон» a1, .«кон» b1 => «замЧ» H a1 b1
  | .«цел» a1, .«цел» b1 => «замЧ» H a1 b1
  | .«помещается» a1, .«помещается» b1 => «замЧ» H a1 b1
  | .«и» a1 a2, .«и» b1 b2 => «замФ» H a1 b1 && «замФ» H a2 b2
  | .«или» a1 a2, .«или» b1 b2 => «замФ» H a1 b1 && «замФ» H a2 b2
  | .«не» a1, .«не» b1 => «замФ» H a1 b1
  | .«еслиФ» a1 a2 a3, .«еслиФ» b1 b2 b3 => «замФ» H a1 b1 && «замФ» H a2 b2 && «замФ» H a3 b3
  | .«вызовФ» a1 a2, .«вызовФ» b1 b2 => decide (a1 = b1) && «замД» H a2 b2
  | _, _ => false
def «замТело» (H : «Тело» → «Тело» → Bool) (a b : «Тело») : Bool :=
  H a b || decide (a = b) ||
  match a, b with
  | .«число» a1, .«число» b1 => «замЧ» H a1 b1
  | .«список» a1, .«список» b1 => «замС» H a1 b1
  | .«текст» a1, .«текст» b1 => «замТ» H a1 b1
  | .«признак» a1, .«признак» b1 => «замФ» H a1 b1
  | .«сумма» a1, .«сумма» b1 => «замСм» H a1 b1
  | .«вызов» a1 a2, .«вызов» b1 b2 => decide (a1 = b1) && «замД» H a2 b2
  | _, _ => false
def «замД» (H : «Тело» → «Тело» → Bool) (a b : «Доводы») : Bool :=
  decide (a = b) ||
  match a, b with
  | .«ещё» a1 a2, .«ещё» b1 b2 => «замТело» H a1 b1 && «замД» H a2 b2
  | _, _ => false
def «замЧл» (H : «Тело» → «Тело» → Bool) (a b : «Члены») : Bool :=
  decide (a = b) ||
  match a, b with
  | .«ещё» a1 a2, .«ещё» b1 b2 => «замЧ» H a1 b1 && «замЧл» H a2 b2
  | _, _ => false
def «замСм» (H : «Тело» → «Тело» → Bool) (a b : «ТермСм») : Bool :=
  H (.«сумма» a) (.«сумма» b) || decide (a = b) ||
  match a, b with
  | .«вызовСм» a1 a2, .«вызовСм» b1 b2 => decide (a1 = b1) && «замД» H a2 b2
  | _, _ => false
end

/-- Цепь подстановок чиста: у каждой пары нет захвата в том, во что подставляют,
    и тело пары не зовёт имён следующих пар. -/
def «цепьЧиста» (u : «Форм») : List (String × «Тело») → Bool
  | [] => true
  | q :: r => !(«захват?» («связанныеФ» u) q.1 q.2) && r.all (fun q' => !((«свободныеТело» q.2).contains q'.1)) &&
              «цепьЧиста» («подстФ» u q.1 q.2) r

/-- Посылка О2: «Г не меньше 0», «Г не больше ⟨литерал⟩» либо «Г : кон» шагом
    Кон3 (сверщик: `шаг_дна`, «не больше» с литералом, «: кон» при Кон3). -/
def «посылкаО2» (g : «ТермЧ») (p : «Принятый») : Bool :=
  match p.«формула» with
  | .«неМеньше» g' (.«лит» 0) => decide (g' = g)
  | .«неБольше» g' (.«лит» _) => decide (g' = g)
  | .«кон» g' => decide (g' = g) && p.«правило» == "Кон3"
  | _ => false

/-- Голова списка по построению (СС3, сверщик: `голова_списка_вывода`): `some none`
    — список пуст (пустой либо выписанный без членов), `some (some Г)` — первый член
    выписанного либо приписанный элемент, `none` — головы не видно. -/
def «голова?» : «ТермС» → Option (Option «ТермЧ»)
  | .«пустой» => some none
  | .«выписан» .«нет» => some none
  | .«выписан» (.«ещё» h _) => some (some h)
  | .«приписать» h _ => some (some h)
  | _ => none

/-- Ветвь шага свёртки для Н7 (сверщик: `ветвь_счёта`): накопитель сам либо
    накопитель плюс неотрицательный литерал в любой позиции. -/
def «ветвьСчёта» (s : «ТермЧ») (a : String) : Bool :=
  match s with
  | .«имя» x => x == a
  | .«плюс» (.«имя» x) (.«лит» k) => x == a && decide (0 ≤ k)
  | .«плюс» (.«лит» k) (.«имя» x) => x == a && decide (0 ≤ k)
  | _ => false

/-- Шаг свёртки для Н7 (сверщик: `шаг_счёта`): такая ветвь либо выбор из двух таких. -/
def «шагСчёта» (s : «ТермЧ») (a : String) : Bool :=
  «ветвьСчёта» s a || (match s with | .«если» _ b c => «ветвьСчёта» b a && «ветвьСчёта» c a | _ => false)

/-- Сомножитель Н8 — положительный целый литерал не выше 2⁵³ − 1. -/
def «литералН8» : «ТермЧ» → Bool
  | .«лит» z => decide (0 < z ∧ z ≤ «К-предст»)
  | _ => false

/-- Сомножитель Н8 зажат в (0, кон] парой допущений функции: «Т больше К» при К ≥ 0
    и «Т не больше ⟨литерал⟩» (сверщик: `в_строго_положительном_отрезке`). -/
def «отрезокН8» (u : «Утверждение») (t : «ТермЧ») : Bool :=
  u.«допущения».any (fun f => match f with | .«больше» t' (.«лит» k) => decide (t' = t ∧ 0 ≤ k) | _ => false) &&
  u.«допущения».any (fun f => match f with | .«неБольше» t' (.«лит» _) => decide (t' = t) | _ => false)

/-- Какой сомножитель несёт дно нуля, в порядке сверщика: литерал справа, литерал
    слева, пара допущений у левого, у правого. `true` — положительный слева. -/
def «второйН8» (u : «Утверждение») (x y : «ТермЧ») : Option («ТермЧ» × Bool) :=
  if «литералН8» y then some (x, false) else if «литералН8» x then some (y, true)
  else if «отрезокН8» u x then some (y, true) else if «отрезокН8» u y then some (x, false) else none

/-- Сочетания позиций общей прибавки О5 (узел «плюс» коммутативен, сверщик ищет в
    четырёх): (Е', Г', прибавка у Е, прибавка у Г) — прибавки обязаны совпасть. -/
def «прибавкиО5» (e g : «ТермЧ») : List («ТермЧ» × «ТермЧ» × «ТермЧ» × «ТермЧ») :=
  match e, g with
  | .«плюс» el ep, .«плюс» gl gp => [(el, gl, ep, gp), (el, gp, ep, gl), (ep, gl, el, gp), (ep, gp, el, gl)]
  | _, _ => []

/-- Терм — литерал. -/
def «литерал?» : «ТермЧ» → Bool
  | .«лит» _ => true
  | _ => false

theorem «литерал?-верно» {s : «ТермЧ»} (h : «литерал?» s = true) : ∃ k, s = .«лит» k := by
  cases s with
  | «лит» k => exact ⟨k, rfl⟩
  | _ => simp [«литерал?»] at h

/-- Прибавка-имя О5 в отрезке (сверщик: `прибавка_числом` при «из N M K»): шаг M —
    «Ш не меньше Д», шаг K — «Ш не больше В», Д и В — литералы. -/
def «отрезокО5» (s : «ТермЧ») (f2 f3 : «Форм») : Bool :=
  match f2, f3 with
  | .«неМеньше» s2 (.«лит» d), .«неБольше» s3 (.«лит» _) => decide (s2 = s ∧ s3 = s ∧ 0 ≤ d)
  | _, _ => false

theorem «отрезокО5-верно» {s : «ТермЧ»} {f2 f3 : «Форм»} (h : «отрезокО5» s f2 f3 = true) :
    ∃ d b, f2 = .«неМеньше» s (.«лит» d) ∧ 0 ≤ d ∧ f3 = .«неБольше» s (.«лит» b) := by
  unfold «отрезокО5» at h
  split at h
  · rename_i s2 d s3 b
    simp only [decide_eq_true_eq] at h
    obtain ⟨rfl, rfl, hd⟩ := h
    exact ⟨d, b, rfl, hd, rfl⟩
  · cases h

/-! ## Отношение «шаг принят» — по конструктору на правило -/

/-- Шаг `k` среди прежних. -/
def «шагПо» («преж» : List «Принятый») (k : Nat) : Option «Принятый» :=
  if k = 0 then none else «преж»[k - 1]?

/-- Итог шага без своих гипотез. -/
def «итог» («ш» : «Шаг») (o : List (Nat × «Форм»)) : «Принятый» :=
  ⟨«ш».«номер», «ш».«правило», «ш».«формула», 0, o⟩

/-- Порядок «П не больше Л» допущением функции — прямо либо зеркалом (Н12). -/
def «порядокДопущением» (u : «Утверждение») (p l : «ТермЧ») : Prop :=
  «Форм».«неБольше» p l ∈ u.«допущения» ∨ «Форм».«неМеньше» l p ∈ u.«допущения»

instance (u : «Утверждение») (p l : «ТермЧ») : Decidable («порядокДопущением» u p l) := by
  unfold «порядокДопущением»; infer_instance

/-- Обязательство входа под утверждением: имя, формула, строка знак в знак (Пред1). -/
def «естьОбязательство» (u : «Утверждение») (x : String) (f : «Форм») (n : Nat) : Prop :=
  ∃ o ∈ u.«обязательства», o.«имя» = x ∧ o.«формула» = f ∧ o.«строка» = n

instance (u : «Утверждение») (x : String) (f : «Форм») (n : Nat) :
    Decidable («естьОбязательство» u x f n) := by
  unfold «естьОбязательство»; infer_instance

inductive «ШагПринят» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : «Принятый» → Prop
  /-- Т1: цель есть допущение — строка N несёт `требует` с той же формулой; скаляр не сличается. -/
  | «Т1» (n : Nat) (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "Т1")
      (hd : u.«допущение» n = some «ш».«формула») (hs : «скаляр» «ш».«формула» = false) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Кон1: «Т : кон» из допущения «Т не больше ⟨литерал⟩». -/
  | «Кон1» (n : Nat) (t : «ТермЧ») (k : Int) (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "Кон1")
      (hf : «ш».«формула» = .«кон» t) (hd : u.«допущение» n = some (.«неБольше» t (.«лит» k))) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Кон3: «Т : кон» из «( Т минус Т ) равен 0». -/
  | «Кон3» (n : Nat) (p : «Принятый») (t : «ТермЧ») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Кон3")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = .«кон» t)
      (hp1 : p.«формула» = .«равен» (.«минус» t t) (.«лит» 0)) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- Цел1: «Т : цел» из «( Т остаток от 1 ) равен 0» — ноль справа или слева,
      прибавка «плюс 0» справа или без, Т знак в знак. -/
  | «Цел1» (n : Nat) (p : «Принятый») (t m : «ТермЧ») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Цел1")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = .«цел» t)
      (hm : m = .«остаток» t (.«лит» 1) ∨ m = .«плюс» (.«остаток» t (.«лит» 1)) (.«лит» 0))
      (hp1 : p.«формула» = .«равен» m (.«лит» 0) ∨ p.«формула» = .«равен» (.«лит» 0) m) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- Цел2: целость довода точной сетки — по обязательству входа «Т : цел» (как Пред1). -/
  | «Цел2» (n : Nat) (x : String) (d : «Довод») (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "Цел2")
      (hf : «ш».«формула» = .«цел» (.«имя» x)) (hd : u.«довод» n x = some d) (ht : d.«точный» = true)
      (hob : «естьОбязательство» u x (.«цел» (.«имя» x)) n) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Св1: существование свидетелем — посылка У[м:=Т], подстановка без захвата. -/
  | «Св1» (n : Nat) (p : «Принятый») (m : String) (t : «ТермЧ») (b : «Форм»)
      (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Св1") (h1 : «шагПо» «преж» n = some p)
      (hf : «ш».«формула» = .«есть» m t b) (hz : «захват?» («связанныеФ» b) m (.«число» t) = false)
      (hp1 : p.«формула» = «подстФ» b m (.«число» t)) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- Или1: «Л или П» из Л. -/
  | «Или1» (n : Nat) (p : «Принятый») (l r : «Форм») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Или1")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = .«или» l r) (hp1 : p.«формула» = l) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- Или2: «Л или П» из П. -/
  | «Или2» (n : Nat) (p : «Принятый») (l r : «Форм») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Или2")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = .«или» l r) (hp1 : p.«формула» = r) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- И1: Л из «Л и притом П». -/
  | «И1» (n : Nat) (p : «Принятый») (l r : «Форм») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "И1")
      (h1 : «шагПо» «преж» n = some p) (hp1 : p.«формула» = .«и» l r) (hf : «ш».«формула» = l) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- И2: П из «Л и притом П». -/
  | «И2» (n : Nat) (p : «Принятый») (l r : «Форм») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "И2")
      (h1 : «шагПо» «преж» n = some p) (hp1 : p.«формула» = .«и» l r) (hf : «ш».«формула» = r) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- ГипО: открытая гипотеза охраны — кладёт себя в открытые. -/
  | «ГипО» (ho : «ш».«основание» = .«сам») (hp : «ш».«правило» = "ГипО") :
      «ШагПринят» u «преж» «ш» («итог» «ш» [(«ш».«номер», «ш».«формула»)])
  /-- ГипД: половина дизъюнкции допущения строки N — открытая гипотеза случая. -/
  | «ГипД» (n : Nat) (l r : «Форм») (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "ГипД")
      (hd : u.«допущение» n = some (.«или» l r)) (hf : «ш».«формула» = l ∨ «ш».«формула» = r) :
      «ШагПринят» u «преж» «ш» ⟨«ш».«номер», «ш».«правило», «ш».«формула», n, [(«ш».«номер», «ш».«формула»)]⟩
  /-- Р1: под гипотезой охраны H выведено Ц (шаг M, ни на чём кроме H) — «если У то Ц иначе да». -/
  | «Р1» (hn m : Nat) (ph pm : «Принятый») (c q : «Форм») (ho : «ш».«основание» = .«из2» hn m) (hp : «ш».«правило» = "Р1")
      (hh : «шагПо» «преж» hn = some ph) (hm : «шагПо» «преж» m = some pm) (hg : ph.«правило» = "ГипО")
      (hf : «ш».«формула» = .«еслиФ» c q .«да») (hc : ph.«формула» = c) (hq : pm.«формула» = q)
      (hotkr : ∀ p ∈ pm.«откр», p.1 = ph.«номер» ∧ p.2 = c) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Р4: два случая под двумя гипотезами ГипД одной строки-дизъюнкции. -/
  | «Р4» (m1 m2 : Nat) (p1 p2 pa pb : «Принятый») (a b : Nat × «Форм») (n : Nat) (l r : «Форм»)
      (ho : «ш».«основание» = .«из2» m1 m2) (hp : «ш».«правило» = "Р4")
      (h1 : «шагПо» «преж» m1 = some p1) (h2 : «шагПо» «преж» m2 = some p2)
      (hf1 : p1.«формула» = «ш».«формула») (hf2 : p2.«формула» = «ш».«формула»)
      (ha : «единственная» p1.«откр» = some a) (hb : «единственная» p2.«откр» = some b) (hab : a.1 ≠ b.1)
      (hpa : «шагПо» «преж» a.1 = some pa) (hpb : «шагПо» «преж» b.1 = some pb)
      (hga : pa.«правило» = "ГипД") (hgb : pb.«правило» = "ГипД") (hstr : pa.«строка» = n) (hstr' : pb.«строка» = n)
      (hfa : a.2 = pa.«формула») (hfb : b.2 = pb.«формула»)
      (hd : u.«допущение» n = some (.«или» l r))
      (hpoloviny : (pa.«формула» = l ∧ pb.«формула» = r) ∨ (pa.«формула» = r ∧ pb.«формула» = l)) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Н1: литерал не меньше нуля. -/
  | «Н1» (k : Int) (ho : «ш».«основание» = .«сам») (hp : «ш».«правило» = "Н1")
      (hf : «ш».«формула» = «≥0» (.«лит» k)) (hk : 0 ≤ k) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Н2: допущение «Т не меньше 0» знак в знак. -/
  | «Н2» (n : Nat) (t : «ТермЧ») (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "Н2")
      (hf : «ш».«формула» = «≥0» t) (hd : u.«допущение» n = some («≥0» t)) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Н3: имя, объявленное типом с дном. -/
  | «Н3» (n : Nat) (x : String) (d : «Довод») (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "Н3")
      (hf : «ш».«формула» = «≥0» (.«имя» x)) (hd : u.«довод» n x = some d) (hdno : d.«сДном» = true) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Н4: встроенная «длина Т». -/
  | «Н4» (l : «ТермС») (ho : «ш».«основание» = .«сам») (hp : «ш».«правило» = "Н4")
      (hf : «ш».«формула» = «≥0» (.«длина» l)) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- Н5: сумма двух неотрицательных. -/
  | «Н5» (n m : Nat) (p1 p2 : «Принятый») (l r : «ТермЧ») (ho : «ш».«основание» = .«из2» n m) (hp : «ш».«правило» = "Н5")
      (h1 : «шагПо» «преж» n = some p1) (h2 : «шагПо» «преж» m = some p2)
      (hf : «ш».«формула» = «≥0» (.«плюс» l r)) (hp1 : p1.«формула» = «≥0» l) (hp2 : p2.«формула» = «≥0» r) :
      «ШагПринят» u «преж» «ш» («итог» «ш» (p1.«откр» ++ p2.«откр»))
  /-- Н9: квадрат конечного. -/
  | «Н9» (n : Nat) (p : «Принятый») (t : «ТермЧ») (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "Н9")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = «≥0» (.«умножить» t t))
      (hp1 : p.«формула» = .«кон» t) (hkon : p.«правило».startsWith "Кон" = true) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- Н12: разность под записанным порядком. -/
  | «Н12» (n m : Nat) (p1 p2 : «Принятый») (l r : «ТермЧ») (k : Int) (ho : «ш».«основание» = .«из2» n m) (hp : «ш».«правило» = "Н12")
      (h1 : «шагПо» «преж» n = some p1) (h2 : «шагПо» «преж» m = some p2)
      (hf : «ш».«формула» = «≥0» (.«минус» l r)) (hp1 : p1.«формула» = «≥0» r) (hp2 : p2.«формула» = «≤К» r k)
      (hpor : «порядокДопущением» u r l) :
      «ШагПринят» u «преж» «ш» («итог» «ш» (p1.«откр» ++ p2.«откр»))
  /-- Пред1: представимость довода точной сетки — по обязательству входа. -/
  | «Пред1» (n : Nat) (x : String) (d : «Довод») (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "Пред1")
      (hf : «ш».«формула» = .«помещается» (.«имя» x)) (hd : u.«довод» n x = some d) (ht : d.«точный» = true)
      (hob : «естьОбязательство» u x («≤К» (.«имя» x) «К-предст») n) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- П1: литерал не выше потолка. -/
  | «П1» (a k : Int) (ho : «ш».«основание» = .«сам») (hp : «ш».«правило» = "П1")
      (hf : «ш».«формула» = «≤К» (.«лит» a) k) (hk : a ≤ k) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- П2 строкой: допущение «Т не больше К'» либо «Т равен К'» при К' ≤ К. -/
  | «П2-строка» (n : Nat) (t : «ТермЧ») (k k2 : Int) (ho : «ш».«основание» = .«строка» n) (hp : «ш».«правило» = "П2")
      (hf : «ш».«формула» = «≤К» t k)
      (hd : u.«допущение» n = some («≤К» t k2) ∨ u.«допущение» n = some (.«равен» t (.«лит» k2))) (hk : k2 ≤ k) :
      «ШагПринят» u «преж» «ш» («итог» «ш» [])
  /-- П2 шагом: то же допущение формулой шага-гипотезы «из M» (ведро Е). -/
  | «П2-шаг» (n : Nat) (p : «Принятый») (t : «ТермЧ») (k k2 : Int) (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "П2")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = «≤К» t k)
      (hp1 : p.«формула» = «≤К» t k2 ∨ p.«формула» = .«равен» t (.«лит» k2)) (hk : k2 ≤ k) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- П3: потолок от посылки Пред1 при К не ниже К_предст. -/
  | «П3» (n : Nat) (p : «Принятый») (x : String) (k : Int) (ho : «ш».«основание» = .«из» n) (hp : «ш».«правило» = "П3")
      (h1 : «шагПо» «преж» n = some p) (hf : «ш».«формула» = «≤К» (.«имя» x) k)
      (hpred : p.«правило» = "Пред1") (hp1 : p.«формула» = .«помещается» (.«имя» x)) (hk : «К-предст» ≤ k) :
      «ШагПринят» u «преж» «ш» («итог» «ш» p.«откр»)
  /-- П5: разность — уменьшаемое под потолком, вычитаемое неотрицательно; К в сетке. -/
