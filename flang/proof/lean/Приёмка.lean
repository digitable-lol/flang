      «при» (l' = l ∧ r' = r ∧ 0 ≤ a ∧ 0 ≤ b ∧ a + b ≤ «К-предст» ∧ c = a + b) («итог» «ш» (p1.«откр» ++ p2.«откр»))
    | _, _, _ => none

/-- Зеркало сверщика у Разв2 (задача 8836): вызов довода-функции — имя без
    ёлочек — плоскости не нарушает. Обратное — вызов объявленной функции с
    доводами плоским не бывает — искажение 23 в `Ловушка.lean`. -/
theorem «плоскость-довод-функции» (f : String) (h : f.startsWith "«" = false) (d : «Доводы»)
    (hd : «безВызоваОбъявленнойД» d = true) :
    «безВызоваОбъявленнойТело» (.«число» (.«вызов» f d)) = true := by
  simp [«безВызоваОбъявленнойТело», «безВызоваОбъявленной», «объявленная», h, hd]

/-- Пр1: пара «А меньше Б» и «Б не больше А» — стороны второй переставлены знак в знак. -/
def «Пр1?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («из2?» «преж» «ш»).bind fun (p1, p2) =>
    match p1.«формула», p2.«формула» with
    | .«меньше» a b, .«неБольше» b' a' => «при» (a = a' ∧ b = b') («итог» «ш» (p1.«откр» ++ p2.«откр»))
    | _, _ => none

/-- М1: посылка и заключение — один вид отношения с тем же литералом, стороны s и t — мера. -/
def «М1?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («из1?» «преж» «ш»).bind fun p =>
    match «разобратьОтн?» p.«формула», «разобратьОтн?» «ш».«формула» with
    | some (r, s, k), some (r', t, k') =>
      «при» (r = r' ∧ k = k' ∧ «мера1» s t = true ∧ -«порог» < k ∧ k < «порог») («итог» «ш» p.«откр»)
    | _, _ => none

/-- М2: одно отношение, одна сторона та же, другая переписана мерой свёртки. -/
def «М2?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («из1?» «преж» «ш»).bind fun p =>
    match «разобрать2?» p.«формула», «разобрать2?» «ш».«формула» with
    | some (c, x, y), some (c', x', y') =>
      «при» (c = c' ∧ ((x = x' ∧ «мера2» y y' = true) ∨ (y = y' ∧ «мера2» x x' = true))) («итог» «ш» p.«откр»)
    | _, _ => none

/-- К↑: одно отношение, одна сторона та же, другая — поле выписанного конструктора
    вместо тела поля в посылке. -/
def «К↑?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («из1?» «преж» «ш»).bind fun p =>
    match «разобрать2?» p.«формула», «разобрать2?» «ш».«формула» with
    | some (c, x, y), some (c', x', y') =>
      «при» (c = c' ∧ ((y = y' ∧ «полеСтороны?» x' = some x) ∨ (x = x' ∧ «полеСтороны?» y' = some y))) («итог» «ш» p.«откр»)
    | _, _ => none

/-- Разв1 для суммы: разбор выписанного конструктора, посылка — ветвь его варианта
    с телами полей на местах имён. -/
def «Разв1?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («из1?» «преж» «ш»).bind fun p =>
    match «ш».«формула» with
    | .«разборСм» (.«вариант» k fs) cs =>
      match «ветвь?» k cs with
      | some (bs, b) =>
        match «поляИмён» fs bs with
        | some ps => «при» («цепьЧиста» b ps = true ∧ p.«формула» = «подстПар» b ps) («итог» «ш» p.«откр»)
        | none => none
      | none => none
    | _ => none

/-- Разв3 по вызову: функция, чьё тело — строка M, плоская, и заключение — посылка
    с развёрнутыми вызовами этой функции (хотя бы одним). -/
def «Разв3-вызов?» (u : «Утверждение») (p : «Принятый») (m : Nat) («ш» : «Шаг») : Option «Принятый» :=
  match u.«определения».find? (fun d => d.«строка» == m) with
  | some d =>
    «при» («безВызоваОбъявленнойТело» d.«тело» = true ∧ «ш».«формула» ≠ p.«формула» ∧
           «замФ» («развёрнут?» d) «ш».«формула» p.«формула» = true) («итог» «ш» p.«откр»)
  | none => none

/-- Разв3: строка M — тело своей функции (развёртка на месте «результат») либо
    тело вызванной (развёртка вызова) — как у сверщика, хозяин строки решает. -/
def «Разв3?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
  («изСтрока?» «преж» «ш»).bind fun (p, m) =>
    match u.«функция».«тело» with
    | some (m', t) =>
      if m = m' then
        «при» («захват?» («связанныеФ» «ш».«формула») "результат" t = false ∧
               p.«формула» = «подстФ» «ш».«формула» "результат" t) («итог» «ш» p.«откр»)
      else «Разв3-вызов?» u p m «ш»
    | none => «Разв3-вызов?» u p m «ш»

/-- Приём по имени правила. -/
