theorem «И2?-верно» (h : «И2?» u «преж» «ш» = some p) (hn : «ш».«правило» = "И2") : «ШагПринят» u «преж» «ш» p := by
  simp only [«И2?», Option.bind_eq_some_iff] at h
  obtain ⟨q, hq, h⟩ := h
