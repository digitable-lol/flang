  («строка?» «ш»).bind fun n => (u.«допущение» n).bind fun f =>
    «при» (f = «ш».«формула» ∧ «скаляр» «ш».«формула» = false) («итог» «ш» [])

def «Кон1?» (u : «Утверждение») («преж» : List «Принятый») («ш» : «Шаг») : Option «Принятый» :=
