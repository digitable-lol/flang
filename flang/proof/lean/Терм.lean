theorem «подстановкаСм» : ∀ (c : «ТермСм») (x : String) (s : «Тело») (w : «Мир»),
    «Чисто» («связанныеСм» c) x s → «оценитьСм» («подстСм» c x s) w = «оценитьСм» c («мир-с» w x s)
  | .«вариант» k fs, x, s, w, h => by
      simp only [«подстСм», «оценитьСм», «связанныеСм»] at *
      rw [«подстановкаП» fs x s w h]
  | .«имяСм» y, x, s, w, h => by
      by_cases hy : y = x
      · subst hy; simp [«подстСм», «оценитьСм», «мир-с», «суммой-верно»]
      · simp [«подстСм», «оценитьСм», «мир-с», hy]
  | .«вызовСм» f d, x, s, w, h => by
      simp only [«подстСм», «оценитьСм», «связанныеСм»] at *
      rw [«подстановкаД» d x s w («Чисто-право» h), «вызываемая-подст» f x s w («Чисто-лево» h)]
      rfl
theorem «подстановкаП» : ∀ (fs : «Поля») (x : String) (s : «Тело») (w : «Мир»),
    «Чисто» («связанныеП» fs) x s → «оценитьП» («подстП» fs x s) w = «оценитьП» fs («мир-с» w x s)
  | .«нет», x, s, w, h => by simp [«подстП», «оценитьП»]
  | .«ещё» p t r, x, s, w, h => by
      simp only [«подстП», «оценитьП», «связанныеП»] at *
      rw [«подстановкаТело» t x s w («Чисто-лево» h), «подстановкаП» r x s w («Чисто-право» h)]
theorem «подстановкаСл» : ∀ (cs : «Случаи») (x : String) (s : «Тело») (v : «Значение») (w : «Мир»),
    «Чисто» («связанныеСл» cs) x s → «оценитьСл» («подстСл» cs x s) v w = «оценитьСл» cs v («мир-с» w x s)
  | .«нет», x, s, v, w, h => by simp [«подстСл», «оценитьСл»]
  | .«ещё» k bs u r, x, s, v, w, h => by
      simp only [«подстСл», «оценитьСл», «связанныеСл», List.append_assoc] at *
      by_cases hk : «вариантЗнач» v = some k
      · simp only [hk, ↓reduceIte]
        rw [«подстановкаФ» u x s _ («Чисто-лево» («Чисто-право» h)),
            «мир-с-под-полями» w x s bs v («Чисто-лево» h)]
      · simp only [hk, ↓reduceIte]
        exact «подстановкаСл» r x s v w («Чисто-право» («Чисто-право» h))
end

/-- Существование, оценённое телом на свидетеле, влечёт «∃» модели — леммой «Св1». -/
theorem «есть-влечёт-∃» (m : String) (t : «ТермЧ») (u : «Форм») (w : «Мир»)
    (h : «оценитьФ» (.«есть» m t u) w = true) :
    ∃ v : «Знач», «оценитьФ» u («обновить» w m v) = true :=
  «Св1» (fun v => «оценитьФ» u («обновить» w m v) = true) («оценить» t w) h

/-! ## Мостики между формулой записи и словами модели

Ведомость пишет неотрицательность формулой «Т не меньше 0», конечность —
«Т : кон», потолок — «Т не больше К». Здесь показано, что значение такой
формулы — ровно то слово модели, о котором говорит лемма правила. -/

/-- «Т не меньше 0» в записи есть «неотр» модели. -/
theorem «неотр-это-порядок» (x : «Знач») : «неотр» x = «неБольше» («кон» 0) x := by
  cases x <;> simp [«неотр», «неБольше»]

theorem «числом-конечно» (x : «Знач») (h : «числом» x = true) : «конечно» x = true := by
  cases x <;> simp_all [«числом», «конечно»]

/-- Γ ⊢ Ф, записанное о формуле. -/
abbrev «Выводится» (Γ : List («Факт» «Мир»)) (f : «Форм») : Prop :=
  «Судим» Γ («Факт-из» f)

/-- «Т не меньше 0» -/
abbrev «≥0» (t : «ТермЧ») : «Форм» := .«неМеньше» t (.«лит» 0)
/-- «Т не больше К» -/
abbrev «≤К» (t : «ТермЧ») (k : Int) : «Форм» := .«неБольше» t (.«лит» k)

theorem «факт-неотр» (t : «ТермЧ») (w : «Мир») :
    «Факт-из» («≥0» t) w ↔ «неотр» («оценить» t w) = true := by
  simp [«Факт-из», «оценитьФ», «оценить», «неМеньше», «неотр-это-порядок»]

theorem «факт-потолок» (t : «ТермЧ») (k : Int) (w : «Мир») :
    «Факт-из» («≤К» t k) w ↔ «неБольше» («оценить» t w) («кон» k) = true := by
  simp [«Факт-из», «оценитьФ», «оценить»]

theorem «факт-кон» (t : «ТермЧ») (w : «Мир») :
    «Факт-из» (.«кон» t) w ↔ «конечно» («оценить» t w) = true := by
  simp [«Факт-из», «оценитьФ»]

theorem «факт-цел» (t : «ТермЧ») (w : «Мир») :
    «Факт-из» (.«цел» t) w ↔ «числом» («оценить» t w) = true := by
  simp [«Факт-из», «оценитьФ»]

theorem «факт-помещается» (t : «ТермЧ») (w : «Мир») :
    «Факт-из» (.«помещается» t) w ↔ «неБольше» («оценить» t w) («кон» («порог» - 1)) = true := by
  simp [«Факт-из», «оценитьФ»]

theorem «факт-всех» (e : String) (l : «ТермС») (u : «Форм») (w : «Мир») :
    «Факт-из» (.«всех» e l u) w ↔
      «всеЭ» (fun v => «оценитьФ» u («обновить» w e v)) («оценитьС» l w) = true := by
  simp [«Факт-из», «оценитьФ»]

/-! ## Переформулировка лемм правил через «оценить» (веха 1, ADR-0041 §2.4 п.1)

Каждая лемма ниже — следствие ОДНОИМЁННОЙ леммы `Правила.lean`, и ничего
сверх подъёма (`подъём0`–`подъём2` из `Модель.lean`) и мостиков выше в ней
нет: если бы модель терма говорила не то, что модель значений, эти следствия
не прошли бы. Семейства — Н, П, Т, Э (как велит задача 2907) и Кон, Св, Пред. -/

/- Семейство Н -/

theorem «Н1-терм» (Γ : List («Факт» «Мир»)) (n : Int) (h : 0 ≤ n) :
    «Выводится» Γ («≥0» (.«лит» n)) :=
  «подъём0» (fun w => («факт-неотр» _ w).mpr («Н1» n h))

theorem «Н2-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ»)
    (h : «Факт-из» («≥0» t) ∈ Γ) : «Выводится» Γ («≥0» t) := «Т1» Γ _ h

theorem «Н3-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ»)
    (h : «Факт-из» («≥0» t) ∈ Γ) : «Выводится» Γ («≥0» t) := «Т1» Γ _ h

theorem «Н4-терм» (Γ : List («Факт» «Мир»)) (l : «ТермС») :
    «Выводится» Γ («≥0» (.«длина» l)) :=
  «подъём0» (fun w => («факт-неотр» _ w).mpr (by simp only [«оценить»]; exact «Н4» _))

theorem «Н5-терм» (Γ : List («Факт» «Мир»)) (l p : «ТермЧ»)
    (h1 : «Выводится» Γ («≥0» l)) (h2 : «Выводится» Γ («≥0» p)) :
    «Выводится» Γ («≥0» (.«плюс» l p)) :=
  «подъём2» (fun w hl hp => («факт-неотр» _ w).mpr (by
    simp only [«оценить»]
    exact «Н5» w.«о» _ _ ((«факт-неотр» _ w).mp hl) ((«факт-неотр» _ w).mp hp))) h1 h2

theorem «Н6-терм» (Γ : List («Факт» «Мир»)) (u : «Форм») (a b : «ТермЧ»)
    (h1 : «Выводится» Γ («≥0» a)) (h2 : «Выводится» Γ («≥0» b)) :
    «Выводится» Γ («≥0» (.«если» u a b)) :=
  «подъём2» (fun w ha hb => («факт-неотр» _ w).mpr (by
    simp only [«оценить»]
    exact «Н6» _ _ _ ((«факт-неотр» _ w).mp ha) ((«факт-неотр» _ w).mp hb))) h1 h2

theorem «Н7-терм» (Γ : List («Факт» «Мир»)) (l : «ТермС») (n : «ТермЧ») (a e : String) (s : «ТермЧ»)
    (h1 : «Выводится» Γ («≥0» n))
    (h2 : ∀ w acc v, «неотр» acc = true →
      «неотр» («оценить» s («обновить» («обновить» w a acc) e v)) = true) :
    «Выводится» Γ («≥0» (.«свёртка» l n a e s)) :=
  «подъём1» (fun w hn => («факт-неотр» _ w).mpr (by
    simp only [«оценить»]
    exact «Н7» _ _ _ ((«факт-неотр» _ w).mp hn) (fun acc v hacc => h2 w acc v hacc))) h1

theorem «Н8-терм» (Γ : List («Факт» «Мир»)) (l p : «ТермЧ»)
    (h1 : «Выводится» Γ (.«меньше» (.«лит» 0) l)) (h2 : «Выводится» Γ (.«кон» l))
    (h3 : «Выводится» Γ («≥0» p)) :
    «Выводится» Γ («≥0» (.«умножить» l p)) := by
  intro w hw
  have a := h1 w hw
  have b := («факт-кон» _ w).mp (h2 w hw)
  have c := («факт-неотр» _ w).mp (h3 w hw)
  simp only [«Факт-из», «оценитьФ», «оценить»] at a
  apply («факт-неотр» _ w).mpr
  simp only [«оценить»]
  exact «Н8-второй» w.«о» _ _ a b c

theorem «Н9-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ»)
    (h : «Выводится» Γ (.«кон» t)) : «Выводится» Γ («≥0» (.«умножить» t t)) :=
  «подъём1» (fun w ht => («факт-неотр» _ w).mpr (by
    simp only [«оценить»]
    exact «Н9» w.«о» _ ((«факт-кон» _ w).mp ht))) h

theorem «Н10-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ») (d : Int) (hd : d ≠ 0)
    (h1 : «Выводится» Γ («≥0» t)) (h2 : «Выводится» Γ (.«цел» t)) :
    «Выводится» Γ («≥0» (.«остаток» t (.«лит» d))) :=
