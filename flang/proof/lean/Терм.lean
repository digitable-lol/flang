    «Выводится» Γ (.«неУбывает» (.«еслиС» c a b)) :=
  «подъём2» (fun w hcw ha => by
    simp only [«Факт-из», «оценитьФ», «оценитьС»] at hcw ha ⊢
    exact «СС4-противоречием» _ _ _ hcw ha) hc h1

theorem «умножить-перест» («о» : «Округление») (x y : «Знач») : «умножить» «о» x y = «умножить» «о» y x := by
  cases x <;> cases y <;> simp [«умножить», «беск», Int.mul_comm, Bool.or_comm]

theorem «плюс-перест» («о» : «Округление») (x y : «Знач») : «плюс» «о» x y = «плюс» «о» y x := by
  cases x <;> cases y <;> simp [«плюс», «чис», Int.add_comm]

theorem «О5-терм» (Γ : List («Факт» «Мир»)) (e g e' g' s : «ТермЧ»)
    (he : ∀ w, «оценить» e w = «плюс» w.«о» («оценить» e' w) («оценить» s w))
    (hg : ∀ w, «оценить» g w = «плюс» w.«о» («оценить» g' w) («оценить» s w))
    (P : «Факт» «Мир») (hs : ∀ w, P w → «числом» («оценить» s w) = true) (hP : «Судим» Γ P)
    (h1 : «Выводится» Γ (.«неБольше» e' g')) : «Выводится» Γ (.«неБольше» e g) :=
  «подъём2» (fun w hPw h1w => by
    simp only [«Факт-из», «оценитьФ»] at h1w ⊢
    rw [he w, hg w]; exact «О5» w.«о» _ _ _ h1w (hs w hPw)) hP h1

/-- Левая сторона О6 представима по построению: имя (факт языка «числа-представимы»,
    `Запись.lean`) либо целый литерал не выше 2⁵³ по модулю. -/
def «представимаЛевая» : «ТермЧ» → Bool
  | .«имя» _ => true
  | .«лит» n => decide (-«порог» ≤ n) && decide (n ≤ «порог»)
  | _ => false

theorem «представимаЛевая-верно» {e : «ТермЧ»} (h : «представимаЛевая» e = true) (w : «Мир»)
    (hn : ∀ x, «представимо» w.«о» («какЧисло» (w.«имя» x))) : «представимо» w.«о» («оценить» e w) := by
  cases e
  case «имя» x => simp only [«оценить»]; exact hn x
  case «лит» n =>
    simp only [«представимаЛевая», Bool.and_eq_true, decide_eq_true_eq] at h
    simp only [«оценить», «представимо»]
    exact w.«о».«точно» n h.1 h.2
  all_goals simp [«представимаЛевая»] at h

/-- Пары (основа, прибавка) правой стороны О6: прибавкой бывает любое из двух
    слагаемых — сверщик пробует сначала левое, потом правое. -/
def «слагаемыеО6» : «ТермЧ» → List («ТермЧ» × «ТермЧ»)
  | .«плюс» a b => [(b, a), (a, b)]
  | _ => []

theorem «слагаемыеО6-верно» {g base s : «ТермЧ»} (h : (base, s) ∈ «слагаемыеО6» g) (w : «Мир») :
    «оценить» g w = «плюс» w.«о» («оценить» base w) («оценить» s w) := by
  cases g <;> simp [«слагаемыеО6»] at h
  rename_i a b
  rcases h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · simp only [«оценить»]; exact «плюс-перест» _ _ _
  · simp only [«оценить»]

/-- О6 на термах: прибавка неотрицательна и конечна (посылка ⟨2⟩), левая сторона
    представима (факт языка) — «Е ≤ Г» даёт «Е ≤ Г плюс Б». -/
theorem «О6-терм» (Γ : List («Факт» «Мир»)) (e g g' s : «ТермЧ»)
    (hg : ∀ w, «оценить» g w = «плюс» w.«о» («оценить» g' w) («оценить» s w))
    (P : «Факт» «Мир») (hs : ∀ w, P w → «неотр» («оценить» s w) = true ∧ «конечно» («оценить» s w) = true)
    (hP : «Судим» Γ P) (R : «Факт» «Мир») (hr : ∀ w, R w → «представимо» w.«о» («оценить» e w))
    (hR : «Судим» Γ R) (h1 : «Выводится» Γ (.«неБольше» e g')) : «Выводится» Γ (.«неБольше» e g) := by
  intro w hw
  have a := h1 w hw
  simp only [«Факт-из», «оценитьФ»] at a ⊢
  rw [hg w]
  exact «О6» w.«о» _ _ _ a (hs w (hP w hw)).1 (hs w (hP w hw)).2 (hr w (hR w hw))

theorem «Д3-терм» (Γ : List («Факт» «Мир»)) (l r : «ТермЧ») (a b : Int) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hab : a + b ≤ «порог» - 1)
    (h1 : «Выводится» Γ (.«неБольше» (.«лит» a) l)) (h2 : «Выводится» Γ (.«неБольше» (.«лит» b) r)) :
    «Выводится» Γ (.«неБольше» (.«лит» (a + b)) (.«плюс» l r)) :=
  «подъём2» (fun w hl hr => by
    simp only [«Факт-из», «оценитьФ», «оценить»] at hl hr ⊢
    exact «Д3-днами» w.«о» _ _ a b hl hr ha hb hab) h1 h2

/- Семейство Т -/

theorem «Т1-терм» (Γ : List («Факт» «Мир»)) (f : «Форм») (h : «Факт-из» f ∈ Γ) :
    «Выводится» Γ f := «Т1» Γ _ h

/- Семейство Э -/

/-- «для всех E из Л : У» -/
abbrev «∀э» (e : String) (l : «ТермС») (u : «Форм») : «Форм» := .«всех» e l u

theorem «Э1-терм» (Γ : List («Факт» «Мир»)) (e : String) (u : «Форм») :
    «Выводится» Γ («∀э» e .«пустой» u) :=
  «подъём0» (fun w => («факт-всех» _ _ _ w).mpr (by simp only [«оценитьС»]; exact «Э1» _))

/-- Э2: свойство цели — условие отбора с E вместо X. Побочные условия те же,
    что у сверщика (подстановка без захвата), и ещё одно, которого сверщик не
    спрашивает: E не свободно в условии отбора (иначе E, стоящее в условии
    свободным, после подстановки читалось бы как связанное — захват имени
    самой цели). -/
theorem «Э2-терм» (Γ : List («Факт» «Мир»)) (e x : String) (l : «ТермС») (u2 : «Форм»)
    (hc : «Чисто» («связанныеФ» u2) x (.«число» (.«имя» e)))
    (he : e = x ∨ e ∉ «свободныеФ» u2) :
    «Выводится» Γ («∀э» e (.«отбор» l x u2) («подстФ» u2 x (.«число» (.«имя» e)))) :=
  «подъём0» (fun w => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    have key : ∀ v, «оценитьФ» («подстФ» u2 x (.«число» (.«имя» e))) («обновить» w e v) =
        «оценитьФ» u2 («обновить» w x v) := by
      intro v
      rw [«подстановкаФ» u2 x (.«число» (.«имя» e)) _ hc]
      have hv : «значение» (.«число» (.«имя» e)) («обновить» w e v) = .«число» v := by
        simp [«значение», «оценить»]
      simp only [«мир-с», hv]
      rcases he with rfl | he
      · show «оценитьФ» u2 («связать» («связать» w e (.«число» v)) e (.«число» v)) = _
        rw [«связать-дважды»]
      · apply «согласиеФ»
        refine ⟨rfl, rfl, fun y hy => ?_⟩
        have : y ≠ e := fun h => he (h ▸ hy)
        simp [this]
    rw [«всеЭ-конгр» _ (fun v => «оценитьФ» u2 («обновить» w x v)) _ key]
    exact «Э2» _ _))

theorem «Э3-приписать-терм» (Γ : List («Факт» «Мир»)) (e : String) (d : «ТермЧ») (l : «ТермС») (u : «Форм»)
    (hc : «Чисто» («связанныеФ» u) e (.«число» d))
    (h1 : «Выводится» Γ («подстФ» u e (.«число» d))) (h2 : «Выводится» Γ («∀э» e l u)) :
    «Выводится» Γ («∀э» e (.«приписать» d l) u) :=
  «подъём2» (fun w ha hb => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    have ha' : «оценитьФ» u («обновить» w e («оценить» d w)) = true := by
      have := ha; simp only [«Факт-из»] at this; rw [«подстановкаФ» u e (.«число» d) w hc] at this; exact this
    exact «Э3-приписать» _ _ _ ha' ((«факт-всех» _ _ _ w).mp hb))) h1 h2

theorem «Э3-добавить-терм» (Γ : List («Факт» «Мир»)) (e : String) (d : «ТермЧ») (l : «ТермС») (u : «Форм»)
    (hc : «Чисто» («связанныеФ» u) e (.«число» d))
    (h1 : «Выводится» Γ («подстФ» u e (.«число» d))) (h2 : «Выводится» Γ («∀э» e l u)) :
    «Выводится» Γ («∀э» e (.«добавить» d l) u) :=
  «подъём2» (fun w ha hb => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    have ha' : «оценитьФ» u («обновить» w e («оценить» d w)) = true := by
      have := ha; simp only [«Факт-из»] at this; rw [«подстановкаФ» u e (.«число» d) w hc] at this; exact this
    exact «Э3-добавить» _ _ _ ha' ((«факт-всех» _ _ _ w).mp hb))) h1 h2

theorem «Э4-терм» (Γ : List («Факт» «Мир»)) (e : String) (c : «Форм») (a b : «ТермС») (u : «Форм»)
    (h1 : «Выводится» Γ («∀э» e a u)) (h2 : «Выводится» Γ («∀э» e b u)) :
    «Выводится» Γ («∀э» e (.«еслиС» c a b) u) :=
  «подъём2» (fun w ha hb => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    exact «Э4» _ _ _ _ ((«факт-всех» _ _ _ w).mp ha) ((«факт-всех» _ _ _ w).mp hb))) h1 h2

/-- Т2 (задача 3123): цель — допущение-квантор с другим именем элемента.
    Переименование e вместо a — подстановка имени без захвата; и ещё одно
    условие, которого сверщик не спрашивает: имя цели e не свободно в свойстве
    допущения (или совпадает с a). Без него «для всех э из Л : э больше у»
    давало бы «для всех у из Л : у больше у» — встречный пример
    «Т2-без-свежести-ложно» ниже, ловушка 33. -/
theorem «Т2-терм» (Γ : List («Факт» «Мир»)) (a e : String) (l : «ТермС») (b : «Форм»)
    (hc : «Чисто» («связанныеФ» b) a (.«число» (.«имя» e)))
    (he : e = a ∨ e ∉ «свободныеФ» b)
    (h : «Факт-из» («∀э» a l b) ∈ Γ) :
    «Выводится» Γ («∀э» e l («подстФ» b a (.«число» (.«имя» e)))) :=
  «подъём1» (fun w ha => («факт-всех» _ _ _ w).mpr (by
    have key : ∀ v, «оценитьФ» («подстФ» b a (.«число» (.«имя» e))) («обновить» w e v) =
        «оценитьФ» b («обновить» w a v) := by
      intro v
      rw [«подстановкаФ» b a (.«число» (.«имя» e)) _ hc]
      have hv : «значение» (.«число» (.«имя» e)) («обновить» w e v) = .«число» v := by
        simp [«значение», «оценить»]
      simp only [«мир-с», hv]
      rcases he with rfl | he
      · show «оценитьФ» b («связать» («связать» w e (.«число» v)) e (.«число» v)) = _
        rw [«связать-дважды»]
      · apply «согласиеФ»
        refine ⟨rfl, rfl, fun y hy => ?_⟩
        have : y ≠ e := fun h => he (h ▸ hy)
        simp [this]
    rw [«всеЭ-конгр» _ (fun v => «оценитьФ» b («обновить» w a v)) _ key]
    exact («факт-всех» _ _ _ w).mp ha)) («Т1» Γ _ h)

/-- Хвост выписанного списка без первого члена — так его пишет сверщик: пустой —
    `[]` (читается `«пустой»`), иначе выписанный. -/
def «хвостЧл» : «Члены» → «ТермС»
  | .«нет» => .«пустой»
  | r => .«выписан» r

theorem «хвостЧл-значение» (r : «Члены») (w : «Мир») : «оценитьС» («хвостЧл» r) w = «оценитьЧл» r w := by
  cases r <;> simp [«хвостЧл», «оценитьС», «оценитьЧл»]

/-- Э5 (задача 4058): выписанный список — свойство о первом члене и квантор над хвостом. -/
theorem «Э5-терм» (Γ : List («Факт» «Мир»)) (e : String) (x : «ТермЧ») (r : «Члены») (b : «Форм»)
    (hc : «Чисто» («связанныеФ» b) e (.«число» x))
    (h1 : «Выводится» Γ («подстФ» b e (.«число» x))) (h2 : «Выводится» Γ («∀э» e («хвостЧл» r) b)) :
    «Выводится» Γ («∀э» e (.«выписан» (.«ещё» x r)) b) :=
  «подъём2» (fun w ha hb => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС», «оценитьЧл»]
    have ha' : «оценитьФ» b («обновить» w e («оценить» x w)) = true := by
      have := ha; simp only [«Факт-из»] at this; rw [«подстановкаФ» b e (.«число» x) w hc] at this; exact this
    have hb' := («факт-всех» _ _ _ w).mp hb
    rw [«хвостЧл-значение»] at hb'
    exact «Э5» _ _ _ ha' hb')) h1 h2

/-- Э6 (задача 4058): свойство образа — свойство прообраза под П[э:=Ф]. Имя элемента
    x не свободно в свойстве (или совпадает с э): иначе квантор посылки связал бы
    чужое имя — встречный пример «Э6-имя-элемента-в-свойстве-ложно», ловушка 35. -/
theorem «Э6-терм» (Γ : List («Факт» «Мир»)) (e x : String) (l : «ТермС») (f : «ТермЧ») (b : «Форм»)
    (hc : «Чисто» («связанныеФ» b) e (.«число» f)) (hx : x = e ∨ x ∉ «свободныеФ» b)
    (h : «Выводится» Γ («∀э» x l («подстФ» b e (.«число» f)))) :
    «Выводится» Γ («∀э» e (.«отобразить» l x f) b) :=
  «подъём1» (fun w ha => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    rw [«всеЭ-отобр»]
    have key : ∀ v, «оценитьФ» («подстФ» b e (.«число» f)) («обновить» w x v) =
        ((fun r => «оценитьФ» b («обновить» w e r)) ∘ (fun v => «оценить» f («обновить» w x v))) v := by
      intro v
      rw [«подстановкаФ» b e (.«число» f) _ hc]
      simp only [«мир-с», «значение», Function.comp]
      rcases hx with rfl | hx
      · rw [«связать-дважды»]
      · apply «согласиеФ»
        refine ⟨rfl, rfl, fun y hy => ?_⟩
        have : y ≠ x := fun h => hx (h ▸ hy)
        simp [this]
    rw [← «всеЭ-конгр» _ _ _ key]
    exact («факт-всех» _ _ _ w).mp ha)) h

/-- Мир встречных примеров: округление грубое, имена носят то, что велено, вызовов нет. -/
def «мир-встречный» (v : String → «Значение») : «Мир» := ⟨«Грубо», v, fun _ _ => .«признак» false⟩

/-- ПАМЯТЬ О ЛОВУШКЕ 33: без свежести имени цели Т2 ложно. Допущение «для всех э
    из [3] : э больше у» при у = 1 истинно, а «для всех у из [3] : у больше у» —
    переименование э в у с захватом свободного у — ложно. Подстановка при этом
    чиста: в свойстве связанных имён нет. -/
theorem «Т2-без-свежести-ложно» :
    «Чисто» («связанныеФ» (.«больше» (.«имя» "э") (.«имя» "у"))) "э" (.«число» (.«имя» "у")) ∧
    «оценитьФ» («∀э» "э" (.«выписан» (.«ещё» (.«лит» 3) .«нет»)) (.«больше» (.«имя» "э") (.«имя» "у")))
      («мир-встречный» (fun _ => .«число» («кон» 1))) = true ∧
    «оценитьФ» («∀э» "у" (.«выписан» (.«ещё» (.«лит» 3) .«нет»))
        («подстФ» (.«больше» (.«имя» "э") (.«имя» "у")) "э" (.«число» (.«имя» "у"))))
      («мир-встречный» (fun _ => .«число» («кон» 1))) = false := by
  refine ⟨«захват?-чисто» (by decide), ?_, ?_⟩ <;>
    simp [«оценитьФ», «оценитьС», «оценитьЧл», «оценить», «подстФ», «подст», «всеЭ», «отобр»,
      «мир-встречный», «Тело».«числом», «меньше»]

/-- ПАМЯТЬ О ЛОВУШКЕ 35: без условия на имя элемента Э6 ложно. Посылка «для всех
    х из [5] : х больше 0» истинна, а цель «для всех э из ( отобразить [5] как х →
    х ) : х больше 0» говорит о ЧУЖОМ х — при х = −1 ложна. Подстановка чиста. -/
theorem «Э6-имя-элемента-в-свойстве-ложно» :
    «Чисто» («связанныеФ» (.«больше» (.«имя» "х") (.«лит» 0))) "э" (.«число» (.«имя» "х")) ∧
    «оценитьФ» («∀э» "х" (.«выписан» (.«ещё» (.«лит» 5) .«нет»))
        («подстФ» (.«больше» (.«имя» "х") (.«лит» 0)) "э" (.«число» (.«имя» "х"))))
      («мир-встречный» (fun _ => .«число» («кон» (-1)))) = true ∧
    «оценитьФ» («∀э» "э" (.«отобразить» (.«выписан» (.«ещё» (.«лит» 5) .«нет»)) "х" (.«имя» "х"))
        (.«больше» (.«имя» "х") (.«лит» 0)))
      («мир-встречный» (fun _ => .«число» («кон» (-1)))) = false := by
  refine ⟨«захват?-чисто» (by decide), ?_, ?_⟩ <;>
    simp [«оценитьФ», «оценитьС», «оценитьЧл», «оценить», «подстФ», «подст», «всеЭ», «отобр»,
      «мир-встречный», «Тело».«числом», «меньше»]

/-- ПАМЯТЬ О ЛОВУШКЕ 34: посылка ⟨1⟩ о ЧУЖОМ члене Э5 не даёт. «1 больше 0»
    истинно, хвост пуст, а «для всех э из [0] : э больше 0» ложно. -/
theorem «Э5-чужой-член-ложно» :
    «оценитьФ» («подстФ» (.«больше» (.«имя» "э") (.«лит» 0)) "э" (.«число» (.«лит» 1)))
      («мир-встречный» (fun _ => .«число» («кон» 0))) = true ∧
    «оценитьФ» («∀э» "э" («хвостЧл» .«нет») (.«больше» (.«имя» "э") (.«лит» 0)))
      («мир-встречный» (fun _ => .«число» («кон» 0))) = true ∧
    «оценитьФ» («∀э» "э" (.«выписан» (.«ещё» (.«лит» 0) .«нет»)) (.«больше» (.«имя» "э") (.«лит» 0)))
      («мир-встречный» (fun _ => .«число» («кон» 0))) = false := by
  refine ⟨?_, ?_, ?_⟩ <;>
    simp [«оценитьФ», «оценитьС», «оценитьЧл», «оценить», «подстФ», «подст», «всеЭ», «хвостЧл»,
      «мир-встречный», «Тело».«числом», «меньше»]

/-- ПАМЯТЬ О ЛОВУШКЕ 37: склейка, собранная в обратном порядке, Ч5 не даёт.
    «2*» начинается с «2», а «соединить "*" с "2"» — нет. -/
theorem «Ч5-обратная-склейка-ложно» :
    ("2".toList.isPrefixOf ("2" ++ "*").toList = true) ∧
    «оценитьФ» (.«начинается» (.«склейка» (.«литТ» "*") (.«литТ» "2")) (.«литТ» "2"))
      («мир-встречный» (fun _ => .«признак» false)) = false := by
  refine ⟨by simp <;> decide, ?_⟩
  simp [«оценитьФ», «оценитьТ», «начинается»] <;> decide

/- Св1 -/

theorem «Св1-терм» (Γ : List («Факт» «Мир»)) (m : String) (t : «ТермЧ») (u : «Форм»)
    (hc : «Чисто» («связанныеФ» u) m (.«число» t))
    (h : «Выводится» Γ («подстФ» u m (.«число» t))) : «Выводится» Γ (.«есть» m t u) :=
  «подъём1» (fun w hu => by
    simp only [«Факт-из», «оценитьФ»] at *
    rw [«подстановкаФ» u m (.«число» t) w hc] at hu
    exact hu) h

/-! ## Скл1–Скл3 и Переп1 на терме (задача 4722)

Леммы «Скл1»–«Скл3» и «Переп1» из «Правила.lean» говорят о значениях. Здесь то
же — о термах: склейка термов-текстов переставляется скобками и теряет пустой
литерал, не меняя значения ни в одном мире; и терм, в котором на месте имени x
стоит s, значит то же, что с s' на том же месте, если s и s' равны в каждом
мире, а подстановка ничего не захватывает («Чисто»). Вторая пара — прямое
следствие «подстановкаТ» и «подстановка»: мир с подстановкой один и тот же.
-/

theorem «Скл1-терм» (a b c : «ТермТ») (w : «Мир») :
    «оценитьТ» (.«склейка» (.«склейка» a b) c) w = «оценитьТ» (.«склейка» a (.«склейка» b c)) w := by
  simp [«оценитьТ», List.append_assoc]

theorem «Скл2-терм» (a : «ТермТ») (w : «Мир») :
    «оценитьТ» (.«склейка» (.«литТ» "") a) w = «оценитьТ» a w := by
  simp [«оценитьТ»]

theorem «Скл3-терм» (a : «ТермТ») (w : «Мир») :
    «оценитьТ» (.«склейка» a (.«литТ» "")) w = «оценитьТ» a w := by
  simp [«оценитьТ»]

theorem «Переп1-термТ» (t : «ТермТ») (x : String) (s s' : «Тело»)
    (hs : ∀ w, «значение» s w = «значение» s' w)
    (h : «Чисто» («связанныеТ» t) x s) (h' : «Чисто» («связанныеТ» t) x s') (w : «Мир») :
    «оценитьТ» («подстТ» t x s) w = «оценитьТ» («подстТ» t x s') w := by
  rw [«подстановкаТ» t x s w h, «подстановкаТ» t x s' w h']
  simp only [«мир-с», hs w]

theorem «Переп1-термЧ» (t : «ТермЧ») (x : String) (s s' : «Тело»)
    (hs : ∀ w, «значение» s w = «значение» s' w)
    (h : «Чисто» («связанные» t) x s) (h' : «Чисто» («связанные» t) x s') (w : «Мир») :
    «оценить» («подст» t x s) w = «оценить» («подст» t x s') w := by
  rw [«подстановка» t x s w h, «подстановка» t x s' w h']
  simp only [«мир-с», hs w]


/-! ## Разв2 и Разв3 на терме (аудит 2844)

Леммы «Разв2» и «Разв3» из «Правила.lean» — определительные равенства на
значениях; условия свежести им не нужны, потому что синтаксиса они не знают.
Здесь то же о термах: тело, вставшее на место «результат», и доводы, вставшие
на места параметров, значат то, что значит цель в мире с этими именами, — если
подстановка ничего не захватывает («Чисто», приёмка спрашивает `захват?`), а у
цепи пар второй параметр не свободен в первом доводе. Без этих условий оба
правила ложны: ловушки 53 и 54, встречные примеры ниже — подделки «Себя» и
«Разность» задачи 7563.
-/

/-- Разв2 (аудит 2844): тело t на месте «результат» в цели b — то же, что цель в
    мире, где «результат» носит значение t. Условие — подстановка без захвата. -/
theorem «Разв2-терм» (b : «Форм») (t : «Тело») (w : «Мир»)
    (hc : «Чисто» («связанныеФ» b) "результат" t) :
    «оценитьФ» («подстФ» b "результат" t) w = «оценитьФ» b («мир-с» w "результат" t) :=
  «подстановкаФ» b "результат" t w hc

/-- Разв3 (аудит 2844): два довода, вставшие на места параметров ПО ОДНОМУ, значат
    то же, что тело в мире, где оба параметра носят значения доводов, снятые в
    исходном мире (то есть подстановка РАЗОМ), — если каждая пара чиста и второй
    параметр q не свободен в первом доводе a. Без последнего условия ложно:
    «Разв3-по-одному-ложно», ловушка 54. -/
theorem «Разв3-терм» (t : «Тело») (p q : String) (a b : «Тело») (w : «Мир») (hpq : p ≠ q)
    (hc1 : «Чисто» («связанныеТело» t) p a)
    (hc2 : «Чисто» («связанныеТело» («подстТело» t p a)) q b)
    (hq : q ∉ «свободныеТело» a) :
    «значение» («подстТело» («подстТело» t p a) q b) w =
      «значение» t («связать» («связать» w p («значение» a w)) q («значение» b w)) := by
  rw [«подстановкаТело» _ q b w hc2, «подстановкаТело» t p a _ hc1]
  have ha : «значение» a («связать» w q («значение» b w)) = «значение» a w :=
    «согласиеТело» a _ _ ⟨rfl, rfl, fun y hy => by
      have hyq : y ≠ q := fun h => hq (h ▸ hy)
      simp [hyq]⟩
  simp only [«мир-с»]
  rw [ha, «связать-связать» _ _ _ _ _ hpq]

/-- ПАМЯТЬ О ЛОВУШКЕ 53 (подделка «Себя», 7563): без вопроса о захвате Разв2 ложно.
    Цель «для всех э из [1, 2] : не ( э больше результат )», тело «э»: посылка
    после подстановки — «для всех э из [1, 2] : не ( э больше э )» — истинна, а
    цель при доводе э = 0 ложна (1 больше 0). Подстановка НЕ чиста: связанное э
    цели свободно в теле — `захват?` говорит «да». -/
theorem «Разв2-без-захвата-ложно» :
    «захват?» («связанныеФ» («∀э» "э" (.«выписан» (.«ещё» (.«лит» 1) (.«ещё» (.«лит» 2) .«нет»)))
        (.«не» (.«больше» (.«имя» "э") (.«имя» "результат"))))) "результат" (.«число» (.«имя» "э")) = true ∧
    «оценитьФ» («подстФ» («∀э» "э" (.«выписан» (.«ещё» (.«лит» 1) (.«ещё» (.«лит» 2) .«нет»)))
        (.«не» (.«больше» (.«имя» "э") (.«имя» "результат")))) "результат" (.«число» (.«имя» "э")))
      («мир-встречный» (fun _ => .«число» («кон» 0))) = true ∧
    «оценитьФ» («∀э» "э" (.«выписан» (.«ещё» (.«лит» 1) (.«ещё» (.«лит» 2) .«нет»)))
        (.«не» (.«больше» (.«имя» "э") (.«имя» "результат"))))
      («мир-с» («мир-встречный» (fun _ => .«число» («кон» 0))) "результат" (.«число» (.«имя» "э"))) = false := by
  refine ⟨by decide, ?_, ?_⟩ <;>
    simp [«оценитьФ», «оценитьС», «оценитьЧл», «оценить», «подстФ», «подстС», «подстЧл», «подст», «всеЭ»,
      «мир-встречный», «мир-с», «связать», «значение», «Тело».«числом», «меньше», «какЧисло»]

/-- Мир встречного примера к Разв3: а = 0, б = 1. -/
def «мир-а0-б1» : «Мир» :=
  «мир-встречный» (fun x => if x = "а" then .«число» («кон» 0) else .«число» («кон» 1))

/-- ПАМЯТЬ О ЛОВУШКЕ 54 (подделка «Разность», 7563): доводами по одному Разв3 не
    даётся. Тело «а минус б», вызов «Разность» от б и а: по одному (а := б, потом
    б := а) выходит «а минус а» = 0, а разом — «б минус а» = 1 при а = 0, б = 1.
    Цепь пар НЕ чиста: второй параметр б свободен в первом доводе «б». -/
theorem «Разв3-по-одному-ложно» :
    "б" ∈ «свободныеТело» (.«число» (.«имя» "б")) ∧
    «какЧисло» («значение» («подстТело» («подстТело» (.«число» (.«минус» (.«имя» "а") (.«имя» "б")))
        "а" (.«число» (.«имя» "б"))) "б" (.«число» (.«имя» "а"))) «мир-а0-б1») = «кон» 0 ∧
    «какЧисло» («значение» (.«число» (.«минус» (.«имя» "а") (.«имя» "б")))
      («связать» («связать» «мир-а0-б1» "а" (.«число» («кон» 1))) "б" (.«число» («кон» 0)))) = «кон» 1 := by
  refine ⟨by decide, ?_, ?_⟩ <;>
    simp [«значение», «оценить», «подстТело», «подст», «мир-а0-б1», «мир-встречный», «связать»,
      «какЧисло», «минус», «плюс», «отр», «чис», «Тело».«числом», «Грубо», «окрГрубо», «порог»]
