      exact «Цел1» w.«о» _ _ (hm' w) (Or.inl hr))) h
  · exact «подъём1» (fun w hr => («факт-цел» _ w).mpr (by
      simp only [«Факт-из», «оценитьФ», «оценить»] at hr
      exact «Цел1» w.«о» _ _ (hm' w) (Or.inr hr))) h

