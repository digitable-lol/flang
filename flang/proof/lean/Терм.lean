/- Семейство Ч (задача 1130) -/

/-- Число членов выписанного списка. -/
def «членов» : «Члены» → Nat
  | .«нет» => 0
  | .«ещё» _ r => «членов» r + 1

theorem «членов-длина» : ∀ (d : «Члены») (w : «Мир»), («оценитьЧл» d w).length = «членов» d
  | .«нет», w => rfl
  | .«ещё» t r, w => by simp [«оценитьЧл», «членов», «членов-длина» r w]

/-- Точное число Ч5 (сверщик: `точный_текст`, ветвь «к строке»): целый литерал от 0
    до 2⁵³ либо длина выписанного списка. -/
def «точноеЧисло?» : «ТермЧ» → Option Int
  | .«лит» n => if 0 ≤ n ∧ n ≤ «порог» then some n else none
  | .«длина» .«пустой» => some 0
  | .«длина» (.«выписан» d) => some («членов» d)
  | _ => none

theorem «точноеЧисло?-значение» {t : «ТермЧ»} {n : Int} (h : «точноеЧисло?» t = some n) (w : «Мир») :
    «оценить» t w = «кон» n := by
  cases t <;> simp [«точноеЧисло?»] at h
  case «лит» m => obtain ⟨_, rfl⟩ := h; rfl
  case «длина» l =>
    cases l <;> simp [«точноеЧисло?»] at h
    · subst h; rfl
    · rename_i d; subst h; simp [«оценить», «оценитьС», «членов-длина»]

/-- Точный текст Ч5 (сверщик: `точный_текст`): литерал без кавычки и обратной черты
    внутри, склейка точных, «к строке» от точного числа. -/
def «точныйТекст?» : «ТермТ» → Option String
  | .«литТ» s => if s.any (fun c => c = '"' || c = '\\') then none else some s
  | .«склейка» l r =>
    match «точныйТекст?» l, «точныйТекст?» r with
    | some a, some b => some (a ++ b)
    | _, _ => none
  | .«кСтроке» t => (fun n => toString n) <$> «точноеЧисло?» t
  | _ => none

theorem «точныйТекст?-значение» : ∀ {t : «ТермТ»} {a : String}, «точныйТекст?» t = some a →
    ∀ w, «оценитьТ» t w = a.toList
  | .«литТ» s, a, h, w => by
      simp only [«точныйТекст?»] at h
      split at h
      · cases h
      · cases h; rfl
  | .«склейка» l r, a, h, w => by
      simp only [«точныйТекст?»] at h
      split at h
      · rename_i x y hx hy
        cases h
        simp only [«оценитьТ»]
        rw [«точныйТекст?-значение» hx w, «точныйТекст?-значение» hy w, String.toList_append]
      · cases h
  | .«кСтроке» t, a, h, w => by
      simp only [«точныйТекст?», Option.map_eq_map, Option.map_eq_some_iff] at h
      obtain ⟨n, hn, rfl⟩ := h
      simp only [«оценитьТ», «точноеЧисло?-значение» hn w, «числоТекстом»]
  | .«имяТ» _, a, h, w => by simp [«точныйТекст?»] at h
  | .«еслиТ» _ _ _, a, h, w => by simp [«точныйТекст?»] at h
  | .«вызовТ» _ _, a, h, w => by simp [«точныйТекст?»] at h

/-- Ч5: точные тексты, и начало сличено знак в знак. -/
theorem «Ч5-терм» (Γ : List («Факт» «Мир»)) (t p : «ТермТ») (a b : String)
    (ht : «точныйТекст?» t = some a) (hp : «точныйТекст?» p = some b)
    (h : b.toList.isPrefixOf a.toList = true) : «Выводится» Γ (.«начинается» t p) :=
  «подъём0» (fun w => by
    simp only [«Факт-из», «оценитьФ»]
    rw [«точныйТекст?-значение» ht w, «точныйТекст?-значение» hp w]
    exact «Ч5» _ _ h)

