theorem «Цел1-терм» (Γ : List («Факт» «Мир»)) (t m : «ТермЧ»)
    (hm : m = .«остаток» t (.«лит» 1) ∨ m = .«плюс» (.«остаток» t (.«лит» 1)) (.«лит» 0))
    (h : «Выводится» Γ (.«равен» m (.«лит» 0)) ∨ «Выводится» Γ (.«равен» (.«лит» 0) m)) :
    «Выводится» Γ (.«цел» t) := by
  have hm' : ∀ w, «оценить» m w = «остаток» («оценить» t w) («кон» 1) ∨
