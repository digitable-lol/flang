  | .«начинается» t p, x, s => .«начинается» («подстТ» t x s) («подстТ» p x s)
  | .«кон» t, x, s => .«кон» («подст» t x s)
  | .«цел» t, x, s => .«цел» («подст» t x s)
  | .«помещается» t, x, s => .«помещается» («подст» t x s)
  | .«всех» e l u, x, s => .«всех» e («подстС» l x s) («подстФ» u x s)
  | .«есть» m t u, x, s => .«есть» m («подст» t x s) («подстФ» u x s)
  | .«и» a b, x, s => .«и» («подстФ» a x s) («подстФ» b x s)
  | .«или» a b, x, s => .«или» («подстФ» a x s) («подстФ» b x s)
  | .«не» a, x, s => .«не» («подстФ» a x s)
  | .«еслиФ» u a b, x, s => .«еслиФ» («подстФ» u x s) («подстФ» a x s) («подстФ» b x s)
  | .«вызовФ» f d, x, s => .«вызовФ» («зовом» f x s) («подстД» d x s)
  | .«разборСм» c cs, x, s => .«разборСм» («подстСм» c x s) («подстСл» cs x s)
def «подстТело» : «Тело» → String → «Тело» → «Тело»
  | .«число» t, x, s => .«число» («подст» t x s)
  | .«список» l, x, s => .«список» («подстС» l x s)
  | .«текст» t, x, s => .«текст» («подстТ» t x s)
  | .«признак» u, x, s => .«признак» («подстФ» u x s)
  | .«сумма» c, x, s => .«сумма» («подстСм» c x s)
  | .«вызов» f d, x, s => .«вызов» («зовом» f x s) («подстД» d x s)
def «подстД» : «Доводы» → String → «Тело» → «Доводы»
  | .«нет», _, _ => .«нет»
  | .«ещё» t r, x, s => .«ещё» («подстТело» t x s) («подстД» r x s)
def «подстЧл» : «Члены» → String → «Тело» → «Члены»
  | .«нет», _, _ => .«нет»
  | .«ещё» t r, x, s => .«ещё» («подст» t x s) («подстЧл» r x s)
def «подстСм» : «ТермСм» → String → «Тело» → «ТермСм»
  | .«вариант» k fs, x, s => .«вариант» k («подстП» fs x s)
  | .«имяСм» y, x, s => if y = x then s.«суммой» else .«имяСм» y
  | .«вызовСм» f d, x, s => .«вызовСм» («зовом» f x s) («подстД» d x s)
def «подстП» : «Поля» → String → «Тело» → «Поля»
  | .«нет», _, _ => .«нет»
  | .«ещё» p t r, x, s => .«ещё» p («подстТело» t x s) («подстП» r x s)
/-- Подстановка в ветви — текстом, под именами ветви тоже (захват — условие леммы). -/
def «подстСл» : «Случаи» → String → «Тело» → «Случаи»
  | .«нет», _, _ => .«нет»
  | .«ещё» k bs u r, x, s => .«ещё» k bs («подстФ» u x s) («подстСл» r x s)
end

/-- Захвата нет: x не связано в терме, связанные имена терма не свободны в s, и
    если x стоит в терме на месте вызова (метка `«метка» x`), s — имя-значение
    либо ярлык (граница 10). `bs` — список связанных имён того терма, в который
    подставляют. -/
def «Чисто» (bs : List String) (x : String) (s : «Тело») : Prop :=
  x ∉ bs ∧ (∀ y ∈ bs, y ∉ «свободныеТело» s) ∧ («метка» x ∈ bs → «зовётся» s = true)

theorem «Чисто-подсписок» {bs bs' : List String} {x : String} {s : «Тело»}
    (h : ∀ y ∈ bs', y ∈ bs) (hc : «Чисто» bs x s) : «Чисто» bs' x s :=
  ⟨fun hx => hc.1 (h x hx), fun y hy => hc.2.1 y (h y hy), fun hm => hc.2.2 (h _ hm)⟩

/-- Разрешимая проверка захвата — то, что зовёт приёмка. -/
def «захват?» (bs : List String) (x : String) (s : «Тело») : Bool :=
  bs.contains x || bs.any (fun y => («свободныеТело» s).contains y) ||
  (bs.contains («метка» x) && !(«зовётся» s))

theorem «захват?-чисто» {bs : List String} {x : String} {s : «Тело»}
    (h : «захват?» bs x s = false) : «Чисто» bs x s := by
  simp only [«захват?», Bool.or_eq_false_iff, Bool.and_eq_false_iff, List.contains_eq_mem,
    decide_eq_false_iff_not, List.any_eq_false, Bool.not_eq_false'] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨h1, fun y hy hs => h2 y hy (by simpa using hs), fun hm => ?_⟩
  rcases h3 with h3 | h3
  · exact absurd hm h3
  · exact h3

/-! ## Согласие миров: значение зависит только от свободных имён -/

/-- Два мира согласны на именах: округление и стрелки одни, имена из списка
    носят одно и то же. -/
def «Согласны» (w w' : «Мир») (xs : List String) : Prop :=
  w.«о» = w'.«о» ∧ w.«функции» = w'.«функции» ∧ ∀ y ∈ xs, w.«имя» y = w'.«имя» y

theorem «Согласны-подсписок» {w w' : «Мир»} {xs ys : List String}
    (h : ∀ y ∈ ys, y ∈ xs) (hs : «Согласны» w w' xs) : «Согласны» w w' ys :=
  ⟨hs.1, hs.2.1, fun y hy => hs.2.2 y (h y hy)⟩

theorem «Согласны-связать» {w w' : «Мир»} {xs : List String} (e : String) (v : «Значение»)
    (hs : «Согласны» w w' («без» xs e)) :
    «Согласны» («связать» w e v) («связать» w' e v) xs := by
  refine ⟨hs.1, hs.2.1, fun y hy => ?_⟩
  by_cases hye : y = e
  · subst hye; simp
  · have := hs.2.2 y («в-без».mpr ⟨hy, hye⟩)
    simp [hye, this]

theorem «Согласны-обновить» {w w' : «Мир»} {xs : List String} (e : String) (v : «Знач»)
    (hs : «Согласны» w w' («без» xs e)) :
    «Согласны» («обновить» w e v) («обновить» w' e v) xs := «Согласны-связать» e _ hs

theorem «Согласны-обновитьС» {w w' : «Мир»} {xs : List String} (e : String) (l : «Список»)
    (hs : «Согласны» w w' («без» xs e)) :
    «Согласны» («обновитьС» w e l) («обновитьС» w' e l) xs := «Согласны-связать» e _ hs

/-- Связывание имени, которого нет в списке, согласия не портит. -/
theorem «Согласны-чужое'» {w : «Мир»} {xs : List String} (e : String) (v : «Значение»)
    (he : e ∉ xs) : «Согласны» w («связать» w e v) xs := by
  refine ⟨rfl, rfl, fun y hy => ?_⟩
  have : y ≠ e := fun h => he (h ▸ hy)
  simp [this]

theorem «Согласны-чужое» {w : «Мир»} {xs : List String} (e : String) (v : «Знач»)
    (he : e ∉ xs) : «Согласны» w («обновить» w e v) xs := «Согласны-чужое'» e _ he

theorem «Согласны-чужоеС» {w : «Мир»} {xs : List String} (e : String) (l : «Список»)
    (he : e ∉ xs) : «Согласны» w («обновитьС» w e l) xs := «Согласны-чужое'» e _ he

theorem «Согласны-симм» {w w' : «Мир»} {xs : List String} (h : «Согласны» w w' xs) :
    «Согласны» w' w xs :=
  ⟨h.1.symm, h.2.1.symm, fun y hy => (h.2.2 y hy).symm⟩

theorem «Согласны-перех» {w w' w'' : «Мир»} {xs : List String}
    (h : «Согласны» w w' xs) (h' : «Согласны» w' w'' xs) : «Согласны» w w'' xs :=
  ⟨h.1.trans h'.1, h.2.1.trans h'.2.1, fun y hy => (h.2.2 y hy).trans (h'.2.2 y hy)⟩

/-- Левая половина согласия на склейке списков. -/
theorem «Согласны-лево» {w w' : «Мир»} {xs ys : List String}
    (h : «Согласны» w w' (xs ++ ys)) : «Согласны» w w' xs :=
  «Согласны-подсписок» (fun y hy => List.mem_append_left _ hy) h
theorem «Согласны-право» {w w' : «Мир»} {xs ys : List String}
    (h : «Согласны» w w' (xs ++ ys)) : «Согласны» w w' ys :=
  «Согласны-подсписок» (fun y hy => List.mem_append_right _ hy) h

/-- Поля ветви на местах имён согласия не портят: имена ветви из списка вынуты. -/
theorem «Согласны-связатьПоля» {w w' : «Мир»} {xs : List String} (bs : List (String × String))
    (v : «Значение») (h : «Согласны» w w' («безВсех» xs (bs.map (·.2)))) :
    «Согласны» («связатьПоля» w bs v) («связатьПоля» w' bs v) xs := by
  induction bs generalizing xs with
  | nil =>
    exact «Согласны-подсписок» (fun y hy => «в-безВсех».mpr ⟨hy, by simp⟩) h
  | cons b bs ih =>
    simp only [«связатьПоля», List.foldr_cons] at ih ⊢
    apply «Согласны-связать»
    apply ih
    refine «Согласны-подсписок» (fun y hy => ?_) h
    obtain ⟨hy1, hy2⟩ := «в-безВсех».mp hy
    obtain ⟨hy3, hy4⟩ := «в-без».mp hy1
    refine «в-безВсех».mpr ⟨hy3, ?_⟩
    simp only [List.map_cons, List.mem_cons, not_or]
    exact ⟨hy4, hy2⟩

theorem «всеЭ-конгр» (p q : «Знач» → Bool) (l : «Список») (h : ∀ v, p v = q v) :
    «всеЭ» p l = «всеЭ» q l := by
  have : p = q := funext h
  rw [this]

theorem «отбор-конгр» (p q : «Знач» → Bool) (l : «Список») (h : ∀ v, p v = q v) :
    «отбор» p l = «отбор» q l := by
  have : p = q := funext h
  rw [this]

theorem «отобр-конгр» (f g : «Знач» → «Знач») (l : «Список») (h : ∀ v, f v = g v) :
    «отобр» f l = «отобр» g l := by
  have : f = g := funext h
  rw [this]

/-- Место вызова зовёт одну функцию в мирах, согласных на его имени-значении. -/
theorem «вызываемая-согласие» {w w' : «Мир»} {f : String} (h : «Согласны» w w' («зовимое» f)) :
    «вызываемая» w f = «вызываемая» w' f := by
  cases hg : «голое» f
  · exact «вызываемая-не-голое» w w' hg
  · rw [«вызываемая-голое» w hg, «вызываемая-голое» w' hg, h.2.2 f (by simp [«зовимое», hg])]

theorem «свёртка-конгр» (s s' : «Знач» → «Знач» → «Знач») (n : «Знач») (l : «Список»)
    (h : ∀ a v, s a v = s' a v) : «свёртка» s n l = «свёртка» s' n l := by
  have : s = s' := funext (fun a => funext (fun v => h a v))
  rw [this]

theorem «свёрткаС-конгр» (s s' : «Список» → «Знач» → «Список») (n : «Список») (l : «Список»)
    (h : ∀ a v, s a v = s' a v) : «свёрткаС» s n l = «свёрткаС» s' n l := by
  have : s = s' := funext (fun a => funext (fun v => h a v))
  rw [this]

theorem «разбор-конгр» {α : Type} (p : α) (z z' : «Знач» → «Список» → α) (l : «Список»)
    (h : ∀ a v, z a v = z' a v) : «разборСписка» p z l = «разборСписка» p z' l := by
  have : z = z' := funext (fun a => funext (fun v => h a v))
  rw [this]

mutual
/-- Значение терма одно во всех мирах, согласных на его свободных именах. -/
theorem «согласие» : ∀ (t : «ТермЧ») (w w' : «Мир»),
    «Согласны» w w' («свободные» t) → «оценить» t w = «оценить» t w'
  | .«лит» n, w, w', h => rfl
  | .«имя» x, w, w', h => by
      simp only [«оценить»]; rw [h.2.2 x (by simp [«свободные»])]
  | .«плюс» a b, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h), h.1]
  | .«минус» a b, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h), h.1]
  | .«умножить» a b, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h), h.1]
  | .«остаток» a b, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«если» u a b, w, w', h => by
      simp only [«оценить», «свободные», List.append_assoc] at *
      rw [«согласиеФ» u w w' («Согласны-лево» h),
          «согласие» a w w' («Согласны-лево» («Согласны-право» h)),
          «согласие» b w w' («Согласны-право» («Согласны-право» h))]
  | .«длина» l, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласиеС» l w w' h]
  | .«кодСимвола» t, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласиеТ» t w w' h]
  | .«свёртка» l n a e s, w, w', h => by
      simp only [«оценить», «свободные», List.append_assoc] at *
      rw [«согласиеС» l w w' («Согласны-лево» h),
          «согласие» n w w' («Согласны-лево» («Согласны-право» h))]
      apply «свёртка-конгр»
      intro acc v
      apply «согласие» s
      apply «Согласны-обновить»
      apply «Согласны-обновить»
      exact «Согласны-право» («Согласны-право» h)
  | .«разбор» l p g x z, w, w', h => by
      simp only [«оценить», «свободные», List.append_assoc] at *
      rw [«согласиеС» l w w' («Согласны-лево» h),
          «согласие» p w w' («Согласны-лево» («Согласны-право» h))]
      apply «разбор-конгр»
      intro hd tl
      apply «согласие» z
      apply «Согласны-обновить»
      apply «Согласны-обновитьС»
      exact «Согласны-право» («Согласны-право» h)
  | .«вызов» f d, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласиеД» d w w' («Согласны-право» h), h.2.1, «вызываемая-согласие» («Согласны-лево» h)]
  | .«поле» c p, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласиеСм» c w w' h]
  | .«ярлык» f, w, w', h => rfl
theorem «согласиеС» : ∀ (l : «ТермС») (w w' : «Мир»),
    «Согласны» w w' («свободныеС» l) → «оценитьС» l w = «оценитьС» l w'
  | .«пустой», w, w', h => rfl
  | .«имяС» x, w, w', h => by
      simp only [«оценитьС»]; rw [h.2.2 x (by simp [«свободныеС»])]
  | .«выписан» d, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласиеЧл» d w w' h]
  | .«приписать» e l, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласие» e w w' («Согласны-лево» h), «согласиеС» l w w' («Согласны-право» h)]
  | .«добавить» e l, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласие» e w w' («Согласны-лево» h), «согласиеС» l w w' («Согласны-право» h)]
  | .«отбор» l x u, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласиеС» l w w' («Согласны-лево» h)]
      apply «отбор-конгр»
      intro v
      apply «согласиеФ» u
      apply «Согласны-обновить»
      exact «Согласны-право» h
  | .«еслиС» u a b, w, w', h => by
      simp only [«оценитьС», «свободныеС», List.append_assoc] at *
      rw [«согласиеФ» u w w' («Согласны-лево» h),
          «согласиеС» a w w' («Согласны-лево» («Согласны-право» h)),
          «согласиеС» b w w' («Согласны-право» («Согласны-право» h))]
  | .«свёрткаС» l n a e s, w, w', h => by
      simp only [«оценитьС», «свободныеС», List.append_assoc] at *
      rw [«согласиеС» l w w' («Согласны-лево» h),
          «согласиеС» n w w' («Согласны-лево» («Согласны-право» h))]
      apply «свёрткаС-конгр»
      intro acc v
      apply «согласиеС» s
      apply «Согласны-обновить»
      apply «Согласны-обновитьС»
      exact «Согласны-право» («Согласны-право» h)
  | .«отобразить» l x f, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласиеС» l w w' («Согласны-лево» h)]
      apply «отобр-конгр»
      intro v
      apply «согласие» f
      apply «Согласны-обновить»
      exact «Согласны-право» h
  | .«вызовС» f d, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласиеД» d w w' («Согласны-право» h), h.2.1, «вызываемая-согласие» («Согласны-лево» h)]
theorem «согласиеТ» : ∀ (t : «ТермТ») (w w' : «Мир»),
    «Согласны» w w' («свободныеТ» t) → «оценитьТ» t w = «оценитьТ» t w'
  | .«литТ» s, w, w', h => rfl
  | .«имяТ» x, w, w', h => by
      simp only [«оценитьТ»]; rw [h.2.2 x (by simp [«свободныеТ»])]
  | .«склейка» l r, w, w', h => by
      simp only [«оценитьТ», «свободныеТ»] at *
      rw [«согласиеТ» l w w' («Согласны-лево» h), «согласиеТ» r w w' («Согласны-право» h)]
  | .«еслиТ» u a b, w, w', h => by
      simp only [«оценитьТ», «свободныеТ», List.append_assoc] at *
      rw [«согласиеФ» u w w' («Согласны-лево» h),
          «согласиеТ» a w w' («Согласны-лево» («Согласны-право» h)),
          «согласиеТ» b w w' («Согласны-право» («Согласны-право» h))]
  | .«кСтроке» t, w, w', h => by
      simp only [«оценитьТ», «свободныеТ»] at *
      rw [«согласие» t w w' h]
  | .«вызовТ» f d, w, w', h => by
      simp only [«оценитьТ», «свободныеТ»] at *
      rw [«согласиеД» d w w' («Согласны-право» h), h.2.1, «вызываемая-согласие» («Согласны-лево» h)]
theorem «согласиеФ» : ∀ (f : «Форм») (w w' : «Мир»),
    «Согласны» w w' («свободныеФ» f) → «оценитьФ» f w = «оценитьФ» f w'
  | .«да», w, w', h => rfl
  | .«нет», w, w', h => rfl
  | .«имяФ» x, w, w', h => by
      simp only [«оценитьФ»]; rw [h.2.2 x (by simp [«свободныеФ»])]
  | .«неБольше» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«неМеньше» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«меньше» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«больше» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«равен» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«равенС» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеС» a w w' («Согласны-лево» h), «согласиеС» b w w' («Согласны-право» h)]
  | .«равенТ» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеТ» a w w' («Согласны-лево» h), «согласиеТ» b w w' («Согласны-право» h)]
  | .«содержит» l e, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеС» l w w' («Согласны-лево» h), «согласие» e w w' («Согласны-право» h)]
  | .«неУбывает» l, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеС» l w w' h]
  | .«пусто» l, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеС» l w w' h]
  | .«пустоТ» t, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеТ» t w w' h]
  | .«начинается» t p, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеТ» t w w' («Согласны-лево» h), «согласиеТ» p w w' («Согласны-право» h)]
  | .«кон» t, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» t w w' h]
  | .«цел» t, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» t w w' h]
  | .«помещается» t, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» t w w' h]
  | .«всех» e l u, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеС» l w w' («Согласны-лево» h)]
      apply «всеЭ-конгр»
      intro v
      apply «согласиеФ» u
      apply «Согласны-обновить»
      exact «Согласны-право» h
  | .«есть» m t u, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» t w w' («Согласны-лево» h)]
      apply «согласиеФ» u
      apply «Согласны-обновить»
      exact «Согласны-право» h
  | .«и» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеФ» a w w' («Согласны-лево» h), «согласиеФ» b w w' («Согласны-право» h)]
  | .«или» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеФ» a w w' («Согласны-лево» h), «согласиеФ» b w w' («Согласны-право» h)]
  | .«не» a, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеФ» a w w' h]
  | .«еслиФ» u a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ», List.append_assoc] at *
      rw [«согласиеФ» u w w' («Согласны-лево» h),
          «согласиеФ» a w w' («Согласны-лево» («Согласны-право» h)),
          «согласиеФ» b w w' («Согласны-право» («Согласны-право» h))]
  | .«вызовФ» f d, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеД» d w w' («Согласны-право» h), h.2.1, «вызываемая-согласие» («Согласны-лево» h)]
  | .«разборСм» c cs, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеСм» c w w' («Согласны-лево» h)]
      exact «согласиеСл» cs _ w w' («Согласны-право» h)
theorem «согласиеТело» : ∀ (b : «Тело») (w w' : «Мир»),
    «Согласны» w w' («свободныеТело» b) → «значение» b w = «значение» b w'
  | .«число» t, w, w', h => by
      simp only [«значение», «свободныеТело»] at *; rw [«согласие» t w w' h]
  | .«список» l, w, w', h => by
      simp only [«значение», «свободныеТело»] at *; rw [«согласиеС» l w w' h]
  | .«текст» t, w, w', h => by
      simp only [«значение», «свободныеТело»] at *; rw [«согласиеТ» t w w' h]
  | .«признак» u, w, w', h => by
      simp only [«значение», «свободныеТело»] at *; rw [«согласиеФ» u w w' h]
  | .«сумма» c, w, w', h => by
      simp only [«значение», «свободныеТело»] at *; rw [«согласиеСм» c w w' h]
  | .«вызов» f d, w, w', h => by
      simp only [«значение», «свободныеТело»] at *; rw [«согласиеД» d w w' («Согласны-право» h), h.2.1, «вызываемая-согласие» («Согласны-лево» h)]
theorem «согласиеД» : ∀ (d : «Доводы») (w w' : «Мир»),
    «Согласны» w w' («свободныеД» d) → «оценитьД» d w = «оценитьД» d w'
  | .«нет», w, w', h => rfl
  | .«ещё» t r, w, w', h => by
      simp only [«оценитьД», «свободныеД»] at *
      rw [«согласиеТело» t w w' («Согласны-лево» h), «согласиеД» r w w' («Согласны-право» h)]
theorem «согласиеЧл» : ∀ (d : «Члены») (w w' : «Мир»),
    «Согласны» w w' («свободныеЧл» d) → «оценитьЧл» d w = «оценитьЧл» d w'
  | .«нет», w, w', h => rfl
  | .«ещё» t r, w, w', h => by
      simp only [«оценитьЧл», «свободныеЧл»] at *
      rw [«согласие» t w w' («Согласны-лево» h), «согласиеЧл» r w w' («Согласны-право» h)]
theorem «согласиеСм» : ∀ (c : «ТермСм») (w w' : «Мир»),
    «Согласны» w w' («свободныеСм» c) → «оценитьСм» c w = «оценитьСм» c w'
  | .«вариант» k fs, w, w', h => by
      simp only [«оценитьСм», «свободныеСм»] at *
      rw [«согласиеП» fs w w' h]
  | .«имяСм» x, w, w', h => by
      simp only [«оценитьСм»]; rw [h.2.2 x (by simp [«свободныеСм»])]
  | .«вызовСм» f d, w, w', h => by
      simp only [«оценитьСм», «свободныеСм»] at *
      rw [«согласиеД» d w w' («Согласны-право» h), h.2.1, «вызываемая-согласие» («Согласны-лево» h)]
theorem «согласиеП» : ∀ (fs : «Поля») (w w' : «Мир»),
    «Согласны» w w' («свободныеП» fs) → «оценитьП» fs w = «оценитьП» fs w'
  | .«нет», w, w', h => rfl
  | .«ещё» p t r, w, w', h => by
      simp only [«оценитьП», «свободныеП»] at *
      rw [«согласиеТело» t w w' («Согласны-лево» h), «согласиеП» r w w' («Согласны-право» h)]
theorem «согласиеСл» : ∀ (cs : «Случаи») (v : «Значение») (w w' : «Мир»),
    «Согласны» w w' («свободныеСл» cs) → «оценитьСл» cs v w = «оценитьСл» cs v w'
  | .«нет», v, w, w', h => rfl
  | .«ещё» k bs u r, v, w, w', h => by
      simp only [«оценитьСл», «свободныеСл»] at *
      by_cases hk : «вариантЗнач» v = some k
      · simp only [hk, ↓reduceIte]
        exact «согласиеФ» u _ _ («Согласны-связатьПоля» bs v («Согласны-лево» h))
      · simp only [hk, ↓reduceIte]
        exact «согласиеСл» r v w w' («Согласны-право» h)
end

/-- Обновление имени, не свободного в терме, значения не меняет. -/
theorem «чужое-имя» (t : «ТермЧ») (w : «Мир») (e : String) (v : «Знач»)
    (he : e ∉ «свободные» t) : «оценить» t («обновить» w e v) = «оценить» t w :=
  («согласие» t w _ («Согласны-чужое» e v he)).symm

theorem «чужое-имяФ» (f : «Форм») (w : «Мир») (e : String) (v : «Знач»)
    (he : e ∉ «свободныеФ» f) : «оценитьФ» f («обновить» w e v) = «оценитьФ» f w :=
  («согласиеФ» f w _ («Согласны-чужое» e v he)).symm

theorem «чужое-имяС» (t : «ТермЧ») (w : «Мир») (e : String) (l : «Список»)
    (he : e ∉ «свободные» t) : «оценить» t («обновитьС» w e l) = «оценить» t w :=
  («согласие» t w _ («Согласны-чужоеС» e l he)).symm

theorem «чужое-имяТело» (b : «Тело») (w : «Мир») (e : String) (v : «Значение»)
    (he : e ∉ «свободныеТело» b) : «значение» b («связать» w e v) = «значение» b w :=
  («согласиеТело» b w _ («Согласны-чужое'» e v he)).symm

/-! ## Подстановка сохраняет смысл — без захвата -/

/-- Мир, в котором x носит значение s. -/
abbrev «мир-с» (w : «Мир») (x : String) (s : «Тело») : «Мир» :=
  «связать» w x («значение» s w)

/-- Под связывателем e (e ≠ x, e не свободно в s) мир «с подстановкой» и мир
    «со связыванием» меняются местами. -/
theorem «мир-с-под-связывателем» (w : «Мир») (x e : String) (s : «Тело») (v : «Значение»)
    (hx : e ≠ x) (hs : e ∉ «свободныеТело» s) :
    «мир-с» («связать» w e v) x s = «связать» («мир-с» w x s) e v := by
  simp only [«мир-с»]
  rw [«чужое-имяТело» s w e v hs, «связать-связать» w e x v _ (Ne.symm hx)]

theorem «Чисто-хвост» {y : String} {bs : List String} {x : String} {s : «Тело»}
    (h : «Чисто» (y :: bs) x s) : «Чисто» bs x s :=
  «Чисто-подсписок» (fun z hz => List.mem_cons_of_mem _ hz) h
theorem «Чисто-голова» {y : String} {bs : List String} {x : String} {s : «Тело»}
    (h : «Чисто» (y :: bs) x s) : y ≠ x ∧ y ∉ «свободныеТело» s :=
  ⟨fun hyx => h.1 (hyx ▸ List.mem_cons_self), h.2.1 y List.mem_cons_self⟩
theorem «Чисто-лево» {as bs : List String} {x : String} {s : «Тело»}
    (h : «Чисто» (as ++ bs) x s) : «Чисто» as x s :=
  «Чисто-подсписок» (fun z hz => List.mem_append_left _ hz) h
theorem «Чисто-право» {as bs : List String} {x : String} {s : «Тело»}
    (h : «Чисто» (as ++ bs) x s) : «Чисто» bs x s :=
  «Чисто-подсписок» (fun z hz => List.mem_append_right _ hz) h

/-- Под именами ветви (ни одно не x и не свободно в s) мир «с подстановкой» и
    мир «с полями на местах имён» меняются местами. -/
theorem «мир-с-под-полями» (w : «Мир») (x : String) (s : «Тело») (bs : List (String × String))
    (v : «Значение») (h : «Чисто» (bs.map (·.2)) x s) :
    «мир-с» («связатьПоля» w bs v) x s = «связатьПоля» («мир-с» w x s) bs v := by
  induction bs with
  | nil => rfl
  | cons b bs ih =>
    simp only [List.map_cons] at h
    have hb := «Чисто-голова» h
    simp only [«связатьПоля», List.foldr_cons] at ih ⊢
    rw [«мир-с-под-связывателем» _ x b.2 s _ hb.1 hb.2, ih («Чисто-хвост» h)]

/-- Тело, прочитанное своим сортом, — то, что читает мир. -/
theorem «числом-верно» (s : «Тело») (w : «Мир») : «оценить» s.«числом» w = «какЧисло» («значение» s w) := by
  cases s
  case «сумма» c =>
    simp only [«Тело».«числом», «значение», «какЧисло-оценитьСм»]
    simp [«нечисло», «оценить», «остаток»]
  all_goals simp [«Тело».«числом», «значение», «нечисло», «оценить», «остаток», «какЧисло»]
theorem «списком-верно» (s : «Тело») (w : «Мир») : «оценитьС» s.«списком» w = «какСписок» («значение» s w) := by
  cases s
  case «сумма» c => simp only [«Тело».«списком», «значение», «какСписок-оценитьСм», «оценитьС»]
  all_goals simp [«Тело».«списком», «значение», «оценитьС», «какСписок»]
theorem «текстом-верно» (s : «Тело») (w : «Мир») : «оценитьТ» s.«текстом» w = «какТекст» («значение» s w) := by
  cases s
  case «сумма» c => simp [«Тело».«текстом», «значение», «какТекст-оценитьСм», «оценитьТ»]
  all_goals simp [«Тело».«текстом», «значение», «оценитьТ», «какТекст»]
theorem «признаком-верно» (s : «Тело») (w : «Мир») : «оценитьФ» s.«признаком» w = «какПризнак» («значение» s w) := by
  cases s
  case «сумма» c => simp only [«Тело».«признаком», «значение», «какПризнак-оценитьСм», «оценитьФ»]
  all_goals simp [«Тело».«признаком», «значение», «оценитьФ», «какПризнак»]
theorem «суммой-верно» (s : «Тело») (w : «Мир») : «оценитьСм» s.«суммой» w = «какСумма» («значение» s w) := by
  cases s
  case «сумма» c => simp only [«Тело».«суммой», «значение», «какСумма-оценитьСм»]
  all_goals simp [«Тело».«суммой», «значение», «оценитьСм», «оценитьП», «какСумма»]

/-- Место вызова после подстановки зовёт ту функцию, которую место зовёт в мире,
    где x носит значение s: имя встаёт именем, ярлык — ярлыком (граница 10). -/
theorem «вызываемая-подст» (f x : String) (s : «Тело») (w : «Мир»)
    (h : «Чисто» («меткаЗова» f) x s) :
    «вызываемая» w («зовом» f x s) = «вызываемая» («мир-с» w x s) f := by
  cases hg : «голое» f
  · have e : «зовом» f x s = f := by simp [«зовом», hg]
    rw [e]; exact «вызываемая-не-голое» _ _ hg
  · by_cases hfx : f = x
    · subst hfx
      have hz : «зовётся» s = true := h.2.2 (by simp [«меткаЗова», hg])
      rw [«вызываемая-голое» _ hg]
      have e2 : («мир-с» w f s).«имя» f = «значение» s w := by simp [«мир-с»]
      rw [e2]
      rcases s with t | l | t | u | c | ⟨g, d⟩
      · cases t <;> simp only [«зовётся», Bool.false_eq_true] at hz
        · rename_i y
          have e3 : «зовом» f f (.«число» (.«имя» y)) = y := by simp [«зовом», hg]
          rw [e3, «вызываемая-голое» w hz]
          simp [«значение», «оценить»]
        · rename_i g
          have e3 : «зовом» f f (.«число» (.«ярлык» g)) = "функция " ++ g := by simp [«зовом», hg]
          rw [e3]
          simp [«вызываемая», «ярлыкЗова?-свой», «значение», «оценить», «декод-код»]
      all_goals simp only [«зовётся», Bool.false_eq_true] at hz
    · have e : «зовом» f x s = f := by simp [«зовом», hfx]
      rw [e, «вызываемая-голое» _ hg, «вызываемая-голое» _ hg]
      simp [«мир-с», hfx]

mutual
/-- Значение подстановки — значение терма в мире, где x носит значение s. -/
theorem «подстановка» : ∀ (t : «ТермЧ») (x : String) (s : «Тело») (w : «Мир»),
    «Чисто» («связанные» t) x s → «оценить» («подст» t x s) w = «оценить» t («мир-с» w x s)
  | .«лит» n, x, s, w, h => by simp [«подст», «оценить»]
  | .«имя» y, x, s, w, h => by
      by_cases hy : y = x
      · subst hy; simp [«подст», «оценить», «мир-с», «числом-верно»]
      · simp [«подст», «оценить», «мир-с», hy]
