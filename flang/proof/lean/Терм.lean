/-- Захвата нет: x не связано в терме, и связанные имена терма не свободны в s.
    `bs` — список связанных имён того терма, в который подставляют. -/
def «Чисто» (bs : List String) (x : String) (s : «ТермЧ») : Prop :=
  x ∉ bs ∧ ∀ y ∈ bs, y ∉ «свободные» s

theorem «Чисто-подсписок» {bs bs' : List String} {x : String} {s : «ТермЧ»}
    (h : ∀ y ∈ bs', y ∈ bs) (hc : «Чисто» bs x s) : «Чисто» bs' x s :=
  ⟨fun hx => hc.1 (h x hx), fun y hy => hc.2 y (h y hy)⟩

/-- Разрешимая проверка захвата — то, что зовёт приёмка. -/
def «захват?» (bs : List String) (x : String) (s : «ТермЧ») : Bool :=
  bs.contains x || bs.any (fun y => («свободные» s).contains y)

theorem «захват?-чисто» {bs : List String} {x : String} {s : «ТермЧ»}
    (h : «захват?» bs x s = false) : «Чисто» bs x s := by
  simp [«захват?», List.any_eq_true] at h
  exact ⟨h.1, fun y hy hs => h.2 y hy hs⟩

/-! ## Согласие миров: значение зависит только от свободных имён -/

/-- Два мира согласны на именах: округление и стрелки одни, имена из списка
    носят одно и то же. -/
def «Согласны» (w w' : «Мир») (xs : List String) : Prop :=
  w.«о» = w'.«о» ∧ w.«функции» = w'.«функции» ∧ ∀ y ∈ xs, w.«имя» y = w'.«имя» y

theorem «Согласны-подсписок» {w w' : «Мир»} {xs ys : List String}
    (h : ∀ y ∈ ys, y ∈ xs) (hs : «Согласны» w w' xs) : «Согласны» w w' ys :=
  ⟨hs.1, hs.2.1, fun y hy => hs.2.2 y (h y hy)⟩

theorem «Согласны-связать» {w w' : «Мир»} {xs : List String} (e : String) (v : «Значение»)
    (hs : «Согласны» w w' («без» xs e)) :
    «Согласны» («связать» w e v) («связать» w' e v) xs := by
  refine ⟨hs.1, hs.2.1, fun y hy => ?_⟩
  by_cases hye : y = e
  · subst hye; simp
  · have := hs.2.2 y («в-без».mpr ⟨hy, hye⟩)
    simp [hye, this]

theorem «Согласны-обновить» {w w' : «Мир»} {xs : List String} (e : String) (v : «Знач»)
    (hs : «Согласны» w w' («без» xs e)) :
    «Согласны» («обновить» w e v) («обновить» w' e v) xs := «Согласны-связать» e _ hs

theorem «Согласны-обновитьС» {w w' : «Мир»} {xs : List String} (e : String) (l : «Список»)
    (hs : «Согласны» w w' («без» xs e)) :
    «Согласны» («обновитьС» w e l) («обновитьС» w' e l) xs := «Согласны-связать» e _ hs

/-- Связывание имени, которого нет в списке, согласия не портит. -/
theorem «Согласны-чужое'» {w : «Мир»} {xs : List String} (e : String) (v : «Значение»)
    (he : e ∉ xs) : «Согласны» w («связать» w e v) xs := by
  refine ⟨rfl, rfl, fun y hy => ?_⟩
  have : y ≠ e := fun h => he (h ▸ hy)
  simp [this]

theorem «Согласны-чужое» {w : «Мир»} {xs : List String} (e : String) (v : «Знач»)
    (he : e ∉ xs) : «Согласны» w («обновить» w e v) xs := «Согласны-чужое'» e _ he

theorem «Согласны-чужоеС» {w : «Мир»} {xs : List String} (e : String) (l : «Список»)
    (he : e ∉ xs) : «Согласны» w («обновитьС» w e l) xs := «Согласны-чужое'» e _ he

theorem «Согласны-симм» {w w' : «Мир»} {xs : List String} (h : «Согласны» w w' xs) :
    «Согласны» w' w xs :=
  ⟨h.1.symm, h.2.1.symm, fun y hy => (h.2.2 y hy).symm⟩

theorem «Согласны-перех» {w w' w'' : «Мир»} {xs : List String}
    (h : «Согласны» w w' xs) (h' : «Согласны» w' w'' xs) : «Согласны» w w'' xs :=
  ⟨h.1.trans h'.1, h.2.1.trans h'.2.1, fun y hy => (h.2.2 y hy).trans (h'.2.2 y hy)⟩

/-- Левая половина согласия на склейке списков. -/
theorem «Согласны-лево» {w w' : «Мир»} {xs ys : List String}
    (h : «Согласны» w w' (xs ++ ys)) : «Согласны» w w' xs :=
  «Согласны-подсписок» (fun y hy => List.mem_append_left _ hy) h
theorem «Согласны-право» {w w' : «Мир»} {xs ys : List String}
    (h : «Согласны» w w' (xs ++ ys)) : «Согласны» w w' ys :=
  «Согласны-подсписок» (fun y hy => List.mem_append_right _ hy) h

theorem «всеЭ-конгр» (p q : «Знач» → Bool) (l : «Список») (h : ∀ v, p v = q v) :
    «всеЭ» p l = «всеЭ» q l := by
  have : p = q := funext h
  rw [this]

theorem «отбор-конгр» (p q : «Знач» → Bool) (l : «Список») (h : ∀ v, p v = q v) :
    «отбор» p l = «отбор» q l := by
  have : p = q := funext h
  rw [this]

theorem «свёртка-конгр» (s s' : «Знач» → «Знач» → «Знач») (n : «Знач») (l : «Список»)
    (h : ∀ a v, s a v = s' a v) : «свёртка» s n l = «свёртка» s' n l := by
  have : s = s' := funext (fun a => funext (fun v => h a v))
  rw [this]

theorem «разбор-конгр» {α : Type} (p : α) (z z' : «Знач» → «Список» → α) (l : «Список»)
    (h : ∀ a v, z a v = z' a v) : «разборСписка» p z l = «разборСписка» p z' l := by
  have : z = z' := funext (fun a => funext (fun v => h a v))
  rw [this]

mutual
/-- Значение терма одно во всех мирах, согласных на его свободных именах. -/
theorem «согласие» : ∀ (t : «ТермЧ») (w w' : «Мир»),
    «Согласны» w w' («свободные» t) → «оценить» t w = «оценить» t w'
  | .«лит» n, w, w', h => rfl
  | .«имя» x, w, w', h => by
      simp only [«оценить»]; rw [h.2.2 x (by simp [«свободные»])]
  | .«плюс» a b, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h), h.1]
  | .«минус» a b, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h), h.1]
  | .«умножить» a b, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h), h.1]
  | .«остаток» a b, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«если» u a b, w, w', h => by
      simp only [«оценить», «свободные», List.append_assoc] at *
      rw [«согласиеФ» u w w' («Согласны-лево» h),
          «согласие» a w w' («Согласны-лево» («Согласны-право» h)),
          «согласие» b w w' («Согласны-право» («Согласны-право» h))]
  | .«длина» l, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласиеС» l w w' h]
  | .«кодСимвола» t, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласиеТ» t w w' h]
  | .«свёртка» l n a e s, w, w', h => by
      simp only [«оценить», «свободные», List.append_assoc] at *
      rw [«согласиеС» l w w' («Согласны-лево» h),
          «согласие» n w w' («Согласны-лево» («Согласны-право» h))]
      apply «свёртка-конгр»
      intro acc v
      apply «согласие» s
      apply «Согласны-обновить»
      apply «Согласны-обновить»
      exact «Согласны-право» («Согласны-право» h)
  | .«разбор» l p g x z, w, w', h => by
      simp only [«оценить», «свободные», List.append_assoc] at *
      rw [«согласиеС» l w w' («Согласны-лево» h),
          «согласие» p w w' («Согласны-лево» («Согласны-право» h))]
      apply «разбор-конгр»
      intro hd tl
      apply «согласие» z
      apply «Согласны-обновить»
      apply «Согласны-обновитьС»
      exact «Согласны-право» («Согласны-право» h)
  | .«вызов» f d, w, w', h => by
      simp only [«оценить», «свободные»] at *
      rw [«согласиеД» d w w' h, h.2.1]
theorem «согласиеС» : ∀ (l : «ТермС») (w w' : «Мир»),
    «Согласны» w w' («свободныеС» l) → «оценитьС» l w = «оценитьС» l w'
  | .«пустой», w, w', h => rfl
  | .«имяС» x, w, w', h => by
      simp only [«оценитьС»]; rw [h.2.2 x (by simp [«свободныеС»])]
  | .«выписан» d, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласиеД» d w w' h]
  | .«приписать» e l, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласие» e w w' («Согласны-лево» h), «согласиеС» l w w' («Согласны-право» h)]
  | .«добавить» e l, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласие» e w w' («Согласны-лево» h), «согласиеС» l w w' («Согласны-право» h)]
  | .«отбор» l x u, w, w', h => by
      simp only [«оценитьС», «свободныеС»] at *
      rw [«согласиеС» l w w' («Согласны-лево» h)]
      apply «отбор-конгр»
      intro v
      apply «согласиеФ» u
      apply «Согласны-обновить»
      exact «Согласны-право» h
  | .«еслиС» u a b, w, w', h => by
      simp only [«оценитьС», «свободныеС», List.append_assoc] at *
      rw [«согласиеФ» u w w' («Согласны-лево» h),
          «согласиеС» a w w' («Согласны-лево» («Согласны-право» h)),
          «согласиеС» b w w' («Согласны-право» («Согласны-право» h))]
theorem «согласиеТ» : ∀ (t : «ТермТ») (w w' : «Мир»),
    «Согласны» w w' («свободныеТ» t) → «оценитьТ» t w = «оценитьТ» t w'
  | .«литТ» s, w, w', h => rfl
  | .«имяТ» x, w, w', h => by
      simp only [«оценитьТ»]; rw [h.2.2 x (by simp [«свободныеТ»])]
  | .«склейка» l r, w, w', h => by
      simp only [«оценитьТ», «свободныеТ»] at *
      rw [«согласиеТ» l w w' («Согласны-лево» h), «согласиеТ» r w w' («Согласны-право» h)]
  | .«еслиТ» u a b, w, w', h => by
      simp only [«оценитьТ», «свободныеТ», List.append_assoc] at *
      rw [«согласиеФ» u w w' («Согласны-лево» h),
          «согласиеТ» a w w' («Согласны-лево» («Согласны-право» h)),
          «согласиеТ» b w w' («Согласны-право» («Согласны-право» h))]
theorem «согласиеФ» : ∀ (f : «Форм») (w w' : «Мир»),
    «Согласны» w w' («свободныеФ» f) → «оценитьФ» f w = «оценитьФ» f w'
  | .«да», w, w', h => rfl
  | .«нет», w, w', h => rfl
  | .«неБольше» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«неМеньше» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«меньше» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«больше» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«равен» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» a w w' («Согласны-лево» h), «согласие» b w w' («Согласны-право» h)]
  | .«содержит» l e, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеС» l w w' («Согласны-лево» h), «согласие» e w w' («Согласны-право» h)]
  | .«неУбывает» l, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеС» l w w' h]
  | .«пусто» l, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеС» l w w' h]
  | .«начинается» t p, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеТ» t w w' («Согласны-лево» h), «согласиеТ» p w w' («Согласны-право» h)]
  | .«кон» t, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» t w w' h]
  | .«цел» t, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» t w w' h]
  | .«помещается» t, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» t w w' h]
  | .«всех» e l u, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеС» l w w' («Согласны-лево» h)]
      apply «всеЭ-конгр»
      intro v
      apply «согласиеФ» u
      apply «Согласны-обновить»
      exact «Согласны-право» h
  | .«есть» m t u, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласие» t w w' («Согласны-лево» h)]
      apply «согласиеФ» u
      apply «Согласны-обновить»
      exact «Согласны-право» h
  | .«и» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеФ» a w w' («Согласны-лево» h), «согласиеФ» b w w' («Согласны-право» h)]
  | .«или» a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеФ» a w w' («Согласны-лево» h), «согласиеФ» b w w' («Согласны-право» h)]
  | .«не» a, w, w', h => by
      simp only [«оценитьФ», «свободныеФ»] at *
      rw [«согласиеФ» a w w' h]
  | .«еслиФ» u a b, w, w', h => by
      simp only [«оценитьФ», «свободныеФ», List.append_assoc] at *
      rw [«согласиеФ» u w w' («Согласны-лево» h),
          «согласиеФ» a w w' («Согласны-лево» («Согласны-право» h)),
          «согласиеФ» b w w' («Согласны-право» («Согласны-право» h))]
theorem «согласиеД» : ∀ (d : «Доводы») (w w' : «Мир»),
    «Согласны» w w' («свободныеД» d) → «оценитьД» d w = «оценитьД» d w'
  | .«нет», w, w', h => rfl
  | .«ещё» t r, w, w', h => by
      simp only [«оценитьД», «свободныеД»] at *
      rw [«согласие» t w w' («Согласны-лево» h), «согласиеД» r w w' («Согласны-право» h)]
end

/-- Обновление имени, не свободного в терме, значения не меняет. -/
theorem «чужое-имя» (t : «ТермЧ») (w : «Мир») (e : String) (v : «Знач»)
    (he : e ∉ «свободные» t) : «оценить» t («обновить» w e v) = «оценить» t w :=
  («согласие» t w _ («Согласны-чужое» e v he)).symm

theorem «чужое-имяФ» (f : «Форм») (w : «Мир») (e : String) (v : «Знач»)
    (he : e ∉ «свободныеФ» f) : «оценитьФ» f («обновить» w e v) = «оценитьФ» f w :=
  («согласиеФ» f w _ («Согласны-чужое» e v he)).symm

theorem «чужое-имяС» (t : «ТермЧ») (w : «Мир») (e : String) (l : «Список»)
    (he : e ∉ «свободные» t) : «оценить» t («обновитьС» w e l) = «оценить» t w :=
  («согласие» t w _ («Согласны-чужоеС» e l he)).symm

/-! ## Подстановка сохраняет смысл — без захвата -/

/-- Мир, в котором x носит значение s. -/
abbrev «мир-с» (w : «Мир») (x : String) (s : «ТермЧ») : «Мир» :=
  «обновить» w x («оценить» s w)

/-- Под связывателем e (e ≠ x, e не свободно в s) мир «с подстановкой» и мир
    «с обновлением» меняются местами. -/
theorem «мир-с-под-связывателем» (w : «Мир») (x e : String) (s : «ТермЧ») (v : «Знач»)
    (hx : e ≠ x) (hs : e ∉ «свободные» s) :
    «мир-с» («обновить» w e v) x s = «обновить» («мир-с» w x s) e v := by
  simp only [«мир-с»]
  rw [«чужое-имя» s w e v hs, «обновить-обновить» w x e _ v hx]

theorem «мир-с-под-связывателемС» (w : «Мир») (x e : String) (s : «ТермЧ») (l : «Список»)
    (hx : e ≠ x) (hs : e ∉ «свободные» s) :
    «мир-с» («обновитьС» w e l) x s = «обновитьС» («мир-с» w x s) e l := by
  simp only [«мир-с»]
  rw [«чужое-имяС» s w e l hs, «обновить-обновитьС» _ _ _ _ _ (Ne.symm hx)]

theorem «Чисто-хвост» {y : String} {bs : List String} {x : String} {s : «ТермЧ»}
    (h : «Чисто» (y :: bs) x s) : «Чисто» bs x s :=
  «Чисто-подсписок» (fun z hz => List.mem_cons_of_mem _ hz) h
theorem «Чисто-голова» {y : String} {bs : List String} {x : String} {s : «ТермЧ»}
    (h : «Чисто» (y :: bs) x s) : y ≠ x ∧ y ∉ «свободные» s :=
  ⟨fun hyx => h.1 (hyx ▸ List.mem_cons_self), h.2 y List.mem_cons_self⟩
theorem «Чисто-лево» {as bs : List String} {x : String} {s : «ТермЧ»}
    (h : «Чисто» (as ++ bs) x s) : «Чисто» as x s :=
  «Чисто-подсписок» (fun z hz => List.mem_append_left _ hz) h
theorem «Чисто-право» {as bs : List String} {x : String} {s : «ТермЧ»}
    (h : «Чисто» (as ++ bs) x s) : «Чисто» bs x s :=
  «Чисто-подсписок» (fun z hz => List.mem_append_right _ hz) h

mutual
/-- Значение подстановки — значение терма в мире, где x носит значение s. -/
theorem «подстановка» : ∀ (t : «ТермЧ») (x : String) (s : «ТермЧ») (w : «Мир»),
    «Чисто» («связанные» t) x s → «оценить» («подст» t x s) w = «оценить» t («мир-с» w x s)
  | .«лит» n, x, s, w, h => by simp [«подст», «оценить»]
  | .«имя» y, x, s, w, h => by
      by_cases hy : y = x <;> simp [«подст», «оценить», «мир-с», hy]
  | .«плюс» a b, x, s, w, h => by
      simp only [«подст», «оценить», «связанные»] at *
      rw [«подстановка» a x s w («Чисто-лево» h), «подстановка» b x s w («Чисто-право» h)]
      rfl
  | .«минус» a b, x, s, w, h => by
      simp only [«подст», «оценить», «связанные»] at *
      rw [«подстановка» a x s w («Чисто-лево» h), «подстановка» b x s w («Чисто-право» h)]
      rfl
  | .«умножить» a b, x, s, w, h => by
      simp only [«подст», «оценить», «связанные»] at *
      rw [«подстановка» a x s w («Чисто-лево» h), «подстановка» b x s w («Чисто-право» h)]
      rfl
  | .«остаток» a b, x, s, w, h => by
      simp only [«подст», «оценить», «связанные»] at *
      rw [«подстановка» a x s w («Чисто-лево» h), «подстановка» b x s w («Чисто-право» h)]
  | .«если» u a b, x, s, w, h => by
      simp only [«подст», «оценить», «связанные», List.append_assoc] at *
      rw [«подстановкаФ» u x s w («Чисто-лево» h),
          «подстановка» a x s w («Чисто-лево» («Чисто-право» h)),
          «подстановка» b x s w («Чисто-право» («Чисто-право» h))]
  | .«длина» l, x, s, w, h => by
      simp only [«подст», «оценить», «связанные»] at *
      rw [«подстановкаС» l x s w h]
  | .«кодСимвола» t, x, s, w, h => by
      simp only [«подст», «оценить», «связанные»] at *
      rw [«подстановкаТ» t x s w h]
  | .«свёртка» l n a e z, x, s, w, h => by
      have ha := «Чисто-голова» h
      have he := «Чисто-голова» («Чисто-хвост» h)
      have h' := «Чисто-хвост» («Чисто-хвост» h)
      simp only [«подст», «оценить», «связанные», List.append_assoc] at *
      rw [«подстановкаС» l x s w («Чисто-лево» h'),
          «подстановка» n x s w («Чисто-лево» («Чисто-право» h'))]
      apply «свёртка-конгр»
      intro acc v
      rw [«подстановка» z x s _ («Чисто-право» («Чисто-право» h'))]
      rw [«мир-с-под-связывателем» _ x e s v he.1 he.2,
          «мир-с-под-связывателем» _ x a s acc ha.1 ha.2]
  | .«разбор» l p g y z, x, s, w, h => by
      have hg := «Чисто-голова» h
      have hy := «Чисто-голова» («Чисто-хвост» h)
      have h' := «Чисто-хвост» («Чисто-хвост» h)
      simp only [«подст», «оценить», «связанные», List.append_assoc] at *
      rw [«подстановкаС» l x s w («Чисто-лево» h'),
          «подстановка» p x s w («Чисто-лево» («Чисто-право» h'))]
      apply «разбор-конгр»
      intro hd tl
      rw [«подстановка» z x s _ («Чисто-право» («Чисто-право» h'))]
      rw [«мир-с-под-связывателем» _ x g s hd hg.1 hg.2,
          «мир-с-под-связывателемС» _ x y s tl hy.1 hy.2]
  | .«вызов» f d, x, s, w, h => by
      simp only [«подст», «оценить», «связанные»] at *
      rw [«подстановкаД» d x s w h]
      rfl
theorem «подстановкаС» : ∀ (l : «ТермС») (x : String) (s : «ТермЧ») (w : «Мир»),
    «Чисто» («связанныеС» l) x s → «оценитьС» («подстС» l x s) w = «оценитьС» l («мир-с» w x s)
  | .«пустой», x, s, w, h => by simp [«подстС», «оценитьС»]
  | .«имяС» y, x, s, w, h => by
      by_cases hy : y = x <;> simp [«подстС», «оценитьС», «мир-с», «какСписок», hy]
  | .«выписан» d, x, s, w, h => by
      simp only [«подстС», «оценитьС», «связанныеС»] at *
      rw [«подстановкаД» d x s w h]
  | .«приписать» e l, x, s, w, h => by
      simp only [«подстС», «оценитьС», «связанныеС»] at *
      rw [«подстановка» e x s w («Чисто-лево» h), «подстановкаС» l x s w («Чисто-право» h)]
  | .«добавить» e l, x, s, w, h => by
      simp only [«подстС», «оценитьС», «связанныеС»] at *
      rw [«подстановка» e x s w («Чисто-лево» h), «подстановкаС» l x s w («Чисто-право» h)]
  | .«отбор» l y u, x, s, w, h => by
      have hy := «Чисто-голова» h
      have h' := «Чисто-хвост» h
      simp only [«подстС», «оценитьС», «связанныеС»] at *
      rw [«подстановкаС» l x s w («Чисто-лево» h')]
      apply «отбор-конгр»
      intro v
      rw [«подстановкаФ» u x s _ («Чисто-право» h')]
      rw [«мир-с-под-связывателем» _ x y s v hy.1 hy.2]
  | .«еслиС» u a b, x, s, w, h => by
      simp only [«подстС», «оценитьС», «связанныеС», List.append_assoc] at *
      rw [«подстановкаФ» u x s w («Чисто-лево» h),
          «подстановкаС» a x s w («Чисто-лево» («Чисто-право» h)),
          «подстановкаС» b x s w («Чисто-право» («Чисто-право» h))]
theorem «подстановкаТ» : ∀ (t : «ТермТ») (x : String) (s : «ТермЧ») (w : «Мир»),
    «Чисто» («связанныеТ» t) x s → «оценитьТ» («подстТ» t x s) w = «оценитьТ» t («мир-с» w x s)
  | .«литТ» z, x, s, w, h => by simp [«подстТ», «оценитьТ»]
  | .«имяТ» y, x, s, w, h => by
      by_cases hy : y = x <;> simp [«подстТ», «оценитьТ», «мир-с», «какТекст», hy]
  | .«склейка» l r, x, s, w, h => by
      simp only [«подстТ», «оценитьТ», «связанныеТ»] at *
      rw [«подстановкаТ» l x s w («Чисто-лево» h), «подстановкаТ» r x s w («Чисто-право» h)]
  | .«еслиТ» u a b, x, s, w, h => by
      simp only [«подстТ», «оценитьТ», «связанныеТ», List.append_assoc] at *
      rw [«подстановкаФ» u x s w («Чисто-лево» h),
          «подстановкаТ» a x s w («Чисто-лево» («Чисто-право» h)),
          «подстановкаТ» b x s w («Чисто-право» («Чисто-право» h))]
theorem «подстановкаФ» : ∀ (f : «Форм») (x : String) (s : «ТермЧ») (w : «Мир»),
    «Чисто» («связанныеФ» f) x s → «оценитьФ» («подстФ» f x s) w = «оценитьФ» f («мир-с» w x s)
  | .«да», x, s, w, h => by simp [«подстФ», «оценитьФ»]
  | .«нет», x, s, w, h => by simp [«подстФ», «оценитьФ»]
  | .«неБольше» a b, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановка» a x s w («Чисто-лево» h), «подстановка» b x s w («Чисто-право» h)]
  | .«неМеньше» a b, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановка» a x s w («Чисто-лево» h), «подстановка» b x s w («Чисто-право» h)]
  | .«меньше» a b, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановка» a x s w («Чисто-лево» h), «подстановка» b x s w («Чисто-право» h)]
  | .«больше» a b, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановка» a x s w («Чисто-лево» h), «подстановка» b x s w («Чисто-право» h)]
  | .«равен» a b, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановка» a x s w («Чисто-лево» h), «подстановка» b x s w («Чисто-право» h)]
  | .«содержит» l e, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановкаС» l x s w («Чисто-лево» h), «подстановка» e x s w («Чисто-право» h)]
  | .«неУбывает» l, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановкаС» l x s w h]
  | .«пусто» l, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановкаС» l x s w h]
  | .«начинается» t p, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановкаТ» t x s w («Чисто-лево» h), «подстановкаТ» p x s w («Чисто-право» h)]
  | .«кон» t, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановка» t x s w h]
  | .«цел» t, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановка» t x s w h]
  | .«помещается» t, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановка» t x s w h]
  | .«всех» e l u, x, s, w, h => by
      have he := «Чисто-голова» h
      have h' := «Чисто-хвост» h
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановкаС» l x s w («Чисто-лево» h')]
      apply «всеЭ-конгр»
      intro v
      rw [«подстановкаФ» u x s _ («Чисто-право» h')]
      rw [«мир-с-под-связывателем» _ x e s v he.1 he.2]
  | .«есть» m t u, x, s, w, h => by
      have hm := «Чисто-голова» h
      have h' := «Чисто-хвост» h
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановка» t x s w («Чисто-лево» h')]
      rw [«подстановкаФ» u x s _ («Чисто-право» h')]
      rw [«мир-с-под-связывателем» _ x m s _ hm.1 hm.2]
  | .«и» a b, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановкаФ» a x s w («Чисто-лево» h), «подстановкаФ» b x s w («Чисто-право» h)]
  | .«или» a b, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановкаФ» a x s w («Чисто-лево» h), «подстановкаФ» b x s w («Чисто-право» h)]
  | .«не» a, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ»] at *
      rw [«подстановкаФ» a x s w h]
  | .«еслиФ» u a b, x, s, w, h => by
      simp only [«подстФ», «оценитьФ», «связанныеФ», List.append_assoc] at *
      rw [«подстановкаФ» u x s w («Чисто-лево» h),
          «подстановкаФ» a x s w («Чисто-лево» («Чисто-право» h)),
          «подстановкаФ» b x s w («Чисто-право» («Чисто-право» h))]
theorem «подстановкаД» : ∀ (d : «Доводы») (x : String) (s : «ТермЧ») (w : «Мир»),
    «Чисто» («связанныеД» d) x s → «оценитьД» («подстД» d x s) w = «оценитьД» d («мир-с» w x s)
  | .«нет», x, s, w, h => by simp [«подстД», «оценитьД»]
  | .«ещё» t r, x, s, w, h => by
      simp only [«подстД», «оценитьД», «связанныеД»] at *
      rw [«подстановка» t x s w («Чисто-лево» h), «подстановкаД» r x s w («Чисто-право» h)]
end

/-- Существование, оценённое телом на свидетеле, влечёт «∃» модели — леммой «Св1». -/
theorem «есть-влечёт-∃» (m : String) (t : «ТермЧ») (u : «Форм») (w : «Мир»)
    (h : «оценитьФ» (.«есть» m t u) w = true) :
    ∃ v : «Знач», «оценитьФ» u («обновить» w m v) = true :=
  «Св1» (fun v => «оценитьФ» u («обновить» w m v) = true) («оценить» t w) h

/-! ## Мостики между формулой записи и словами модели

Ведомость пишет неотрицательность формулой «Т не меньше 0», конечность —
«Т : кон», потолок — «Т не больше К». Здесь показано, что значение такой
формулы — ровно то слово модели, о котором говорит лемма правила. -/

/-- «Т не меньше 0» в записи есть «неотр» модели. -/
theorem «неотр-это-порядок» (x : «Знач») : «неотр» x = «неБольше» («кон» 0) x := by
  cases x <;> simp [«неотр», «неБольше»]

theorem «числом-конечно» (x : «Знач») (h : «числом» x = true) : «конечно» x = true := by
  cases x <;> simp_all [«числом», «конечно»]

/-- Γ ⊢ Ф, записанное о формуле. -/
abbrev «Выводится» (Γ : List («Факт» «Мир»)) (f : «Форм») : Prop :=
  «Судим» Γ («Факт-из» f)

/-- «Т не меньше 0» -/
abbrev «≥0» (t : «ТермЧ») : «Форм» := .«неМеньше» t (.«лит» 0)
/-- «Т не больше К» -/
abbrev «≤К» (t : «ТермЧ») (k : Int) : «Форм» := .«неБольше» t (.«лит» k)

theorem «факт-неотр» (t : «ТермЧ») (w : «Мир») :
    «Факт-из» («≥0» t) w ↔ «неотр» («оценить» t w) = true := by
  simp [«Факт-из», «оценитьФ», «оценить», «неМеньше», «неотр-это-порядок»]

theorem «факт-потолок» (t : «ТермЧ») (k : Int) (w : «Мир») :
    «Факт-из» («≤К» t k) w ↔ «неБольше» («оценить» t w) («кон» k) = true := by
  simp [«Факт-из», «оценитьФ», «оценить»]

theorem «факт-кон» (t : «ТермЧ») (w : «Мир») :
    «Факт-из» (.«кон» t) w ↔ «конечно» («оценить» t w) = true := by
  simp [«Факт-из», «оценитьФ»]

theorem «факт-цел» (t : «ТермЧ») (w : «Мир») :
    «Факт-из» (.«цел» t) w ↔ «числом» («оценить» t w) = true := by
  simp [«Факт-из», «оценитьФ»]

theorem «факт-помещается» (t : «ТермЧ») (w : «Мир») :
    «Факт-из» (.«помещается» t) w ↔ «неБольше» («оценить» t w) («кон» («порог» - 1)) = true := by
  simp [«Факт-из», «оценитьФ»]

theorem «факт-всех» (e : String) (l : «ТермС») (u : «Форм») (w : «Мир») :
    «Факт-из» (.«всех» e l u) w ↔
      «всеЭ» (fun v => «оценитьФ» u («обновить» w e v)) («оценитьС» l w) = true := by
  simp [«Факт-из», «оценитьФ»]

/-! ## Переформулировка лемм правил через «оценить» (веха 1, ADR-0041 §2.4 п.1)

Каждая лемма ниже — следствие ОДНОИМЁННОЙ леммы `Правила.lean`, и ничего
сверх подъёма (`подъём0`–`подъём2` из `Модель.lean`) и мостиков выше в ней
нет: если бы модель терма говорила не то, что модель значений, эти следствия
не прошли бы. Семейства — Н, П, Т, Э (как велит задача 2907) и Кон, Св, Пред. -/

/- Семейство Н -/

theorem «Н1-терм» (Γ : List («Факт» «Мир»)) (n : Int) (h : 0 ≤ n) :
    «Выводится» Γ («≥0» (.«лит» n)) :=
  «подъём0» (fun w => («факт-неотр» _ w).mpr («Н1» n h))

theorem «Н2-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ»)
    (h : «Факт-из» («≥0» t) ∈ Γ) : «Выводится» Γ («≥0» t) := «Т1» Γ _ h

theorem «Н3-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ»)
    (h : «Факт-из» («≥0» t) ∈ Γ) : «Выводится» Γ («≥0» t) := «Т1» Γ _ h

theorem «Н4-терм» (Γ : List («Факт» «Мир»)) (l : «ТермС») :
    «Выводится» Γ («≥0» (.«длина» l)) :=
  «подъём0» (fun w => («факт-неотр» _ w).mpr (by simp only [«оценить»]; exact «Н4» _))

theorem «Н5-терм» (Γ : List («Факт» «Мир»)) (l p : «ТермЧ»)
    (h1 : «Выводится» Γ («≥0» l)) (h2 : «Выводится» Γ («≥0» p)) :
    «Выводится» Γ («≥0» (.«плюс» l p)) :=
  «подъём2» (fun w hl hp => («факт-неотр» _ w).mpr (by
    simp only [«оценить»]
    exact «Н5» w.«о» _ _ ((«факт-неотр» _ w).mp hl) ((«факт-неотр» _ w).mp hp))) h1 h2

theorem «Н6-терм» (Γ : List («Факт» «Мир»)) (u : «Форм») (a b : «ТермЧ»)
    (h1 : «Выводится» Γ («≥0» a)) (h2 : «Выводится» Γ («≥0» b)) :
    «Выводится» Γ («≥0» (.«если» u a b)) :=
  «подъём2» (fun w ha hb => («факт-неотр» _ w).mpr (by
    simp only [«оценить»]
    exact «Н6» _ _ _ ((«факт-неотр» _ w).mp ha) ((«факт-неотр» _ w).mp hb))) h1 h2

theorem «Н7-терм» (Γ : List («Факт» «Мир»)) (l : «ТермС») (n : «ТермЧ») (a e : String) (s : «ТермЧ»)
    (h1 : «Выводится» Γ («≥0» n))
    (h2 : ∀ w acc v, «неотр» acc = true →
      «неотр» («оценить» s («обновить» («обновить» w a acc) e v)) = true) :
    «Выводится» Γ («≥0» (.«свёртка» l n a e s)) :=
  «подъём1» (fun w hn => («факт-неотр» _ w).mpr (by
    simp only [«оценить»]
    exact «Н7» _ _ _ ((«факт-неотр» _ w).mp hn) (fun acc v hacc => h2 w acc v hacc))) h1

theorem «Н8-терм» (Γ : List («Факт» «Мир»)) (l p : «ТермЧ»)
    (h1 : «Выводится» Γ (.«меньше» (.«лит» 0) l)) (h2 : «Выводится» Γ (.«кон» l))
    (h3 : «Выводится» Γ («≥0» p)) :
    «Выводится» Γ («≥0» (.«умножить» l p)) := by
  intro w hw
  have a := h1 w hw
  have b := («факт-кон» _ w).mp (h2 w hw)
  have c := («факт-неотр» _ w).mp (h3 w hw)
  simp only [«Факт-из», «оценитьФ», «оценить»] at a
  apply («факт-неотр» _ w).mpr
  simp only [«оценить»]
  exact «Н8-второй» w.«о» _ _ a b c

theorem «Н9-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ»)
    (h : «Выводится» Γ (.«кон» t)) : «Выводится» Γ («≥0» (.«умножить» t t)) :=
  «подъём1» (fun w ht => («факт-неотр» _ w).mpr (by
    simp only [«оценить»]
    exact «Н9» w.«о» _ ((«факт-кон» _ w).mp ht))) h

theorem «Н10-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ») (d : Int) (hd : d ≠ 0)
    (h1 : «Выводится» Γ («≥0» t)) (h2 : «Выводится» Γ (.«цел» t)) :
    «Выводится» Γ («≥0» (.«остаток» t (.«лит» d))) :=
  «подъём2» (fun w ha hb => («факт-неотр» _ w).mpr (by
    simp only [«оценить»]
    exact «Н10» _ d ((«факт-неотр» _ w).mp ha) ((«факт-цел» _ w).mp hb) hd)) h1 h2

theorem «Н12-терм» (Γ : List («Факт» «Мир»)) (l p : «ТермЧ») (k : Int)
    (h1 : «Выводится» Γ («≥0» p)) (h2 : «Выводится» Γ («≤К» p k))
    (h3 : «Факт-из» (.«неБольше» p l) ∈ Γ) :
    «Выводится» Γ («≥0» (.«минус» l p)) := by
  intro w hw
  have a := («факт-неотр» _ w).mp (h1 w hw)
  have b := («факт-потолок» _ _ w).mp (h2 w hw)
  have c := hw _ h3
  simp only [«Факт-из», «оценитьФ»] at c
  apply («факт-неотр» _ w).mpr
  simp only [«оценить»]
  exact «Н12» w.«о» _ _ k a b c

/- Семейство Кон -/

theorem «Кон1-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ») (k : Int)
    (h : «Факт-из» («≤К» t k) ∈ Γ) : «Выводится» Γ (.«кон» t) :=
  «подъём1» (fun w hk => («факт-кон» _ w).mpr («Кон1» _ k ((«факт-потолок» _ _ w).mp hk)))
    («Т1» Γ _ h)

theorem «Кон3-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ»)
    (h : «Выводится» Γ (.«равен» (.«минус» t t) (.«лит» 0))) : «Выводится» Γ (.«кон» t) :=
  «подъём1» (fun w hr => («факт-кон» _ w).mpr (by
    simp only [«Факт-из», «оценитьФ», «оценить»] at hr
    exact «числом-конечно» _ («Кон2» w.«о» _ hr))) h

/- Семейство П и Пред -/

theorem «П1-терм» (Γ : List («Факт» «Мир»)) (t k : Int) (h : t ≤ k) :
    «Выводится» Γ («≤К» (.«лит» t) k) :=
  «подъём0» (fun w => («факт-потолок» _ _ w).mpr («П1» t k h))

theorem «П2-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ») (k2 k : Int) (hk : k2 ≤ k)
    (h : «Факт-из» («≤К» t k2) ∈ Γ) : «Выводится» Γ («≤К» t k) :=
  «подъём1» (fun w h2 => («факт-потолок» _ _ w).mpr («П2» _ k2 k ((«факт-потолок» _ _ w).mp h2) hk))
    («Т1» Γ _ h)

theorem «Пред1-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ»)
    (h : «Факт-из» («≤К» t («порог» - 1)) ∈ Γ) : «Выводится» Γ (.«помещается» t) :=
  «подъём1» (fun w hp => («факт-помещается» _ w).mpr («Пред1» _ ((«факт-потолок» _ _ w).mp hp)))
    («Т1» Γ _ h)

theorem «П3-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ») (k : Int) (hk : «порог» - 1 ≤ k)
    (h : «Выводится» Γ (.«помещается» t)) : «Выводится» Γ («≤К» t k) :=
  «подъём1» (fun w hp => («факт-потолок» _ _ w).mpr
    («П3» _ _ ((«факт-помещается» _ w).mp hp) (by simp [«неБольше», hk]))) h

theorem «П4-терм» (Γ : List («Факт» «Мир»)) (u : «Форм») (a b : «ТермЧ») (k : Int)
    (h1 : «Выводится» Γ («≤К» a k)) (h2 : «Выводится» Γ («≤К» b k)) :
    «Выводится» Γ («≤К» (.«если» u a b) k) :=
  «подъём2» (fun w ha hb => («факт-потолок» _ _ w).mpr (by
    simp only [«оценить»]
    exact «П4» _ _ _ _ ((«факт-потолок» _ _ w).mp ha) ((«факт-потолок» _ _ w).mp hb))) h1 h2

theorem «П5-терм» (Γ : List («Факт» «Мир»)) (l p : «ТермЧ») (k : Int)
    (hk1 : -«порог» ≤ k) (hk2 : k ≤ «порог»)
    (h1 : «Выводится» Γ («≤К» l k)) (h2 : «Выводится» Γ («≥0» p)) :
    «Выводится» Γ («≤К» (.«минус» l p) k) :=
  «подъём2» (fun w hl hp => («факт-потолок» _ _ w).mpr (by
    simp only [«оценить»]
    exact «П5» w.«о» _ _ k ((«факт-потолок» _ _ w).mp hl) ((«факт-неотр» _ w).mp hp)
      (w.«о».«точно» k hk1 hk2))) h1 h2

theorem «П6-терм» (Γ : List («Факт» «Мир»)) (t : «ТермЧ») (d k : Int) (hd : 0 < d) (hk : d - 1 ≤ k)
    (h1 : «Выводится» Γ («≥0» t)) (h2 : «Выводится» Γ (.«цел» t)) :
    «Выводится» Γ («≤К» (.«остаток» t (.«лит» d)) k) :=
  «подъём2» (fun w ha hb => («факт-потолок» _ _ w).mpr (by
    simp only [«оценить»]
    exact «П6» _ d k ((«факт-неотр» _ w).mp ha) ((«факт-цел» _ w).mp hb) hd hk)) h1 h2

/- Семейство Т -/

theorem «Т1-терм» (Γ : List («Факт» «Мир»)) (f : «Форм») (h : «Факт-из» f ∈ Γ) :
    «Выводится» Γ f := «Т1» Γ _ h

/- Семейство Э -/

/-- «для всех E из Л : У» -/
abbrev «∀э» (e : String) (l : «ТермС») (u : «Форм») : «Форм» := .«всех» e l u

theorem «Э1-терм» (Γ : List («Факт» «Мир»)) (e : String) (u : «Форм») :
    «Выводится» Γ («∀э» e .«пустой» u) :=
  «подъём0» (fun w => («факт-всех» _ _ _ w).mpr (by simp only [«оценитьС»]; exact «Э1» _))

/-- Э2: свойство цели — условие отбора с E вместо X. Побочные условия те же,
    что у сверщика (подстановка без захвата), и ещё одно, которого сверщик не
    спрашивает: E не свободно в условии отбора (иначе E, стоящее в условии
    свободным, после подстановки читалось бы как связанное — захват имени
    самой цели). -/
theorem «Э2-терм» (Γ : List («Факт» «Мир»)) (e x : String) (l : «ТермС») (u2 : «Форм»)
    (hc : «Чисто» («связанныеФ» u2) x (.«имя» e))
    (he : e = x ∨ e ∉ «свободныеФ» u2) :
    «Выводится» Γ («∀э» e (.«отбор» l x u2) («подстФ» u2 x (.«имя» e))) :=
  «подъём0» (fun w => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    have key : ∀ v, «оценитьФ» («подстФ» u2 x (.«имя» e)) («обновить» w e v) =
        «оценитьФ» u2 («обновить» w x v) := by
      intro v
      rw [«подстановкаФ» u2 x (.«имя» e) _ hc]
      have hv : «оценить» (.«имя» e) («обновить» w e v) = v := by simp [«оценить»]
      simp only [«мир-с», hv]
      rcases he with rfl | he
      · rw [«обновить-дважды»]
      · apply «согласиеФ»
        refine ⟨rfl, rfl, fun y hy => ?_⟩
        have : y ≠ e := fun h => he (h ▸ hy)
        simp [this]
    rw [«всеЭ-конгр» _ (fun v => «оценитьФ» u2 («обновить» w x v)) _ key]
    exact «Э2» _ _))

theorem «Э3-приписать-терм» (Γ : List («Факт» «Мир»)) (e : String) (d : «ТермЧ») (l : «ТермС») (u : «Форм»)
    (hc : «Чисто» («связанныеФ» u) e d)
    (h1 : «Выводится» Γ («подстФ» u e d)) (h2 : «Выводится» Γ («∀э» e l u)) :
    «Выводится» Γ («∀э» e (.«приписать» d l) u) :=
  «подъём2» (fun w ha hb => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    have ha' : «оценитьФ» u («обновить» w e («оценить» d w)) = true := by
      have := ha; simp only [«Факт-из»] at this; rwa [«подстановкаФ» u e d w hc] at this
    exact «Э3-приписать» _ _ _ ha' ((«факт-всех» _ _ _ w).mp hb))) h1 h2

theorem «Э3-добавить-терм» (Γ : List («Факт» «Мир»)) (e : String) (d : «ТермЧ») (l : «ТермС») (u : «Форм»)
    (hc : «Чисто» («связанныеФ» u) e d)
    (h1 : «Выводится» Γ («подстФ» u e d)) (h2 : «Выводится» Γ («∀э» e l u)) :
    «Выводится» Γ («∀э» e (.«добавить» d l) u) :=
  «подъём2» (fun w ha hb => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    have ha' : «оценитьФ» u («обновить» w e («оценить» d w)) = true := by
      have := ha; simp only [«Факт-из»] at this; rwa [«подстановкаФ» u e d w hc] at this
    exact «Э3-добавить» _ _ _ ha' ((«факт-всех» _ _ _ w).mp hb))) h1 h2

theorem «Э4-терм» (Γ : List («Факт» «Мир»)) (e : String) (c : «Форм») (a b : «ТермС») (u : «Форм»)
    (h1 : «Выводится» Γ («∀э» e a u)) (h2 : «Выводится» Γ («∀э» e b u)) :
    «Выводится» Γ («∀э» e (.«еслиС» c a b) u) :=
  «подъём2» (fun w ha hb => («факт-всех» _ _ _ w).mpr (by
    simp only [«оценитьС»]
    exact «Э4» _ _ _ _ ((«факт-всех» _ _ _ w).mp ha) ((«факт-всех» _ _ _ w).mp hb))) h1 h2

/- Св1 -/

theorem «Св1-терм» (Γ : List («Факт» «Мир»)) (m : String) (t : «ТермЧ») (u : «Форм»)
    (hc : «Чисто» («связанныеФ» u) m t)
    (h : «Выводится» Γ («подстФ» u m t)) : «Выводится» Γ (.«есть» m t u) :=
  «подъём1» (fun w hu => by
    simp only [«Факт-из», «оценитьФ»] at *
    rw [«подстановкаФ» u m t w hc] at hu
    exact hu) h
