def «подст» : «ТермЧ» → String → «ТермЧ» → «ТермЧ»
  | .«лит» n, _, _ => .«лит» n
  | .«имя» y, x, s => if y = x then s else .«имя» y
  | .«плюс» a b, x, s => .«плюс» («подст» a x s) («подст» b x s)
