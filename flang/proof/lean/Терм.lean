theorem «Н12-терм» (Γ : List («Факт» «Мир»)) (l p : «ТермЧ») (k : Int)
    (h1 : «Выводится» Γ («≥0» p)) (h2 : «Выводится» Γ («≤К» p k))
    (h3 : «Факт-из» (.«неБольше» p l) ∈ Γ) :
    «Выводится» Γ («≥0» (.«минус» l p)) := by
  intro w hw
  have a := («факт-неотр» _ w).mp (h1 w hw)
  have b := («факт-потолок» _ _ w).mp (h2 w hw)
  have c := hw _ h3
  simp only [«Факт-из», «оценитьФ»] at c
  apply («факт-неотр» _ w).mpr
  simp only [«оценить»]
  exact «Н12» w.«о» _ _ k a b c

