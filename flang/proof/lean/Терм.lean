    (h : «Факт-из» (.«неБольше» e g) ∈ Γ) : «Выводится» Γ (.«неБольше» e g) := by
  have eq : «Факт-из» (.«неБольше» e g) = fun w => «неБольше» («оценить» e w) («оценить» g w) = true := by
    funext w; simp [«Факт-из», «оценитьФ»]
  show «Судим» Γ («Факт-из» (.«неБольше» e g))
  rw [eq] at h ⊢; exact «О1» Γ (fun w => «оценить» e w) (fun w => «оценить» g w) h

