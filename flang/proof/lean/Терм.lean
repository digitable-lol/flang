theorem «Н12-терм» (Γ : List («Факт» «Мир»)) (l p : «ТермЧ») (k : Int)
    (h1 : «Выводится» Γ («≥0» p)) (h2 : «Выводится» Γ («≤К» p k))
    (h3 : «Факт-из» (.«неБольше» p l) ∈ Γ) :
    «Выводится» Γ («≥0» (.«минус» l p)) := by
  intro w hw
