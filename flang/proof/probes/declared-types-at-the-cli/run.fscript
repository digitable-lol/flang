модуль «Пробы объявленных типов на входе»

использует «Таблица проб» из "../table.fscript"

тотальная функция «Имя набора»
  возвращает строка
  пример «набор назван своим каталогом»
    ожидается "declared-types-at-the-cli"
  "declared-types-at-the-cli"

тотальная функция «Этот набор»
  возвращает «Набор»
  пусть имя равно («Имя набора»)
  пусть красное равно "FLANG_PROBE_DECLARED_TYPES_AT_THE_CLI"
  пусть слепое равно "FLANG_PROBE_DECLARED_TYPES_AT_THE_CLI_CANNOT_LOOK"
  запись «Набор» с «имя» равным имя и «код расхождения» равным красное и «код слепоты» равным слепое

тотальная функция «Каталог набора»
  возвращает строка
  пример «путь считается от корня дерева»
    ожидается "flang/proof/probes/declared-types-at-the-cli"
  "flang/proof/probes/declared-types-at-the-cli"

тотальная функция «Запрос прогонщику»
  принимает называемая: строка, значение: строка
  возвращает строка
  пример «один числовой аргумент в разметке прогонщика»
    дано называемая равно "Удвоить вес"
    дано значение равно "-1"
    ожидается "{\"fn\":\"Удвоить вес\",\"args\":[{\"n\":\"-1\"}]}"
  соединить ["{\"fn\":\"", называемая, "\",\"args\":[{\"n\":\"", значение, "\"}]}"] по ""

тотальная функция «Сборка цели»
  принимает цель: строка
  возвращает строка
  пример «Java собирается своей целью build»
    дано цель равно "java"
    ожидается "make -s build"
  если («Есть в списке» от ["c", "cpp", "go", "rust", "elixir"] и цель)
    то "make -s"
    иначе (если («Есть в списке» от ["java", "csharp"] и цель) то "make -s build" иначе "true")

тотальная функция «Есть в списке»
  принимает слова: список строки, слово: строка
  возвращает признак
  свёртка слова начиная с нет как нашлось и кандидат → (нашлось или (кандидат равен слово))

тотальная функция «Запуск цели»
  принимает цель: строка
  возвращает строка
  пример «прогонщик Go — собранный файл»
    дано цель равно "go"
    ожидается "./flang_cli"
  если «Есть в списке» от ["c", "cpp", "go"] и цель
    то "./flang_cli"
    иначе «Запуск цели на чужом рантайме» от цель

тотальная функция «Запуск цели на чужом рантайме»
  принимает цель: строка
  возвращает строка
  пусть мод равно "\"$(sed -n 's/^MODULE ?= //p' Makefile)\""
  пусть класс равно "\"$(sed -n 's/^CLASS ?= //p' Makefile)\""
  если цель равен "rust"
    то "./target/debug/flang_cli"
    иначе
      если цель равен "java"
        то соединить ["java -cp . FlangCli ", класс] по ""
        иначе «Запуск цели без JVM» от цель и мод и класс

тотальная функция «Запуск цели без JVM»
  принимает цель: строка, мод: строка, класс: строка
  возвращает строка
  если цель равен "csharp"
    то соединить ["dotnet run --no-build -- ", класс] по ""
    иначе
      если цель равен "python"
        то соединить ["python3 -B flang_cli.py ", мод] по ""
        иначе «Запуск цели на сценарии» от цель и мод

тотальная функция «Запуск цели на сценарии»
  принимает цель: строка, мод: строка
  возвращает строка
  пусть сценарий равно "\"./$(ls | grep -v '^flang_' | grep -E '[.](js|ts)$' | head -n 1)\""
  пусть эликсир равно (соединить ["{ m=$(sed -n 's/^MODULE ?= //p' Makefile); ",
    "elixir -pa _build -e \"Flang.Cli.main([\\\"$m\\\"])\"; }"] по "")
  если цель равен "elixir" то эликсир иначе (соединить ["node flang_cli.js ", сценарий] по "")

тотальная функция «Вызов цели»
  принимает цель: строка, путь: строка, запрос: строка
  возвращает строка
  соединить ["d=${FLANG_TMP:-${TMPDIR:-/tmp}}/declared-types-at-the-cli/",
    "$(cat \"$flang\" '", путь, "' | cksum | tr ' ' -)/", цель, "; ",
    "[ -f \"$d/.built\" ] || { rm -rf \"$d\"; \"$flang\" emit '", путь, "' --target ", цель,
    " --out \"$d\" > /dev/null 2>&1 && (cd \"$d\" && ", («Сборка цели» от цель),
    ") > /dev/null 2>&1 && touch \"$d/.built\"; }; ",
    "cd \"$d\" && printf '%s\\n' '", запрос, "' | ", («Запуск цели» от цель)] по ""

тотальная функция «Вызов»
  принимает поверхность: строка, программа: строка, называемая: строка, вход: строка
  возвращает строка
  пример «проверке нужен только файл»
    дано поверхность равно "check"
    дано программа равно "scale-mix.flang"
    дано называемая равно "-"
    дано вход равно "-"
    ожидается "$flang check 'flang/proof/probes/declared-types-at-the-cli/programs/scale-mix.flang'"
  пусть путь равно (соединить [(«Каталог набора»), "/programs/", программа] по "")
  если поверхность равен "check"
    то соединить ["$flang check '", путь, "'"] по ""
    иначе
      если поверхность равен "run"
        то соединить ["$flang run '", путь, "' --function '", называемая, "' --args '", вход, "'"] по ""
        иначе «Вызов цели» от поверхность и путь и («Запрос прогонщику» от называемая и вход)

тотальная функция «Проба из строки»
  принимает части: список строки
  возвращает «Проба»
  пусть п равно («Поле» от части и 1)
  пусть поверхность равно («Поле» от части и 2)
  пусть называемая равно («Поле» от части и 3)
  пусть вход равно («Поле» от части и 4)
  пусть пр равно («Приметы» от п и [поверхность, называемая, вход])
  пусть з равно («От корня» от («С меткой» от («Вызов» от поверхность и п и называемая и вход)))
  пусть кд равно («Поле» от части и 5)
  пусть сл равно («Поле» от части и 6)
  запись «Проба» с «программа» равным п и «приметы» равным пр и «команда» равным з и «код» равным кд и «слово» равным сл

тотальная функция «Пробы»
  принимает текст: строка
  возвращает список «Проба»
  отобразить («Строки данных» от текст) как части → («Проба из строки» от части)

тотальная функция «Начать»
  возвращает «Ход»
  вариант «Начало»

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём таблицу»
      то «После таблицы» от («Этот набор») и («Пробы» от («Содержимое» от отклик))
    случай любое
      то «Шаг» от («Этот набор») и ход и отклик

план «Binary»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
