модуль «Exact actions in the print targets»

тотальная функция «Функции»
  возвращает список строки
  обеспечивает «функций пробы тридцать три» (длина результат) равен 33
  [
    "Сумма за потолком", "Разность за потолком", "Квадрат за потолком", "Двойка в сто тридцать второй",
    "Остаток длинного на длинное", "Шаг генератора", "Переполненный разряд из счёта", "Канон при действии",
    "Канон при разности", "Соседи различимы", "Соседи не путаются", "Равные не меньше", "Равные не больше",
    "Ниже нуля", "Остаток от нуля", "Слева направо", "Справа налево", "Сокращено при действии",
    "Ноль над единицей", "Деление точно", "Произведение сокращено", "Большой числитель", "Большой знаменатель",
    "Длинный общий делитель", "Порядок длинных", "Треть меньше половины", "Две трети не меньше трёх пятых",
    "Равные дроби не больше", "Равные дроби не больше строго", "Дробь ниже нуля", "На ноль",
    "Целая часть дроби", "Целая часть меньше единицы"
  ]

тотальная функция «Цели»
  возвращает список строки
  обеспечивает «целей печати десять» (длина результат) равен 10
  ["c", "cpp", "python", "go", "java", "csharp", "rust", "elixir", "js", "ts"]

тотальная функция «Заменить»
  принимает текст: строка, что: строка, чем: строка
  возвращает строка
  пример «каждое вхождение заменено»
    дано текст равно "а-б-в"
    дано что равно "-"
    дано чем равно "+"
    ожидается "а+б+в"
  пример «без вхождений текст тот же»
    дано текст равно "абв"
    дано что равно "-"
    дано чем равно "+"
    ожидается "абв"
  соединить (разделить текст по что) по чем

тотальная функция «Значение словами»
  принимает значение: строка
  возвращает строка
  пример «дробь из JSON печати становится записью вычислителя»
    дано значение равно "{\"l\":[{\"l\":[{\"n\":\"3\"}]},{\"l\":[{\"n\":\"5\"}]}]}"
    ожидается "[[3],[5]]"
  пример «пустые разряды остаются пустыми скобками»
    дано значение равно "{\"l\":[{\"l\":[]},{\"l\":[{\"n\":\"1\"}]}]}"
    ожидается "[[],[1]]"
  пример «признак не меняется»
    дано значение равно "true"
    ожидается "true"
  пусть без_чисел равно («Заменить» от («Заменить» от значение и "{\"n\":\"" и "") и "\"}" и "")
  «Заменить» от («Заменить» от без_чисел и "{\"l\":[" и "[") и "]}" и "]"

тотальная функция «Хвост после»
  принимает текст: строка, начало: строка
  возвращает строка
  пример «начало снято»
    дано текст равно "ключ:значение"
    дано начало равно "ключ:"
    ожидается "значение"
  соединить (хвост (разделить текст по начало)) по начало

тотальная функция «Без последнего знака»
  принимает текст: строка
  возвращает строка
  пример «закрывающая скобка снята»
    дано текст равно "true}"
    ожидается "true"
  пример «пустая строка остаётся пустой»
    дано текст равно ""
    ожидается ""
  если (длина текст) больше 1
    то подстрока текст с 1 по ((длина текст) минус 1)
    иначе ""

тотальная функция «Удача»
  возвращает строка
  "{\"ok\":true,\"value\":"

тотальная функция «Отказ»
  возвращает строка
  "{\"ok\":false,\"code\":\""

тотальная функция «Отказ словами»
  принимает строка: строка
  возвращает строка
  пример «код и сообщение через двоеточие, как у вычислителя»
    дано строка равно "{\"ok\":false,\"code\":\"FLANG_PROPERTY\",\"message\":\"на ноль\"}"
    ожидается "FLANG_PROPERTY: на ноль"
  пусть тело равно («Хвост после» от строка и («Отказ»))
  пусть части равно (разделить тело по "\",\"message\":\"")
  пусть сообщение равно (соединить (хвост части) по "\",\"message\":\"")
  соединить [(голова части), ": ", («Без последнего знака» от («Без последнего знака» от сообщение))] по ""

тотальная функция «Ответ словами»
  принимает строка: строка
  возвращает строка
  пример «удача печатается значением»
    дано строка равно "{\"ok\":true,\"value\":true}"
    ожидается "true"
  пример «отказ печатается кодом и сообщением»
    дано строка равно "{\"ok\":false,\"code\":\"FLANG_TYPE\",\"message\":\"нет\"}"
    ожидается "FLANG_TYPE: нет"
  пример «чужая строка доезжает как есть и потому расходится»
    дано строка равно "error: build failed"
    ожидается "error: build failed"
  разбор (строка начинается с («Удача»))
    случай да
      то «Значение словами» от («Без последнего знака» от («Хвост после» от строка и («Удача»)))
    случай нет
      то разбор (строка начинается с («Отказ»))
        случай да
          то «Отказ словами» от строка
        случай нет
          то строка

тотальная функция «Непустые строки»
  принимает текст: строка
  возвращает список строки
  пример «пустые строки и перевод на конце сняты»
    дано текст равно "а\n\nб\n"
    ожидается ["а", "б"]
  отфильтровать (разделить текст по "\n") где строка → (длина строка) больше 0

тотальная функция «Строки с именами»
  принимает имена: список строки, ответы: список строки
  возвращает список строки
  пример «имя и ответ через табуляцию»
    дано имена равно ["Ф", "Г"]
    дано ответы равно ["1", "2"]
    ожидается ["Ф\t1", "Г\t2"]
  пример «недостающий ответ назван пустым»
    дано имена равно ["Ф", "Г"]
    дано ответы равно ["1"]
    ожидается ["Ф\t1", "Г\t"]
  разбор имена
    случай пусто
      то пустой список
    случай голова «имя» и хвост «прочие имена»
      то разбор ответы
        случай пусто
          то приписать (соединить [«имя», "\t"] по "") к («Строки с именами» от «прочие имена» и пустой список)
        случай голова «ответ» и хвост «прочие ответы»
          то приписать (соединить [«имя», «ответ»] по "\t") к («Строки с именами» от «прочие имена» и «прочие ответы»)

тотальная функция «Таблица ответов»
  принимает имена: список строки, ответы: список строки
  возвращает строка
  пример «каждый ответ под своим именем»
    дано имена равно ["Ф"]
    дано ответы равно ["[[3],[5]]"]
    ожидается "Ф\t[[3],[5]]"
  соединить («Строки с именами» от имена и ответы) по "\n"

тотальная функция «Ответы цели»
  принимает имена: список строки, вывод: строка
  возвращает строка
  пример «JSON печати становится таблицей вычислителя»
    дано имена равно ["Ф"]
    дано вывод равно "{\"ok\":true,\"value\":{\"l\":[{\"n\":\"2\"},{\"n\":\"0\"},{\"n\":\"512\"}]}}\n"
    ожидается "Ф\t[2,0,512]"
  «Таблица ответов» от имена и (отобразить («Непустые строки» от вывод) как строка → («Ответ словами» от строка))

тотальная функция «Ответы вычислителя»
  принимает имена: список строки, вывод: строка
  возвращает строка
  пример «вычислитель печатает ответы по строке на функцию»
    дано имена равно ["Ф"]
    дано вывод равно "[2,0,512]\n"
    ожидается "Ф\t[2,0,512]"
  «Таблица ответов» от имена и («Непустые строки» от вывод)

тотальная функция «Ожидание из файла»
  принимает текст: строка
  возвращает строка
  пример «перевод строки на конце снят»
    дано текст равно "Ф\t1\n"
    ожидается "Ф\t1"
  соединить («Непустые строки» от текст) по "\n"

тотальная функция «Подлог»
  принимает ожидание: строка
  возвращает строка
  пример «пять шестых подменены пятью седьмыми»
    дано ожидание равно "Деление точно\t[[5],[6]]"
    ожидается "Деление точно\t[[5],[7]]"
  «Заменить» от ожидание и "Деление точно\t[[5],[6]]" и "Деление точно\t[[5],[7]]"

тотальная функция «Двоичный»
  возвращает строка
  "../../../../bootstrap/flang"

тотальная функция «Программа»
  возвращает строка
  "programs/exact-actions.flang"

тотальная функция «Имена для оболочки»
  возвращает строка
  обеспечивает «имена стоят в одинарных кавычках» результат начинается с "'"
  соединить (отобразить («Функции») как имя → (соединить ["'", имя, "'"] по "")) по " "

тотальная функция «Временный каталог»
  возвращает строка
  соединить [
    "d=$(mktemp -d \"${FLANG_TMP:-${TMPDIR:-/tmp}}/exact-actions.XXXXXX\") || exit 2; ",
    "trap 'rm -rf \"$d\"' EXIT INT TERM; "
  ] по ""

тотальная функция «Зов вычислителя»
  возвращает строка
  обеспечивает «вычислитель зовётся на каждую функцию» результат содержит "--function"
  соединить [
    («Временный каталог»),
    "for f in ", («Имена для оболочки»), "; do ",
    "if out=$(", («Двоичный»), " run ", («Программа»), " --function \"$f\" 2>\"$d/err\"); ",
    "then printf '%s\\n' \"$out\"; else tail -n 1 \"$d/err\"; fi; done"
  ] по ""

тотальная функция «Запросы»
  возвращает строка
  соединить [
    "for f in ", («Имена для оболочки»), "; do printf '{\"fn\":\"%s\",\"args\":[]}\\n' \"$f\"; done > \"$d/q\"; "
  ] по ""

тотальная функция «Каталог рантайма»
  принимает цель: строка
  возвращает строка
  пример «cpp берёт рантайм у общего каталога»
    дано цель равно "cpp"
    ожидается "$PWD/../../../src/emit"
  пример «c берёт свой»
    дано цель равно "c"
    ожидается "$PWD/../../../src/emit/c"
  разбор цель
    случай "cpp"
      то "$PWD/../../../src/emit"
    случай "ts"
      то "$PWD/../../../src/emit"
    случай любое
      то соединить ["$PWD/../../../src/emit/", цель] по ""

тотальная функция «Печать цели»
  принимает цель: строка
  возвращает строка
  соединить [
    («Двоичный»), " emit ", («Программа»), " --target ", цель, " --out \"$d/p\" --runtime \"",
    («Каталог рантайма» от цель), "\" > \"$d/e\" 2>&1 || { head -n 3 \"$d/e\"; exit 0; }; "
  ] по ""

тотальная функция «Свежесть JS»
  возвращает строка
  соединить [
    "grep -q 'function [$]exactCanon' \"$d\"/p/*.js || { printf 'skip\\t%s\\n' ",
    "'напечатанный рантайм JS ещё без точного дробного: он печатается из flang/self/emit-js.flang'; exit 0; }; "
  ] по ""

тотальная функция «Инструмент»
  принимает цель: строка
  возвращает строка
  пример «C собирается cc»
    дано цель равно "c"
    ожидается "cc"
  разбор цель
    случай "c"
      то "cc"
    случай "cpp"
      то "g++"
    случай "python"
      то "python3"
    случай "go"
      то "go"
    случай "java"
      то "javac"
    случай "csharp"
      то "dotnet"
    случай "rust"
      то "cargo"
    случай "elixir"
      то "elixirc"
    случай любое
      то "node"

тотальная функция «Сборка и прогон»
  принимает цель: строка
  возвращает строка
  пример «c собирается своим Makefile»
    дано цель равно "c"
    ожидается "(cd \"$d/p\" && make -s flang_cli > \"$d/b\" 2>&1 && ./flang_cli --json < \"$d/q\") || cat \"$d/b\""
  разбор цель
    случай "c"
      то "(cd \"$d/p\" && make -s flang_cli > \"$d/b\" 2>&1 && ./flang_cli --json < \"$d/q\") || cat \"$d/b\""
    случай "cpp"
      то "(cd \"$d/p\" && make -s flang_cli > \"$d/b\" 2>&1 && ./flang_cli --json < \"$d/q\") || cat \"$d/b\""
    случай "python"
      то "cd \"$d/p\" && python3 -B flang_cli.py $(sed -n 's/^MODULE ?= //p' Makefile) < \"$d/q\""
    случай "go"
      то "(cd \"$d/p\" && go build -o flang_cli ./cli > \"$d/b\" 2>&1 && ./flang_cli < \"$d/q\") || cat \"$d/b\""
    случай "java"
      то «Сборка Java»
    случай "csharp"
      то «Сборка CSharp»
    случай "rust"
      то «Сборка Rust»
    случай "elixir"
      то «Сборка Elixir»
    случай "js"
      то "cd \"$d/p\" && node flang_cli.js ./$(ls *.js | grep -v '^flang_' | head -n 1) < \"$d/q\""
    случай любое
      то «Сборка TS»

тотальная функция «Сборка Java»
  возвращает строка
  соединить [
    "(cd \"$d/p\" && make -s build > \"$d/b\" 2>&1 ",
    "&& java -cp . FlangCli $(sed -n 's/^CLASS ?= //p' Makefile) < \"$d/q\") || cat \"$d/b\""
  ] по ""

тотальная функция «Сборка CSharp»
  возвращает строка
  соединить [
    "(cd \"$d/p\" && DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 ",
    "dotnet build -v quiet --nologo -o out > \"$d/b\" 2>&1 ",
    "&& dotnet out/flang.dll $(sed -n 's/^CLASS ?= //p' Makefile) < \"$d/q\") || cat \"$d/b\""
  ] по ""

тотальная функция «Сборка Rust»
  возвращает строка
  соединить [
    "(cd \"$d/p\" && RUSTFLAGS='-D warnings' cargo build --offline -q > \"$d/b\" 2>&1 ",
    "&& ./target/debug/flang_cli < \"$d/q\") || cat \"$d/b\""
  ] по ""

тотальная функция «Сборка Elixir»
  возвращает строка
  соединить [
    "(cd \"$d/p\" && make -s build > \"$d/b\" 2>&1 ",
    "&& elixir -pa _build -e \"Flang.Cli.main([\\\"$(sed -n 's/^MODULE ?= //p' Makefile)\\\"])\" < \"$d/q\") ",
    "|| cat \"$d/b\""
  ] по ""

тотальная функция «Сборка TS»
  возвращает строка
  соединить [
    "cd \"$d/p\" && { npx --yes -p typescript tsc --outDir out --noEmit false > \"$d/b\" 2>&1 || true; } ",
    "&& { ls out/*.js > /dev/null 2>&1 || { printf 'skip\\t%s\\n' 'нет tsc: npx не достал typescript'; exit 0; }; } ",
    "&& cp flang_cli.js flang_runtime.js package.json out/ && cd out ",
    "&& node flang_cli.js ./$(ls *.js | grep -v '^flang_' | head -n 1) < \"$d/q\""
  ] по ""

тотальная функция «Зов цели»
  принимает цель: строка
  возвращает строка
  пусть свежесть равно (если (цель равен "js") или (цель равен "ts") то («Свежесть JS») иначе "")
  соединить [
    "command -v ", («Инструмент» от цель), " > /dev/null 2>&1 || { printf 'skip\\tнет %s\\n' '",
    («Инструмент» от цель), "'; exit 0; }; ", («Временный каталог»), («Запросы»), («Печать цели» от цель),
    свежесть, («Сборка и прогон» от цель)
  ] по ""

тотальная функция «Это отказ смотреть»
  принимает ответ: строка
  возвращает признак
  пример «цель без инструментов отвечает словом skip»
    дано ответ равно "skip\tнет cc"
    ожидается да
  пример «строка ответа отказом не считается»
    дано ответ равно "[[3],[5]]"
    ожидается нет
  ответ начинается с "skip\t"

объект «Ведомость»
  «строки»: список строки
  «беды»: список строки

тотальная функция «Пустая ведомость»
  возвращает «Ведомость»
  обеспечивает «до первого участника строк нет» (длина (результат.«строки»)) равен 0
  запись «Ведомость» с «строки» равным пустой список и «беды» равным пустой список

тотальная функция «Сколько с меткой»
  принимает ведомость: «Ведомость», метка: строка
  возвращает число
  пример «зелёные строки сочтены»
    дано ведомость равно (запись «Ведомость» с «строки» равным ["зелен   c: да", "?       js: нет"] и «беды» равным [])
    дано метка равно "зелен"
    ожидается 1
  длина (отфильтровать (ведомость.«строки») где строка → строка начинается с метка)

тотальная функция «Строка исхода»
  принимает метка: строка, кто: строка, что: строка
  возвращает строка
  пример «строка исхода называет участника»
    дано метка равно "зелен   "
    дано кто равно "c"
    дано что равно "ответы совпали"
    ожидается "зелен   c: ответы совпали"
  соединить [метка, кто, ": ", что] по ""

тотальная функция «Беда участника»
  принимает кто: строка, ожидание: строка, ответ: строка
  возвращает строка
  пример «беда показывает оба текста целиком»
    дано кто равно "go"
    дано ожидание равно "Ф\t1"
    дано ответ равно "Ф\t2"
    ожидается "go: ждали\nФ\t1\nполучили\nФ\t2"
  соединить [кто, ": ждали\n", ожидание, "\nполучили\n", ответ] по ""

тотальная функция «Прибавить»
  принимает ведомость: «Ведомость», кто: строка, ожидание: строка, ответ: строка
  возвращает «Ведомость»
  обеспечивает «участник даёт одну строку» (длина (результат.«строки»)) равен ((длина (ведомость.«строки»)) плюс 1)
  пусть сошлось равно (ответ равен ожидание)
  пусть метка равно (если сошлось то "зелен   " иначе "КРАСЕН  ")
  пусть что равно (если сошлось то "ответы совпали с ожиданием знак в знак" иначе "ответ разошёлся с ожиданием")
  пусть строки равно (добавить («Строка исхода» от метка и кто и что) к (ведомость.«строки»))
  пусть беда равно («Беда участника» от кто и ожидание и ответ)
  пусть беды равно (если сошлось то (ведомость.«беды») иначе (добавить беда к (ведомость.«беды»)))
  запись «Ведомость» с «строки» равным строки и «беды» равным беды

тотальная функция «Прибавить немеренное»
  принимает ведомость: «Ведомость», кто: строка, ответ: строка
  возвращает «Ведомость»
  обеспечивает «немеренное бед не прибавляет» (длина (результат.«беды»)) равен (длина (ведомость.«беды»))
  пусть причина равно (соединить (хвост (разделить ответ по "\t")) по "\t")
  пусть строка равно («Строка исхода» от "?       " и кто и (соединить ["не мерено — ", причина] по ""))
  запись «Ведомость» с «строки» равным (добавить строка к (ведомость.«строки»)) и «беды» равным (ведомость.«беды»)

тотальная функция «Принять ответ цели»
  принимает ведомость: «Ведомость», цель: строка, ожидание: строка, вывод: строка
  возвращает «Ведомость»
  пусть первая равно (соединить («Непустые строки» от вывод) по "\n")
  если «Это отказ смотреть» от первая
    то «Прибавить немеренное» от ведомость и цель и первая
    иначе «Прибавить» от ведомость и цель и ожидание и («Ответы цели» от («Функции») и вывод)

тотальная функция «Итоговая строка»
  принимает ведомость: «Ведомость»
  возвращает строка
  пример «итог называет три числа»
    дано ведомость равно (запись «Ведомость» с «строки» равным ["зелен   c: да", "КРАСЕН  go: нет"] и «беды» равным [])
    ожидается "ИТОГ: участников 2 — зелено 1, красно 1, не мерено 0"
  пусть зелено равно (к строке («Сколько с меткой» от ведомость и "зелен"))
  пусть красно равно (к строке («Сколько с меткой» от ведомость и "КРАСЕН"))
  пусть немерено равно (к строке («Сколько с меткой» от ведомость и "?"))
  пусть всего равно (к строке (длина (ведомость.«строки»)))
  соединить ["ИТОГ: участников ", всего, " — зелено ", зелено, ", красно ", красно, ", не мерено ", немерено] по ""

тотальная функция «Текст ведомости»
  принимает ведомость: «Ведомость»
  возвращает строка
  соединить (добавить («Итоговая строка» от ведомость) к (ведомость.«строки»)) по "\n"

тотальная функция «Приговор»
  принимает ведомость: «Ведомость»
  возвращает «Продолжение»
  пусть текст равно («Текст ведомости» от ведомость)
  разбор (ведомость.«беды»)
    случай пусто
      то вариант «Конец работы» с значение равным текст
    случай голова и хвост
      пусть слова равно (соединить (приписать текст к (ведомость.«беды»)) по "\n\n")
      вариант «Провал» с код равным "FLANG_PROBE_EXACT_ACTIONS" и сообщение равным слова

тотальная функция «Приговор подлогу»
  принимает ведомость: «Ведомость»
  возвращает «Продолжение»
  пусть текст равно («Текст ведомости» от ведомость)
  пусть зелено равно («Сколько с меткой» от ведомость и "зелен")
  пусть красно равно («Сколько с меткой» от ведомость и "КРАСЕН")
  если (зелено равен 0) и притом (красно больше 1)
    то вариант «Конец работы» с значение равным (соединить ["подлог замечен каждым, кто мерился\n", текст] по "")
    иначе
      пусть слова равно (соединить ["подлог прошёл незамеченным\n", текст] по "")
      вариант «Провал» с код равным "FLANG_PROBE_EXACT_ACTIONS_FORGERY" и сообщение равным слова

объект «Сверка»
  «ждали»: строка
  «счёт»: «Ведомость»
  «подлог»: признак

тотальная функция «С ведомостью»
  принимает сверка: «Сверка», ведомость: «Ведомость»
  возвращает «Сверка»
  обеспечивает «ожидание доезжает как есть» (результат.«ждали») равен (сверка.«ждали»)
  запись «Сверка» с «ждали» равным (сверка.«ждали») и «счёт» равным ведомость и «подлог» равным (сверка.«подлог»)

тип «Ход»
  вариант «Начало» содержит подлог: признак
  вариант «Ждём ожидание» содержит подлог: признак
  вариант «Ждём вычислитель» содержит ожидание: строка, подлог: признак
  вариант «Ждём цель» содержит цель: строка, осталось: список строки, сверка: «Сверка»

тотальная функция «Начать»
  возвращает «Ход»
  пример «проба начинается без подлога»
    ожидается вариант «Начало» с подлог равным нет
  вариант «Начало» с подлог равным нет

тотальная функция «Начать с подлога»
  возвращает «Ход»
  пример «подлог начинается со своего начала»
    ожидается вариант «Начало» с подлог равным да
  вариант «Начало» с подлог равным да

тотальная функция «Процесс»
  принимает зов: строка
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", зов]

тотальная функция «Спросить цель»
  принимает цель: строка, осталось: список строки, сверка: «Сверка»
  возвращает «Продолжение»
  пусть потом равно (вариант «Ждём цель» с цель равным цель и осталось равным осталось и сверка равным сверка)
  вариант «Сделать» с поручение равным («Процесс» от («Зов цели» от цель)) и потом равным потом

тотальная функция «Пойти»
  принимает очередь: список строки, сверка: «Сверка»
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      пусть ведомость равно (сверка.«счёт»)
      если (сверка.«подлог») то «Приговор подлогу» от ведомость иначе «Приговор» от ведомость
    случай голова «первая» и хвост «прочие»
      то «Спросить цель» от «первая» и «прочие» и сверка

тотальная функция «Смотреть нечем»
  принимает причина: строка
  возвращает «Продолжение»
  пример «участник, которого не удалось запустить, — не приговор печати»
    дано причина равно "нет sh"
    ожидается вариант «Не проверено» с код равным "FLANG_PROBE_EXACT_ACTIONS_BLIND" и сообщение равным "нет sh"
  вариант «Не проверено» с код равным "FLANG_PROBE_EXACT_ACTIONS_BLIND" и сообщение равным причина

тотальная функция «Вывод процесса»
  принимает отклик: «Отклик»
  возвращает строка
  пример «вывод завершённого процесса доезжает»
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "да" и ошибки равным ""
    ожидается "да"
  пример «иной отклик — пустой вывод»
    дано отклик равно вариант «Пока ничего»
    ожидается ""
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то вывод
    случай любое
      то ""

тотальная функция «Запущен ли»
  принимает отклик: «Отклик»
  возвращает признак
  пример «завершённый процесс запущен»
    дано отклик равно вариант «Процесс завершён» с код равным 1 и вывод равным "" и ошибки равным ""
    ожидается да
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то да
    случай любое
      то нет

тотальная функция «После вычислителя»
  принимает ожидание: строка, подлог: признак, отклик: «Отклик»
  возвращает «Продолжение»
  пусть ответ равно («Ответы вычислителя» от («Функции») и («Вывод процесса» от отклик))
  пусть ведомость равно («Прибавить» от («Пустая ведомость») и "вычислитель" и ожидание и ответ)
  пусть сверка равно (запись «Сверка» с «ждали» равным ожидание и «счёт» равным ведомость и «подлог» равным подлог)
  если «Запущен ли» от отклик
    то «Пойти» от («Цели») и сверка
    иначе «Смотреть нечем» от "вычислитель не запустился"

тотальная функция «После ожидания»
  принимает подлог: признак, отклик: «Отклик»
  возвращает «Продолжение»
  пусть прочитано равно («Ожидание из файла» от («Прочитанное» от отклик))
  пусть ожидание равно (если подлог то («Подлог» от прочитано) иначе прочитано)
  пусть потом равно (вариант «Ждём вычислитель» с ожидание равным ожидание и подлог равным подлог)
  вариант «Сделать» с поручение равным («Процесс» от («Зов вычислителя»)) и потом равным потом

тотальная функция «Прочитанное»
  принимает отклик: «Отклик»
  возвращает строка
  пример «прочитанный файл отдаёт текст»
    дано отклик равно вариант «Прочитано» с содержимое равным "Ф\t1"
    ожидается "Ф\t1"
  разбор отклик
    случай вариант «Прочитано» с содержимое как содержимое
      то содержимое
    случай любое
      то ""

тотальная функция «После цели»
  принимает цель: строка, осталось: список строки, сверка: «Сверка», отклик: «Отклик»
  возвращает «Продолжение»
  пусть вывод равно («Вывод процесса» от отклик)
  пусть ведомость равно («Принять ответ цели» от (сверка.«счёт») и цель и (сверка.«ждали») и вывод)
  если «Запущен ли» от отклик
    то «Пойти» от осталось и («С ведомостью» от сверка и ведомость)
    иначе «Смотреть нечем» от (соединить ["цель «", цель, "» не запустилась"] по "")

тотальная функция «Прочитать ожидание»
  принимает подлог: признак
  возвращает «Продолжение»
  пусть дело равно (вариант «Прочитать файл» с путь равным "expected.tsv")
  вариант «Сделать» с поручение равным дело и потом равным (вариант «Ждём ожидание» с подлог равным подлог)

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Начало» с подлог как подлог
      то «Прочитать ожидание» от подлог
    случай вариант «Ждём ожидание» с подлог как подлог
      то «После ожидания» от подлог и отклик
    случай вариант «Ждём вычислитель» с ожидание как ожидание и подлог как подлог
      то «После вычислителя» от ожидание и подлог и отклик
    случай вариант «Ждём цель» с цель как цель и осталось как осталось и сверка как сверка
      то «После цели» от цель и осталось и сверка и отклик

план «Binary»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»

план «Forgery»
  состояние «Ход»
  начинает с «Начать с подлога»
  обрабатывает «Дальше»
