  пусть глубина_ограничения равно (если ((«Ветвь» от зерно и 9) остаток от 2) равен 0 то 0 иначе 1)
  пусть случайное равно «Условие» от («Ветвь» от зерно и 3) и глубина_ограничения и числа и списки и строки
  пусть ограничение равно «Одно из» от (((«Ветвь» от зерно и 2) остаток от 2) равен 0) и "" и случайное
  пусть глубина равно (если ((«Ветвь» от зерно и 4) остаток от 3) равен 0 то 2 иначе 1)
  пусть высказывание равно «Условие» от («Ветвь» от зерно и 5) и глубина и числа и списки и строки
  «Программы семейства» от "claim" и номер и («Мутанты утверждения» от переменные и ограничение и высказывание)

тотальная функция «Случайная функция»
  принимает мутация: строка, переменные: список «Переменная», предусловие: строка, обещание: строка, тело: строка
  возвращает «Мутант»
  пример «функция без помощников и теоремы»
    дано мутация равно "random"
    дано переменные равно пустой список
    дано предусловие равно ""
    дано обещание равно ""
    дано тело равно "0"
    ожидается запись «Мутант» с «текст» равным """
      модуль «Probe»

      тотальная функция «Ф»
        принимает 
        возвращает число
        0

      """ и «оракул» равным """
      тотальная функция «Ф»
        принимает 
        возвращает число
        0

      функция «Сверить»
        принимает метка: строка
        возвращает строка
        пусть результат равно «Ф»
        если результат равен результат
          то ""
          иначе метка

      функция «Проверить»
        принимает метка: строка
        возвращает строка
        если да и притом да
          то «Сверить» от метка
          иначе ""

      функция «Оракул»
        возвращает строка
        соединить (отфильтровать ([«Проверить» от "нарушено"]) где ответ → не (ответ равен "")) по "; "
      """ и «мутация» равным "random"
  пусть контракт равно «Контракт» от предусловие и "" и обещание
  «Мутант от» от мутация и («Заголовок» от переменные и "число") и контракт и («Код» от "" и "" и тело и "")

тотальная функция «Если отличается»
  принимает прежнее: строка, новое: строка, мутант: «Мутант»
  возвращает список «Мутант»
  пример «одинаковое не порождает мутанта»
    дано прежнее равно "а"
    дано новое равно "а"
    дано мутант равно запись «Мутант» с «мутация» равным "m" и «текст» равным "т" и «оракул» равным "о"
    ожидается пустой список
  если прежнее равен новое
    то пустой список
    иначе [мутант]

тотальная функция «Обещание случайной функции»
  принимает зерно: число, числа: список строки, списки: список строки, строки: список строки
  возвращает строка
  пример «сравнение результата с выражением или условие о нём»
    дано зерно равно 5
    дано числа равно ["а"]
    дано списки равно пустой список
    дано строки равно пустой список
    ожидается "((результат) не меньше (0.5))"
  пусть сравнение равно «Слово по зерну» от зерно и 6 и («Сравнения»)
  пусть правое равно «В скобках» от («Числовое» от («Ветвь» от зерно и 7) и 1 и числа и списки и строки)
  пусть о_результате равно соединить ["(результат) ", сравнение, " ", правое] по ""
  пусть условие равно «Условие» от («Ветвь» от зерно и 8) и 1 и (приписать "результат" к числа) и списки и строки
  «Одно из» от (((«Ветвь» от зерно и 5) остаток от 2) равен 0) и о_результате и условие


тотальная функция «Случайные функции»
  принимает зерно: число, номер: число
  возвращает список «Программа»
  пример «функция и её мутанты»
    дано зерно равно 5
    дано номер равно 1
    ожидается [
      запись «Программа» с «мутант» равным (запись «Мутант» с «текст» равным """
      модуль «Probe»

      тотальная функция «Ф»
        принимает а: число, б: список неотрицательное
        возвращает число
        обеспечивает «обещание» (((длина б)) не меньше (а))
        2

      """ и «оракул» равным """
      тотальная функция «Ф»
        принимает а: число, б: список неотрицательное
        возвращает число
        2

      функция «Сверить»
        принимает метка: строка, а: число, б: список неотрицательное
        возвращает строка
        пусть результат равно «Ф» от а и б
        если (((а) не больше ((длина б))))
          то ""
          иначе метка

      функция «Проверить»
        принимает метка: строка, а: число, б: список неотрицательное
        возвращает строка
        если да и притом да
          то «Сверить» от метка и а и б
          иначе ""

      функция «Оракул»
        возвращает строка
        соединить (отфильтровать (свёртка [
          0, (0 умножить на -1), -1, 0.5, -2.5, 3, 1e308, (1 делить на 0), (-1 делить на 0),
          (0 делить на 0)
          ] начиная с пустой список как собрано и а → свёртка [
          пустой список, [0], [2], [1, 0], [3, 3], [0, 5, 2]
          ] начиная с собрано как собрано и б → добавить («Проверить» от (соединить [
          "нарушено: ", "а=", «Показ число» от а, ", ", "б=", «Показ список» от б
          ] по "") и а и б) к собрано) где ответ → не (ответ равен "")) по "; "
      """ и «мутация» равным "random") и «семейство» равным "function" и «номер» равным 1,
      запись «Программа» с «мутант» равным (запись «Мутант» с «текст» равным """
      модуль «Probe»

      тотальная функция «Ф»
        принимает а: число, б: список неотрицательное
        возвращает число
        обеспечивает «обещание» (((длина б)) не больше (а))
        2

      """ и «оракул» равным """
      тотальная функция «Ф»
        принимает а: число, б: список неотрицательное
        возвращает число
        2

      функция «Сверить»
        принимает метка: строка, а: число, б: список неотрицательное
        возвращает строка
        пусть результат равно «Ф» от а и б
        если ((((длина б)) не больше (а)))
          то ""
          иначе метка

      функция «Проверить»
        принимает метка: строка, а: число, б: список неотрицательное
        возвращает строка
        если да и притом да
          то «Сверить» от метка и а и б
          иначе ""

      функция «Оракул»
        возвращает строка
        соединить (отфильтровать (свёртка [
          0, (0 умножить на -1), -1, 0.5, -2.5, 3, 1e308, (1 делить на 0), (-1 делить на 0),
          (0 делить на 0)
          ] начиная с пустой список как собрано и а → свёртка [
          пустой список, [0], [2], [1, 0], [3, 3], [0, 5, 2]
          ] начиная с собрано как собрано и б → добавить («Проверить» от (соединить [
          "нарушено: ", "а=", «Показ число» от а, ", ", "б=", «Показ список» от б
          ] по "") и а и б) к собрано) где ответ → не (ответ равен "")) по "; "
      """ и «мутация» равным "flip-comparison") и «семейство» равным "function" и «номер» равным 1]
  пусть переменные равно «Случайные переменные» от («Ветвь» от зерно и 1)
  пусть числа равно «Имена вида» от переменные и "число"
  пусть списки равно «Имена вида» от переменные и "список"
  пусть строки равно «Имена вида» от переменные и "строка"
  пусть случайное равно «Условие» от («Ветвь» от зерно и 3) и 0 и числа и списки и строки
  пусть предусловие равно «Одно из» от (((«Ветвь» от зерно и 2) остаток от 3) равен 0) и случайное и ""
  пусть тело равно «Числовое» от («Ветвь» от зерно и 4) и 2 и числа и списки и строки
  пусть обещание равно «Обещание случайной функции» от зерно и числа и списки и строки
  пусть наоборот равно «Перевернуть сравнение» от обещание
  пусть тело_сдвинуто равно «Сдвинуть константу» от тело
  пусть вход_наоборот равно «Перевернуть сравнение» от предусловие
  пусть база равно «Случайная функция» от "random" и переменные и предусловие и обещание и тело
  пусть перевёрнутое равно «Случайная функция» от "flip-comparison" и переменные и предусловие и наоборот и тело
  пусть сдвинутое равно «Случайная функция» от "change-constant" и переменные и предусловие и обещание и тело_сдвинуто
  пусть без_требования равно «Случайная функция» от "drop-precondition" и переменные и "" и обещание и тело
  пусть с_перевёрнутым равно «Случайная функция» от "flip-precondition" и переменные и вход_наоборот и обещание и тело
  пусть мутанты равно [
    «Если отличается» от обещание и наоборот и перевёрнутое,
    «Если отличается» от тело и тело_сдвинуто и сдвинутое,
    «Если отличается» от предусловие и "" и без_требования,
    «Если отличается» от предусловие и вход_наоборот и с_перевёрнутым]
  пусть все равно свёртка мутанты начиная с [база] как собрано и часть → «Склеить» от собрано и часть
  «Программы семейства» от "function" и номер и все

тотальная функция «Знак в»
  принимает текст: строка, позиция: число
  возвращает строка
  пример «знак по номеру с единицы»
    дано текст равно "(а)"
    дано позиция равно 2
    ожидается "а"
  если (позиция не меньше 1) и притом (позиция не больше (длина текст))
    то подстрока текст с позиция по позиция
    иначе ""

тотальная функция «Сдвиг глубины»
  принимает знак: строка, открывающая: строка, закрывающая: строка
  возвращает число
  пример «открывающая углубляет»
    дано знак равно ")"
    дано открывающая равно ")"
    дано закрывающая равно "("
    ожидается 1
  пример «закрывающая поднимает»
    дано знак равно "("
    дано открывающая равно ")"
    дано закрывающая равно "("
    ожидается -1
  («Одно из чисел» от (знак равен открывающая) и 1 и 0) минус («Одно из чисел» от (знак равен закрывающая) и 1 и 0)

тотальная функция «Начало группы»
  принимает текст: строка, позиция: неотрицательное, глубина: число
  возвращает число
  пример «скобка, парная снятой в конце»
    дано текст равно "если (а плюс (б)"
    дано позиция равно 16
    дано глубина равно 1
    ожидается 6
  пусть глубже равно глубина плюс («Сдвиг глубины» от («Знак в» от текст и позиция) и ")" и "(")
  если позиция не больше 0
    то 0
    иначе «Одно из чисел» от (глубже не больше 0) и позиция и («Начало группы» от текст и (позиция минус 1) и глубже)

тотальная функция «Конец группы»
  принимает текст: строка, осталось: неотрицательное, глубина: число
  возвращает число
  пример «скобка, парная снятой в начале»
    дано текст равно "б) плюс (в)"
    дано осталось равно 11
    дано глубина равно 1
    ожидается 2
  пусть позиция равно ((длина текст) минус осталось) плюс 1
  пусть глубже равно глубина плюс («Сдвиг глубины» от («Знак в» от текст и позиция) и "(" и ")")
  если осталось не больше 0
    то (длина текст) плюс 1
    иначе «Одно из чисел» от (глубже не больше 0) и позиция и («Конец группы» от текст и (осталось минус 1) и глубже)

тотальная функция «Кусок»
  принимает текст: строка, с_какого: число, по_какой: число
  возвращает строка
  пример «пустой кусок, когда концы перепутаны»
    дано текст равно "абв"
    дано с_какого равно 3
    дано по_какой равно 2
    ожидается ""
  если (с_какого не больше по_какой) и притом (с_какого не меньше 1) и притом (по_какой не больше (длина текст))
    то подстрока текст с с_какого по по_какой
    иначе ""

тотальная функция «Развернуть первое нестрогое»
  принимает текст: строка
  возвращает строка
  пример «нестрогое больше становится нестрогим меньше с обменом сторон»
    дано текст равно "если ((а плюс 1) не меньше (б)) то 1 иначе 2"
    ожидается "если ((б) не больше (а плюс 1)) то 1 иначе 2"
  пусть части равно разделить текст по ") не меньше ("
  разбор части
    случай пусто
      то текст
    случай голова и хвост
      то если пусто хвост
        то текст
        иначе «Сшить развёрнутое» от голова и (соединить хвост по ") не меньше (")

тотальная функция «Сшить развёрнутое»
  принимает левая: строка, правая: строка
  возвращает строка
  пример «стороны меняются местами»
    дано левая равно "х (а"
    дано правая равно "б) у"
    ожидается "х (б) не больше (а) у"
  пусть начало равно «Начало группы» от левая и (длина левая) и 1
  пусть конец равно «Конец группы» от правая и (длина правая) и 1
  соединить [
    «Кусок» от левая и 1 и начало, «Кусок» от правая и 1 и (конец минус 1), ") не больше (",
    «Кусок» от левая и (начало плюс 1) и (длина левая), «Кусок» от правая и конец и (длина правая)] по ""

тотальная функция «Без нестрогого больше»
  принимает текст: строка
  возвращает строка
  пример «каждое нестрогое больше развёрнуто»
    дано текст равно "((а) не меньше (б)) и притом ((в) не меньше (0))"
    ожидается "((б) не больше (а)) и притом ((0) не больше (в))"
  пусть куски равно разделить текст по ") не меньше ("
  свёртка куски начиная с текст как собрано и кусок → «Развернуть первое нестрогое» от собрано
