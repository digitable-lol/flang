модуль «Falsifier generator»

объект «Переменная»
  «имя»: строка
  «тип»: строка
  «вид»: строка
  «сетка»: список строки

объект «Мутант»
  «мутация»: строка
  «текст»: строка
  «оракул»: строка

объект «Программа»
  «семейство»: строка
  «номер»: число
  «мутант»: «Мутант»

объект «Заголовок»
  «переменные»: список «Переменная»
  «возвращает»: строка

объект «Контракт»
  «требует»: строка
  «квантор»: строка
  «обещание»: строка

объект «Код»
  «ядру»: строка
  «оракулу»: строка
  «тело»: строка
  «теорема»: строка

объект «Замена»
  «что»: строка
  «чем»: строка

объект «Правило»
  «годится»: признак
  «значение»: строка

тип «Форма числа»
  вариант «Имя числа»
  вариант «Литерал»
  вариант «Действие»
  вариант «Выбор»
  вариант «Длина списка»
  вариант «Длина строки»
  вариант «Свёртка суммой»

тип «Форма условия»
  вариант «Сравнение»
  вариант «Отрицание»
  вариант «Конъюнкция»
  вариант «Дизъюнкция»
  вариант «Вхождение»
  вариант «Пустота»
  вариант «Начало строки»
  вариант «Подстрока»

тотальная функция «Перемешать»
  принимает зерно: число
  возвращает число
  пример «зерно ноль даёт не ноль»
    дано зерно равно 0
    ожидается 182605794
  пример «одно и то же зерно даёт одно и то же число»
    дано зерно равно 12345
    ожидается 1740787021
  пусть первое равно (зерно остаток от 2147483646) плюс 1
  пусть второе равно (первое умножить на 48271) остаток от 2147483647
  (второе умножить на 48271) остаток от 2147483647

тотальная функция «Ветвь»
  принимает зерно: число, соль: число
  возвращает число
  пример «разные соли дают разные ветви»
    дано зерно равно 7
    дано соль равно 1
    ожидается 1335963240
  «Перемешать» от (((зерно остаток от 2147483647) умножить на 31) плюс соль)

тотальная функция «Номер выбора»
  принимает зерно: число, сколько: число
  возвращает число
  пример «номер лежит от единицы до числа вариантов»
    дано зерно равно 10
    дано сколько равно 3
    ожидается 2
  если сколько не больше 0
    то 1
    иначе (зерно остаток от сколько) плюс 1

тотальная функция «Выбрать» от «А»
  принимает зерно: число, варианты: список «А», запасное: «А»
  возвращает «А»
  пример «выбор по зерну»
    дано зерно равно 4
    дано варианты равно ["а", "б", "в"]
    дано запасное равно ""
    ожидается "б"
  пример «из пустого берётся запасное»
    дано зерно равно 4
    дано варианты равно пустой список
    дано запасное равно "-"
    ожидается "-"
  разбор варианты
    случай пусто
      то запасное
    случай голова и хвост
      то элемент («Номер выбора» от зерно и (длина варианты)) в варианты

тотальная функция «Выбрать строку»
  принимает зерно: число, варианты: список строки
  возвращает строка
  пример «выбор по зерну»
    дано зерно равно 4
    дано варианты равно ["а", "б", "в"]
    ожидается "б"
  пример «из пустого выбирать нечего»
    дано зерно равно 4
    дано варианты равно пустой список
    ожидается ""
  «Выбрать» от зерно и варианты и ""

тотальная функция «Одно из» от «А»
  принимает условие: признак, если_да: «А», если_нет: «А»
  возвращает «А»
  пример «условие выбирает первое»
    дано условие равно да
    дано если_да равно 1
    дано если_нет равно 2
    ожидается 1
  если условие
    то если_да
    иначе если_нет

тотальная функция «Одно из чисел»
  принимает условие: признак, если_да: число, если_нет: число
  возвращает число
  пример «условие выбирает второе»
    дано условие равно нет
    дано если_да равно 1
    дано если_нет равно 2
    ожидается 2
  если условие
    то если_да
    иначе если_нет

тотальная функция «Первое годное»
  принимает правила: список «Правило», запасное: строка
  возвращает строка
  пример «первое правило, чьё условие верно»
    дано правила равно [
      запись «Правило» с «годится» равным нет и «значение» равным "а",
      запись «Правило» с «годится» равным да и «значение» равным "б",
      запись «Правило» с «годится» равным да и «значение» равным "в"]
    дано запасное равно ""
    ожидается "б"
  пример «ни одно не годится — запасное»
    дано правила равно пустой список
    дано запасное равно "-"
    ожидается "-"
  разбор (отфильтровать правила где кандидат → кандидат.«годится»)
    случай пусто
      то запасное
    случай голова и хвост
      то голова.«значение»

тотальная функция «Заменить первое»
  принимает текст: строка, что: строка, чем: строка
  возвращает строка
  пример «заменено только первое вхождение»
    дано текст равно "а минус б минус в"
    дано что равно "минус"
    дано чем равно "плюс"
    ожидается "а плюс б минус в"
  пример «нет вхождения — текст прежний»
    дано текст равно "а"
    дано что равно "минус"
    дано чем равно "плюс"
    ожидается "а"
  пусть части равно разделить текст по что
  разбор части
    случай пусто
      то текст
    случай голова и хвост
      то если пусто хвост
        то текст
        иначе соединить [голова, чем, соединить хвост по что] по ""

тотальная функция «Сдвинуть строки»
  принимает текст: строка, отступ: строка
  возвращает строка
  пример «каждая строка получает отступ»
    дано текст равно "если а\n  то б"
    дано отступ равно "  "
    ожидается "  если а\n    то б"
  пусть строки равно разделить текст по "\n"
  соединить (отобразить строки как строка → соединить [отступ, строка] по "") по "\n"

тотальная функция «Переменная»
  принимает имя: строка, тип_: строка, вид: строка, сетка: список строки
  возвращает «Переменная»
  пример «поля по порядку»
    дано имя равно "а"
    дано тип_ равно "число"
    дано вид равно "число"
    дано сетка равно ["0"]
    ожидается запись «Переменная» с «сетка» равным [
      "0"] и «имя» равным "а" и «тип» равным "число" и «вид» равным "число"
  запись «Переменная» с «имя» равным имя и «тип» равным тип_ и «вид» равным вид и «сетка» равным сетка

тотальная функция «Натуральная»
  принимает имя: строка
  возвращает «Переменная»
  пример «натуральная переменная знает свою сетку»
    дано имя равно "н"
    ожидается запись «Переменная» с «сетка» равным [
      "0", "1", "2", "3", "7",
      "9007199254740991"] и «имя» равным "н" и «тип» равным "неотрицательное" и «вид» равным "число"
  «Переменная» от имя и "неотрицательное" и "число" и ["0", "1", "2", "3", "7", "9007199254740991"]

тотальная функция «Малая натуральная»
  принимает имя: строка
  возвращает «Переменная»
  пример «сетка малая, рекурсии по ней хватает шагов»
    дано имя равно "н"
    ожидается запись «Переменная» с «сетка» равным [
      "0", "1", "2", "3", "7", "20"] и «имя» равным "н" и «тип» равным "неотрицательное" и «вид» равным "число"
  «Переменная» от имя и "неотрицательное" и "число" и ["0", "1", "2", "3", "7", "20"]

тотальная функция «Целая»
  принимает имя: строка
  возвращает «Переменная»
  пример «целая переменная заходит ниже нуля»
    дано имя равно "ц"
    ожидается запись «Переменная» с «сетка» равным [
      "-9007199254740991", "-2", "-1", "0", "1", "5"] и «имя» равным "ц" и «тип» равным "целое" и «вид» равным "число"
  «Переменная» от имя и "целое" и "число" и ["-9007199254740991", "-2", "-1", "0", "1", "5"]

тотальная функция «Вещественная»
  принимает имя: строка
  возвращает «Переменная»
  пример «вещественная сетка несёт минус ноль, бесконечности и не число»
    дано имя равно "х"
    ожидается запись «Переменная» с «сетка» равным [
      "0", "(0 умножить на -1)", "-1", "0.5", "-2.5", "3", "1e308", "(1 делить на 0)", "(-1 делить на 0)",
      "(0 делить на 0)"] и «имя» равным "х" и «тип» равным "число" и «вид» равным "число"
  «Переменная» от имя и "число" и "число" и [
    "0", "(0 умножить на -1)", "-1", "0.5", "-2.5", "3", "1e308", "(1 делить на 0)", "(-1 делить на 0)",
    "(0 делить на 0)"]

тотальная функция «Список натуральных»
  принимает имя: строка
  возвращает «Переменная»
  пример «сетка списков начинается с пустого»
    дано имя равно "элементы"
    ожидается запись «Переменная» с «сетка» равным [
      "пустой список", "[0]", "[2]", "[1, 0]", "[3, 3]",
      "[0, 5, 2]"] и «имя» равным "элементы" и «тип» равным "список неотрицательное" и «вид» равным "список"
  «Переменная» от имя и "список неотрицательное" и "список" и [
    "пустой список", "[0]", "[2]", "[1, 0]", "[3, 3]", "[0, 5, 2]"]

тотальная функция «Список чисел»
  принимает имя: строка
  возвращает «Переменная»
  пример «в списке чисел есть не число и бесконечность»
    дано имя равно "значения"
    ожидается запись «Переменная» с «сетка» равным [
      "пустой список", "[-1]", "[0.5, -2]", "[(0 делить на 0)]", "[1, (1 делить на 0)]",
      "[(0 умножить на -1)]"] и «имя» равным "значения" и «тип» равным "список числа" и «вид» равным "список"
  «Переменная» от имя и "список числа" и "список" и [
    "пустой список", "[-1]", "[0.5, -2]", "[(0 делить на 0)]", "[1, (1 делить на 0)]", "[(0 умножить на -1)]"]

тотальная функция «Строковая»
  принимает имя: строка
  возвращает «Переменная»
  пример «сетка строк начинается с пустой»
    дано имя равно "слово"
    ожидается запись «Переменная» с «сетка» равным [
      "\"\"", "\"а\"", "\"аб\"", "\"ба\"",
      "\"б\""] и «имя» равным "слово" и «тип» равным "строка" и «вид» равным "строка"
  «Переменная» от имя и "строка" и "строка" и ["\"\"", "\"а\"", "\"аб\"", "\"ба\"", "\"б\""]

тотальная функция «Случайная переменная»
  принимает зерно: число, имя: строка
  возвращает «Переменная»
  пример «зерно выбирает вид переменной»
    дано зерно равно 0
    дано имя равно "а"
    ожидается запись «Переменная» с «сетка» равным [
      "0", "1", "2", "3", "7",
      "9007199254740991"] и «имя» равным "а" и «тип» равным "неотрицательное" и «вид» равным "число"
  пусть числовые равно [«Натуральная» от имя, «Натуральная» от имя, «Целая» от имя, «Вещественная» от имя]
  пусть прочие равно [«Вещественная» от имя, «Список натуральных» от имя, «Список чисел» от имя, «Строковая» от имя]
  «Выбрать» от зерно и («Склеить» от числовые и прочие) и («Натуральная» от "н")

тотальная функция «Имена вида»
  принимает переменные: список «Переменная», вид: строка
  возвращает список строки
  пример «отобраны имена числового вида»
    дано переменные равно [
      запись «Переменная» с «имя» равным "а" и «тип» равным "неотрицательное" и «вид» равным "число" и «сетка» равным [
      ],
      запись «Переменная» с «имя» равным "б" и «тип» равным "строка" и «вид» равным "строка" и «сетка» равным [
      ],
      запись «Переменная» с «имя» равным "в" и «тип» равным "число" и «вид» равным "число" и «сетка» равным [
      ]]
    дано вид равно "число"
    ожидается ["а", "в"]
  пусть свои равно отфильтровать переменные где переменная → (переменная.«вид») равен вид
  отобразить свои как переменная → переменная.«имя»

тотальная функция «Литералы»
  возвращает список строки
  пример «литералы несут границы и дробь»
    ожидается ["0", "1", "2", "3", "-1", "0.5", "9007199254740991"]
  ["0", "1", "2", "3", "-1", "0.5", "9007199254740991"]

тотальная функция «Действия»
  возвращает список строки
  пример «пять действий над числами»
    ожидается ["плюс", "плюс", "минус", "умножить на", "делить на", "остаток от"]
  ["плюс", "плюс", "минус", "умножить на", "делить на", "остаток от"]

тотальная функция «Сравнения»
  возвращает список строки
  пример «пять сравнений»
    ожидается ["больше", "меньше", "не больше", "не меньше", "не меньше", "равен"]
  ["больше", "меньше", "не больше", "не меньше", "не меньше", "равен"]

тотальная функция «Склеить» от «А»
  принимает первый: список «А», второй: список «А»
  возвращает список «А»
  пример «второй список встаёт за первым»
    дано первый равно [1, 2]
    дано второй равно [3]
    ожидается [1, 2, 3]
  свёртка второй начиная с первый как собрано и член → добавить член к собрано

тотальная функция «Обратить» от «А»
  принимает список_: список «А»
  возвращает список «А»
  пример «порядок обратный»
    дано список_ равно [1, 2, 3]
    ожидается [3, 2, 1]
  свёртка список_ начиная с пустой список как собрано и член → приписать член к собрано

тотальная функция «Обратить строки»
  принимает строки: список строки
  возвращает список строки
  пример «порядок обратный»
    дано строки равно ["а", "б"]
    ожидается ["б", "а"]
  «Обратить» от строки

тотальная функция «Если не пусто» от «А»
  принимает имена: список строки, части: список «А»
  возвращает список «А»
  пример «пустые имена — частей нет»
    дано имена равно пустой список
    дано части равно [1]
    ожидается пустой список
  пример «есть имена — части на месте»
    дано имена равно ["а"]
    дано части равно [1]
    ожидается [1]
  если пусто имена
    то пустой список
    иначе части

тотальная функция «Формы числа на глубине»
  принимает списки: список строки, строки: список строки, листом: признак
  возвращает список «Форма числа»
  пример «у листа без списков и строк только имя и литерал»
    дано списки равно пустой список
    дано строки равно пустой список
    дано листом равно да
    ожидается [вариант «Имя числа», вариант «Имя числа», вариант «Литерал»]
  пример «составные формы со свёрткой, когда есть список»
    дано списки равно ["элементы"]
    дано строки равно пустой список
    дано листом равно нет
    ожидается [
      вариант «Имя числа», вариант «Имя числа», вариант «Литерал», вариант «Длина списка», вариант «Действие»,
      вариант «Действие», вариант «Действие», вариант «Выбор», вариант «Свёртка суммой»]
  пусть листья равно [вариант «Имя числа», вариант «Имя числа», вариант «Литерал»]
  пусть со_списками равно «Если не пусто» от списки и [вариант «Длина списка»]
  пусть со_строками равно «Если не пусто» от строки и [вариант «Длина строки»]
  пусть действия равно [вариант «Действие», вариант «Действие», вариант «Действие», вариант «Выбор»]
  пусть свёртки равно «Если не пусто» от списки и [вариант «Свёртка суммой»]
  пусть составные равно «Одно из» от листом и пустой список и («Склеить» от действия и свёртки)
  «Склеить» от («Склеить» от («Склеить» от листья и со_списками) и со_строками) и составные

тотальная функция «Формы условия на глубине»
  принимает списки: список строки, строки: список строки, листом: признак
  возвращает список «Форма условия»
  пример «у листа без списков только сравнение»
    дано списки равно пустой список
    дано строки равно пустой список
    дано листом равно да
    ожидается [вариант «Сравнение», вариант «Сравнение»]
  пример «строки дают начало и подстроку»
    дано списки равно пустой список
    дано строки равно ["слово"]
    дано листом равно да
    ожидается [вариант «Сравнение», вариант «Сравнение», вариант «Начало строки», вариант «Подстрока»]
  пусть сравнения равно [вариант «Сравнение», вариант «Сравнение»]
  пусть со_списками равно «Если не пусто» от списки и [вариант «Вхождение», вариант «Пустота»]
  пусть со_строками равно «Если не пусто» от строки и [вариант «Начало строки», вариант «Подстрока»]
  пусть связки равно [вариант «Отрицание», вариант «Конъюнкция», вариант «Дизъюнкция»]
  пусть составные равно «Одно из» от листом и пустой список и связки
  «Склеить» от («Склеить» от («Склеить» от сравнения и со_списками) и со_строками) и составные

тотальная функция «В скобках»
  принимает текст: строка
  возвращает строка
  пример «скобки вокруг выражения»
    дано текст равно "а плюс 1"
    ожидается "(а плюс 1)"
  соединить ["(", текст, ")"] по ""

тотальная функция «Слово по зерну»
  принимает зерно: число, соль: число, слова: список строки
  возвращает строка
  пример «слово по ветви зерна»
    дано зерно равно 0
    дано соль равно 1
    дано слова равно ["а", "б"]
    ожидается "а"
  «Выбрать строку» от («Ветвь» от зерно и соль) и слова

тотальная функция «Длина по зерну»
  принимает зерно: число, имена: список строки
  возвращает строка
  пример «длина выбранного имени»
    дано зерно равно 0
    дано имена равно ["слово"]
    ожидается "(длина слово)"
  «В скобках» от (соединить ["длина ", «Слово по зерну» от зерно и 2 и имена] по "")

тотальная функция «Числа или литералы»
  принимает числа: список строки
  возвращает список строки
  пример «без имён — литералы»
    дано числа равно пустой список
    ожидается ["0", "1", "2", "3", "-1", "0.5", "9007199254740991"]
  «Одно из» от (пусто числа) и («Литералы») и числа

тотальная функция «Лист по форме»
  принимает форма: «Форма числа», зерно: число, числа: список строки, списки: список строки, строки: список строки
  возвращает строка
  пример «имя числа берётся из имён»
    дано форма равно вариант «Имя числа»
    дано зерно равно 0
    дано числа равно ["а"]
    дано списки равно пустой список
    дано строки равно пустой список
    ожидается "а"
  разбор форма
    случай вариант «Имя числа»
      то «Слово по зерну» от зерно и 1 и («Числа или литералы» от числа)
    случай вариант «Длина списка»
      то «Длина по зерну» от зерно и списки
    случай вариант «Длина строки»
      то «Длина по зерну» от зерно и строки
    случай любое
      то «Слово по зерну» от зерно и 3 и («Литералы»)

тотальная функция «Числовой лист»
  принимает зерно: число, числа: список строки, списки: список строки, строки: список строки
  возвращает строка
  пример «лист без списков — имя или литерал»
    дано зерно равно 0
    дано числа равно ["а"]
    дано списки равно пустой список
    дано строки равно пустой список
    ожидается "а"
  пусть форма равно «Выбрать» от зерно и («Формы числа на глубине» от списки и строки и да) и (вариант «Литерал»)
  «Лист по форме» от форма и зерно и числа и списки и строки

тотальная функция «Числовое»
  принимает зерно: число, глубина: неотрицательное, числа: список строки, списки: список строки, строки: список строки
  возвращает строка
  пример «на нулевой глубине выходит имя или литерал»
    дано зерно равно 0
    дано глубина равно 0
    дано числа равно ["а"]
    дано списки равно пустой список
    дано строки равно пустой список
    ожидается "а"
  пример «на глубине выходит составное выражение»
    дано зерно равно 3
    дано глубина равно 1
    дано числа равно ["а"]
    дано списки равно пустой список
    дано строки равно пустой список
    ожидается "((а) делить на (а))"
  если глубина не больше 0
    то «Числовой лист» от зерно и числа и списки и строки
    иначе «Составное числовое» от зерно и числа и списки и строки и [
      «Числовое» от («Ветвь» от зерно и 4) и (глубина минус 1) и числа и списки и строки,
      «Числовое» от («Ветвь» от зерно и 6) и (глубина минус 1) и числа и списки и строки,
      «Условие» от («Ветвь» от зерно и 7) и (глубина минус 1) и числа и списки и строки,
      «Числовое» от («Ветвь» от зерно и 8) и (глубина минус 1) и числа и списки и строки,
      «Числовое» от («Ветвь» от зерно и 9) и (глубина минус 1) и числа и списки и строки]

тотальная функция «Составное числовое»
  принимает зерно: число, числа: список строки, списки: список строки, строки: список строки, части: список строки
  возвращает строка
  пример «действие над двумя подвыражениями»
    дано зерно равно 3
    дано числа равно ["а"]
    дано списки равно пустой список
    дано строки равно пустой список
    дано части равно ["а", "а", "а больше 0", "а", "а"]
    ожидается "((а) делить на (а))"
  пусть форма равно «Выбрать» от зерно и («Формы числа на глубине» от списки и строки и нет) и (вариант «Литерал»)
  пусть левое равно «В скобках» от (элемент 1 в части)
  пусть правое равно «В скобках» от (элемент 2 в части)
  пусть выбор равно соединить [
    "если ", элемент 3 в части, " то ", «В скобках» от (элемент 4 в части), " иначе ",
    «В скобках» от (элемент 5 в части)] по ""
  пусть начало равно «Слово по зерну» от зерно и 11 и («Литералы»)
  пусть шаг равно «Слово по зерну» от зерно и 12 и ["плюс", "плюс", "умножить на", "минус"]
  пусть список_ равно «Слово по зерну» от зерно и 10 и списки
  разбор форма
    случай вариант «Действие»
      то «В скобках» от (соединить [левое, «Слово по зерну» от зерно и 5 и («Действия»), правое] по " ")
    случай вариант «Выбор»
      то «В скобках» от выбор
    случай вариант «Свёртка суммой»
      то «В скобках» от (соединить [
        "свёртка ", список_, " начиная с ", начало, " как накоплено и член → накоплено ", шаг, " член"] по "")
    случай любое
      то «Лист по форме» от форма и зерно и числа и списки и строки

тотальная функция «Условие без чисел»
  принимает форма: «Форма условия», зерно: число, списки: список строки, строки: список строки
  возвращает строка
  пример «пустота списка»
    дано форма равно вариант «Пустота»
    дано зерно равно 0
    дано списки равно ["элементы"]
    дано строки равно пустой список
    ожидается "(пусто элементы)"
  пусть список_ равно «Слово по зерну» от зерно и 1 и списки
  пусть строка_ равно «Слово по зерну» от зерно и 1 и строки
  разбор форма
    случай вариант «Пустота»
      то «В скобках» от (соединить ["пусто ", список_] по "")
    случай вариант «Начало строки»
      то «В скобках» от (соединить [
        строка_, " начинается с ", «Слово по зерну» от зерно и 3 и ["\"а\"", "\"\"", "\"аб\""]] по "")
    случай вариант «Подстрока»
      то «В скобках» от (соединить [
        строка_, " содержит ", «Слово по зерну» от зерно и 3 и ["\"б\"", "\"\"", "\"ба\""]] по "")
    случай любое
      то ""

тотальная функция «Числа вхождения»
  принимает зерно: число, числа: список строки
  возвращает список строки
  пример «две трети зёрен прячут имена»
    дано зерно равно 0
    дано числа равно ["а"]
    ожидается ["а"]
  «Одно из» от (((«Ветвь» от зерно и 6) остаток от 3) равен 0) и числа и пустой список

тотальная функция «Условие»
  принимает зерно: число, глубина: неотрицательное, числа: список строки, списки: список строки, строки: список строки
  возвращает строка
  пример «на нулевой глубине выходит сравнение листьев»
    дано зерно равно 0
    дано глубина равно 0
    дано числа равно ["а"]
    дано списки равно пустой список
    дано строки равно пустой список
    ожидается "((а) больше (а))"
  пусть числа_вхождения равно «Числа вхождения» от зерно и числа
  если глубина не больше 0
    то «Простое условие» от зерно и числа и списки и строки
    иначе «Составное условие» от зерно и числа и списки и строки и [
      «Числовое» от («Ветвь» от зерно и 2) и (глубина минус 1) и числа_вхождения и пустой список и пустой список,
      «Числовое» от («Ветвь» от зерно и 4) и (глубина минус 1) и числа и списки и строки,
      «Числовое» от («Ветвь» от зерно и 6) и (глубина минус 1) и числа и списки и строки,
      «Условие» от («Ветвь» от зерно и 7) и (глубина минус 1) и числа и списки и строки,
      «Условие» от («Ветвь» от зерно и 8) и (глубина минус 1) и числа и списки и строки,
      «Условие» от («Ветвь» от зерно и 9) и (глубина минус 1) и числа и списки и строки]

тотальная функция «Простое условие»
  принимает зерно: число, числа: список строки, списки: список строки, строки: список строки
  возвращает строка
  пример «сравнение листьев»
    дано зерно равно 0
    дано числа равно ["а"]
    дано списки равно пустой список
    дано строки равно пустой список
    ожидается "((а) больше (а))"
  пусть формы равно «Формы условия на глубине» от списки и строки и да
  пусть форма равно «Выбрать» от зерно и формы и (вариант «Сравнение»)
  пусть числа_вхождения равно «Числа вхождения» от зерно и числа
  пусть элемент_ равно «Числовой лист» от («Ветвь» от зерно и 2) и числа_вхождения и списки и строки
  пусть левое равно «В скобках» от («Числовой лист» от («Ветвь» от зерно и 4) и числа и списки и строки)
  пусть правое равно «В скобках» от («Числовой лист» от («Ветвь» от зерно и 6) и числа и списки и строки)
  разбор форма
    случай вариант «Вхождение»
      то «В скобках» от (соединить [
        «Слово по зерну» от зерно и 1 и списки, " содержит ", «В скобках» от элемент_] по "")
    случай вариант «Сравнение»
      то «В скобках» от (соединить [левое, «Слово по зерну» от зерно и 5 и («Сравнения»), правое] по " ")
    случай любое
      то «Условие без чисел» от форма и зерно и списки и строки

тотальная функция «Составное условие»
  принимает зерно: число, числа: список строки, списки: список строки, строки: список строки, части: список строки
  возвращает строка
  пример «связка двух условий»
    дано зерно равно 1
    дано числа равно ["а"]
    дано списки равно пустой список
    дано строки равно пустой список
    дано части равно ["1", "а", "а", "а больше 0", "а меньше 1", "а равен 0"]
    ожидается "((а) не меньше (а))"
  пусть формы равно «Формы условия на глубине» от списки и строки и нет
  пусть форма равно «Выбрать» от зерно и формы и (вариант «Сравнение»)
  пусть левое равно «В скобках» от (элемент 2 в части)
  пусть правое равно «В скобках» от (элемент 3 в части)
  пусть первое равно элемент 5 в части
  пусть второе равно элемент 6 в части
  разбор форма
    случай вариант «Вхождение»
      то «В скобках» от (соединить [
        «Слово по зерну» от зерно и 1 и списки, " содержит ", «В скобках» от (элемент 1 в части)] по "")
    случай вариант «Отрицание»
      то «В скобках» от (соединить ["не ", элемент 4 в части] по "")
    случай вариант «Конъюнкция»
      то «В скобках» от (соединить [первое, " и притом ", второе] по "")
    случай вариант «Дизъюнкция»
      то «В скобках» от (соединить [первое, " или ", второе] по "")
    случай вариант «Сравнение»
      то «В скобках» от (соединить [левое, «Слово по зерну» от зерно и 5 и («Сравнения»), правое] по " ")
    случай любое
      то «Условие без чисел» от форма и зерно и списки и строки

тотальная функция «Объявления параметров»
  принимает переменные: список «Переменная»
  возвращает строка
  пример «параметры через запятую с типами»
    дано переменные равно [
      запись «Переменная» с «имя» равным "а" и «тип» равным "число" и «вид» равным "число" и «сетка» равным [
      ],
      запись «Переменная» с «имя» равным "б" и «тип» равным "строка" и «вид» равным "строка" и «сетка» равным [
      ]]
    ожидается "а: число, б: строка"
  пусть объявления равно отобразить переменные как п → соединить [п.«имя», ": ", п.«тип»] по ""
  соединить объявления по ", "

тотальная функция «Вызов с доводами»
  принимает имя: строка, доводы: список строки
  возвращает строка
  пример «без доводов — одно имя»
    дано имя равно "«Ф»"
    дано доводы равно пустой список
    ожидается "«Ф»"
  пример «с доводами через и»
    дано имя равно "«Ф»"
    дано доводы равно ["(1)", "(2)"]
    ожидается "«Ф» от (1) и (2)"
  разбор доводы
    случай пусто
      то имя
    случай голова и хвост
      то соединить [имя, " от ", соединить доводы по " и "] по ""

тотальная функция «Или да»
  принимает условие: строка
  возвращает строка
  пример «пустое условие — истина»
    дано условие равно ""
    ожидается "да"
  пример «условие в скобках»
    дано условие равно "а больше 0"
    ожидается "(а больше 0)"
  если условие равен ""
    то "да"
    иначе «В скобках» от условие

тотальная функция «Показ переменной»
  принимает переменная: «Переменная»
  возвращает строка
  пример «показ зовётся по виду переменной»
    дано переменная равно запись «Переменная» с «сетка» равным [
      "0"] и «имя» равным "а" и «тип» равным "число" и «вид» равным "число"
    ожидается "«Показ число» от а"
  соединить ["«Показ ", переменная.«вид», "» от ", переменная.«имя»] по ""

тотальная функция «Строки сетки»
  принимает строки: список строки, член: строка
  возвращает список строки
  пример «элемент дописывается к последней строке, пока она коротка»
    дано строки равно ["0, 1"]
    дано член равно "2"
    ожидается ["0, 1, 2"]
  пример «пустой список строк начинается с элемента»
    дано строки равно пустой список
    дано член равно "2"
    ожидается ["2"]
  разбор строки
    случай пусто
      то [член]
    случай голова и хвост
      то если ((длина голова) плюс (длина член)) меньше 88
        то приписать (соединить [голова, ", ", член] по "") к хвост
        иначе приписать член к строки

тотальная функция «Сетка строками»
  принимает сетка: список строки
  возвращает строка
  пример «короткая сетка помещается в одну строку»
    дано сетка равно ["0", "1"]
    ожидается "0, 1"
  пусть строки равно свёртка сетка начиная с пустой список как собрано и член → «Строки сетки» от собрано и член
  соединить («Обратить строки» от строки) по ",\n    "

тотальная функция «Перебор переменной»
  принимает переменная: «Переменная», начало: строка
  возвращает строка
  пример «свёртка по сетке переменной»
    дано переменная равно запись «Переменная» с «сетка» равным [
      "0", "1"] и «имя» равным "а" и «тип» равным "число" и «вид» равным "число"
    дано начало равно "пустой список"
    ожидается """
      свёртка [
          0, 1
          ] начиная с пустой список как собрано и а → """
  соединить [
    "свёртка [\n    ", «Сетка строками» от (переменная.«сетка»), "\n    ] начиная с ", начало, " как собрано и ",
    переменная.«имя», " → "] по ""

тотальная функция «Переборы»
  принимает переменные: список «Переменная»
  возвращает строка
  пример «первая свёртка начинает с пустого списка»
    дано переменные равно пустой список
    ожидается ""
  пусть переборы равно свёртка переменные начиная с пустой список как собрано и член → «С перебором» от собрано и член
  соединить переборы по ""

тотальная функция «С перебором»
  принимает переборы: список строки, переменная: «Переменная»
  возвращает список строки
  пример «первая свёртка начинает с пустого списка»
    дано переборы равно пустой список
    дано переменная равно запись «Переменная» с «сетка» равным [
      "0"] и «имя» равным "а" и «тип» равным "число" и «вид» равным "число"
    ожидается ["свёртка [\n    0\n    ] начиная с пустой список как собрано и а → "]
  пусть начало равно «Одно из» от (пусто переборы) и "пустой список" и "собрано"
  добавить («Перебор переменной» от переменная и начало) к переборы

тотальная функция «Сборщик оракула»
  принимает переменные: список «Переменная»
  возвращает строка
  пример «перебор сетки вложенными свёртками»
    дано переменные равно [
      запись «Переменная» с «имя» равным "а" и «тип» равным "число" и «вид» равным "число" и «сетка» равным [
      "0", "1"]]
    ожидается """
      функция «Оракул»
        возвращает строка
        соединить (отфильтровать (свёртка [
          0, 1
          ] начиная с пустой список как собрано и а → добавить («Проверить» от (соединить [
          "нарушено: ", "а=", «Показ число» от а
          ] по "") и а) к собрано) где ответ → не (ответ равен "")) по "; "
      """
  пусть метки равно отобразить переменные как переменная → соединить [
    "\"", переменная.«имя», "=\", ", «Показ переменной» от переменная] по ""
  пусть метка равно соединить [
    "(соединить [\n    \"нарушено: \", ", соединить метки по ", \", \", ", "\n    ] по \"\")"] по ""
  пусть имена равно отобразить переменные как переменная → переменная.«имя»
  пусть вызов равно «Вызов с доводами» от "«Проверить»" и (приписать метка к имена)
  пусть перебор равно соединить [«Переборы» от переменные, "добавить (", вызов, ") к собрано"] по ""
  пусть без_переменных равно "[«Проверить» от \"нарушено\"]"
  соединить [
    "функция «Оракул»\n  возвращает строка\n  соединить (отфильтровать (",
    «Одно из» от (пусто переменные) и без_переменных и перебор,
    ") где ответ → не (ответ равен \"\")) по \"; \"\n"] по ""

тотальная функция «Показы»
  возвращает строка
  пример «показы стандартных видов»
    ожидается """
      функция «Показ число»
        принимает х: число
        возвращает строка
        если (х равен 0) и притом ((1 делить на х) меньше 0)
          то "-0"
          иначе к строке х

      функция «Показ список»
        принимает х: список числа
        возвращает строка
        соединить ["[", соединить (отобразить х как э → «Показ число» от э) по ", ", "]"] по ""

      функция «Показ строка»
        принимает х: строка
        возвращает строка
        соединить ["'", х, "'"] по ""

      функция «Показ признак»
        принимает х: признак
        возвращает строка
        если х то "да" иначе "нет"

      """
  """
  функция «Показ число»
    принимает х: число
    возвращает строка
    если (х равен 0) и притом ((1 делить на х) меньше 0)
      то "-0"
      иначе к строке х

  функция «Показ список»
    принимает х: список числа
    возвращает строка
    соединить ["[", соединить (отобразить х как э → «Показ число» от э) по ", ", "]"] по ""

  функция «Показ строка»
    принимает х: строка
    возвращает строка
    соединить ["'", х, "'"] по ""

  функция «Показ признак»
    принимает х: признак
    возвращает строка
    если х то "да" иначе "нет"

  """

тотальная функция «Полный оракул»
  принимает оракул: строка
  возвращает строка
  пример «модуль оракула несёт показы»
    дано оракул равно ""
    ожидается """
      модуль «Oracle»

      функция «Показ число»
        принимает х: число
        возвращает строка
        если (х равен 0) и притом ((1 делить на х) меньше 0)
          то "-0"
          иначе к строке х

      функция «Показ список»
        принимает х: список числа
        возвращает строка
        соединить ["[", соединить (отобразить х как э → «Показ число» от э) по ", ", "]"] по ""

      функция «Показ строка»
        принимает х: строка
        возвращает строка
        соединить ["'", х, "'"] по ""

      функция «Показ признак»
        принимает х: признак
        возвращает строка
        если х то "да" иначе "нет"

      """
  соединить ["модуль «Oracle»\n\n", «Показы», оракул] по ""

тотальная функция «Метка и параметры»
  принимает переменные: список «Переменная»
  возвращает строка
  пример «первым параметром идёт метка»
    дано переменные равно [
      запись «Переменная» с «имя» равным "а" и «тип» равным "число" и «вид» равным "число" и «сетка» равным [
      ]]
    ожидается "метка: строка, а: число"
  если пусто переменные
    то "метка: строка"
    иначе соединить ["метка: строка, ", «Объявления параметров» от переменные] по ""

тотальная функция «Оракул утверждения»
  принимает переменные: список «Переменная», ограничение: строка, высказывание: строка, помощники: строка
  возвращает строка
  пример «утверждение проверяется в каждой точке под ограничением»
    дано переменные равно [
      запись «Переменная» с «имя» равным "а" и «тип» равным "признак" и «вид» равным "признак" и «сетка» равным [
      "да"]]
    дано ограничение равно ""
    дано высказывание равно "а"
    дано помощники равно ""
    ожидается """
      функция «Проверить»
        принимает метка: строка, а: признак
        возвращает строка
        если да и притом (не (а))
          то метка
          иначе ""

      функция «Оракул»
        возвращает строка
        соединить (отфильтровать (свёртка [
          да
          ] начиная с пустой список как собрано и а → добавить («Проверить» от (соединить [
          "нарушено: ", "а=", «Показ признак» от а
          ] по "") и а) к собрано) где ответ → не (ответ равен "")) по "; "
      """
  пусть пропуск равно «Без нестрогого больше» от («Или да» от ограничение)
  соединить [
    помощники, "функция «Проверить»\n  принимает ",
    «Метка и параметры» от переменные, "\n  возвращает строка\n  если ", пропуск, " и притом (не (",
    «Без нестрогого больше» от высказывание, "))\n    то метка\n    иначе \"\"\n\n",
    «Сборщик оракула» от переменные] по ""

тотальная функция «Строка квантора»
  принимает переменная: «Переменная»
  возвращает строка
  пример «квантор с типом»
    дано переменная равно запись «Переменная» с «сетка» равным [
      ] и «имя» равным "а" и «тип» равным "число" и «вид» равным "число"
    ожидается "  для всех а: число"
  соединить ["  для всех ", переменная.«имя», ": ", переменная.«тип»] по ""

тотальная функция «Текст утверждения»
  принимает переменные: список «Переменная», ограничение: строка, высказывание: строка, помощники: строка
  возвращает строка
  пример «утверждение с ограничением на последней строке кванторов»
    дано переменные равно [
      запись «Переменная» с «имя» равным "а" и «тип» равным "неотрицательное" и «вид» равным "число" и «сетка» равным [
      ]]
    дано ограничение равно "а больше 0"
    дано высказывание равно "а не меньше 1"
    дано помощники равно ""
    ожидается """
      модуль «Probe»

      утверждение «утверждение»
        для всех а: неотрицательное таких что а больше 0
        утверждаем а не меньше 1
      """
  пусть кванторы равно отобразить переменные как переменная → «Строка квантора» от переменная
  пусть хвостик равно «Одно из» от (ограничение равен "") и "" и (соединить [" таких что ", ограничение] по "")
  пусть с_ограничением равно «Приставить к последней» от кванторы и хвостик
  соединить [
    "модуль «Probe»\n\n", помощники, "утверждение «утверждение»\n", соединить с_ограничением по "\n",
    "\n  утверждаем ", высказывание, "\n"] по ""

тотальная функция «Приставить к последней»
  принимает строки: список строки, хвостик: строка
  возвращает список строки
  пример «хвостик встаёт в конец последней строки»
    дано строки равно ["а", "б"]
    дано хвостик равно "!"
    ожидается ["а", "б!"]
  разбор («Обратить» от строки)
    случай пусто
      то строки
    случай голова и хвост
      то «Обратить» от (приписать (соединить [голова, хвостик] по "") к хвост)

