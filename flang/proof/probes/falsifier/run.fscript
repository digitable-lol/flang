  возвращает строка
  пример «ядро доказало, оракул нашёл нарушение»
    дано вывод равно """
      kernel=0 proved=1 errors=0 checker=3 oracle=0
      rule=«порядок по построению»
      "нарушено: а=0\""""
    ожидается "false-proof"
  пример «ядро приняло тотальность, оракул упёрся в предел шагов»
    дано вывод равно """
      kernel=3 proved=0 errors=0 checker=- oracle=1
      rule=
      FLANG_RECURSION_LIMIT: функция «Петля» исчерпала лимит шагов"""
    ожидается "accepted-loop"
  пример «ядро доказало, оракул молчит, проверяющая программа называет запись ложью»
    дано вывод равно """
      kernel=0 proved=1 errors=0 checker=1 oracle=0
      rule=«порядок по построению»
      checkmsg=НЕ СОШЛОСЬ: утверждение «…», вывод: шаг N: Д3
      "\""""
    ожидается "checker-calls-it-a-lie"
  пример «ядро отказало — находки нет»
    дано вывод равно "kernel=1 proved=0 errors=1 checker=- oracle=-\nrule=\n"
    ожидается ""
  пусть доказано равно вывод содержит "proved=1"
  пусть без_замечаний равно вывод содержит "errors=0"
  пусть нарушено равно вывод содержит "нарушено:"
  пусть предел равно (вывод содержит "FLANG_RECURSION_LIMIT") или (вывод содержит "лимит шагов")
  пусть петля равно предел или (вывод содержит "oracle=124")
  пусть нарушение равно доказано и притом нарушено
  пусть зацикливание равно (доказано или без_замечаний) и притом петля
  пусть ложь равно доказано и притом (вывод содержит "checker=1")
  «Первое годное» от [
    запись «Правило» с «годится» равным нарушение и «значение» равным "false-proof",
    запись «Правило» с «годится» равным зацикливание и «значение» равным "accepted-loop",
    запись «Правило» с «годится» равным ложь и «значение» равным "checker-calls-it-a-lie"] и ""

тотальная функция «Случайное семейство»
  принимает семейство: строка
  возвращает признак
  пример «утверждения случайны»
    дано семейство равно "claim"
    ожидается да
  пример «шаблон не случаен»
    дано семейство равно "subtraction"
    ожидается нет
  ["claim", "function"] содержит семейство

тотальная функция «Причина»
  принимает программа: «Программа», вид: строка, основание: строка, сверщик: строка
  возвращает строка
  пример «у случайного семейства причина — правило ядра»
    дано программа равно запись «Программа» с «семейство» равным """
      claim""" и «номер» равным 4 и «мутант» равным (запись «Мутант» с «мутация» равным """
      negate""" и «текст» равным "" и «оракул» равным "")
    дано вид равно "false-proof"
    дано основание равно "«порядок по построению»"
    дано сверщик равно ""
    ожидается "claim/false-proof/«порядок по построению»"
  пусть семейство равно программа.«семейство»
  пусть мутация равно программа.«мутант».«мутация»
  пусть от_сверщика равно соединить [вид, "/", сверщик] по ""
  пусть от_правила равно соединить [семейство, "/", вид, "/", основание] по ""
  пусть от_мутации равно соединить [семейство, "/", мутация, "/", вид] по ""
  пусть правила равно [
    запись «Правило» с «годится» равным (вид равен "checker-calls-it-a-lie") и «значение» равным от_сверщика,
    запись «Правило» с «годится» равным («Случайное семейство» от семейство) и «значение» равным от_правила]
  «Первое годное» от правила и от_мутации

тотальная функция «Строка оракула»
  принимает вывод: строка
  возвращает строка
  пример «ответ оракула — строки после третьей»
    дано вывод равно "kernel=0\nrule=\ncheckmsg=\n\"нарушено: а=0\"\n"
    ожидается "\"нарушено: а=0\""
  пусть строки равно «Без головы» от («Без головы» от («Без головы» от (разделить вывод по "\n")))
  соединить (отфильтровать строки где строка → не (строка равен "")) по " "

тотальная функция «Прибавки»
  принимает вывод: строка, база: признак, сторож: признак, сбой: признак
  возвращает список «Счётчик»
  пример «база без замечаний»
    дано вывод равно "kernel=3 proved=0 errors=0 checker=- oracle=0"
    дано база равно да
    дано сторож равно нет
    дано сбой равно нет
    ожидается [
      запись «Счётчик» с «имя» равным "программ" и «значение» равным 1,
      запись «Счётчик» с «имя» равным "мутантов" и «значение» равным 0,
      запись «Счётчик» с «имя» равным "доказано" и «значение» равным 0,
      запись «Счётчик» с «имя» равным "без замечаний" и «значение» равным 1,
      запись «Счётчик» с «имя» равным "отказов ядра" и «значение» равным 0,
      запись «Счётчик» с «имя» равным "сбоев оракула" и «значение» равным 0,
      запись «Счётчик» с «имя» равным "остановлено сторожем" и «значение» равным 0]
  [
    «Счётчик» от "программ" и («Единица» от база),
    «Счётчик» от "мутантов" и («Единица» от (не база)),
    «Счётчик» от "доказано" и («Единица» от (вывод содержит "proved=1")),
    «Счётчик» от "без замечаний" и («Единица» от (вывод содержит "errors=0")),
    «Счётчик» от "отказов ядра" и («Единица» от (вывод содержит "errors=1")),
    «Счётчик» от "сбоев оракула" и («Единица» от сбой),
    «Счётчик» от "остановлено сторожем" и («Единица» от сторож)]

тотальная функция «Учесть»
  принимает учёт: «Учёт», программа: «Программа», вывод: строка
  возвращает «Учёт»
  пример «база без замечаний считается программой»
    дано учёт равно запись «Учёт» с «счётчики» равным [
      запись «Счётчик» с «имя» равным "программ" и «значение» равным 0,
      запись «Счётчик» с «имя» равным "без замечаний" и «значение» равным 0] и «находки» равным пустой список
    дано программа равно запись «Программа» с «семейство» равным """
      claim""" и «номер» равным 4 и «мутант» равным (запись «Мутант» с «мутация» равным """
      random""" и «текст» равным "" и «оракул» равным "")
    дано вывод равно "kernel=3 proved=0 errors=0 checker=- oracle=0\nrule=\n\"\""
    ожидается запись «Учёт» с «счётчики» равным [
      запись «Счётчик» с «имя» равным "программ" и «значение» равным 1,
      запись «Счётчик» с «имя» равным "без замечаний" и «значение» равным 1] и «находки» равным пустой список
  пусть база равно ["random", "base"] содержит (программа.«мутант».«мутация»)
  пусть вид равно «Вид находки» от вывод
  пусть оракул равно «Строка оракула» от вывод
  пусть сторож равно (оракул содержит "FLANG_MEASURE") и притом (вид равен "")
  пусть сбой равно (оракул содержит "FLANG_") и притом (вид равен "") и притом (не сторож)
  пусть прибавки равно «Прибавки» от вывод и база и сторож и сбой
  пусть счётчики равно свёртка прибавки начиная с (учёт.«счётчики») как собрано и п → «Прибавить» от собрано и п
  пусть основание равно «Значение метки» от вывод и "rule="
  пусть отказ равно «Строка метки» от вывод и "checkmsg="
  пусть сверщик равно «Значение метки» от вывод и "checker="
  пусть причина равно «Причина» от программа и вид и основание и отказ
  пусть ответ равно запись «Ответ» с «вид» равным вид и «контрпример» равным оракул и «сверщик» равным сверщик
  пусть находка равно запись «Находка» с «причина» равным причина и «ответ» равным ответ и «программа» равным программа
  пусть находки равно «Одно из» от (вид равен "") и (учёт.«находки») и (добавить находка к (учёт.«находки»))
  запись «Учёт» с «счётчики» равным счётчики и «находки» равным находки

тотальная функция «Команда прогона»
  принимает каталог: строка
  возвращает строка
  пример «ядро, сверщик и оракул одной командой»
    дано каталог равно "/w"
    ожидается """
      export LC_ALL=C.UTF-8 && root=$(cd ../../../.. && pwd) && f=${FLANG_BIN:-$root/bootstrap/flang} &&
        c=$root/flang/proof/checker/сверщик && d='/w' &&
        { [ -x "$c" ] || make -C "$root/flang/proof/checker" >/dev/null 2>&1; } &&
        "$f" check "$d/k.flang" --proof --strict --record "$d/k.rec" > "$d/k.out" 2>&1
      k=$?
      p=0
      if [ $k = 0 ] && grep -q ': ДОКАЗАНО — ' "$d/k.out"; then p=1; fi
      e=0
      if grep -q 'FLANG_' "$d/k.out"; then e=1; fi
      r=$(sed -n '/что высказано/,/принято на веру/p' "$d/k.out" | grep -o 'правил[^ ]* «[^»]*»' | head -1 |
        sed 's/^[^«]*//')
      cc=-
      rm -f "$d/c.out"
      if [ $p = 1 ] || [ $e = 0 ]; then "$c" "$d/k.flang" "$d/k.rec" > "$d/c.out" 2>&1; cc=$?; fi
      cm=$(grep '^НЕ СОШЛОСЬ' "$d/c.out" 2>/dev/null | head -1 |
        sed -e 's/«[^»]*»/«…»/g' -e 's/ — .*//' -e 's/\\b[0-9][0-9]*\\b/N/g')
      o=-
      rm -f "$d/o.out"
      if [ $p = 1 ] || [ $e = 0 ]; then
        timeout 30 "$f" run "$d/o.flang" --function '«Оракул»' --trust --max-steps 150000 --memory-limit 2G \\
          > "$d/o.out" 2>&1
        o=$?
      fi
      echo "kernel=$k proved=$p errors=$e checker=$cc oracle=$o"
      echo "rule=$r"
      echo "checkmsg=$cm"
      if [ -f "$d/o.out" ]; then
        grep -v '^на веру' "$d/o.out" | grep -v 'идёт «' | tail -n 3 | sed 's/; нарушено: .*$/ …/'
      fi
      """
  пусть начало равно """
    export LC_ALL=C.UTF-8 && root=$(cd ../../../.. && pwd) && f=${FLANG_BIN:-$root/bootstrap/flang} &&
      c=$root/flang/proof/checker/сверщик && d='"""
  пусть дальше равно """
    ' &&
      { [ -x "$c" ] || make -C "$root/flang/proof/checker" >/dev/null 2>&1; } &&
      "$f" check "$d/k.flang" --proof --strict --record "$d/k.rec" > "$d/k.out" 2>&1
    k=$?
    p=0
    if [ $k = 0 ] && grep -q ': ДОКАЗАНО — ' "$d/k.out"; then p=1; fi
    e=0
    if grep -q 'FLANG_' "$d/k.out"; then e=1; fi
    r=$(sed -n '/что высказано/,/принято на веру/p' "$d/k.out" | grep -o 'правил[^ ]* «[^»]*»' | head -1 |
      sed 's/^[^«]*//')
    cc=-
    rm -f "$d/c.out"
    if [ $p = 1 ] || [ $e = 0 ]; then "$c" "$d/k.flang" "$d/k.rec" > "$d/c.out" 2>&1; cc=$?; fi
    cm=$(grep '^НЕ СОШЛОСЬ' "$d/c.out" 2>/dev/null | head -1 |
      sed -e 's/«[^»]*»/«…»/g' -e 's/ — .*//' -e 's/\\b[0-9][0-9]*\\b/N/g')
    o=-
    rm -f "$d/o.out"
    if [ $p = 1 ] || [ $e = 0 ]; then
      timeout 30 "$f" run "$d/o.flang" --function '«Оракул»' --trust --max-steps 150000 --memory-limit 2G \\
        > "$d/o.out" 2>&1
      o=$?
    fi
    echo "kernel=$k proved=$p errors=$e checker=$cc oracle=$o"
    echo "rule=$r"
    echo "checkmsg=$cm"
    if [ -f "$d/o.out" ]; then
      grep -v '^на веру' "$d/o.out" | grep -v 'идёт «' | tail -n 3 | sed 's/; нарушено: .*$/ …/'
    fi
    """
  соединить [начало, каталог, дальше] по ""

тотальная функция «Причины»
  принимает находки: список «Находка»
  возвращает список строки
  пример «повторы причины схлопнуты в одну»
    дано находки равно пустой список
    ожидается пустой список
  пусть все равно отобразить находки как находка → находка.«причина»
  свёртка все начиная с пустой список как собрано и причина → «Добавить новую» от собрано и причина

тотальная функция «Добавить новую»
  принимает собрано: список строки, строка: строка
  возвращает список строки
  пример «повтор не добавляется»
    дано собрано равно ["а"]
    дано строка равно "а"
    ожидается ["а"]
  пример «новая встаёт в конец»
    дано собрано равно ["а"]
    дано строка равно "б"
    ожидается ["а", "б"]
  если собрано содержит строка
    то собрано
    иначе добавить строка к собрано

тотальная функция «Первая находка причины»
  принимает находки: список «Находка», причина: строка
  возвращает список «Находка»
  пример «без находок пусто»
    дано находки равно пустой список
    дано причина равно "а"
    ожидается пустой список
  разбор (отфильтровать находки где находка → (находка.«причина») равен причина)
    случай пусто
      то пустой список
    случай голова и хвост
      то [голова]

тотальная функция «Описание находки»
  принимает находка: «Находка»
  возвращает строка
  пример «семейство, мутация, номер, контрпример и ответ сверщика»
    дано находка равно запись «Находка» с «причина» равным "а" и «ответ» равным (запись «Ответ» с «вид» равным """
      false-proof""" и «контрпример» равным "\"нарушено: н=0\"" и «сверщик» равным """
      3""") и «программа» равным (запись «Программа» с «семейство» равным """
      s""" и «номер» равным 1 и «мутант» равным (запись «Мутант» с «мутация» равным "m" и «текст» равным """
      модуль «Probe»""" и «оракул» равным ""))
    ожидается "s/m номер 1, контрпример \"нарушено: н=0\", сверщик 3"
  пусть программа равно находка.«программа»
  соединить [
    программа.«семейство», "/", программа.«мутант».«мутация», " номер ", к строке (программа.«номер»),
    ", контрпример ", находка.«ответ».«контрпример», ", сверщик ", находка.«ответ».«сверщик»] по ""

тотальная функция «Строка причины»
  принимает находки: список «Находка», причина: строка, известные: список строки, подробно: признак
  возвращает строка
  пример «без находок описания нет»
    дано находки равно пустой список
    дано причина равно "а"
    дано известные равно ["а"]
    дано подробно равно нет
    ожидается "известная а — находок 0; первая: "
  пусть свои равно отфильтровать находки где находка → (находка.«причина») равен причина
  пусть первая равно «Первая находка причины» от находки и причина
  пусть описание равно соединить (отобразить первая как находка → «Описание находки» от находка) по ""
  пусть известна равно известные содержит причина
  пусть тексты равно отобразить первая как находка → соединить ["\n", находка.«программа».«мутант».«текст»] по ""
  пусть текст равно «Одно из» от (подробно или (не известна)) и (соединить тексты по "") и ""
  пусть слово равно «Одно из» от известна и "известная " и "НОВАЯ "
  соединить [слово, причина, " — находок ", к строке (длина свои), "; первая: ", описание, текст] по ""

тотальная функция «Сводка»
  принимает работа: «Работа»
  возвращает строка
  пример «пустой учёт»
    дано работа равно запись «Работа» с «среда» равным (запись «Среда» с «каталог» равным """
      /w""" и «настройки» равным (вариант «Проба») и «известные» равным [
      ]) и «учёт» равным (запись «Учёт» с «счётчики» равным пустой список и «находки» равным [
      ]) и «следующий» равным 0 и «очередь» равным пустой список
    ожидается """
      falsifier: зерно 20261001, номера 0…59, программ 0, мутантов 0
        ядро: доказало 0, приняло без замечаний 0, отказало 0
        оракул: не смог 0, сторож меры остановил 0
        причин находок 0, новых 0"""
  пусть среда равно работа.«среда»
  пусть учёт равно работа.«учёт»
  пусть счёт равно учёт.«счётчики»
  пусть причины равно «Причины» от (учёт.«находки»)
  пусть новые равно отфильтровать причины где причина → не ((среда.«известные») содержит причина)
  пусть подробно равно «Подробно» от (среда.«настройки»)
  пусть находки равно учёт.«находки»
  пусть известные равно среда.«известные»
  пусть строки равно отобразить причины как причина → «Строка причины» от находки и причина и известные и подробно
  пусть первый равно «Первый номер» от (среда.«настройки»)
  пусть последний равно («Номер за последним» от (среда.«настройки»)) минус 1
  пусть счётчик равно отобразить («Имена счётчиков») как имя → к строке («Значение счётчика» от счёт и имя)
  пусть заголовок равно соединить [
    "falsifier: зерно ", к строке («Зерно»), ", номера ", к строке первый, "…", к строке последний,
    ", программ ", элемент 1 в счётчик, ", мутантов ", элемент 2 в счётчик] по ""
  пусть ядро равно соединить [
    "  ядро: доказало ", элемент 3 в счётчик, ", приняло без замечаний ", элемент 4 в счётчик,
    ", отказало ", элемент 5 в счётчик] по ""
  пусть оракул равно соединить [
    "  оракул: не смог ", элемент 6 в счётчик, ", сторож меры остановил ", элемент 7 в счётчик] по ""
  пусть итог равно соединить ["  причин находок ", к строке (длина причины), ", новых ", к строке (длина новые)] по ""
  соединить (приписать (соединить [заголовок, ядро, оракул, итог] по "\n") к строки) по "\n  · "

