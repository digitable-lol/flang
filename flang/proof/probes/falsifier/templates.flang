  пусть строки равно отобразить допущения как допущение → соединить ["  дано ", допущение, "\n"] по ""
  соединить [
    "следует «утверждение»\n  дано предмет: «Предмет»\n", соединить строки по "", "  утверждаем ", вывод,
    "\n  по предположению\n"] по ""

тотальная функция «Программа рассуждения»
  принимает мутация: строка, ограничения: список строки, допущения: список строки, вывод: строка
  возвращает «Мутант»
  пример «рассуждение без посылок»
    дано мутация равно "base"
    дано ограничения равно пустой список
    дано допущения равно пустой список
    дано вывод равно "предмет.«грек»"
    ожидается запись «Мутант» с «текст» равным """
      модуль «Probe»

      объект «Предмет»
        «человек»: признак
        «смертен»: признак
        «грек»: признак

      утверждение «утверждение»
        для всех предмет: «Предмет»
        утверждаем предмет.«грек»

      следует «утверждение»
        дано предмет: «Предмет»
        утверждаем предмет.«грек»
        по предположению
      """ и «оракул» равным """
      объект «Предмет»
        «человек»: признак
        «смертен»: признак
        «грек»: признак

      функция «Показ предмет»
        принимает х: «Предмет»
        возвращает строка
        соединить [
          если х.«человек» то "человек" иначе "не человек",
          если х.«смертен» то "смертен" иначе "бессмертен",
          если х.«грек» то "грек" иначе "не грек"] по " "

      функция «Проверить»
        принимает метка: строка, предмет: «Предмет»
        возвращает строка
        если да и притом (не (предмет.«грек»))
          то метка
          иначе ""

      функция «Оракул»
        возвращает строка
        соединить (отфильтровать (свёртка [
          запись «Предмет» с «человек» равным да и «смертен» равным да и «грек» равным да,
          запись «Предмет» с «человек» равным да и «смертен» равным да и «грек» равным нет,
          запись «Предмет» с «человек» равным да и «смертен» равным нет и «грек» равным да,
          запись «Предмет» с «человек» равным да и «смертен» равным нет и «грек» равным нет,
          запись «Предмет» с «человек» равным нет и «смертен» равным да и «грек» равным да,
          запись «Предмет» с «человек» равным нет и «смертен» равным да и «грек» равным нет,
          запись «Предмет» с «человек» равным нет и «смертен» равным нет и «грек» равным да,
          запись «Предмет» с «человек» равным нет и «смертен» равным нет и «грек» равным нет
          ] начиная с пустой список как собрано и предмет → добавить («Проверить» от (соединить [
          "нарушено: ", "предмет=", «Показ предмет» от предмет
          ] по "") и предмет) к собрано) где ответ → не (ответ равен "")) по "; "
      """ и «мутация» равным "base"
  пусть объявление равно «Объявление предмета»
  пусть предмет равно «Переменная» от "предмет" и "«Предмет»" и "предмет" и («Сетка предметов»)
  пусть ограничение равно соединить ограничения по " и притом "
  пусть высказано равно «Текст утверждения» от [предмет] и ограничение и вывод и объявление
  пусть следствие равно «Следствие» от допущения и вывод
  пусть с_теоремой равно не (мутация равен "without-theorem")
  пусть текст равно соединить [высказано, "\n", «Одно из» от с_теоремой и следствие и ""] по ""
  пусть помощники_оракула равно соединить [объявление, «Показ предмета»] по ""
  пусть оракул равно «Оракул утверждения» от [предмет] и ограничение и вывод и помощники_оракула
  «Мутант» от мутация и текст и оракул

