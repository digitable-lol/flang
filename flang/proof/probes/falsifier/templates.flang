тотальная функция «Сдвиг с ограничением»
  принимает порог: строка, с_контрактом: признак
  возвращает строка
  пример «помощник с ограниченным постусловием»
    дано порог равно "2"
    дано с_контрактом равно да
    ожидается """
      тотальная функция «Сдвиг»
        принимает н: число
        возвращает число
        для всех н таких что (н) не меньше (2) обеспечивает «сдвиг не ниже порога» (результат) не меньше (2)
        н

      """
  пусть контракт равно соединить [
    "  для всех н таких что (н) не меньше (", порог, ") обеспечивает «сдвиг не ниже порога» (результат) не меньше (",
    порог, ")\n"] по ""
  соединить [
    "тотальная функция «Сдвиг»\n  принимает н: число\n  возвращает число\n", «Одно из» от с_контрактом и контракт и "",
    "  н\n\n"] по ""

тотальная функция «Программа ограниченного постусловия»
  принимает порог: строка, предусловие: строка, доказательство: строка
  возвращает «Мутант»
  пример «вызов помощника под предусловием»
    дано порог равно "1"
    дано предусловие равно "(н) не меньше (1)"
    дано доказательство равно ""
    ожидается запись «Мутант» с «текст» равным """
      модуль «Probe»

      тотальная функция «Сдвиг»
        принимает н: число
        возвращает число
        для всех н таких что (н) не меньше (1) обеспечивает «сдвиг не ниже порога» (результат) не меньше (1)
        н

      тотальная функция «Ф»
        принимает н: число
        возвращает число
        требует «условие» (н) не меньше (1)
        обеспечивает «обещание» (результат) не меньше (1)
        «Сдвиг» от н

      """ и «оракул» равным """
      тотальная функция «Сдвиг»
        принимает н: число
        возвращает число
        н

      тотальная функция «Ф»
        принимает н: число
        возвращает число
        «Сдвиг» от н

      функция «Сверить»
        принимает метка: строка, н: число
        возвращает строка
        пусть результат равно «Ф» от н
        если ((1) не больше (результат))
          то ""
          иначе метка

      функция «Проверить»
        принимает метка: строка, н: число
        возвращает строка
        если ((1) не больше (н)) и притом да
          то «Сверить» от метка и н
          иначе ""

      функция «Оракул»
        возвращает строка
        соединить (отфильтровать (свёртка [
          0, (0 умножить на -1), -1, 0.5, -2.5, 3, 1e308, (1 делить на 0), (-1 делить на 0),
          (0 делить на 0)
          ] начиная с пустой список как собрано и н → добавить («Проверить» от (соединить [
          "нарушено: ", "н=", «Показ число» от н
          ] по "") и н) к собрано) где ответ → не (ответ равен "")) по "; "
      """ и «мутация» равным ""
  пусть ядру равно «Сдвиг с ограничением» от порог и да
  пусть оракулу равно «Сдвиг с ограничением» от порог и нет
  пусть обещание равно соединить ["(результат) не меньше (", порог, ")"] по ""
  пусть код равно «Код» от ядру и оракулу и "«Сдвиг» от н" и доказательство
  «Функция шаблона» от [«Вещественная» от "н"] и («Контракт» от предусловие и "" и обещание) и код

