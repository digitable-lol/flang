  пусть через_список равно "свёртка [функция «Ф»] начиная с х как накоплено и действие → действие от накоплено"
  [«Назвать» от "base" и база,
    «Назвать» от "direct-loop" и («Программа функции-значения» от "" и "«Ф» от х"),
    «Назвать» от "loop-through-value" и через_значение,
    «Назвать» от "loop-through-partial-application" и частично,
    «Назвать» от "loop-through-two-functions" и через_вторую,
    «Назвать» от "loop-through-list" и («Программа функции-значения» от "" и через_список)]

тотальная функция «Объявление фигуры»
  возвращает строка
  пример «сумма из трёх вариантов»
    ожидается """
      тип «Фигура»
        вариант «Точка»
        вариант «Круг» содержит радиус: неотрицательное
        вариант «Прямоугольник» содержит ширина: неотрицательное, высота: неотрицательное

      """
  """
  тип «Фигура»
    вариант «Точка»
    вариант «Круг» содержит радиус: неотрицательное
    вариант «Прямоугольник» содержит ширина: неотрицательное, высота: неотрицательное

  """

тотальная функция «Показ фигуры»
  возвращает строка
  пример «показ называет вариант»
    ожидается """
      функция «Показ фигура»
        принимает х: «Фигура»
        возвращает строка
        разбор х
          случай вариант «Точка»
            то "точка"
          случай вариант «Круг» с радиус как радиус
            то соединить ["круг ", к строке радиус] по ""
          случай вариант «Прямоугольник» с ширина как ширина и высота как высота
            то соединить ["прямоугольник ", к строке ширина, "×", к строке высота] по ""

      """
  """
  функция «Показ фигура»
    принимает х: «Фигура»
    возвращает строка
    разбор х
      случай вариант «Точка»
        то "точка"
      случай вариант «Круг» с радиус как радиус
        то соединить ["круг ", к строке радиус] по ""
      случай вариант «Прямоугольник» с ширина как ширина и высота как высота
        то соединить ["прямоугольник ", к строке ширина, "×", к строке высота] по ""

  """

тотальная функция «Фигура»
  возвращает «Переменная»
  пример «сетка фигур несёт края»
    ожидается запись «Переменная» с «сетка» равным [
      "вариант «Точка»", "вариант «Круг» с радиус равным 0", "вариант «Круг» с радиус равным 3",
      "вариант «Прямоугольник» с ширина равным 1 и высота равным 2",
      "вариант «Прямоугольник» с ширина равным 2 и высота равным 1",
      """
      вариант «Прямоугольник» с ширина равным 9007199254740991 и высота равным 9007199254740991"""] и «имя» равным """
      фигура""" и «тип» равным "«Фигура»" и «вид» равным "фигура"
  «Переменная» от "фигура" и "«Фигура»" и "фигура" и [
    "вариант «Точка»", "вариант «Круг» с радиус равным 0", "вариант «Круг» с радиус равным 3",
    "вариант «Прямоугольник» с ширина равным 1 и высота равным 2",
    "вариант «Прямоугольник» с ширина равным 2 и высота равным 1",
    "вариант «Прямоугольник» с ширина равным 9007199254740991 и высота равным 9007199254740991"]

тотальная функция «Программа фигуры»
  принимает точка: строка, круг: строка, прямоугольник: строка
  возвращает «Мутант»
  пример «площадь фигуры разбором»
    дано точка равно "0"
    дано круг равно "(радиус) умножить на (радиус)"
    дано прямоугольник равно "(ширина) умножить на (высота)"
    ожидается запись «Мутант» с «текст» равным """
      модуль «Probe»

      тип «Фигура»
        вариант «Точка»
        вариант «Круг» содержит радиус: неотрицательное
        вариант «Прямоугольник» содержит ширина: неотрицательное, высота: неотрицательное

      тотальная функция «Ф»
        принимает фигура: «Фигура»
        возвращает число
        для всех фигура обеспечивает «обещание» (результат) не меньше (0)
        разбор фигура
          случай вариант «Точка»
            то 0
          случай вариант «Круг» с радиус как радиус
            то (радиус) умножить на (радиус)
          случай вариант «Прямоугольник» с ширина как ширина и высота как высота
            то (ширина) умножить на (высота)

      """ и «оракул» равным """
      тип «Фигура»
        вариант «Точка»
        вариант «Круг» содержит радиус: неотрицательное
        вариант «Прямоугольник» содержит ширина: неотрицательное, высота: неотрицательное

      функция «Показ фигура»
        принимает х: «Фигура»
        возвращает строка
        разбор х
          случай вариант «Точка»
            то "точка"
          случай вариант «Круг» с радиус как радиус
            то соединить ["круг ", к строке радиус] по ""
          случай вариант «Прямоугольник» с ширина как ширина и высота как высота
            то соединить ["прямоугольник ", к строке ширина, "×", к строке высота] по ""

      тотальная функция «Ф»
        принимает фигура: «Фигура»
        возвращает число
        разбор фигура
          случай вариант «Точка»
            то 0
          случай вариант «Круг» с радиус как радиус
            то (радиус) умножить на (радиус)
          случай вариант «Прямоугольник» с ширина как ширина и высота как высота
            то (ширина) умножить на (высота)

      функция «Сверить»
        принимает метка: строка, фигура: «Фигура»
        возвращает строка
        пусть результат равно «Ф» от фигура
        если ((0) не больше (результат))
          то ""
          иначе метка

      функция «Проверить»
        принимает метка: строка, фигура: «Фигура»
        возвращает строка
        если да и притом да
          то «Сверить» от метка и фигура
          иначе ""

      функция «Оракул»
        возвращает строка
        соединить (отфильтровать (свёртка [
          вариант «Точка», вариант «Круг» с радиус равным 0, вариант «Круг» с радиус равным 3,
          вариант «Прямоугольник» с ширина равным 1 и высота равным 2,
          вариант «Прямоугольник» с ширина равным 2 и высота равным 1,
          вариант «Прямоугольник» с ширина равным 9007199254740991 и высота равным 9007199254740991
          ] начиная с пустой список как собрано и фигура → добавить («Проверить» от (соединить [
          "нарушено: ", "фигура=", «Показ фигура» от фигура
          ] по "") и фигура) к собрано) где ответ → не (ответ равен "")) по "; "
      """ и «мутация» равным ""
  пусть объявление равно «Объявление фигуры»
  пусть оракулу равно соединить [объявление, «Показ фигуры»] по ""
  пусть тело равно соединить [
    "разбор фигура\n  случай вариант «Точка»\n    то ", точка,
    "\n  случай вариант «Круг» с радиус как радиус\n    то ", круг,
    "\n  случай вариант «Прямоугольник» с ширина как ширина и высота как высота\n    то ", прямоугольник] по ""
  пусть код равно «Код» от объявление и оракулу и тело и ""
  «Функция шаблона» от [«Фигура»] и («Контракт» от "" и "фигура" и "(результат) не меньше (0)") и код

