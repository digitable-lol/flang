    «Назвать» от "weaken-precondition" и («Программа вычитания» от слабее и обещание и "а минус б")]

тотальная функция «Индукция по числу»
  принимает обещание: строка
  возвращает строка
  пример «теорема индукцией по н»
    дано обещание равно "(результат) не меньше (0)"
    ожидается """
      теорема «обещание»
        дано н: неотрицательное
        утверждаем (результат) не меньше (0)
        индукция по н убывает н
          случай любое
            то по предположению
        следовательно доказано
      """
  соединить [
    "теорема «обещание»\n  дано н: неотрицательное\n  утверждаем ", обещание,
    "\n  индукция по н убывает н\n    случай любое\n      то по предположению\n  следовательно доказано\n"] по ""

тотальная функция «Программа рекурсии по числу»
  принимает база: строка, слагаемое: строка, шаг: строка, обещание: строка, доказательство: строка
  возвращает «Мутант»
  пример «сумма до н»
    дано база равно "0"
    дано слагаемое равно "н"
    дано шаг равно "н минус 1"
    дано обещание равно "(результат) не меньше (0)"
    дано доказательство равно ""
    ожидается запись «Мутант» с «текст» равным """
      модуль «Probe»

      тотальная функция «Ф»
        принимает н: неотрицательное
        возвращает число
        для всех н обеспечивает «обещание» (результат) не меньше (0)
        если (н) не больше (0)
          то 0
          иначе (н) плюс («Ф» от (н минус 1))

      """ и «оракул» равным """
      тотальная функция «Ф»
        принимает н: неотрицательное
        возвращает число
        если (н) не больше (0)
          то 0
          иначе (н) плюс («Ф» от (н минус 1))

      функция «Сверить»
        принимает метка: строка, н: неотрицательное
        возвращает строка
        пусть результат равно «Ф» от н
        если ((0) не больше (результат))
          то ""
          иначе метка

      функция «Проверить»
        принимает метка: строка, н: неотрицательное
        возвращает строка
        если да и притом да
          то «Сверить» от метка и н
          иначе ""

      функция «Оракул»
        возвращает строка
        соединить (отфильтровать (свёртка [
          0, 1, 2, 3, 7, 20
          ] начиная с пустой список как собрано и н → добавить («Проверить» от (соединить [
          "нарушено: ", "н=", «Показ число» от н
          ] по "") и н) к собрано) где ответ → не (ответ равен "")) по "; "
      """ и «мутация» равным ""
  пусть тело равно соединить [
    "если (н) не больше (0)\n  то ", база, "\n  иначе (", слагаемое, ") плюс («Ф» от (", шаг, "))"] по ""
  пусть код равно «Код» от "" и "" и тело и доказательство
