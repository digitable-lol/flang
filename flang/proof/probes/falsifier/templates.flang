  разбор имя
    случай "subtraction"
      то «Семейство вычитания» от зерно
    случай "nat-recursion"
      то «Семейство рекурсии по числу» от зерно
    случай "list-recursion"
      то «Семейство рекурсии по списку» от зерно
    случай "restricted-postcondition"
      то «Семейство ограниченного постусловия» от зерно
    случай "theorem-hypothesis"
      то «Семейство гипотезы теоремы» от зерно
    случай "function-value"
      то «Семейство функции-значения» от зерно
    случай "sum-type"
      то «Семейство суммы типов» от зерно
    случай "record"
      то «Семейство записи» от зерно
    случай "record-build"
      то «Семейство построения записи» от зерно
    случай "measure"
      то «Семейство меры» от зерно
    случай "mutual-recursion"
      то «Семейство взаимной рекурсии» от зерно
    случай "call-precondition"
      то «Семейство вызова под предусловием» от зерно
    случай "fold"
      то «Семейство свёртки» от зерно
    случай "proof-structure"
      то «Семейство устройства доказательства» от зерно
    случай "logic"
      то «Семейство рассуждений» от зерно
    случай любое
      то пустой список

