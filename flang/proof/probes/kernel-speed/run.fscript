модуль «Kernel speed gate»
  использует «Lists» только «Соединить списки»
  использует «Inquiry» из "../../../../scripts/inquiry.fscript"

объект «Бюджет»
  «программа»: строка
  «шагов»: число
  «предел»: число

тотальная функция «Бюджеты»
  возвращает список «Бюджет»
  обеспечивает «программ две» (длина результат) равен 2
  [(запись «Бюджет» с «программа» равным "let-parse" и «шагов» равным 125000000 и «предел» равным 500000000),
    (запись «Бюджет» с «программа» равным "xor-weights" и «шагов» равным 60000000 и «предел» равным 240000000)]

тотальная функция «Строка замера»
  принимает б: «Бюджет»
  возвращает строка
  пример «замер зовёт проверку с пределом шагов»
    дано б равно запись «Бюджет» с «программа» равным "p" и «шагов» равным 1 и «предел» равным 4
    ожидается "steps p 4"
  соединить ["steps ", (б.«программа»), " ", (к строке (б.«предел»))] по ""

тотальная функция «Сценарий строками»
  возвращает список строки
  обеспечивает «строк сценария не меньше шести» (длина результат) не меньше 6
  пусть начало равно ["set -u", "F=${FLANG_BIN:-bootstrap/flang}", "P=flang/proof/probes/kernel-speed/programs",
    "R=$(mktemp -d \"${TMPDIR:-/tmp}/kernel-speed.XXXXXX\") || exit 1", "trap 'rm -rf \"$R\"' EXIT", («Замер»)]
  «Соединить списки» от начало и (отобразить («Бюджеты») как б → «Строка замера» от б)

тотальная функция «Замер»
  возвращает строка
  соединить [
    "steps() { FLANG_TICKS_OUT=\"$R/$1.ticks\" $F check --proof \"$P/$1.flang\" --step-limit \"$2\" ",
    ">/dev/null 2>\"$R/$1.err\"; c=$?; s=$(sed -n 's/^шагов всего\\t//p' \"$R/$1.ticks\" 2>/dev/null); ",
    "echo \"$1_code=$c\"; echo \"$1_steps=${s:-0}\"; echo \"$1_cut=$(grep -c FLANG_RECURSION_LIMIT \"$R/$1.err\")\"; }"
  ] по ""

тотальная функция «Сценарий»
  возвращает строка
  обеспечивает «сценарий начинается с set -u» результат начинается с "set -u"
  соединить («Сценарий строками») по "\n"

тотальная функция «Значение строки»
  принимает строка: строка, ключ: строка
  возвращает строка
  пример «значение после знака равенства»
    дано строка равно "xor-weights_steps=640"
    дано ключ равно "xor-weights_steps"
    ожидается "640"
  пример «чужой ключ не даёт ничего»
    дано строка равно "let-parse_steps=5000"
    дано ключ равно "xor-weights_steps"
    ожидается ""
  если строка начинается с (соединить ключ с "=")
    то соединить (хвост (разделить строка по "=")) по "="
    иначе ""

тотальная функция «Значение ключа»
  принимает вывод: строка, ключ: строка
  возвращает строка
  пример «ключ находится среди строк»
    дано вывод равно "a_cut=0\nxor-weights_steps=2\n"
    дано ключ равно "xor-weights_steps"
    ожидается "2"
  пусть строки равно (разделить вывод по "\n")
  свёртка строки начиная с "" как найдено и строка → соединить найдено с («Значение строки» от строка и ключ)

тотальная функция «Число ключа»
  принимает вывод: строка, ключ: строка
  возвращает число
  пример «нет числа — минус единица»
    дано вывод равно "x_steps=\n"
    дано ключ равно "x_steps"
    ожидается -1
  разбор (к числу или беда («Значение ключа» от вывод и ключ))
    случай вариант «Разобрано» с значение как значение
      то значение
    случай вариант «Не разобрано» с код как код и сообщение как сообщение
      то -1

тотальная функция «Беда бюджета»
  принимает вывод: строка, б: «Бюджет», делитель: число
  возвращает строка
  пример «в бюджете беды нет»
    дано вывод равно "p_steps=90\np_cut=0\n"
    дано б равно запись «Бюджет» с «программа» равным "p" и «шагов» равным 100 и «предел» равным 400
    дано делитель равно 1
    ожидается ""
  пример «сверх бюджета — беда»
    дано вывод равно "p_steps=90\np_cut=0\n"
    дано б равно запись «Бюджет» с «программа» равным "p" и «шагов» равным 100 и «предел» равным 400
    дано делитель равно 4
    ожидается "p: шагов 90 при бюджете 25"
  пусть имя равно (б.«программа»)
  пусть шагов равно («Число ключа» от вывод и (соединить имя с "_steps"))
  пусть бюджет равно ((б.«шагов») делить на делитель)
  пусть обрезано равно («Число ключа» от вывод и (соединить имя с "_cut"))
  разбор ((обрезано равен 0) и притом ((шагов больше 0) и притом (шагов не больше бюджет)))
    случай да
      то ""
    случай нет
      то соединить [имя, ": шагов ", (к строке шагов), " при бюджете ", (к строке бюджет)] по ""

тотальная функция «Беды»
  принимает вывод: строка, делитель: число
  возвращает список строки
  отфильтровать (отобразить («Бюджеты») как б → «Беда бюджета» от вывод и б и делитель) где беда → не (пусто беда)

тотальная функция «Отчёт»
  принимает вывод: строка
  возвращает строка
  пример «отчёт называет шаги обеих программ»
    дано вывод равно "let-parse_steps=7\nxor-weights_steps=9\n"
    ожидается "шагов: let-parse 7, xor-weights 9"
  соединить ["шагов: let-parse ", («Значение ключа» от вывод и "let-parse_steps"), ", xor-weights ",
    («Значение ключа» от вывод и "xor-weights_steps")] по ""

тотальная функция «Приговор проверки»
  принимает вывод: строка
  возвращает «Продолжение»
  пусть беды равно («Беды» от вывод и 1)
  разбор беды
    случай пусто
      то вариант «Конец работы» с значение равным (соединить ["скорость ядра в бюджете — ", («Отчёт» от вывод)] по "")
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_KERNEL_SPEED" и сообщение равным (соединить (приписать
        "ЯДРО ЗАМЕДЛИЛОСЬ:" к беды) по "\n  · ")

тотальная функция «Приговор подлога»
  принимает вывод: строка
  возвращает «Продолжение»
  пусть беды равно («Беды» от вывод и 4)
  разбор ((длина беды) равен (длина («Бюджеты»)))
    случай да
      то вариант «Конец работы» с значение равным (соединить ["ПОДЛОГ ПОЙМАН: бюджет вчетверо меньше ",
        "краснеет у обеих программ — ", («Отчёт» от вывод)] по "")
    случай нет
      то вариант «Провал» с код равным "FLANG_KERNEL_SPEED_FORGERY" и сообщение равным (соединить ["ПОДЛОГ НЕ ПОЙМАН: ",
        («Отчёт» от вывод)] по "")

тотальная функция «Ответ стенда»
  принимает ответы: список «Answer», подлог: признак
  возвращает «Продолжение»
  пусть код равно («Exit code of» от "стенд" и ответы)
  пусть вывод равно («Output of» от "стенд" и ответы)
  пусть беда равно (соединить ["замер не прошёл: ", вывод, («Errors of» от "стенд" и ответы)] по "")
  разбор (код равен 0)
    случай нет
      то вариант «Не проверено» с код равным "FLANG_KERNEL_SPEED_UNRUN" и сообщение равным беда
    случай да
      то «Приговор по виду» от вывод и подлог

тотальная функция «Приговор по виду»
  принимает вывод: строка, подлог: признак
  возвращает «Продолжение»
  разбор подлог
    случай да
      то «Приговор подлога» от вывод
    случай нет
      то «Приговор проверки» от вывод

тотальная функция «Начать»
  возвращает «Inquiry»
  «Begin with» от 1

тотальная функция «Ход»
  принимает inquiry: «Inquiry», отклик: «Отклик», подлог: признак
  возвращает «Продолжение»
  пусть ответы равно («Heard» от inquiry и отклик)
  разбор ((inquiry.«stages») больше 0)
    случай да
      то «Ask» от («Run from» от "стенд" и "../../../.." и "sh" и ["-c", («Сценарий»)]) и пустой список и 0 и ответы
    случай нет
      то «Ответ стенда» от ответы и подлог

тотальная функция «Дальше проверки»
  принимает inquiry: «Inquiry», отклик: «Отклик»
  возвращает «Продолжение»
  «Ход» от inquiry и отклик и нет

тотальная функция «Дальше подлога»
  принимает inquiry: «Inquiry», отклик: «Отклик»
  возвращает «Продолжение»
  «Ход» от inquiry и отклик и да

план «Check»
  состояние «Inquiry»
  начинает с «Начать»
  обрабатывает «Дальше проверки»

план «Forgery»
  состояние «Inquiry»
  начинает с «Начать»
  обрабатывает «Дальше подлога»
