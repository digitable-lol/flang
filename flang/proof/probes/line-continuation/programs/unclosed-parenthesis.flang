модуль «Проба переноса: незакрытая скобка»
  использует «Парсер flang» из "../../../../self/parser.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Незакрытая скобка»",
    "",
    "тотальная функция «Сложить»",
    "  принимает а: число, б: число",
    "  возвращает число",
    "  (а плюс б",
    "",
    "тотальная функция «Главная»",
    "  возвращает число",
    "  1"
  ] по "\n"

функция «Строка беды»
  принимает беда: «Диагностика»
  возвращает строка
  соединить [беда.«код», " строка ", (к строке беда.«строка»),
    " столбец ", (к строке беда.«столбец»), ": ", беда.«сообщение»] по ""

функция «Свод»
  возвращает строка
  пусть беды равно «Диагностики разбора» от («Текст программы»)
  пусть дерево равно «Печать разбора исходника» от («Текст программы»)
  пусть признак равно "\"functions\""
  пусть слова равно "дерево есть"
  пусть метка равно соединить [слова, (если дерево содержит признак то ": да" иначе ": нет")] по ""
  если пусто беды
    то соединить ["замечаний 0; ", метка] по ""
    иначе соединить (отобразить беды как беда → «Строка беды» от беда) по "; "
