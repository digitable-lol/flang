модуль «Приговоры ядра о сочетательности монад»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Честный текст»
  возвращает строка
  соединить [
    "модуль «Две честные монады»",
    "",
    "тип «Возможно» от «А»",
    "  вариант «Ничего»",
    "  вариант «Нечто» содержит значение: «А»",
    "",
    "тотальная функция «Обернуть» от «А»",
    "  принимает значение: «А»",
    "  возвращает «Возможно» от «А»",
    "  вариант «Нечто» с значение равным значение",
    "",
    "тотальная функция «Сплющить» от «А»",
    "  принимает вложенное: «Возможно» от («Возможно» от «А»)",
    "  возвращает «Возможно» от «А»",
    "  пример «два слоя дают один»",
    "    дано вложенное равно вариант «Нечто» с значение равным (вариант «Нечто» с значение равным 5)",
    "    ожидается вариант «Нечто» с значение равным 5",
    "  пример «пустой внешний слой»",
    "    дано вложенное равно вариант «Ничего»",
    "    ожидается вариант «Ничего»",
    "  разбор вложенное",
    "    случай вариант «Ничего»",
    "      то вариант «Ничего»",
    "    случай вариант «Нечто» с значение как внутри",
    "      то внутри",
    "",
    "монада «Возможно» от «А»",
    "  возврат «Обернуть»",
    "  соединение «Сплющить»",
    "",
    "тип «Исход» от «Значение»",
    "  вариант «Удалось» содержит итог: «Значение»",
    "  вариант «Сорвалось» содержит причина: строка",
    "",
    "тотальная функция «Удалось» от «Значение»",
    "  принимает итог: «Значение»",
    "  возвращает «Исход» от «Значение»",
    "  пример «Число»",
    "    дано итог равно 5",
    "    ожидается вариант «Удалось» с итог равным 5",
    "  пример «Строка»",
    "    дано итог равно \"готово\"",
    "    ожидается вариант «Удалось» с итог равным \"готово\"",
    "  вариант «Удалось» с итог равным итог",
    "",
    "тотальная функция «Сплющить исход» от «Значение»",
    "  принимает вложенное: «Исход» от («Исход» от «Значение»)",
    "  возвращает «Исход» от «Значение»",
    "  пример «Два успеха дают один»",
    "    дано вложенное равно вариант «Удалось» с итог равным (вариант «Удалось» с итог равным 5)",
    "    ожидается вариант «Удалось» с итог равным 5",
    "  пример «Внешний срыв переживает сплющивание»",
    "    дано вложенное равно вариант «Сорвалось» с причина равным \"нет связи\"",
    "    ожидается вариант «Сорвалось» с причина равным \"нет связи\"",
    "  разбор вложенное",
    "    случай вариант «Сорвалось» с причина как причина",
    "      то вариант «Сорвалось» с причина равным причина",
    "    случай вариант «Удалось» с итог как внутри",
    "      то внутри",
    "",
    "монада «Исход» от «Значение»",
    "  возврат «Удалось»",
    "  соединение «Сплющить исход»"
  ] по "\n"

функция «Текст подлога»
  возвращает строка
  соединить [
    "модуль «Монада исхода с неверным соединением»",
    "",
    "тип «Исход» от «Значение»",
    "  вариант «Удалось» содержит итог: «Значение»",
    "  вариант «Сорвалось» содержит причина: строка",
    "",
    "тотальная функция «Удалось» от «Значение»",
    "  принимает итог: «Значение»",
    "  возвращает «Исход» от «Значение»",
    "  пример «Число»",
    "    дано итог равно 5",
    "    ожидается вариант «Удалось» с итог равным 5",
    "  вариант «Удалось» с итог равным итог",
    "",
    "тотальная функция «Сплющить исход» от «Значение»",
    "  принимает вложенное: «Исход» от («Исход» от «Значение»)",
    "  возвращает «Исход» от «Значение»",
    "  пример «Два успеха дают один»",
    "    дано вложенное равно вариант «Удалось» с итог равным (вариант «Удалось» с итог равным 5)",
    "    ожидается вариант «Удалось» с итог равным 5",
    "  пример «Срыв помечается»",
    "    дано вложенное равно вариант «Сорвалось» с причина равным \"нет связи\"",
    "    ожидается вариант «Сорвалось» с причина равным \"нет связи!\"",
    "  разбор вложенное",
    "    случай вариант «Сорвалось» с причина как причина",
    "      то вариант «Сорвалось» с причина равным (соединить причина с \"!\")",
    "    случай вариант «Удалось» с итог как внутри",
    "      то внутри",
    "",
    "монада «Исход» от «Значение»",
    "  возврат «Удалось»",
    "  соединение «Сплющить исход»"
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/monad-associativity/programs/monad-law-verdicts.flang"

функция «Строки с»
  принимает «текст»: строка, «слово»: строка
  возвращает список строки
  отфильтровать (разделить «текст» по "\n") где «с» → «с» содержит «слово»

функция «Первая или нет»
  принимает «строки»: список строки
  возвращает строка
  разбор «строки»
    случай пусто
      то "нет"
    случай голова «г» и хвост «х»
      то «г»

функция «Свод»
  возвращает строка
  пусть «честно» равно («Проверить исходным компилятором» от («Путь программы») и («Честный текст»))
  пусть «подлог» равно («Проверить исходным компилятором» от («Путь программы») и («Текст подлога»))
  пусть «суд» равно («Судить исходным компилятором» от («Путь программы») и («Текст подлога»))
  пусть «доказано» равно (длина («Строки с» от «честно» и "— ассоциативность связывания» — доказано индукцией"))
  пусть «отказ» равно (длина («Строки с» от «подлог» и "«Исход — ассоциативность связывания» — ядром НЕ доказан"))
  пусть «контрпример» равно («Первая или нет» от («Строки с» от «суд» и "FLANG_MONAD_ASSOC"))
  соединить ["сочетательность монад: доказано ядром ", (к строке «доказано»), " из 2; у неверного соединения ядро ",
      (если «отказ» равен 1 то "отказало" иначе "не отказало"), ", суд: ", «контрпример»] по ""
