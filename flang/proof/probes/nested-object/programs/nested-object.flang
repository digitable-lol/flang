модуль «Проба старого слова: вложен объект»
  использует «Парсер flang» из "../../../../self/parser.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Вложенный»",
    "",
    "объект «Заказ»",
    "  номер является числом",
    "  вложен объект «Адрес»",
    "    город является строкой",
    "",
    "тотальная функция «Номер»",
    "  принимает заказ: «Заказ»",
    "  возвращает число",
    "  заказ.номер"
  ] по "\n"

функция «Строка беды»
  принимает беда: «Диагностика»
  возвращает строка
  соединить [беда.«код», " строка ", (к строке беда.«строка»),
    " столбец ", (к строке беда.«столбец»), ": ", беда.«сообщение»] по ""

функция «Свод»
  возвращает строка
  пусть беды равно «Диагностики разбора» от («Текст программы»)
  если пусто беды
    то "замечаний 0"
    иначе соединить (отобразить беды как беда → «Строка беды» от беда) по "; "
