модуль «Пробы сети хозяина»

использует «Таблица проб» из "../table.fscript"

тотальная функция «Набор по коду»
  принимает имя: строка, код: строка
  возвращает «Набор»
  пример «код слепоты — код набора с хвостом»
    дано имя равно "n"
    дано код равно "C"
    ожидается запись «Набор» с «имя» равным "n" и «код расхождения» равным "C" и «код слепоты» равным "C_CANNOT_LOOK"
  пусть слепота равно соединить [код, "_CANNOT_LOOK"] по ""
  запись «Набор» с «имя» равным имя и «код расхождения» равным код и «код слепоты» равным слепота

тотальная функция «Этот набор»
  возвращает «Набор»
  «Набор по коду» от "network" и "FLANG_PROBE_NETWORK"

тотальная функция «Подлог набора»
  возвращает «Набор»
  «Набор по коду» от "network forgery" и "FLANG_PROBE_NETWORK_FORGERY"

тотальная функция «Ключи пробы»
  возвращает строка
  соединить ["w=$(mktemp -d) && p=$((20000 + $$ % 20000)) && ",
    "openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes -keyout \"$w/root.key\" -out \"$w/root.pem\" ",
    "-subj '/CN=flang probe root' -addext 'basicConstraints=critical,CA:TRUE' ",
    "-addext 'keyUsage=critical,keyCertSign,cRLSign' 2>/dev/null && ",
    "openssl req -newkey rsa:2048 -nodes -keyout \"$w/leaf.key\" -out \"$w/leaf.csr\" ",
    "-subj '/CN=localhost' 2>/dev/null && ",
    "printf 'basicConstraints=CA:FALSE\\nsubjectAltName=DNS:localhost\\nextendedKeyUsage=serverAuth\\n' ",
    "> \"$w/leaf.ext\" && ",
    "openssl x509 -req -in \"$w/leaf.csr\" -CA \"$w/root.pem\" -CAkey \"$w/root.key\" -CAcreateserial -sha256 ",
    "-days 365 -extfile \"$w/leaf.ext\" -out \"$w/leaf.pem\" 2>/dev/null && ",
    "openssl x509 -req -in \"$w/leaf.csr\" -CA \"$w/root.pem\" -CAkey \"$w/root.key\" -CAcreateserial -sha256 ",
    "-not_before 20200101000000Z -not_after 20210101000000Z ",
    "-extfile \"$w/leaf.ext\" -out \"$w/old.pem\" 2>/dev/null && ",
    "openssl req -x509 -newkey rsa:2048 -sha256 -days 365 -nodes -keyout \"$w/rogue.key\" -out \"$w/rogue.pem\" ",
    "-subj '/CN=localhost' -addext 'subjectAltName=DNS:localhost' 2>/dev/null && ",
    "printf 'flang speaks tls itself\\n' > \"$w/page.txt\""] по ""

тотальная функция «Сертификат сценария»
  принимает сценарий: строка
  возвращает строка
  пример «подменённый лист — самоподписанный»
    дано сценарий равно "rogue"
    ожидается "rogue"
  пример «просроченный лист»
    дано сценарий равно "expired"
    ожидается "old"
  пример «прочие сценарии — честный лист»
    дано сценарий равно "honest"
    ожидается "leaf"
  если сценарий равен "rogue"
    то "rogue"
    иначе (если сценарий равен "expired" то "old" иначе "leaf")

тотальная функция «Ключ сценария»
  принимает сценарий: строка
  возвращает строка
  пример «у подменённого листа свой ключ»
    дано сценарий равно "rogue"
    ожидается "rogue"
  пример «у честного и просроченного — ключ листа»
    дано сценарий равно "expired"
    ожидается "leaf"
  если сценарий равен "rogue"
    то "rogue"
    иначе "leaf"

тотальная функция «Имя сценария»
  принимает сценарий: строка
  возвращает строка
  пример «чужое имя — адрес вместо имени из subjectAltName»
    дано сценарий равно "name"
    ожидается "127.0.0.1"
  пример «прочие — имя листа»
    дано сценарий равно "honest"
    ожидается "localhost"
  если сценарий равен "name"
    то "127.0.0.1"
    иначе "localhost"

тотальная функция «Сервер сценария»
  принимает сценарий: строка
  возвращает строка
  соединить ["(cd \"$w\" && exec openssl s_server -accept 127.0.0.1:$p -cert ", («Сертификат сценария» от сценарий),
    ".pem -key ", («Ключ сценария» от сценарий), ".key -WWW -tls1_3 -ciphersuites TLS_AES_128_GCM_SHA256 ",
    "-groups X25519 -naccept 1 > server.log 2>&1 < /dev/null) & s=$!; i=0; ",
    "while ! grep -q ACCEPT \"$w/server.log\" 2>/dev/null && [ $i -lt 100 ]; do i=$((i + 1)); sleep 0.1; done"] по ""

тотальная функция «Запрос сценария»
  принимает сценарий: строка
  возвращает строка
  соединить ["mkdir \"$w/bin\" && PATH=\"$w/bin\" \"$flang\" io ",
    "flang/proof/probes/network/programs/secure-request.fscript ",
    "--на-веру --timeout 20000 --trust-roots \"$w/root.pem\" -- \"https://", («Имя сценария» от сценарий),
    ":$p/page.txt\"; c=$?; kill $s 2>/dev/null; rm -rf \"$w\"; exit $c"] по ""

тотальная функция «Вызов»
  принимает сценарий: строка
  возвращает строка
  пример «датаграммы обходятся без сервера»
    дано сценарий равно "udp"
    ожидается "\"$flang\" io flang/proof/probes/network/programs/datagram-loop.fscript --на-веру --timeout 5000"
  если сценарий равен "udp"
    то "\"$flang\" io flang/proof/probes/network/programs/datagram-loop.fscript --на-веру --timeout 5000"
    иначе соединить ["( ", («Ключи пробы»), " || exit 3; ", («Сервер сценария» от сценарий), "; ",
      («Запрос сценария» от сценарий), " )"] по ""

тотальная функция «Проба из строки»
  принимает части: список строки
  возвращает «Проба»
  пусть пг равно «Поле» от части и 1
  пусть сц равно «Поле» от части и 2
  пусть пм равно «Приметы» от пг и [сц]
  пусть км равно «От корня» от («С меткой» от («Вызов» от сц))
  «Собрать пробу» от пг и пм и км и («Поле» от части и 3) и («Поле» от части и 4)

тотальная функция «Собрать пробу»
  принимает а: строка, б: строка, г: строка, д: строка, е: строка
  возвращает «Проба»
  запись «Проба» с «программа» равным а и «приметы» равным б и «команда» равным г и «код» равным д и «слово» равным е

тотальная функция «Пробы»
  принимает текст: строка
  возвращает список «Проба»
  отобразить («Строки данных» от текст) как части → («Проба из строки» от части)

тотальная функция «Обратный код»
  принимает код: строка
  возвращает строка
  пример «успех подделан в отказ»
    дано код равно "0"
    ожидается "1"
  пример «отказ подделан в успех»
    дано код равно "1"
    ожидается "0"
  если код равен "0"
    то "1"
    иначе "0"

тотальная функция «Подделать»
  принимает проба: «Проба»
  возвращает «Проба»
  пусть кд равно «Обратный код» от (проба.«код»)
  «Собрать пробу» от (проба.«программа») и (проба.«приметы») и (проба.«команда») и кд и (проба.«слово»)

тотальная функция «Подделки»
  принимает текст: строка
  возвращает список «Проба»
  отобразить («Пробы» от текст) как проба → («Подделать» от проба)

тотальная функция «Начать»
  возвращает «Ход»
  пример «план начинается с начала»
    ожидается вариант «Начало»
  вариант «Начало»

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём таблицу»
      то «После таблицы» от («Этот набор») и («Пробы» от («Содержимое» от отклик))
    случай любое
      то «Шаг» от («Этот набор») и ход и отклик

тотальная функция «Приговор подлогу»
  принимает дальше: «Продолжение»
  возвращает «Продолжение»
  пример «подделка прошла — это провал набора, а не удача»
    дано дальше равно вариант «Конец работы» с значение равным "все сошлись"
    ожидается вариант «Провал» с код равным "FLANG_PROBE_NETWORK" и сообщение равным "подлог прошёл: все сошлись"
  разбор дальше
    случай вариант «Провал» с код как код и сообщение как сообщение
      то «Подлог отвергнут» от код и сообщение
    случай вариант «Конец работы» с значение как значение
      пусть слова равно соединить ["подлог прошёл: ", (к строке значение)] по ""
      вариант «Провал» с код равным "FLANG_PROBE_NETWORK" и сообщение равным слова
    случай любое
      то дальше

тотальная функция «Подлог отвергнут»
  принимает код: строка, сообщение: строка
  возвращает «Продолжение»
  пример «каждая подделка разошлась — подлог отвергнут»
    дано код равно "FLANG_PROBE_NETWORK_FORGERY"
    дано сообщение равно "проб 6, разошлось 6"
    ожидается вариант «Конец работы» с значение равным "подлог отвергнут: проб 6, разошлось 6"
  если код равен "FLANG_PROBE_NETWORK_FORGERY"
    то вариант «Конец работы» с значение равным (соединить ["подлог отвергнут: ", сообщение] по "")
    иначе вариант «Провал» с код равным код и сообщение равным сообщение

тотальная функция «Дальше подлога»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём таблицу»
      то «Приговор подлогу» от («После таблицы» от («Подлог набора») и («Подделки» от («Содержимое» от отклик)))
    случай любое
      то «Приговор подлогу» от («Шаг» от («Подлог набора») и ход и отклик)

план «Binary»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»

план «Forgery»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше подлога»
