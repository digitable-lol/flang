модуль «Проба: постусловие под требованием»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Постусловие под требованием»",
    "",
    "тотальная функция «Голова строки»",
    "  принимает текст: строка",
    "  возвращает строка",
    "  требует «текст не пуст» (длина текст) больше 0",
    "  обеспечивает «голова не меняет» результат равен текст",
    "  соединить текст с \"\"",
    "",
    "тотальная функция «Дважды голова»",
    "  принимает текст: строка",
    "  возвращает строка",
    "  требует «текст не пуст снаружи» (длина текст) больше 0",
    "  обеспечивает «дважды голова не меняет» результат равен текст",
    "  «Голова строки» от текст"
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/postcondition-rewrite/programs/with-requires.flang"

функция «Свод»
  возвращает строка
  «Проверить исходным компилятором» от («Путь программы») и («Текст программы»)
