модуль «Пробы случайности хозяина»

использует «Таблица проб» из "../table.fscript"

тотальная функция «Набор по коду»
  принимает имя: строка, код: строка
  возвращает «Набор»
  пример «код слепоты — код набора с хвостом»
    дано имя равно "n"
    дано код равно "C"
    ожидается запись «Набор» с «имя» равным "n" и «код расхождения» равным "C" и «код слепоты» равным "C_CANNOT_LOOK"
  пусть слепота равно соединить [код, "_CANNOT_LOOK"] по ""
  запись «Набор» с «имя» равным имя и «код расхождения» равным код и «код слепоты» равным слепота

тотальная функция «Этот набор»
  возвращает «Набор»
  обеспечивает «набор зовётся randomness» (результат.«имя») равен "randomness"
  «Набор по коду» от "randomness" и "FLANG_PROBE_RANDOMNESS"

тотальная функция «Подлог набора»
  возвращает «Набор»
  обеспечивает «подлог зовётся своим именем» (результат.«имя») равен "randomness forgery"
  «Набор по коду» от "randomness forgery" и "FLANG_PROBE_RANDOMNESS_FORGERY"

тотальная функция «Один прогон»
  принимает программа: строка, ключи: строка
  возвращает строка
  пример «один прогон зовёт двоичный на программу набора с её ключами»
    дано программа равно "o.fscript"
    дано ключи равно "--no-random"
    ожидается "$flang io 'flang/proof/probes/randomness/programs/o.fscript' --на-веру --no-random"
  соединить ["$flang io 'flang/proof/probes/randomness/programs/", программа, "' --на-веру ", ключи] по ""

тотальная функция «Сравнить прогоны»
  принимает вызов: строка
  возвращает строка
  пусть дважды равно соединить ["a=$(", вызов, " 2>&1); b=$(", вызов, " 2>&1); echo \"$a\"; echo \"$b\"; "] по ""
  соединить [дважды, "if [ \"$a\" = \"$b\" ]; then echo 'два прогона совпали'; ",
    "else echo 'два прогона разошлись'; fi"] по ""

тотальная функция «Вызов»
  принимает программа: строка, ключи: строка, прогонов: строка
  возвращает строка
  пример «прогонов один — простой вызов»
    дано программа равно "o.fscript"
    дано ключи равно ""
    дано прогонов равно "1"
    ожидается "$flang io 'flang/proof/probes/randomness/programs/o.fscript' --на-веру "
  если прогонов равен "2"
    то «Сравнить прогоны» от («Один прогон» от программа и ключи)
    иначе «Один прогон» от программа и ключи

тотальная функция «Проба из строки»
  принимает части: список строки
  возвращает «Проба»
  пусть пг равно «Поле» от части и 1
  пусть пм равно «Приметы» от пг и [(«Поле» от части и 2), («Поле» от части и 3)]
  пусть вызов равно «Вызов» от пг и («Ключи» от («Поле» от части и 2)) и («Поле» от части и 3)
  пусть км равно «От корня» от («С меткой» от вызов)
  пусть кд равно «Поле» от части и 4
  пусть сл равно «Поле» от части и 5
  «Собрать пробу» от пг и пм и км и кд и сл

тотальная функция «Собрать пробу»
  принимает а: строка, б: строка, г: строка, д: строка, е: строка
  возвращает «Проба»
  запись «Проба» с «программа» равным а и «приметы» равным б и «команда» равным г и «код» равным д и «слово» равным е

тотальная функция «Пробы»
  принимает текст: строка
  возвращает список «Проба»
  отобразить («Строки данных» от текст) как части → («Проба из строки» от части)

тотальная функция «Обратный код»
  принимает код: строка
  возвращает строка
  пример «успех подделан в отказ»
    дано код равно "0"
    ожидается "1"
  пример «отказ подделан в успех»
    дано код равно "1"
    ожидается "0"
  если код равен "0"
    то "1"
    иначе "0"

тотальная функция «Пары слов»
  возвращает список список строки
  пример «слово двух прогонов подделывается в обратное, в обе стороны»
    ожидается [["два прогона разошлись", "два прогона совпали"],
      ["два прогона совпали", "два прогона разошлись"]]
  [["два прогона разошлись", "два прогона совпали"], ["два прогона совпали", "два прогона разошлись"]]

тотальная функция «Обратное слово»
  принимает слово: строка
  возвращает строка
  пример «разошлись подделано в совпали»
    дано слово равно "два прогона разошлись"
    ожидается "два прогона совпали"
  пример «прочее слово остаётся, подделан код»
    дано слово равно "FLANG_IO_DENIED"
    ожидается "FLANG_IO_DENIED"
  разбор (отфильтровать («Пары слов») где пара → (элемент 1 в пара) равен слово)
    случай пусто
      то слово
    случай голова и хвост
      то элемент 2 в голова

тотальная функция «Подделать»
  принимает проба: «Проба»
  возвращает «Проба»
  пусть кд равно «Обратный код» от (проба.«код»)
  пусть сл равно «Обратное слово» от (проба.«слово»)
  пусть пг равно проба.«программа»
  пусть пм равно проба.«приметы»
  пусть км равно проба.«команда»
  «Собрать пробу» от пг и пм и км и кд и сл

тотальная функция «Подделки»
  принимает текст: строка
  возвращает список «Проба»
  отобразить («Пробы» от текст) как проба → («Подделать» от проба)

тотальная функция «Начать»
  возвращает «Ход»
  пример «план начинается с начала»
    ожидается вариант «Начало»
  вариант «Начало»

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём таблицу»
      то «После таблицы» от («Этот набор») и («Пробы» от («Содержимое» от отклик))
    случай любое
      то «Шаг» от («Этот набор») и ход и отклик

тотальная функция «Приговор подлогу»
  принимает дальше: «Продолжение»
  возвращает «Продолжение»
  пример «подделка прошла — это провал набора, а не удача»
    дано дальше равно вариант «Конец работы» с значение равным "все сошлись"
    ожидается вариант «Провал» с код равным "FLANG_PROBE_RANDOMNESS" и сообщение равным "подлог прошёл: все сошлись"
  разбор дальше
    случай вариант «Провал» с код как код и сообщение как сообщение
      то «Подлог отвергнут» от код и сообщение
    случай вариант «Конец работы» с значение как значение
      пусть слова равно соединить ["подлог прошёл: ", (к строке значение)] по ""
      вариант «Провал» с код равным "FLANG_PROBE_RANDOMNESS" и сообщение равным слова
    случай любое
      то дальше

тотальная функция «Подлог отвергнут»
  принимает код: строка, сообщение: строка
  возвращает «Продолжение»
  пример «каждая подделка разошлась — подлог отвергнут»
    дано код равно "FLANG_PROBE_RANDOMNESS_FORGERY"
    дано сообщение равно "проб 8, разошлось 8"
    ожидается вариант «Конец работы» с значение равным "подлог отвергнут: проб 8, разошлось 8"
  если код равен "FLANG_PROBE_RANDOMNESS_FORGERY"
    то вариант «Конец работы» с значение равным (соединить ["подлог отвергнут: ", сообщение] по "")
    иначе вариант «Провал» с код равным код и сообщение равным сообщение

тотальная функция «Дальше подлога»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём таблицу»
      то «Приговор подлогу» от («После таблицы» от («Подлог набора») и («Подделки» от («Содержимое» от отклик)))
    случай любое
      то «Приговор подлогу» от («Шаг» от («Подлог набора») и ход и отклик)

план «Binary»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»

план «Forgery»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше подлога»
