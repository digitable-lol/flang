модуль «Проба: равенство себе над числом и подделка»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Равен себе: число»",
    "",
    "тотальная функция «Сам себе»",
    "  принимает х: число",
    "  возвращает признак",
    "  обеспечивает «равен себе» результат равен да",
    "  пример «два»",
    "    дано х равно 2",
    "    ожидается да",
    "  х равен х",
    "",
    "тотальная функция «Выбор по себе»",
    "  принимает х: число, а: число, б: число",
    "  возвращает число",
    "  обеспечивает «берёт первое» результат равен а",
    "  пример «два»",
    "    дано х равно 2",
    "    дано а равно 1",
    "    дано б равно 5",
    "    ожидается 1",
    "  если х равен х то а иначе б",
    "",
    "тотальная функция «Подделка»",
    "  принимает х: неотрицательное",
    "  возвращает признак",
    "  обеспечивает «равен следующему» результат равен да",
    "  х равен (х плюс 1)"
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/records-and-arithmetic/programs/equal-to-itself-number.flang"

функция «Свод»
  возвращает строка
  «Проверить исходным компилятором» от («Путь программы») и («Текст программы»)
