модуль «Проба: сужение числа: формы, которые сужают»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Сужение: годное»",
    "",
    "тотальная функция «Перевод»",
    "  принимает значение: число",
    "  возвращает неотрицательное",
    "  пример «сорок»",
    "    дано значение равно 40",
    "    ожидается 40",
    (соединить [
      "  если (значение не меньше 0) и притом ((значение остаток от 1) равно 0) и ",
      "притом (значение не больше 9007199254740991)"
    ] по ""),
    "    то значение",
    "    иначе 0",
    "",
    "тотальная функция «Перевод с краями наоборот»",
    "  принимает значение: число",
    "  возвращает неотрицательное",
    "  пример «семь»",
    "    дано значение равно 7",
    "    ожидается 7",
    (соединить [
      "  если (100 не меньше значение) и притом (0 меньше значение) и притом ((значение ",
      "остаток от 1) равно 0)"
    ] по ""),
    "    то значение",
    "    иначе 0",
    "",
    "тотальная функция «Половина»",
    "  принимает значение: неотрицательное",
    "  возвращает неотрицательное",
    "  пример «половина сорока»",
    "    дано значение равно 40",
    "    ожидается 20",
    "  пример «половина сорока одного»",
    "    дано значение равно 41",
    "    ожидается 20",
    "  (значение минус (значение остаток от 2)) делить на 2"
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/records-and-arithmetic/programs/number-to-natural-forms.flang"

функция «Свод»
  возвращает строка
  «Проверить исходным компилятором» от («Путь программы») и («Текст программы»)
