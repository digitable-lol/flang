модуль «Проба: сужение числа: формы, которые не сужают»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Сужение: подделки»",
    "",
    "тотальная функция «Без целости»",
    "  принимает значение: число",
    "  возвращает неотрицательное",
    "  если (значение не меньше 0) и притом (значение не больше 9007199254740991)",
    "    то значение",
    "    иначе 0",
    "",
    "тотальная функция «Без потолка»",
    "  принимает значение: число",
    "  возвращает неотрицательное",
    "  если (значение не меньше 0) и притом ((значение остаток от 1) равно 0)",
    "    то значение",
    "    иначе 0",
    "",
    "тотальная функция «Ниже нуля»",
    "  принимает значение: число",
    "  возвращает неотрицательное",
    (соединить [
      "  если (значение не меньше -1) и притом ((значение остаток от 1) равно 0) и ",
      "притом (значение не больше 10)"
    ] по ""),
    "    то значение",
    "    иначе 0",
    "",
    "тотальная функция «За потолком»",
    "  принимает значение: число",
    "  возвращает неотрицательное",
    (соединить [
      "  если (значение не меньше 0) и притом ((значение остаток от 1) равно 0) и ",
      "притом (значение не больше 9007199254740992)"
    ] по ""),
    "    то значение",
    "    иначе 0",
    "",
    "тотальная функция «Через или»",
    "  принимает значение: число",
    "  возвращает неотрицательное",
    (соединить [
      "  если (значение не меньше 0) или ((значение остаток от 1) равно 0) и притом ",
      "(значение не больше 10)"
    ] по ""),
    "    то значение",
    "    иначе 0",
    "",
    "тотальная функция «В ветви иначе»",
    "  принимает значение: число",
    "  возвращает неотрицательное",
    (соединить [
      "  если (значение не меньше 0) и притом ((значение остаток от 1) равно 0) и ",
      "притом (значение не больше 10)"
    ] по ""),
    "    то 0",
    "    иначе значение",
    "",
    "тотальная функция «Остаток не тот»",
    "  принимает значение: неотрицательное",
    "  возвращает неотрицательное",
    "  (значение минус (значение остаток от 3)) делить на 2"
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/records-and-arithmetic/programs/number-to-natural-refused.flang"

функция «Свод»
  возвращает строка
  «Проверить исходным компилятором» от («Путь программы») и («Текст программы»)
