модуль «Проба: эта записи и равенство по полям (заявка 374)»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Эта записи»",
    "",
    "объект «Пара»",
    "  «а»: признак",
    "  «б»: признак",
    "",
    "утверждение «конгруэнция построенных»",
    "  для всех х: признак",
    "  для всех ю: признак",
    (соединить [
      "  утверждаем (запись «Пара» с а равным (х и притом ю) и б равным х) равно ",
      "(запись «Пара» с а равным (ю и притом х) и б равным х)"
    ] по ""),
    "",
    "утверждение «эта записи»",
    "  для всех п: «Пара»",
    "  утверждаем (запись «Пара» с а равным п.а и б равным п.б) равно п",
    "",
    "утверждение «равенство по полям»",
    "  для всех п: «Пара»",
    "  для всех д: «Пара»",
    "  утверждаем (если (п.а равно д.а) и притом (п.б равно д.б) то п равно д иначе да)"
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/records-and-arithmetic/programs/record-eta.flang"

функция «Свод»
  возвращает строка
  «Проверить исходным компилятором» от («Путь программы») и («Текст программы»)
