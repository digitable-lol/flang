модуль «Проба: записи из двух и трёх полей (заявка 375)»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Три поля»",
    "",
    "объект «Два»",
    "  «а»: признак",
    "  «б»: признак",
    "",
    "объект «Три»",
    "  «а»: признак",
    "  «б»: признак",
    "  «в»: признак",
    "",
    "утверждение «три равенства конъюнкцией»",
    "  для всех х1: признак",
    "  для всех ю1: признак",
    "  для всех х2: признак",
    "  для всех ю2: признак",
    "  для всех х3: признак",
    "  для всех ю3: признак",
    (соединить [
      "  утверждаем ((х1 и притом ю1) равно (ю1 и притом х1)) и притом ((х2 и притом ",
      "ю2) равно (ю2 и притом х2)) и притом ((х3 и притом ю3) равно (ю3 и притом х3))"
    ] по ""),
    "",
    "утверждение «два поля записью»",
    "  для всех х1: признак",
    "  для всех ю1: признак",
    "  для всех х2: признак",
    "  для всех ю2: признак",
    (соединить [
      "  утверждаем (запись «Два» с а равным (х1 и притом ю1) и б равным (х2 и притом ",
      "ю2)) равно (запись «Два» с а равным (ю1 и притом х1) и б равным (ю2 и притом ",
      "х2))"
    ] по ""),
    "",
    "утверждение «три поля записью»",
    "  для всех х1: признак",
    "  для всех ю1: признак",
    "  для всех х2: признак",
    "  для всех ю2: признак",
    "  для всех х3: признак",
    "  для всех ю3: признак",
    (соединить [
      "  утверждаем (запись «Три» с а равным (х1 и притом ю1) и б равным (х2 и притом ",
      "ю2) и в равным (х3 и притом ю3)) равно (запись «Три» с а равным (ю1 и притом х1) ",
      "и б равным (ю2 и притом х2) и в равным (ю3 и притом х3))"
    ] по "")
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/records-and-arithmetic/programs/record-fields.flang"

функция «Свод»
  возвращает строка
  «Проверить исходным компилятором» от («Путь программы») и («Текст программы»)
