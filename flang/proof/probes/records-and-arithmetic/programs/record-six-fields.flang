модуль «Проба: запись из шести полей и подделка»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Поля 6»",
    "",
    "объект «З»",
    "  «а»: признак",
    "  «б»: признак",
    "  «в»: признак",
    "  «г»: признак",
    "  «д»: признак",
    "  «е»: признак",
    "",
    "утверждение «перестановка»",
    "  для всех х1: признак",
    "  для всех ю1: признак",
    "  для всех х2: признак",
    "  для всех ю2: признак",
    "  для всех х3: признак",
    "  для всех ю3: признак",
    "  для всех х4: признак",
    "  для всех ю4: признак",
    "  для всех х5: признак",
    "  для всех ю5: признак",
    "  для всех х6: признак",
    "  для всех ю6: признак",
    (соединить [
      "  утверждаем (запись «З» с а равным (х1 и притом ю1) и б равным (х2 и притом ю2) ",
      "и в равным (х3 и притом ю3) и г равным (х4 и притом ю4) и д равным (х5 и притом ",
      "ю5) и е равным (х6 и притом ю6)) равно (запись «З» с а равным (ю1 и притом х1) и ",
      "б равным (ю2 и притом х2) и в равным (ю3 и притом х3) и г равным (ю4 и притом ",
      "х4) и д равным (ю5 и притом х5) и е равным (ю6 и притом х6))"
    ] по ""),
    "",
    "утверждение «подделка: одно поле с другим знаком»",
    "  для всех х1: признак",
    "  для всех ю1: признак",
    "  для всех х2: признак",
    "  для всех ю2: признак",
    "  для всех х3: признак",
    "  для всех ю3: признак",
    "  для всех х4: признак",
    "  для всех ю4: признак",
    "  для всех х5: признак",
    "  для всех ю5: признак",
    "  для всех х6: признак",
    "  для всех ю6: признак",
    (соединить [
      "  утверждаем (запись «З» с а равным (х1 и притом ю1) и б равным (х2 и притом ю2) ",
      "и в равным (х3 и притом ю3) и г равным (х4 и притом ю4) и д равным (х5 и притом ",
      "ю5) и е равным (х6 и притом ю6)) равно (запись «З» с а равным (ю1 и притом х1) и ",
      "б равным (ю2 и притом х2) и в равным (ю3 и притом х3) и г равным (ю4 и притом ",
      "х4) и д равным (ю5 и притом х5) и е равным (ю6 или х6))"
    ] по "")
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/records-and-arithmetic/programs/record-six-fields.flang"

функция «Свод»
  возвращает строка
  «Проверить исходным компилятором» от («Путь программы») и («Текст программы»)
