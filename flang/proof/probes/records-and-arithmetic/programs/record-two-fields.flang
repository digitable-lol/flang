модуль «Проба: запись из двух полей и подделка»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Поля 2»",
    "",
    "объект «З»",
    "  «а»: признак",
    "  «б»: признак",
    "",
    "утверждение «перестановка»",
    "  для всех х1: признак",
    "  для всех ю1: признак",
    "  для всех х2: признак",
    "  для всех ю2: признак",
    (соединить [
      "  утверждаем (запись «З» с а равным (х1 и притом ю1) и б равным (х2 и притом ",
      "ю2)) равно (запись «З» с а равным (ю1 и притом х1) и б равным (ю2 и притом х2))"
    ] по ""),
    "",
    "утверждение «подделка: одно поле с другим знаком»",
    "  для всех х1: признак",
    "  для всех ю1: признак",
    "  для всех х2: признак",
    "  для всех ю2: признак",
    (соединить [
      "  утверждаем (запись «З» с а равным (х1 и притом ю1) и б равным (х2 и притом ",
      "ю2)) равно (запись «З» с а равным (ю1 и притом х1) и б равным (ю2 или х2))"
    ] по "")
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/records-and-arithmetic/programs/record-two-fields.flang"

функция «Свод»
  возвращает строка
  «Проверить исходным компилятором» от («Путь программы») и («Текст программы»)
