модуль «Проба: кольцо под остатком и подделки»
  использует «Check with source compiler» из "../../../../self/bootstrap/check-with-source-compiler.flang"

функция «Текст программы»
  возвращает строка
  соединить [
    "модуль «Кольцо под остатком»",
    "",
    "утверждение «без остатка»",
    "  для всех а: точное целое",
    "  для всех б: точное целое",
    "  утверждаем (а плюс б) равно (б плюс а)",
    "",
    "утверждение «под остатком»",
    "  для всех а: точное целое",
    "  для всех б: точное целое",
    "  для всех м: точное целое",
    "  утверждаем ((а плюс б) остаток от м) равно ((б плюс а) остаток от м)",
    "",
    "утверждение «под умножением»",
    "  для всех а: точное целое",
    "  для всех б: точное целое",
    "  для всех м: точное целое",
    "  утверждаем ((а плюс б) умножить на м) равно ((б плюс а) умножить на м)",
    "",
    "утверждение «подделка под остатком»",
    "  для всех а: точное целое",
    "  для всех б: точное целое",
    "  для всех м: точное целое",
    "  утверждаем ((а плюс б) остаток от м) равно ((а плюс б плюс «Один») остаток от м)",
    "",
    "утверждение «подделка цепочкой»",
    "  для всех а: точное целое",
    "  для всех б: точное целое",
    "  для всех м: точное целое",
    "  утверждаем (а умножить на б остаток от м) равно (б умножить на (а остаток от м))",
    "",
    "утверждение «вложенный остаток»",
    "  для всех а: точное целое",
    "  для всех б: точное целое",
    "  для всех м: точное целое",
    (соединить [
      "  утверждаем (((а умножить на б) остаток от (м плюс а)) плюс «Один») равно ",
      "(«Один» плюс ((б умножить на а) остаток от (а плюс м)))"
    ] по ""),
    "",
    "тотальная функция «Один»",
    "  возвращает точное целое",
    "  [1]"
  ] по "\n"

функция «Путь программы»
  возвращает строка
  "flang/proof/probes/records-and-arithmetic/programs/ring-under-remainder-refused.flang"

функция «Свод»
  возвращает строка
  «Проверить исходным компилятором» от («Путь программы») и («Текст программы»)
