модуль «Runs not executed probes»

объект «Шаг»
  «зачем»: строка
  «команда»: строка
  «ждём»: число
  «слово»: строка

тотальная функция «Образец каталога»
  возвращает строка
  пример «каталог заводится во временном, а не в дереве»
    ожидается "/tmp/probes-runs-not-executed-"
  "/tmp/probes-runs-not-executed-"

тотальная функция «Из корня»
  возвращает строка
  пример «команды идут из корня дерева, а не из каталога плана»
    ожидается "cd ../../../.. && "
  "cd ../../../.. && "

тотальная функция «Ключи сборки»
  возвращает список строки
  пример «ключи те же, что у семени, кроме -flto и -O2»
    ожидается ["-std=c99", "-Wall", "-Wextra", "-Werror", "-pedantic", "-O0",
               "-DFL_PROGRAM_CALL=compiler_flang_call", "-DFL_PROGRAM_ENTRY=compiler_flang_entry",
               "-Ibootstrap"]
  ["-std=c99", "-Wall", "-Wextra", "-Werror", "-pedantic", "-O0",
   "-DFL_PROGRAM_CALL=compiler_flang_call", "-DFL_PROGRAM_ENTRY=compiler_flang_entry",
   "-Ibootstrap"]

тотальная функция «Исходники сборки»
  возвращает список строки
  пример «оболочка из дерева, остальные три файла из семени»
    ожидается ["flang/src/emit/c/flang_repl.c", "bootstrap/flang_cli.c",
               "bootstrap/flang_runtime.c", "bootstrap/compiler_flang.c"]
  ["flang/src/emit/c/flang_repl.c", "bootstrap/flang_cli.c",
   "bootstrap/flang_runtime.c", "bootstrap/compiler_flang.c"]

тотальная функция «Сборка»
  принимает каталог: строка
  возвращает строка
  соединить [(«Из корня»), "cc ", (соединить («Ключи сборки») по " "), " -o ", каталог,
             "/flang ", (соединить («Исходники сборки») по " "), " -lm -lpthread 2>&1"] по ""

тотальная функция «Вызов»
  принимает каталог: строка, программа: строка
  возвращает строка
  соединить [(«Из корня»), каталог, "/flang test flang/proof/probes/runs-not-executed/programs/",
             программа, " 2>&1"] по ""

тотальная функция «Уборка»
  принимает каталог: строка
  возвращает строка
  соединить [(«Из корня»), "rm -rf ", каталог] по ""

тотальная функция «Настройка»
  принимает команда: строка
  возвращает «Шаг»
  обеспечивает «у настройки нет ожиданий» (результат.«зачем») равен ""
  запись «Шаг» с «зачем» равным "" и «команда» равным команда и «ждём» равным 0 и «слово» равным ""

тотальная функция «Проба»
  принимает каталог: строка, программа: строка, ждём: число, слово: строка
  возвращает «Шаг»
  обеспечивает «проба названа программой, на которой стоит» (результат.«зачем») равен программа
  пусть зов равно («Вызов» от каталог и программа)
  запись «Шаг» с «зачем» равным программа и «команда» равным зов и «ждём» равным ждём и «слово» равным слово

тотальная функция «Шаги»
  принимает каталог: строка
  возвращает список «Шаг»
  обеспечивает «шагов ровно пять» (длина результат) равен 5
  пусть блоки равно "блоков «прогон» 1, исполнено 0"
  пусть примеры равно "примеров 1, прошло 1, не прошло 0"
  [(«Настройка» от («Сборка» от каталог)),
   («Проба» от каталог и "one-true-run.flang" и 3 и блоки),
   («Проба» от каталог и "one-false-run.flang" и 3 и блоки),
   («Проба» от каталог и "no-runs.flang" и 0 и примеры),
   («Настройка» от («Уборка» от каталог))]

тотальная функция «Поручение шага»
  принимает шаг: «Шаг»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (шаг.«команда»)]

тотальная функция «Сошлась ли»
  принимает шаг: «Шаг», код: число, вывод: строка
  возвращает признак
  пример «код и слово сошлись»
    дано шаг равно запись «Шаг» с «зачем» равным "п" и «команда» равным "" и «ждём» равным 3 и «слово» равным "блоков"
    дано код равно 3
    дано вывод равно "блоков «прогон» 1\n"
    ожидается да
  пример «слово сошлось, а код нет»
    дано шаг равно запись «Шаг» с «зачем» равным "п" и «команда» равным "" и «ждём» равным 3 и «слово» равным "блоков"
    дано код равно 0
    дано вывод равно "блоков «прогон» 1\n"
    ожидается нет
  (код равен (шаг.«ждём»)) и притом (вывод содержит (шаг.«слово»))

тотальная функция «Кратко»
  принимает текст: строка
  возвращает строка
  пример «переводы строк становятся пробелами»
    дано текст равно "раз\nдва"
    ожидается "раз два"
  пусть одной равно (соединить (разделить текст по "\n") по " ")
  если (длина одной) не больше 400
    то одной
    иначе подстрока одной с 1 по 400

тотальная функция «Про беду»
  принимает шаг: «Шаг», код: число, вывод: строка
  возвращает строка
  соединить [(шаг.«зачем»), " — ждали код ", (к строке (шаг.«ждём»)), " и слово «", (шаг.«слово»),
             "», вышло код ", (к строке код), ", вывод: ", («Кратко» от вывод)] по ""

тотальная функция «Про настройку»
  принимает код: число, вывод: строка
  возвращает строка
  соединить ["настройка не вышла, код ", (к строке код), ": ", («Кратко» от вывод)] по ""

тотальная функция «Нечем смотреть»
  принимает почему: строка
  возвращает «Продолжение»
  пример «невозможность смотреть — не расхождение»
    дано почему равно "не собралось"
    ожидается вариант «Не проверено» с код равным "FLANG_PROBE_RUNS_NO_MEANS" и сообщение равным "не собралось"
  вариант «Не проверено» с код равным "FLANG_PROBE_RUNS_NO_MEANS" и сообщение равным почему

тотальная функция «Слово итога»
  принимает сделано: число
  возвращает строка
  пример «итог называет число проб и число расхождений»
    дано сделано равно 3
    ожидается "блоки «прогон» названы числом: проб 3, разошлось 0"
  соединить ["блоки «прогон» названы числом: проб ", (к строке сделано), ", разошлось 0"] по ""

тотальная функция «Слово беды»
  принимает беды: список строки, сделано: число
  возвращает строка
  пусть сколько равно (соединить [(к строке (длина беды)), " из ", (к строке сделано)] по "")
  пусть заголовок равно (соединить ["блоки «прогон» не названы, расхождений ", сколько, ":"] по "")
  соединить (приписать заголовок к беды) по "\n  · "

тотальная функция «Итог»
  принимает беды: список строки, сделано: число
  возвращает «Продолжение»
  пример «все пробы сошлись — план доходит до конца»
    дано беды равно пустой список
    дано сделано равно 3
    ожидается вариант «Конец работы» с значение равным "блоки «прогон» названы числом: проб 3, разошлось 0"
  разбор беды
    случай пусто
      то вариант «Конец работы» с значение равным («Слово итога» от сделано)
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_PROBE_RUNS" и сообщение равным («Слово беды» от беды и сделано)

тип «Ход»
  вариант «Ждём каталог»
  вариант «Ждём шаг» содержит шаг: «Шаг», осталось: список «Шаг», беды: список строки, сделано: число

тотальная функция «Начать»
  возвращает «Ход»
  пример «первым делом заводится каталог под двоичный пробы»
    ожидается вариант «Ждём каталог»
  вариант «Ждём каталог»

тотальная функция «Завести каталог»
  возвращает «Продолжение»
  пусть дело равно (вариант «Завести временный каталог» с образец равным («Образец каталога»))
  вариант «Сделать» с поручение равным дело и потом равным (вариант «Ждём каталог»)

тотальная функция «Ждать шаг»
  принимает шаг: «Шаг», осталось: список «Шаг», беды: список строки, сделано: число
  возвращает «Ход»
  вариант «Ждём шаг» с шаг равным шаг и осталось равным осталось и беды равным беды и сделано равным сделано

тотальная функция «Сделать шаг»
  принимает шаг: «Шаг», осталось: список «Шаг», беды: список строки, сделано: число
  возвращает «Продолжение»
  пусть потом равно («Ждать шаг» от шаг и осталось и беды и сделано)
  вариант «Сделать» с поручение равным («Поручение шага» от шаг) и потом равным потом

тотальная функция «Пойти»
  принимает очередь: список «Шаг», беды: список строки, сделано: число
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то «Итог» от беды и сделано
    случай голова первый и хвост остальные
      то «Сделать шаг» от первый и остальные и беды и сделано

тотальная функция «После настройки»
  принимает осталось: список «Шаг», беды: список строки, сделано: число, код: число, вывод: строка
  возвращает «Продолжение»
  если код равен 0
    то «Пойти» от осталось и беды и сделано
    иначе «Нечем смотреть» от («Про настройку» от код и вывод)

тотальная функция «Сложить беду»
  принимает шаг: «Шаг», беды: список строки, код: число, вывод: строка
  возвращает список строки
  если («Сошлась ли» от шаг и код и вывод)
    то беды
    иначе добавить («Про беду» от шаг и код и вывод) к беды

тотальная функция «После процесса»
  принимает шаг: «Шаг», осталось: список «Шаг», беды: список строки, сделано: число, код: число, вывод: строка
  возвращает «Продолжение»
  если (шаг.«зачем») равен ""
    то «После настройки» от осталось и беды и сделано и код и вывод
    иначе «Пойти» от осталось и («Сложить беду» от шаг и беды и код и вывод) и (сделано плюс 1)

тотальная функция «Про сигнал»
  принимает шаг: «Шаг», сигнал: строка
  возвращает строка
  соединить ["шаг «", (шаг.«зачем»), "» убит сигналом ", сигнал] по ""

тотальная функция «Про сбой»
  принимает код: строка, сообщение: строка
  возвращает строка
  соединить ["sh не запустился (", код, "): ", сообщение] по ""

тотальная функция «После шага»
  принимает шаг: «Шаг», осталось: список «Шаг», беды: список строки, сделано: число, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то «После процесса» от шаг и осталось и беды и сделано и код и (соединить [вывод, ошибки] по " ")
    случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
      то «Нечем смотреть» от («Про сигнал» от шаг и сигнал)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то «Нечем смотреть» от («Про сбой» от код и сообщение)
    случай любое
      то «Нечем смотреть» от («Про сигнал» от шаг и "ждали ответа процесса")

тотальная функция «После каталога»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Пока ничего»
      то «Завести каталог»
    случай вариант «Заведено» с путь как путь
      то «Пойти» от («Шаги» от путь) и пустой список и 0
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то «Нечем смотреть» от («Про сбой» от код и сообщение)
    случай любое
      то «Нечем смотреть» от "ждали временного каталога"

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём каталог»
      то «После каталога» от отклик
    случай вариант «Ждём шаг» с шаг как шаг и осталось как осталось и беды как беды и сделано как сделано
      то «После шага» от шаг и осталось и беды и сделано и отклик

план «Check»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
