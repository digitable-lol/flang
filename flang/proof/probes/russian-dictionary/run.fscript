модуль «Пробы русского словаря»

использует «Таблица проб» из "../table.fscript"

тотальная функция «Этот набор»
  возвращает «Набор»
  пример «набор назван, и у расхождения и слепоты разные коды»
    ожидается (запись «Набор» с «имя» равным "russian-dictionary"
      и «код расхождения» равным "FLANG_PROBE_RUSSIAN_DICTIONARY"
      и «код слепоты» равным "FLANG_PROBE_RUSSIAN_DICTIONARY_CANNOT_LOOK")
  (запись «Набор» с «имя» равным "russian-dictionary"
    и «код расхождения» равным "FLANG_PROBE_RUSSIAN_DICTIONARY"
    и «код слепоты» равным "FLANG_PROBE_RUSSIAN_DICTIONARY_CANNOT_LOOK")

тотальная функция «Доводы функции»
  принимает форма: строка
  возвращает строка
  пример «форма уходит функции полем записи»
    дано форма равно "стали"
    ожидается "'{\"форма\":\"стали\"}'"
  соединить ["'{\"форма\":\"", форма, "\"}'"] по ""

тотальная функция «Вызов функции»
  принимает форма: строка
  возвращает строка
  (соединить ["$flang run 'flang/ct/russian/dictionary/features.flang' ",
    "--function '«Признаки слова строками»' --args ", («Доводы функции» от форма)] по "")

тотальная функция «Сценарий плана»
  возвращает строка
  """
  d=$(mktemp -d -p "${FLANG_TMP:-${TMPDIR:-/tmp}}" russian-dictionary.XXXXXX)
  text=flang/proof/probes/russian-dictionary/text.txt
  $flang io flang/ct/russian/dictionary/words.fscript --plan Words -- "$dict" "$text" "$d/table" "$d/short" \
    >/dev/null 2>"$d/said"
  c=$?
  cat "$d/table" "$d/short" "$d/said"
  rm -rf "$d"
  exit $c
  """

тотальная функция «Вызов плана»
  принимает словарь: строка
  возвращает строка
  пример «каталог словаря назван переменной перед сценарием, сценарий идёт в своей оболочке»
    дано словарь равно ""
    ожидается """
      ( dict=
      d=$(mktemp -d -p "${FLANG_TMP:-${TMPDIR:-/tmp}}" russian-dictionary.XXXXXX)
      text=flang/proof/probes/russian-dictionary/text.txt
      $flang io flang/ct/russian/dictionary/words.fscript --plan Words -- "$dict" "$text" "$d/table" "$d/short" \
        >/dev/null 2>"$d/said"
      c=$?
      cat "$d/table" "$d/short" "$d/said"
      rm -rf "$d"
      exit $c
      )"""
  соединить ["( dict=", словарь, "\n", («Сценарий плана»), ")"] по ""

тотальная функция «Каталог словаря»
  принимает путь: строка
  возвращает строка
  пример «собранный образец словаря лежит рядом с пробами»
    дано путь равно "data"
    ожидается "flang/proof/probes/russian-dictionary/data"
  пример «всякий другой путь — словаря нет»
    дано путь равно "none"
    ожидается "flang/proof/probes/russian-dictionary/no-such-dictionary"
  если путь равен "data"
    то "flang/proof/probes/russian-dictionary/data"
    иначе "flang/proof/probes/russian-dictionary/no-such-dictionary"

тотальная функция «Вызов»
  принимает путь: строка, форма: строка
  возвращает строка
  если путь равен "own"
    то «Вызов функции» от форма
    иначе «Вызов плана» от («Каталог словаря» от путь)

тотальная функция «Проба из строки»
  принимает части: список строки
  возвращает «Проба»
  пусть путь равно «Поле» от части и 1
  пусть форма равно «Поле» от части и 2
  (запись «Проба» с «программа» равным форма
    и «приметы» равным («Приметы» от форма и [путь, («Поле» от части и 4)])
    и «команда» равным («От корня» от («С меткой» от («Вызов» от путь и форма)))
    и «код» равным («Поле» от части и 3)
    и «слово» равным («Поле» от части и 4))

тотальная функция «Пробы»
  принимает текст: строка
  возвращает список «Проба»
  отобразить («Строки данных» от текст) как части → («Проба из строки» от части)

тотальная функция «Пройти таблицу»
  принимает пробы: список «Проба»
  возвращает «Продолжение»
  пример «пустая таблица — смотреть не на что»
    дано пробы равно пустой список
    ожидается (вариант «Не проверено» с код равным "FLANG_PROBE_RUSSIAN_DICTIONARY_CANNOT_LOOK"
      и сообщение равным "russian-dictionary: в expected.tsv нет ни одной строки данных")
  разбор пробы
    случай пусто
      то «Нечем смотреть» от («Этот набор») и "в expected.tsv нет ни одной строки данных"
    случай голова и хвост
      то «Пойти по пробам» от («Этот набор») и пробы и пустой список и 0

тотальная функция «Начать»
  возвращает «Ход»
  пример «план начинается с начала»
    ожидается вариант «Начало»
  вариант «Начало»

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём таблицу»
      то «Пройти таблицу» от («Пробы» от («Содержимое» от отклик))
    случай любое
      то «Шаг» от («Этот набор») и ход и отклик

план «Binary»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
