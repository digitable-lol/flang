тотальная функция «Reasoning json»
  принимает language: строка, text: строка, output: строка
  возвращает строка
  «Report json» от («Check report of» от language и text и output)

тотальная функция «Fallacy words»
  принимает report: «Check report»
  возвращает список строки
  пример «A named fallacy and its card»
    дано report равно (запись «Check report» с «language» равным "ru" и «verdict» равным "does-not-follow"
        и «fallacy» равным (запись «Fallacy» с «id» равным "affirming-the-consequent"
        и «name» равным "обращение следствия" и «slug» равным "affirming-the-consequent"
        и «why» равным "средний термин не взят целиком") и «premises» равным пустой список и «conclusion» равным ""
        и «counterexample» равным "" и «unparsed» равным пустой список и «hints» равным пустой список
        и «dictionary» равным пустой список и «kernel» равным "" и «boundary» равным "")
    ожидается (["не следует — это обращение следствия: средний термин не взят целиком",
        "карточка ошибки: https://courses.digitable.life/fallacies/#affirming-the-consequent"])
  пусть fallacy равно (report.«fallacy»)
  пусть card равно («Card address» от fallacy)
  «Applying» от [
    («When» от (((report.«verdict») равен "does-not-follow") и притом (пусто (fallacy.«id»)))
        и (соединить ["не следует — имени ошибки правила силлогистики здесь не дают: ",
        "смотрите пример против"] по "")),
    («When» от (((report.«verdict») равен "does-not-follow") и притом (не (пусто (fallacy.«id»))))
        и (соединить ["не следует — это ", (fallacy.«name»), ": ", (fallacy.«why»)] по "")),
    («When» от (((report.«verdict») равен "follows") и притом (не (пусто (fallacy.«id»))))
        и (соединить ["по форме следует, но это ", (fallacy.«name»), ": ", (fallacy.«why»)] по "")),
    («When» от (не (пусто card)) и (соединить ["карточка ошибки: ", card] по ""))]

тотальная функция «Hint words»
  принимает hint: «Hint»
  возвращает строка
  (соединить ["подсказка (", («Hint note»), "): ", (hint.«name»), " — на словах «", (hint.«phrase»), "»: ",
      (hint.«why»), (если пусто (hint.«slug») то "" иначе соединить ["; карточка: ", («Catalog address»), "#",
      (hint.«slug»)] по "")] по "")

тотальная функция «Report extras»
  принимает report: «Check report»
  возвращает список строки
  пример «A report not judged says the boundary and the reason»
    дано report равно (запись «Check report» с «language» равным "ru" и «verdict» равным "not-judged"
        и «fallacy» равным (запись «Fallacy» с «id» равным "" и «name» равным "" и «slug» равным "" и «why» равным "")
        и «premises» равным пустой список и «conclusion» равным "" и «counterexample» равным ""
        и «unparsed» равным пустой список и «hints» равным пустой список и «dictionary» равным ["Имя: Барсик"]
        и «kernel» равным "" и «boundary» равным "граница")
    ожидается ["словарь, прочитанный морфологией: Имя: Барсик", "граница: граница"]
  («Соединить списки» от («Соединить списки» от («Fallacy words» от report)
      и («Applying» от [(«When» от (не (пусто (report.«dictionary»)))
      и (соединить ["словарь, прочитанный морфологией: ", (соединить (report.«dictionary») по "; ")] по "")),
      («When» от да и (соединить ["граница: ", (report.«boundary»)] по ""))]))
      и (отобразить (report.«hints») как hint → «Hint words» от hint))

тотальная функция «Reasoning words»
  принимает language: строка, text: строка, output: строка
  возвращает строка
  соединить («Report extras» от («Check report of» от language и text и output)) по "\n"

примечание "Подсказки. Неформальная ошибка формой не доказывается, и здесь её не
доказывают: для пяти узнаваемых образцов из каталога ошибок подсказка называет
фразу, на которой образец сработал, и объясняет, что проверить. Образец читает
строение предложения, а не голые слова: кто подлежащее и согласовано ли с ним
сказуемое, решает прегруппа (flang/ct/russian/pregroup.flang) над типами, которые
даёт морфология: лицо и число глагола по окончанию, род и число краткой формы,
число существительного по словарной записи. Служебные слова (местоимения,
«если … то», «либо … либо», «что» после глагола речи) — закрытые списки, и это
сказано здесь, а не спрятано."

тотальная функция «Noun type»
  принимает gender: строка, count: строка, person: строка
  возвращает «Тип»
  пример «A noun phrase in the nominative»
    дано gender равно "ж"
    дано count равно "ед"
    дано person равно "3"
    ожидается ([(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
        и лицо равным "3" и сопряжение равным 0)])
  [«Именная» от "им" и gender и count и person]

тотальная функция «Verb type»
  принимает gender: строка, count: строка, person: строка
  возвращает «Тип»
  пример «A predicate waits for its subject on the left»
    дано gender равно "*"
    дано count равно "ед"
    дано person равно "2"
    ожидается ([(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
        и лицо равным "2" и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*"
        и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 0)])
  [«Сопряжённый» от («Именная» от "им" и gender и count и person) и 1, «Предложение»]

тотальная функция «Pronoun types»
  принимает word: строка
  возвращает список «Тип»
  пример «"ты" may be either gender»
    дано word равно "ты"
    ожидается ([[(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "м" и число равным "ед"
        и лицо равным "2" и сопряжение равным 0)], [(запись «Простой тип» с вид равным "n" и падеж равным "им"
        и род равным "ж" и число равным "ед" и лицо равным "2" и сопряжение равным 0)]])
  пример «A noun is not a pronoun»
    дано word равно "кит"
    ожидается пустой список
  пусть w равно («Lowered» от word)
  «Chosen» от [
    («When» от (w равен "я") и [«Noun type» от "м" и "ед" и "1", «Noun type» от "ж" и "ед" и "1"]),
    («When» от (w равен "ты") и [«Noun type» от "м" и "ед" и "2", «Noun type» от "ж" и "ед" и "2"]),
    («When» от (w равен "он") и [«Noun type» от "м" и "ед" и "3"]),
    («When» от (w равен "она") и [«Noun type» от "ж" и "ед" и "3"]),
    («When» от (w равен "оно") и [«Noun type» от "ср" и "ед" и "3"]),
    («When» от (w равен "мы") и [«Noun type» от "*" и "мн" и "1"]),
    («When» от (w равен "вы") и [«Noun type» от "*" и "мн" и "2"]),
    («When» от (w равен "они") и [«Noun type» от "*" и "мн" и "3"]),
    («When» от ((w равен "все") или (w равен "многие")) и [«Noun type» от "*" и "мн" и "3"]),
    («When» от (w равен "большинство") и [«Noun type» от "ср" и "ед" и "3"]),
    («When» от ((w равен "каждый") или (w равен "никто")) и [«Noun type» от "м" и "ед" и "3"])] и (пустой список)

тотальная функция «Person words»
  возвращает список строки
  пример «Pronouns that name a person»
    ожидается ["я", "ты", "он", "она", "мы", "вы", "они"]
  ["я", "ты", "он", "она", "мы", "вы", "они"]

тотальная функция «Gender letter»
  принимает who: строка
  возвращает строка
  пример «"она" is feminine»
    дано who равно "она"
    ожидается "ж"
  («Chosen» от [(«When» от (who равен "он") и "м"), («When» от (who равен "она") и "ж"),
      («When» от (who равен "оно") и "ср")] и "*")

тотальная функция «Notion types»
  принимает token: строка
  возвращает список «Тип»
  пример «A full adjective in the plural is a plural noun phrase»
    дано token равно "мохнатые"
    ожидается ([[(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "мн"
        и лицо равным "3" и сопряжение равным 0)]])
  (свёртка («Candidates of» от token и нет) начиная с (пустой список) как got и cand → «Соединить списки» от got
      и («Applying» от [(«When» от ((((cand.«entry»).«kind») равен "понятие")
      и притом ((((cand.«entry»).«forms»).«one») равен token))
      и («Noun type» от («Gender letter» от ((cand.«entry»).«gender»)) и "ед" и "3")),
      («When» от ((((cand.«entry»).«kind») равен "понятие") и притом ((((cand.«entry»).«forms»).«many») равен token))
      и («Noun type» от "*" и "мн" и "3"))]))

тотальная функция «Subject types»
  принимает token: строка
  возвращает список «Тип»
  пример «A capitalised word may be a name of either gender, and a notion as well»
    дано token равно "Иван"
    ожидается ([[(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "м" и число равным "ед"
        и лицо равным "3" и сопряжение равным 0)], [(запись «Простой тип» с вид равным "n" и падеж равным "им"
        и род равным "ж" и число равным "ед" и лицо равным "3" и сопряжение равным 0)],
        [(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "м" и число равным "ед"
        и лицо равным "3" и сопряжение равным 0)]])
  пусть pronoun равно («Pronoun types» от token)
  если не (пусто pronoun)
    то pronoun
    иначе («Соединить списки» от (если «Written with a capital» от token то [«Noun type» от "м" и "ед" и "3",
        «Noun type» от "ж" и "ед" и "3"] иначе пустой список) и («Notion types» от token))

тотальная функция «Without the reflexive»
  принимает token: строка
  возвращает строка
  пример «"ошибаешься" loses "ся"»
    дано token равно "ошибаешься"
    ожидается "ошибаешь"
  пример «A plain verb stays»
    дано token равно "говорит"
    ожидается "говорит"
  если ((«Ends with» от token и "ся") или («Ends with» от token и "сь")) и притом ((длина token) больше 3)
    то подстрока token с 1 по ((длина token) минус 2)
    иначе token

тотальная функция «Ends with one of»
  принимает token: строка, tails: список строки
  возвращает признак
  пример «One of the tails ends the word»
    дано token равно "говоришь"
    дано tails равно ["ешь", "ишь"]
    ожидается да
  свёртка tails начиная с нет как found и tail → found или («Ends with» от token и tail)

тотальная функция «Verb types by ending»
  принимает token: строка
  возвращает список «Тип»
  пример «"-ешь" is the second person singular»
    дано token равно "разбираешься"
    ожидается ([[(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "ед"
        и лицо равным "2" и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*"
        и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 0)]])
  пример «"-ли" is the plural of the past»
    дано token равно "сказали"
    ожидается ([[(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "*" и число равным "мн"
        и лицо равным "*" и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*"
        и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 0)]])
  пусть v равно («Without the reflexive» от («Lowered» от token))
  «Chosen» от [
    («When» от («Ends with one of» от v и ["ешь", "ёшь", "ишь"]) и [«Verb type» от "*" и "ед" и "2"]),
    («When» от («Ends with one of» от v и ["ете", "ёте", "ите"]) и [«Verb type» от "*" и "мн" и "2"]),
    («When» от («Ends with one of» от v и ["ет", "ёт", "ит"]) и [«Verb type» от "*" и "ед" и "3"]),
    («When» от («Ends with one of» от v и ["ем", "ём", "им"]) и [«Verb type» от "*" и "мн" и "1"]),
    («When» от («Ends with one of» от v и ["ут", "ют", "ат", "ят"]) и [«Verb type» от "*" и "мн" и "3"]),
    («When» от («Ends with» от v и "ла") и [«Verb type» от "ж" и "ед" и "*"]),
    («When» от («Ends with» от v и "ло") и [«Verb type» от "ср" и "ед" и "*"]),
    («When» от («Ends with» от v и "ли") и [«Verb type» от "*" и "мн" и "*"]),
    («When» от («Ends with» от v и "л") и [«Verb type» от "м" и "ед" и "*"])] и (пустой список)

тотальная функция «Predicate types»
  принимает token: строка
  возвращает список «Тип»
  пример «"неправа" agrees with a feminine subject of any person»
    дано token равно "неправа"
    ожидается ([[(запись «Простой тип» с вид равным "n" и падеж равным "им" и род равным "ж" и число равным "ед"
        и лицо равным "*" и сопряжение равным 1), (запись «Простой тип» с вид равным "s" и падеж равным "*"
        и род равным "*" и число равным "*" и лицо равным "*" и сопряжение равным 0)]])
  пусть w равно («Lowered» от token)
  «Chosen» от [
    («When» от ((w равен "прав") или (w равен "неправ")) и [«Verb type» от "м" и "ед" и "*"]),
    («When» от ((w равен "права") или (w равен "неправа")) и [«Verb type» от "ж" и "ед" и "*"]),
    («When» от ((w равен "правы") или (w равен "неправы"))
        и [«Verb type» от "*" и "мн" и "*"])] и («Verb types by ending» от token)

тотальная функция «Forms a sentence»
  принимает subject: строка, predicate: строка
  возвращает признак
  пример «"ты неправ" is a sentence»
    дано subject равно "ты"
    дано predicate равно "неправ"
    ожидается да
  пример «"вы неправ" is not: the number does not agree»
    дано subject равно "вы"
    дано predicate равно "неправ"
    ожидается нет
  пример «"учёные говорят" is a sentence»
    дано subject равно "учёные"
    дано predicate равно "говорят"
    ожидается да
  пример «"все делает" is not»
    дано subject равно "все"
    дано predicate равно "делает"
    ожидается нет
  пусть words равно ([(запись «Слово с типами» с номер равным 1 и типы равным («Subject types» от subject)),
      (запись «Слово с типами» с номер равным 2 и типы равным («Predicate types» от predicate))])
  разбор («Разобрать типы» от words и («Предложение»))
    случай вариант «Сводится» с выбор как выбор и связи как связи
      то да
    случай любое
      то нет

тотальная функция «Fillers»
  возвращает список строки
  пример «Particles that do not change who is judged»
    ожидается ["не", "просто", "конечно", "явно", "опять", "тоже", "снова", "точно", "же", "ведь", "совершенно", "и"]
  ["не", "просто", "конечно", "явно", "опять", "тоже", "снова", "точно", "же", "ведь", "совершенно", "и"]

тотальная функция «Clause words»
  принимает text: строка
  возвращает список строки
  пример «The mark of the conclusion and the commas go»
    дано text равно "Следовательно, ты, конечно, неправ"
    ожидается ["ты", "конечно", "неправ"]
  «Claim words of» от («Words kept with dashes» от text)

тотальная функция «Core words»
  принимает tokens: список строки
  возвращает список строки
  пример «Particles are dropped»
    дано tokens равно ["ты", "конечно", "не", "прав"]
    ожидается ["ты", "прав"]
  отфильтровать tokens где token → не ((«Fillers») содержит («Lowered» от token))

тотальная функция «Evaluation word»
  принимает token: строка
  возвращает признак
  пример «"неправ" says a claim is false»
    дано token равно "неправ"
    ожидается да
  пример «"ошибаешься" says it too»
    дано token равно "ошибаешься"
    ожидается да
  пример «"устал" does not»
    дано token равно "устал"
    ожидается нет
  пусть w равно («Lowered» от token)
  (["прав", "права", "правы", "неправ", "неправа", "неправы", "лжёт", "лжёшь", "лжёте", "лгут", "врёт", "врёшь",
      "врёте", "врут"] содержит w) или (w начинается с "ошиба") или (w начинается с "заблужда")

тотальная функция «Plain claim»
  принимает line: «Claim line»
  возвращает строка
  пример «The mark of the conclusion is not part of the phrase»
    дано line равно запись «Claim line» с «text» равным "Следовательно, ты неправ" и «concludes» равным да
    ожидается "ты неправ"
  если line.«concludes» то («Words behind the first» от (line.«text»)) иначе line.«text»

тотальная функция «Hint»
  принимает id: строка, name: строка, slug: строка, phrase: строка, why: строка
  возвращает «Hint»
  пример «A hint with its card»
    дано id равно "false-dilemma"
    дано name равно "ложная дилемма"
    дано slug равно "false-dilemma"
    дано phrase равно "либо со мной, либо против меня"
    дано why равно "третий путь не исключён"
    ожидается (запись «Hint» с «id» равным "false-dilemma" и «name» равным "ложная дилемма"
        и «slug» равным "false-dilemma" и «phrase» равным "либо со мной, либо против меня"
        и «why» равным "третий путь не исключён")
  запись «Hint» с «id» равным id и «name» равным name и «slug» равным slug и «phrase» равным phrase и «why» равным why

тотальная функция «Judged person»
  принимает line: «Claim line»
  возвращает строка
  пример «"ты неправ" judges "ты"»
    дано line равно запись «Claim line» с «text» равным "Следовательно, ты неправ" и «concludes» равным да
    ожидается "ты"
  пример «"расчёт неверен" judges no person»
    дано line равно запись «Claim line» с «text» равным "Следовательно, расчёт неверен" и «concludes» равным да
    ожидается ""
  пусть core равно («Core words» от («Clause words» от (line.«text»)))
  пусть who равно («Form at» от core и 1)
  пусть person равно ((«Person words») содержит («Lowered» от who)) или («Written with a capital» от who)
  если (((длина core) равен 2) и притом (person и притом ((«Evaluation word» от («Form at» от core и 2))
      и притом («Forms a sentence» от who и («Form at» от core и 2)))))
    то who
    иначе ""

тотальная функция «Speaks of»
  принимает line: «Claim line», who: строка
  возвращает признак
  пример «"Ты не разбираешься в физике" speaks of "ты"»
    дано line равно запись «Claim line» с «text» равным "Ты не разбираешься в физике" и «concludes» равным нет
    дано who равно "ты"
    ожидается да
  пример «"Она ничего не понимает в экономике" speaks of "она": the verb agrees with her»
    дано line равно запись «Claim line» с «text» равным "Она ничего не понимает в экономике" и «concludes» равным нет
    дано who равно "она"
    ожидается да
  пример «"В расчёте две ошибки" does not»
    дано line равно запись «Claim line» с «text» равным "В расчёте две ошибки" и «concludes» равным нет
    дано who равно "ты"
    ожидается нет
  пусть core равно («Core words» от («Clause words» от (line.«text»)))
  пусть head равно («Form at» от core и 1)
  пусть said равно («Form at» от core и 2)
  пусть judged равно (свёртка core начиная с нет как found и token → found или («Evaluation word» от token))
  пусть spoken равно (свёртка («Without the first» от core) начиная с нет как found
      и token → found или («Forms a sentence» от head и token))
  ((«Lowered» от head) равен («Lowered» от who)) и притом ((не judged) и притом ((«Is a dash» от said) или spoken))

тотальная функция «Ad hominem hints»
  принимает lines: список «Claim line»
  возвращает список «Hint»
  (свёртка (отфильтровать lines где line → line.«concludes») начиная с (пустой список) как got
      и drawn → «Соединить списки» от got
      и (если пусто («Judged person» от drawn) то пустой список иначе (отобразить («First of premises» от
      («Premises about» от lines и («Judged person» от drawn))) как told → «Hint» от "ad-hominem"
      и "переход на личность" и "ad-hominem" и (соединить [(told.«text»), " → ",
      («Plain claim» от drawn)] по "") и (соединить ["вывод «", («Plain claim» от drawn),
      (соединить ["» сделан о том, кто говорит, из сведений о нём самом, а не из ",
      "оснований его утверждения: уберите характеристику человека — ", "останется ли довод?"] по "")] по ""))))

тотальная функция «Ad hominem hints ids»
  принимает lines: список «Claim line»
  возвращает список строки
  пример «"Ты не разбираешься в физике, значит, ты неправ"»
    дано lines равно ([(запись «Claim line» с «text» равным "Ты не разбираешься в физике" и «concludes» равным нет),
        (запись «Claim line» с «text» равным "Следовательно, ты неправ" и «concludes» равным да)])
    ожидается ["ad-hominem"]
  пример «A reason about the claim is not about the person»
    дано lines равно ([(запись «Claim line» с «text» равным "В расчёте две ошибки" и «concludes» равным нет),
        (запись «Claim line» с «text» равным "Следовательно, ты неправ" и «concludes» равным да)])
    ожидается пустой список
  отобразить («Ad hominem hints» от lines) как hint → hint.«id»

тотальная функция «Premises about»
  принимает lines: список «Claim line», who: строка
  возвращает список «Claim line»
  пример «The premises that speak of the judged person»
    дано lines равно ([(запись «Claim line» с «text» равным "Ты не разбираешься в физике" и «concludes» равным нет),
        (запись «Claim line» с «text» равным "Следовательно, ты неправ" и «concludes» равным да)])
    дано who равно "ты"
    ожидается [запись «Claim line» с «text» равным "Ты не разбираешься в физике" и «concludes» равным нет]
  отфильтровать lines где line → «Spoken about» от line и who

тотальная функция «Spoken about»
  принимает line: «Claim line», who: строка
  возвращает признак
  пример «A conclusion is not a premise about anyone»
    дано line равно запись «Claim line» с «text» равным "Следовательно, ты неправ" и «concludes» равным да
    дано who равно "ты"
    ожидается нет
  (не (line.«concludes»)) и притом («Speaks of» от line и who)

тотальная функция «First of premises»
  принимает lines: список «Claim line»
  возвращает список «Claim line»
  пример «Only the first line is kept»
    дано lines равно ([(запись «Claim line» с «text» равным "а" и «concludes» равным нет),
        (запись «Claim line» с «text» равным "б" и «concludes» равным нет)])
    ожидается [запись «Claim line» с «text» равным "а" и «concludes» равным нет]
  разбор lines
    случай пусто
      то пустой список
    случай голова и хвост
      то [голова]

тотальная функция «Report parts»
  принимает line: «Claim line»
  возвращает список строки
  пример «Who said, the verb of saying and what was said»
    дано line равно (запись «Claim line» с «text» равным "Профессор Иванов сказал, что вода ядовита"
        и «concludes» равным нет)
    ожидается ["Иванов", "сказал", "вода ядовита"]
  пример «A sentence without "что" reports nothing»
    дано line равно запись «Claim line» с «text» равным "Все люди смертны" и «concludes» равным нет
    ожидается пустой список
  пусть plain равно («Trimmed» от («Replaced» от (line.«text») и "," и " "))
  пусть parts равно («Cut at» от (соединить [" ", plain, " "] по "") и " что ")
  пусть before равно («Spaced words» от («Form at» от parts и 1))
  пусть said равно («Trimmed» от («Form at» от parts и 2))
  пусть spot равно («Last speech verb at» от before)
  если ((длина parts) равен 2) и притом ((spot больше 1) и притом (не (пусто said)))
    то [(«Form at» от before и (spot минус 1)), («Form at» от before и spot), said]
    иначе пустой список

тотальная функция «Last speech verb at»
  принимает tokens: список строки
  возвращает число
  пример «The verb of saying may stand before the one it was said to»
    дано tokens равно ["Профессор", "Иванов", "сказал", "студентам"]
    ожидается 3
  пример «No verb of saying is no place»
    дано tokens равно ["Врач", "измерил", "давление"]
    ожидается 0
  (свёртка («Numbered ones» от tokens) начиная с 0 как found
      и word → если («Speech verb» от (word.«text»)) то word.«number» иначе found)


тотальная функция «Speech verb»
  принимает token: строка
  возвращает признак
  пример «"утверждают" is a verb of saying»
    дано token равно "утверждают"
    ожидается да
  пример «"измерил" is not»
    дано token равно "измерил"
    ожидается нет
  пусть w равно («Lowered» от token)
  (свёртка ["говор", "сказа", "счита", "утвержда", "доказа", "заяви", "заявля", "пиш", "написа", "полага", "уверя",
      "сообщ", "подтверд", "объяви"] начиная с нет как found и stem → found или (w начинается с stem))

тотальная функция «Reported»
  принимает line: «Claim line»
  возвращает строка
  пример «What the authority said, when the subject agrees with the verb»
    дано line равно запись «Claim line» с «text» равным "Учёные доказали, что кофе полезен" и «concludes» равным нет
    ожидается "кофе полезен"
  пример «Not a report of words»
    дано line равно запись «Claim line» с «text» равным "Врач измерил давление" и «concludes» равным нет
    ожидается ""
  пусть parts равно («Report parts» от line)
  если (((длина parts) равен 3) и притом ((«Speech verb» от («Form at» от parts и 2))
      и притом («Forms a sentence» от («Form at» от parts и 1) и («Form at» от parts и 2))))
    то «Form at» от parts и 3
    иначе ""

тотальная функция «Same words»
  принимает one: строка, other: строка
  возвращает признак
  пример «A capital and commas do not matter»
    дано one равно "Кофе полезен"
    дано other равно "кофе, полезен"
    ожидается да
  (соединить (отобразить («Spaced words» от («Replaced» от one и "," и " ")) как token → «Lowered» от token)
      по " ") равен (соединить (отобразить («Spaced words» от («Replaced» от other и ","
      и " ")) как token → «Lowered» от token) по " ")

тотальная функция «Authority hints»
  принимает lines: список «Claim line»
  возвращает список «Hint»
  пусть told равно (отфильтровать lines где line → не (line.«concludes»))
  пусть reports равно (отфильтровать told где line → не (пусто («Reported» от line)))
  пусть drawn равно (отфильтровать lines где line → line.«concludes»)
  если ((длина reports) равен (длина told)) и притом (не (пусто told))
    то (свёртка drawn начиная с (пустой список) как got и conclusion → «Соединить списки» от got
        и (отобразить («First of premises» от (отфильтровать reports где line → «Same words» от («Reported» от line)
        и («Plain claim» от conclusion))) как line → «Hint» от "appeal-to-authority" и "апелляция к авторитету"
        и "appeal-to-authority" и (line.«text») и (соединить ["вывод «", («Plain claim» от conclusion),
        (соединить ["» повторяет чужие слова, и других оснований в тексте нет: ссылка ",
        "заняла место довода — каковы данные, на которые опирается «"] по ""),
        («Form at» от («Report parts» от line) и 1), "»?"] по "")))
    иначе пустой список

тотальная функция «Authority hints ids»
  принимает lines: список «Claim line»
  возвращает список строки
  пример «Only the words of an authority hold the conclusion up»
    дано lines равно ([(запись «Claim line» с «text» равным "Учёные доказали, что кофе полезен"
        и «concludes» равным нет), (запись «Claim line» с «text» равным "Следовательно, кофе полезен"
        и «concludes» равным да)])
    ожидается ["appeal-to-authority"]
  пример «Testimony with its own evidence is not flagged»
    дано lines равно ([(запись «Claim line» с «text» равным "Врач сказал, что у Ани грипп" и «concludes» равным нет),
        (запись «Claim line» с «text» равным "Анализ показал вирус гриппа" и «concludes» равным нет),
        (запись «Claim line» с «text» равным "Следовательно, у Ани грипп" и «concludes» равным да)])
    ожидается пустой список
  отобразить («Authority hints» от lines) как hint → hint.«id»

тотальная функция «Choice pieces»
  принимает text: строка, mark: строка
  возвращает список строки
  пример «Two alternatives after the paired mark»
    дано text равно "Ты либо со мной, либо против меня"
    дано mark равно "либо"
    ожидается ["со мной", "против меня"]
  пример «A single mark is no pair»
    дано text равно "Можно ехать поездом или автобусом"
    дано mark равно "или"
    ожидается пустой список
  пусть pieces равно (разделить (соединить [" ", («Replaced» от («Lowered» от text) и "," и " "),
      " "] по "") по (соединить [" ", mark, " "] по ""))
  если (длина pieces) равен 3
    то [«Trimmed» от («Form at» от pieces и 2), «Trimmed» от («Form at» от pieces и 3)]
    иначе пустой список

тотальная функция «Covers every case»
  принимает one: строка, other: строка
  возвращает признак
  пример «"чётное" or "нечётное" is every case»
    дано one равно "чётное"
    дано other равно "нечётное"
    ожидается да
  пример «"со мной" or "против меня" is not»
    дано one равно "со мной"
    дано other равно "против меня"
    ожидается нет
  пример «"придёт" or "нет" is every case»
    дано one равно "придёт"
    дано other равно "нет"
    ожидается да
  пусть a равно («First of» от («Spaced words» от one))
  пусть b равно («First of» от («Spaced words» от other))
  (other равен "нет") или (one равен "нет") или (other равен (соединить ["не ",
      one] по "")) или (one равен (соединить ["не ", other] по "")) или (b равен (соединить ["не",
      a] по "")) или (a равен (соединить ["не", b] по ""))

тотальная функция «Dilemma pieces»
  принимает line: «Claim line»
  возвращает список строки
  пример «"Или … или" pairs as well»
    дано line равно (запись «Claim line» с «text» равным "Или мы снижаем цены, или фирма разорится"
        и «concludes» равным нет)
    ожидается ["мы снижаем цены", "фирма разорится"]
  пусть either равно («Choice pieces» от (line.«text») и "либо")
  если пусто either то («Choice pieces» от (line.«text») и "или") иначе either

тотальная функция «Dilemma hints»
  принимает lines: список «Claim line»
  возвращает список «Hint»
  если пусто (отфильтровать lines где line → line.«concludes»)
    то пустой список
    иначе (отобразить (отфильтровать lines где line → ((длина («Dilemma pieces» от line)) равен 2)
        и притом (не («Covers every case» от («Form at» от («Dilemma pieces» от line) и 1)
        и («Form at» от («Dilemma pieces» от line) и 2)))) как line → «Hint» от "false-dilemma" и "ложная дилемма"
        и "false-dilemma" и (line.«text») и (соединить ["выбор сведён к двум вариантам — «",
        («Form at» от («Dilemma pieces» от line) и 1), "» и «", («Form at» от («Dilemma pieces» от line) и 2),
        "», — и ничто в тексте не исключает третьего"] по ""))

тотальная функция «Dilemma hints ids»
  принимает lines: список «Claim line»
  возвращает список строки
  пример «Two options named as if there were no third»
    дано lines равно ([(запись «Claim line» с «text» равным "Ты либо со мной, либо против меня"
        и «concludes» равным нет), (запись «Claim line» с «text» равным "Ты не со мной" и «concludes» равным нет),
        (запись «Claim line» с «text» равным "Следовательно, ты против меня" и «concludes» равным да)])
    ожидается ["false-dilemma"]
  пример «A choice between a thing and its denial covers every case»
    дано lines равно ([(запись «Claim line» с «text» равным "Число либо чётное, либо нечётное"
        и «concludes» равным нет), (запись «Claim line» с «text» равным "Следовательно, оно делится на два или нет"
        и «concludes» равным да)])
    ожидается пустой список
  отобразить («Dilemma hints» от lines) как hint → hint.«id»

тотальная функция «Whole words»
  возвращает список строки
  пример «Words of inevitability and of everything at once»
    ожидается ["вообще", "никогда", "навсегда", "совсем", "окончательно", "неизбежно"]
  ["вообще", "никогда", "навсегда", "совсем", "окончательно", "неизбежно"]

тотальная функция «Small step words»
  возвращает список строки
  пример «Words of one small first step»
    ожидается ["раз", "однажды", "сегодня", "немного", "чуть-чуть", "разок"]
  ["раз", "однажды", "сегодня", "немного", "чуть-чуть", "разок"]

тотальная функция «Condition parts»
  принимает line: «Claim line»
  возвращает список строки
  пример «"Если …, то …" gives the step and its end»
    дано line равно (запись «Claim line» с «text» равным
        "Если разрешить ему опоздать сегодня, то он вообще перестанет приходить вовремя" и «concludes» равным нет)
    ожидается ["разрешить ему опоздать сегодня", "он вообще перестанет приходить вовремя"]
  пример «A dash and "и" join the step and its end»
    дано line равно (запись «Claim line» с «text» равным "Разрешишь один раз — и он никогда не будет ложиться вовремя"
        и «concludes» равным нет)
    ожидается ["разрешишь один раз", "он никогда не будет ложиться вовремя"]
  пусть plain равно (соединить [" ", («Replaced» от («Lowered» от («Plain claim» от line)) и "," и " "), " "] по "")
  пусть conditioned равно («Cut at» от plain и " то ")
  пусть dashed равно («Cut at» от plain и " — и ")
  («Chosen» от [(«When» от ((plain начинается с " если ") и притом ((длина conditioned) равен 2))
      и [«Trimmed» от («Words behind the first» от («Form at» от conditioned и 1)),
      «Trimmed» от («Form at» от conditioned и 2)]), («When» от ((длина dashed) равен 2)
      и [«Trimmed» от («Form at» от dashed и 1), «Trimmed» от («Form at» от dashed и 2)])] и (пустой список))

тотальная функция «Has one of»
  принимает text: строка, words: список строки
  возвращает признак
  пример «A word of the list stands in the text»
    дано text равно "он вообще перестанет"
    дано words равно ["вообще"]
    ожидается да
  свёртка («Spaced words» от text) начиная с нет как found и token → found или (words содержит token)

тотальная функция «Slope hints»
  принимает lines: список «Claim line»
  возвращает список «Hint»
  (отобразить (отфильтровать lines где line → ((длина («Condition parts» от line)) равен 2)
      и притом ((«Has one of» от («Form at» от («Condition parts» от line) и 1) и («Small step words»))
      и притом («Has one of» от («Form at» от («Condition parts» от line) и 2)
      и («Whole words»)))) как line → «Hint» от "slippery-slope" и "скользкая дорожка" и "slippery-slope"
      и («Plain claim» от line) и (соединить ["от первого шага «", («Form at» от («Condition parts» от line) и 1),
      "» сразу сделан вывод о конце «", («Form at» от («Condition parts» от line) и 2),
      (соединить ["», а промежуточные переходы и то, что могло бы цепочку ", "остановить, не названы"] по "")] по ""))

тотальная функция «Slope hints ids»
  принимает lines: список «Claim line»
  возвращает список строки
  пример «From one small step straight to the very end»
    дано lines равно ([(запись «Claim line» с «text» равным
        "Разрешишь один раз — и он никогда не будет ложиться вовремя" и «concludes» равным нет)])
    ожидается ["slippery-slope"]
  пример «A condition with its plain consequence»
    дано lines равно ([(запись «Claim line» с «text» равным "Если не полить цветок неделю, то он засохнет"
        и «concludes» равным нет)])
    ожидается пустой список
  отобразить («Slope hints» от lines) как hint → hint.«id»

тотальная функция «Crowd words»
  возвращает список строки
  пример «Subjects that stand for many people at once»
    ожидается ["все", "многие", "большинство", "каждый", "никто"]
  ["все", "многие", "большинство", "каждый", "никто"]

тотальная функция «Rightness words»
  возвращает список строки
  пример «Words that call a deed right»
    ожидается ["правильно", "нормально", "верно", "можно", "хорошо", "допустимо", "прилично"]
  ["правильно", "нормально", "верно", "можно", "хорошо", "допустимо", "прилично"]

тотальная функция «Crowd does it»
  принимает line: «Claim line»
  возвращает признак
  пример «"Все так делают"»
    дано line равно запись «Claim line» с «text» равным "Все так делают" и «concludes» равным нет
    ожидается да
  пример «"Все люди смертны" is a claim about everyone, not a custom»
    дано line равно запись «Claim line» с «text» равным "Все люди смертны" и «concludes» равным нет
    ожидается нет
  пусть core равно (отобразить («Core words» от («Clause words» от (line.«text»))) как token → «Lowered» от token)
  пусть who равно («Form at» от core и 1)
  пусть pointed равно ((core содержит "так") или (core содержит "это"))
  пусть done равно (свёртка core начиная с нет как found и token → found или ((не (token равен who))
      и притом («Forms a sentence» от who и token)))
  (не (line.«concludes»)) и притом (((«Crowd words») содержит who) и притом (pointed и притом done))

тотальная функция «Crowd hints»
  принимает lines: список «Claim line»
  возвращает список «Hint»
  пусть crowd равно («First of premises» от (отфильтровать lines где line → «Crowd does it» от line))
  пусть drawn равно (отфильтровать lines где line → (line.«concludes»)
      и притом («Has one of» от («Lowered» от («Plain claim» от line)) и («Rightness words»)))
  (свёртка crowd начиная с (пустой список) как got и told → «Соединить списки» от got
      и (отобразить («First of premises» от drawn) как line → «Hint» от "appeal-to-popularity"
      и "апелляция к большинству («все так делают»)" и "" и (соединить [(told.«text»), " → ",
      («Plain claim» от line)] по "")
      и (соединить ["из того, как поступают многие, выведено, что так и надо; сколько ",
      "людей так делает, не говорит, правильно ли это. Отдельной ", "карточки этой ошибки в каталоге нет"] по "")))

тотальная функция «Crowd hints ids»
  принимает lines: список «Claim line»
  возвращает список строки
  пример «Everyone does it, so it is right»
    дано lines равно ([(запись «Claim line» с «text» равным "Все так делают" и «concludes» равным нет),
        (запись «Claim line» с «text» равным "Следовательно, это нормально" и «concludes» равным да)])
    ожидается ["appeal-to-popularity"]
  отобразить («Crowd hints» от lines) как hint → hint.«id»

тотальная функция «Hints of»
  принимает text: строка
  возвращает список «Hint»
  пример «A syllogism gives no hint»
    дано text равно "Все люди смертны. Сократ — человек. Значит, Сократ смертен."
    ожидается пустой список
  пусть lines равно («Claim lines of» от text)
  («Соединить списки» от («Соединить списки» от («Соединить списки» от («Ad hominem hints» от lines)
      и («Authority hints» от lines)) и («Соединить списки» от («Dilemma hints» от lines) и («Slope hints» от lines)))
      и («Crowd hints» от lines))

тотальная функция «Plain fault»
  принимает fault: строка
  возвращает строка
  пусть parts равно (разделить fault по "»: слово «")
  если (длина parts) больше 1
    то (соединить [(«First of» от parts), "»: ", («Plain reason» от (соединить ["слово «",
        (соединить («Without the first» от parts) по "»: слово «")] по ""))] по "")
    иначе fault

