  "возможная ошибка, проверьте сами"

тотальная функция «Hint json»
  принимает hint: «Hint»
  возвращает строка
  («Json object» от [(«Json field» от "id" и («Json string» от (hint.«id»))),
      («Json field» от "name" и («Json string» от (hint.«name»))),
      («Json field» от "slug" и («Json string» от (hint.«slug»))),
      («Json field» от "url" и («Json string» от (если пусто (hint.«slug») то "" иначе соединить [(«Catalog address»),
      "#", (hint.«slug»)] по ""))), («Json field» от "phrase" и («Json string» от (hint.«phrase»))),
      («Json field» от "why" и («Json string» от (hint.«why»))),
      («Json field» от "note" и («Json string» от («Hint note»))), («Json field» от "verdict" и "false")])

тотальная функция «Unparsed json»
  принимает found: «Unparsed»
  возвращает строка
  пример «An unread sentence with its number and reason»
    дано found равно (запись «Unparsed» с «number» равным 2 и «sentence» равным "Ты неправ"
        и «reason» равным "слово «Ты» не объявлено")
    ожидается "{\"sentence\": 2, \"text\": \"Ты неправ\", \"reason\": \"слово «Ты» не объявлено\"}"
  («Json object» от [(«Json field» от "sentence" и (к строке (found.«number»))),
      («Json field» от "text" и («Json string» от (found.«sentence»))),
      («Json field» от "reason" и («Json string» от (found.«reason»)))])

тотальная функция «Report json»
  принимает report: «Check report»
  возвращает строка
  («Json object» от [(«Json field» от "language" и («Json string» от (report.«language»))),
      («Json field» от "verdict" и («Json string» от (report.«verdict»))),
      («Json field» от "fallacy" и («Fallacy json» от (report.«fallacy»))),
      («Json field» от "premises" и («Json strings» от (report.«premises»))),
