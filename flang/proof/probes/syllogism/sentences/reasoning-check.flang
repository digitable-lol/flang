      («Json field» от "unparsed" и (соединить ["[",
      (соединить (отобразить (report.«unparsed») как found → «Unparsed json» от found) по ", "), "]"] по "")),
      («Json field» от "hints" и (соединить ["[",
      (соединить (отобразить (report.«hints») как hint → «Hint json» от hint) по ", "), "]"] по "")),
      («Json field» от "dictionary" и («Json strings» от (report.«dictionary»))),
      («Json field» от "kernel" и («Json string» от (report.«kernel»))),
