модуль «Text block token probe»
  использует «Лексер flang» из "../../../self/lexer.flang"

объект «Счёт»
  «сверено»: число
  «разошлись»: список строки

тип «Ход»
  вариант «Начало сверки»
  вариант «Ждём доводы»
  вариант «Ждём перечень»
  вариант «Ждём исходник» содержит путь: строка, осталось: список строки, счёт: «Счёт»
  вариант «Ждём двоичный» содержит путь: строка, свой: строка, осталось: список строки, счёт: «Счёт»

тотальная функция «Строка токена»
  принимает токен: «Токен»
  возвращает строка
  пример «место и короткая запись токена через табуляцию»
    дано токен равно (запись «Токен» с «вид» равным "string" и «значение» равным "а" и «число» равным 0 и «текст» равным "" и «в ёлочках» равным да и «нижний» равным "" и «строка» равным 5 и «столбец» равным 3)
    ожидается "5:3\tстрока а"
  соединить [(к строке (токен.«строка»)), ":", (к строке (токен.«столбец»)), "\t", («Показать токен» от токен)] по ""

тотальная функция «Строка беды»
  принимает беда: «Диагностика», путь: строка
  возвращает строка
  пример «отказ лексера теми же словами, что у двоичного»
    дано беда равно (запись «Диагностика» с «код» равным "FLANG_LEX" и «сообщение» равным "не закрыта кавычка" и «строка» равным 2 и «столбец» равным 3)
    дано путь равно "a.flang"
    ожидается "FLANG_LEX в файле a.flang, строка 2, столбец 3: не закрыта кавычка"
  соединить [(беда.«код»), " в файле ", путь, ", строка ", (к строке (беда.«строка»)), ", столбец ", (к строке (беда.«столбец»)), ": ", (беда.«сообщение»)] по ""

тотальная функция «Свой поток»
  принимает текст: строка, путь: строка
  возвращает строка
  пример «поток токенов строками, как печатает flang tokens»
    дано текст равно "модуль «М»\n"
    дано путь равно "a.flang"
    ожидается "1:1\tслово module\n1:8\tёлочка М\n1:11\t/\n2:1\t.\n"
  пример «отказ лексера одной строкой»
    дано текст равно "«"
    дано путь равно "a.flang"
    ожидается "FLANG_LEX в файле a.flang, строка 1, столбец 1: не закрыта кавычка-ёлочка\n"
  пример «блок текста читается одним токеном строки»
    дано текст равно "\"\"\"\n  а\n  \"\"\"\n"
    дано путь равно "a.flang"
    ожидается "1:1\tстрока а\n\n3:6\t/\n4:1\t.\n"
  пусть разбор_текста равно «Разобрать» от текст
  пусть строки равно если пусто (разбор_текста.«диагностики»)
    то (отобразить (разбор_текста.«токены») как токен → «Строка токена» от токен)
    иначе (отобразить (разбор_текста.«диагностики») как беда → «Строка беды» от беда и путь)
  соединить [(соединить строки по "\n"), "\n"] по ""

тотальная функция «Команда перечня»
  возвращает строка
  пример «перечень берётся у git, от корня дерева»
    ожидается "cd ../../../.. && git -c core.quotepath=false ls-files '*.flang' '*.fscript' '*.fp' '*.фп' '*.фланг'"
  "cd ../../../.. && git -c core.quotepath=false ls-files '*.flang' '*.fscript' '*.fp' '*.фп' '*.фланг'"

тотальная функция «Команда двоичного»
  принимает путь: строка
  возвращает строка
  пример «двоичный печатает поток токенов того же файла, отказ — тем же потоком»
    дано путь равно "flang/self/lexer.flang"
    ожидается "cd ../../../.. && ${FLANG_BIN:-bootstrap/flang} tokens 'flang/self/lexer.flang' 2>&1"
  соединить ["cd ../../../.. && ${FLANG_BIN:-bootstrap/flang} tokens '", путь, "' 2>&1"] по ""

тотальная функция «Запустить»
  принимает команда: строка, потом: «Ход»
  возвращает «Продолжение»
  пример «команда идёт через sh»
    дано команда равно "true"
    дано потом равно вариант «Ждём перечень»
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "true"]) и потом равным (вариант «Ждём перечень»)
  вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", команда]) и потом равным потом

тотальная функция «Нечем смотреть»
  принимает весть: строка
  возвращает «Продолжение»
  пример «слепота названа своим кодом»
    дано весть равно "перечень не получен"
    ожидается вариант «Не проверено» с код равным "FLANG_PROBE_TEXT_BLOCK_CANNOT_LOOK" и сообщение равным "text-block: перечень не получен"
  вариант «Не проверено» с код равным "FLANG_PROBE_TEXT_BLOCK_CANNOT_LOOK" и сообщение равным (соединить ["text-block: ", весть] по "")

тотальная функция «Итог»
  принимает счёт: «Счёт»
  возвращает «Продолжение»
  пример «расхождений нет — конец работы со счётом»
    дано счёт равно запись «Счёт» с «сверено» равным 3 и «разошлись» равным пустой список
    ожидается вариант «Конец работы» с значение равным "text-block: файлов 3, поток токенов разошёлся у 0"
  пример «расхождение названо файлом»
    дано счёт равно запись «Счёт» с «сверено» равным 3 и «разошлись» равным ["a.flang"]
    ожидается вариант «Провал» с код равным "FLANG_PROBE_TEXT_BLOCK" и сообщение равным "text-block: файлов 3, поток токенов разошёлся у 1\n  · a.flang"
  пусть слова равно соединить ["text-block: файлов ", (к строке (счёт.«сверено»)), ", поток токенов разошёлся у ", (к строке (длина (счёт.«разошлись»)))] по ""
  если пусто (счёт.«разошлись»)
    то вариант «Конец работы» с значение равным слова
    иначе вариант «Провал» с код равным "FLANG_PROBE_TEXT_BLOCK" и сообщение равным (соединить (приписать слова к (отобразить (счёт.«разошлись») как путь → соединить "  · " с путь)) по "\n")

тотальная функция «Пойти по файлам»
  принимает очередь: список строки, счёт: «Счёт»
  возвращает «Продолжение»
  пример «очередь пуста — итог»
    дано очередь равно пустой список
    дано счёт равно запись «Счёт» с «сверено» равным 1 и «разошлись» равным пустой список
    ожидается вариант «Конец работы» с значение равным "text-block: файлов 1, поток токенов разошёлся у 0"
  пример «очередной файл читается от каталога плана»
    дано очередь равно ["a.flang", "b.flang"]
    дано счёт равно запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "../../../../a.flang") и потом равным (вариант «Ждём исходник» с путь равным "a.flang" и осталось равным ["b.flang"] и счёт равным (запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список))
  разбор очередь
    случай пусто
      то «Итог» от счёт
    случай голова и хвост
      то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным (соединить "../../../../" с голова)) и потом равным (вариант «Ждём исходник» с путь равным голова и осталось равным хвост и счёт равным счёт)

тотальная функция «Непустые»
  принимает строки: список строки
  возвращает список строки
  пример «пустые строки перечня отброшены»
    дано строки равно ["a.flang", "", "b.flang", ""]
    ожидается ["a.flang", "b.flang"]
  отфильтровать строки где строка → не (строка равен "")

тотальная функция «После доводов»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пример «без доводов перечень берётся у git»
    дано отклик равно вариант «Доводы» с доводы равным пустой список
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "cd ../../../.. && git -c core.quotepath=false ls-files '*.flang' '*.fscript' '*.fp' '*.фп' '*.фланг'"]) и потом равным (вариант «Ждём перечень»)
  пример «доводы — сами файлы»
    дано отклик равно вариант «Доводы» с доводы равным ["a.flang"]
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "../../../../a.flang") и потом равным (вариант «Ждём исходник» с путь равным "a.flang" и осталось равным пустой список и счёт равным (запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список))
  разбор отклик
    случай вариант «Доводы» с доводы как доводы
      то разбор доводы
        случай пусто
          то «Запустить» от «Команда перечня» и (вариант «Ждём перечень»)
        случай голова и хвост
          то «Пойти по файлам» от доводы и (запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список)
    случай любое
      то «Нечем смотреть» от "доводы плана не прочитаны"

тотальная функция «После перечня»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пример «перечень git становится очередью файлов»
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "a.flang\n" и ошибки равным ""
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "../../../../a.flang") и потом равным (вариант «Ждём исходник» с путь равным "a.flang" и осталось равным пустой список и счёт равным (запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список))
  пример «git не ответил — смотреть нечем»
    дано отклик равно вариант «Сбой» с код равным "FLANG_IO" и сообщение равным "нет sh"
    ожидается вариант «Не проверено» с код равным "FLANG_PROBE_TEXT_BLOCK_CANNOT_LOOK" и сообщение равным "text-block: перечень файлов у git не получен"
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то «Пойти по файлам» от («Непустые» от (разделить вывод по "\n")) и (запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список)
    случай любое
      то «Нечем смотреть» от "перечень файлов у git не получен"

тотальная функция «После исходника»
  принимает путь: строка, осталось: список строки, счёт: «Счёт», отклик: «Отклик»
  возвращает «Продолжение»
  пример «исходник прочитан — свой поток посчитан, спрашивается двоичный»
    дано путь равно "a.flang"
    дано осталось равно пустой список
    дано счёт равно запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список
    дано отклик равно вариант «Прочитано» с содержимое равным ""
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "cd ../../../.. && ${FLANG_BIN:-bootstrap/flang} tokens 'a.flang' 2>&1"]) и потом равным (вариант «Ждём двоичный» с путь равным "a.flang" и свой равным "1:1\t.\n" и осталось равным пустой список и счёт равным (запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список))
  разбор отклик
    случай вариант «Прочитано» с содержимое как текст
      то «Запустить» от («Команда двоичного» от путь) и (вариант «Ждём двоичный» с путь равным путь и свой равным («Свой поток» от текст и путь) и осталось равным осталось и счёт равным счёт)
    случай любое
      то «Нечем смотреть» от (соединить "исходник не прочитан: " с путь)

тотальная функция «Учесть»
  принимает счёт: «Счёт», путь: строка, сошлось: признак
  возвращает «Счёт»
  пример «сошедшийся файл только сосчитан»
    дано счёт равно запись «Счёт» с «сверено» равным 2 и «разошлись» равным пустой список
    дано путь равно "a.flang"
    дано сошлось равно да
    ожидается запись «Счёт» с «сверено» равным 3 и «разошлись» равным пустой список
  пример «разошедшийся файл назван»
    дано счёт равно запись «Счёт» с «сверено» равным 2 и «разошлись» равным пустой список
    дано путь равно "a.flang"
    дано сошлось равно нет
    ожидается запись «Счёт» с «сверено» равным 3 и «разошлись» равным ["a.flang"]
  запись «Счёт» с «сверено» равным ((счёт.«сверено») плюс 1) и «разошлись» равным (если сошлось то (счёт.«разошлись») иначе (добавить путь к (счёт.«разошлись»)))

тотальная функция «После двоичного»
  принимает путь: строка, свой: строка, осталось: список строки, счёт: «Счёт», отклик: «Отклик»
  возвращает «Продолжение»
  пример «потоки совпали — файл сосчитан, очередь кончилась»
    дано путь равно "a.flang"
    дано свой равно "1:1\t.\n"
    дано осталось равно пустой список
    дано счёт равно запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "1:1\t.\n" и ошибки равным ""
    ожидается вариант «Конец работы» с значение равным "text-block: файлов 1, поток токенов разошёлся у 0"
  пример «потоки разошлись — файл назван»
    дано путь равно "a.flang"
    дано свой равно "1:1\t.\n"
    дано осталось равно пустой список
    дано счёт равно запись «Счёт» с «сверено» равным 0 и «разошлись» равным пустой список
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "1:1\tимя а\n" и ошибки равным ""
    ожидается вариант «Провал» с код равным "FLANG_PROBE_TEXT_BLOCK" и сообщение равным "text-block: файлов 1, поток токенов разошёлся у 1\n  · a.flang"
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то «Пойти по файлам» от осталось и («Учесть» от счёт и путь и (вывод равен свой))
    случай любое
      то «Нечем смотреть» от (соединить "двоичный не ответил на файле " с путь)

тотальная функция «Начать»
  возвращает «Ход»
  пример «план начинается с начала сверки»
    ожидается вариант «Начало сверки»
  вариант «Начало сверки»

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Начало сверки»
      то вариант «Сделать» с поручение равным (вариант «Прочитать доводы») и потом равным (вариант «Ждём доводы»)
    случай вариант «Ждём доводы»
      то «После доводов» от отклик
    случай вариант «Ждём перечень»
      то «После перечня» от отклик
    случай вариант «Ждём исходник» с путь как путь и осталось как осталось и счёт как счёт
      то «После исходника» от путь и осталось и счёт и отклик
    случай вариант «Ждём двоичный» с путь как путь и свой как свой и осталось как осталось и счёт как счёт
      то «После двоичного» от путь и свой и осталось и счёт и отклик

план «Tokens»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
