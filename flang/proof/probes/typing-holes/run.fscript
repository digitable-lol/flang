модуль «Пробы известных дыр типизации»

использует «Таблица проб» из "../table.fscript"

тотальная функция «Имя набора»
  возвращает строка
  пример «набор назван своим каталогом»
    ожидается "typing-holes"
  "typing-holes"

тотальная функция «Код расхождения»
  возвращает строка
  пример «код расхождения из семейства FLANG»
    ожидается "FLANG_PROBE_TYPING_HOLES"
  "FLANG_PROBE_TYPING_HOLES"

тотальная функция «Код слепоты»
  возвращает строка
  пример «у слепоты код свой, не как у расхождения»
    ожидается "FLANG_PROBE_TYPING_HOLES_CANNOT_LOOK"
  "FLANG_PROBE_TYPING_HOLES_CANNOT_LOOK"

тотальная функция «Этот набор»
  возвращает «Набор»
  пусть имя равно («Имя набора»)
  пусть красное равно («Код расхождения»)
  пусть слепое равно («Код слепоты»)
  запись «Набор» с «имя» равным имя и «код расхождения» равным красное и «код слепоты» равным слепое

тотальная функция «Каталог программ»
  возвращает строка
  пример «путь считается от корня дерева, а не от каталога набора»
    ожидается "flang/proof/probes/typing-holes/programs"
  "flang/proof/probes/typing-holes/programs"

тотальная функция «Хвост запуска»
  принимает поверхность: строка
  возвращает строка
  пример «запуск с доводом вне объявленного типа»
    дано поверхность равно "run-negative"
    ожидается " --function '«Удвоить неотрицательное»' --args '{\"н\":-1}'"
  пример «запуск с доводом внутри типа»
    дано поверхность равно "run-inside"
    ожидается " --function '«Удвоить неотрицательное»' --args '{\"н\":21}'"
  пример «у проверки хвоста нет»
    дано поверхность равно "check"
    ожидается ""
  пример «проверка с доказательствами печатает счёт ядра»
    дано поверхность равно "proof"
    ожидается " --proof"
  пример «запуск с доводом вне требования»
    дано поверхность равно "run-requirement-outside"
    ожидается " --function '«Неотрицательное по требованию»' --args '{\"а\":-7}'"
  пример «запуск слова без доводов»
    дано поверхность равно "run-word-answer"
    ожидается " --function '«Пять»'"
  разбор поверхность
    случай "run-negative"
      то " --function '«Удвоить неотрицательное»' --args '{\"н\":-1}'"
    случай "run-inside"
      то " --function '«Удвоить неотрицательное»' --args '{\"н\":21}'"
    случай "proof"
      то " --proof"
    случай "run-requirement-outside"
      то " --function '«Неотрицательное по требованию»' --args '{\"а\":-7}'"
    случай "run-weight-from-number"
      то " --function '«Вес из числа»' --args '{\"элементы\":[1],\"б\":-7}'"
    случай "run-weight-first-branch"
      то " --function '«Вес из большого литерала»' --args '{\"а\":0}'"
    случай "run-function-value"
      то " --function '«Ниже нуля»'"
    случай "run-empty-list"
      то " --function '«Дописать к пустому»' --args '{\"а\":-2}'"
    случай "run-negative-zero-word"
      то " --function '«Байт нулём»' --args '{\"б\":-0}'"
    случай "run-negative-zero-answer"
      то " --function '«Как есть»' --args '{\"б\":-0}'"
    случай "emit-c-parametric-entry"
      то («Вход печати на C» от "th-parametric-entry" и
        "{\"fn\":\"Значение или ноль\",\"args\":[{\"v\":\"Нечто\",\"f\":[[\"значение\",{\"n\":\"-3\"}]]}]}")
    случай "emit-rust-shortest-tie"
      то («Вход печати на Rust» от "th-shortest-tie" и "{\"fn\":\"Треть степени двойки\",\"args\":[]}")
    случай "run-shortest-tie"
      то " --function '«Треть степени двойки»'"
    случай "run-fieldless-variant"
      то " --function '«Пусто ли»' --args '{\"р\":{\"вариант\":\"Пусто\"}}'"
    случай "run-fieldless-variant-tagged"
      то " --function '«Пусто ли»' --args '{\"р\":{\"variant\":\"Пусто\",\"fields\":{}}}'"
    случай "run-percent-zero"
      то " --function '«Знак процентов от нуля»' --args '{\"а\":0}'"
    случай "emit-c-exact-entry"
      то («Вход печати на C» от "th-exact-entry" и "{\"fn\":\"Тот же\",\"args\":[{\"l\":[{\"n\":\"-1\"}]}]}")
    случай "run-exact-entry"
      то " --function '«Тот же»' --args '{\"а\":[-1]}'"
    случай "run-requirement-bypass"
      то " --function '«Мимо требования»'"
    случай "run-generic-field"
      то " --function '«Минус семь неотрицательным»'"
    случай "run-generic-call-in-match"
      то " --function '«Половина целым»' --args '{\"а\":{\"variant\":\"Нечто\",\"fields\":{\"значение\":-3}}}'"
    случай "run-word-answer"
      то " --function '«Пять»'"
    случай "run-word-argument"
      то " --function '«То же слово»' --args '{\"а\":5}'"
    случай любое
      то ""

тотальная функция «Вход печати на C»
  принимает каталог: строка, запрос: строка
  возвращает строка
  пусть место равно соединить ["\"${FLANG_TMP:-/tmp}/", каталог] по ""
  соединить [" --target c --out ", место, "\" > /dev/null && make -s -C ", место,
      "\" CFLAGS='-std=c99 -O1' > /dev/null",
    " && printf '%s\\n' '", запрос, "' | ", место, "/flang_cli\""] по ""

тотальная функция «Вход печати на Rust»
  принимает каталог: строка, запрос: строка
  возвращает строка
  пусть место равно соединить ["\"${FLANG_TMP:-/tmp}/", каталог] по ""
  соединить [" --target rust --out ", место, "\" > /dev/null && (cd ", место,
    "\" && cargo build --offline -q) > /dev/null",
    " && printf '%s\\n' '", запрос, "' | ", место, "/target/debug/flang_cli\""] по ""

тотальная функция «Вызов»
  принимает поверхность: строка, программа: строка
  возвращает строка
  пример «проверка файла»
    дано поверхность равно "check"
    дано программа равно "probe.flang"
    ожидается "$flang check 'flang/proof/probes/typing-holes/programs/probe.flang'"
  пусть путь равно (соединить ["'", («Каталог программ»), "/", программа, "'"] по "")
  пусть команда равно (если поверхность начинается с "run" то "run" иначе (если поверхность начинается с "emit" то
      "emit" иначе
      "check"))
  соединить ["$flang ", команда, " ", путь, («Хвост запуска» от поверхность)] по ""

тотальная функция «Команда»
  принимает части: список строки
  возвращает строка
  пусть программа равно («Поле» от части и 1)
  пусть поверхность равно («Поле» от части и 2)
  «От корня» от («С меткой» от («Вызов» от поверхность и программа))

тотальная функция «Проба из строки»
  принимает части: список строки
  возвращает «Проба»
  пусть имя равно («Поле» от части и 1)
  пусть зов равно («Команда» от части)
  пусть код равно («Поле» от части и 3)
  пусть слово равно («Поле» от части и 4)
  пусть приметы равно («Приметы» от имя и [(«Поле» от части и 2)])
  (запись «Проба» с «программа» равным имя и «приметы» равным приметы и «команда» равным зов и «код» равным код
    и «слово» равным слово)

тотальная функция «Пробы»
  принимает текст: строка
  возвращает список «Проба»
  отобразить («Строки данных» от текст) как части → («Проба из строки» от части)

тотальная функция «Начать»
  возвращает «Ход»
  пример «план начинается с начала»
    ожидается вариант «Начало»
  вариант «Начало»

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём таблицу»
      то «После таблицы» от («Этот набор») и («Пробы» от («Содержимое» от отклик))
    случай любое
      то «Шаг» от («Этот набор») и ход и отклик

план «Binary»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
