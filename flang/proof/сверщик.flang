// ── законы: закрытый список ─────────────────────────────────────────────────
//
// ЗАКОН — ИМЕНОВАННАЯ ТЕОРЕМА, А НЕ ПОИСК. Ядро ищет, каким сложением собрана
// цель; сверщику это уже сказано, и он только сличает форму и выписывает
// посылки. Оттого закон стоит здесь пять строк, а в ядре — сорок: там перебор со
// всеми случаями сразу, здесь проверка одного названного.
//
// Список закрыт: закон, которого здесь нет, ОТВЕРГАЕТСЯ. Так доверие к сведению
// перестаёт быть «верю трём тысячам строк» и становится «верю вот этим
// названным теоремам, и запись не вправе сослаться ни на что другое».

объект «Применение»
  «вышло»: признак
  «почему»: строка
  «посылки»: список строки

тотальная функция «Закон не подошёл»
  принимает «почему»: строка
  возвращает «Применение»
  обеспечивает «поле 1» ((результат.«вышло») равен нет)
  обеспечивает «поле 2» ((результат.«почему») равен «почему»)
  обеспечивает «поле 3» ((результат.«посылки») равен (пустой список))
  пример «Закон не подошёл — посылок нет»
    дано «почему» равно "закон суммы берёт только цель вида «Е не меньше 0»"
    ожидается запись «Применение» с «вышло» равным нет и «почему» равным "закон суммы берёт только цель вида «Е не меньше 0»" и «посылки» равным пустой список
  запись «Применение» с «вышло» равным нет и «почему» равным «почему» и «посылки» равным пустой список

// Сумма неотрицательных неотрицательна. В IEEE-754 это теорема без оговорок:
// сумма двух значений из [0, +∞] снова в [0, +∞], переполнение даёт +∞.
тотальная функция «Закон суммы»
  принимает «цель»: строка
  возвращает «Применение»
  обеспечивает «ветвь один» ((не (не (((«Разрез по» от «цель» и "не меньше").«есть») и притом (((«Разрез по» от «цель» и "не меньше").«право») равен "0")))) или (результат равен («Закон не подошёл» от "закон суммы берёт только цель вида «Е не меньше 0»")))
  обеспечивает «ветвь два» ((не (((«Разрез по» от «цель» и "не меньше").«есть») и притом (((«Разрез по» от «цель» и "не меньше").«право») равен "0"))) или ((не (не (((«Разрез по» от ((«Разрез по» от «цель» и "не меньше").«лево») и "плюс").«есть») и притом ((длина («Разделить сверху» от («Ужать» от ((«Разрез по» от «цель» и "не меньше").«лево»)) и "плюс")) равен 2)))) или (результат равен («Закон не подошёл» от "закон суммы берёт только сумму ровно двух слагаемых"))))
  обеспечивает «ветвь три» ((не (((«Разрез по» от «цель» и "не меньше").«есть») и притом (((«Разрез по» от «цель» и "не меньше").«право») равен "0"))) или ((не (((«Разрез по» от ((«Разрез по» от «цель» и "не меньше").«лево») и "плюс").«есть») и притом ((длина («Разделить сверху» от («Ужать» от ((«Разрез по» от «цель» и "не меньше").«лево»)) и "плюс")) равен 2))) или (результат равен (запись «Применение» с «вышло» равным да и «почему» равным "" и «посылки» равным [(соединить [((«Разрез по» от ((«Разрез по» от «цель» и "не меньше").«лево») и "плюс").«лево»), " не меньше 0"] по ""), (соединить [((«Разрез по» от ((«Разрез по» от «цель» и "не меньше").«лево») и "плюс").«право»), " не меньше 0"] по "")]))))
  пример «Сумма двух слагаемых разводится на две посылки»
    дано «цель» равно "а плюс б не меньше 0"
    ожидается запись «Применение» с «вышло» равным да и «почему» равным "" и «посылки» равным ["а не меньше 0", "б не меньше 0"]
  пусть «р» равно («Разрез по» от «цель» и "не меньше")
  пусть «с» равно («Разрез по» от («р».«лево») и "плюс")
  если не ((«р».«есть») и притом ((«р».«право») равен "0"))
    то «Закон не подошёл» от "закон суммы берёт только цель вида «Е не меньше 0»"
    иначе
      если не ((«с».«есть») и притом ((длина («Разделить сверху» от («Ужать» от («р».«лево»)) и "плюс")) равен 2))
        то «Закон не подошёл» от "закон суммы берёт только сумму ровно двух слагаемых"
        иначе запись «Применение» с «вышло» равным да и «почему» равным "" и «посылки» равным [(соединить [(«с».«лево»), " не меньше 0"] по ""), (соединить [(«с».«право»), " не меньше 0"] по "")]

// Литерал не меньше нуля. Проверяется счётом, а не списком: буква числом не
// станет, «Число из слова» отдаёт на не-числе минус один.
тотальная функция «Закон литерала»
  принимает «цель»: строка
  возвращает «Применение»
  обеспечивает «ветвь да» ((не (((«Разрез по» от «цель» и "не меньше").«есть») и притом (((«Разрез по» от «цель» и "не меньше").«право») равен "0") и притом ((«Число из слова» от («Ужать» от ((«Разрез по» от «цель» и "не меньше").«лево»))) не меньше 0))) или (результат равен (запись «Применение» с «вышло» равным да и «почему» равным "" и «посылки» равным пустой список)))
  обеспечивает «ветвь нет» ((((«Разрез по» от «цель» и "не меньше").«есть») и притом (((«Разрез по» от «цель» и "не меньше").«право») равен "0") и притом ((«Число из слова» от («Ужать» от ((«Разрез по» от «цель» и "не меньше").«лево»))) не меньше 0)) или (результат равен («Закон не подошёл» от "закон литерала берёт только неотрицательный литерал слева и 0 справа")))
  пример «Неотрицательный литерал закрывает цель без посылок»
    дано «цель» равно "7 не меньше 0"
    ожидается запись «Применение» с «вышло» равным да и «почему» равным "" и «посылки» равным пустой список
  пусть «р» равно («Разрез по» от «цель» и "не меньше")
  пусть «н» равно («Число из слова» от («Ужать» от («р».«лево»)))
  если («р».«есть») и притом ((«р».«право») равен "0") и притом («н» не меньше 0)
    то запись «Применение» с «вышло» равным да и «почему» равным "" и «посылки» равным пустой список
    иначе «Закон не подошёл» от "закон литерала берёт только неотрицательный литерал слева и 0 справа"

тотальная функция «Применить закон»
  принимает «имя»: строка, «цель»: строка
  возвращает «Применение»
  обеспечивает «ветвь один» ((не («имя» равен "сумма неотрицательных")) или (результат равен («Закон суммы» от «цель»)))
  обеспечивает «ветвь два» ((«имя» равен "сумма неотрицательных") или ((не («имя» равен "литерал неотрицателен")) или (результат равен («Закон литерала» от «цель»))))
  обеспечивает «ветвь три» ((«имя» равен "сумма неотрицательных") или ((«имя» равен "литерал неотрицателен") или (результат равен («Закон не подошёл» от (соединить ["закона «", «имя», "» сверщик не знает: список законов закрыт"] по "")))))
  пример «Закон вне закрытого списка не применяется»
    дано «имя» равно "закон о среднем"
    дано «цель» равно "а плюс б не меньше 0"
    ожидается запись «Применение» с «вышло» равным нет и «почему» равным "закона «закон о среднем» сверщик не знает: список законов закрыт" и «посылки» равным пустой список
  если «имя» равен "сумма неотрицательных"
    то «Закон суммы» от «цель»
    иначе
      если «имя» равен "литерал неотрицателен"
        то «Закон литерала» от «цель»
        иначе «Закон не подошёл» от (соединить ["закона «", «имя», "» сверщик не знает: список законов закрыт"] по "")

// ── обстановка утверждения ──────────────────────────────────────────────────

объект «Обстановка»
  «строки»: список строки
  «свои»: список строки
  «цель»: строка
  «функция»: строка
  «по»: строка
  «тип»: строка

// Строка исходника того случая теоремы, который разбирает названный вариант.
тотальная функция «Исходная строка случая»
  принимает «о»: «Обстановка», «случай»: строка
  возвращает строка
  «Строка по номеру» от («о».«строки») и («Число после» от «случай» и "строка ")

тотальная функция «Случай варианта»
  принимает «о»: «Обстановка», «вариант»: строка
  возвращает строка
  обеспечивает «ветвь да» ((не (пусто (отфильтровать (отобразить («Все с началом» от («о».«свои») и "случай строка") как «с» → («Исходная строка случая» от «о» и «с»)) где «л» → («Имя варианта» от («Слова после» от «л» и 1)) равен «вариант»))) или (результат равен ""))
  обеспечивает «ветвь нет» ((пусто (отфильтровать (отобразить («Все с началом» от («о».«свои») и "случай строка") как «с» → («Исходная строка случая» от «о» и «с»)) где «л» → («Имя варианта» от («Слова после» от «л» и 1)) равен «вариант»)) или (результат равен (голова (отфильтровать (отобразить («Все с началом» от («о».«свои») и "случай строка") как «с» → («Исходная строка случая» от «о» и «с»)) где «л» → («Имя варианта» от («Слова после» от «л» и 1)) равен «вариант»))))
  пример «Случая варианта в записи нет»
    дано «о» равно запись «Обстановка» с «строки» равным пустой список и «свои» равным пустой список и «цель» равным "" и «функция» равным "" и «по» равным "" и «тип» равным ""
    дано «вариант» равно "пусто"
    ожидается ""
  пусть «свои» равно (отобразить («Все с началом» от («о».«свои») и "случай строка") как «с» → («Исходная строка случая» от «о» и «с»))
  пусть «годные» равно (отфильтровать «свои» где «л» → («Имя варианта» от («Слова после» от «л» и 1)) равен «вариант»)
  если пусто «годные» то "" иначе (голова «годные»)

// Образец случая становится КОНСТРУКТОРОМ: `с голова как г` — это `с голова
// равным г`. Одно и то же значение, записанное с двух сторон уравнения.
тотальная функция «Конструктор случая»
  принимает «случай»: строка
  возвращает строка
  пример «Образец читается конструктором»
    дано «случай» равно "случай вариант «Звено» с голова как г и хвост как х"
    ожидается "вариант «Звено» с голова равным г и хвост равным х"
  «Заменить всюду» от («Слова после» от «случай» и 1) и " как " и " равным "

// Что стоит на месте поля образца: `с голова как г` при имени «г» — «голова».
тотальная функция «Поле образца»
  принимает «случай»: строка, «имя»: строка
  возвращает строка
  обеспечивает «ветвь да» ((не (пусто (отфильтровать («Разделить сверху» от («Справа от» от («Слова после» от «случай» и 1) и "с") и "и") где «ч» → («Обрезать пробелы» от («Справа от» от «ч» и "как")) равен «имя»))) или (результат равен ""))
  обеспечивает «ветвь нет» ((пусто (отфильтровать («Разделить сверху» от («Справа от» от («Слова после» от «случай» и 1) и "с") и "и") где «ч» → («Обрезать пробелы» от («Справа от» от «ч» и "как")) равен «имя»)) или (результат равен («Обрезать пробелы» от («Слева от» от (голова (отфильтровать («Разделить сверху» от («Справа от» от («Слова после» от «случай» и 1) и "с") и "и") где «ч» → («Обрезать пробелы» от («Справа от» от «ч» и "как")) равен «имя»)) и "как"))))
  пример «Имя ведёт к своему полю»
    дано «случай» равно "случай вариант «Звено» с голова как г и хвост как х"
    дано «имя» равно "х"
    ожидается "хвост"
  пусть «части» равно («Разделить сверху» от («Справа от» от («Слова после» от «случай» и 1) и "с") и "и")
  пусть «годные» равно (отфильтровать «части» где «ч» → («Обрезать пробелы» от («Справа от» от «ч» и "как")) равен «имя»)
  если пусто «годные» то "" иначе («Обрезать пробелы» от («Слева от» от (голова «годные») и "как"))

объект «Ловля»
  «внутри»: признак
  «текст»: строка

тотальная функция «Шаг ловли варианта»
  принимает «л»: «Ловля», «сырая»: строка, «заголовок»: строка, «вариант»: строка
  возвращает «Ловля»
  обеспечивает «ветвь один» ((не ((«Обрезать пробелы» от «сырая») равен «заголовок»)) или (результат равен (запись «Ловля» с «внутри» равным да и «текст» равным («л».«текст»))))
  обеспечивает «ветвь два» (((«Обрезать пробелы» от «сырая») равен «заголовок») или ((не (не («л».«внутри»))) или (результат равен «л»)))
  обеспечивает «ветвь три» (((«Обрезать пробелы» от «сырая») равен «заголовок») или ((не («л».«внутри»)) или (результат равен (если («Обрезать пробелы» от «сырая») начинается с "вариант " то (если («Имя варианта» от («Обрезать пробелы» от «сырая»)) равен «вариант» то (запись «Ловля» с «внутри» равным да и «текст» равным («Обрезать пробелы» от «сырая»)) иначе «л») иначе (если (длина («Обрезать пробелы» от «сырая»)) равен 0 то «л» иначе (запись «Ловля» с «внутри» равным нет и «текст» равным («л».«текст»)))))))
  пример «Заголовок типа вводит внутрь объявления»
    дано «л» равно запись «Ловля» с «внутри» равным нет и «текст» равным ""
    дано «сырая» равно "тип «Ход»"
    дано «заголовок» равно "тип «Ход»"
    дано «вариант» равно "Начало"
    ожидается запись «Ловля» с «внутри» равным да и «текст» равным ""
  пусть «строка» равно («Обрезать пробелы» от «сырая»)
  если «строка» равен «заголовок»
    то запись «Ловля» с «внутри» равным да и «текст» равным («л».«текст»)
    иначе
      если не («л».«внутри»)
        то «л»
        иначе
          если «строка» начинается с "вариант "
            то (если («Имя варианта» от «строка») равен «вариант» то (запись «Ловля» с «внутри» равным да и «текст» равным «строка») иначе «л»)
            иначе (если (длина «строка») равен 0 то «л» иначе (запись «Ловля» с «внутри» равным нет и «текст» равным («л».«текст»)))

тотальная функция «Строка варианта типа»
  принимает «о»: «Обстановка», «вариант»: строка
  возвращает строка
  (свёртка («о».«строки») начиная с (запись «Ловля» с «внутри» равным нет и «текст» равным "") как «л» и «с» → («Шаг ловли варианта» от «л» и «с» и (соединить ["тип «", («о».«тип»), "»"] по "") и «вариант»)).«текст»

// РЕКУРСИВНО ЛИ ПОЛЕ — вот на чём держится законность допущения индукции.
// Допущение берётся о ЧАСТИ значения, и часть обязана быть того же типа, иначе
// это не индукция, а круг. Проверяется по объявлению типа, а не по вере записи.
тотальная функция «Поле рекурсивно»
  принимает «о»: «Обстановка», «вариант»: строка, «поле»: строка
  возвращает признак
  обеспечивает «ветвь да» ((не (пусто (отфильтровать (разделить («Справа от» от («Строка варианта типа» от «о» и «вариант») и "содержит") по ",") где «ч» → («Обрезать пробелы» от («Часть списка» от (разделить «ч» по ":") и 1)) равен «поле»))) или (результат равен нет))
  обеспечивает «ветвь нет» ((пусто (отфильтровать (разделить («Справа от» от («Строка варианта типа» от «о» и «вариант») и "содержит") по ",") где «ч» → («Обрезать пробелы» от («Часть списка» от (разделить «ч» по ":") и 1)) равен «поле»)) или (результат равен ((«Обрезать пробелы» от («Часть списка» от (разделить (голова (отфильтровать (разделить («Справа от» от («Строка варианта типа» от «о» и «вариант») и "содержит") по ",") где «ч» → («Обрезать пробелы» от («Часть списка» от (разделить «ч» по ":") и 1)) равен «поле»)) по ":") и 2)) равен (соединить ["«", («о».«тип»), "»"] по ""))))
  пример «У пустой обстановки рекурсивных полей нет»
    дано «о» равно запись «Обстановка» с «строки» равным пустой список и «свои» равным пустой список и «цель» равным "" и «функция» равным "" и «по» равным "" и «тип» равным ""
    дано «вариант» равно "звено"
    дано «поле» равно "хвост"
    ожидается нет
  пусть «строка» равно («Строка варианта типа» от «о» и «вариант»)
  пусть «части» равно (разделить («Справа от» от «строка» и "содержит") по ",")
  пусть «годные» равно (отфильтровать «части» где «ч» → («Обрезать пробелы» от («Часть списка» от (разделить «ч» по ":") и 1)) равен «поле»)
  если пусто «годные»
    то нет
    иначе («Обрезать пробелы» от («Часть списка» от (разделить (голова «годные») по ":") и 2)) равен (соединить ["«", («о».«тип»), "»"] по "")

// Цель посылки — утверждение теоремы, в котором разбираемое имя заменено тем,
// о чём эта посылка: конструктором случая. `результат` при этом становится
// вызовом доказываемой функции на нём.
тотальная функция «Цель при значении»
  принимает «о»: «Обстановка», «значение»: строка
  возвращает строка
  пусть «взятое» равно («В скобки» от «значение»)
  пусть «вызов» равно («Терм» от (соединить ["«", («о».«функция»), "» от ", «взятое»] по ""))
  «Терм» от («Вставить вместо» от («Вставить вместо» от («о».«цель») и "результат" и «вызов») и («о».«по») и «значение»)

тотальная функция «Начальная цель»
  принимает «о»: «Обстановка», «вариант»: строка
  возвращает строка
  «Цель при значении» от «о» и («Терм» от («Конструктор случая» от («Случай варианта» от «о» и «вариант»)))

// ── прогон: список незакрытых целей ─────────────────────────────────────────

объект «Прогон»
  «цели»: список строки
  «дано»: список строки
  «беды»: список строки
  «ходов»: число
  «проиграно»: число
  «идёт»: признак
  «вариант»: строка

тотальная функция «Пустой прогон»
  возвращает «Прогон»
  обеспечивает «поле 1» ((результат.«цели») равен (пустой список))
  обеспечивает «поле 2» ((результат.«дано») равен (пустой список))
  обеспечивает «поле 3» ((результат.«беды») равен (пустой список))
  обеспечивает «поле 4» ((результат.«ходов») равен 0)
  обеспечивает «поле 5» ((результат.«проиграно») равен 0)
  обеспечивает «поле 6» ((результат.«идёт») равен нет)
  пример «Пустой прогон — нули и пустые списки»
    ожидается запись «Прогон» с «цели» равным пустой список и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным нет и «вариант» равным ""
  запись «Прогон» с «цели» равным пустой список и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным нет и «вариант» равным ""

тотальная функция «Беда прогона»
  принимает «п»: «Прогон», «текст»: строка
  возвращает «Прогон»
  обеспечивает «поле 1» ((результат.«цели») равен («п».«цели»))
  обеспечивает «поле 2» ((результат.«дано») равен («п».«дано»))
  обеспечивает «поле 3» ((результат.«беды») равен (добавить «текст» к («п».«беды»)))
  обеспечивает «поле 4» ((результат.«ходов») равен («п».«ходов»))
  обеспечивает «поле 5» ((результат.«проиграно») равен («п».«проиграно»))
  обеспечивает «поле 6» ((результат.«идёт») равен нет)
  обеспечивает «поле 7» ((результат.«вариант») равен («п».«вариант»))
  пример «Беда останавливает прогон»
    дано «п» равно запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
    дано «текст» равно "ход конец стоит без «ход цель»"
    ожидается запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным ["ход конец стоит без «ход цель»"] и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным нет и «вариант» равным ""
  запись «Прогон» с «цели» равным («п».«цели») и «дано» равным («п».«дано») и «беды» равным (добавить «текст» к («п».«беды»)) и «ходов» равным («п».«ходов») и «проиграно» равным («п».«проиграно») и «идёт» равным нет и «вариант» равным («п».«вариант»)

тотальная функция «Первая цель»
  принимает «п»: «Прогон»
  возвращает строка
  обеспечивает «ветвь да» ((не (пусто («п».«цели»))) или (результат равен ""))
  обеспечивает «ветвь нет» ((пусто («п».«цели»)) или (результат равен (голова («п».«цели»))))
  пример «Первая незакрытая цель»
    дано «п» равно запись «Прогон» с «цели» равным ["результат не меньше 0", "0 не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
    ожидается "результат не меньше 0"
  если пусто («п».«цели») то "" иначе (голова («п».«цели»))

тотальная функция «Прочие цели»
  принимает «п»: «Прогон»
  возвращает список строки
  обеспечивает «ветвь да» ((не (пусто («п».«цели»))) или (результат равен (пустой список)))
  обеспечивает «ветвь нет» ((пусто («п».«цели»)) или (результат равен (хвост («п».«цели»))))
  пример «Цели после первой»
    дано «п» равно запись «Прогон» с «цели» равным ["результат не меньше 0", "0 не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
    ожидается ["0 не меньше 0"]
  если пусто («п».«цели») то пустой список иначе (хвост («п».«цели»))

// Первая цель заменяется тем, во что она разошлась: пусто — закрыта, одна —
// переписана, две — поделена. Порядок значим: новые цели встают ПЕРЕД прочими,
// и следующий ход говорит о первой из них.
тотальная функция «Вместо первой»
  принимает «п»: «Прогон», «новые»: список строки
  возвращает «Прогон»
  обеспечивает «поле 1» ((результат.«цели») равен («Слить списки» от «новые» и («Прочие цели» от «п»)))
  обеспечивает «поле 2» ((результат.«дано») равен («п».«дано»))
  обеспечивает «поле 3» ((результат.«беды») равен («п».«беды»))
  обеспечивает «поле 4» ((результат.«ходов») равен ((«п».«ходов») плюс 1))
  обеспечивает «поле 5» ((результат.«проиграно») равен («п».«проиграно»))
  обеспечивает «поле 6» ((результат.«идёт») равен («п».«идёт»))
  обеспечивает «поле 7» ((результат.«вариант») равен («п».«вариант»))
  пример «Первая цель заменяется на две новые»
    дано «п» равно запись «Прогон» с «цели» равным ["а плюс б не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
    дано «новые» равно ["а не меньше 0", "б не меньше 0"]
    ожидается запись «Прогон» с «цели» равным ["а не меньше 0", "б не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 1 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
  запись «Прогон» с «цели» равным («Слить списки» от «новые» и («Прочие цели» от «п»)) и «дано» равным («п».«дано») и «беды» равным («п».«беды») и «ходов» равным ((«п».«ходов») плюс 1) и «проиграно» равным («п».«проиграно») и «идёт» равным («п».«идёт») и «вариант» равным («п».«вариант»)

// ── ходы ────────────────────────────────────────────────────────────────────

// РАЗВЁРТКА ОПРЕДЕЛЕНИЯ. Тело берётся из ИСХОДНИКА по номеру строки, а не из
// записи, и три условия проверяются прежде, чем ему поверить: строка стоит
// внутри названной функции, над нею стоит образец названного варианта, и сама
// она начинается словом `то`. Без этих трёх «развернуть» означало бы «поверить
// записи на слово», то есть ровно то, от чего уходим.
тотальная функция «Ход развёртки»
  принимает «п»: «Прогон», «строка»: строка, «о»: «Обстановка»
  возвращает «Прогон»
  обеспечивает «ветвь один» ((не (не («Есть терм» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1))))) или (результат равен («Беда прогона» от «п» и (соединить ["развёртка: в цели «", («Первая цель» от «п»), "» нет терма «", («Терм» от («В уголках» от «строка» и 1)), "»"] по ""))))
  обеспечивает «ветвь два» ((не («Есть терм» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1)))) или ((не (не ((«Хозяин строки» от («о».«строки») и («Число после» от «строка» и "строка ")) равен («В ёлочках» от («Терм» от («В уголках» от «строка» и 1)) и 1)))) или (результат равен («Беда прогона» от «п» и (соединить ["развёртка «", («В ёлочках» от («Терм» от («В уголках» от «строка» и 1)) и 1), "»: строка ", (к строке («Число после» от «строка» и "строка ")), " исходника стоит в функции «", («Хозяин строки» от («о».«строки») и («Число после» от «строка» и "строка ")), "»"] по "")))))
  обеспечивает «ветвь три» ((не («Есть терм» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1)))) или ((не ((«Хозяин строки» от («о».«строки») и («Число после» от «строка» и "строка ")) равен («В ёлочках» от («Терм» от («В уголках» от «строка» и 1)) и 1))) или (результат равен (если не ((«Строка по номеру» от («о».«строки») и («Число после» от «строка» и "строка ")) начинается с "то ") то «Беда прогона» от «п» и (соединить ["развёртка «", («В ёлочках» от («Терм» от («В уголках» от «строка» и 1)) и 1), "»: строка ", (к строке («Число после» от «строка» и "строка ")), " исходника не начинается словом «то»"] по "") иначе если не (((«Строка по номеру» от («о».«строки») и ((«Число после» от «строка» и "строка ") минус 1)) начинается с "случай ") и притом ((«Имя варианта» от («Слова после» от («Строка по номеру» от («о».«строки») и ((«Число после» от «строка» и "строка ") минус 1)) и 1)) равен («Имя варианта» от («Ужать» от («Справа от» от («Терм» от («В уголках» от «строка» и 1)) и "от"))))) то «Беда прогона» от «п» и (соединить ["развёртка «", («В ёлочках» от («Терм» от («В уголках» от «строка» и 1)) и 1), "»: над строкой ", (к строке («Число после» от «строка» и "строка ")), " исходника не стоит случай варианта «", («Имя варианта» от («Ужать» от («Справа от» от («Терм» от («В уголках» от «строка» и 1)) и "от"))), "»"] по "") иначе «Развернуть по телу» от «п» и («Терм» от («В уголках» от «строка» и 1)) и («Строка по номеру» от («о».«строки») и ((«Число после» от «строка» и "строка ") минус 1)) и («Терм» от («Слова после» от («Строка по номеру» от («о».«строки») и («Число после» от «строка» и "строка ")) и 1)) и («Ужать» от («Справа от» от («Терм» от («В уголках» от «строка» и 1)) и "от"))))))
  пример «Развёртка без такого терма в цели — беда»
    дано «п» равно запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
    дано «строка» равно "ход 1 развернуть ⟨«Длина» от хвост⟩ строка 12"
    дано «о» равно запись «Обстановка» с «строки» равным пустой список и «свои» равным пустой список и «цель» равным "" и «функция» равным "" и «по» равным "" и «тип» равным ""
    ожидается запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным ["развёртка: в цели «результат не меньше 0» нет терма ««Длина» от хвост»"] и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным нет и «вариант» равным ""
  пусть «что» равно («Терм» от («В уголках» от «строка» и 1))
  пусть «где» равно («Число после» от «строка» и "строка ")
  пусть «имя» равно («В ёлочках» от «что» и 1)
  пусть «довод» равно («Ужать» от («Справа от» от «что» и "от"))
  пусть «вариант» равно («Имя варианта» от «довод»)
  пусть «тело» равно («Строка по номеру» от («о».«строки») и «где»)
  пусть «образец» равно («Строка по номеру» от («о».«строки») и («где» минус 1))
  пусть «хозяин» равно («Хозяин строки» от («о».«строки») и «где»)
  если не («Есть терм» от («Первая цель» от «п») и «что»)
    то «Беда прогона» от «п» и (соединить ["развёртка: в цели «", («Первая цель» от «п»), "» нет терма «", «что», "»"] по "")
    иначе
      если не («хозяин» равен «имя»)
        то «Беда прогона» от «п» и (соединить ["развёртка «", «имя», "»: строка ", (к строке «где»), " исходника стоит в функции «", «хозяин», "»"] по "")
        иначе
          если не («тело» начинается с "то ")
            то «Беда прогона» от «п» и (соединить ["развёртка «", «имя», "»: строка ", (к строке «где»), " исходника не начинается словом «то»"] по "")
            иначе
              если не ((«образец» начинается с "случай ") и притом ((«Имя варианта» от («Слова после» от «образец» и 1)) равен «вариант»))
                то «Беда прогона» от «п» и (соединить ["развёртка «", «имя», "»: над строкой ", (к строке «где»), " исходника не стоит случай варианта «", «вариант», "»"] по "")
                иначе «Развернуть по телу» от «п» и «что» и «образец» и («Терм» от («Слова после» от «тело» и 1)) и «довод»

// Подстановка доводов вместо связанных имён образца: `с голова как г` и
// `с голова равным Г` — одно и то же место, и `г` в теле означает `Г`.
тотальная функция «Развернуть по телу»
  принимает «п»: «Прогон», «что»: строка, «образец»: строка, «тело»: строка, «довод»: строка
  возвращает «Прогон»
  пусть «имена» равно («Разделить сверху» от («Справа от» от («Слова после» от «образец» и 1) и "с") и "и")
  пусть «значения» равно («Разделить сверху» от («Справа от» от «довод» и "с") и "и")
  пусть «готовое» равно (свёртка «имена» начиная с (запись «Подстановка» с «терм» равным «тело» и «и» равным 0) как «з» и «ч» → («Шаг подстановки поля» от «з» и «ч» и «значения»))
  «Вместо первой» от «п» и [(«Терм» от («Вставить вместо» от («Первая цель» от «п») и «что» и («готовое».«терм»)))]

объект «Подстановка»
  «терм»: строка
  «и»: число

тотальная функция «Шаг подстановки поля»
  принимает «з»: «Подстановка», «поле образца»: строка, «значения»: список строки
  возвращает «Подстановка»
  обеспечивает «поле 1» ((результат.«и») равен ((«з».«и») плюс 1))
  обеспечивает «поле 2» ((результат.«терм») равен (если ((длина («Обрезать пробелы» от («Справа от» от «поле образца» и "как"))) больше 0) и притом ((длина («Обрезать пробелы» от («Справа от» от («Часть списка» от «значения» и ((«з».«и») плюс 1)) и "равным"))) больше 0) то («Вставить вместо» от («з».«терм») и («Обрезать пробелы» от («Справа от» от «поле образца» и "как")) и («Обрезать пробелы» от («Справа от» от («Часть списка» от «значения» и ((«з».«и») плюс 1)) и "равным"))) иначе («з».«терм»)))
  пример «Поле образца без имени терм не меняет»
    дано «з» равно запись «Подстановка» с «терм» равным "результат не меньше 0" и «и» равным 0
    дано «поле образца» равно "хвост"
    дано «значения» равно ["хвост равным хвост"]
    ожидается запись «Подстановка» с «терм» равным "результат не меньше 0" и «и» равным 1
  пусть «номер» равно ((«з».«и») плюс 1)
  пусть «имя» равно («Обрезать пробелы» от («Справа от» от «поле образца» и "как"))
  пусть «значение» равно («Обрезать пробелы» от («Справа от» от («Часть списка» от «значения» и «номер») и "равным"))
  запись «Подстановка» с «и» равным «номер» и «терм» равным (если ((длина «имя») больше 0) и притом ((длина «значение») больше 0) то («Вставить вместо» от («з».«терм») и «имя» и «значение») иначе («з».«терм»))

// ПЕРЕПИСКА ДОПУЩЕНИЕМ. Допущение обязано быть равенством; переписываются ВСЕ
// вхождения левой стороны, как это делает и ядро. Обратное направление
// называется словом, а не подразумевается.
тотальная функция «Ход замены»
  принимает «п»: «Прогон», «строка»: строка
  возвращает «Прогон»
  обеспечивает «ветвь один» ((не (не ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«есть»))) или (результат равен («Беда прогона» от «п» и (соединить ["замена по дано ", (к строке («Число после» от «строка» и "по дано ")), ": допущения-равенства под этим номером нет"] по ""))))
  обеспечивает «ветвь два» ((не ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«есть»)) или ((не (не («Есть терм» от («Первая цель» от «п») и (если («строка» содержит " обратно") то ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«право») иначе ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«лево»))))) или (результат равен («Беда прогона» от «п» и (соединить ["замена по дано ", (к строке («Число после» от «строка» и "по дано ")), ": в цели «", («Первая цель» от «п»), "» нет терма «", (если («строка» содержит " обратно") то ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«право») иначе ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«лево»)), "»"] по "")))))
  обеспечивает «ветвь три» ((не ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«есть»)) или ((не («Есть терм» от («Первая цель» от «п») и (если («строка» содержит " обратно") то ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«право») иначе ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«лево»)))) или (результат равен («Вместо первой» от «п» и [(«Терм» от («Вставить вместо» от («Первая цель» от «п») и (если («строка» содержит " обратно") то ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«право») иначе ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«лево»)) и (если («строка» содержит " обратно") то ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«лево») иначе ((«Разрез по» от («Часть списка» от («п».«дано») и («Число после» от «строка» и "по дано ")) и "равно").«право»))))]))))
  пример «Замена по несуществующему допущению — беда»
    дано «п» равно запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
    дано «строка» равно "ход 1 замена по дано 1"
    ожидается запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным ["замена по дано 1: допущения-равенства под этим номером нет"] и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным нет и «вариант» равным ""
  пусть «номер» равно («Число после» от «строка» и "по дано ")
  пусть «наоборот» равно («строка» содержит " обратно")
  пусть «факт» равно («Часть списка» от («п».«дано») и «номер»)
  пусть «р» равно («Разрез по» от «факт» и "равно")
  пусть «что» равно (если «наоборот» то («р».«право») иначе («р».«лево»))
  пусть «на» равно (если «наоборот» то («р».«лево») иначе («р».«право»))
  если не («р».«есть»)
    то «Беда прогона» от «п» и (соединить ["замена по дано ", (к строке «номер»), ": допущения-равенства под этим номером нет"] по "")
    иначе
      если не («Есть терм» от («Первая цель» от «п») и «что»)
        то «Беда прогона» от «п» и (соединить ["замена по дано ", (к строке «номер»), ": в цели «", («Первая цель» от «п»), "» нет терма «", «что», "»"] по "")
        иначе «Вместо первой» от «п» и [(«Терм» от («Вставить вместо» от («Первая цель» от «п») и «что» и «на»))]

// ПОРЯДОК СОСЕДЕЙ. Переставляются два операнда ОДНОГО узла и только они:
// перестановка через скобки была бы ассоциативностью, а она в IEEE-754 ложна.
тотальная функция «Ход соседей»
  принимает «п»: «Прогон», «строка»: строка
  возвращает «Прогон»
  обеспечивает «ветвь один» ((не ((длина (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "плюс")) равен 2) то "плюс" иначе (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "умножить на")) равен 2) то "умножить на" иначе ""))) равен 0)) или (результат равен («Беда прогона» от «п» и (соединить ["соседи: «", («Терм» от («В уголках» от «строка» и 1)), "» не сумма и не произведение ровно двух соседей"] по ""))))
  обеспечивает «ветвь два» (((длина (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "плюс")) равен 2) то "плюс" иначе (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "умножить на")) равен 2) то "умножить на" иначе ""))) равен 0) или ((не (не («Есть терм» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1))))) или (результат равен («Беда прогона» от «п» и (соединить ["соседи: в цели «", («Первая цель» от «п»), "» нет терма «", («Терм» от («В уголках» от «строка» и 1)), "»"] по "")))))
  обеспечивает «ветвь три» (((длина (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "плюс")) равен 2) то "плюс" иначе (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "умножить на")) равен 2) то "умножить на" иначе ""))) равен 0) или ((не («Есть терм» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1)))) или (результат равен («Вместо первой» от «п» и [(«Терм» от («Вставить вместо» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1)) и (соединить [((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "плюс")) равен 2) то "плюс" иначе (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "умножить на")) равен 2) то "умножить на" иначе ""))).«право»), " ", (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "плюс")) равен 2) то "плюс" иначе (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "умножить на")) равен 2) то "умножить на" иначе "")), " ", ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "плюс")) равен 2) то "плюс" иначе (если ((длина («Разделить сверху» от («Терм» от («В уголках» от «строка» и 1)) и "умножить на")) равен 2) то "умножить на" иначе ""))).«лево»)] по "")))]))))
  пример «Соседи не у суммы и не у произведения — беда»
    дано «п» равно запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
    дано «строка» равно "ход 1 соседи ⟨результат⟩"
    ожидается запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным ["соседи: «результат» не сумма и не произведение ровно двух соседей"] и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным нет и «вариант» равным ""
  пусть «что» равно («Терм» от («В уголках» от «строка» и 1))
  пусть «оп» равно (если ((длина («Разделить сверху» от «что» и "плюс")) равен 2) то "плюс" иначе (если ((длина («Разделить сверху» от «что» и "умножить на")) равен 2) то "умножить на" иначе ""))
  пусть «р» равно («Разрез по» от «что» и «оп»)
  пусть «на» равно (соединить [(«р».«право»), " ", «оп», " ", («р».«лево»)] по "")
  если (длина «оп») равен 0
    то «Беда прогона» от «п» и (соединить ["соседи: «", «что», "» не сумма и не произведение ровно двух соседей"] по "")
    иначе
      если не («Есть терм» от («Первая цель» от «п») и «что»)
        то «Беда прогона» от «п» и (соединить ["соседи: в цели «", («Первая цель» от «п»), "» нет терма «", «что», "»"] по "")
        иначе «Вместо первой» от «п» и [(«Терм» от («Вставить вместо» от («Первая цель» от «п») и «что» и «на»))]

// ВЕТВЬ ПРИ ИЗВЕСТНОМ УСЛОВИИ. `если да то А иначе Б` — это `А`, и спорить не о
// чем: вычислитель считает условие и берёт названную ветвь, второй не считая.
// Ход ничего не ВЫВОДИТ, он ЧИТАЕТ написанное — как и развёртка определения.
// Без него деление цели было бы бесполезно: оно ставит на место условия литерал,
// а забрать после этого нужную ветвь нечем.
тотальная функция «Ход выбора»
  принимает «п»: «Прогон», «строка»: строка
  возвращает «Прогон»
  обеспечивает «ветвь один» ((не (не (((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«есть») и притом ((«Разрез по» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«право») и "иначе").«есть») и притом (((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«лево») начинается с "если ")))) или (результат равен («Беда прогона» от «п» и (соединить ["выбор: «", («Терм» от («В уголках» от «строка» и 1)), "» не вида «если У то А иначе Б»"] по ""))))
  обеспечивает «ветвь два» ((не (((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«есть») и притом ((«Разрез по» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«право») и "иначе").«есть») и притом (((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«лево») начинается с "если "))) или ((не (не (((«Слова после» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«лево») и 1) равен "да") или ((«Слова после» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«лево») и 1) равен "нет")))) или (результат равен («Беда прогона» от «п» и (соединить ["выбор: условие «", («Слова после» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«лево») и 1), "» не вычислено до литерала — ветвь брать не из чего"] по "")))))
  обеспечивает «ветвь три» ((не (((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«есть») и притом ((«Разрез по» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«право») и "иначе").«есть») и притом (((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«лево») начинается с "если "))) или ((не (((«Слова после» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«лево») и 1) равен "да") или ((«Слова после» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«лево») и 1) равен "нет"))) или (результат равен (если не («Есть терм» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1))) то «Беда прогона» от «п» и (соединить ["выбор: в цели «", («Первая цель» от «п»), "» нет терма «", («Терм» от («В уголках» от «строка» и 1)), "»"] по "") иначе «Вместо первой» от «п» и [(«Терм» от («Вставить вместо» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1)) и (если («Слова после» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«лево») и 1) равен "да" то ((«Разрез по» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«право») и "иначе").«лево») иначе ((«Разрез по» от ((«Разрез по» от («Терм» от («В уголках» от «строка» и 1)) и "то").«право») и "иначе").«право»))))]))))
  пример «Выбор не над условным термом — беда»
    дано «п» равно запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
    дано «строка» равно "ход 1 выбор ⟨результат⟩"
    ожидается запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным ["выбор: «результат» не вида «если У то А иначе Б»"] и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным нет и «вариант» равным ""
  пусть «что» равно («Терм» от («В уголках» от «строка» и 1))
  пусть «по то» равно («Разрез по» от «что» и "то")
  пусть «условие» равно («Слова после» от («по то».«лево») и 1)
  пусть «ветви» равно («Разрез по» от («по то».«право») и "иначе")
  пусть «взято» равно (если «условие» равен "да" то («ветви».«лево») иначе («ветви».«право»))
  если не ((«по то».«есть») и притом («ветви».«есть») и притом ((«по то».«лево») начинается с "если "))
    то «Беда прогона» от «п» и (соединить ["выбор: «", «что», "» не вида «если У то А иначе Б»"] по "")
    иначе
      если не ((«условие» равен "да") или («условие» равен "нет"))
        то «Беда прогона» от «п» и (соединить ["выбор: условие «", «условие», "» не вычислено до литерала — ветвь брать не из чего"] по "")
        иначе
          если не («Есть терм» от («Первая цель» от «п») и «что»)
            то «Беда прогона» от «п» и (соединить ["выбор: в цели «", («Первая цель» от «п»), "» нет терма «", «что», "»"] по "")
            иначе «Вместо первой» от «п» и [(«Терм» от («Вставить вместо» от («Первая цель» от «п») и «что» и «взято»))]

// ДЕЛЕНИЕ ЦЕЛИ ПО УСЛОВИЮ. Условие — признак, значений у него ровно два, значит
// цель совпадает либо с собой при `да`, либо с собой при `нет`. Берётся ТОЛЬКО
// выражение, стоящее в цели условием (`если У то`): у произвольного подтерма
// значений больше двух, и замена была бы ложью.
тотальная функция «Ход деления»
  принимает «п»: «Прогон», «строка»: строка
  возвращает «Прогон»
  обеспечивает «ветвь да» ((не (не ((«Первая цель» от «п») содержит (соединить ["если ", («Терм» от («В уголках» от «строка» и 1)), " то "] по "")))) или (результат равен («Беда прогона» от «п» и (соединить ["деление: «", («Терм» от («В уголках» от «строка» и 1)), "» не стоит в цели условием («если … то»)"] по ""))))
  обеспечивает «ветвь нет» ((не ((«Первая цель» от «п») содержит (соединить ["если ", («Терм» от («В уголках» от «строка» и 1)), " то "] по ""))) или (результат равен («Вместо первой» от «п» и [(«Терм» от («Вставить вместо» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1)) и "да")), («Терм» от («Вставить вместо» от («Первая цель» от «п») и («Терм» от («В уголках» от «строка» и 1)) и "нет"))])))
  пример «Деление по терму, которого нет условием в цели, — беда»
    дано «п» равно запись «Прогон» с «цели» равным ["результат не меньше 0"] и «дано» равным пустой список и «беды» равным пустой список и «ходов» равным 0 и «проиграно» равным 0 и «идёт» равным да и «вариант» равным ""
    дано «строка» равно "ход 1 деление ⟨н больше 0⟩"
