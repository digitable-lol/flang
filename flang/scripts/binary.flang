    дано рядом равно "../stdlib"
    дано метка равно "7"
    ожидается "../stdlib/.flang-proba-7.flang"
  соединить [рядом, "/.flang-proba-", метка, ".flang"] по ""

тотальная функция «Записать пробу»
  принимает куда: строка, текст: строка
  возвращает «Поручение»
  пример «Проба пишется файлом»
    дано куда равно "../stdlib/.flang-proba-7.flang"
    дано текст равно "модуль «Проба»"
    ожидается вариант «Записать файл» с путь равным "../stdlib/.flang-proba-7.flang" и содержимое равным "модуль «Проба»"
  вариант «Записать файл» с путь равным куда и содержимое равным текст

// Поручения «Удалить файл» в словаре ввода-вывода нет — проба убирается
// оболочкой. Одинарной кавычки в пути быть не должно: язык этого не держит,
// правило негласное.
тотальная функция «Убрать пробу»
  принимает куда: строка
  возвращает «Поручение»
  пример «Убирается оболочкой — поручения удаления в словаре нет»
    дано куда равно "../stdlib/.flang-proba-7.flang"
    ожидается вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "rm -f -- '../stdlib/.flang-proba-7.flang'"]
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (соединить ["rm -f -- '", куда, "'"] по "")]

// ── ВЕЕР: много разборов за один заход ────────────────────────────────────
//
// Один `flang ast` на файле, подключающем половину компилятора, идёт десятки
// секунд; проверке имён таких файлов 226, и по одному она шла больше десяти
// минут — то есть её перестали бы звать, а проверка, которую не зовут, ничем
// не отличается от снятой.
//
// Веера в языке нет, и заводить его сюда незачем: `xargs -P` разводит вызовы
// по ядрам сам. Задания пишутся ФАЙЛОМ («Записать файл»), а не подаются на
// вход потомку: поручения «Запустить процесс с вводом» двоичный хозяин не
// знает, хотя словарь его объявляет.
//
// ЧИСЛО ПОТОКОВ СЧИТАЕТСЯ ПО ПАМЯТИ, А НЕ ПО ЯДРАМ. Цена одного `flang ast` —
// 14 ГиБ; веер из 64 таких вызовов просит 896 ГиБ, а на машине их 499. Разбор
// ночи 21 августа 2026: убийца памяти снял 24 процесса flang размером от 26,0
// до 57,4 ГиБ, машина стояла 87 минут.

тотальная функция «Строка задания»
  принимает путь: строка, куда: строка
  возвращает строка
  пример «Задание — путь и место ответа в одной строке»
    дано путь равно "../stdlib/json.flang"
    дано куда равно "/srv/tmp/c-1/0.json"
    ожидается "../stdlib/json.flang /srv/tmp/c-1/0.json\n"
  соединить [путь, " ", куда, "\n"] по ""

тотальная функция «Потоков веера»
  принимает свободно: нат, цена: нат
  возвращает число
  обеспечивает «поток хотя бы один» результат не меньше 1
  пример «Памяти на два прогона — два потока»
    дано свободно равно 60
    дано цена равно 14
    ожидается 2
  пример «Памяти нет вовсе — всё равно один поток, иначе веер не тронется»
    дано свободно равно 0
    дано цена равно 14
    ожидается 1
  пример «Потолок 64 — как было у предшественницы»
    дано свободно равно 100000
    дано цена равно 14
    ожидается 64
  пусть пара равно ((если цена не меньше 1 то цена иначе 1) умножить на 2)
  пусть влезает равно ((свободно минус (свободно остаток от пара)) делить на пара)
  если влезает не больше 1
    то 1
    иначе (если влезает не меньше 64 то 64 иначе влезает)

тотальная функция «Веер деревьев»
  принимает задания: строка, потоков: строка
  возвращает «Поручение»
  пример «Задания читаются файлом, потоки разводит xargs»
    дано задания равно "/srv/tmp/c-1/zadaniya"
    дано потоков равно "8"
    ожидается вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "xargs -a '/srv/tmp/c-1/zadaniya' -n 2 -P 8 sh -c 'exec \"$0\" ast \"$1\" >\"$2\" 2>\"$2.err\"' '../../bootstrap/flang'"]
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (соединить ["xargs -a '", задания, "' -n 2 -P ", потоков, " sh -c 'exec \"$0\" ast \"$1\" >\"$2\" 2>\"$2.err\"' '", («Двоичный»), "'"] по "")]

// ── Прогон: модуль спрашивает лексер о двух словах и сличает с известным ────
//
//   flang io flang/scripts/binary.flang --plan 'Двоичный отвечает'
//
// «код символа» — форма, из-за которой сторож утверждений и написан: она
// появилась 9 августа 2026, а шесть мест продолжали утверждать, что её нет.
// «мурзилка» — слово, которого в языке нет и не будет.

тип «Ход»
  вариант «Ждём известное»
  вариант «Ждём неизвестное»

тотальная функция «Начать»
  возвращает «Ход»
  пример «Первым спрашивается слово, которое в языке есть»
    ожидается вариант «Ждём известное»
  вариант «Ждём известное»

тотальная функция «После известного»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пример «Пока ничего — значит лексера ещё не спрашивали»
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "../../bootstrap/flang" и аргументы равным ["tokens", "--keyword", "код символа", "--json"]) и потом равным (вариант «Ждём известное»)
  пример «Слово известно — идём спрашивать про несуществующее»
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "{\"keyword\":\"charCode\"}" и ошибки равным ""
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "../../bootstrap/flang" и аргументы равным ["tokens", "--keyword", "мурзилка", "--json"]) и потом равным (вариант «Ждём неизвестное»)
  разбор отклик
    случай вариант «Пока ничего»
      то вариант «Сделать» с поручение равным («Спросить ключевое слово» от "код символа") и потом равным (вариант «Ждём известное»)
    случай любое
      то если («Лексер знает» от («Ключевое слово» от отклик))
        то вариант «Сделать» с поручение равным («Спросить ключевое слово» от "мурзилка") и потом равным (вариант «Ждём неизвестное»)
        иначе вариант «Провал» с код равным "FLANG_DVOICHNYY_NE_OTVECHAET" и сообщение равным "лексер не назвал «код символа» ключевым словом — а форма в языке есть с 9 августа 2026"

тотальная функция «После неизвестного»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пример «Слова нет — модуль отвечает так, как от него ждут»
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "{\"keyword\":null}" и ошибки равным ""
    ожидается вариант «Конец работы» с значение равным "двоичный отвечает: «код символа» — ключевое слово, «мурзилка» — нет"
  пример «Лексер вдруг знает несуществующее — красный, а не тишина»
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "{\"keyword\":\"murzilka\"}" и ошибки равным ""
    ожидается вариант «Провал» с код равным "FLANG_DVOICHNYY_NE_OTVECHAET" и сообщение равным "лексер назвал «мурзилку» ключевым словом — либо язык изменился, либо вопрос задан не тому"
  если («Лексер знает» от («Ключевое слово» от отклик))
    то вариант «Провал» с код равным "FLANG_DVOICHNYY_NE_OTVECHAET" и сообщение равным "лексер назвал «мурзилку» ключевым словом — либо язык изменился, либо вопрос задан не тому"
    иначе вариант «Конец работы» с значение равным "двоичный отвечает: «код символа» — ключевое слово, «мурзилка» — нет"

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём известное»
      то «После известного» от отклик
    случай вариант «Ждём неизвестное»
      то «После неизвестного» от отклик

план «Двоичный отвечает»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
