модуль «Сторож ключей»

// ПЕРЕПИСАНО НА FLANG ИЗ flang/scripts/cli-keys-guard.mjs (372 строки).
//
//   flang io flang/scripts/cli-keys-guard.flang
//
// Сходятся ли ключи командной строки у трёх реализаций: эталона на самом
// flang (flang/self/cli.flang), рукописного разбора на C
// (flang/src/emit/c/flang_repl.c, flang_cli.c) и справки СОБРАННОГО
// двоичного (прогоном). Ни один из трёх наборов не вписан сюда руками —
// каждый снимается заново при каждом прогоне, иначе сторож сам стал бы ещё
// одним списком, набранным руками, и отстал бы первым.
//
// Код возврата 0 — наборы сошлись (с точностью до записанного долга);
// 1 — разошлись, и это назван «Провал» с числом расхождений; «couldn't ask»
// (нет двоичного, файл не читается) — тоже «Провал», отдельным кодом:
// `flang io` не даёт плану выбирать между «1» и «2» самому — эти два
// исхода различает ТЕКСТ провала, а не число выхода (SPEC, раздел 7:
// «flang io» решает 0/1 по «Конец работы»/«Провал» сам, коды 2 и 3 — это
// сломанный ВЫЗОВ или ХОЗЯИН, а не приговор предмету).

// ── Мелкие строковые помощники ──────────────────────────────────────────────

тотальная функция «До метки»
  принимает текст: строка, метка: строка
  возвращает строка
  пример «До первой метки»
    дано текст равно "раз|два"
    дано метка равно "|"
    ожидается "раз"
  голова (разделить текст по метка)

тотальная функция «После метки»
  принимает текст: строка, метка: строка
  возвращает строка
  пример «После первой метки»
    дано текст равно "раз|два|три"
    дано метка равно "|"
    ожидается "два"
  пример «Метки нет — пусто»
    дано текст равно "раз"
    дано метка равно "|"
    ожидается ""
  пусть куски равно (разделить текст по метка)
  если (длина куски) не меньше 2
    то элемент 2 в куски
    иначе ""

// Всё, что после ПЕРВОГО вхождения метки, включая повторные вхождения самой
// метки внутри хвоста (в отличие от «После метки», которая берёт только
// второй кусок разбиения). Метки нет вовсе — пусто, а не исходный текст:
// «разделить» на один кусок даёт хвост пустым, и это ровно то же самое.
тотальная функция «Хвост после метки»
  принимает текст: строка, метка: строка
  возвращает строка
  пример «Хвост может содержать метку ещё раз»
    дано текст равно "раз|два|три"
    дано метка равно "|"
    ожидается "два|три"
  пример «Метки нет — пусто»
    дано текст равно "раз"
    дано метка равно "|"
    ожидается ""
  пусть куски равно разделить текст по метка
  разбор куски
    случай пусто
      то ""
    случай голова и хвост
      то если пусто хвост
        то ""
        иначе соединить хвост по метка

тотальная функция «Между»
  принимает текст: строка, слева: строка, справа: строка
  возвращает строка
  пример «Значение между метками»
    дано текст равно "  version \"0.5.0\"\n"
    дано слева равно "version \""
    дано справа равно "\""
    ожидается "0.5.0"
  если не (текст содержит слева)
    то ""
    иначе «До метки» от («После метки» от текст и слева) и справа

тотальная функция «Сложить строки»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Два списка в один»
    дано первые равно ["раз"]
    дано вторые равно ["два"]
    ожидается ["раз", "два"]
  свёртка вторые начиная с первые как акк и что
    добавить что к акк

тотальная функция «Есть строка в списке»
  принимает перечень: список строки, что: строка
  возвращает признак
  пример «Есть»
    дано перечень равно ["а", "б"]
    дано что равно "б"
    ожидается да
  пример «Нет»
    дано перечень равно ["а", "б"]
    дано что равно "в"
    ожидается нет
  разбор перечень
    случай пусто
      то нет
    случай голова и хвост
      то если голова равен что
        то да
        иначе «Есть строка в списке» от хвост и что

тотальная функция «Без повторов строк»
  принимает перечень: список строки
  возвращает список строки
  // Держится ПОСЛЕДНЕЕ вхождение (набор всё равно потом сортируется —
  // «Только различия по алфавиту» ниже, — поэтому какое из повторов держать
  // значения не имеет; важен только СОСТАВ множества).
  пример «Повтор снят»
    дано перечень равно ["а", "б", "а"]
    ожидается ["б", "а"]
  разбор перечень
    случай пусто
      то пустой список
    случай голова и хвост
      то если «Есть строка в списке» от хвост и голова
        то «Без повторов строк» от хвост
        иначе приписать голова к («Без повторов строк» от хвост)

// ── Алфавиты и признак «это ключ» ───────────────────────────────────────────

тотальная функция «Строчная кириллица»
  возвращает строка
  "абвгдежзийклмнопрстуфхцчшщъыьэюяё"

тотальная функция «Заглавная кириллица»
  возвращает строка
  "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯЁ"

тотальная функция «Строчная латиница»
  возвращает строка
  "abcdefghijklmnopqrstuvwxyz"

тотальная функция «Заглавная латиница»
  возвращает строка
  "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

тотальная функция «Цифры»
  возвращает строка
  "0123456789"

тотальная функция «Буквы»
  возвращает строка
  соединить [(«Строчная кириллица»), («Заглавная кириллица»), («Строчная латиница»), («Заглавная латиница»)] по ""

тотальная функция «Буквы цифры и дефис»
  возвращает строка
  соединить [(«Буквы»), («Цифры»), "-"] по ""

тотальная функция «Знак содержится в»
  принимает алфавит: строка, знак: строка
  возвращает признак
  пример «Буква содержится»
    дано алфавит равно "абв"
    дано знак равно "б"
    ожидается да
  пример «Пустой знак не содержится нигде»
    дано алфавит равно "абв"
    дано знак равно ""
    ожидается нет
  если (длина знак) равен 0
    то нет
    иначе алфавит содержит знак

// Хвост строки годен, если каждый его знак — буква, цифра или дефис (пустой
// хвост — годен даром). Рекурсия структурна — по разбору строки, доказуема
// без объявленной меры: убывание видно по построению, а не по числу.
тотальная функция «Хвост из букв цифр и дефисов»
  принимает текст: строка
  возвращает признак
  пример «Хвост ключа»
    дано текст равно "max-steps2"
    ожидается да
  пример «Пробел ломает хвост»
    дано текст равно "max steps"
    ожидается нет
  пример «Пустой хвост годен»
    дано текст равно ""
    ожидается да
  разбор текст
    случай пусто
      то да
    случай голова и хвост
      то («Знак содержится в» от («Буквы цифры и дефис») и голова) и притом («Хвост из букв цифр и дефисов» от хвост)

// Длинный ключ: остаток после «--» начинается буквой, а дальше — только
// буквы/цифры/дефисы. Соответствует /^--\p{L}[\p{L}\p{N}-]*$/u у свидетеля
// (алфавит сужен до кириллицы и латиницы — другие письма ключам не встречались).
тотальная функция «Длинный ключ ли»
  принимает остаток: строка
  возвращает признак
  пример «Буква и хвост»
    дано остаток равно "max-steps"
    ожидается да
  пример «Голый остаток — не ключ»
    дано остаток равно ""
    ожидается нет
  пример «Начинается не с буквы»
    дано остаток равно "-max"
    ожидается нет
  разбор остаток
    случай пусто
      то нет
    случай голова и хвост
      то («Знак содержится в» от («Буквы») и голова) и притом («Хвост из букв цифр и дефисов» от хвост)

// Короткий ключ: одна чёрточка и РОВНО одна буква. /^-\p{L}$/u у свидетеля.
тотальная функция «Короткий ключ ли»
  принимает остаток: строка
  возвращает признак
  пример «Одна буква»
    дано остаток равно "h"
    ожидается да
  пример «Две буквы — уже не короткий ключ»
    дано остаток равно "hh"
    ожидается нет
  разбор остаток
    случай пусто
      то нет
    случай голова и хвост
      то («Знак содержится в» от («Буквы») и голова) и притом (пусто хвост)

// «--слово…» или «-б». Разбор структурный — снимает первую чёрточку, затем
// смотрит, вторая ли это чёрточка (длинный ключ) или буква (короткий).
тотальная функция «Ключ ли»
  принимает слово: строка
  возвращает признак
  пример «Длинный ключ»
    дано слово равно "--max-steps"
    ожидается да
  пример «Короткий ключ»
    дано слово равно "-h"
    ожидается да
  пример «Голая чёрточка — не ключ»
    дано слово равно "--"
    ожидается нет
  пример «Не ключ»
    дано слово равно "flang"
    ожидается нет
  пример «Три чёрточки — не короткий ключ»
    дано слово равно "-hh"
    ожидается нет
  разбор слово
    случай пусто
      то нет
    случай голова и хвост
      то если голова равен "-"
        то «После первой чёрточки» от хвост
        иначе нет

тотальная функция «После первой чёрточки»
  принимает остаток: строка
  возвращает признак
  пример «Вторая чёрточка — длинный ключ»
    дано остаток равно "-max-steps"
    ожидается да
  пример «Буква — короткий ключ»
    дано остаток равно "h"
    ожидается да
  разбор остаток
    случай пусто
      то нет
    случай голова и хвост
      то если голова равен "-"
        то «Длинный ключ ли» от хвост
        иначе «Короткий ключ ли» от остаток

тотальная функция «Только ключи»
  принимает слова: список строки
  возвращает список строки
  отфильтровать слова где слово → («Ключ ли» от слово)

// ── Литералы в кавычках: общий сборщик, с учётом экранов ───────────────────
//
// Спрашивается ХАРАКТЕР ЗА ХАРАКТЕРОМ (свёртка по разложенной строке) — так
// же, как «Скан числа» у flang/self/cli.flang и обрезка пробелов там же.
// Экран (`\"`) не закрывает литерал, перевод строки внутри незакрытой
// кавычки его обрывает: свидетель на JavaScript тоже не читает кавычку
// через перевод строки — `[^"\\\n]` в его же регулярном выражении.

объект «Ход литералов»
  «режим»: число
  «текущий»: строка
  «найдено»: список строки

тотальная функция «Начальный ход литералов»
  возвращает «Ход литералов»
  запись «Ход литералов» с «режим» равным 0 и «текущий» равным "" и «найдено» равным пустой список

тотальная функция «Шаг литералов»
  принимает ход: «Ход литералов», знак: строка
  возвращает «Ход литералов»
  пусть режим равно ход.«режим»
  пусть текущий равно ход.«текущий»
  пусть найдено равно ход.«найдено»
  если режим равен 0
    то если знак равен "\""
      то запись «Ход литералов» с «режим» равным 1 и «текущий» равным "" и «найдено» равным найдено
      иначе ход
    иначе если режим равен 1
      то если знак равен "\\"
        то запись «Ход литералов» с «режим» равным 2 и «текущий» равным (соединить текущий с знак) и «найдено» равным найдено
        иначе если знак равен "\""
          то запись «Ход литералов» с «режим» равным 0 и «текущий» равным "" и «найдено» равным (приписать текущий к найдено)
          иначе если знак равен "\n"
            то запись «Ход литералов» с «режим» равным 0 и «текущий» равным "" и «найдено» равным найдено
            иначе запись «Ход литералов» с «режим» равным 1 и «текущий» равным (соединить текущий с знак) и «найдено» равным найдено
      иначе запись «Ход литералов» с «режим» равным 1 и «текущий» равным (соединить текущий с знак) и «найдено» равным найдено

// Все литералы текста, ПОСЛЕДНИЙ ПЕРВЫМ: голова результата — тот литерал,
// что стоит в тексте последним. Это ровно то, что нужно телу именованной
// функции (свидетель берёт «самый длинный», а тело этих функций несёт РОВНО
// ОДИН перечень — последний написанный литерал и есть возвращаемое значение).
тотальная функция «Литералы текста»
  принимает текст: строка
  возвращает список строки
  пример «Два литерала — последний головой»
    дано текст равно "\"а\" да \"бб\""
    ожидается ["бб", "а"]
  пример «Экранированная кавычка не закрывает литерал»
    дано текст равно "\"а\\\"б\""
    ожидается ["а\\\"б"]
  пусть итог равно свёртка (разложить текст на символы) начиная с («Начальный ход литералов») как ход и знак → («Шаг литералов» от ход и знак)
  итог.«найдено»

// Самый длинный (по числу элементов после разбиения по "|") литерал вида
// "|--a|--b|" среди всех литералов текста. Пустой список, если такого нет.
тотальная функция «Семейство из перечня»
  принимает литерал: строка
  возвращает список строки
  пример «Разбор перечня»
    дано литерал равно "|--a|--b|"
    ожидается ["--a", "--b"]
  пример «Не перечень — пусто»
    дано литерал равно "просто текст"
    ожидается пустой список
  если (не (литерал начинается с "|")) или (не («Заканчивается на трубу» от литерал))
    то пустой список
    иначе «Только ключи» от (разделить литерал по "|")

тотальная функция «Заканчивается на трубу»
  принимает текст: строка
  возвращает признак
  если (длина текст) равен 0
    то нет
    иначе (подстрока текст с (длина текст) по (длина текст)) равен "|"

тотальная функция «Это пробельный знак»
  принимает знак: строка
  возвращает признак
  (знак равен " ") или (знак равен "\t") или (знак равен "\n") или (знак равен "\r")

// Обрезка СПРАВА структурной рекурсией по хвосту: как «Без точек справа»
// выше, но снимает любой пробельный знак, а не точку.
тотальная функция «Обрезать пробелы справа»
  принимает текст: строка
  возвращает строка
  разбор текст
    случай пусто
      то ""
    случай голова и хвост
      то если пусто хвост
        то (если «Это пробельный знак» от голова то "" иначе голова)
        иначе
          пусть остаток равно «Обрезать пробелы справа» от хвост
          если (остаток равен "") и притом («Это пробельный знак» от голова)
            то ""
            иначе соединить [голова, остаток] по ""

// Настоящая граница пары написаний — это ДВЕ ЧЁРТОЧКИ РЯДОМ СРАЗУ ПОСЛЕ
// закрытия своего же сравнения, не любое «||» где-то дальше в куске: кусок
// у C тянется до СЛЕДУЮЩЕГО «strcmp(», то есть может нести десятки строк
// чужого кода, где «||» встречается по не связанным поводам. Значит смотрим
// не «содержит», а «кончается на» — после обрезки хвостовых пробелов.
// Хвост берётся коротким кусочком ПЕРЕД обрезкой пробелов, а не целиком:
// «кусок» между двумя «strcmp(» бывает многие тысячи знаков, а «Обрезать
// пробелы справа» — обычная (не хвостовая) рекурсия по знаку, и на тексте
// длиннее предела глубины вызовов (10 000) она бы отказала САМА, раньше,
// чем успела ответить. Нужны только последние знаки — двадцати с запасом
// хватает: между закрывающей скобкой сравнения и «||» пробелов не бывает
// много.
тотальная функция «Хвост для границы или»
  принимает текст: строка
  возвращает строка
  пусть длина_текста равно длина текст
  если длина_текста равен 0
    то ""
    иначе если длина_текста не больше 20
      то текст
      иначе подстрока текст с ((длина_текста минус 20) плюс 1) по длина_текста

тотальная функция «Кончается двумя чёрточками»
  принимает текст: строка
  возвращает признак
  пусть обрезано равно «Обрезать пробелы справа» от («Хвост для границы или» от текст)
  если (длина обрезано) меньше 2
    то нет
    иначе (подстрока обрезано с ((длина обрезано) минус 1) по (длина обрезано)) равен "||"

тотальная функция «Длиннее»
  принимает а: список строки, б: список строки
  возвращает список строки
  если (длина б) больше (длина а)
    то б
    иначе а

тотальная функция «Самое длинное семейство»
  принимает литералы: список строки
  возвращает список строки
  разбор литералы
    случай пусто
      то пустой список
    случай голова и хвост
      то «Длиннее» от («Самое длинное семейство» от хвост) и («Семейство из перечня» от голова)

// ── Э: эталон на самом языке (flang/self/cli.flang) ─────────────────────────

объект «Набор ключей»
  «ключи»: список строки
  «со значением»: список строки
  «без значения»: список строки
  «команды»: список строки
  «пары»: список строки

тотальная функция «Тело функции»
  принимает текст: строка, имя: строка
  возвращает строка
  пусть метка равно соединить ["тотальная функция «", имя, "»"] по ""
  если не (текст содержит метка)
    то ""
    иначе «До метки» от («После метки» от текст и метка) и "\n\n"

// Значение простой функции-константы: последний (он же единственный по
// смыслу) литерал в её теле.
тотальная функция «Значение простой функции»
  принимает текст: строка, имя: строка
  возвращает строка
  пусть тело равно «Тело функции» от текст и имя
  пусть литералы равно «Литералы текста» от тело
  разбор литералы
    случай пусто
      то ""
    случай голова и хвост
      то голова

тотальная функция «Семейство функции»
  принимает текст: строка, имя: строка
  возвращает список строки
  пусть тело равно «Тело функции» от текст и имя
  «Самое длинное семейство» от («Литералы текста» от тело)

// «Только ключи» выше отфильтровала бы имена команд (без чёрточки) — а нам
// нужны они сами, поэтому здесь читаем перечень напрямую, без фильтра.
тотальная функция «Слова перечня»
  принимает литерал: строка
  возвращает список строки
  пример «Слова перечня без фильтра по ключам»
    дано литерал равно "|check|ast|"
    ожидается ["check", "ast"]
  пример «Не перечень — пусто»
    дано литерал равно "мимо"
    ожидается пустой список
  если (не (литерал начинается с "|")) или (не («Заканчивается на трубу» от литерал))
    то пустой список
    иначе отфильтровать (разделить литерал по "|") где слово → не (слово равен "")

// Между кусок[i] и кусок[i+1] стоит ровно одно вхождение `") или ("` — тот же
// приём, что у «Шаг поиска» в flang/scripts/jargon-guard.flang: свёртка по
// кускам, «прошлый» несёт кусок слева от границы. Тотальна СВЁРТКОЙ — без
// объявленной меры и её тройной цены при проверке.
объект «Ход пар»
  «прошлый»: строка
  «начало»: признак
  «пары»: список строки

тотальная функция «Шаг пар»
  принимает ход: «Ход пар», кусок: строка
  возвращает «Ход пар»
  пусть пары равно ход.«пары»
  если ход.«начало»
    то запись «Ход пар» с «прошлый» равным кусок и «начало» равным нет и «пары» равным пары
    иначе запись «Ход пар» с «прошлый» равным кусок и «начало» равным нет и «пары» равным («Сложить строки» от пары и («Пара если оба ключи» от («Ключ на конце» от (ход.«прошлый»)) и («Первый литерал куска» от кусок)))

тотальная функция «Найти пары в эталоне»
  принимает текст: строка
  возвращает список строки
  пусть куски равно разделить текст по ") или ("
  пусть итог равно свёртка куски начиная с (запись «Ход пар» с «прошлый» равным "" и «начало» равным да и «пары» равным пустой список) как ход и кусок → («Шаг пар» от ход и кусок)
  итог.«пары»

тотальная функция «Ключ на конце»
  принимает кусок: строка
  возвращает строка
  «После последней кавычки слева» от кусок

// Последняя кавычка слева: содержимое от последнего символа `"` до конца
// куска — это ключ, оставшийся ПОСЛЕ разреза `") или ("` слева от границы.
тотальная функция «После последней кавычки слева»
  принимает кусок: строка
  возвращает строка
  пусть литералы равно «Литералы текста» от (соединить [кусок, "\""] по "")
  разбор литералы
    случай пусто
      то ""
    случай голова и хвост
      то голова

// Первая кавычка справа: содержимое первого литерала куска — это ключ,
// оставшийся ПОСЛЕ разреза `") или ("` справа от границы.
тотальная функция «Первый литерал куска»
  принимает кусок: строка
  возвращает строка
  пусть литералы равно «Обратить список» от («Литералы текста» от кусок)
  разбор литералы
    случай пусто
      то ""
    случай голова и хвост
      то голова

тотальная функция «Обратить список»
  принимает перечень: список строки
  возвращает список строки
  разбор перечень
    случай пусто
      то пустой список
    случай голова и хвост
      то добавить голова к («Обратить список» от хвост)

// Порядок как у сортировки строк JavaScript по умолчанию: сравнение по кодам
// символов знак за знаком, короткий префикс меньше своего продолжения.
// Нужен именно ЭТОТ порядок, а не любой согласованный: ключ ведомости долга
// «--function/--utility» записан ИМЕННО в таком порядке, и сверка с ним
// обязана давать тот же порядок, что и `[а, б].sort()`.
тотальная функция «Строка меньше»
  принимает а: строка, б: строка
  возвращает признак
  пример «Пустая строка меньше непустой»
    дано а равно ""
    дано б равно "x"
    ожидается да
  пример «По первому несовпавшему знаку»
    дано а равно "--function"
    дано б равно "--utility"
    ожидается да
  разбор а
    случай пусто
      то не (пусто б)
    случай голова и хвост
      то если да
        то
          пусть перваяА равно голова
          пусть остатокА равно хвост
          разбор б
            случай пусто
              то нет
            случай голова и хвост
              то если (код символа перваяА) меньше (код символа голова)
                то да
                иначе если (код символа перваяА) больше (код символа голова)
                  то нет
                  иначе «Строка меньше» от остатокА и хвост
        иначе нет

тотальная функция «Пара упорядочена»
  принимает а: строка, б: строка
  возвращает строка
  если «Строка меньше» от б и а
    то соединить [б, "/", а] по ""
    иначе соединить [а, "/", б] по ""

тотальная функция «Пара если оба ключи»
  принимает слева: строка, справа: строка
  возвращает список строки
  если («Ключ ли» от слева) и притом («Ключ ли» от справа)
    то [(«Пара упорядочена» от слева и справа)]
    иначе пустой список

// ── Р: рукописный разбор на C (flang_repl.c, flang_cli.c) ───────────────────
//
// Читается ТЕМ ЖЕ приёмом, что и у эталона: делением по литералу и сверткой,
// без второго регулярного движка. Куски между вхождениями `strcmp(` дают
// готовое окно для каждого сравнения — то же окно, в котором свидетель ищет
// идиому «берёт значение» (у него оно ограничено следующей веткой или 4000
// знаками; здесь граница естественная — следующее «strcmp(»).

объект «Кусок сравнения»
  «годно»: признак
  «переменная»: строка
  «ключ»: строка
  «кусок»: строка

тотальная функция «После открывающей кавычки»
  принимает хвост_после_запятой: строка
  возвращает строка
  если хвост_после_запятой начинается с " \""
    то «После метки» от хвост_после_запятой и " \""
    иначе если хвост_после_запятой начинается с "\""
      то «После метки» от хвост_после_запятой и "\""
      иначе "ЗНАК-ЦИТАТЫ-НЕ-НАЙДЕН"

тотальная функция «Кавычка была»
  принимает хвост_после_запятой: строка
  возвращает признак
  (хвост_после_запятой начинается с " \"") или (хвост_после_запятой начинается с "\"")

тотальная функция «Разобрать кусок strcmp»
  принимает кусок: строка
  возвращает «Кусок сравнения»
  пусть переменная равно «До метки» от кусок и ","
  пусть после_запятой равно «Хвост после метки» от кусок и ","
  пусть годно равно (не (переменная равен кусок)) и притом («Кавычка была» от после_запятой)
  пусть содержимое равно (если годно то («До метки» от («После открывающей кавычки» от после_запятой) и "\"") иначе "")
  запись «Кусок сравнения» с «годно» равным годно и «переменная» равным переменная и «ключ» равным содержимое и «кусок» равным кусок

// «переменная равен кусок» у «Разобрать кусок strcmp» ловит случай «запятой
// нет вовсе»: тогда «До метки»/«Хвост после метки» отдают весь кусок и пусто
// соответственно — признак негодности среди двух пустых нужен другой:
// разделитель не нашёлся, значит «До метки» вернула ВЕСЬ кусок целиком.

// Окно ветви — от места сравнения до следующей ветви цепочки, как у
// свидетеля (`} else if (strcmp(` или `} else {`, что раньше). Первую
// границу поставил уже сам раздел кусков: он режет ровно по «strcmp(», а
// значит естественно не заходит за следующую ветвь ЭТОГО вида. Вторую —
// голый `} else {`, до которого своего «strcmp(» нет вовсе, — ставит эта
// функция: без неё окно уезжало бы в СЛЕДУЮЩУЮ, ничем не связанную функцию
// C, и «index += 1» из чужого цикла считалось бы значением этого ключа.
тотальная функция «Окно ветви»
  принимает кусок: строка
  возвращает строка
  если кусок содержит "} else {"
    то «До метки» от кусок и "} else {"
    иначе кусок

тотальная функция «Берёт значение»
  принимает счётчик: строка, кусок_целиком: строка
  возвращает признак
  пусть кусок равно «Окно ветви» от кусок_целиком
  (кусок содержит (соединить [счётчик, " + 1 < argc"] по "")) или (кусок содержит (соединить [счётчик, " += 1"] по "")) или (кусок содержит (соединить [счётчик, " += 2"] по "")) или (кусок содержит (соединить ["argv[", счётчик, " + 1]"] по ""))

// Счётчик — это то, что стоит в квадратных скобках («argv[index]» → «index»),
// а без скобок (голое имя) счётчиком служит само имя: идиома с чужим
// счётчиком («word = argv[read]») здесь не ловится нарочно — на сегодняшнем
// дереве расхождений «берёт значение» нет ни одного (ведомость долга,
// «Ключей... разошлось бы... ноль»), и заводить третью идиому ради нуля
// случаев значило бы стеречь воображаемое.
тотальная функция «Счётчик переменной»
  принимает переменная: строка
  возвращает строка
  если переменная содержит "["
    то «До метки» от («После метки» от переменная и "[") и "]"
    иначе переменная

тотальная функция «Пара если строки заканчиваются или»
  принимает левый_кусок: строка, ключ_слева: строка, ключ_справа: строка
  возвращает список строки
  если («Кончается двумя чёрточками» от левый_кусок) и притом («Ключ ли» от ключ_слева) и притом («Ключ ли» от ключ_справа)
    то [(«Пара упорядочена» от ключ_слева и ключ_справа)]
    иначе пустой список

объект «Ход разбора C»
  «начало»: признак
  «прошлый»: «Кусок сравнения»
  «ключи»: список строки
  «со значением»: список строки
  «команды»: список строки
  «пары»: список строки

тотальная функция «Пустой кусок сравнения»
  возвращает «Кусок сравнения»
  запись «Кусок сравнения» с «годно» равным нет и «переменная» равным "" и «ключ» равным "" и «кусок» равным ""

// ЗАДЕРЖКА НА ОДИН ШАГ, И ЭТО НЕ УСЛОЖНЕНИЕ РАДИ КРАСОТЫ. «Берёт значение»
// смотрит в окно ветви — а у пары написаний, слитой через «||»
// (`strcmp(…, "--предел-шагов") == 0 || strcmp(…, "--step-limit") == 0)`),
// СВОЙ кусок первого сравнения кончается ПРЯМО ПЕРЕД вторым «strcmp(» —
// раньше, чем дошло до `index += 1`. Тело ветви стоит уже ПОСЛЕ ВТОРОГО
// сравнения. Значит правило «берёт значение» для сравнения признаётся не
// сразу, а на СЛЕДУЮЩЕМ шаге — когда рядом окажется кусок соседа, и окно
// станет «мой кусок + strcmp( + кусок соседа». Найдено прогоном на
// «--предел-шагов»: без задержки Р отвечал «не берёт значение», хотя
// `index += 1;` в исходнике есть — просто не в этом куске.
тотальная функция «Окно значения»
  принимает свой_кусок: строка, кусок_соседа: строка
  возвращает строка
  соединить [свой_кусок, "strcmp(", кусок_соседа] по ""

// Окно РАСШИРЯЕТСЯ на соседа ТОЛЬКО когда свой кусок кончается «||» —
// то есть условие правда продолжается через границу. Без этой охраны окно
// растягивалось на соседа ВСЕГДА, и обычный переключатель («--pretty» без
// «||» на конце) прихватывал чужой `index += 1` из СЛЕДУЮЩЕЙ, ничем не
// связанной ветви — счётчик там часто зовётся тем же именем «index».
// Найдено прогоном: без охраны «--pretty» и «--no-spawn» показывали
// «берёт значение», хотя оба — голые переключатели.
тотальная функция «Части отложенного»
  принимает отложенный: «Кусок сравнения», кусок_соседа: строка
  возвращает «Ход разбора C»
  пусть добавить_ключ равно (отложенный.«годно») и притом (не (отложенный.«переменная» равен "command")) и притом (не (отложенный.«переменная» равен "topic")) и притом («Ключ ли» от (отложенный.«ключ»))
  пусть добавить_команду равно (отложенный.«годно») и притом (отложенный.«переменная» равен "command")
  пусть значение_ключи равно (если добавить_ключ то [(отложенный.«ключ»)] иначе пустой список)
  пусть продолжается равно «Кончается двумя чёрточками» от (отложенный.«кусок»)
  пусть окно равно (если продолжается то («Окно значения» от (отложенный.«кусок») и кусок_соседа) иначе (отложенный.«кусок»))
  пусть значение_со_значением равно (если добавить_ключ и притом («Берёт значение» от («Счётчик переменной» от (отложенный.«переменная»)) и окно) то [(отложенный.«ключ»)] иначе пустой список)
  пусть значение_команды равно (если добавить_команду то [(отложенный.«ключ»)] иначе пустой список)
  запись «Ход разбора C» с «начало» равным нет и «прошлый» равным («Пустой кусок сравнения») и «ключи» равным значение_ключи и «со значением» равным значение_со_значением и «команды» равным значение_команды и «пары» равным пустой список

тотальная функция «Шаг разбора C»
  принимает ход: «Ход разбора C», кусок: строка
  возвращает «Ход разбора C»
  пусть текущий равно «Разобрать кусок strcmp» от кусок
  пусть прошлый равно ход.«прошлый»
  пусть значение_пары равно (если (ход.«начало») или (не (прошлый.«годно»)) или (не (текущий.«годно»)) то пустой список иначе («Пара если строки заканчиваются или» от (прошлый.«кусок») и (прошлый.«ключ») и (текущий.«ключ»)))
  если ход.«начало»
    то запись «Ход разбора C» с «начало» равным нет и «прошлый» равным текущий и «ключи» равным (ход.«ключи») и «со значением» равным (ход.«со значением») и «команды» равным (ход.«команды») и «пары» равным (ход.«пары»)
    иначе
      пусть части равно «Части отложенного» от прошлый и (текущий.«кусок»)
      запись «Ход разбора C» с «начало» равным нет и «прошлый» равным текущий и «ключи» равным («Сложить строки» от (ход.«ключи») и (части.«ключи»)) и «со значением» равным («Сложить строки» от (ход.«со значением») и (части.«со значением»)) и «команды» равным («Сложить строки» от (ход.«команды») и (части.«команды»)) и «пары» равным («Сложить строки» от (ход.«пары») и значение_пары)

тотальная функция «Начальный ход разбора C»
  возвращает «Ход разбора C»
  запись «Ход разбора C» с «начало» равным да и «прошлый» равным («Пустой кусок сравнения») и «ключи» равным пустой список и «со значением» равным пустой список и «команды» равным пустой список и «пары» равным пустой список

// Последний кусок остаётся ОТЛОЖЕННЫМ после свёртки — соседа справа у него
// нет, окно ветви ограничивается его же куском без продолжения.
тотальная функция «Досчитать хвост разбора C»
  принимает ход: «Ход разбора C»
  возвращает «Ход разбора C»
  пусть прошлый равно ход.«прошлый»
  если не (прошлый.«годно»)
    то ход
    иначе
      пусть части равно «Части отложенного» от прошлый и ""
      запись «Ход разбора C» с «начало» равным нет и «прошлый» равным («Пустой кусок сравнения») и «ключи» равным («Сложить строки» от (ход.«ключи») и (части.«ключи»)) и «со значением» равным («Сложить строки» от (ход.«со значением») и (части.«со значением»)) и «команды» равным («Сложить строки» от (ход.«команды») и (части.«команды»)) и «пары» равным (ход.«пары»)

// Первый кусок разбиения — это ВСЁ, что стоит ДО первого вхождения метки, а
// не про вызов вовсе: на 16 000-строчном файле это может быть половина
// файла со своими запятыми и кавычками, никак не связанными с «strcmp(»/
// «human_word(». Считать его куском вызова — значит подсунуть разборщику
// чужой текст и получить приз наугад из первой попавшейся кавычки где-то в
// преамбуле. Эта функция снимает его: куски вызовов — то, что идёт СТРОГО
// после каждого настоящего вхождения метки.
тотальная функция «Куски после метки»
  принимает текст: строка, метка: строка
  возвращает список строки
  разбор (разделить текст по метка)
    случай пусто
      то пустой список
    случай голова и хвост
      то хвост

тотальная функция «Разбор C одного файла»
  принимает текст: строка
  возвращает «Ход разбора C»
  пусть куски равно «Куски после метки» от текст и "strcmp("
  пусть после_свёртки равно свёртка куски начиная с («Начальный ход разбора C») как ход и кусок → («Шаг разбора C» от ход и кусок)
  «Досчитать хвост разбора C» от после_свёртки

тотальная функция «Слить ходы разбора C»
  принимает первый: «Ход разбора C», второй: «Ход разбора C»
  возвращает «Набор ключей»
  запись «Набор ключей» с «ключи» равным («Без повторов строк» от («Сложить строки» от (первый.«ключи») и (второй.«ключи»))) и «со значением» равным («Без повторов строк» от («Сложить строки» от (первый.«со значением») и (второй.«со значением»))) и «без значения» равным пустой список и «команды» равным («Без повторов строк» от («Сложить строки» от (первый.«команды») и (второй.«команды»))) и «пары» равным («Без повторов строк» от («Сложить строки» от (первый.«пары») и (второй.«пары»)))

// Третий довод human_word — ГОЛОЕ слово: `human_word(command, "--help", "-h",
// "help")` даёт команду «help» так же, как `human_flag`-соседи дают ключи.
// Свидетель несёт его в «команды» БЕЗУСЛОВНО, чёрточки не спросив.
тотальная функция «Третий литерал»
  принимает текст: строка
  возвращает список строки
  если не («Начинается с кавычки после пробелов» от текст)
    то пустой список
    иначе
      пусть первый равно «Снять литерал» от текст
      пусть второй равно «Снять литерал» от (первый.«остаток»)
      пусть третий равно «Снять литерал» от (второй.«остаток»)
      если пусто (третий.«литерал»)
        то пустой список
        иначе [(третий.«литерал»)]

тотальная функция «Команды human_word»
  принимает репл: строка
  возвращает список строки
  пусть куски равно «Куски после метки» от репл и "human_word("
  «Без повторов строк» от свёртка куски начиная с пустой список как собрано и кусок → («Сложить строки» от собрано и («Третий литерал» от («Хвост после метки» от кусок и ",")))

тотальная функция «Разбор C»
  принимает репл: строка, сли: строка
  возвращает «Набор ключей»
  пусть из_strcmp равно «Слить ходы разбора C» от («Разбор C одного файла» от репл) и («Разбор C одного файла» от сли)
  пусть из_human равно «Ключи human» от репл
  пусть пары_human равно «Пары human» от репл
  пусть команды_human равно «Команды human_word» от репл
  пусть все_команды равно «Без повторов строк» от («Сложить строки» от (из_strcmp.«команды») и команды_human)
  запись «Набор ключей» с «ключи» равным («Без повторов строк» от («Сложить строки» от (из_strcmp.«ключи») и из_human)) и «со значением» равным (из_strcmp.«со значением») и «без значения» равным пустой список и «команды» равным все_команды и «пары» равным («Без повторов строк» от («Сложить строки» от (из_strcmp.«пары») и пары_human))

// ── human_word / human_flag: ЕЩЁ ДВА МЕСТА, ГДЕ C РАЗБИРАЕТ КЛЮЧИ ───────────
//
// `human_word(command, "--help", "-h", "help")` и
// `human_flag(argc, argv, "--version", "-v")` — тем же приёмом (деление по
// литералу «(имя_вызова»), но с двумя литералами на вызов, а не с одним.

