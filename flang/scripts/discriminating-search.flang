модуль «Различительный поиск»

объект «Вход»
  «метка»: строка
  «доводы»: список строки

тотальная функция «Вход одним доводом»
  принимает метка: строка, довод: строка
  возвращает «Вход»
  пример «Одноместный вход несёт один довод»
    дано метка равно "ноль"
    дано довод равно "0"
    ожидается запись «Вход» с «метка» равным "ноль" и «доводы» равным ["0"]
  запись «Вход» с «метка» равным метка и «доводы» равным [довод]

тотальная функция «Числа»
  возвращает список «Вход»
  [
    («Вход одним доводом» от "ноль" и "0"),
    («Вход одним доводом» от "минус ноль" и "0 умножить на (0 минус 1)"),
    («Вход одним доводом» от "единица" и "1"),
    («Вход одним доводом» от "минус единица" и "0 минус 1"),
    («Вход одним доводом» от "дробное" и "0.1"),
    («Вход одним доводом» от "не число" и "0 делить на 0"),
    («Вход одним доводом» от "бесконечность" и "1 делить на 0"),
    («Вход одним доводом» от "минус бесконечность" и "(0 минус 1) делить на 0"),
    («Вход одним доводом» от "край неотрицательное" и "9007199254740991"),
    («Вход одним доводом» от "за краем неотрицательное" и "9007199254740992"),
    («Вход одним доводом» от "предел двойной точности" и "1.7976931348623157e308")
  ]

тотальная функция «Метка среди»
  принимает метки: список строки, метка: строка
  возвращает признак
  пример «Метка названа»
    дано метки равно ["ноль", "единица"]
    дано метка равно "единица"
    ожидается да
  пример «Метки нет»
    дано метки равно пустой список
    дано метка равно "ноль"
    ожидается нет
  разбор метки
    случай пусто
      то нет
    случай голова и хвост
      то если голова равен метка
        то да
        иначе «Метка среди» от хвост и метка

тотальная функция «Ядро чисел»
  возвращает список «Вход»
  отфильтровать («Числа») где вход → («Метка среди» от ["ноль", "минус ноль", "единица", "минус единица", "не число", "бесконечность", "минус бесконечность"] и (вход.«метка»))

тотальная функция «Списки»
  возвращает список «Вход»
  [
    («Вход одним доводом» от "пустой" и "пустой список"),
    («Вход одним доводом» от "один" и "[1]"),
    («Вход одним доводом» от "по порядку" и "[1, 2, 3]"),
    («Вход одним доводом» от "вразнобой" и "[3, 1, 2]"),
    («Вход одним доводом» от "с не числом" и "[0 делить на 0]"),
    («Вход одним доводом» от "не число вторым" и "[1, 0 делить на 0]"),
    («Вход одним доводом» от "минус ноль и ноль" и "[0 умножить на (0 минус 1), 0]"),
    («Вход одним доводом» от "обе бесконечности" и "[(0 минус 1) делить на 0, 1 делить на 0]"),
    («Вход одним доводом» от "повторы" и "[2, 2, 2]")
  ]

тотальная функция «Строки»
  возвращает список «Вход»
  [
    («Вход одним доводом» от "пустая" и "\"\""),
    («Вход одним доводом» от "буква" и "\"а\""),
    («Вход одним доводом» от "слово" и "\"абв\""),
    («Вход одним доводом» от "смайлик в четыре октета" и "\"😀\""),
    («Вход одним доводом» от "пробел" и "\" \""),
    («Вход одним доводом» от "цифры" и "\"120\"")
  ]

тотальная функция «Сложить строки»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Два списка в один по порядку»
    дано первые равно ["а"]
    дано вторые равно ["б", "в"]
    ожидается ["а", "б", "в"]
  свёртка вторые начиная с первые как собрано и очередной → (добавить очередной к собрано)

тотальная функция «Сложить входы»
  принимает первые: список «Вход», вторые: список «Вход»
  возвращает список «Вход»
  свёртка вторые начиная с первые как собрано и вход → (добавить вход к собрано)

тотальная функция «Пары одного»
  принимает первый: «Вход», вторые: список «Вход»
  возвращает список «Вход»
  отобразить вторые как второй → (запись «Вход» с «метка» равным (соединить [(первый.«метка»), " + ", (второй.«метка»)] по "") и «доводы» равным («Сложить строки» от (первый.«доводы») и (второй.«доводы»)))

тотальная функция «Пары»
  принимает первые: список «Вход», вторые: список «Вход»
  возвращает список «Вход»
  пример «Крест два на один — метки через плюс, доводы по порядку»
    дано первые равно [(запись «Вход» с «метка» равным "а" и «доводы» равным ["1"]), (запись «Вход» с «метка» равным "б" и «доводы» равным ["2"])]
    дано вторые равно [(запись «Вход» с «метка» равным "в" и «доводы» равным ["3"])]
    ожидается [(запись «Вход» с «метка» равным "а + в" и «доводы» равным ["1", "3"]), (запись «Вход» с «метка» равным "б + в" и «доводы» равным ["2", "3"])]
  свёртка первые начиная с пустой список как собрано и первый → («Сложить входы» от собрано и («Пары одного» от первый и вторые))

объект «Цель»
  «имя»: строка
  «тело»: строка

тотальная функция «Цель с телом»
  принимает имя: строка, тело: строка
  возвращает «Цель»
  запись «Цель» с «имя» равным имя и «тело» равным тело

тотальная функция «Цели одного числа»
  возвращает список «Цель»
  [
    («Цель с телом» от "Тождество" и "х"),
    («Цель с телом» от "Модуль через не меньше" и "если х не меньше 0\n    то х\n    иначе 0 минус х"),
    («Цель с телом» от "Модуль через меньше" и "если х меньше 0\n    то 0 минус х\n    иначе х"),
    («Цель с телом» от "Противоположное" и "0 минус х"),
    («Цель с телом» от "Удвоить" и "х плюс х"),
    («Цель с телом» от "Квадрат" и "х умножить на х"),
    («Цель с телом» от "Плюс один" и "х плюс 1"),
    («Цель с телом» от "Минус один" и "х минус 1"),
    («Цель с телом» от "Половина" и "х делить на 2"),
    («Цель с телом» от "Обнулить умножением" и "х умножить на 0"),
    («Цель с телом» от "Обнулить вычитанием" и "х минус х"),
    («Цель с телом» от "Отсечь снизу нулём" и "если х не меньше 0\n    то х\n    иначе 0"),
    («Цель с телом» от "Через сложение нуля" и "х плюс 0"),
    («Цель с телом» от "Через умножение на единицу" и "х умножить на 1"),
    («Цель с телом» от "Через своё равенство" и "если х равен х\n    то х\n    иначе 0"),
    («Цель с телом» от "Туда и обратно сложением" и "(х плюс 1) минус 1"),
    («Цель с телом» от "Туда и обратно делением" и "(х умножить на 2) делить на 2")
  ]

