тотальная функция «Посчитать»
  принимает тексты: список строки, зовущий: строка
  возвращает «Счёт»
  пусть чистые равно (отобразить тексты как текст → («Без блочных» от текст))
  пусть ход равно («Разобрать ядро» от чистые)
  пусть работники равно (ход.«готовые»)
  пусть имена равно («Набор всех имён» от работники)
  пусть зовы равно («Зовы ядра» от чистые и имена)
  пусть поверхность равно («Набор поверхности» от зовущий и имена)
  пусть решения равно («Набор решений» от работники)
  пусть достижимо равно («Замыкание» от зовы и поверхность и 1000)
  пусть ядро равно («Замыкание» от зовы и решения и 1000)
  запись «Счёт» с «всего строк» равным (ход.«всего») и «комментарий» равным (ход.«комментарий») и «пусто» равным (ход.«пусто») и «обещания» равным (ход.«обещания») и «код» равным ((((ход.«всего») минус (ход.«комментарий»)) минус (ход.«пусто»)) минус (ход.«обещания»)) и «функций» равным (длина работники) и «поверхность» равным («Функций в наборе» от работники и поверхность) и «достижимо строк» равным («Строк в наборе» от работники и достижимо) и «ядро решений функций» равным («Функций в наборе» от работники и ядро) и «ядро решений строк» равным («Строк в наборе» от работники и ядро) и «только слова строк» равным («Строк только слов» от работники и ядро) и «только слова функций» равным («Функций только слов» от работники и ядро) и «разбор формы строк» равным («Разбора формы в наборе» от работники и ядро) и «с подписью узла» равным («С подписью узла в наборе» от работники и ядро)

тотальная функция «Доля процентов»
  принимает числитель: число, делитель: число
  возвращает число
  обеспечивает «Доля процентов: первая ветвь» если делитель равен 0 то результат равен (0) иначе да
  обеспечивает «доля процентов: первая ветвь» если делитель равен 0 то результат равен 0 иначе да
  пример «Треть»
    дано числитель равно 1
    дано делитель равно 3
    ожидается 33
  пример «Ровно половина округляется вверх»
    дано числитель равно 1
    дано делитель равно 8
    ожидается 13
  пример «Целого нет»
    дано числитель равно 5
    дано делитель равно 0
    ожидается 0
  если делитель равен 0
    то 0
    иначе
      пусть точно равно (((100 умножить на числитель) делить на делитель) плюс 0.5)
      точно минус (точно остаток от 1)

тотальная функция «Отчёт»
  принимает счёт: «Счёт»
  возвращает строка
  соединить [
    "три файла ядра доказательств: flang/self/proofterm.flang, flang/self/proof-kernel.flang, flang/self/proof-initial.flang\n",
    "  всего строк:                       ", (к строке (счёт.«всего строк»)), "\n",
    "  из них комментарий:                ", (к строке (счёт.«комментарий»)), "\n",
    "  из них пустых:                     ", (к строке (счёт.«пусто»)), "\n",
    "  из них обещаний и примеров:        ", (к строке (счёт.«обещания»)),
      "   (доказанное обещание и пример верить не заставляют)\n",
    "  КОД:                               ", (к строке (счёт.«код»)), "   (функций ", (к строке (счёт.«функций»)),
      ")\n",
    "  достижимо от поверхности ядра:     ", (к строке (счёт.«достижимо строк»)), "   (поверхность — ",
      (к строке (счёт.«поверхность»)), " имён, их зовёт compiler.flang)\n",
    "  ЯДРО РЕШЕНИЙ — верить надо ему:    ", (к строке (счёт.«ядро решений строк»)), "   (функций ",
      (к строке (счёт.«ядро решений функций»)), ")\n",
    "  только слова (текст отказов):      ", (к строке (счёт.«только слова строк»)), "   (функций ",
      (к строке (счёт.«только слова функций»)), ")\n",
    "  из ядра решений — разбор формы:    ", (к строке (счёт.«разбор формы строк»)), "   (",
      (к строке («Доля процентов» от (счёт.«разбор формы строк») и (счёт.«ядро решений строк»))),
      "% ядра решений; столько строк терм ТРОНЕТ — снимет меньше, разбор в шапке)\n",
    "  функций с «Значением» в подписи:   ", (к строке (счёт.«с подписью узла»)), " из ",
      (к строке (счёт.«ядро решений функций»))
  ] по ""

тотальная функция «Строка из потолка»
  принимает текст: строка, ключ: строка
  возвращает строка
  пример «Ключ найден»
    дано текст равно "{\n  \"почему\": \"довод\",\n  \"иное\": 1\n}"
    дано ключ равно "почему"
    ожидается "довод"
  пример «Ключа нет»
    дано текст равно "{\n}"
    дано ключ равно "нету"
    ожидается ""
  пусть искомое равно (соединить ["\"", ключ, "\": \""] по "")
  если не (текст содержит искомое)
    то ""
    иначе (голова (разделить (соединить (хвост (разделить текст по искомое)) по искомое) по "\""))

тотальная функция «Потолок текстом»
  принимает счёт: «Счёт», прежний: строка
  возвращает строка
  соединить [
    "{\n",
    "  \"снято\": \"", («Строка из потолка» от прежний и "снято"), "\",\n",
    "  \"коммит\": \"", («Строка из потолка» от прежний и "коммит"), "\",\n",
    "  \"почему\": \"", («Строка из потолка» от прежний и "почему"), "\",\n",
    "  \"наряд\": \"", («Строка из потолка» от прежний и "наряд"), "\",\n",
    "  \"всегоСтрок\": ", (к строке (счёт.«всего строк»)), ",\n",
    "  \"обещанияСтрок\": ", (к строке (счёт.«обещания»)), ",\n",
    "  \"код\": ", (к строке (счёт.«код»)), ",\n",
    "  \"функций\": ", (к строке (счёт.«функций»)), ",\n",
    "  \"поверхность\": ", (к строке (счёт.«поверхность»)), ",\n",
    "  \"достижимоСтрок\": ", (к строке (счёт.«достижимо строк»)), ",\n",
    "  \"ядроРешенийФункций\": ", (к строке (счёт.«ядро решений функций»)), ",\n",
    "  \"ядроРешенийСтрок\": ", (к строке (счёт.«ядро решений строк»)), ",\n",
    "  \"толькоСловаСтрок\": ", (к строке (счёт.«только слова строк»)), ",\n",
    "  \"разборФормыСтрок\": ", (к строке (счёт.«разбор формы строк»)), ",\n",
    "  \"сПодписьюУзла\": ", (к строке (счёт.«с подписью узла»)), "\n",
    "}\n"
  ] по ""

тотальная функция «Число из потолка»
  принимает текст: строка, ключ: строка
  возвращает число
  пример «Ключ найден»
    дано текст равно "{\n  \"ядроРешенийСтрок\": 3372,\n  \"иное\": 1\n}"
    дано ключ равно "ядроРешенийСтрок"
    ожидается 3372
  пример «Последний ключ без запятой»
    дано текст равно "{\n  \"сПодписьюУзла\": 371\n}"
    дано ключ равно "сПодписьюУзла"
    ожидается 371
  пример «Ключа нет»
    дано текст равно "{\n}"
    дано ключ равно "нету"
    ожидается -1
  пусть искомое равно (соединить ["\"", ключ, "\":"] по "")
  если не (текст содержит искомое)
    то 0 минус 1
    иначе
      пусть хвостик равно (соединить (хвост (разделить текст по искомое)) по искомое)
      пусть первая равно (голова (разделить хвостик по "\n"))
      к числу («Без пробелов» от (соединить (разделить первая по ",") по ""))

тотальная функция «Число из куч»
  принимает текст: строка, ключ: строка
  возвращает число
  пример «Ключ найден»
    дано текст равно "checkerCode 7602\ninferenceRules 109"
    дано ключ равно "checkerCode"
    ожидается 7602
  пример «Второй ключ тоже найден»
    дано текст равно "checkerCode 7602\ninferenceRules 109"
    дано ключ равно "inferenceRules"
    ожидается 109
  пример «Ключа нет»
    дано текст равно "checkerCode 7602"
    дано ключ равно "нету"
    ожидается -1
  пусть искомое равно (соединить [ключ, " "] по "")
  пусть строки равно (отфильтровать (разделить текст по "\n") где строчка → (строчка начинается с искомое))
  если пусто строки
    то 0 минус 1
    иначе к числу («Без пробелов» от (соединить (хвост (разделить (голова строки) по искомое)) по искомое))

тотальная функция «Счётчик кода на flang»
  возвращает строка
  обеспечивает «счётчик flang снимает блочные» результат содержит "index(l,\"*/\")"
  обеспечивает «счётчик flang снимает обещания» результат содержит "обеспечивает«"
  соединить [
    "BEGIN{c=0}FNR==1{f++}{r=$0;gsub(/[[:space:]]/,\"\",r);l=$0;o=\"\";",
    "while(l!=\"\"){if(c){t=index(l,\"*/\");if(!t){l=\"\";break}l=substr(l,t+2);c=0;continue}",
    "a=index(l,\"/*\");b=index(l,\"//\");",
    "if(a&&(!b||a<b)){o=o substr(l,1,a-1);l=substr(l,a+2);c=1;continue}",
    "if(b){o=o substr(l,1,b-1);l=\"\";break}o=o l;l=\"\"}",
    "s=o;gsub(/[[:space:]]/,\"\",s);if(r==\"\"||s==\"\")next;",
    "if(index(s,\"обеспечивает«\")==1||index(s,\"требует«\")==1||index(s,\"пример«\")==1",
    "||index(s,\"дано\")==1||index(s,\"ожидается\")==1)next;n++}",
    "END{print k, n+0; if(k2!=\"\")print k2, f+0}"
  ] по ""

тотальная функция «Счётчик кода на C»
  возвращает строка
  обеспечивает «счётчик C снимает блочные» результат содержит "index(l,\"*/\")"
  обеспечивает «счётчик C обещаний не знает» не (результат содержит "обеспечивает«")
  соединить [
    "BEGIN{c=0}FNR==1{f++}{l=$0;o=\"\";",
    "while(l!=\"\"){if(c){t=index(l,\"*/\");if(!t){l=\"\";break}l=substr(l,t+2);c=0;continue}",
    "a=index(l,\"/*\");b=index(l,\"//\");",
    "if(a&&(!b||a<b)){o=o substr(l,1,a-1);l=substr(l,a+2);c=1;continue}",
    "if(b){o=o substr(l,1,b-1);l=\"\";break}o=o l;l=\"\"}",
    "if(o~/[^[:space:]]/)n++}",
    "END{print k, n+0; if(k2!=\"\")print k2, f+0}"
  ] по ""

тотальная функция «Доводы куч»
  возвращает список строки
  обеспечивает «кучи считаются от корня дерева» (элемент 2 в результат) содержит "cd ../.."
  обеспечивает «список замыкания берётся из отпечатка печати» (элемент 2 в результат) содержит "scripts/seed-fingerprint"
  обеспечивает «оболочке отдаётся один довод» (длина результат) равен 2
  обеспечивает «пустой список файлов даёт отказ, а не ноль» (элемент 2 в результат) содержит "exit 4"
  ["-c", (соединить [
    "cd ../.. || exit 2; ",
    "COUNT_FLANG='", («Счётчик кода на flang»), "'; ",
    "COUNT_C='", («Счётчик кода на C»), "'; ",
    "PICK='/^[0-9a-f][0-9a-f]*  / { print $2 }'; FINGERPRINT=scripts/seed-fingerprint; ",
    "[ -r $FINGERPRINT ] || { echo 'отпечаток печати scripts/seed-fingerprint не читается' >&2; exit 3; }; ",
    "CLOSURE=$(awk \"$PICK\" $FINGERPRINT | grep 'flang$'); ",
    "RUNTIME=$(awk \"$PICK\" $FINGERPRINT | grep '^flang/src/emit/c/'); ",
    "SEED=$(awk \"$PICK\" $FINGERPRINT | grep '^bootstrap/' | grep -v Makefile); ",
    "[ -n \"$CLOSURE\" ] || { echo 'в отпечатке печати нет ни одного файла на flang' >&2; exit 4; }; ",
    "[ -n \"$RUNTIME\" ] || { echo 'в отпечатке печати нет рантайма flang/src/emit/c' >&2; exit 4; }; ",
    "[ -n \"$SEED\" ] || { echo 'в отпечатке печати нет тела семени bootstrap' >&2; exit 4; }; ",
    "awk -v k=kernelFilesCode \"$COUNT_FLANG\" flang/self/proofterm.flang flang/self/proof-kernel.flang flang/self/proof-initial.flang && ",
    "awk -v k=seedSourcesCode -v k2=seedSourcesFiles \"$COUNT_FLANG\" $CLOSURE && ",
    "awk -v k=parsingCode \"$COUNT_FLANG\" flang/self/lexer.flang flang/self/parser.flang && ",
    "awk -v k=evaluatorCode \"$COUNT_FLANG\" flang/self/interpret.flang && ",
    "awk -v k=emitCCode \"$COUNT_FLANG\" flang/self/emit-c.flang && ",
    "awk -v k=typeCheckCode \"$COUNT_FLANG\" flang/self/types.flang && ",
    "awk -v k=runtimeCode -v k2=runtimeFiles \"$COUNT_C\" $RUNTIME && ",
    "awk -v k=printedCCode -v k2=printedCFiles \"$COUNT_C\" $SEED && ",
    "awk -v k=checkerCode \"$COUNT_C\" flang/proof/checker/checker.c && ",
    "awk -F'\t' -v k=inferenceRules 'NR > 1 && NF > 3 { n++ } END { print k, n+0 }' flang/proof/tables/inference-rules.tsv"
  ] по "")]

тотальная функция «Файл потолка пути»
  возвращает строка
  обеспечивает «файл потолка пути: в постоянной стоит слово» результат содержит "lines-to-trust-ceiling.json"
  обеспечивает «файл потолка пути: длина постоянной» (длина результат) равен 27
  "lines-to-trust-ceiling.json"

тотальная функция «Кучи потолка»
  возвращает список строки
  обеспечивает «под храповиком десять куч» (длина результат) равен 10
  обеспечивает «сверщик под храповиком тоже» (элемент 10 в результат) равен "checkerCode"
  ["decisionKernelLines", "kernelFilesCode", "seedSourcesCode", "parsingCode",
   "evaluatorCode", "emitCCode", "typeCheckCode", "runtimeCode", "printedCCode",
   "checkerCode"]

тотальная функция «Число кучи»
  принимает счёт: «Счёт», кучи: строка, ключ: строка
  возвращает число
  если ключ равен "decisionKernelLines"
    то счёт.«ядро решений строк»
    иначе «Число из куч» от кучи и ключ

тотальная функция «Строка сдвига»
  принимает ключ: строка, было: число, стало: число
  возвращает строка
  пример «Куча не двинулась — строки нет»
    дано ключ равно "checkerCode"
    дано было равно 7602
    дано стало равно 7602
    ожидается ""
  пример «Куча выросла»
    дано ключ равно "checkerCode"
    дано было равно 7602
    дано стало равно 7610
    ожидается "\n  • checkerCode: было 7602, стало 7610 (+8)"
  пример «Куча уменьшилась»
    дано ключ равно "checkerCode"
    дано было равно 7602
    дано стало равно 7600
    ожидается "\n  · checkerCode: было 7602, стало 7600 (−2)"
  пусть выросла равно (стало больше было)
  пусть метка равно (если выросла то "\n  • " иначе "\n  · ")
  пусть знак равно (если выросла то "+" иначе "−")
  пусть разность равно (если выросла то (стало минус было) иначе (было минус стало))
  если стало равен было
    то ""
    иначе соединить [метка, ключ, ": было ", (к строке было), ", стало ", (к строке стало), " (", знак,
      (к строке разность), ")"] по ""

тотальная функция «Сдвиги куч»
  принимает счёт: «Счёт», кучи: строка, потолок: строка, вверх: признак
  возвращает строка
  свёртка («Кучи потолка») начиная с "" как собрано и ключ
      пусть было равно («Число из потолка» от потолок и ключ)
      пусть стало равно («Число кучи» от счёт и кучи и ключ)
      если ((было меньше 0) или (стало меньше 0)) или (не ((стало больше было) равен вверх))
        то собрано
        иначе соединить [собрано, («Строка сдвига» от ключ и было и стало)] по ""

тотальная функция «Неснятых куч»
  принимает счёт: «Счёт», кучи: строка, потолок: строка
  возвращает строка
  свёртка («Кучи потолка») начиная с "" как собрано и ключ
      пусть несчитано равно ((«Число кучи» от счёт и кучи и ключ) меньше 0)
      пусть безпотолка равно ((не несчитано) и притом ((«Число из потолка» от потолок и ключ) меньше 0))
      соединить [
        собрано,
        (если несчитано то (соединить ["\n  ? ", ключ, " — прибор числа не дал"] по "") иначе ""),
        (если безпотолка то (соединить ["\n  ? ", ключ, " — в потолке ключа нет"] по "") иначе "")
      ] по ""

тотальная функция «Сверка двух счётчиков»
  принимает счёт: «Счёт», кучи: строка
  возвращает строка
  пример «Счётчики сошлись»
    дано счёт равно (запись «Счёт» с «всего строк» равным 0 и «комментарий» равным 0 и «пусто» равным 0 и «обещания» равным 0 и «код» равным 9211 и «функций» равным 0 и «поверхность» равным 0 и «достижимо строк» равным 0 и «ядро решений функций» равным 0 и «ядро решений строк» равным 0 и «только слова строк» равным 0 и «только слова функций» равным 0 и «разбор формы строк» равным 0 и «с подписью узла» равным 0)
    дано кучи равно "kernelFilesCode 9211"
    ожидается ""
  пример «Счётчики разошлись»
    дано счёт равно (запись «Счёт» с «всего строк» равным 0 и «комментарий» равным 0 и «пусто» равным 0 и «обещания» равным 0 и «код» равным 9211 и «функций» равным 0 и «поверхность» равным 0 и «достижимо строк» равным 0 и «ядро решений функций» равным 0 и «ядро решений строк» равным 0 и «только слова строк» равным 0 и «только слова функций» равным 0 и «разбор формы строк» равным 0 и «с подписью узла» равным 0)
    дано кучи равно "kernelFilesCode 9200"
    ожидается "\n  счётчик на flang насчитал в трёх файлах ядра 9211 строк кода, счётчик на awk — 9200"
  если («Число из куч» от кучи и "kernelFilesCode") равен (счёт.«код»)
    то ""
    иначе соединить ["\n  счётчик на flang насчитал в трёх файлах ядра ", (к строке (счёт.«код»)),
      " строк кода, счётчик на awk — ", (к строке («Число из куч» от кучи и "kernelFilesCode"))] по ""

тотальная функция «Отчёт всего пути»
  принимает счёт: «Счёт», кучи: строка
  возвращает строка
  пусть исходники равно ((«Число из куч» от кучи и "seedSourcesCode") плюс («Число из куч» от кучи и "runtimeCode"))
  соединить [
    "СКОЛЬКО СТРОК ПРИДЁТСЯ ПРИНЯТЬ НА ВЕРУ — по всему пути, а не по одному ядру\n\n",
    "  ОДНО ЧИСЛО, читая исходники и веря печати:        ", (к строке исходники), "\n",
    "  ОНО ЖЕ, не веря печати, а читая напечатанное:     ", (к строке («Число из куч» от кучи и "printedCCode")), "\n",
    "  вторым путём — верить только сверщику на C:       ", (к строке («Число из куч» от кучи и "checkerCode")), "\n\n",
    "кучи, каждая своим счётом:\n",
    "  1 ядро решений на flang                    ", (к строке (счёт.«ядро решений строк»)), "   из ",
      (к строке («Число из куч» от кучи и "kernelFilesCode")), " строк кода трёх файлов ядра\n",
    "  2 замыкание печати семени на flang        ", (к строке («Число из куч» от кучи и "seedSourcesCode")),
      "   файлов ", (к строке («Число из куч» от кучи и "seedSourcesFiles")), ", ядро внутри\n",
    "      из него разбор исходника               ", (к строке («Число из куч» от кучи и "parsingCode")),
      "   lexer.flang и parser.flang\n",
    "      из него вычислитель                    ", (к строке («Число из куч» от кучи и "evaluatorCode")),
      "   interpret.flang\n",
    "      из него печать в C                     ", (к строке («Число из куч» от кучи и "emitCCode")),
      "   emit-c.flang\n",
    "      из него проверка типов                 ", (к строке («Число из куч» от кучи и "typeCheckCode")),
      "   types.flang\n",
    "  3 рукописный рантайм на C                 ", (к строке («Число из куч» от кучи и "runtimeCode")), "   файлов ",
      (к строке («Число из куч» от кучи и "runtimeFiles")), ", уезжают в печать дословно\n",
    "  4 напечатанный C семени                  ", (к строке («Число из куч» от кучи и "printedCCode")), "   файлов ",
      (к строке («Число из куч» от кучи и "printedCFiles")), ", их и собирает cc\n",
    "  5 независимый сверщик на C                  ", (к строке («Число из куч» от кучи и "checkerCode")),
      "   flang/proof/checker/checker.c\n",
    "  6 компилятор C                         НЕ СНЯТО   исходников cc в дереве нет; CompCert не замерен (ADR-0030)\n",
    "  7 ведомость правил вывода                   ", (к строке («Число из куч» от кучи и "inferenceRules")),
      " правил   flang/proof/tables/inference-rules.tsv, храповик её не судит\n\n",
    "что считается строкой:\n",
    "  flang — строка, на которой после снятия /* */ и // остаётся непробельный знак\n",
    "          и которая не начинается словом обеспечивает, требует, пример, дано, ожидается\n",
    "  C     — строка, на которой после снятия /* */ и // остаётся непробельный знак\n",
    "          (то же правило, что у сторожа С-6: bootstrap/flang io flang/proof/tables-guard.fscript --max-steps 4000000000 --timeout 900000 -- --code-lines)\n",
    "  список замыкания печати и рантайма берётся из scripts/seed-fingerprint, а не руками\n\n",
    "два счётчика держат друг друга: те же три файла ядра счёл и счётчик на flang\n",
    "  из этого прибора (", (к строке (счёт.«код»)), " строк кода), и счётчик на awk (",
    (к строке («Число из куч» от кучи и "kernelFilesCode")), ") — расхождение красит замер"
  ] по ""

объект «Отказ пути»
  «код»: строка
  «начало»: строка
  «беда»: строка
  «конец»: строка

тотальная функция «Правила отказа пути»
  принимает счёт: «Счёт», кучи: строка, потолок: строка
  возвращает список «Отказ пути»
  обеспечивает «правил отказа четыре» (длина результат) равен 4
  [
    запись «Отказ пути» с «код» равным "FLANG_TRUST_PATH_COUNTS_DIFFER" и «начало» равным "ДВА СЧЁТЧИКА РАЗОШЛИСЬ:" и «беда» равным («Сверка двух счётчиков» от счёт и кучи) и «конец» равным "\n\nПока они не сходятся, счёт по кучам не значит ничего: правило строки у них одно,\nи разное число значит, что одно из двух его нарушает.",
    запись «Отказ пути» с «код» равным "FLANG_TRUST_PATH_NO_CEILING" и «начало» равным "судить нечем:" и «беда» равным («Неснятых куч» от счёт и кучи и потолок) и «конец» равным "\n\nзапишите потолок: --plan 'Переписать потолок всего пути'",
    запись «Отказ пути» с «код» равным "FLANG_TRUST_PATH_CEILING_BROKEN" и «начало» равным "ВЕРИТЬ ПРИХОДИТСЯ БОЛЬШЕМУ, ЧЕМ ВЧЕРА:" и «беда» равным («Сдвиги куч» от счёт и кучи и потолок и да) и «конец» равным "\n\nПотолок ползёт только вниз. Либо снимите доверие с выросшей кучи,\nлибо напишите довод и перепишите потолок.",
    запись «Отказ пути» с «код» равным "FLANG_TRUST_PATH_CEILING_STALE" и «начало» равным "стало МЕНЬШЕ — перепишите потолок:" и «беда» равным («Сдвиги куч» от счёт и кучи и потолок и нет) и «конец» равным ""
  ]

тотальная функция «Вердикт пути»
  принимает счёт: «Счёт», кучи: строка, потолок: строка
  возвращает «Продолжение»
  пусть отчёт равно (соединить [(«Отчёт» от счёт), "\n\n", («Отчёт всего пути» от счёт и кучи)] по "")
  пусть сработали равно (отфильтровать («Правила отказа пути» от счёт и кучи и потолок) где отказ → не ((длина (отказ.«беда»)) равен 0))
  разбор сработали
    случай пусто
      то вариант «Конец работы» с значение равным (соединить [отчёт, "\n\nпотолок всего пути не пробит"] по "")
    случай голова и хвост
      то вариант «Провал» с код равным (голова.«код») и сообщение равным (соединить [отчёт, "\n\n", (голова.«начало»),
        (голова.«беда»), (голова.«конец»)] по "")

тотальная функция «Потолок пути текстом»
  принимает счёт: «Счёт», кучи: строка
  возвращает строка
  пусть исходники равно ((«Число из куч» от кучи и "seedSourcesCode") плюс («Число из куч» от кучи и "runtimeCode"))
  соединить [
    "{\n",
    "  \"decisionKernelLines\": ", (к строке (счёт.«ядро решений строк»)), ",\n",
    "  \"kernelFilesCode\": ", (к строке («Число из куч» от кучи и "kernelFilesCode")), ",\n",
    "  \"seedSourcesCode\": ", (к строке («Число из куч» от кучи и "seedSourcesCode")), ",\n",
    "  \"seedSourcesFiles\": ", (к строке («Число из куч» от кучи и "seedSourcesFiles")), ",\n",
    "  \"parsingCode\": ", (к строке («Число из куч» от кучи и "parsingCode")), ",\n",
    "  \"evaluatorCode\": ", (к строке («Число из куч» от кучи и "evaluatorCode")), ",\n",
    "  \"emitCCode\": ", (к строке («Число из куч» от кучи и "emitCCode")), ",\n",
    "  \"typeCheckCode\": ", (к строке («Число из куч» от кучи и "typeCheckCode")), ",\n",
    "  \"runtimeCode\": ", (к строке («Число из куч» от кучи и "runtimeCode")), ",\n",
    "  \"runtimeFiles\": ", (к строке («Число из куч» от кучи и "runtimeFiles")), ",\n",
    "  \"printedCCode\": ", (к строке («Число из куч» от кучи и "printedCCode")), ",\n",
    "  \"printedCFiles\": ", (к строке («Число из куч» от кучи и "printedCFiles")), ",\n",
    "  \"checkerCode\": ", (к строке («Число из куч» от кучи и "checkerCode")), ",\n",
    "  \"inferenceRules\": ", (к строке («Число из куч» от кучи и "inferenceRules")), ",\n",
    "  \"totalSources\": ", (к строке исходники), ",\n",
    "  \"totalPrinted\": ", (к строке («Число из куч» от кучи и "printedCCode")), "\n",
    "}\n"
  ] по ""

тотальная функция «Ядро решений поимённо»
  принимает работники: список «Работник», ядро: строка
  возвращает строка
  свёртка работники начиная с "" как акк и раб
      если ядро содержит (раб.«метка»)
        то соединить [акк, "\n  ", (к строке (раб.«код»)), "  ", (раб.«метка»)] по ""
        иначе акк

тотальная функция «Файлы ядра»
  возвращает список строки
  обеспечивает «файлы ядра: длина постоянного списка» (длина результат) равен 3
  ["../self/proofterm.flang", "../self/proof-kernel.flang", "../self/proof-initial.flang"]

тотальная функция «Файл зовущего»
  возвращает строка
  обеспечивает «файл зовущего: в постоянной стоит слово» результат содержит "../self/bootstrap/compiler.flang"
  обеспечивает «файл зовущего: длина постоянной» (длина результат) равен 32
  "../self/bootstrap/compiler.flang"

тотальная функция «Файл потолка»
  возвращает строка
  обеспечивает «файл потолка: в постоянной стоит слово» результат содержит "kernel-lines-to-trust-ceiling.json"
  обеспечивает «файл потолка: длина постоянной» (длина результат) равен 34
  "kernel-lines-to-trust-ceiling.json"

тип «Ход»
  вариант «Ждём потолок» содержит режим: строка
  вариант «Ждём ядро» содержит режим: строка, потолок: строка, тексты: список строки, осталось: список строки
  вариант «Ждём зовущего» содержит режим: строка, потолок: строка, тексты: список строки
  вариант «Ждём записи» содержит отчёт: строка
  вариант «Ждём потолок пути» содержит режим: строка, счёт: «Счёт»
  вариант «Ждём кучи» содержит режим: строка, счёт: «Счёт», потолок: строка

тотальная функция «Начать»
  возвращает «Ход»
  вариант «Ждём потолок» с режим равным "сверить"

тотальная функция «Начать список»
  возвращает «Ход»
  вариант «Ждём потолок» с режим равным "поимённо"

тотальная функция «Начать запись»
  возвращает «Ход»
  вариант «Ждём потолок» с режим равным "переписать"

тотальная функция «Начать весь путь»
  возвращает «Ход»
  вариант «Ждём потолок» с режим равным "весь путь"

тотальная функция «Начать запись пути»
  возвращает «Ход»
  вариант «Ждём потолок» с режим равным "переписать путь"

тотальная функция «Прочитать»
  принимает путь: строка, потом: «Ход»
  возвращает «Продолжение»
  вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным путь) и потом равным потом

тотальная функция «Вердикт»
  принимает счёт: «Счёт», потолок: строка
  возвращает «Продолжение»
  пусть отчёт равно («Отчёт» от счёт)
  пусть прежнееядро равно («Число из потолка» от потолок и "ядроРешенийСтрок")
  пусть прежнеедостижимо равно («Число из потолка» от потолок и "достижимоСтрок")
  если (прежнееядро меньше 0) или (прежнеедостижимо меньше 0)
    то вариант «Провал» с код равным "FLANG_VERIT_POTOLKA_NET" и сообщение равным (соединить [отчёт, "\n\nпотолка нет — запишите его: --plan 'Переписать потолок'"] по "")
    иначе
      пусть выросло равно (соединить [
        (если (счёт.«ядро решений строк») больше прежнееядро то (соединить ["\n  • ядроРешенийСтрок: было ", (к строке прежнееядро), ", стало ", (к строке (счёт.«ядро решений строк»)), " (+", (к строке ((счёт.«ядро решений строк») минус прежнееядро)), ")"] по "") иначе ""),
        (если (счёт.«достижимо строк») больше прежнеедостижимо то (соединить ["\n  • достижимоСтрок: было ", (к строке прежнеедостижимо), ", стало ", (к строке (счёт.«достижимо строк»)), " (+", (к строке ((счёт.«достижимо строк») минус прежнеедостижимо)), ")"] по "") иначе "")
      ] по "")
      если не ((длина выросло) равен 0)
        то вариант «Провал» с код равным "FLANG_VERIT_POTOLOK_PROBIT" и сообщение равным (соединить [отчёт, "\n\nВЕРИТЬ ПРИХОДИТСЯ БОЛЬШЕМУ, ЧЕМ ВЧЕРА:", выросло, "\n\nПотолок ползёт только вниз. Либо перенесите работу из ядра решений\nв то, что вердикта не касается, либо напишите довод и перепишите потолок."] по "")
        иначе
          пусть упало равно (соединить [
            (если (счёт.«ядро решений строк») меньше прежнееядро то (соединить ["\n  ядроРешенийСтрок: было ", (к строке прежнееядро), ", стало ", (к строке (счёт.«ядро решений строк»)), " (−", (к строке (прежнееядро минус (счёт.«ядро решений строк»))), ")"] по "") иначе ""),
            (если (счёт.«достижимо строк») меньше прежнеедостижимо то (соединить ["\n  достижимоСтрок: было ", (к строке прежнеедостижимо), ", стало ", (к строке (счёт.«достижимо строк»)), " (−", (к строке (прежнеедостижимо минус (счёт.«достижимо строк»))), ")"] по "") иначе "")
          ] по "")
          если не ((длина упало) равен 0)
            то вариант «Провал» с код равным "FLANG_VERIT_POTOLOK_USTAREL" и сообщение равным (соединить [отчёт, "\n\nстало МЕНЬШЕ — перепишите потолок:", упало] по "")
            иначе вариант «Конец работы» с значение равным (соединить [отчёт, "\n\nпотолок не пробит"] по "")

тотальная функция «Список поимённо»
  принимает тексты: список строки, счёт: «Счёт»
  возвращает «Продолжение»
  пусть чистые равно (отобразить тексты как текст → («Без блочных» от текст))
  пусть ход равно («Разобрать ядро» от чистые)
  пусть работники равно (ход.«готовые»)
  пусть имена равно («Набор всех имён» от работники)
  пусть зовы равно («Зовы ядра» от чистые и имена)
  пусть ядро равно («Замыкание» от зовы и («Набор решений» от работники) и 1000)
  вариант «Конец работы» с значение равным (соединить [(«Отчёт» от счёт), "\n\nядро решений поимённо:",
    («Ядро решений поимённо» от работники и ядро)] по "")

тотальная функция «Ответить по ядру»
  принимает режим: строка, потолок: строка, тексты: список строки, счёт: «Счёт»
  возвращает «Продолжение»
  если режим равен "переписать"
    то вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным («Файл потолка») и содержимое равным («Потолок текстом» от счёт и потолок)) и потом равным (вариант «Ждём записи» с отчёт равным (соединить [(«Отчёт» от счёт), "\n\nпотолок переписан. Проза в шапке (снято, коммит, почему, наряд)\nперенесена как была — перепишите её руками под этот замер."] по ""))
    иначе
      если режим равен "поимённо"
        то «Список поимённо» от тексты и счёт
        иначе «Вердикт» от счёт и потолок

тотальная функция «Ответить»
  принимает режим: строка, потолок: строка, тексты: список строки, зовущий: строка
  возвращает «Продолжение»
  пусть счёт равно («Посчитать» от тексты и зовущий)
  если (режим равен "весь путь") или (режим равен "переписать путь")
    то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным («Файл потолка пути»)) и потом равным (вариант «Ждём потолок пути» с режим равным режим и счёт равным счёт)
    иначе «Ответить по ядру» от режим и потолок и тексты и счёт

тотальная функция «После потолка»
  принимает режим: строка, отклик: «Отклик»
  возвращает «Продолжение»
  обеспечивает «После потолка: ветвь Пока ничего» если отклик равен (вариант «Пока ничего») то результат равен («Прочитать» от («Файл потолка») и (вариант «Ждём потолок» с режим равным режим)) иначе да
  разбор отклик
    случай вариант «Пока ничего»
      то «Прочитать» от («Файл потолка») и (вариант «Ждём потолок» с режим равным режим)
    случай вариант «Прочитано» с содержимое как текст
      то «Прочитать» от (голова («Файлы ядра»)) и (вариант «Ждём ядро» с режим равным режим и потолок равным текст и тексты равным (пустой список) и осталось равным (хвост («Файлы ядра»)))
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то «Прочитать» от (голова («Файлы ядра»)) и (вариант «Ждём ядро» с режим равным режим и потолок равным "" и тексты равным (пустой список) и осталось равным (хвост («Файлы ядра»)))
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали текст потолка"

тотальная функция «Дальше по ядру»
  принимает режим: строка, потолок: строка, тексты: список строки, осталось: список строки, текст: строка
  возвращает «Продолжение»
  пусть собрано равно (добавить текст к тексты)
  если пусто осталось
    то «Прочитать» от («Файл зовущего») и (вариант «Ждём зовущего» с режим равным режим и потолок равным потолок и тексты равным собрано)
    иначе «Прочитать» от (голова осталось) и (вариант «Ждём ядро» с режим равным режим и потолок равным потолок и тексты равным собрано и осталось равным (хвост осталось))

тотальная функция «После файла ядра»
  принимает режим: строка, потолок: строка, тексты: список строки, осталось: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Прочитано» с содержимое как текст
      то «Дальше по ядру» от режим и потолок и тексты и осталось и текст
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_VERIT_YADRA_NET" и сообщение равным (соединить ["файл ядра не прочитан (",
        код, "): ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали текст файла ядра"

тотальная функция «После зовущего»
  принимает режим: строка, потолок: строка, тексты: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Прочитано» с содержимое как текст
      то «Ответить» от режим и потолок и тексты и текст
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_VERIT_ZOVUSHCHEGO_NET" и сообщение равным (соединить [
        "compiler.flang не прочитан (", код, "): ", сообщение, " — поверхность ядра брать неоткуда"] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали текст compiler.flang"

тотальная функция «После записи»
  принимает отчёт: строка, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Записано»
      то вариант «Конец работы» с значение равным (соединить [отчёт, "\n\nпотолок переписан"] по "")
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_VERIT_POTOLOK_NE_ZAPISAN" и сообщение равным (соединить [
        "потолок не записан (", код, "): ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали подтверждение записи"

тотальная функция «После потолка пути»
  принимает режим: строка, счёт: «Счёт», отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Прочитано» с содержимое как текст
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным («Доводы куч»)) и потом равным (вариант «Ждём кучи» с режим равным режим и счёт равным счёт и потолок равным текст)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным («Доводы куч»)) и потом равным (вариант «Ждём кучи» с режим равным режим и счёт равным счёт и потолок равным "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали текст потолка всего пути"

тотальная функция «Ответ по кучам»
  принимает режим: строка, счёт: «Счёт», потолок: строка, вывод: строка
  возвращает «Продолжение»
  если режим равен "переписать путь"
    то вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным («Файл потолка пути») и содержимое равным («Потолок пути текстом» от счёт и вывод)) и потом равным (вариант «Ждём записи» с отчёт равным (соединить [(«Отчёт всего пути» от счёт и вывод), "\n\nпотолок всего пути переписан. В файле потолка одни числа;\nдовод, почему он сдвинут, пишется в задачу."] по ""))
    иначе «Вердикт пути» от счёт и вывод и потолок

тотальная функция «После куч»
  принимает режим: строка, счёт: «Счёт», потолок: строка, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то если не (код равен 0)
        то вариант «Провал» с код равным "FLANG_TRUST_PATH_NO_COUNT" и сообщение равным (соединить ["счётчик куч ответил кодом ", (к строке код), ": ", ошибки, " — мерить нечем"] по "")
        иначе «Ответ по кучам» от режим и счёт и потолок и вывод
    случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
      то вариант «Провал» с код равным "FLANG_TRUST_PATH_NO_COUNT" и сообщение равным (соединить ["счётчик куч убит сигналом ", сигнал] по "")
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным (соединить ["счётчик куч не запустился: ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответ счётчика куч"

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём потолок» с режим как режим
      то «После потолка» от режим и отклик
    случай вариант «Ждём ядро» с режим как режим и потолок как потолок и тексты как тексты и осталось как осталось
      то «После файла ядра» от режим и потолок и тексты и осталось и отклик
    случай вариант «Ждём зовущего» с режим как режим и потолок как потолок и тексты как тексты
      то «После зовущего» от режим и потолок и тексты и отклик
    случай вариант «Ждём записи» с отчёт как отчёт
      то «После записи» от отчёт и отклик
    случай вариант «Ждём потолок пути» с режим как режим и счёт как счёт
      то «После потолка пути» от режим и счёт и отклик
    случай вариант «Ждём кучи» с режим как режим и счёт как счёт и потолок как потолок
      то «После куч» от режим и счёт и потолок и отклик

план «Потолок не пробит»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»

план «Ядро решений поимённо»
  состояние «Ход»
  начинает с «Начать список»
  обрабатывает «Дальше»

план «Переписать потолок»
  состояние «Ход»
  начинает с «Начать запись»
  обрабатывает «Дальше»

план «Сколько верим по всему пути»
  состояние «Ход»
  начинает с «Начать весь путь»
  обрабатывает «Дальше»

план «Переписать потолок всего пути»
  состояние «Ход»
  начинает с «Начать запись пути»
  обрабатывает «Дальше»

тотальная функция «Объявление короткой команды trust:ceiling»
  возвращает строка
  "bootstrap/flang io --plan 'Сколько верим по всему пути' --max-steps 2000000000 — скольким строкам приходится верить по ВСЕМУ пути, а не по одному ядру: ядро решений, замыкание печати семени на flang, разбор исходника, вычислитель, рукописный рантайм на C, напечатанное семя, независимый проверяющий на C, таблица правил вывода; потолок ползёт только вниз"
