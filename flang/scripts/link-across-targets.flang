модуль «Связь на целях»

объект «Цель»
  «имя»: строка
  «куда»: строка
  «сборка»: строка
  «запуск»: строка

тотальная функция «Цели»
  возвращает список «Цель»
  обеспечивает «девять целей» (длина результат) равен 9
  [запись «Цель» с «имя» равным "js" и «куда» равным "." и «сборка» равным "true" и «запуск» равным "node flang_cli.js svyaz_uzlov.js",
   запись «Цель» с «имя» равным "python" и «куда» равным "." и «сборка» равным "make check" и «запуск» равным "python3 -B flang_cli.py svyaz_uzlov",
   запись «Цель» с «имя» равным "go" и «куда» равным "." и «сборка» равным "make" и «запуск» равным "./flang_cli",
   запись «Цель» с «имя» равным "c" и «куда» равным "." и «сборка» равным "make" и «запуск» равным "./flang_cli",
   запись «Цель» с «имя» равным "cpp" и «куда» равным "." и «сборка» равным "make" и «запуск» равным "./flang_cli",
   запись «Цель» с «имя» равным "rust" и «куда» равным "." и «сборка» равным "RUSTFLAGS='-D warnings' cargo build --offline" и «запуск» равным "./target/debug/flang_cli",
   запись «Цель» с «имя» равным "java" и «куда» равным "." и «сборка» равным "make build" и «запуск» равным "java -cp . FlangCli SvyazUzlov",
   запись «Цель» с «имя» равным "csharp" и «куда» равным "." и «сборка» равным "dotnet build -v quiet --nologo" и «запуск» равным "dotnet $(find bin -name flang.dll | head -1) SvyazUzlov",
   запись «Цель» с «имя» равным "elixir" и «куда» равным "." и «сборка» равным "elixirc --warnings-as-errors -o _build flang_runtime.ex svyaz_uzlov.ex flang_cli.ex" и «запуск» равным "elixir -pa _build -e 'Flang.Cli.main([\"SvyazUzlov\"])'"]

тотальная функция «Корень работы»
  возвращает строка
  "../../tmp/svyaz-na-celyah"

тотальная функция «Корень от дерева»
  возвращает строка
  "tmp/svyaz-na-celyah"

тотальная функция «Файл вопросов»
  возвращает строка
  соединить [(«Корень работы»), "/voprosy.jsonl"] по ""

тотальная функция «Мой хэш»
  возвращает строка
  "0123456789abcdef0123456789abcdef"

тотальная функция «События»
  возвращает список строки
  обеспечивает «семнадцать событий» (длина результат) равен 17
  ["{\"v\":\"Сокет завёлся\",\"f\":[[\"сейчас\",{\"n\":\"1500\"}]]}",
   "{\"v\":\"Пришёл привет\",\"f\":[[\"узел\",{\"s\":\"склад\"}],[\"хэш\",{\"s\":\"0123456789abcdef0123456789abcdef\"}]]}",
   "{\"v\":\"Пришёл привет\",\"f\":[[\"узел\",{\"s\":\"склад\"}],[\"хэш\",{\"s\":\"ffffffffffffffffffffffffffffffff\"}]]}",
   "{\"v\":\"Пришёл привет\",\"f\":[[\"узел\",{\"s\":\"\"}],[\"хэш\",{\"s\":\"ff\"}]]}",
   "{\"v\":\"Пришёл пульс\",\"f\":[]}",
   "{\"v\":\"Пришло письмо\",\"f\":[[\"кому\",{\"s\":\"Учётчик\"}]]}",
   "{\"v\":\"Пришёл отбой\",\"f\":[[\"почему\",{\"s\":\"остановлен\"}]]}",
   "{\"v\":\"Пришёл отбой\",\"f\":[[\"почему\",{\"s\":\"без причины\"}]]}",
   "{\"v\":\"Пришёл чужой кадр\",\"f\":[[\"вид\",{\"s\":\"запрос\"}]]}",
   "{\"v\":\"Байты пришли\",\"f\":[[\"сейчас\",{\"n\":\"1700\"}]]}",
   "{\"v\":\"Сокет отказал\",\"f\":[[\"почему\",{\"s\":\"сокет закрыт\"}]]}",
   "{\"v\":\"Сокет отказал\",\"f\":[[\"почему\",{\"s\":\"сокет отказал\"}]]}",
   "{\"v\":\"Звонок не удался\",\"f\":[]}",
   "{\"v\":\"Сторож проснулся\",\"f\":[[\"сейчас\",{\"n\":\"1500\"}]]}",
   "{\"v\":\"Сторож проснулся\",\"f\":[[\"сейчас\",{\"n\":\"2000\"}]]}",
   "{\"v\":\"Сторож проснулся\",\"f\":[[\"сейчас\",{\"n\":\"2001\"}]]}",
   "{\"v\":\"Срок знакомства вышел\",\"f\":[[\"срок\",{\"n\":\"30000\"}]]}"]

тотальная функция «Состояния»
  возвращает список строки
  обеспечивает «шесть состояний» (длина результат) равен 6
  ["{\"r\":[[\"кто\",{\"s\":\"учёт\"}],[\"готова\",false],[\"звоним\",false],[\"виделись\",false],[\"ждём решения\",false],[\"срок вышел\",false],[\"последний байт\",{\"n\":\"0\"}]]}",
   "{\"r\":[[\"кто\",{\"s\":\"учёт\"}],[\"готова\",true],[\"звоним\",true],[\"виделись\",true],[\"ждём решения\",true],[\"срок вышел\",true],[\"последний байт\",{\"n\":\"1000\"}]]}",
   "{\"r\":[[\"кто\",{\"s\":\"учёт\"}],[\"готова\",true],[\"звоним\",false],[\"виделись\",false],[\"ждём решения\",false],[\"срок вышел\",false],[\"последний байт\",{\"n\":\"0\"}]]}",
   "{\"r\":[[\"кто\",{\"s\":\"учёт\"}],[\"готова\",false],[\"звоним\",true],[\"виделись\",false],[\"ждём решения\",false],[\"срок вышел\",false],[\"последний байт\",{\"n\":\"0\"}]]}",
   "{\"r\":[[\"кто\",{\"s\":\"учёт\"}],[\"готова\",false],[\"звоним\",false],[\"виделись\",true],[\"ждём решения\",true],[\"срок вышел\",false],[\"последний байт\",{\"n\":\"100\"}]]}",
   "{\"r\":[[\"кто\",{\"s\":\"учёт\"}],[\"готова\",false],[\"звоним\",false],[\"виделись\",false],[\"ждём решения\",true],[\"срок вышел\",true],[\"последний байт\",{\"n\":\"0\"}]]}"]

тотальная функция «Слить»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Порядок сохраняется»
    дано первые равно ["раз"]
    дано вторые равно ["два"]
    ожидается ["раз", "два"]
  свёртка вторые начиная с первые как акк и строчка
    добавить строчка к акк

тотальная функция «Слить списки»
  принимает списки: список (список строки)
  возвращает список строки
  свёртка списки начиная с пустой список как акк и один
    «Слить» от акк и один

тотальная функция «Запрос шаг связи»
  принимает связь: строка, событие: строка, работает: строка
  возвращает строка
  соединить ["{\"fn\":\"Шаг связи\",\"args\":[", связь, ",", событие, ",{\"s\":\"", («Мой хэш»), "\"},{\"n\":\"1000\"},{\"n\":\"250\"},", работает, "]}"] по ""

тотальная функция «Вопросы для состояния»
  принимает связь: строка
  возвращает список строки
  пусть работая равно (отобразить («События») как событие → («Запрос шаг связи» от связь и событие и "true"))
  пусть стоя равно (отобразить («События») как событие → («Запрос шаг связи» от связь и событие и "false"))
  «Слить» от работая и стоя

тотальная функция «Связь для часов»
  возвращает строка
  "{\"r\":[[\"кто\",{\"s\":\"учёт\"}],[\"готова\",true],[\"звоним\",false],[\"виделись\",true],[\"ждём решения\",false],[\"срок вышел\",false],[\"последний байт\",{\"n\":\"1000\"}]]}"

тотальная функция «Запрос про часы»
  принимает имя_функции: строка, сейчас: строка, срок: строка
  возвращает строка
  соединить ["{\"fn\":\"", имя_функции, "\",\"args\":[", («Связь для часов»), ",{\"n\":\"", сейчас, "\"},{\"n\":\"", срок, "\"}]}"] по ""

тотальная функция «Вопросы про часы»
  возвращает список строки
  обеспечивает «восемь вопросов про часы» (длина результат) равен 8
  [(«Запрос про часы» от "Связь замолчала" и "1900" и "1000"), («Запрос про часы» от "Почему замолчала" и "1900" и "1000"),
   («Запрос про часы» от "Связь замолчала" и "2000" и "1000"), («Запрос про часы» от "Почему замолчала" и "2000" и "1000"),
   («Запрос про часы» от "Связь замолчала" и "2001" и "1000"), («Запрос про часы» от "Почему замолчала" и "2001" и "1000"),
   («Запрос про часы» от "Связь замолчала" и "1070" и "50"), («Запрос про часы» от "Почему замолчала" и "1070" и "50")]

тотальная функция «Все вопросы»
  возвращает список строки
  «Слить» от («Слить списки» от (отобразить («Состояния») как связь → («Вопросы для состояния» от связь))) и («Вопросы про часы»)

тотальная функция «Текст вопросов»
  возвращает строка
  соединить [(соединить («Все вопросы») по "\n"), "\n"] по ""

тотальная функция «Команда цели»
  принимает цель: «Цель»
  возвращает строка
  соединить [
    "cd ../.. && q=\"$PWD/", («Корень от дерева»), "/voprosy.jsonl\"",
    " && d=", («Корень от дерева»), "/cel-", (цель.«имя»),
    " && rm -rf \"$d\" && mkdir -p \"$d\"",
    " && bootstrap/flang emit flang/conc/link.flang --target ", (цель.«имя»), " --out \"$d\" >&2",
    "; (cd \"$d/", (цель.«куда»), "\" && ", (цель.«сборка»), ") >&2",
    "; (cd \"$d/", (цель.«куда»), "\" && LC_ALL=C.UTF-8 ", (цель.«запуск»), " < \"$q\")"
  ] по ""

тотальная функция «Поручение заведения корня»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (соединить ["mkdir -p ", («Корень работы»)] по "")]

тотальная функция «Поручение записи вопросов»
  возвращает «Поручение»
  вариант «Записать файл» с путь равным («Файл вопросов») и содержимое равным («Текст вопросов»)

тотальная функция «Поручение цели»
  принимает цель: «Цель»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда цели» от цель)]

тотальная функция «Вывод процесса»
  принимает отклик: «Отклик»
  возвращает строка
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то вывод
    случай любое
      то ""

объект «Исход»
  «имя»: строка
  «сошлась»: признак
  «почему»: строка

тотальная функция «Число строк»
  принимает текст: строка
  возвращает число
  длина (разделить текст по "\n")

тотальная функция «Судить»
  принимает имя: строка, вывод: строка, эталон: строка
  возвращает «Исход»
  пример «Тексты совпали — сошлась»
    дано имя равно "проба"
    дано вывод равно "одно и то же\n"
    дано эталон равно "одно и то же\n"
    ожидается запись «Исход» с «имя» равным "проба" и «сошлась» равным да и «почему» равным ""
  если вывод равен эталон
    то запись «Исход» с «имя» равным имя и «сошлась» равным да и «почему» равным ""
    иначе запись «Исход» с «имя» равным имя и «сошлась» равным нет и «почему» равным (соединить ["текст разошёлся с эталоном js: у цели ", (к строке («Число строк» от вывод)), " строк, у эталона ", (к строке («Число строк» от эталон)), " строк"] по "")

тотальная функция «Сошедшиеся»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → (исход.«сошлась»)) как исход → (исход.«имя»)

тотальная функция «Беды»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → не (исход.«сошлась»)) как исход → (соединить [(исход.«имя»), ": ", (исход.«почему»)] по "")

тотальная функция «Мера»
  принимает исходы: список «Исход»
  возвращает строка
  разбор («Сошедшиеся» от исходы)
    случай пусто
      то "СВЯЗЬ: НЕ ИЗМЕРЕНО — эталон js не дошёл до суда"
    случай голова и хвост
      то соединить ["СВЯЗЬ РАБОТАЕТ ОДИНАКОВО НА ", (к строке (длина («Сошедшиеся» от исходы))), " ЦЕЛЯХ ИЗ ", (к строке (длина («Цели»))), ": ", (соединить («Сошедшиеся» от исходы) по ", "), "; вопросов сверено ", (к строке (длина («Все вопросы»))), " на цель"] по ""

тотальная функция «Итог»
  принимает исходы: список «Исход»
  возвращает «Продолжение»
  разбор («Беды» от исходы)
    случай пусто
      то вариант «Конец работы» с значение равным («Мера» от исходы)
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_SVYAZ_CELI_NE_SOSHLIS" и сообщение равным (соединить (приписать («Мера» от исходы) к (приписать (соединить ["не сошлось ", (к строке (длина («Беды» от исходы))), " из 7:"] по "") к («Беды» от исходы))) по "\n  • ")

тип «Ход»
  вариант «Заводим корень»
  вариант «Пишем вопросы»
  вариант «Ждём запись»
  вариант «Ждём цель» содержит осталось: список «Цель», эталон: строка, исходы: список «Исход»

тотальная функция «Начать»
  возвращает «Ход»
  вариант «Заводим корень»

тотальная функция «Судить или взять эталоном»
  принимает имя: строка, вывод: строка, эталон: строка
  возвращает «Исход»
  пример «Пустой эталон — эта цель И ЕСТЬ эталон, засчитана без сравнения»
    дано имя равно "js"
    дано вывод равно "что угодно\n"
    дано эталон равно ""
    ожидается запись «Исход» с «имя» равным "js" и «сошлась» равным да и «почему» равным "(эталон)"
  пример «Цель промолчала — не сошлась, даже когда эталона ещё нет»
    дано имя равно "js"
    дано вывод равно ""
    дано эталон равно ""
    ожидается запись «Исход» с «имя» равным "js" и «сошлась» равным нет и «почему» равным "цель не ответила ничего: не собралась, не запустилась или не получила вопросника"
  если вывод равен ""
    то запись «Исход» с «имя» равным имя и «сошлась» равным нет и «почему» равным "цель не ответила ничего: не собралась, не запустилась или не получила вопросника"
    иначе если эталон равен ""
      то запись «Исход» с «имя» равным имя и «сошлась» равным да и «почему» равным "(эталон)"
      иначе «Судить» от имя и вывод и эталон

тотальная функция «Следующая»
  принимает осталось: список «Цель», эталон: строка, исходы: список «Исход»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то «Итог» от исходы
    случай голова и хвост
      то вариант «Сделать» с поручение равным («Поручение цели» от голова) и потом равным (вариант «Ждём цель» с осталось равным осталось и эталон равным эталон и исходы равным исходы)

тотальная функция «Новый эталон»
  принимает эталон: строка, вывод: строка
  возвращает строка
  если эталон равен ""
    то вывод
    иначе эталон

тотальная функция «После цели»
  принимает осталось: список «Цель», эталон: строка, исходы: список «Исход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали отклик цели, а список целей уже пуст"
    случай голова и хвост
      то пусть вывод равно («Вывод процесса» от отклик)
      пусть исход равно («Судить или взять эталоном» от (голова.«имя») и вывод и эталон)
      «Следующая» от хвост и («Новый эталон» от эталон и вывод) и (добавить исход к исходы)

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Заводим корень»
      то вариант «Сделать» с поручение равным («Поручение заведения корня») и потом равным (вариант «Пишем вопросы»)
    случай вариант «Пишем вопросы»
      то вариант «Сделать» с поручение равным («Поручение записи вопросов») и потом равным (вариант «Ждём запись»)
    случай вариант «Ждём запись»
      то «Следующая» от («Цели») и "" и []
    случай вариант «Ждём цель» с осталось как осталось и эталон как эталон и исходы как исходы
      то «После цели» от осталось и эталон и исходы и отклик

план «Связь работает одинаково на целях печати»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
