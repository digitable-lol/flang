модуль «Связь на целях»

объект «Цель»
  «имя»: строка
  «куда»: строка
  «сборка»: строка
  «запуск»: строка

тотальная функция «Цели»
  возвращает список «Цель»
  обеспечивает «девять целей» (длина результат) равен 9
  [запись «Цель» с «имя» равным "js" и «куда» равным "." и «сборка» равным "true" и «запуск» равным "node flang_cli.js svyaz_uzlov.js",
   запись «Цель» с «имя» равным "python" и «куда» равным "." и «сборка» равным "make check" и «запуск» равным "python3 -B flang_cli.py svyaz_uzlov",
   запись «Цель» с «имя» равным "go" и «куда» равным "." и «сборка» равным "make" и «запуск» равным "./flang_cli",
   запись «Цель» с «имя» равным "c" и «куда» равным "." и «сборка» равным "make" и «запуск» равным "./flang_cli",
   запись «Цель» с «имя» равным "cpp" и «куда» равным "." и «сборка» равным "make" и «запуск» равным "./flang_cli",
   запись «Цель» с «имя» равным "rust" и «куда» равным "." и «сборка» равным "RUSTFLAGS='-D warnings' cargo build --offline" и «запуск» равным "./target/debug/flang_cli",
   запись «Цель» с «имя» равным "java" и «куда» равным "." и «сборка» равным "make build" и «запуск» равным "java -cp . FlangCli SvyazUzlov",
   запись «Цель» с «имя» равным "csharp" и «куда» равным "." и «сборка» равным "dotnet build -v quiet --nologo" и «запуск» равным "dotnet $(find bin -name flang.dll | head -1) SvyazUzlov",
   запись «Цель» с «имя» равным "elixir" и «куда» равным "." и «сборка» равным "elixirc --warnings-as-errors -o _build flang_runtime.ex svyaz_uzlov.ex flang_cli.ex" и «запуск» равным "elixir -pa _build -e 'Flang.Cli.main([\"SvyazUzlov\"])'"]

тотальная функция «Корень работы»
  возвращает строка
  "../../tmp/svyaz-na-celyah"

тотальная функция «Корень от дерева»
  возвращает строка
  "tmp/svyaz-na-celyah"

тотальная функция «Файл вопросов»
  возвращает строка
  соединить [(«Корень работы»), "/voprosy.jsonl"] по ""

тотальная функция «Мой хэш»
  возвращает строка
  "0123456789abcdef0123456789abcdef"

тотальная функция «События»
  возвращает список строки
  обеспечивает «семнадцать событий» (длина результат) равен 17
  ["{\"v\":\"Сокет завёлся\",\"f\":[[\"сейчас\",{\"n\":\"1500\"}]]}",
   "{\"v\":\"Пришёл привет\",\"f\":[[\"узел\",{\"s\":\"склад\"}],[\"хэш\",{\"s\":\"0123456789abcdef0123456789abcdef\"}]]}",
   "{\"v\":\"Пришёл привет\",\"f\":[[\"узел\",{\"s\":\"склад\"}],[\"хэш\",{\"s\":\"ffffffffffffffffffffffffffffffff\"}]]}",
   "{\"v\":\"Пришёл привет\",\"f\":[[\"узел\",{\"s\":\"\"}],[\"хэш\",{\"s\":\"ff\"}]]}",
   "{\"v\":\"Пришёл пульс\",\"f\":[]}",
   "{\"v\":\"Пришло письмо\",\"f\":[[\"кому\",{\"s\":\"Учётчик\"}]]}",
   "{\"v\":\"Пришёл отбой\",\"f\":[[\"почему\",{\"s\":\"остановлен\"}]]}",
   "{\"v\":\"Пришёл отбой\",\"f\":[[\"почему\",{\"s\":\"без причины\"}]]}",
   "{\"v\":\"Пришёл чужой кадр\",\"f\":[[\"вид\",{\"s\":\"запрос\"}]]}",
   "{\"v\":\"Байты пришли\",\"f\":[[\"сейчас\",{\"n\":\"1700\"}]]}",
   "{\"v\":\"Сокет отказал\",\"f\":[[\"почему\",{\"s\":\"сокет закрыт\"}]]}",
   "{\"v\":\"Сокет отказал\",\"f\":[[\"почему\",{\"s\":\"сокет отказал\"}]]}",
   "{\"v\":\"Звонок не удался\",\"f\":[]}",
   "{\"v\":\"Сторож проснулся\",\"f\":[[\"сейчас\",{\"n\":\"1500\"}]]}",
   "{\"v\":\"Сторож проснулся\",\"f\":[[\"сейчас\",{\"n\":\"2000\"}]]}",
   "{\"v\":\"Сторож проснулся\",\"f\":[[\"сейчас\",{\"n\":\"2001\"}]]}",
   "{\"v\":\"Срок знакомства вышел\",\"f\":[[\"срок\",{\"n\":\"30000\"}]]}"]

тотальная функция «Слить наборы»
  принимает первые: список (список строки), вторые: список (список строки)
  возвращает список (список строки)
  пример «Порядок наборов сохраняется»
    дано первые равно [["раз"]]
    дано вторые равно [["два"]]
    ожидается [["раз"], ["два"]]
  свёртка вторые начиная с первые как итог и набор
    добавить набор к итог

тотальная функция «Каждый с каждым»
  принимает наборы: список (список строки), значения: список строки
  возвращает список (список строки)
  пример «Прежние измерения меняются медленнее нового»
    дано наборы равно [["а"], ["б"]]
    дано значения равно ["1", "2"]
    ожидается [["а", "1"], ["а", "2"], ["б", "1"], ["б", "2"]]
  свёртка наборы начиная с пустой список как итог и набор
    «Слить наборы» от итог и (отобразить значения как значение → (добавить значение к набор))

тотальная функция «Один пустой набор»
  возвращает список (список строки)
  [пустой список]

тотальная функция «Произведение»
  принимает измерения: список (список строки)
  возвращает список (список строки)
  пример «Первое измерение меняется медленнее всех, как внешний цикл»
    дано измерения равно [["false", "true"], ["0", "1000"]]
    ожидается [["false", "0"], ["false", "1000"], ["true", "0"], ["true", "1000"]]
  свёртка измерения начиная с («Один пустой набор») как наборы и измерение
    «Каждый с каждым» от наборы и измерение

тотальная функция «Признаки»
  возвращает список строки
  ["false", "true"]

тотальная функция «Связь текстом»
  принимает готова: строка, звоним: строка, виделись: строка, ждём: строка, срок_вышел: строка, последний_байт: строка
  возвращает строка
  соединить ["{\"r\":[[\"кто\",{\"s\":\"учёт\"}],[\"готова\",", готова, "],[\"звоним\",", звоним, "],[\"виделись\",", виделись, "],[\"ждём решения\",", ждём, "],[\"срок вышел\",", срок_вышел, "],[\"последний байт\",{\"n\":\"", последний_байт, "\"}]]}"] по ""

тотальная функция «Связь из набора»
  принимает набор: список строки
  возвращает строка
  «Связь текстом» от (элемент 1 в набор) и (элемент 2 в набор) и (элемент 3 в набор) и (элемент 4 в набор) и (элемент 5 в набор) и (элемент 6 в набор)

тотальная функция «Состояния»
  возвращает список строки
  обеспечивает «пять признаков и два байта — шестьдесят четыре состояния» (длина результат) равен 64
  отобразить («Произведение» от [(«Признаки»), («Признаки»), («Признаки»), («Признаки»), («Признаки»), ["0", "1000"]]) как набор → («Связь из набора» от набор)

тотальная функция «Состояния сверх перебора»
  возвращает список строки
  обеспечивает «одно состояние с байтом 100» (длина результат) равен 1
  [(«Связь текстом» от "false" и "false" и "true" и "true" и "false" и "100")]

тотальная функция «Слить»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Порядок сохраняется»
    дано первые равно ["раз"]
    дано вторые равно ["два"]
    ожидается ["раз", "два"]
  свёртка вторые начиная с первые как итог и строчка
    добавить строчка к итог

тотальная функция «Слить списки»
  принимает списки: список (список строки)
  возвращает список строки
  свёртка списки начиная с пустой список как итог и один
    «Слить» от итог и один

тотальная функция «Запрос шаг связи»
  принимает связь: строка, событие: строка, работает: строка
  возвращает строка
  соединить ["{\"fn\":\"Шаг связи\",\"args\":[", связь, ",", событие, ",{\"s\":\"", («Мой хэш»), "\"},{\"n\":\"1000\"},{\"n\":\"250\"},", работает, "]}"] по ""

тотальная функция «Вопросы для состояния»
  принимает связь: строка
  возвращает список строки
  «Слить списки» от (отобразить («События») как событие → [(«Запрос шаг связи» от связь и событие и "true"), («Запрос шаг связи» от связь и событие и "false")])

тотальная функция «Связь для часов»
  возвращает строка
  «Связь текстом» от "true" и "false" и "true" и "false" и "false" и "1000"

тотальная функция «Запрос про часы»
  принимает имя_функции: строка, сейчас: строка, срок: строка
  возвращает строка
  соединить ["{\"fn\":\"", имя_функции, "\",\"args\":[", («Связь для часов»), ",{\"n\":\"", сейчас, "\"},{\"n\":\"", срок, "\"}]}"] по ""

тотальная функция «Вопросы про часы»
  возвращает список строки
  обеспечивает «восемь вопросов про часы» (длина результат) равен 8
  [(«Запрос про часы» от "Связь замолчала" и "1900" и "1000"), («Запрос про часы» от "Почему замолчала" и "1900" и "1000"),
   («Запрос про часы» от "Связь замолчала" и "2000" и "1000"), («Запрос про часы» от "Почему замолчала" и "2000" и "1000"),
   («Запрос про часы» от "Связь замолчала" и "2001" и "1000"), («Запрос про часы» от "Почему замолчала" и "2001" и "1000"),
   («Запрос про часы» от "Связь замолчала" и "1070" и "50"), («Запрос про часы» от "Почему замолчала" и "1070" и "50")]

тотальная функция «Вопросы перебора»
  возвращает список строки
  обеспечивает «две тысячи сто восемьдесят четыре вопроса, как у проверки на Node» (длина результат) равен 2184
  «Слить» от («Слить списки» от (отобразить («Состояния») как связь → («Вопросы для состояния» от связь))) и («Вопросы про часы»)

тотальная функция «Все вопросы»
  возвращает список строки
  «Слить» от («Вопросы перебора») и («Слить списки» от (отобразить («Состояния сверх перебора») как связь → («Вопросы для состояния» от связь)))

тотальная функция «Текст вопросов»
  возвращает строка
  соединить [(соединить («Все вопросы») по "\n"), "\n"] по ""

тотальная функция «Команда свидетеля»
  возвращает строка
  соединить [
    "cd ../.. && q=\"$PWD/", («Корень от дерева»), "/voprosy.jsonl\"",
    " && d=", («Корень от дерева»), "/witness",
    " && rm -rf \"$d\" && mkdir -p \"$d\"",
    " && bootstrap/flang emit flang/conc/link.flang --target js --out \"$d\" >&2",
    " && cp flang/conc/link.js \"$d/witness.js\"",
    " && { grep -q '^export const \\$PROGRAM' \"$d/witness.js\" || sed -n '/^export const \\$PROGRAM = {/,$p' \"$d/svyaz_uzlov.js\" >> \"$d/witness.js\"; }",
    " && (cd \"$d\" && LC_ALL=C.UTF-8 node flang_cli.js witness.js < \"$q\")"
  ] по ""

тотальная функция «Команда цели»
  принимает цель: «Цель»
  возвращает строка
  соединить [
    "cd ../.. && q=\"$PWD/", («Корень от дерева»), "/voprosy.jsonl\"",
    " && d=", («Корень от дерева»), "/cel-", (цель.«имя»),
    " && rm -rf \"$d\" && mkdir -p \"$d\"",
    " && bootstrap/flang emit flang/conc/link.flang --target ", (цель.«имя»), " --out \"$d\" >&2",
    "; (cd \"$d/", (цель.«куда»), "\" && ", (цель.«сборка»), ") >&2",
    "; (cd \"$d/", (цель.«куда»), "\" && LC_ALL=C.UTF-8 ", (цель.«запуск»), " < \"$q\")"
  ] по ""

тотальная функция «Поручение заведения корня»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (соединить ["mkdir -p ", («Корень работы»)] по "")]

тотальная функция «Поручение записи вопросов»
  возвращает «Поручение»
  вариант «Записать файл» с путь равным («Файл вопросов») и содержимое равным («Текст вопросов»)

тотальная функция «Поручение свидетеля»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда свидетеля»)]

тотальная функция «Поручение цели»
  принимает цель: «Цель»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда цели» от цель)]

тотальная функция «Вывод процесса»
  принимает отклик: «Отклик»
  возвращает строка
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то вывод
    случай любое
      то ""

тотальная функция «Непустые строки»
  принимает текст: строка
  возвращает список строки
  пример «Пустой хвост после последнего перевода строки не считается»
    дано текст равно "раз\nдва\n"
    ожидается ["раз", "два"]
  отфильтровать (разделить текст по "\n") где строчка → не (строчка равна "")

тотальная функция «Ответов ok»
  принимает текст: строка
  возвращает число
  пример «Отказ ответом ok не считается»
    дано текст равно "{\"ok\":true,\"value\":1}\n{\"ok\":false,\"code\":\"X\"}\n"
    ожидается 1
  длина (отфильтровать («Непустые строки» от текст) где строчка → (строчка начинается с "{\"ok\":true,"))

тотальная функция «Беда свидетеля»
  принимает вывод: строка, вопросов: число
  возвращает строка
  пример «Ответил на всё и всё ok — беды нет»
    дано вывод равно "{\"ok\":true,\"value\":1}\n{\"ok\":true,\"value\":2}\n"
    дано вопросов равно 2
    ожидается ""
  пример «Один отказ — беда, как у проверки на Node»
    дано вывод равно "{\"ok\":true,\"value\":1}\n{\"ok\":false,\"code\":\"X\"}\n"
    дано вопросов равно 2
    ожидается "свидетель flang/conc/link.js: строк 2, ответов ok 1, вопросов 2"
  пример «Промолчал — беда»
    дано вывод равно ""
    дано вопросов равно 2
    ожидается "свидетель flang/conc/link.js: строк 0, ответов ok 0, вопросов 2"
  если ((длина («Непустые строки» от вывод)) равен вопросов) и притом ((«Ответов ok» от вывод) равен вопросов)
    то ""
    иначе соединить ["свидетель flang/conc/link.js: строк ", (к строке (длина («Непустые строки» от вывод))), ", ответов ok ", (к строке («Ответов ok» от вывод)), ", вопросов ", (к строке вопросов)] по ""

объект «Поиск расхождения»
  «номер»: число
  «первое»: число
  «остаток»: список строки

тотальная функция «Шаг поиска»
  принимает поиск: «Поиск расхождения», строчка: строка
  возвращает «Поиск расхождения»
  пусть номер равно ((поиск.«номер») плюс 1)
  разбор (поиск.«остаток»)
    случай пусто
      то запись «Поиск расхождения» с «номер» равным номер и «первое» равным (если (поиск.«первое») равен 0 то номер иначе (поиск.«первое»)) и «остаток» равным пустой список
    случай голова и хвост
      то запись «Поиск расхождения» с «номер» равным номер и «первое» равным (если ((поиск.«первое») равен 0) и притом (не (строчка равна голова)) то номер иначе (поиск.«первое»)) и «остаток» равным хвост

тотальная функция «Первое расхождение»
  принимает вывод: строка, эталон: строка
  возвращает число
  пример «Совпали — ноль»
    дано вывод равно "а\nб\n"
    дано эталон равно "а\nб\n"
    ожидается 0
  пример «Вторая строка разошлась»
    дано вывод равно "а\nв\n"
    дано эталон равно "а\nб\n"
    ожидается 2
  пример «Цель ответила короче — расхождение на первой недостающей строке»
    дано вывод равно "а\n"
    дано эталон равно "а\nб\n"
    ожидается 2
  пусть строки_эталона равно («Непустые строки» от эталон)
  пусть строки_вывода равно («Непустые строки» от вывод)
  пусть итог равно (свёртка строки_вывода начиная с (запись «Поиск расхождения» с «номер» равным 0 и «первое» равным 0 и «остаток» равным строки_эталона) как поиск и строчка → («Шаг поиска» от поиск и строчка))
  если (итог.«первое») больше 0
    то итог.«первое»
    иначе если (длина строки_вывода) равен (длина строки_эталона)
      то 0
      иначе (длина строки_вывода) плюс 1

объект «Исход»
  «имя»: строка
  «сошлась»: признак
  «почему»: строка

тотальная функция «Судить»
  принимает имя: строка, вывод: строка, эталон: строка
  возвращает «Исход»
  пример «Тексты совпали — сошлась»
    дано имя равно "проба"
    дано вывод равно "одно и то же\n"
    дано эталон равно "одно и то же\n"
    ожидается запись «Исход» с «имя» равным "проба" и «сошлась» равным да и «почему» равным ""
  пример «Цель промолчала — не сошлась»
    дано имя равно "проба"
    дано вывод равно ""
    дано эталон равно "одно\n"
    ожидается запись «Исход» с «имя» равным "проба" и «сошлась» равным нет и «почему» равным "цель не ответила ничего: не собралась, не запустилась или не получила вопросника"
  пример «Разошлась — названа строка, она же номер вопроса»
    дано имя равно "проба"
    дано вывод равно "а\nв\n"
    дано эталон равно "а\nб\n"
    ожидается запись «Исход» с «имя» равным "проба" и «сошлась» равным нет и «почему» равным "ответ разошёлся со свидетелем flang/conc/link.js: у цели 2 строк, у свидетеля 2, первое расхождение на вопросе 2"
  если вывод равен эталон
    то запись «Исход» с «имя» равным имя и «сошлась» равным да и «почему» равным ""
    иначе если вывод равен ""
      то запись «Исход» с «имя» равным имя и «сошлась» равным нет и «почему» равным "цель не ответила ничего: не собралась, не запустилась или не получила вопросника"
      иначе запись «Исход» с «имя» равным имя и «сошлась» равным нет и «почему» равным (соединить ["ответ разошёлся со свидетелем flang/conc/link.js: у цели ", (к строке (длина («Непустые строки» от вывод))), " строк, у свидетеля ", (к строке (длина («Непустые строки» от эталон))), ", первое расхождение на вопросе ", (к строке («Первое расхождение» от вывод и эталон))] по "")

тотальная функция «Сошедшиеся»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → (исход.«сошлась»)) как исход → (исход.«имя»)

тотальная функция «Беды»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → не (исход.«сошлась»)) как исход → (соединить [(исход.«имя»), ": ", (исход.«почему»)] по "")

тотальная функция «Мера»
  принимает исходы: список «Исход»
  возвращает строка
  разбор («Сошедшиеся» от исходы)
    случай пусто
      то "СВЯЗЬ: НЕ ИЗМЕРЕНО — ни одна цель не сошлась со свидетелем"
    случай голова и хвост
      то соединить ["СВЯЗЬ РЕШАЕТ КАК СВИДЕТЕЛЬ flang/conc/link.js НА ", (к строке (длина («Сошедшиеся» от исходы))), " ЦЕЛЯХ ИЗ ", (к строке (длина («Цели»))), ": ", (соединить («Сошедшиеся» от исходы) по ", "), "; вопросов на цель ", (к строке (длина («Все вопросы»))), " (перебор проверки на Node ", (к строке (длина («Вопросы перебора»))), " и сверх него ", (к строке ((длина («Все вопросы»)) минус (длина («Вопросы перебора»)))), "); сверок всего ", (к строке ((длина («Все вопросы»)) умножить на (длина («Сошедшиеся» от исходы)))), ", расхождений 0"] по ""

тотальная функция «Итог»
  принимает исходы: список «Исход»
  возвращает «Продолжение»
  разбор («Беды» от исходы)
    случай пусто
      то вариант «Конец работы» с значение равным («Мера» от исходы)
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_SVYAZ_CELI_NE_SOSHLIS" и сообщение равным (соединить (приписать («Мера» от исходы) к (приписать (соединить ["не сошлось ", (к строке (длина («Беды» от исходы))), " из ", (к строке (длина («Цели»))), ":"] по "") к («Беды» от исходы))) по "\n  • ")

тип «Ход»
  вариант «Заводим корень»
  вариант «Пишем вопросы»
  вариант «Ждём запись»
  вариант «Ждём свидетеля»
  вариант «Ждём цель» содержит осталось: список «Цель», эталон: строка, исходы: список «Исход»

тотальная функция «Начать»
  возвращает «Ход»
  вариант «Заводим корень»

тотальная функция «Следующая»
  принимает осталось: список «Цель», эталон: строка, исходы: список «Исход»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то «Итог» от исходы
    случай голова и хвост
      то вариант «Сделать» с поручение равным («Поручение цели» от голова) и потом равным (вариант «Ждём цель» с осталось равным осталось и эталон равным эталон и исходы равным исходы)

тотальная функция «После свидетеля»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пусть вывод равно («Вывод процесса» от отклик)
  пусть беда равно («Беда свидетеля» от вывод и (длина («Все вопросы»)))
  если беда равна ""
    то «Следующая» от («Цели») и вывод и []
    иначе вариант «Провал» с код равным "FLANG_LINK_WITNESS_FAILED" и сообщение равным беда

тотальная функция «После цели»
  принимает осталось: список «Цель», эталон: строка, исходы: список «Исход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали отклик цели, а список целей уже пуст"
    случай голова и хвост
      то пусть исход равно («Судить» от (голова.«имя») и («Вывод процесса» от отклик) и эталон)
      «Следующая» от хвост и эталон и (добавить исход к исходы)

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Заводим корень»
      то вариант «Сделать» с поручение равным («Поручение заведения корня») и потом равным (вариант «Пишем вопросы»)
    случай вариант «Пишем вопросы»
      то вариант «Сделать» с поручение равным («Поручение записи вопросов») и потом равным (вариант «Ждём запись»)
    случай вариант «Ждём запись»
      то вариант «Сделать» с поручение равным («Поручение свидетеля») и потом равным (вариант «Ждём свидетеля»)
    случай вариант «Ждём свидетеля»
      то «После свидетеля» от отклик
    случай вариант «Ждём цель» с осталось как осталось и эталон как эталон и исходы как исходы
      то «После цели» от осталось и эталон и исходы и отклик

план «Связь решает как свидетель на целях печати»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
