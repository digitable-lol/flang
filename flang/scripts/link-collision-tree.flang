  «Слить строки» от («Слить строки» от [(соединить [отступ, («Сообщение» от столкновение)] по ""), (соединить [отступ, "  ", (столкновение.«первый файл»), ":", (столкновение.«первая строка»)] по ""), (соединить [отступ, "  ", (столкновение.«второй файл»), ":", (столкновение.«вторая строка»)] по "")] и (если (длина программы) больше 0 то [(соединить [отступ, "  в замыкании ", (если (длина программы) равен 1 то "программы" иначе (соединить [(к строке (длина программы)), " программ"] по "")), ": ", (соединить программы по ", ")] по "")] иначе пустой список)) и [(соединить [отступ, "  цена: ", («Цена» от программы)] по "")]

