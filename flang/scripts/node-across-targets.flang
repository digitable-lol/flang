модуль «Узел на целях»

// SPDX-FileCopyrightText: 2026 Digitable (Marat Zimnurov)
// SPDX-License-Identifier: BSD-2-Clause
//
// ПОЛНЫЙ УЗЕЛ на каждой цели, у которой есть хозяин: не слой связи, а узел
// целиком.
//
//   bootstrap/flang io flang/scripts/node-across-targets.flang --timeout 1800000
//
// Раньше это был `flang/test/uzel-celi.test.mjs` (215 строк на JavaScript).
// Ушёл он целиком: проверка здесь — это прогон с кодом возврата, а не тест.
//
// ── Что здесь считается доказательством ─────────────────────────────────────
//
// Не «форма заведена» и не «ответы сошлись», а РАБОТА:
//
//   1. рукопожатие сошлось у ОБОИХ концов (у одного оно не сходится молча);
//   2. письмо, посланное процессом на узле новой цели, доехало до процесса на
//      узле ОПОРЫ и ПОМЕНЯЛО ЕГО СОСТОЯНИЕ;
//   3. ответ вернулся и поменял состояние процесса НА УЗЛЕ НОВОЙ ЦЕЛИ.
//
// Третье — то, чего у слоя связи быть не могло: чтобы ответ поменял состояние,
// принявшей стороне нужен процесс, ящик и планировщик, а не только сокет.
//
// ── Почему пара поднимается оболочкой ───────────────────────────────────────
//
// Языку недостаёт четырёх вещей, и все четыре нужны разом: фонового запуска
// процесса, чтения потока живого процесса, сигналов и заведения каталога.
// Поэтому ПОДЪЁМ пары отдан одному `sh -c` — ровно тем же приёмом, каким мерку
// памяти ставит `flang/scripts/memory-guard.flang` и каким PATH без Node
// собирает `scripts/path-without-node.flang`. Оболочка НЕ СУДИТ: она поднимает два
// узла, ждёт обоих и выкладывает их журналы одним потоком. Все до одного
// решения — здесь, тотальными функциями, и снимаются они с журналов.
//
// ── Мера ────────────────────────────────────────────────────────────────────
//
// Прогон печатает её сам: «полный узел на N целях из 9». N — число целей, у
// которых есть ХОЗЯИН и чья пара сошлась; решения печатаются во все девять и
// сверены отдельно (`scripts/conc-link-emit.flang`). Путать эти два числа
// нельзя: первое про работу, второе про переносимость.

// ── данные ──────────────────────────────────────────────────────────────────

// Цель печати вместе со всем, что нужно, чтобы поднять на ней узел. Поля —
// куски команды оболочки, и это честнее, чем прятать их в саму оболочку:
// разойдись сборка с запуском — видно здесь, в одной записи.
объект «Цель»
  «имя»: строка
  «хозяин»: строка
  «куда»: строка
  «рядом»: строка
  «сборка»: строка
  «запуск»: строка

// Итог одной пары.
объект «Исход»
  «имя»: строка
  «сошлась»: признак
  «почему»: строка

// ОПОРА — второй конец каждой пары: такой же узел, хозяин `node.py` плюс
// напечатанный `node-benchmark.flang`. Особого положения у неё нет, кроме того,
// что она стоит в паре всегда, — и потому считается работающей ровно тогда,
// когда сошлась хоть одна пара.
тотальная функция «Опора»
  возвращает строка
  обеспечивает «длина постоянной — Опора» (длина результат) равен 6
  пример «Опора — python»
    ожидается "python"
  "python"

// ДЕВЯТАЯ ЦЕЛЬ, «cpp», НЕ ПРИНОСИТ ВОСЬМОГО ХОЗЯИНА. Хозяин у неё — тот же
// `node.c`, собранный компилятором C++ (`-x c++`): имя напечатанного заголовка
// и имя цели приезжают в него ключами `-D`, а не второй копией файла. Копия
// разошлась бы с подлинником молча — тот же довод, по которому сама цель «cpp»
// не копирует рантайм цели «c», а читает его.
тотальная функция «Цели»
  возвращает список «Цель»
  [запись «Цель» с «имя» равным "go" и «хозяин» равным "node.go" и «куда» равным "node" и «рядом» равным "true" и «сборка» равным "go build -o flang_node ./node" и «запуск» равным "./flang_node",
   запись «Цель» с «имя» равным "csharp" и «хозяин» равным "node.cs" и «куда» равным "." и «рядом» равным "true" и «сборка» равным "dotnet build -v quiet --nologo -p:StartupObject=HozyainUzla" и «запуск» равным "dotnet $(ls bin/*/*/flang.dll | head -1)",
   запись «Цель» с «имя» равным "elixir" и «хозяин» равным "node.ex" и «куда» равным "." и «рядом» равным "true" и «сборка» равным "elixirc --warnings-as-errors -o _build flang_runtime.ex uzel_zamera.ex flang_cli.ex node.ex" и «запуск» равным "elixir -pa _build -e 'HozyainUzla.main(System.argv())' --",
   запись «Цель» с «имя» равным "js" и «хозяин» равным "node.js" и «куда» равным "." и «рядом» равным "printf '%s' '{\"type\":\"module\"}' > \"$d/cel/package.json\"" и «сборка» равным "true" и «запуск» равным "node node.js",
   запись «Цель» с «имя» равным "rust" и «хозяин» равным "node.rs" и «куда» равным "src/bin" и «рядом» равным "true" и «сборка» равным "RUSTFLAGS='-D warnings' cargo build --offline" и «запуск» равным "./target/debug/node",
   запись «Цель» с «имя» равным "java" и «хозяин» равным "node.java" и «куда» равным "." и «рядом» равным "true" и «сборка» равным "make build" и «запуск» равным "java -cp . HozyainUzla",
   запись «Цель» с «имя» равным "c" и «хозяин» равным "node.c" и «куда» равным "." и «рядом» равным "printf '%s' 'include Makefile\n\nflang_node: node.o $(OBJECTS)\n\t$(CC) $(CFLAGS) -o $@ node.o $(OBJECTS) $(LDLIBS)\n' > \"$d/cel/node.mk\"" и «сборка» равным "make -f node.mk flang_node" и «запуск» равным "./flang_node",
   запись «Цель» с «имя» равным "cpp" и «хозяин» равным "node.c" и «куда» равным "." и «рядом» равным "printf '%s' 'include Makefile\n\nnode.o: node.c\n\t$(CXX) $(CXXFLAGS) -x c++ -DZAGOLOVOK_MODULYA=\\\"uzel_zamera.hpp\\\" -DCEL=\\\"cpp\\\" -c -o $@ node.c\n\nflang_node: node.o $(OBJECTS)\n\t$(CXX) $(CXXFLAGS) -o $@ node.o $(OBJECTS) $(LDLIBS)\n' > \"$d/cel/node.mk\"" и «сборка» равным "make -f node.mk flang_node" и «запуск» равным "./flang_node"]

// План узла: имя процесса → начальное состояние и обработчик, оба ИМЕНАМИ.
// Именами, а не значениями, потому что вызвать функцию по имени, приехавшему
// строкой, может только хозяин.
тотальная функция «План процессов»
  возвращает строка
  обеспечивает «длина постоянной — План процессов» (длина результат) равен 198
  "{\"процессы\":[{\"имя\":\"Счётчик\",\"начальное\":\"Начальный счёт\",\"обработчик\":\"Обработчик счёта\",\"ящик\":null},{\"имя\":\"Учётчик\",\"начальное\":\"Начальные записи\",\"обработчик\":\"Обработчик учёта\",\"ящик\":null}]}"

тотальная функция «Вброс»
  возвращает строка
  обеспечивает «длина постоянной — Вброс» (длина результат) равен 63
  "[{\"кому\":\"Счётчик\",\"что\":[\"в\",\"замерить\",{\"сколько\":[\"ч\",2]}]}]"

// ── подъём пары ─────────────────────────────────────────────────────────────

// Одна строка оболочки на всю пару. Читать её надо так: сначала печать узла в
// цель и в опору и хэш программы (его обязаны предъявить друг другу оба конца,
// иначе рукопожатие не сойдётся — и это правильно), потом сборка, потом опора
// в фоне, ожидание её порта из журнала, потом узел цели, `wait` и выкладка
// обоих журналов одним потоком.
тотальная функция «Корень работы»
  возвращает строка
  "${FLANG_TMP:-/srv/tmp}/uzel-celi"

тотальная функция «Команда пары»
  принимает цель: «Цель»
  возвращает строка
  соединить [
    "cd ../.. && d=\"", («Корень работы»), "/uzel-", (цель.«имя»), "\"",
    " && rm -rf \"$d\" && mkdir -p \"$d/cel/", (цель.«куда»), "\" \"$d/opora\"",
    " && bootstrap/flang emit flang/conc/examples/distributed.flang --target js --out \"$d/prog\" >/dev/null 2>&1;",
    " h=$(cat $(ls \"$d\"/prog/*.js | grep -v flang_cli) | sha256sum | cut -c1-64);",
    " bootstrap/flang emit flang/conc/node-benchmark.flang --target ", (цель.«имя»), " --out \"$d/cel\" >&2;",
    " bootstrap/flang emit flang/conc/node-benchmark.flang --target ", («Опора»), " --out \"$d/opora\" >&2;",
    " cp flang/conc/bin/", (цель.«хозяин»), " \"$d/cel/", (цель.«куда»), "/\";",
    " cp flang/conc/bin/node.py \"$d/opora/\";",
    " ", (цель.«рядом»), ";",
    " printf '%s' '", («План процессов»), "' > \"$d/cel/plan.json\";",
    " printf '%s' '", («План процессов»), "' > \"$d/opora/plan.json\";",
    " (cd \"$d/cel\" && ", (цель.«сборка»), ") >&2;",
    " (cd \"$d/opora\" && LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8 python3 -B node.py --я учёт --слушать 127.0.0.1:0 --хэш \"$h\" --план-файл plan.json --размещение '{\"Счётчик\":\"счёт\",\"Учётчик\":\"учёт\"}' --срок 2000 --пульс 200 --жить 9 >\"$d/opora.log\" 2>>\"$d/err\") &",
    " i=0; p=\"\"; while [ $i -lt 300 ]; do p=$(sed -n 's/.*\"поднят\".*\"порт\": *\\([0-9]*\\).*/\\1/p' \"$d/opora.log\" 2>/dev/null); [ -n \"$p\" ] && break; i=$((i+1)); sleep 0.1; done;",
    " (cd \"$d/cel\" && LC_ALL=C.UTF-8 ", (цель.«запуск»), " --я счёт --слушать 127.0.0.1:0 --хэш \"$h\" --план-файл plan.json --размещение '{\"Счётчик\":\"счёт\",\"Учётчик\":\"учёт\",\"звонить\":{\"учёт\":\"127.0.0.1:'$p'\"}}' --вбросить '", («Вброс»), "' --срок 2000 --пульс 200 --жить 6 >\"$d/cel.log\" 2>>\"$d/err\");",
    " wait; cat \"$d/opora.log\" \"$d/cel.log\" 2>/dev/null; cat \"$d/err\" >&2 2>/dev/null; rm -rf \"$d\""
  ] по ""

тотальная функция «Поручение пары»
  принимает цель: «Цель»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда пары» от цель)]

// ── суд по журналам ─────────────────────────────────────────────────────────

// Журналы девяти узлов печатаются одним и тем же JSON-ом, но пробелы между
// парами у разных печатников разные: python ставит их, остальные нет. Пробел
// внутри наших ключей и значений не встречается ни разу, поэтому сверяется
// текст БЕЗ пробелов — иначе сверка ловила бы печатника, а не работу узла.
тотальная функция «Без пробелов»
  принимает текст: строка
  возвращает строка
  пример «Пробелы python убраны»
    дано текст равно "{\"в\": \"конец\", \"узел\": \"учёт\"}"
    ожидается "{\"в\":\"конец\",\"узел\":\"учёт\"}"
  пример «Там, где их не было, ничего не меняется»
    дано текст равно "{\"в\":\"конец\"}"
    ожидается "{\"в\":\"конец\"}"
  соединить (разделить текст по " ") по ""

// Порядок пар в строке журнала у девяти печатников РАЗНЫЙ: go сортирует ключи
// по алфавиту, python и js оставляют порядок записи. Поэтому строка ищется по
// набору кусков, а не по одной длинной подстроке: сверять надо сказанное, а не
// то, в каком порядке печатник его выложил.
тотальная функция «Все внутри»
  принимает строчка: строка, куски: список строки
  возвращает признак
  пример «Порядок кусков значения не имеет»
    дано строчка равно "{\"б\":2,\"а\":1}"
    дано куски равно ["\"а\":1", "\"б\":2"]
    ожидается да
  пример «Нет одного куска — нет и строки»
    дано строчка равно "{\"а\":1}"
    дано куски равно ["\"а\":1", "\"б\":2"]
    ожидается нет
  (длина (отфильтровать куски где кусок → не (строчка содержит кусок))) равен 0

тотальная функция «Есть строка со всеми»
  принимает журналы: строка, куски: список строки
  возвращает признак
  пример «Куски одной строки — да, куски разных строк — нет»
    дано журналы равно "{\"а\":1}\n{\"б\":2}"
    дано куски равно ["\"а\":1"]
    ожидается да
  пример «Разнесённые по разным строкам куски строкой не считаются»
    дано журналы равно "{\"а\":1}\n{\"б\":2}"
    дано куски равно ["\"а\":1", "\"б\":2"]
    ожидается нет
  (длина (отфильтровать (разделить журналы по "\n") где строчка → («Все внутри» от строчка и куски))) больше 0

// ПЕРВОЕ: рукопожатие сошлось у ОБОИХ. У одного конца оно не сходится молча,
// поэтому спрашиваются оба журнала, а не один.
тотальная функция «Рукопожатие у обоих»
  принимает журналы: строка, имя: строка
  возвращает признак
  пусть у_цели равно ["\"в\":\"связь\"", "\"узел\":\"счёт\"", (соединить ["\"цель\":\"", имя, "\""] по ""), "\"сосед\":\"учёт\"", "\"что\":\"заведена\""]
  пусть у_опоры равно ["\"в\":\"связь\"", "\"узел\":\"учёт\"", "\"цель\":\"python\"", "\"сосед\":\"счёт\"", "\"что\":\"заведена\""]
  («Есть строка со всеми» от журналы и у_цели) и притом («Есть строка со всеми» от журналы и у_опоры)

// ТРЕТЬЕ, и ради него всё: ОТВЕТ вернулся и поменял состояние процесса на узле
// новой цели. Состояния сверяются ЗАКОДИРОВАННЫМИ — теми же метками, какими они
// едут по проводу: подстрока «2» здесь солгала бы, а метка называет и число.
тотальная функция «Ответ поменял состояние цели»
  принимает журналы: строка, имя: строка
  возвращает признак
  «Есть строка со всеми» от журналы и ["\"в\":\"конец\"", "\"узел\":\"счёт\"", (соединить ["\"цель\":\"", имя, "\""] по ""), "\"состояния\":{\"Счётчик\":[\"з\",{\"всего\":[\"ч\",2],\"подтверждено\":[\"ч\",1]}]}"]

// ВТОРОЕ: письмо ушло с узла новой цели и поменяло состояние процесса на узле
// опоры.
тотальная функция «Письмо доехало до опоры»
  принимает журналы: строка
  возвращает признак
  «Есть строка со всеми» от журналы и ["\"в\":\"конец\"", "\"узел\":\"учёт\"", "\"цель\":\"python\"", "\"состояния\":{\"Учётчик\":[\"з\",{\"строки\":[\"л\",[[\"с\",\"2\"]]]}]}"]

тотальная функция «Судить пару»
  принимает цель: «Цель», вывод: строка, ошибки: строка
  возвращает «Исход»
  пусть журналы равно («Без пробелов» от вывод)
  пусть имя равно (цель.«имя»)
  если не («Рукопожатие у обоих» от журналы и имя)
    то запись «Исход» с «имя» равным имя и «сошлась» равным нет и «почему» равным (соединить ["рукопожатие не сошлось у обоих концов; поток ошибок пары:\n", ошибки] по "")
    иначе если не («Ответ поменял состояние цели» от журналы и имя)
      то запись «Исход» с «имя» равным имя и «сошлась» равным нет и «почему» равным (соединить ["ответ с узла опоры не поменял состояния «Счётчика»; поток ошибок пары:\n", ошибки] по "")
      иначе если не («Письмо доехало до опоры» от журналы)
        то запись «Исход» с «имя» равным имя и «сошлась» равным нет и «почему» равным (соединить ["письмо с узла на ", имя, " не доехало до процесса на опоре; поток ошибок пары:\n", ошибки] по "")
        иначе запись «Исход» с «имя» равным имя и «сошлась» равным да и «почему» равным ""

// ── начальные состояния ─────────────────────────────────────────────────────

// Функцию без аргументов позвать через ввоз нельзя, поэтому два начальных
// состояния выписаны в `node-benchmark.flang` ЗАНОВО. Два источника правды об одном
// расходятся молча — вот проверка, которая молчать не даёт. Считает их сам
// двоичный: `flang run --function` отдаёт значение JSON-ом, и сверяется его текст.
тотальная функция «Команда состояний»
  возвращает строка
  соединить [
    "cd ../..;",
    " bootstrap/flang run flang/conc/node-benchmark.flang --function 'Начальный счёт' 2>/dev/null; echo '@@';",
    " bootstrap/flang run flang/conc/examples/distributed.flang --function 'пустой счёт' 2>/dev/null; echo '@@';",
    " bootstrap/flang run flang/conc/node-benchmark.flang --function 'Начальные записи' 2>/dev/null; echo '@@';",
    " bootstrap/flang run flang/conc/examples/distributed.flang --function 'пустые записи' 2>/dev/null; echo '@@'"
  ] по ""

тотальная функция «Значения состояний»
  принимает вывод: строка
  возвращает список строки
  пример «Четыре значения, разделитель и переводы строк убраны»
    дано вывод равно "{\"а\":0}\n@@\n{\"а\":0}\n@@\n"
    ожидается ["{\"а\":0}", "{\"а\":0}"]
  отфильтровать (отобразить (разделить («Без пробелов» от вывод) по "@@") как кусок → (соединить (разделить кусок по "\n") по "")) где кусок → не (кусок равен "")

тотальная функция «Пары сошлись»
  принимает значения: список строки
  возвращает признак
  обеспечивает «Пары сошлись: первая ветвь» если (длина значения) больше 1 то результат равен (((голова значения) равен (голова (хвост значения))) и притом («Пары сошлись» от (хвост (хвост значения)))) иначе да
  убывает (длина значения)
  пример «Две сошедшиеся пары»
    дано значения равно ["а", "а", "б", "б"]
    ожидается да
  пример «Вторая пара разошлась»
    дано значения равно ["а", "а", "б", "в"]
    ожидается нет
  пример «Нечётное число значений»
    дано значения равно ["а"]
    ожидается нет
  если (длина значения) больше 1
    то ((голова значения) равен (голова (хвост значения))) и притом («Пары сошлись» от (хвост (хвост значения)))
    иначе (длина значения) равен 0

тотальная функция «Состояния сошлись»
  принимает вывод: строка
  возвращает признак
  ((длина («Значения состояний» от вывод)) равен 4) и притом («Пары сошлись» от («Значения состояний» от вывод))

// ── итог ────────────────────────────────────────────────────────────────────

тотальная функция «Сошедшиеся»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → (исход.«сошлась»)) как исход → (исход.«имя»)

тотальная функция «Беды»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → не (исход.«сошлась»)) как исход → (соединить [(исход.«имя»), ": ", (исход.«почему»)] по "")

тотальная функция «Мера»
  принимает исходы: список «Исход»
  возвращает строка
  разбор («Сошедшиеся» от исходы)
    случай пусто
      то "ПОЛНЫЙ УЗЕЛ: НЕ ИЗМЕРЕНО — ни одна пара не сошлась"
    случай голова и хвост
      то соединить ["ПОЛНЫЙ УЗЕЛ РАБОТАЕТ НА ", (к строке (длина («Сошедшиеся» от исходы) плюс 1)), " ЦЕЛЯХ ИЗ 9: ", («Опора»), ", ", (соединить («Сошедшиеся» от исходы) по ", "), "\nрешения при этом печатаются во все девять — это другое число и другой прогон"] по ""

тотальная функция «Сложить»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  обеспечивает «Сложить: первая ветвь» если (длина первые) больше 0 то результат равен (приписать (голова первые) к («Сложить» от (хвост первые) и вторые)) иначе да
  убывает (длина первые)
  пример «Два списка складываются в один»
    дано первые равно ["а"]
    дано вторые равно ["б"]
    ожидается ["а", "б"]
  если (длина первые) больше 0
    то приписать (голова первые) к («Сложить» от (хвост первые) и вторые)
    иначе вторые

тотальная функция «Слово о состояниях»
  принимает состояния: признак
  возвращает список строки
  обеспечивает «Слово о состояниях: первая ветвь» если состояния то результат равен ([]) иначе да
  если состояния
    то []
    иначе ["начальные состояния: «Начальный счёт»/«Начальные записи» узла разошлись с «пустой счёт»/«пустые записи» программы"]

тотальная функция «Итог»
  принимает исходы: список «Исход», состояния: признак
  возвращает «Продолжение»
  разбор («Сложить» от («Слово о состояниях» от состояния) и («Беды» от исходы))
    случай пусто
      то вариант «Конец работы» с значение равным (соединить [(«Мера» от исходы), "\nначальных состояний сверено 2, расхождений 0"] по "")
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_UZEL_PARA_NE_SOSHLAS" и сообщение равным (соединить (приписать («Мера» от исходы) к (приписать (соединить ["не сошлось: ", (к строке (длина («Сложить» от («Слово о состояниях» от состояния) и («Беды» от исходы))))] по "") к («Сложить» от («Слово о состояниях» от состояния) и («Беды» от исходы)))) по "\n  • ")

// ── ход плана ───────────────────────────────────────────────────────────────

тип «Ход»
  вариант «Ждём пару» содержит осталось: список «Цель», исходы: список «Исход»
  вариант «Ждём состояния» содержит исходы: список «Исход»

тотальная функция «Начать»
  возвращает «Ход»
  вариант «Ждём пару» с осталось равным («Цели») и исходы равным []

тотальная функция «Следующая»
  принимает осталось: список «Цель», исходы: список «Исход»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда состояний»)]) и потом равным (вариант «Ждём состояния» с исходы равным исходы)
    случай голова и хвост
      то вариант «Сделать» с поручение равным («Поручение пары» от голова) и потом равным (вариант «Ждём пару» с осталось равным осталось и исходы равным исходы)

тотальная функция «После пары»
  принимает осталось: список «Цель», исходы: список «Исход», отклик: «Отклик»
  возвращает «Продолжение»
  обеспечивает «После пары: ветвь Пока ничего» если отклик равен (вариант «Пока ничего») то результат равен («Следующая» от осталось и исходы) иначе да
  разбор отклик
    случай вариант «Пока ничего»
      то «Следующая» от осталось и исходы
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то разбор осталось
        случай пусто
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ответ пришёл, а пары никто не поднимал"
        случай голова и хвост
          то «Следующая» от хвост и (добавить («Судить пару» от голова и вывод и ошибки) к исходы)
    случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
      то вариант «Провал» с код равным "FLANG_UZEL_PARA_UBITA" и сообщение равным (соединить ["оболочка пары убита сигналом ", сигнал] по "")
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_UZEL_NECHEM_PODNYAT" и сообщение равным (соединить ["sh не запустился: ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответ оболочки о паре"

тотальная функция «После состояний»
  принимает исходы: список «Исход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то «Итог» от исходы и («Состояния сошлись» от вывод)
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответ двоичного о начальных состояниях"

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём пару» с осталось как осталось и исходы как исходы
      то «После пары» от осталось и исходы и отклик
    случай вариант «Ждём состояния» с исходы как исходы
      то «После состояний» от исходы и отклик

план «Полный узел работает на целях печати»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
