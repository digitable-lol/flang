  ["── Аксиом ноль, и это не упущение ──", "── ПОЧЕМУ ТЕОРЕМА, А НЕ АКСИОМА ──", "── ПОЧЕМУ СЧЁТ НЕ АКСИОМА ──", "── ПОЧЕМУ ЭТО НЕ АКСИОМА ──"]

// ── Суд над одной подделкой ────────────────────────────────────────────────

тотальная функция «Про пропажу»
  принимает подделка: «Подделка», имя: строка
  возвращает строка
  пример «Подделка разошлась с проверкой»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано имя равно "а"
    ожидается "f.flang: утверждения «а» в отчёте нет — подделка разошлась с проверкой"
  соединить [подделка.«файл», ": утверждения «", имя, "» в отчёте нет — подделка разошлась с проверкой"] по ""

тотальная функция «Про дыру»
  принимает подделка: «Подделка», имя: строка, вердикт: строка
  возвращает строка
  пример «Ложь доказана — правило берёт ложь»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано имя равно "а"
    дано вердикт равно "proved"
    ожидается "f.flang: «а» ДОКАЗАНО (proved) — правило «п» берёт ложь"
  соединить [подделка.«файл», ": «", имя, "» ДОКАЗАНО (", вердикт, ") — правило «", подделка.«правило», "» берёт ложь"] по ""

тотальная функция «Беды подделки»
  принимает подделка: «Подделка», пункты: список «Утверждение»
  возвращает список строки
  пример «Все утверждения на месте и не взяты — бед нет»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано пункты равно [запись «Утверждение» с «имя» равным "а" и «вердикт» равным "declared"]
    ожидается пустой список
  пример «Утверждение доказано — беда названа»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано пункты равно [запись «Утверждение» с «имя» равным "а" и «вердикт» равным "proved"]
    ожидается ["f.flang: «а» ДОКАЗАНО (proved) — правило «п» берёт ложь"]
  свёртка (подделка.«утверждения») начиная с (пустой список) как беды и имя
    пусть вердикт равно («Вердикт по имени» от пункты и имя)
    если вердикт равен ""
      то добавить («Про пропажу» от подделка и имя) к беды
      иначе если «Взято ядром» от вердикт
        то добавить («Про дыру» от подделка и имя и вердикт) к беды
        иначе беды

// ── Суд над честной половиной ──────────────────────────────────────────────
//
// Здесь всё наоборот: утверждение истинно, и ядро обязано его ВЗЯТЬ. Не взяло —
// правило не работает, и подделка при нём ничего не меряет: она осталась бы
// недоказанной и при выключенном правиле вовсе.

тотальная функция «Про мёртвое правило»
  принимает подделка: «Подделка», имя: строка, вердикт: строка
  возвращает строка
  пример «Истина не взята — правило не работает»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано имя равно "а"
    дано вердикт равно "grid"
    ожидается "f.flang: «а» НЕ доказано (grid) — правило «п» не работает, и подделка при нём ничего не меряет"
  соединить [подделка.«файл», ": «", имя, "» НЕ доказано (", вердикт, ") — правило «", подделка.«правило», "» не работает, и подделка при нём ничего не меряет"] по ""

тотальная функция «Про пропажу правды»
  принимает подделка: «Подделка», имя: строка
  возвращает строка
  пример «Честная половина разошлась с проверкой»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано имя равно "а"
    ожидается "f.flang: утверждения «а» в отчёте нет — пара разошлась с проверкой"
  соединить [подделка.«файл», ": утверждения «", имя, "» в отчёте нет — пара разошлась с проверкой"] по ""

тотальная функция «Беды правды»
  принимает подделка: «Подделка», пункты: список «Утверждение»
  возвращает список строки
  пример «Истина доказана — бед нет»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано пункты равно [запись «Утверждение» с «имя» равным "а" и «вердикт» равным "proved-induction"]
    ожидается пустой список
  пример «Истина не взята — беда названа»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано пункты равно [запись «Утверждение» с «имя» равным "а" и «вердикт» равным "grid"]
    ожидается ["f.flang: «а» НЕ доказано (grid) — правило «п» не работает, и подделка при нём ничего не меряет"]
  свёртка (подделка.«утверждения») начиная с (пустой список) как беды и имя
    пусть вердикт равно («Вердикт по имени» от пункты и имя)
    если вердикт равен ""
      то добавить («Про пропажу правды» от подделка и имя) к беды
      иначе если «Взято ядром» от вердикт
        то беды
        иначе добавить («Про мёртвое правило» от подделка и имя и вердикт) к беды

// ── Аксиом ноль ────────────────────────────────────────────────────────────

объект «Обход»
  «внутри»: признак
  «нашли»: признак

тотальная функция «Заголовок довода»
  принимает строчка: строка
  возвращает признак
  пример «Названный довод»
    дано строчка равно "// ── ПОЧЕМУ ТЕОРЕМА, А НЕ АКСИОМА ────────────"
    ожидается да
  пример «Чужой заголовок»
    дано строчка равно "// ── Что здесь считается ───────────"
    ожидается нет
  свёртка («Заголовки доводов») начиная с нет как найдено и заголовок
    найдено или (строчка содержит заголовок)

тотальная функция «Слово аксиома»
  принимает строчка: строка
  возвращает признак
  пример «Строчное написание»
    дано строчка равно "// это аксиома"
    ожидается да
  пример «С большой буквы»
    дано строчка равно "// Аксиома принимается без проверки"
    ожидается да
  пример «Прописью»
    дано строчка равно "// НЕ АКСИОМА"
    ожидается да
  пример «Слова нет»
    дано строчка равно "// это теорема"
    ожидается нет
  (строчка содержит "аксиом") или (строчка содержит "Аксиом") или (строчка содержит "АКСИОМ")

тотальная функция «Шаг обхода»
  принимает обход: «Обход», строчка: строка
  возвращает «Обход»
  пример «Строка кода закрывает довод»
    дано обход равно запись «Обход» с «внутри» равным да и «нашли» равным нет
    дано строчка равно "тотальная функция «Шаг»"
    ожидается запись «Обход» с «внутри» равным нет и «нашли» равным нет
  пример «Заголовок довода открывает блок и сам под запрет не идёт»
    дано обход равно запись «Обход» с «внутри» равным нет и «нашли» равным нет
    дано строчка равно "// ── ПОЧЕМУ СЧЁТ НЕ АКСИОМА ──"
    ожидается запись «Обход» с «внутри» равным да и «нашли» равным нет
  пример «Аксиома вне довода — найдена»
    дано обход равно запись «Обход» с «внутри» равным нет и «нашли» равным нет
    дано строчка равно "// здесь завелась аксиома"
    ожидается запись «Обход» с «внутри» равным нет и «нашли» равным да
  пусть комментарий равно ((«Без пробелов в начале» от строчка) начинается с "//")
  пусть внутри равно (если не комментарий то нет иначе если («Заголовок довода» от строчка) то да иначе если (строчка содержит "──") то нет иначе (обход.«внутри»))
  запись «Обход» с «внутри» равным внутри и «нашли» равным ((обход.«нашли») или (не внутри) и притом («Слово аксиома» от строчка))

тотальная функция «Аксиома вне довода»
  принимает ядро: строка
  возвращает признак
  пример «Довод не считается аксиомой»
    дано ядро равно "// ── ПОЧЕМУ СЧЁТ НЕ АКСИОМА ──\n// Аксиома принимается без проверки\nфункция «Ф»"
    ожидается нет
  пример «Аксиома в обычном комментарии — найдена»
    дано ядро равно "// просто аксиома\nфункция «Ф»"
    ожидается да
  (свёртка (разделить ядро по "\n") начиная с (запись «Обход» с «внутри» равным нет и «нашли» равным нет) как обход и строчка → («Шаг обхода» от обход и строчка)).«нашли»

тотальная функция «Пропавшие доводы»
  принимает ядро: строка
  возвращает список строки
  пример «Все доводы на месте»
    дано ядро равно "// ── Аксиом ноль, и это не упущение ──\n// ── ПОЧЕМУ ТЕОРЕМА, А НЕ АКСИОМА ──\n// ── ПОЧЕМУ СЧЁТ НЕ АКСИОМА ──\n// ── ПОЧЕМУ ЭТО НЕ АКСИОМА ──"
    ожидается пустой список
  отобразить (отфильтровать («Заголовки доводов») где заголовок → не (ядро содержит заголовок)) как заголовок → (соединить ["довод «", заголовок, "» пропал, а слово «аксиома» вычёркивается по нему"] по "")

// ── Печать: у какого утверждения сторож снимается, а у какого обязан остаться ─
//
// Спрашивается НАСТОЯЩЕЙ командой печати — `flang emit … --target c`, — а не
// отдельным пробником: вердикт берётся оттуда же, откуда его берёт человек.
// Читаются только модульные исходники: `flang_runtime.c` несёт образец
// «постусловие «%s»» без имени, `flang_cli.c` — прогонщик, и оба к делу не
// относятся. Так проверка и точнее, и не тащит четверть мегабайта в отчёт.

тотальная функция «Подделка печати»
  возвращает строка
  пример «Файл, у которого один сторож снимается, а два остаются»
    ожидается "flang/test/fixtures/poddelka-snyatie-storozha.flang"
  "flang/test/fixtures/poddelka-snyatie-storozha.flang"

тотальная функция «Правило печати»
  возвращает строка
  пример «Правило названо целиком»
    ожидается "доказанное постусловие в напечатанный код не едет"
  "доказанное постусловие в напечатанный код не едет"

тотальная функция «Каталог печати»
  возвращает строка
  пример «Печатается в каталог, который git не видит»
    ожидается "../../out-poddelki-pechat"
  "../../out-poddelki-pechat"

// Сторож, которого в напечатанном коде быть НЕ должно: утверждение доказано
// ядром и проверено примерами.
тотальная функция «Сторожа снятые»
  возвращает список строки
  пример «Снимается ровно один»
    ожидается ["противоположное есть нуль минус вход"]
  ["противоположное есть нуль минус вход"]

// Две границы правила, и обе обязаны СОХРАНИТЬ сторожа: недоказанное
// утверждение и утверждение функции БЕЗ примеров.
тотальная функция «Сторожа оставшиеся»
  возвращает список строки
  пример «Остаются двое»
    ожидается ["это и есть вхождение", "и это нуль минус вход"]
  ["это и есть вхождение", "и это нуль минус вход"]

тотальная функция «Метка сторожа»
  принимает имя: строка
  возвращает строка
  пример «Сторож узнаётся по этой строке напечатанного кода»
    дано имя равно "это и есть вхождение"
    ожидается "постусловие «это и есть вхождение»"
  соединить ["постусловие «", имя, "»"] по ""

тотальная функция «Про напечатанного сторожа»
  принимает имя: строка
  возвращает строка
  пример «Доказанное утверждение всё-таки поехало в код»
    дано имя равно "противоположное есть нуль минус вход"
    ожидается "flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «противоположное есть нуль минус вход» напечатан, а утверждение доказано и проверено примерами — правило «доказанное постусловие в напечатанный код не едет» не сработало"
  соединить [(«Подделка печати»), ": сторож «", имя, "» напечатан, а утверждение доказано и проверено примерами — правило «", («Правило печати»), "» не сработало"] по ""

тотальная функция «Про снятого сторожа»
  принимает имя: строка
  возвращает строка
  пример «Сняли то, что сниматься не должно»
    дано имя равно "это и есть вхождение"
    ожидается "flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «это и есть вхождение» СНЯТ, а сниматься не должен — правило «доказанное постусловие в напечатанный код не едет» шире объявленного"
  соединить [(«Подделка печати»), ": сторож «", имя, "» СНЯТ, а сниматься не должен — правило «", («Правило печати»), "» шире объявленного"] по ""

тотальная функция «Беды печати»
  принимает текст: строка
  возвращает список строки
  пример «Снятый снят, оставшиеся на месте — бед нет»
    дано текст равно "постусловие «это и есть вхождение» и постусловие «и это нуль минус вход»"
    ожидается пустой список
  пример «Доказанное постусловие напечатано — беда названа»
    дано текст равно "постусловие «противоположное есть нуль минус вход» постусловие «это и есть вхождение» постусловие «и это нуль минус вход»"
    ожидается ["flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «противоположное есть нуль минус вход» напечатан, а утверждение доказано и проверено примерами — правило «доказанное постусловие в напечатанный код не едет» не сработало"]
  пример «Сняли лишнего — обе беды названы»
    дано текст равно ""
    ожидается ["flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «это и есть вхождение» СНЯТ, а сниматься не должен — правило «доказанное постусловие в напечатанный код не едет» шире объявленного", "flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «и это нуль минус вход» СНЯТ, а сниматься не должен — правило «доказанное постусловие в напечатанный код не едет» шире объявленного"]
  «Сложить» от (отобразить (отфильтровать («Сторожа снятые») где имя → (текст содержит («Метка сторожа» от имя))) как имя → («Про напечатанного сторожа» от имя)) и (отобразить (отфильтровать («Сторожа оставшиеся») где имя → не (текст содержит («Метка сторожа» от имя))) как имя → («Про снятого сторожа» от имя))

тотальная функция «Кончается на»
  принимает текст: строка, хвостик: строка
  возвращает признак
  пример «Исходник на C»
    дано текст равно "poddelka_snyatiya_storozha.c"
    дано хвостик равно ".c"
    ожидается да
  пример «Заголовок за исходник не считается»
    дано текст равно "poddelka_snyatiya_storozha.h"
    дано хвостик равно ".c"
    ожидается нет
  пусть куски равно (разделить текст по хвостик)
  ((длина куски) не меньше 2) и притом ((элемент (длина куски) в куски) равен "")

тотальная функция «Модульные исходники»
  принимает имена: список строки
  возвращает список строки
  пример «Рантайм и прогонщик отсеиваются, заголовки тоже»
    дано имена равно ["Makefile", "flang_cli.c", "flang_runtime.c", "flang_runtime.h", "poddelka_snyatiya_storozha.c", "poddelka_snyatiya_storozha.h"]
    ожидается ["poddelka_snyatiya_storozha.c"]
  отфильтровать имена где имя → («Кончается на» от имя и ".c") и притом (не (имя равен "flang_cli.c")) и притом (не (имя равен "flang_runtime.c"))

// ── Круг при работе: проверка обязана остаться живой в напечатанном коде ────
//
// Развязка постусловий снимает контракты у ДВОЙНИКОВ. Снимись они шире — круг
// «туда и обратно» перестал бы проверяться вовсе, и `flang check` этого не
// увидел бы: примеры автора нарушающего входа не содержат. Поэтому программа
// ПЕЧАТАЕТСЯ, СОБИРАЕТСЯ и ЗОВЁТСЯ на входе, который утверждение нарушает.

тотальная функция «Подделка круга»
  возвращает строка
  пример «Файл, который печатается и собирается»
    ожидается "flang/test/fixtures/poddelka-krug-pri-rabote.flang"
  "flang/test/fixtures/poddelka-krug-pri-rabote.flang"

тотальная функция «Каталог круга»
  возвращает строка
  пример «Собирается в каталог, который git не видит»
    ожидается "../../out-poddelki-krug"
  "../../out-poddelki-krug"

тотальная функция «Собранный прогонщик»
  возвращает строка
  пример «Собранная программа лежит рядом с напечатанным»
    ожидается "../../out-poddelki-krug/flang_cli"
  соединить [(«Каталог круга»), "/flang_cli"] по ""

// Вход, на котором круг СХОДИТСЯ: список из одного элемента переворачивается
// сам в себя.
тотальная функция «Запрос на один»
  возвращает строка
  пример «Один элемент»
    ожидается "{\"fn\":\"Переворот хитрец\",\"args\":[{\"l\":[{\"n\":\"1\"}]}]}"
  "{\"fn\":\"Переворот хитрец\",\"args\":[{\"l\":[{\"n\":\"1\"}]}]}"

// Вход, на котором утверждение НАРУШАЕТСЯ и собранная программа обязана
// ответить FLANG_PROPERTY.
тотальная функция «Запрос на два»
  возвращает строка
  пример «Два элемента»
    ожидается "{\"fn\":\"Переворот хитрец\",\"args\":[{\"l\":[{\"n\":\"1\"},{\"n\":\"2\"}]}]}"
  "{\"fn\":\"Переворот хитрец\",\"args\":[{\"l\":[{\"n\":\"1\"},{\"n\":\"2\"}]}]}"

// СПРОСИТЬ СОБРАННУЮ ПРОГРАММУ ПРИХОДИТСЯ ЧЕРЕЗ ОБОЛОЧКУ, И ВОТ ПОЧЕМУ.
//
// В словаре языка поручение для этого есть — «Запустить процесс с вводом»
// (`flang/cat/SPEC.md`, шестнадцать поручений). Двоичный хозяин его НЕ ЗНАЕТ:
//
//   flang io flang/scripts/poddelki-yadra.flang
//   • …: собранная программа не запустилась —
//     хозяин не знает поручения «Запустить процесс с вводом»
//
// Это тот самый FLANG_IO_UNKNOWN, про который спека говорит «вот этого быть не
// должно ни у кого». Пока его нет, вход подаётся оболочкой: `printf` и труба.
// Кавычек и обратных косых в запросе нет — только двойные, — поэтому одинарные
// кавычки оболочки его закрывают целиком.
тотальная функция «Спросить собранную»
  принимает запрос: строка
  возвращает «Поручение»
  пример «Вход подаётся трубой, потому что поручения с вводом хозяин не знает»
    дано запрос равно "{}"
    ожидается вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "printf '%s\\n' '{}' | ../../out-poddelki-krug/flang_cli"]
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (соединить ["printf '%s\\n' '", запрос, "' | ", («Собранный прогонщик»)] по "")]

тотальная функция «Беды короткого круга»
  принимает ответ: строка
  возвращает список строки
  пример «Круг сошёлся»
    дано ответ равно "{\"ok\":true,\"value\":{\"l\":[{\"n\":\"1\"}]}}"
    ожидается пустой список
  пример «Собранная программа отказала там, где обязана ответить»
    дано ответ равно "{\"ok\":false}"
    ожидается ["flang/test/fixtures/poddelka-krug-pri-rabote.flang: на [1] собранная программа отказала — {\"ok\":false}"]
  если ответ содержит "\"ok\":true"
    то пустой список
    иначе [соединить [(«Подделка круга»), ": на [1] собранная программа отказала — ", ответ] по ""]

тотальная функция «Беды длинного круга»
  принимает ответ: строка
  возвращает список строки
  пример «Нарушение поймано в напечатанном коде»
    дано ответ равно "{\"ok\":false,\"code\":\"FLANG_PROPERTY\",\"message\":\"нарушено свойство «круг сходится» функции «Переворот хитрец»\"}"
    ожидается пустой список
  пример «Нарушение НЕ поймано — развязка сняла проверку шире объявленного»
    дано ответ равно "{\"ok\":true,\"value\":{\"l\":[{\"n\":\"2\"},{\"n\":\"1\"}]}}"
    ожидается ["flang/test/fixtures/poddelka-krug-pri-rabote.flang: на [1, 2] нарушение НЕ поймано — развязка сняла проверку шире объявленного: {\"ok\":true,\"value\":{\"l\":[{\"n\":\"2\"},{\"n\":\"1\"}]}}"]
  если (ответ содержит "FLANG_PROPERTY") и притом (ответ содержит "круг сходится")
    то пустой список
    иначе [соединить [(«Подделка круга»), ": на [1, 2] нарушение НЕ поймано — развязка сняла проверку шире объявленного: ", ответ] по ""]

