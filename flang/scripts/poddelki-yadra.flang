    ожидается ["── Аксиом ноль, и это не упущение ──", "── ПОЧЕМУ ТЕОРЕМА, А НЕ АКСИОМА ──", "── ПОЧЕМУ СЧЁТ НЕ АКСИОМА ──", "── ПОЧЕМУ ЭТО НЕ АКСИОМА ──"]
  ["── Аксиом ноль, и это не упущение ──", "── ПОЧЕМУ ТЕОРЕМА, А НЕ АКСИОМА ──", "── ПОЧЕМУ СЧЁТ НЕ АКСИОМА ──", "── ПОЧЕМУ ЭТО НЕ АКСИОМА ──"]

// ── СВЕРКА СПИСКОВ С КАТАЛОГОМ: НИ ОДНОЙ ПОДДЕЛКИ МИМО НАДЗОРА ─────────────
//
// Списки выше — единственное место, где сказано, ЧЕГО ждать от подделки. Файл,
// в них не названный, не проверяется вовсе; правило под ним стоит без надзора,
// а проверка при этом зеленеет — то есть врёт. Так и было: в каталоге лежало
// четырнадцать подделок, здесь названы восемь, и шесть правил ядра не сторожил
// никто.
//
// Поэтому каталог и списки сверяются В ОБЕ СТОРОНЫ, и сверяются ПЕРВЫМ ДЕЛОМ,
// до всякого запуска компилятора: файл `poddelka-*.flang` без записи красит
// проверку словами «НЕЗАРЕГИСТРИРОВАННАЯ ПОДДЕЛКА», запись на пропавший файл —
// словами «запись на исчезнувший файл». Обойти сверку можно ровно одним
// способом: вписать файл и сказать, чего от него ждут.

тотальная функция «Каталог подделок»
  возвращает строка
  пример «Подделки лежат в одном каталоге»
    ожидается "../../flang/test/fixtures"
  "../../flang/test/fixtures"

тотальная функция «Приставка подделок»
  возвращает строка
  пример «Тот же каталог, но путём от корня дерева»
    ожидается "flang/test/fixtures/"
  "flang/test/fixtures/"

тотальная функция «Без повторов»
  принимает имена: список строки
  возвращает список строки
  пример «Повтор убран, порядок первых вхождений цел»
    дано имена равно ["а", "б", "а"]
    ожидается ["а", "б"]
  свёртка имена начиная с (пустой список) как собрано и имя
    если собрано содержит имя
      то собрано
      иначе добавить имя к собрано

// Все файлы, названные хоть где-то в этой проверке. Считается по СПИСКАМ, а не
// переписывается рядом ещё раз: второй список разошёлся бы с первым в тот же
// день, и сверка мерила бы согласие проверки с самой собой.
тотальная функция «Названные файлы»
  возвращает список строки
  «Без повторов» от («Сложить» от («Сложить» от («Сложить» от (отобразить («Подделки лжи») как подделка → (подделка.«файл»)) и (отобразить («Подделки правды») как подделка → (подделка.«файл»))) и (отобразить («Подделки отказа») как отказ → (отказ.«файл»))) и [(«Подделка прохода»), («Подделка печати»), («Подделка круга»)])

тотальная функция «Названные подделки»
  возвращает список строки
  отфильтровать («Названные файлы») где файл → (файл начинается с (соединить [(«Приставка подделок»), "poddelka-"] по ""))

тотальная функция «Подделки каталога»
  принимает имена: список строки
  возвращает список строки
  пример «Из каталога берутся только подделки»
    дано имена равно ["krug-tuda-i-obratno.flang", "poddelka-dlina.flang", "plany"]
    ожидается ["flang/test/fixtures/poddelka-dlina.flang"]
  отобразить (отфильтровать имена где имя → (имя начинается с "poddelka-") и притом («Кончается на» от имя и ".flang")) как имя → (соединить [(«Приставка подделок»), имя] по "")

тотальная функция «Файлы каталога»
  принимает имена: список строки
  возвращает список строки
  пример «Каждое имя каталога — путь от корня дерева»
    дано имена равно ["krug-tuda-i-obratno.flang"]
    ожидается ["flang/test/fixtures/krug-tuda-i-obratno.flang"]
  отобразить имена как имя → (соединить [(«Приставка подделок»), имя] по "")

тотальная функция «Про незарегистрированную»
  принимает файл: строка
  возвращает строка
  пример «Подделка лежит в каталоге, а в списках её нет»
    дано файл равно "flang/test/fixtures/poddelka-х.flang"
    ожидается "flang/test/fixtures/poddelka-х.flang: НЕЗАРЕГИСТРИРОВАННАЯ ПОДДЕЛКА — лежит в каталоге, а ни в одном списке не названа: правило, ради которого она написана, стоит без надзора. Впишите файл и скажите, чего от него ждёте"
  соединить [файл, ": НЕЗАРЕГИСТРИРОВАННАЯ ПОДДЕЛКА — лежит в каталоге, а ни в одном списке не названа: правило, ради которого она написана, стоит без надзора. Впишите файл и скажите, чего от него ждёте"] по ""

тотальная функция «Про исчезнувший файл»
  принимает файл: строка
  возвращает строка
  пример «Запись есть, файла нет»
    дано файл равно "flang/test/fixtures/poddelka-х.flang"
    ожидается "flang/test/fixtures/poddelka-х.flang: запись на исчезнувший файл — проверка ждёт подделку, которой в каталоге нет. Снимайте запись доводом, почему правило больше не нуждается в надзоре, а не молча"
  соединить [файл, ": запись на исчезнувший файл — проверка ждёт подделку, которой в каталоге нет. Снимайте запись доводом, почему правило больше не нуждается в надзоре, а не молча"] по ""

тотальная функция «Незарегистрированные»
  принимает названы: список строки, вкаталоге: список строки
  возвращает список строки
  пример «Одна из двух подделок каталога не названа»
    дано названы равно ["flang/test/fixtures/poddelka-а.flang"]
    дано вкаталоге равно ["flang/test/fixtures/poddelka-а.flang", "flang/test/fixtures/poddelka-х.flang"]
    ожидается ["flang/test/fixtures/poddelka-х.flang: НЕЗАРЕГИСТРИРОВАННАЯ ПОДДЕЛКА — лежит в каталоге, а ни в одном списке не названа: правило, ради которого она написана, стоит без надзора. Впишите файл и скажите, чего от него ждёте"]
  отобразить (отфильтровать вкаталоге где файл → не (названы содержит файл)) как файл → («Про незарегистрированную» от файл)

тотальная функция «Исчезнувшие»
  принимает названы: список строки, вкаталоге: список строки
  возвращает список строки
  пример «Названного файла в каталоге нет»
    дано названы равно ["flang/test/fixtures/poddelka-х.flang"]
    дано вкаталоге равно ["flang/test/fixtures/poddelka-а.flang"]
    ожидается ["flang/test/fixtures/poddelka-х.flang: запись на исчезнувший файл — проверка ждёт подделку, которой в каталоге нет. Снимайте запись доводом, почему правило больше не нуждается в надзоре, а не молча"]
  отобразить (отфильтровать названы где файл → не (вкаталоге содержит файл)) как файл → («Про исчезнувший файл» от файл)

тотальная функция «Беды каталога»
  принимает имена: список строки
  возвращает список строки
  «Сложить» от («Незарегистрированные» от («Названные подделки») и («Подделки каталога» от имена)) и («Исчезнувшие» от («Названные файлы») и («Файлы каталога» от имена))

тотальная функция «Сколько подделок»
  возвращает число
  длина («Названные подделки»)

// ── Суд над одной подделкой ────────────────────────────────────────────────

тотальная функция «Про пропажу»
  принимает подделка: «Подделка», имя: строка
  возвращает строка
  пример «Подделка разошлась с проверкой»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано имя равно "а"
    ожидается "f.flang: утверждения «а» в отчёте нет — подделка разошлась с проверкой"
  соединить [подделка.«файл», ": утверждения «", имя, "» в отчёте нет — подделка разошлась с проверкой"] по ""

тотальная функция «Про дыру»
  принимает подделка: «Подделка», имя: строка, вердикт: строка
  возвращает строка
  пример «Ложь доказана — правило берёт ложь»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано имя равно "а"
    дано вердикт равно "proved"
    ожидается "f.flang: «а» ДОКАЗАНО (proved) — правило «п» берёт ложь"
  соединить [подделка.«файл», ": «", имя, "» ДОКАЗАНО (", вердикт, ") — правило «", подделка.«правило», "» берёт ложь"] по ""

тотальная функция «Беды подделки»
  принимает подделка: «Подделка», пункты: список «Утверждение»
  возвращает список строки
  пример «Все утверждения на месте и не взяты — бед нет»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано пункты равно [запись «Утверждение» с «имя» равным "а" и «вердикт» равным "declared"]
    ожидается пустой список
  пример «Утверждение доказано — беда названа»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано пункты равно [запись «Утверждение» с «имя» равным "а" и «вердикт» равным "proved"]
    ожидается ["f.flang: «а» ДОКАЗАНО (proved) — правило «п» берёт ложь"]
  свёртка (подделка.«утверждения») начиная с (пустой список) как беды и имя
    пусть вердикт равно («Вердикт по имени» от пункты и имя)
    если вердикт равен ""
      то добавить («Про пропажу» от подделка и имя) к беды
      иначе если «Взято ядром» от вердикт
        то добавить («Про дыру» от подделка и имя и вердикт) к беды
        иначе беды

тотальная функция «Про непринятую»
  принимает подделка: «Подделка», имя: строка, вердикт: строка
  возвращает строка
  пример «Правда не взята — правило не работает, и подделка при нём ничего не меряет»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано имя равно "а"
    дано вердикт равно "declared"
    ожидается "f.flang: «а» НЕ доказано (declared) — правило «п» не работает, и подделка при нём ничего не меряет"
  соединить [подделка.«файл», ": «", имя, "» НЕ доказано (", вердикт, ") — правило «", подделка.«правило», "» не работает, и подделка при нём ничего не меряет"] по ""

тотальная функция «Беды правды»
  принимает подделка: «Подделка», пункты: список «Утверждение»
  возвращает список строки
  пример «Правда взята — бед нет»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано пункты равно [запись «Утверждение» с «имя» равным "а" и «вердикт» равным "proved"]
    ожидается пустой список
  пример «Правда не взята — беда названа»
    дано подделка равно запись «Подделка» с «файл» равным "f.flang" и «правило» равным "п" и «утверждения» равным ["а"]
    дано пункты равно [запись «Утверждение» с «имя» равным "а" и «вердикт» равным "grid"]
    ожидается ["f.flang: «а» НЕ доказано (grid) — правило «п» не работает, и подделка при нём ничего не меряет"]
  свёртка (подделка.«утверждения») начиная с (пустой список) как беды и имя
    пусть вердикт равно («Вердикт по имени» от пункты и имя)
    если вердикт равен ""
      то добавить («Про пропажу» от подделка и имя) к беды
      иначе если «Взято ядром» от вердикт
        то беды
        иначе добавить («Про непринятую» от подделка и имя и вердикт) к беды

// ── Аксиом ноль ────────────────────────────────────────────────────────────

объект «Обход»
  «внутри»: признак
  «нашли»: признак

тотальная функция «Заголовок довода»
  принимает строчка: строка
  возвращает признак
  пример «Названный довод»
    дано строчка равно "// ── ПОЧЕМУ ТЕОРЕМА, А НЕ АКСИОМА ────────────"
    ожидается да
  пример «Чужой заголовок»
    дано строчка равно "// ── Что здесь считается ───────────"
    ожидается нет
  свёртка («Заголовки доводов») начиная с нет как найдено и заголовок
    найдено или (строчка содержит заголовок)

тотальная функция «Слово аксиома»
  принимает строчка: строка
  возвращает признак
  пример «Строчное написание»
    дано строчка равно "// это аксиома"
    ожидается да
  пример «С большой буквы»
    дано строчка равно "// Аксиома принимается без проверки"
    ожидается да
  пример «Прописью»
    дано строчка равно "// НЕ АКСИОМА"
    ожидается да
  пример «Слова нет»
    дано строчка равно "// это теорема"
    ожидается нет
  (строчка содержит "аксиом") или (строчка содержит "Аксиом") или (строчка содержит "АКСИОМ")

тотальная функция «Шаг обхода»
  принимает обход: «Обход», строчка: строка
  возвращает «Обход»
  пример «Строка кода закрывает довод»
    дано обход равно запись «Обход» с «внутри» равным да и «нашли» равным нет
    дано строчка равно "тотальная функция «Шаг»"
    ожидается запись «Обход» с «внутри» равным нет и «нашли» равным нет
  пример «Заголовок довода открывает блок и сам под запрет не идёт»
    дано обход равно запись «Обход» с «внутри» равным нет и «нашли» равным нет
    дано строчка равно "// ── ПОЧЕМУ СЧЁТ НЕ АКСИОМА ──"
    ожидается запись «Обход» с «внутри» равным да и «нашли» равным нет
  пример «Аксиома вне довода — найдена»
    дано обход равно запись «Обход» с «внутри» равным нет и «нашли» равным нет
    дано строчка равно "// здесь завелась аксиома"
    ожидается запись «Обход» с «внутри» равным нет и «нашли» равным да
  пусть комментарий равно ((«Без пробелов в начале» от строчка) начинается с "//")
  пусть внутри равно (если не комментарий то нет иначе если («Заголовок довода» от строчка) то да иначе если (строчка содержит "──") то нет иначе (обход.«внутри»))
  запись «Обход» с «внутри» равным внутри и «нашли» равным ((обход.«нашли») или (не внутри) и притом («Слово аксиома» от строчка))

тотальная функция «Аксиома вне довода»
  принимает ядро: строка
  возвращает признак
  пример «Довод не считается аксиомой»
    дано ядро равно "// ── ПОЧЕМУ СЧЁТ НЕ АКСИОМА ──\n// Аксиома принимается без проверки\nфункция «Ф»"
    ожидается нет
  пример «Аксиома в обычном комментарии — найдена»
    дано ядро равно "// просто аксиома\nфункция «Ф»"
    ожидается да
  (свёртка (разделить ядро по "\n") начиная с (запись «Обход» с «внутри» равным нет и «нашли» равным нет) как обход и строчка → («Шаг обхода» от обход и строчка)).«нашли»

тотальная функция «Пропавшие доводы»
  принимает ядро: строка
  возвращает список строки
  пример «Все доводы на месте»
    дано ядро равно "// ── Аксиом ноль, и это не упущение ──\n// ── ПОЧЕМУ ТЕОРЕМА, А НЕ АКСИОМА ──\n// ── ПОЧЕМУ СЧЁТ НЕ АКСИОМА ──\n// ── ПОЧЕМУ ЭТО НЕ АКСИОМА ──"
    ожидается пустой список
  отобразить (отфильтровать («Заголовки доводов») где заголовок → не (ядро содержит заголовок)) как заголовок → (соединить ["довод «", заголовок, "» пропал, а слово «аксиома» вычёркивается по нему"] по "")

// ── Печать: у какого утверждения сторож снимается, а у какого обязан остаться ─
//
// Спрашивается НАСТОЯЩЕЙ командой печати — `flang emit … --target c`, — а не
// отдельным пробником: вердикт берётся оттуда же, откуда его берёт человек.
// Читаются только модульные исходники: `flang_runtime.c` несёт образец
// «постусловие «%s»» без имени, `flang_cli.c` — прогонщик, и оба к делу не
// относятся. Так проверка и точнее, и не тащит четверть мегабайта в отчёт.

тотальная функция «Подделка печати»
  возвращает строка
  пример «Файл, у которого один сторож снимается, а два остаются»
    ожидается "flang/test/fixtures/poddelka-snyatie-storozha.flang"
  "flang/test/fixtures/poddelka-snyatie-storozha.flang"

тотальная функция «Правило печати»
  возвращает строка
  пример «Правило названо целиком»
    ожидается "доказанное постусловие в напечатанный код не едет"
  "доказанное постусловие в напечатанный код не едет"

тотальная функция «Каталог печати»
  возвращает строка
  пример «Печатается в каталог, который git не видит»
    ожидается "../../out-poddelki-pechat"
  "../../out-poddelki-pechat"

// Сторож, которого в напечатанном коде быть НЕ должно: утверждение доказано
// ядром и проверено примерами.
тотальная функция «Сторожа снятые»
  возвращает список строки
  пример «Снимается ровно один»
    ожидается ["противоположное есть нуль минус вход"]
  ["противоположное есть нуль минус вход"]

// Две границы правила, и обе обязаны СОХРАНИТЬ сторожа: недоказанное
// утверждение и утверждение функции БЕЗ примеров.
тотальная функция «Сторожа оставшиеся»
  возвращает список строки
  пример «Остаются двое»
    ожидается ["это и есть вхождение", "и это нуль минус вход"]
  ["это и есть вхождение", "и это нуль минус вход"]

тотальная функция «Метка сторожа»
  принимает имя: строка
  возвращает строка
  пример «Сторож узнаётся по этой строке напечатанного кода»
    дано имя равно "это и есть вхождение"
    ожидается "постусловие «это и есть вхождение»"
  соединить ["постусловие «", имя, "»"] по ""

тотальная функция «Про напечатанного сторожа»
  принимает имя: строка
  возвращает строка
  пример «Доказанное утверждение всё-таки поехало в код»
    дано имя равно "противоположное есть нуль минус вход"
    ожидается "flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «противоположное есть нуль минус вход» напечатан, а утверждение доказано и проверено примерами — правило «доказанное постусловие в напечатанный код не едет» не сработало"
  соединить [(«Подделка печати»), ": сторож «", имя, "» напечатан, а утверждение доказано и проверено примерами — правило «", («Правило печати»), "» не сработало"] по ""

тотальная функция «Про снятого сторожа»
  принимает имя: строка
  возвращает строка
  пример «Сняли то, что сниматься не должно»
    дано имя равно "это и есть вхождение"
    ожидается "flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «это и есть вхождение» СНЯТ, а сниматься не должен — правило «доказанное постусловие в напечатанный код не едет» шире объявленного"
  соединить [(«Подделка печати»), ": сторож «", имя, "» СНЯТ, а сниматься не должен — правило «", («Правило печати»), "» шире объявленного"] по ""

тотальная функция «Беды печати»
  принимает текст: строка
  возвращает список строки
  пример «Снятый снят, оставшиеся на месте — бед нет»
    дано текст равно "постусловие «это и есть вхождение» и постусловие «и это нуль минус вход»"
    ожидается пустой список
  пример «Доказанное постусловие напечатано — беда названа»
    дано текст равно "постусловие «противоположное есть нуль минус вход» постусловие «это и есть вхождение» постусловие «и это нуль минус вход»"
    ожидается ["flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «противоположное есть нуль минус вход» напечатан, а утверждение доказано и проверено примерами — правило «доказанное постусловие в напечатанный код не едет» не сработало"]
  пример «Сняли лишнего — обе беды названы»
    дано текст равно ""
    ожидается ["flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «это и есть вхождение» СНЯТ, а сниматься не должен — правило «доказанное постусловие в напечатанный код не едет» шире объявленного", "flang/test/fixtures/poddelka-snyatie-storozha.flang: сторож «и это нуль минус вход» СНЯТ, а сниматься не должен — правило «доказанное постусловие в напечатанный код не едет» шире объявленного"]
  «Сложить» от (отобразить (отфильтровать («Сторожа снятые») где имя → (текст содержит («Метка сторожа» от имя))) как имя → («Про напечатанного сторожа» от имя)) и (отобразить (отфильтровать («Сторожа оставшиеся») где имя → не (текст содержит («Метка сторожа» от имя))) как имя → («Про снятого сторожа» от имя))

тотальная функция «Кончается на»
  принимает текст: строка, хвостик: строка
  возвращает признак
  пример «Исходник на C»
    дано текст равно "poddelka_snyatiya_storozha.c"
    дано хвостик равно ".c"
    ожидается да
  пример «Заголовок за исходник не считается»
    дано текст равно "poddelka_snyatiya_storozha.h"
    дано хвостик равно ".c"
    ожидается нет
  пусть куски равно (разделить текст по хвостик)
  ((длина куски) не меньше 2) и притом ((элемент (длина куски) в куски) равен "")

тотальная функция «Модульные исходники»
  принимает имена: список строки
  возвращает список строки
  пример «Рантайм и прогонщик отсеиваются, заголовки тоже»
    дано имена равно ["Makefile", "flang_cli.c", "flang_runtime.c", "flang_runtime.h", "poddelka_snyatiya_storozha.c", "poddelka_snyatiya_storozha.h"]
    ожидается ["poddelka_snyatiya_storozha.c"]
  отфильтровать имена где имя → («Кончается на» от имя и ".c") и притом (не (имя равен "flang_cli.c")) и притом (не (имя равен "flang_runtime.c"))

// ── Круг при работе: проверка обязана остаться живой в напечатанном коде ────
//
// Развязка постусловий снимает контракты у ДВОЙНИКОВ. Снимись они шире — круг
// «туда и обратно» перестал бы проверяться вовсе, и `flang check` этого не
// увидел бы: примеры автора нарушающего входа не содержат. Поэтому программа
// ПЕЧАТАЕТСЯ, СОБИРАЕТСЯ и ЗОВЁТСЯ на входе, который утверждение нарушает.

тотальная функция «Подделка круга»
  возвращает строка
  пример «Файл, который печатается и собирается»
    ожидается "flang/test/fixtures/poddelka-krug-pri-rabote.flang"
  "flang/test/fixtures/poddelka-krug-pri-rabote.flang"

тотальная функция «Каталог круга»
  возвращает строка
  пример «Собирается в каталог, который git не видит»
    ожидается "../../out-poddelki-krug"
  "../../out-poddelki-krug"

тотальная функция «Собранный прогонщик»
  возвращает строка
  пример «Собранная программа лежит рядом с напечатанным»
    ожидается "../../out-poddelki-krug/flang_cli"
  соединить [(«Каталог круга»), "/flang_cli"] по ""

// Вход, на котором круг СХОДИТСЯ: список из одного элемента переворачивается
// сам в себя.
тотальная функция «Запрос на один»
  возвращает строка
  пример «Один элемент»
    ожидается "{\"fn\":\"Переворот хитрец\",\"args\":[{\"l\":[{\"n\":\"1\"}]}]}"
  "{\"fn\":\"Переворот хитрец\",\"args\":[{\"l\":[{\"n\":\"1\"}]}]}"

// Вход, на котором утверждение НАРУШАЕТСЯ и собранная программа обязана
// ответить FLANG_PROPERTY.
тотальная функция «Запрос на два»
  возвращает строка
  пример «Два элемента»
    ожидается "{\"fn\":\"Переворот хитрец\",\"args\":[{\"l\":[{\"n\":\"1\"},{\"n\":\"2\"}]}]}"
  "{\"fn\":\"Переворот хитрец\",\"args\":[{\"l\":[{\"n\":\"1\"},{\"n\":\"2\"}]}]}"

// СПРОСИТЬ СОБРАННУЮ ПРОГРАММУ ПРИХОДИТСЯ ЧЕРЕЗ ОБОЛОЧКУ, И ВОТ ПОЧЕМУ.
//
// В словаре языка поручение для этого есть — «Запустить процесс с вводом»
// (`flang/cat/SPEC.md`, шестнадцать поручений). Двоичный хозяин его НЕ ЗНАЕТ:
//
//   flang io flang/scripts/poddelki-yadra.flang
//   • …: собранная программа не запустилась —
//     хозяин не знает поручения «Запустить процесс с вводом»
//
// Это тот самый FLANG_IO_UNKNOWN, про который спека говорит «вот этого быть не
// должно ни у кого». Пока его нет, вход подаётся оболочкой: `printf` и труба.
// Кавычек и обратных косых в запросе нет — только двойные, — поэтому одинарные
// кавычки оболочки его закрывают целиком.
тотальная функция «Спросить собранную»
  принимает запрос: строка
  возвращает «Поручение»
  пример «Вход подаётся трубой, потому что поручения с вводом хозяин не знает»
    дано запрос равно "{}"
    ожидается вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "printf '%s\\n' '{}' | ../../out-poddelki-krug/flang_cli"]
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (соединить ["printf '%s\\n' '", запрос, "' | ", («Собранный прогонщик»)] по "")]

тотальная функция «Беды короткого круга»
  принимает ответ: строка
  возвращает список строки
  пример «Круг сошёлся»
    дано ответ равно "{\"ok\":true,\"value\":{\"l\":[{\"n\":\"1\"}]}}"
    ожидается пустой список
  пример «Собранная программа отказала там, где обязана ответить»
    дано ответ равно "{\"ok\":false}"
    ожидается ["flang/test/fixtures/poddelka-krug-pri-rabote.flang: на [1] собранная программа отказала — {\"ok\":false}"]
  если ответ содержит "\"ok\":true"
    то пустой список
    иначе [соединить [(«Подделка круга»), ": на [1] собранная программа отказала — ", ответ] по ""]

тотальная функция «Беды длинного круга»
  принимает ответ: строка
  возвращает список строки
  пример «Нарушение поймано в напечатанном коде»
    дано ответ равно "{\"ok\":false,\"code\":\"FLANG_PROPERTY\",\"message\":\"нарушено свойство «круг сходится» функции «Переворот хитрец»\"}"
    ожидается пустой список
  пример «Нарушение НЕ поймано — развязка сняла проверку шире объявленного»
    дано ответ равно "{\"ok\":true,\"value\":{\"l\":[{\"n\":\"2\"},{\"n\":\"1\"}]}}"
    ожидается ["flang/test/fixtures/poddelka-krug-pri-rabote.flang: на [1, 2] нарушение НЕ поймано — развязка сняла проверку шире объявленного: {\"ok\":true,\"value\":{\"l\":[{\"n\":\"2\"},{\"n\":\"1\"}]}}"]
  если (ответ содержит "FLANG_PROPERTY") и притом (ответ содержит "круг сходится")
    то пустой список
    иначе [соединить [(«Подделка круга»), ": на [1, 2] нарушение НЕ поймано — развязка сняла проверку шире объявленного: ", ответ] по ""]

// ── План ───────────────────────────────────────────────────────────────────

тотальная функция «Сложить»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Два списка в один»
    дано первые равно ["раз"]
    дано вторые равно ["два"]
    ожидается ["раз", "два"]
  свёртка вторые начиная с первые как акк и хвостовое
    добавить хвостовое к акк

тотальная функция «Компилятор»
  возвращает строка
  пример «Двоичный лежит в точке раскрутки»
    ожидается "../../bootstrap/flang"
  "../../bootstrap/flang"

тотальная функция «Путь к дереву»
  принимает файл: строка
  возвращает строка
  пример «Путь считается от корня дерева»
    дано файл равно "flang/test/fixtures/a.flang"
    ожидается "../../flang/test/fixtures/a.flang"
  соединить ["../../", файл] по ""

тип «Ход»
  вариант «Ждём каталог» содержит беды: список строки
  вариант «Ждём отчёт» содержит очередь: список «Подделка», беды: список строки
  вариант «Ждём правду» содержит очередь: список «Подделка», беды: список строки
  вариант «Ждём отказ» содержит очередь: список «Отказ», беды: список строки
  вариант «Ждём проход» содержит беды: список строки
  вариант «Ждём уборку до» содержит беды: список строки
  вариант «Ждём печать» содержит беды: список строки
  вариант «Ждём список печати» содержит беды: список строки
  вариант «Ждём файл печати» содержит осталось: список строки, собрано: строка, беды: список строки
  вариант «Ждём печать круга» содержит беды: список строки
  вариант «Ждём сборку круга» содержит беды: список строки
  вариант «Ждём короткий круг» содержит беды: список строки
  вариант «Ждём длинный круг» содержит беды: список строки
  вариант «Ждём уборку после» содержит беды: список строки
  вариант «Ждём ядро» содержит беды: список строки

тотальная функция «Начать»
  возвращает «Ход»
  пример «Первым делом сверяются списки с каталогом, и ни одной беды ещё нет»
    ожидается вариант «Ждём каталог» с беды равным пустой список
  вариант «Ждём каталог» с беды равным (пустой список)

// Сверка идёт ДО первого запуска компилятора: незарегистрированная подделка —
// это правило без надзора, и узнать об этом надо раньше, чем проверка потратит
// минуту на те правила, у которых надзор есть.
//
// Разошлись каталог и списки — на этом и останавливаемся, а не идём дальше. Идти
// дальше значило бы запускать компилятор на файлах, которых может не быть, и
// падать словами «отчёт не сложился» вместо настоящей причины. Красным бы вышло
// и так, но названа была бы не та беда, а это ровно тот класс, ради которого всё
// здесь и заведено.
тотальная функция «После каталога»
  принимает беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Перечислено» с имена как имена
      то разбор («Сложить» от беды и («Беды каталога» от имена))
        случай пусто
          то «Пойти по подделкам» от («Подделки лжи») и (пустой список)
        случай голова и хвост
          то «Итог» от («Сложить» от беды и («Беды каталога» от имена))
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["каталог подделок не перечислить: ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали список каталога подделок"

тотальная функция «Спросить проход»
  принимает беды: список строки
  возвращает «Продолжение»
  пример «Спрашивается обычная проверка файла, который обязан пройти»
    дано беды равно пустой список
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "../../bootstrap/flang" и аргументы равным ["check", "../../flang/test/fixtures/krug-tuda-i-obratno.flang"]) и потом равным (вариант «Ждём проход» с беды равным пустой список)
  вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Компилятор») и аргументы равным ["check", («Путь к дереву» от («Подделка прохода»))]) и потом равным (вариант «Ждём проход» с беды равным беды)

тотальная функция «Спросить отказ»
  принимает очередь: список «Отказ», беды: список строки
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то «Спросить проход» от беды
    случай голова и хвост
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Компилятор») и аргументы равным ["check", («Путь к дереву» от (голова.«файл»))]) и потом равным (вариант «Ждём отказ» с очередь равным очередь и беды равным беды)

тотальная функция «Пойти по подделкам»
  принимает очередь: список «Подделка», беды: список строки
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то «Пойти по правде» от («Подделки правды») и беды
    случай голова и хвост
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Компилятор») и аргументы равным ["check", («Путь к дереву» от (голова.«файл»)), "--proof", "--json"]) и потом равным (вариант «Ждём отчёт» с очередь равным очередь и беды равным беды)

тотальная функция «Пойти по правде»
  принимает очередь: список «Подделка», беды: список строки
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то «Спросить отказ» от («Подделки отказа») и беды
    случай голова и хвост
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Компилятор») и аргументы равным ["check", («Путь к дереву» от (голова.«файл»)), "--proof", "--json"]) и потом равным (вариант «Ждём правду» с очередь равным очередь и беды равным беды)

// Число берётся ИЗ СВЕРЕННОГО СПИСКА, а не написано рядом рукой: написанное
// рукой говорило бы «проверено столько, сколько я собирался проверить» — то есть
// не говорило бы ничего. Сверка выше приравняла список каталогу, поэтому строка
// значит «в каталоге столько подделок, и каждая под надзором».
тотальная функция «Слова итога»
  возвращает строка
  пример «Итог называет число подделок»
    ожидается "подделки отвергнуты: 14 файлов — все poddelka-* каталога сверены со списками, ни одной мимо надзора; аксиом ноль, нарушений 0"
  соединить ["подделки отвергнуты: ", (к строке («Сколько подделок»)), " файлов — все poddelka-* каталога сверены со списками, ни одной мимо надзора; аксиом ноль, нарушений 0"] по ""

тотальная функция «Итог»
  принимает беды: список строки
  возвращает «Продолжение»
  пример «Бед нет — план доходит до конца»
    дано беды равно пустой список
    ожидается вариант «Конец работы» с значение равным "подделки отвергнуты: 14 файлов — все poddelka-* каталога сверены со списками, ни одной мимо надзора; аксиом ноль, нарушений 0"
  разбор беды
    случай пусто
      то вариант «Конец работы» с значение равным («Слова итога»)
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_PODDELKA_VZYATA" и сообщение равным (соединить (приписать (соединить ["нарушений: ", (к строке (длина беды))] по "") к беды) по "\n  • ")

тотальная функция «После отчёта»
  принимает очередь: список «Подделка», беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "отчёт приехал, а спрашивать было некому"
    случай голова и хвост
      то разбор отклик
        случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
          то если не (код равен 0)
            то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить [голова.«файл», ": отчёт о доказательствах не сложился, компилятор ответил кодом ", (к строке код), ": ", ошибки] по "")
            иначе «Пойти по подделкам» от хвост и («Сложить» от беды и («Беды подделки» от голова и («Утверждения отчёта» от вывод)))
        случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
          то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить [голова.«файл», ": компилятор убит сигналом ", сигнал] по "")
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["компилятор не запустился: ", сообщение] по "")
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали отчёт о доказательствах"

тотальная функция «После правды»
  принимает очередь: список «Подделка», беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "отчёт приехал, а спрашивать было некому"
    случай голова и хвост
      то разбор отклик
        случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
          то если не (код равен 0)
            то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить [голова.«файл», ": отчёт о доказательствах не сложился, компилятор ответил кодом ", (к строке код), ": ", ошибки] по "")
            иначе «Пойти по правде» от хвост и («Сложить» от беды и («Беды правды» от голова и («Утверждения отчёта» от вывод)))
        случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
          то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["компилятор убит сигналом ", сигнал] по "")
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["компилятор не запустился: ", сообщение] по "")
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали отчёт о доказательствах"

тотальная функция «Про принятую»
  принимает отказ: «Отказ»
  возвращает строка
  пример «Файл принят, хотя обязан быть отвергнут»
    дано отказ равно запись «Отказ» с «файл» равным "f.flang" и «правило» равным "п" и «слова» равным "с"
    ожидается "f.flang: принят без замечаний — правило «п» шире объявленного"
  соединить [отказ.«файл», ": принят без замечаний — правило «", отказ.«правило», "» шире объявленного"] по ""

тотальная функция «Про чужие слова»
  принимает отказ: «Отказ»
  возвращает строка
  пример «Отвергнут, но не теми словами»
    дано отказ равно запись «Отказ» с «файл» равным "f.flang" и «правило» равным "п" и «слова» равным "с"
    ожидается "f.flang: отвергнут, но не теми словами: ждали «с»"
  соединить [отказ.«файл», ": отвергнут, но не теми словами: ждали «", отказ.«слова», "»"] по ""

тотальная функция «Беды отказа»
  принимает отказ: «Отказ», код: число, сказано: строка
  возвращает список строки
  пример «Отвергнут теми словами — беды нет»
    дано отказ равно запись «Отказ» с «файл» равным "f.flang" и «правило» равным "п" и «слова» равным "только скаляры"
    дано код равно 1
    дано сказано равно "FLANG_TYPE: сравнивать на равенство можно только скаляры"
    ожидается пустой список
  пример «Принят, хотя обязан быть отвергнут»
    дано отказ равно запись «Отказ» с «файл» равным "f.flang" и «правило» равным "п" и «слова» равным "только скаляры"
    дано код равно 0
    дано сказано равно ""
    ожидается ["f.flang: принят без замечаний — правило «п» шире объявленного"]
  пример «Отвергнут, но по другой причине»
    дано отказ равно запись «Отказ» с «файл» равным "f.flang" и «правило» равным "п" и «слова» равным "только скаляры"
    дано код равно 1
    дано сказано равно "FLANG_PARSE: не разобралось"
    ожидается ["f.flang: отвергнут, но не теми словами: ждали «только скаляры»"]
  если код равен 0
    то [«Про принятую» от отказ]
    иначе если не (сказано содержит (отказ.«слова»))
      то [«Про чужие слова» от отказ]
      иначе пустой список

тотальная функция «После отказа»
  принимает очередь: список «Отказ», беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ответ приехал, а спрашивать было некому"
    случай голова и хвост
      то разбор отклик
        случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
          то «Спросить отказ» от хвост и («Сложить» от беды и («Беды отказа» от голова и код и (соединить [вывод, ошибки] по "\n")))
        случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
          то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["компилятор убит сигналом ", сигнал] по "")
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["компилятор не запустился: ", сообщение] по "")
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответ компилятора"

тотальная функция «Про отвергнутый проход»
  принимает первая: строка
  возвращает строка
  пример «Файл отвергнут, а обязан пройти»
    дано первая равно "FLANG_RECURSION_LIMIT"
    ожидается "flang/test/fixtures/krug-tuda-i-obratno.flang: отвергнут, а обязан пройти — правило «контракт не проверяется, пока считается контракт (истинный круг обязан пройти)» не работает: FLANG_RECURSION_LIMIT"
  соединить [(«Подделка прохода»), ": отвергнут, а обязан пройти — правило «", («Правило прохода»), "» не работает: ", первая] по ""

тотальная функция «После прохода»
  принимает беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то «Спросить уборку до» от (если код равен 0 то беды иначе (добавить («Про отвергнутый проход» от (голова (разделить (соединить [вывод, ошибки] по "\n") по "\n"))) к беды))
    случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
      то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["компилятор убит сигналом ", сигнал] по "")
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["компилятор не запустился: ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответ компилятора"

// ── Печать и сборка ────────────────────────────────────────────────────────
//
// Оба каталога сносятся ДО работы, а не только после: остаток чужого прогона в
// каталоге печати доехал бы до сравнения как свой.

тотальная функция «Спросить уборку до»
  принимает беды: список строки
  возвращает «Продолжение»
  пример «Сносятся оба каталога разом»
    дано беды равно пустой список
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "rm" и аргументы равным ["-rf", "../../out-poddelki-pechat", "../../out-poddelki-krug"]) и потом равным (вариант «Ждём уборку до» с беды равным пустой список)
  вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "rm" и аргументы равным ["-rf", («Каталог печати»), («Каталог круга»)]) и потом равным (вариант «Ждём уборку до» с беды равным беды)

тотальная функция «Спросить печать»
  принимает беды: список строки
  возвращает «Продолжение»
  пример «Печатается настоящей командой печати»
    дано беды равно пустой список
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "../../bootstrap/flang" и аргументы равным ["emit", "../../flang/test/fixtures/poddelka-snyatie-storozha.flang", "--target", "c", "--out", "../../out-poddelki-pechat"]) и потом равным (вариант «Ждём печать» с беды равным пустой список)
  вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Компилятор») и аргументы равным ["emit", («Путь к дереву» от («Подделка печати»)), "--target", "c", "--out", («Каталог печати»)]) и потом равным (вариант «Ждём печать» с беды равным беды)

тотальная функция «После печати»
  принимает беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то если не (код равен 0)
        то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить [(«Подделка печати»), ": не напечаталась, компилятор ответил кодом ", (к строке код), ": ", ошибки] по "")
        иначе вариант «Сделать» с поручение равным (вариант «Перечислить каталог» с путь равным («Каталог печати»)) и потом равным (вариант «Ждём список печати» с беды равным беды)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["печать не запустилась: ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответ печати"

тотальная функция «Пойти по файлам печати»
  принимает осталось: список строки, собрано: строка, беды: список строки
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то «Спросить печать круга» от («Сложить» от беды и («Беды печати» от собрано))
    случай голова и хвост
      то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным (соединить [(«Каталог печати»), "/", голова] по "")) и потом равным (вариант «Ждём файл печати» с осталось равным осталось и собрано равным собрано и беды равным беды)

тотальная функция «После списка печати»
  принимает беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Перечислено» с имена как имена
      то разбор («Модульные исходники» от имена)
        случай пусто
          то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить [(«Каталог печати»), ": печать не оставила ни одного модульного исходника — смотреть нечего"] по "")
        случай голова и хвост
          то «Пойти по файлам печати» от («Модульные исходники» от имена) и "" и беды
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить ["каталог печати не перечислить: ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали список каталога печати"

тотальная функция «После файла печати»
  принимает осталось: список строки, собрано: строка, беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "текст приехал, а читать было некого"
    случай голова и хвост
      то разбор отклик
        случай вариант «Прочитано» с содержимое как текст
          то «Пойти по файлам печати» от хвост и (соединить [собрано, текст] по "\n") и беды
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным "FLANG_PODDELKA_NECHEM_SMOTRET" и сообщение равным (соединить [голова, ": ", сообщение] по "")
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали текст напечатанного исходника"

