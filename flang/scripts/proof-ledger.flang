тотальная функция «Потоков по памяти»
  принимает мета: строка
  возвращает число
  обеспечивает «поток хотя бы один» результат не меньше 1
  обеспечивает «потоков не больше шестидесяти четырёх» результат не больше 64
  пример «Половина свободной памяти делится на тридцать гибибайт: 347 ГиБ — пять потоков»
    дано мета равно "MemTotal:       523000000 kB\nMemAvailable:   364000000 kB\n"
    ожидается 5
  пример «Памяти мало — всё равно один поток»
    дано мета равно "MemAvailable:   1000 kB\n"
    ожидается 1
  пример «Строки о доступной памяти нет — один поток»
    дано мета равно "MemTotal: 1 kB\n"
    ожидается 1
  пример «Памяти очень много — потолок шестьдесят четыре»
    дано мета равно "MemAvailable:   99999999999 kB\n"
    ожидается 64
  пусть цифры равно («Ведущие цифры» от («Обрезать края» от («До метки» от («Хвост за меткой» от мета и "MemAvailable:") и "kB")))
  пусть килобайт равно (если цифры равен "" то 0 иначе к числу цифры)
  пусть влезает равно ((килобайт минус (килобайт остаток от 62914560)) делить на 62914560)
  если влезает не больше 1
    то 1
    иначе если влезает не меньше 64
      то 64
      иначе влезает

объект «Счёт заданий»
  «текст»: строка
  «следующий»: число

тотальная функция «Строки заданий»
  принимает стан: «Стан свода»
  возвращает строка
  пример «Задание — полный путь файла и место ответа»
    дано стан равно запись «Стан свода» с «режим» равным "слова" и «каталог» равным "/tmp/x" и «корень» равным "/дерево" и «корпус» равным ["а.flang", "б.flang"] и «номера» равным "\n" и «потоков» равным 1 и «итог» равным (запись «Итог свода» с «функций» равным 0 и «тотальных» равным 0 и «обычных» равным 0 и «композиция» равным 0 и «структура» равным 0 и «точный шаг» равным 0 и «постоянный шаг» равным 0 и «мера» равным 0 и «неучтённых» равным 0 и «сторожей» равным 0 и «частичных» равным 0 и «с частичными» равным 0 и «тотальных с частичными» равным 0 и «без проверок» равным 0 и «без проверок глубоко» равным 0 и «утверждений» равным 0 и «доказано» равным 0 и «индукцией» равным 0 и «по сумме» равным 0 и «по отрезку» равным 0 и «по свёртке» равным 0 и «без теоремы» равным 0 и «по типу» равным 0 и «условно» равным 0 и «сетка» равным 0 и «объявлено» равным 0 и «отвергнуто» равным 0 и «нарушено» равным 0 и «шагов» равным 0) и «отвергнуто без ведомости» равным 0 и «строки файлов» равным пустой список и «подмены» равным пустой список и «отказы» равным пустой список
    ожидается "/дерево/а.flang /tmp/x/0\n/дерево/б.flang /tmp/x/1\n"
  пусть счёт равно (свёртка стан.«корпус» начиная с (запись «Счёт заданий» с «текст» равным "" и «следующий» равным 0) как ход и путь → (запись «Счёт заданий» с «текст» равным (соединить [ход.«текст», стан.«корень», "/", путь, " ", стан.«каталог», "/", (к строке ход.«следующий»), "\n"] по "") и «следующий» равным (ход.«следующий» плюс 1)))
  счёт.«текст»

тотальная функция «Команда веера»
  принимает стан: «Стан свода»
  возвращает список строки
  пример «Веер xargs: дерево и ведомость каждого файла, пульс раз в минуту, число ветвей из среды или по памяти»
    дано стан равно запись «Стан свода» с «режим» равным "слова" и «каталог» равным "/tmp/x" и «корень» равным "/дерево" и «корпус» равным пустой список и «номера» равным "\n" и «потоков» равным 5 и «итог» равным (запись «Итог свода» с «функций» равным 0 и «тотальных» равным 0 и «обычных» равным 0 и «композиция» равным 0 и «структура» равным 0 и «точный шаг» равным 0 и «постоянный шаг» равным 0 и «мера» равным 0 и «неучтённых» равным 0 и «сторожей» равным 0 и «частичных» равным 0 и «с частичными» равным 0 и «тотальных с частичными» равным 0 и «без проверок» равным 0 и «без проверок глубоко» равным 0 и «утверждений» равным 0 и «доказано» равным 0 и «индукцией» равным 0 и «по сумме» равным 0 и «по отрезку» равным 0 и «по свёртке» равным 0 и «без теоремы» равным 0 и «по типу» равным 0 и «условно» равным 0 и «сетка» равным 0 и «объявлено» равным 0 и «отвергнуто» равным 0 и «нарушено» равным 0 и «шагов» равным 0) и «отвергнуто без ведомости» равным 0 и «строки файлов» равным пустой список и «подмены» равным пустой список и «отказы» равным пустой список
    ожидается ["-c", "B=\"${FLANG_BINARY:-/дерево/bootstrap/flang}\"; ( trap 'kill $S 2>/dev/null; exit 0' TERM; while :; do sleep 60 & S=$!; wait $S; echo .; done ) & HB=$!; xargs -a '/tmp/x/tasks' -n 2 -P \"${FLANG_POTOKOV:-5}\" sh -c '\"$0\" ast \"$1\" >\"$2.ast\" 2>\"$2.ast.err\"; \"$0\" check \"$1\" --proof --json >\"$2.json\" 2>\"$2.err\"; echo $? >\"$2.kod\"; echo \"$1\"' \"$B\"; K=$?; kill $HB 2>/dev/null; exit $K"]
  ["-c", (соединить ["B=\"${FLANG_BINARY:-", стан.«корень», "/bootstrap/flang}\"; ( trap 'kill $S 2>/dev/null; exit 0' TERM; while :; do sleep 60 & S=$!; wait $S; echo .; done ) & HB=$!; xargs -a '", стан.«каталог», "/tasks' -n 2 -P \"${FLANG_POTOKOV:-", (к строке стан.«потоков»), "}\" sh -c '\"$0\" ast \"$1\" >\"$2.ast\" 2>\"$2.ast.err\"; \"$0\" check \"$1\" --proof --json >\"$2.json\" 2>\"$2.err\"; echo $? >\"$2.kod\"; echo \"$1\"' \"$B\"; K=$?; kill $HB 2>/dev/null; exit $K"] по "")]

тотальная функция «Команда чужого дерева»
  принимает стан: «Стан свода», путь: строка
  возвращает список строки
  пример «Сосед вне корпуса спрашивается у двоичного по одному»
    дано стан равно запись «Стан свода» с «режим» равным "слова" и «каталог» равным "/tmp/x" и «корень» равным "/дерево" и «корпус» равным пустой список и «номера» равным "\n" и «потоков» равным 1 и «итог» равным (запись «Итог свода» с «функций» равным 0 и «тотальных» равным 0 и «обычных» равным 0 и «композиция» равным 0 и «структура» равным 0 и «точный шаг» равным 0 и «постоянный шаг» равным 0 и «мера» равным 0 и «неучтённых» равным 0 и «сторожей» равным 0 и «частичных» равным 0 и «с частичными» равным 0 и «тотальных с частичными» равным 0 и «без проверок» равным 0 и «без проверок глубоко» равным 0 и «утверждений» равным 0 и «доказано» равным 0 и «индукцией» равным 0 и «по сумме» равным 0 и «по отрезку» равным 0 и «по свёртке» равным 0 и «без теоремы» равным 0 и «по типу» равным 0 и «условно» равным 0 и «сетка» равным 0 и «объявлено» равным 0 и «отвергнуто» равным 0 и «нарушено» равным 0 и «шагов» равным 0) и «отвергнуто без ведомости» равным 0 и «строки файлов» равным пустой список и «подмены» равным пустой список и «отказы» равным пустой список
    дано путь равно "docs/x.flang"
    ожидается ["-c", "exec \"${FLANG_BINARY:-/дерево/bootstrap/flang}\" ast '/дерево/docs/x.flang'"]
  ["-c", (соединить ["exec \"${FLANG_BINARY:-", стан.«корень», "/bootstrap/flang}\" ast '", стан.«корень», "/", путь, "'"] по "")]

