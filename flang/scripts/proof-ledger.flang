  пример «Каталог для ответов, корень дерева и файлы пяти расширений — одним заходом оболочки»
    ожидается ["-c", "cd ../.. && T=$(mktemp -d) && printf '%s\\n%s\\n' \"$T\" \"$(pwd)\" && find flang \\( -name '*.flang' -o -name '*.fp' -o -name '*.фп' -o -name '*.фланг' -o -name '*.fscript' \\) -type f | LC_ALL=C sort"]
  ["-c", "cd ../.. && T=$(mktemp -d) && printf '%s\\n%s\\n' \"$T\" \"$(pwd)\" && find flang \\( -name '*.flang' -o -name '*.fp' -o -name '*.фп' -o -name '*.фланг' -o -name '*.fscript' \\) -type f | LC_ALL=C sort"]

