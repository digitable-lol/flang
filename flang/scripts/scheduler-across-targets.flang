модуль «Планировщик на целях»

объект «Цель»
  «имя»: строка
  «сборка»: строка
  «запуск»: строка

тотальная функция «Цели»
  возвращает список «Цель»
  обеспечивает «девять целей» (длина результат) равен 9
  [запись «Цель» с «имя» равным "js" и «сборка» равным "true" и «запуск» равным "node flang_cli.js planirovschik_uzla.js",
   запись «Цель» с «имя» равным "python" и «сборка» равным "make check" и «запуск» равным "python3 -B flang_cli.py planirovschik_uzla",
   запись «Цель» с «имя» равным "go" и «сборка» равным "make" и «запуск» равным "./flang_cli",
   запись «Цель» с «имя» равным "c" и «сборка» равным "make" и «запуск» равным "./flang_cli",
   запись «Цель» с «имя» равным "cpp" и «сборка» равным "make" и «запуск» равным "./flang_cli",
   запись «Цель» с «имя» равным "rust" и «сборка» равным "RUSTFLAGS='-D warnings' cargo build --offline" и «запуск» равным "./target/debug/flang_cli",
   запись «Цель» с «имя» равным "java" и «сборка» равным "make build" и «запуск» равным "java -cp . FlangCli PlanirovschikUzla",
   запись «Цель» с «имя» равным "csharp" и «сборка» равным "dotnet build -v quiet --nologo" и «запуск» равным "dotnet $(find bin -name flang.dll | head -1) PlanirovschikUzla",
   запись «Цель» с «имя» равным "elixir" и «сборка» равным "elixirc --warnings-as-errors -o _build flang_runtime.ex planirovschik_uzla.ex flang_cli.ex" и «запуск» равным "elixir -pa _build -e 'Flang.Cli.main([\"PlanirovschikUzla\"])'"]

тотальная функция «Корень работы»
  возвращает строка
  "../../tmp/planirovshchik-na-celyah"

тотальная функция «Корень от дерева»
  возвращает строка
  "tmp/planirovshchik-na-celyah"

тотальная функция «Файл вопросов»
  возвращает строка
  соединить [(«Корень работы»), "/voprosy.jsonl"] по ""

тотальная функция «Файл ответов»
  принимает имя: строка
  возвращает строка
  пример «Ответы каждой цели лежат в своём файле рядом с вопросником»
    дано имя равно "go"
    ожидается "../../tmp/planirovshchik-na-celyah/answers-go.jsonl"
  соединить [(«Корень работы»), "/answers-", имя, ".jsonl"] по ""

тотальная функция «Слить»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Порядок сохраняется»
    дано первые равно ["раз"]
    дано вторые равно ["два"]
    ожидается ["раз", "два"]
  свёртка вторые начиная с первые как итог и строчка
    добавить строчка к итог

тотальная функция «Слить списки»
  принимает списки: список (список строки)
  возвращает список строки
  свёртка списки начиная с пустой список как итог и один
    «Слить» от итог и один

тотальная функция «Слить наборы»
  принимает первые: список (список строки), вторые: список (список строки)
  возвращает список (список строки)
  пример «Порядок наборов сохраняется»
    дано первые равно [["раз"]]
    дано вторые равно [["два"]]
    ожидается [["раз"], ["два"]]
  свёртка вторые начиная с первые как итог и набор
    добавить набор к итог

тотальная функция «Каждый с каждым»
  принимает наборы: список (список строки), значения: список строки
  возвращает список (список строки)
  пример «Прежние измерения меняются медленнее нового»
    дано наборы равно [["а"], ["б"]]
    дано значения равно ["1", "2"]
    ожидается [["а", "1"], ["а", "2"], ["б", "1"], ["б", "2"]]
  свёртка наборы начиная с пустой список как итог и набор
    «Слить наборы» от итог и (отобразить значения как значение → (добавить значение к набор))

тотальная функция «Один пустой набор»
  возвращает список (список строки)
  [пустой список]

тотальная функция «Произведение»
  принимает измерения: список (список строки)
  возвращает список (список строки)
  пример «Первое измерение меняется медленнее всех, как внешний цикл»
    дано измерения равно [["false", "true"], ["0", "2"]]
    ожидается [["false", "0"], ["false", "2"], ["true", "0"], ["true", "2"]]
  свёртка измерения начиная с («Один пустой набор») как наборы и измерение
    «Каждый с каждым» от наборы и измерение

тотальная функция «Узел текстом»
  принимает жив_счётчика: строка, потолок: строка, ящик: строка, в_лёте: строка, жив_учётчика: строка, связи: строка, кто_бежит: строка, что_бежит: строка, работает: строка
  возвращает строка
  соединить [
    "{\"r\":[[\"имя\",{\"s\":\"счёт\"}],[\"процессы\",{\"l\":[",
    "{\"r\":[[\"имя\",{\"s\":\"Счётчик\"}],[\"вид\",{\"s\":\"шаг счёта\"}],[\"свой\",true],[\"на каком\",{\"s\":\"\"}],[\"жив\",", жив_счётчика, "],[\"причина\",{\"s\":\"\"}],[\"потолок\",{\"n\":\"", потолок, "\"}],[\"в лёте\",{\"n\":\"", в_лёте, "\"}],[\"ящик\",{\"l\":[", ящик, "]}]]},",
    "{\"r\":[[\"имя\",{\"s\":\"Учётчик\"}],[\"вид\",{\"s\":\"шаг учёта\"}],[\"свой\",false],[\"на каком\",{\"s\":\"учёт\"}],[\"жив\",", жив_учётчика, "],[\"причина\",{\"s\":\"\"}],[\"потолок\",{\"n\":\"0\"}],[\"в лёте\",{\"n\":\"0\"}],[\"ящик\",{\"l\":[]}]]}",
    "]}],[\"связи\",{\"l\":[", связи, "]}],[\"кто бежит\",{\"s\":\"", кто_бежит, "\"}],[\"что бежит\",{\"n\":\"", что_бежит, "\"}],[\"работает\",", работает, "]]}"
  ] по ""

тотальная функция «Письмо текстом»
  принимает билет: строка, начатое: строка
  возвращает строка
  соединить ["{\"r\":[[\"билет\",{\"n\":\"", билет, "\"}],[\"начатое\",", начатое, "]]}"] по ""

тотальная функция «Ящики»
  возвращает список строки
  обеспечивает «пустой, одно письмо, два письма» (длина результат) равен 3
  ["", («Письмо текстом» от "11" и "false"), (соединить [(«Письмо текстом» от "11" и "false"), («Письмо текстом» от "12" и "true")] по ",")]

тотальная функция «Что бежит при»
  принимает кто_бежит: строка
  возвращает строка
  пример «Никто не бежит — ноль»
    дано кто_бежит равно ""
    ожидается "0"
  пример «Бежит Счётчик — письмо 11»
    дано кто_бежит равно "Счётчик"
    ожидается "11"
  если кто_бежит равен ""
    то "0"
    иначе "11"

тотальная функция «Узел из набора»
  принимает набор: список строки
  возвращает строка
  «Узел текстом» от (элемент 1 в набор) и (элемент 2 в набор) и (элемент 3 в набор) и (элемент 4 в набор) и (элемент 5 в набор) и (элемент 6 в набор) и (элемент 7 в набор) и («Что бежит при» от (элемент 7 в набор)) и (элемент 8 в набор)

тотальная функция «Состояния»
  возвращает список строки
  обеспечивает «два на два на три на два на два на два на два на два — триста восемьдесят четыре состояния» (длина результат) равен 384
  отобразить («Произведение» от [["false", "true"], ["0", "2"], («Ящики»), ["0", "1"], ["false", "true"], ["", "{\"s\":\"учёт\"}"], ["", "Счётчик"], ["true", "false"]]) как набор → («Узел из набора» от набор)

тотальная функция «Ответы о кандидате текстом»
  принимает перенос_есть: строка, оценка: строка
  возвращает строка
  соединить ["{\"r\":[[\"разобран\",true],[\"типы сошлись\",true],[\"тотален\",true],[\"оценка постоянна\",true],[\"оценка\",{\"n\":\"", оценка, "\"}],[\"перенос объявлен\",", перенос_есть, "],[\"перенос тотален\",", перенос_есть, "]]}"] по ""

тотальная функция «Просьба о замене текстом»
  принимает кого: строка, вид: строка, предел_витков: строка
  возвращает строка
  соединить ["{\"r\":[[\"кого\",{\"s\":\"", кого, "\"}],[\"вид\",{\"s\":\"", вид, "\"}],[\"предел витков\",{\"n\":\"", предел_витков, "\"}]]}"] по ""

тотальная функция «События»
  возвращает список строки
  обеспечивает «двадцать шесть событий» (длина результат) равен 26
  ["{\"v\":\"Письмо снаружи\",\"f\":[[\"кому\",{\"s\":\"Счётчик\"}],[\"билет\",{\"n\":\"21\"}]]}",
   "{\"v\":\"Письмо снаружи\",\"f\":[[\"кому\",{\"s\":\"Учётчик\"}],[\"билет\",{\"n\":\"22\"}]]}",
   "{\"v\":\"Письмо снаружи\",\"f\":[[\"кому\",{\"s\":\"Кладовщик\"}],[\"билет\",{\"n\":\"23\"}]]}",
   "{\"v\":\"Таймер сработал\",\"f\":[[\"кому\",{\"s\":\"Счётчик\"}],[\"билет\",{\"n\":\"24\"}]]}",
   "{\"v\":\"Таймер сработал\",\"f\":[[\"кому\",{\"s\":\"Учётчик\"}],[\"билет\",{\"n\":\"25\"}]]}",
   "{\"v\":\"Связь готова\",\"f\":[[\"узел\",{\"s\":\"учёт\"}]]}",
   "{\"v\":\"Связь готова\",\"f\":[[\"узел\",{\"s\":\"склад\"}]]}",
   "{\"v\":\"Связь потеряна\",\"f\":[[\"узел\",{\"s\":\"учёт\"}],[\"почему\",{\"s\":\"сосед ушёл сам: остановлен\"}]]}",
   "{\"v\":\"Пора бежать\",\"f\":[[\"жребий\",{\"n\":\"0\"}]]}",
   "{\"v\":\"Пора бежать\",\"f\":[[\"жребий\",{\"n\":\"0.99\"}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[]}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[{\"v\":\"Велено слать\",\"f\":[[\"кому\",{\"s\":\"Учётчик\"}],[\"билет\",{\"n\":\"31\"}]]}]}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[{\"v\":\"Велено слать\",\"f\":[[\"кому\",{\"s\":\"Счётчик\"}],[\"билет\",{\"n\":\"32\"}]]}]}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[{\"v\":\"Велено слать\",\"f\":[[\"кому\",{\"s\":\"Кладовщик\"}],[\"билет\",{\"n\":\"33\"}]]}]}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[{\"v\":\"Велено слать позже\",\"f\":[[\"кому\",{\"s\":\"Счётчик\"}],[\"билет\",{\"n\":\"34\"}],[\"задержка\",{\"n\":\"50\"}]]}]}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[{\"v\":\"Велено отложить\",\"f\":[]}]}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[{\"v\":\"Велено продолжить\",\"f\":[]}]}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[{\"v\":\"Велено остановить\",\"f\":[[\"почему\",{\"s\":\"остановлен\"}]]}]}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[{\"v\":\"Велено остановить\",\"f\":[[\"почему\",{\"s\":\"не сошлось\"}]]}]}]]}",
   "{\"v\":\"Обработчик вернул\",\"f\":[[\"действия\",{\"l\":[{\"v\":\"Велено слать\",\"f\":[[\"кому\",{\"s\":\"Учётчик\"}],[\"билет\",{\"n\":\"35\"}]]},{\"v\":\"Велено отложить\",\"f\":[]},{\"v\":\"Велено остановить\",\"f\":[[\"почему\",{\"s\":\"остановлен\"}]]}]}]]}",
   "{\"v\":\"Обработчик отказал\",\"f\":[[\"код\",{\"s\":\"FLANG_BUDGET_EXHAUSTED\"}],[\"текст\",{\"s\":\"запас витков кончился\"}]]}",
   "{\"v\":\"Обработчик отказал\",\"f\":[[\"код\",{\"s\":\"FLANG_PROCESS\"}],[\"текст\",{\"s\":\"отклик не разобран\"}]]}",
   (соединить ["{\"v\":\"Просят заменить\",\"f\":[[\"просьба\",", («Просьба о замене текстом» от "Счётчик" и "шаг счёта вдвое" и "8"), "],[\"ответы\",", («Ответы о кандидате текстом» от "true" и "1"), "]]}"] по ""),
   (соединить ["{\"v\":\"Просят заменить\",\"f\":[[\"просьба\",", («Просьба о замене текстом» от "Счётчик" и "шаг счёта" и "8"), "],[\"ответы\",", («Ответы о кандидате текстом» от "false" и "1"), "]]}"] по ""),
   (соединить ["{\"v\":\"Просят заменить\",\"f\":[[\"просьба\",", («Просьба о замене текстом» от "Счётчик" и "шаг счёта вдвое" и "0"), "],[\"ответы\",", («Ответы о кандидате текстом» от "true" и "1"), "]]}"] по ""),
   (соединить ["{\"v\":\"Просят заменить\",\"f\":[[\"просьба\",", («Просьба о замене текстом» от "Кладовщик" и "шаг склада" и "8"), "],[\"ответы\",", («Ответы о кандидате текстом» от "true" и "1"), "]]}"] по "")]

тотальная функция «Запрос шаг узла»
  принимает узел: строка, событие: строка
  возвращает строка
  соединить ["{\"fn\":\"Шаг узла\",\"args\":[", узел, ",", событие, "]}"] по ""

тотальная функция «Вопросы для состояния»
  принимает узел: строка
  возвращает список строки
  отобразить («События») как событие → («Запрос шаг узла» от узел и событие)

тотальная функция «Запрос номер по жребию»
  принимает сколько: строка, жребий: строка
  возвращает строка
  соединить ["{\"fn\":\"Номер по жребию\",\"args\":[{\"n\":\"", сколько, "\"},{\"n\":\"", жребий, "\"}]}"] по ""

тотальная функция «Вопросы про жребий»
  возвращает список строки
  обеспечивает «двадцать вопросов про жребий» (длина результат) равен 20
  отобразить («Произведение» от [["0", "1", "3", "7"], ["0", "0.0001", "0.5", "0.9999", "1"]]) как набор → («Запрос номер по жребию» от (элемент 1 в набор) и (элемент 2 в набор))

тотальная функция «Все вопросы»
  возвращает список строки
  обеспечивает «десять тысяч четыре вопроса, как у проверки на Node» (длина результат) равен 10004
  «Слить» от («Слить списки» от (отобразить («Состояния») как узел → («Вопросы для состояния» от узел))) и («Вопросы про жребий»)

тотальная функция «Текст вопросов»
  возвращает строка
  соединить [(соединить («Все вопросы») по "\n"), "\n"] по ""

тотальная функция «Команда свидетеля»
  возвращает строка
  соединить [
    "cd ../.. && q=\"$PWD/", («Корень от дерева»), "/voprosy.jsonl\"",
    " && a=\"$PWD/", («Корень от дерева»), "/answers-witness.jsonl\"",
    " && d=", («Корень от дерева»), "/witness",
    " && rm -f \"$a\" && rm -rf \"$d\" && mkdir -p \"$d\"",
    " && bootstrap/flang emit flang/conc/scheduler.flang --target js --out \"$d\" > \"$d.log\" 2>&1",
    " && cp flang/conc/scheduler.js \"$d/witness.js\"",
    " && { grep -q '^export const \\$PROGRAM' \"$d/witness.js\" || sed -n '/^export const \\$PROGRAM = {/,$p' \"$d/planirovschik_uzla.js\" >> \"$d/witness.js\"; }",
    " && (cd \"$d\" && LC_ALL=C.UTF-8 node flang_cli.js witness.js < \"$q\" > \"$a\" 2>> ../witness.log)"
  ] по ""

тотальная функция «Команда цели»
  принимает цель: «Цель»
  возвращает строка
  соединить [
    "cd ../.. && q=\"$PWD/", («Корень от дерева»), "/voprosy.jsonl\"",
    " && a=\"$PWD/", («Корень от дерева»), "/answers-", (цель.«имя»), ".jsonl\"",
    " && l=\"$PWD/", («Корень от дерева»), "/log-", (цель.«имя»), ".txt\"",
    " && d=", («Корень от дерева»), "/cel-", (цель.«имя»),
    " && rm -f \"$a\" \"$l\" && rm -rf \"$d\" && mkdir -p \"$d\"",
    " && bootstrap/flang emit flang/conc/scheduler.flang --target ", (цель.«имя»), " --out \"$d\" >> \"$l\" 2>&1",
    "; (cd \"$d\" && ", (цель.«сборка»), ") >> \"$l\" 2>&1",
    "; (cd \"$d\" && LC_ALL=C.UTF-8 ", (цель.«запуск»), " < \"$q\" > \"$a\" 2>> \"$l\")"
  ] по ""

тотальная функция «Поручение заведения корня»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", (соединить ["mkdir -p ", («Корень работы»)] по "")]

тотальная функция «Поручение записи вопросов»
  возвращает «Поручение»
  вариант «Записать файл» с путь равным («Файл вопросов») и содержимое равным («Текст вопросов»)

тотальная функция «Поручение свидетеля»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда свидетеля»)]

тотальная функция «Поручение цели»
  принимает цель: «Цель»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда цели» от цель)]

тотальная функция «Поручение чтения ответов»
  принимает имя: строка
  возвращает «Поручение»
  вариант «Прочитать файл» с путь равным («Файл ответов» от имя)

тотальная функция «Содержимое»
  принимает отклик: «Отклик»
  возвращает строка
  пример «Прочитанный файл отдаёт текст»
    дано отклик равно вариант «Прочитано» с содержимое равным "раз"
    ожидается "раз"
  разбор отклик
    случай вариант «Прочитано» с содержимое как текст
      то текст
    случай любое
      то ""

тотальная функция «Непустые строки»
  принимает текст: строка
  возвращает список строки
  пример «Пустой хвост после последнего перевода строки не считается»
    дано текст равно "раз\nдва\n"
    ожидается ["раз", "два"]
  отфильтровать (разделить текст по "\n") где строчка → не (строчка равна "")

тотальная функция «Ответов ok»
  принимает текст: строка
  возвращает число
  пример «Отказ ответом ok не считается»
    дано текст равно "{\"ok\":true,\"value\":1}\n{\"ok\":false,\"code\":\"X\"}\n"
    ожидается 1
  длина (отфильтровать («Непустые строки» от текст) где строчка → (строчка начинается с "{\"ok\":true,"))

тотальная функция «Беда свидетеля»
  принимает вывод: строка, вопросов: число
  возвращает строка
  пример «Ответил на всё и всё ok — беды нет»
    дано вывод равно "{\"ok\":true,\"value\":1}\n{\"ok\":true,\"value\":2}\n"
    дано вопросов равно 2
    ожидается ""
  пример «Один отказ — беда, как у проверки на Node»
    дано вывод равно "{\"ok\":true,\"value\":1}\n{\"ok\":false,\"code\":\"X\"}\n"
    дано вопросов равно 2
    ожидается "свидетель flang/conc/scheduler.js: строк 2, ответов ok 1, вопросов 2"
  пример «Промолчал — беда»
    дано вывод равно ""
    дано вопросов равно 2
    ожидается "свидетель flang/conc/scheduler.js: строк 0, ответов ok 0, вопросов 2"
  если ((длина («Непустые строки» от вывод)) равен вопросов) и притом ((«Ответов ok» от вывод) равен вопросов)
    то ""
    иначе соединить ["свидетель flang/conc/scheduler.js: строк ", (к строке (длина («Непустые строки» от вывод))), ", ответов ok ", (к строке («Ответов ok» от вывод)), ", вопросов ", (к строке вопросов)] по ""

объект «Поиск расхождения»
  «номер»: число
  «первое»: число
  «остаток»: список строки

тотальная функция «Шаг поиска»
  принимает поиск: «Поиск расхождения», строчка: строка
  возвращает «Поиск расхождения»
  пусть номер равно ((поиск.«номер») плюс 1)
  разбор (поиск.«остаток»)
    случай пусто
      то запись «Поиск расхождения» с «номер» равным номер и «первое» равным (если (поиск.«первое») равен 0 то номер иначе (поиск.«первое»)) и «остаток» равным пустой список
    случай голова и хвост
      то запись «Поиск расхождения» с «номер» равным номер и «первое» равным (если ((поиск.«первое») равен 0) и притом (не (строчка равна голова)) то номер иначе (поиск.«первое»)) и «остаток» равным хвост

тотальная функция «Первое расхождение»
  принимает вывод: строка, эталон: строка
  возвращает число
  пример «Совпали — ноль»
    дано вывод равно "а\nб\n"
    дано эталон равно "а\nб\n"
    ожидается 0
  пример «Вторая строка разошлась»
    дано вывод равно "а\nв\n"
    дано эталон равно "а\nб\n"
    ожидается 2
  пример «Цель ответила короче — расхождение на первой недостающей строке»
    дано вывод равно "а\n"
    дано эталон равно "а\nб\n"
    ожидается 2
  пусть строки_эталона равно («Непустые строки» от эталон)
  пусть строки_вывода равно («Непустые строки» от вывод)
  пусть итог равно (свёртка строки_вывода начиная с (запись «Поиск расхождения» с «номер» равным 0 и «первое» равным 0 и «остаток» равным строки_эталона) как поиск и строчка → («Шаг поиска» от поиск и строчка))
  если (итог.«первое») больше 0
    то итог.«первое»
    иначе если (длина строки_вывода) равен (длина строки_эталона)
      то 0
      иначе (длина строки_вывода) плюс 1

объект «Исход»
  «имя»: строка
  «сошлась»: признак
  «почему»: строка

тотальная функция «Судить»
  принимает имя: строка, вывод: строка, эталон: строка
  возвращает «Исход»
  пример «Тексты совпали — сошлась»
    дано имя равно "проба"
    дано вывод равно "одно и то же\n"
    дано эталон равно "одно и то же\n"
    ожидается запись «Исход» с «имя» равным "проба" и «сошлась» равным да и «почему» равным ""
  пример «Цель промолчала — не сошлась»
    дано имя равно "проба"
    дано вывод равно ""
    дано эталон равно "одно\n"
    ожидается запись «Исход» с «имя» равным "проба" и «сошлась» равным нет и «почему» равным "цель не ответила ничего: не собралась, не запустилась или не получила вопросника"
  пример «Разошлась — названа строка, она же номер вопроса»
    дано имя равно "проба"
    дано вывод равно "а\nв\n"
    дано эталон равно "а\nб\n"
    ожидается запись «Исход» с «имя» равным "проба" и «сошлась» равным нет и «почему» равным "ответ разошёлся со свидетелем flang/conc/scheduler.js: у цели 2 строк, у свидетеля 2, первое расхождение на вопросе 2"
  если вывод равен эталон
    то запись «Исход» с «имя» равным имя и «сошлась» равным да и «почему» равным ""
    иначе если вывод равен ""
      то запись «Исход» с «имя» равным имя и «сошлась» равным нет и «почему» равным "цель не ответила ничего: не собралась, не запустилась или не получила вопросника"
      иначе запись «Исход» с «имя» равным имя и «сошлась» равным нет и «почему» равным (соединить ["ответ разошёлся со свидетелем flang/conc/scheduler.js: у цели ", (к строке (длина («Непустые строки» от вывод))), " строк, у свидетеля ", (к строке (длина («Непустые строки» от эталон))), ", первое расхождение на вопросе ", (к строке («Первое расхождение» от вывод и эталон))] по "")

тотальная функция «Сошедшиеся»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → (исход.«сошлась»)) как исход → (исход.«имя»)

тотальная функция «Беды»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → не (исход.«сошлась»)) как исход → (соединить [(исход.«имя»), ": ", (исход.«почему»)] по "")

тотальная функция «Мера»
  принимает исходы: список «Исход»
  возвращает строка
  разбор («Сошедшиеся» от исходы)
    случай пусто
      то "ПЛАНИРОВЩИК: НЕ ИЗМЕРЕНО — ни одна цель не сошлась со свидетелем"
    случай голова и хвост
      то соединить ["ПЛАНИРОВЩИК РЕШАЕТ КАК СВИДЕТЕЛЬ flang/conc/scheduler.js НА ", (к строке (длина («Сошедшиеся» от исходы))), " ЦЕЛЯХ ИЗ ", (к строке (длина («Цели»))), ": ", (соединить («Сошедшиеся» от исходы) по ", "), "; вопросов на цель ", (к строке (длина («Все вопросы»))), "; сверок всего ", (к строке ((длина («Все вопросы»)) умножить на (длина («Сошедшиеся» от исходы)))), ", расхождений 0"] по ""

тотальная функция «Итог»
  принимает исходы: список «Исход»
  возвращает «Продолжение»
  разбор («Беды» от исходы)
    случай пусто
      то вариант «Конец работы» с значение равным («Мера» от исходы)
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_PLANIROVSHCHIK_CELI_NE_SOSHLIS" и сообщение равным (соединить (приписать («Мера» от исходы) к (приписать (соединить ["не сошлось ", (к строке (длина («Беды» от исходы))), " из ", (к строке (длина («Цели»))), ":"] по "") к («Беды» от исходы))) по "\n  • ")

тип «Ход»
  вариант «Заводим корень»
  вариант «Пишем вопросы»
  вариант «Ждём запись»
  вариант «Ждём свидетеля»
  вариант «Читаем свидетеля»
  вариант «Ждём цель» содержит осталось: список «Цель», эталон: строка, исходы: список «Исход»
  вариант «Читаем цель» содержит осталось: список «Цель», эталон: строка, исходы: список «Исход»

тотальная функция «Начать»
  возвращает «Ход»
  вариант «Заводим корень»

тотальная функция «Следующая»
  принимает осталось: список «Цель», эталон: строка, исходы: список «Исход»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то «Итог» от исходы
    случай голова и хвост
      то вариант «Сделать» с поручение равным («Поручение цели» от голова) и потом равным (вариант «Ждём цель» с осталось равным осталось и эталон равным эталон и исходы равным исходы)

тотальная функция «После свидетеля»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пусть вывод равно («Содержимое» от отклик)
  пусть беда равно («Беда свидетеля» от вывод и (длина («Все вопросы»)))
  если беда равна ""
    то «Следующая» от («Цели») и вывод и []
    иначе вариант «Провал» с код равным "FLANG_SCHEDULER_WITNESS_FAILED" и сообщение равным беда

тотальная функция «Читать ответы цели»
  принимает осталось: список «Цель», эталон: строка, исходы: список «Исход»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали прогон цели, а список целей уже пуст"
    случай голова и хвост
      то вариант «Сделать» с поручение равным («Поручение чтения ответов» от (голова.«имя»)) и потом равным (вариант «Читаем цель» с осталось равным осталось и эталон равным эталон и исходы равным исходы)

тотальная функция «После цели»
  принимает осталось: список «Цель», эталон: строка, исходы: список «Исход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответы цели, а список целей уже пуст"
    случай голова и хвост
      то пусть исход равно («Судить» от (голова.«имя») и («Содержимое» от отклик) и эталон)
      «Следующая» от хвост и эталон и (добавить исход к исходы)

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Заводим корень»
      то вариант «Сделать» с поручение равным («Поручение заведения корня») и потом равным (вариант «Пишем вопросы»)
    случай вариант «Пишем вопросы»
      то вариант «Сделать» с поручение равным («Поручение записи вопросов») и потом равным (вариант «Ждём запись»)
    случай вариант «Ждём запись»
      то вариант «Сделать» с поручение равным («Поручение свидетеля») и потом равным (вариант «Ждём свидетеля»)
    случай вариант «Ждём свидетеля»
      то вариант «Сделать» с поручение равным («Поручение чтения ответов» от "witness") и потом равным (вариант «Читаем свидетеля»)
    случай вариант «Читаем свидетеля»
      то «После свидетеля» от отклик
    случай вариант «Ждём цель» с осталось как осталось и эталон как эталон и исходы как исходы
      то «Читать ответы цели» от осталось и эталон и исходы
    случай вариант «Читаем цель» с осталось как осталось и эталон как эталон и исходы как исходы
      то «После цели» от осталось и эталон и исходы и отклик

план «Планировщик узла решает как свидетель на целях печати»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
