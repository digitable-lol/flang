модуль «Надзор на целях»

объект «Цель»
  «имя»: строка
  «хозяин»: строка
  «куда»: строка
  «рядом»: строка
  «сборка»: строка
  «запуск»: строка

объект «Исход»
  «имя»: строка
  «сошлось»: признак
  «почему»: строка

тотальная функция «Опора»
  возвращает «Цель»
  обеспечивает «имя опоры — python» (результат.«имя») равен "python"
  запись «Цель» с «имя» равным "python" и «хозяин» равным "node.py" и «куда» равным "." и «рядом» равным "true" и «сборка» равным "true" и «запуск» равным "python3 -B node.py"

тотальная функция «Остальные цели»
  возвращает список «Цель»
  [запись «Цель» с «имя» равным "go" и «хозяин» равным "node.go" и «куда» равным "node" и «рядом» равным "true" и «сборка» равным "go build -o flang_node ./node" и «запуск» равным "./flang_node",
   запись «Цель» с «имя» равным "csharp" и «хозяин» равным "node.cs" и «куда» равным "." и «рядом» равным "true" и «сборка» равным "dotnet build -v quiet --nologo -p:StartupObject=HozyainUzla" и «запуск» равным "dotnet $(ls bin/*/*/flang.dll | head -1)",
   запись «Цель» с «имя» равным "elixir" и «хозяин» равным "node.ex" и «куда» равным "." и «рядом» равным "true" и «сборка» равным "elixirc --warnings-as-errors -o _build flang_runtime.ex uzel_zamera.ex flang_cli.ex node.ex" и «запуск» равным "elixir -pa _build -e 'HozyainUzla.main(System.argv())' --",
   запись «Цель» с «имя» равным "js" и «хозяин» равным "node.js" и «куда» равным "." и «рядом» равным "printf '%s' '{\"type\":\"module\"}' > \"$d/cel/package.json\"" и «сборка» равным "true" и «запуск» равным "node node.js",
   запись «Цель» с «имя» равным "rust" и «хозяин» равным "node.rs" и «куда» равным "src/bin" и «рядом» равным "true" и «сборка» равным "RUSTFLAGS='-D warnings' cargo build --offline" и «запуск» равным "./target/debug/node",
   запись «Цель» с «имя» равным "java" и «хозяин» равным "node.java" и «куда» равным "." и «рядом» равным "true" и «сборка» равным "make build" и «запуск» равным "java -cp . HozyainUzla",
   запись «Цель» с «имя» равным "c" и «хозяин» равным "node.c" и «куда» равным "." и «рядом» равным "printf '%s' 'include Makefile\n\nflang_node: node.o $(OBJECTS)\n\t$(CC) $(CFLAGS) -o $@ node.o $(OBJECTS) $(LDLIBS)\n' > \"$d/cel/node.mk\"" и «сборка» равным "make -f node.mk flang_node" и «запуск» равным "./flang_node",
   запись «Цель» с «имя» равным "cpp" и «хозяин» равным "node.c" и «куда» равным "." и «рядом» равным "printf '%s' 'include Makefile\n\nnode.o: node.c\n\t$(CXX) $(CXXFLAGS) -x c++ -DZAGOLOVOK_MODULYA=\\\"uzel_zamera.hpp\\\" -DCEL=\\\"cpp\\\" -c -o $@ node.c\n\nflang_node: node.o $(OBJECTS)\n\t$(CXX) $(CXXFLAGS) -o $@ node.o $(OBJECTS) $(LDLIBS)\n' > \"$d/cel/node.mk\"" и «сборка» равным "make -f node.mk flang_node" и «запуск» равным "./flang_node"]

тотальная функция «Цели»
  возвращает список «Цель»
  обеспечивает «девять целей» (длина результат) равен 9
  приписать («Опора») к («Остальные цели»)

тотальная функция «Корень работы»
  возвращает строка
  "tmp/nadzor-na-celyah"

тотальная функция «Процессы JSON»
  возвращает строка
  "[{\"имя\":\"Счётчик\",\"начальное\":\"Начальный счёт\",\"обработчик\":\"Обработчик счёта\",\"ящик\":null},{\"имя\":\"Учётчик\",\"начальное\":\"Начальные записи\",\"обработчик\":\"Обработчик учёта\",\"ящик\":null}]"

тотальная функция «План с надзором»
  возвращает строка
  соединить ["{\"процессы\":", («Процессы JSON»), ",\"надзоры\":[{\"имя\":\"Цех\",\"порог\":1,\"окно\":5000,\"иначе\":\"передать выше\",\"процессы\":[{\"кто\":\"Счётчик\",\"стратегия\":\"перезапустить\"}],\"надзоры\":[]}]}"] по ""

тотальная функция «План без надзора»
  возвращает строка
  соединить ["{\"процессы\":", («Процессы JSON»), "}"] по ""

тотальная функция «План с порогом ноль»
  возвращает строка
  соединить ["{\"процессы\":", («Процессы JSON»), ",\"надзоры\":[{\"имя\":\"Цех\",\"порог\":0,\"окно\":5000,\"иначе\":\"передать выше\",\"процессы\":[{\"кто\":\"Счётчик\",\"стратегия\":\"перезапустить\"}],\"надзоры\":[]}]}"] по ""

тотальная функция «Вброс»
  возвращает строка
  "[{\"кому\":\"Счётчик\",\"что\":[\"в\",\"замерить\",{\"сколько\":[\"ч\",2]}]},{\"кому\":\"Счётчик\",\"что\":[\"в\",\"записать\",{\"текст\":[\"с\",\"не тому\"]}]},{\"кому\":\"Счётчик\",\"что\":[\"в\",\"замерить\",{\"сколько\":[\"ч\",3]}]}]"

тотальная функция «Файл плана по номеру»
  принимает номер: число
  возвращает строка
  пример «первый сценарий — с надзором»
    дано номер равно 1
    ожидается "plan.json"
  пример «второй сценарий — без надзора»
    дано номер равно 2
    ожидается "plan-bez.json"
  пример «третий сценарий — порог ноль»
    дано номер равно 3
    ожидается "plan-porog.json"
  если номер равен 1
    то "plan.json"
    иначе если номер равен 2
      то "plan-bez.json"
      иначе "plan-porog.json"

тотальная функция «Команда сборки»
  принимает цель: «Цель»
  возвращает строка
  соединить [
    "cd ../.. && d=\"$PWD/", («Корень работы»), "/uzel-", (цель.«имя»), "\"",
    " && rm -rf \"$d\" && mkdir -p \"$d/cel/", (цель.«куда»), "\" \"$d/opora\"",
    " && bootstrap/flang emit flang/conc/examples/distributed.flang --target js --out \"$d/prog\" >/dev/null 2>&1;",
    " h=$(cat $(ls \"$d\"/prog/*.js | grep -v flang_cli) | sha256sum | cut -c1-64); printf '%s' \"$h\" > \"$d/hash.txt\";",
    " bootstrap/flang emit flang/conc/node-benchmark.flang --target ", (цель.«имя»), " --out \"$d/cel\" >&2;",
    " bootstrap/flang emit flang/conc/node-benchmark.flang --target python --out \"$d/opora\" >&2;",
    " cp flang/conc/bin/", (цель.«хозяин»), " \"$d/cel/", (цель.«куда»), "/\";",
    " cp flang/conc/bin/node.py \"$d/opora/\";",
    " ", (цель.«рядом»), ";",
    " printf '%s' '", («План с надзором»), "' > \"$d/cel/plan.json\";",
    " printf '%s' '", («План с надзором»), "' > \"$d/opora/plan.json\";",
    " printf '%s' '", («План без надзора»), "' > \"$d/cel/plan-bez.json\";",
    " printf '%s' '", («План без надзора»), "' > \"$d/opora/plan-bez.json\";",
    " printf '%s' '", («План с порогом ноль»), "' > \"$d/cel/plan-porog.json\";",
    " printf '%s' '", («План с порогом ноль»), "' > \"$d/opora/plan-porog.json\";",
    " (cd \"$d/cel\" && ", (цель.«сборка»), ") >&2;",
    " echo СОБРАНО"
  ] по ""

тотальная функция «Команда сценария»
  принимает цель: «Цель», номер: число
  возвращает строка
  соединить [
    "cd ../.. && d=\"$PWD/", («Корень работы»), "/uzel-", (цель.«имя»), "\"",
    " && h=$(cat \"$d/hash.txt\") && planfile=", («Файл плана по номеру» от номер), ";",
    " rm -f \"$d/opora.log\" \"$d/cel.log\" \"$d/err\";",
    " (cd \"$d/opora\" && LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8 python3 -B node.py --я учёт --слушать 127.0.0.1:0 --хэш \"$h\" --план-файл \"$planfile\" --размещение '{\"Счётчик\":\"счёт\",\"Учётчик\":\"учёт\"}' --срок 2000 --пульс 200 --жить 9 >\"$d/opora.log\" 2>>\"$d/err\") &",
    " i=0; p=\"\"; while [ $i -lt 300 ]; do p=$(sed -n 's/.*\"поднят\".*\"порт\": *\\([0-9]*\\).*/\\1/p' \"$d/opora.log\" 2>/dev/null); [ -n \"$p\" ] && break; i=$((i+1)); sleep 0.1; done;",
    " t0=$(date +%s%N);",
    " (cd \"$d/cel\" && LC_ALL=C.UTF-8 ", (цель.«запуск»), " --я счёт --слушать 127.0.0.1:0 --хэш \"$h\" --план-файл \"$planfile\" --размещение '{\"Счётчик\":\"счёт\",\"Учётчик\":\"учёт\",\"звонить\":{\"учёт\":\"127.0.0.1:'$p'\"}}' --вбросить '", («Вброс»), "' --срок 2000 --пульс 200 --жить 6 >\"$d/cel.log\" 2>>\"$d/err\");",
    " t1=$(date +%s%N);",
    " wait;",
    " cat \"$d/cel.log\" \"$d/opora.log\" 2>/dev/null;",
    " echo '{\"измерено\":\"прожил\",\"мс\":'$(( (t1 - t0) / 1000000 ))'}';",
    " cat \"$d/err\" >&2 2>/dev/null"
  ] по ""

тотальная функция «Поручение сборки»
  принимает цель: «Цель»
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда сборки» от цель)]

тотальная функция «Поручение сценария»
  принимает цель: «Цель», номер: число
  возвращает «Поручение»
  вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда сценария» от цель и номер)]

тотальная функция «Вывод процесса»
  принимает отклик: «Отклик»
  возвращает строка
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то вывод
    случай любое
      то ""

тотальная функция «Без пробелов»
  принимает текст: строка
  возвращает строка
  пример «Пробелы python убраны»
    дано текст равно "{\"в\": \"конец\", \"узел\": \"учёт\"}"
    ожидается "{\"в\":\"конец\",\"узел\":\"учёт\"}"
  пример «Там, где их не было, ничего не меняется»
    дано текст равно "{\"в\":\"конец\"}"
    ожидается "{\"в\":\"конец\"}"
  соединить (разделить текст по " ") по ""

тотальная функция «Все внутри»
  принимает строчка: строка, куски: список строки
  возвращает признак
  пример «Порядок кусков значения не имеет»
    дано строчка равно "{\"б\":2,\"а\":1}"
    дано куски равно ["\"а\":1", "\"б\":2"]
    ожидается да
  пример «Нет одного куска — нет и строки»
    дано строчка равно "{\"а\":1}"
    дано куски равно ["\"а\":1", "\"б\":2"]
    ожидается нет
  (длина (отфильтровать куски где кусок → не (строчка содержит кусок))) равен 0

тотальная функция «Есть строка со всеми»
  принимает журналы: строка, куски: список строки
  возвращает признак
  пример «Куски одной строки — да, куски разных строк — нет»
    дано журналы равно "{\"а\":1}\n{\"б\":2}"
    дано куски равно ["\"а\":1"]
    ожидается да
  пример «Разнесённые по разным строкам куски строкой не считаются»
    дано журналы равно "{\"а\":1}\n{\"б\":2}"
    дано куски равно ["\"а\":1", "\"б\":2"]
    ожидается нет
  (длина (отфильтровать (разделить журналы по "\n") где строчка → («Все внутри» от строчка и куски))) больше 0

тотальная функция «Один из вариантов внутри»
  принимает строчка: строка, варианты: список строки
  возвращает признак
  пример «Годится любой из двух»
    дано строчка равно "{\"всего\":[\"ч\",3.0]}"
    дано варианты равно ["\"всего\":[\"ч\",3]", "\"всего\":[\"ч\",3.0]"]
    ожидается да
  пример «Не годится ни один»
    дано строчка равно "{\"всего\":[\"ч\",4]}"
    дано варианты равно ["\"всего\":[\"ч\",3]", "\"всего\":[\"ч\",3.0]"]
    ожидается нет
  (длина (отфильтровать варианты где форма → (строчка содержит форма))) больше 0

тотальная функция «Все наборы внутри»
  принимает строчка: строка, наборы: список (список строки)
  возвращает признак
  (длина (отфильтровать наборы где набор → не («Один из вариантов внутри» от строчка и набор))) равен 0

тотальная функция «Есть строка со всеми наборами»
  принимает журналы: строка, наборы: список (список строки)
  возвращает признак
  пример «Каждый набор нашёл свою альтернативу в одной строке»
    дано журналы равно "{\"а\":1,\"всего\":[\"ч\",3.0]}"
    дано наборы равно [["\"а\":1"], ["\"всего\":[\"ч\",3]", "\"всего\":[\"ч\",3.0]"]]
    ожидается да
  (длина (отфильтровать (разделить журналы по "\n") где строчка → («Все наборы внутри» от строчка и наборы))) больше 0

тотальная функция «Оба вида целого поля»
  принимает метка: строка, целое: строка
  возвращает список строки
  пример «Ноль»
    дано метка равно "всего"
    дано целое равно "3"
    ожидается ["\"всего\":[\"ч\",3]", "\"всего\":[\"ч\",3.0]"]
  [(соединить ["\"", метка, "\":[\"ч\",", целое, "]"] по ""), (соединить ["\"", метка, "\":[\"ч\",", целое, ".0]"] по "")]

тотальная функция «Один вид»
  принимает кусок: строка
  возвращает список строки
  [кусок]

тотальная функция «Нет ни одной строки с»
  принимает журналы: строка, кусок: строка
  возвращает признак
  пример «Кусок нигде не встретился»
    дано журналы равно "{\"а\":1}\n{\"б\":2}"
    дано кусок равно "\"в\":3"
    ожидается да
  пример «Кусок нашёлся — значит неверно»
    дано журналы равно "{\"а\":1}"
    дано кусок равно "\"а\":1"
    ожидается нет
  (длина (отфильтровать (разделить журналы по "\n") где строчка → (строчка содержит кусок))) равен 0

тотальная функция «До метки»
  принимает текст: строка, метка: строка
  возвращает строка
  пример «До первой метки»
    дано текст равно "раз|два"
    дано метка равно "|"
    ожидается "раз"
  голова (разделить текст по метка)

тотальная функция «После метки»
  принимает текст: строка, метка: строка
  возвращает строка
  пример «После первой метки»
    дано текст равно "раз|два|три"
    дано метка равно "|"
    ожидается "два"
  пример «Метки нет — пусто»
    дано текст равно "раз"
    дано метка равно "|"
    ожидается ""
  пусть куски равно (разделить текст по метка)
  если (длина куски) не меньше 2
    то элемент 2 в куски
    иначе ""

тотальная функция «Цифра знака»
  принимает знак: строка
  возвращает число
  пример «Ноль»
    дано знак равно "0"
    ожидается 0
  пример «Девять»
    дано знак равно "9"
    ожидается 9
  пример «Не цифра — ноль»
    дано знак равно "x"
    ожидается 0
  если ((код символа знак) не меньше 48) и притом ((код символа знак) не больше 57)
    то (код символа знак) минус 48
    иначе 0

тотальная функция «Число из текста»
  принимает текст: строка
  возвращает число
  пример «Четыре тысячи девяносто шесть»
    дано текст равно "4096"
    ожидается 4096
  пример «Пусто — ноль»
    дано текст равно ""
    ожидается 0
  свёртка (разложить текст на символы) начиная с 0 как акк и знак → (акк умножить на 10) плюс («Цифра знака» от знак)

тотальная функция «Прожил мс»
  принимает журналы: строка
  возвращает число
  «Число из текста» от («До метки» от («После метки» от журналы и "\"мс\":") и "}")

тотальная функция «Слить»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Порядок бед сохраняется»
    дано первые равно ["раз"]
    дано вторые равно ["два"]
    ожидается ["раз", "два"]
  свёртка вторые начиная с первые как акк и строчка
    добавить строчка к акк

тотальная функция «Беда, если не сошлось»
  принимает журналы: строка, наборы: список (список строки), беда: строка
  возвращает список строки
  если («Есть строка со всеми наборами» от журналы и наборы)
    то пустой список
    иначе [беда]

тотальная функция «Беда, если нашлась строка с»
  принимает журналы: строка, кусок: строка, беда: строка
  возвращает список строки
  если («Нет ни одной строки с» от журналы и кусок)
    то пустой список
    иначе [беда]

тотальная функция «Беда, если не уложился в срок»
  принимает журналы: строка, потолок: число, беда: строка
  возвращает список строки
  если («Прожил мс» от журналы) меньше потолок
    то пустой список
    иначе [беда]

тотальная функция «Беды сценария 1»
  принимает журналы: строка
  возвращает список строки
  пусть решено равно («Беда, если не сошлось» от журналы и [(«Один вид» от "\"в\":\"надзор\""), («Один вид» от "\"узел\":\"счёт\""), («Один вид» от "\"что\":\"решено\""), («Один вид» от "\"надзор\":\"Цех\""), («Один вид» от "\"стратегия\":\"перезапустить\"")] и "надзор не решил «перезапустить» для «Цеха»")
  пусть поднят равно («Беда, если не сошлось» от журналы и [(«Один вид» от "\"в\":\"надзор\""), («Один вид» от "\"узел\":\"счёт\""), («Один вид» от "\"что\":\"поднят\""), («Один вид» от "\"кто\":\"Счётчик\"")] и "надзор не поднял «Счётчика»")
  пусть счётЦели равно («Беда, если не сошлось» от журналы и [(«Один вид» от "\"в\":\"конец\""), («Один вид» от "\"узел\":\"счёт\""), («Оба вида целого поля» от "всего" и "3"), («Оба вида целого поля» от "подтверждено" и "2")] и "после подъёма «Счётчик» не досчитал ровно до 3 при 2 подтверждённых")
  пусть письмоОпоре равно («Беда, если не сошлось» от журналы и [(«Один вид» от "\"в\":\"конец\""), («Один вид» от "\"узел\":\"учёт\""), («Один вид» от "\"строки\":[\"л\",[[\"с\",\"2\"],[\"с\",\"3\"]]]")] и "письмо, лежавшее в ящике мёртвого процесса, не доехало до опоры")
  «Слить» от («Слить» от («Слить» от решено и поднят) и счётЦели) и письмоОпоре

тотальная функция «Беды сценария 2»
  принимает журналы: строка
  возвращает список строки
  пусть счётЦели равно («Беда, если не сошлось» от журналы и [(«Один вид» от "\"в\":\"конец\""), («Один вид» от "\"узел\":\"счёт\""), («Оба вида целого поля» от "всего" и "2"), («Оба вида целого поля» от "подтверждено" и "0")] и "без объявленного надзора «Счётчик» не должен был подняться")
  пусть письмоОпоре равно («Беда, если не сошлось» от журналы и [(«Один вид» от "\"в\":\"конец\""), («Один вид» от "\"узел\":\"учёт\""), («Один вид» от "\"строки\":[\"л\",[[\"с\",\"2\"]]]")] и "без надзора третье письмо не должно было доехать")
  пусть безНадзора равно («Беда, если нашлась строка с» от журналы и "\"в\":\"надзор\"" и "без объявленного надзора не должно быть ни одной записи о надзоре")
  «Слить» от («Слить» от счётЦели и письмоОпоре) и безНадзора

тотальная функция «Беды сценария 3»
  принимает журналы: строка
  возвращает список строки
  пусть решеноВыше равно («Беда, если не сошлось» от журналы и [(«Один вид» от "\"в\":\"надзор\""), («Один вид» от "\"узел\":\"счёт\""), («Один вид» от "\"что\":\"решено\""), («Один вид» от "\"стратегия\":\"передатьвыше\"")] и "порог 0 обязан был уйти на запасную стратегию «передать выше»")
  пусть некому равно («Беда, если не сошлось» от журналы и [(«Один вид» от "\"в\":\"надзор\""), («Один вид» от "\"узел\":\"счёт\""), («Один вид» от "\"что\":\"некому\"")] и "над «Цехом» надзора нет — обязано быть «некому»")
  пусть срокНеВышел равно («Беда, если не уложился в срок» от журналы и 5000 и (соединить ["узел не остановился вовремя: прожил ", (к строке («Прожил мс» от журналы)), " мс из 6000, а порог исчерпан ждать не должен"] по ""))
  «Слить» от («Слить» от решеноВыше и некому) и срокНеВышел

тотальная функция «Судить цель»
  принимает имя: строка, отчёт1: строка, отчёт2: строка, отчёт3: строка
  возвращает «Исход»
  пусть беды1 равно («Беды сценария 1» от («Без пробелов» от отчёт1))
  пусть беды2 равно («Беды сценария 2» от («Без пробелов» от отчёт2))
  пусть беды3 равно («Беды сценария 3» от («Без пробелов» от отчёт3))
  пусть беды равно («Слить» от («Слить» от беды1 и беды2) и беды3)
  разбор беды
    случай пусто
      то запись «Исход» с «имя» равным имя и «сошлось» равным да и «почему» равным ""
    случай голова и хвост
      то запись «Исход» с «имя» равным имя и «сошлось» равным нет и «почему» равным (соединить беды по "; ")

тотальная функция «Сошедшиеся»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → (исход.«сошлось»)) как исход → (исход.«имя»)

тотальная функция «Беды всех»
  принимает исходы: список «Исход»
  возвращает список строки
  отобразить (отфильтровать исходы где исход → не (исход.«сошлось»)) как исход → (соединить [(исход.«имя»), ": ", (исход.«почему»)] по "")

тотальная функция «Мера»
  принимает исходы: список «Исход»
  возвращает строка
  разбор («Сошедшиеся» от исходы)
    случай пусто
      то "НАДЗОР: НЕ ИЗМЕРЕНО — ни одна цель не прошла"
    случай голова и хвост
      то соединить ["НАДЗОР РАБОТАЕТ НА ", (к строке (длина («Сошедшиеся» от исходы))), " ЦЕЛЯХ ИЗ 9: ", (соединить («Сошедшиеся» от исходы) по ", ")] по ""

тотальная функция «Итог»
  принимает исходы: список «Исход»
  возвращает «Продолжение»
  разбор («Беды всех» от исходы)
    случай пусто
      то вариант «Конец работы» с значение равным («Мера» от исходы)
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_NADZOR_PARA_NE_SOSHLAS" и сообщение равным (соединить (приписать («Мера» от исходы) к (приписать (соединить ["не сошлось ", (к строке (длина («Беды всех» от исходы))), " из 8:"] по "") к («Беды всех» от исходы))) по "\n  • ")

тип «Ход»
  вариант «Ждём сборку» содержит осталось: список «Цель», сделано: список «Исход»
  вариант «Ждём сценарий» содержит осталось: список «Цель», сделано: список «Исход», номер: число, отчёты: список строки

тотальная функция «Начать»
  возвращает «Ход»
  вариант «Ждём сборку» с осталось равным («Цели») и сделано равным []

тотальная функция «После сборки»
  принимает осталось: список «Цель», сделано: список «Исход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали цель для сборки, а список целей уже пуст"
    случай голова и хвост
      то вариант «Сделать» с поручение равным («Поручение сборки» от голова) и потом равным (вариант «Ждём сценарий» с осталось равным осталось и сделано равным сделано и номер равным 0 и отчёты равным [])

тотальная функция «После сценария»
  принимает осталось: список «Цель», сделано: список «Исход», номер: число, отчёты: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали отклик сценария, а список целей уже пуст"
    случай голова и хвост
      то если номер равен 0
           то вариант «Сделать» с поручение равным («Поручение сценария» от голова и 1) и потом равным (вариант «Ждём сценарий» с осталось равным осталось и сделано равным сделано и номер равным 1 и отчёты равным [])
           иначе «После отчёта» от голова и сделано и хвост и номер и (добавить («Вывод процесса» от отклик) к отчёты)

тотальная функция «После отчёта»
  принимает текущая: «Цель», сделано: список «Исход», хвост: список «Цель», номер: число, отчёты: список строки
  возвращает «Продолжение»
  если номер не меньше 3
    то «После цели» от хвост и (добавить («Судить цель» от (текущая.«имя») и (элемент 1 в отчёты) и (элемент 2 в отчёты) и (элемент 3 в отчёты)) к сделано)
    иначе вариант «Сделать» с поручение равным («Поручение сценария» от текущая и (номер плюс 1)) и потом равным (вариант «Ждём сценарий» с осталось равным (приписать текущая к хвост) и сделано равным сделано и номер равным (номер плюс 1) и отчёты равным отчёты)

тотальная функция «После цели»
  принимает осталось: список «Цель», сделано: список «Исход»
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то «Итог» от сделано
    случай голова и хвост
      то вариант «Сделать» с поручение равным («Поручение сборки» от голова) и потом равным (вариант «Ждём сборку» с осталось равным осталось и сделано равным сделано)

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём сборку» с осталось как осталось и сделано как сделано
      то «После сборки» от осталось и сделано и отклик
    случай вариант «Ждём сценарий» с осталось как осталось и сделано как сделано и номер как номер и отчёты как отчёты
      то «После сценария» от осталось и сделано и номер и отчёты и отклик

план «Надзор поднимает упавший процесс на девяти целях»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
