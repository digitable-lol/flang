модуль «Сторож слов»
  использует «Двоичный» из "./binary.flang"
  использует «JSON»
  использует «UTF-8» из "../stdlib/utf8.flang"
  использует «SHA-256»
  использует «Tree map»
  использует «Lists»
  использует «Strings»

тотальная функция «От корня»
  принимает путь: строка
  возвращает строка
  пример «Путь каталога подделок — от корня дерева»
    дано путь равно "flang/test/fixtures/poddelka-slovo-o-dokazannosti.flang"
    ожидается "../../flang/test/fixtures/poddelka-slovo-o-dokazannosti.flang"
  соединить [(«Корень»), "/", путь] по ""

тотальная функция «Путь каталога слов»
  возвращает строка
  пример «Каталог лежит рядом со сторожем»
    ожидается "proof-words.json"
  "proof-words.json"

тотальная функция «Путь каталога подделок ядра»
  возвращает строка
  пример «Каталог подделок ядра лежит рядом со сторожем»
    ожидается "kernel-forgeries.flang"
  "kernel-forgeries.flang"

тотальная функция «Имя каталога подделок ядра»
  возвращает строка
  пример «Каталог подделок ядра назван путём от корня»
    ожидается "flang/scripts/kernel-forgeries.flang"
  "flang/scripts/kernel-forgeries.flang"

тотальная функция «Каталог фикстур»
  возвращает строка
  пример «Фикстуры на два шага выше сторожа»
    ожидается "../test/fixtures"
  "../test/fixtures"

тотальная функция «Пробельный знак»
  принимает знак: строка
  возвращает признак
  пример «Табуляция пробельная»
    дано знак равно "\t"
    ожидается да
  пример «Буква не пробельная»
    дано знак равно "а"
    ожидается нет
  (знак равен " ") или ((знак равен "\t") или ((знак равен "\n") или ((знак равен "\r") или ((знак равен "\u000B") или ((знак равен "\u000C") или (знак равен "\u00A0"))))))

объект «Обрезка»
  «началось»: признак
  «собрано»: строка

тотальная функция «Шаг снятия пробельных»
  принимает ход: «Обрезка», знак: строка
  возвращает «Обрезка»
  если (ход.«началось») или (не («Пробельный знак» от знак))
    то запись «Обрезка» с «началось» равным да и «собрано» равным (соединить [(ход.«собрано»), знак] по "")
    иначе ход

тотальная функция «Снять пробельные слева»
  принимает текст: строка
  возвращает строка
  пример «Пробелы и переводы строки слева сняты»
    дано текст равно " \n а б"
    ожидается "а б"
  пусть итог равно (свёртка (разложить текст на символы) начиная с (запись «Обрезка» с «началось» равным нет и «собрано» равным "") как ход и знак → «Шаг снятия пробельных» от ход и знак)
  итог.«собрано»

тотальная функция «Обрезать края»
  принимает текст: строка
  возвращает строка
  пример «Края сняты так же, как у trim в JavaScript»
    дано текст равно "  отказ\n"
    ожидается "отказ"
  «Обратить строку» от («Снять пробельные слева» от («Обратить строку» от («Снять пробельные слева» от текст)))

тотальная функция «Пустая строка ли»
  принимает строка: строка
  возвращает признак
  пример «Одни пробелы — пустая»
    дано строка равно "  \t"
    ожидается да
  пример «С буквой — не пустая»
    дано строка равно "  а"
    ожидается нет
  («Снять пробельные слева» от строка) равен ""

тотальная функция «Начало текста»
  принимает текст: строка, сколько: число
  возвращает строка
  пример «Короткий текст целиком»
    дано текст равно "аб"
    дано сколько равно 40
    ожидается "аб"
  пример «Длинный обрезан»
    дано текст равно "абвг"
    дано сколько равно 2
    ожидается "аб"
  если (длина текст) не больше сколько
    то текст
    иначе подстрока текст с 1 по сколько

тотальная функция «Хвост после»
  принимает текст: строка, сколько: число
  возвращает строка
  пример «Отброшены первые знаки»
    дано текст равно "абвг"
    дано сколько равно 1
    ожидается "бвг"
  пример «Отброшено всё»
    дано текст равно "аб"
    дано сколько равно 5
    ожидается ""
  если (длина текст) не больше сколько
    то ""
    иначе подстрока текст с (сколько плюс 1) по (длина текст)

тотальная функция «Заменить первое»
  принимает текст: строка, что: строка, чем: строка
  возвращает строка
  пример «Только первое вхождение»
    дано текст равно "а-б-в"
    дано что равно "-"
    дано чем равно "+"
    ожидается "а+б-в"
  пример «Нечего заменять»
    дано текст равно "абв"
    дано что равно "-"
    дано чем равно "+"
    ожидается "абв"
  пусть куски равно (разделить текст по что)
  если (длина куски) не больше 1
    то текст
    иначе соединить [(голова куски), чем, (соединить («Отбросить первые» от куски и 1) по что)] по ""

тотальная функция «После первого»
  принимает текст: строка, метка: строка
  возвращает строка
  пример «Всё, что после первой метки»
    дано текст равно "а)б)в"
    дано метка равно ")"
    ожидается "б)в"
  соединить («Отбросить первые» от (разделить текст по метка) и 1) по метка

тотальная функция «Последний кусок»
  принимает текст: строка, метка: строка
  возвращает строка
  пример «Имя файла — последний кусок пути»
    дано текст равно "flang/test/fixtures/poddelka-x.flang"
    дано метка равно "/"
    ожидается "poddelka-x.flang"
  свёртка (разделить текст по метка) начиная с "" как прежний и кусок → кусок

объект «Ход ведущих цифр»
  «стоп»: признак
  «вывод»: строка

тотальная функция «Шаг ведущих цифр»
  принимает ход: «Ход ведущих цифр», знак: строка
  возвращает «Ход ведущих цифр»
  если (ход.«стоп») или (не ("0123456789" содержит знак))
    то запись «Ход ведущих цифр» с «стоп» равным да и «вывод» равным (ход.«вывод»)
    иначе запись «Ход ведущих цифр» с «стоп» равным нет и «вывод» равным (соединить [(ход.«вывод»), знак] по "")

тотальная функция «Ведущие цифры»
  принимает текст: строка
  возвращает строка
  пример «Цифры до первого нецифрового знака»
    дано текст равно "12, сетка"
    ожидается "12"
  пример «Цифр нет — пусто»
    дано текст равно "а1"
    ожидается ""
  пусть итог равно (свёртка (разложить текст на символы) начиная с (запись «Ход ведущих цифр» с «стоп» равным нет и «вывод» равным "") как ход и знак → «Шаг ведущих цифр» от ход и знак)
  итог.«вывод»

тотальная функция «После цифр»
  принимает текст: строка
  возвращает строка
  пример «Хвост за числом»
    дано текст равно "12: доказано"
    ожидается ": доказано"
  «Хвост после» от текст и (длина («Ведущие цифры» от текст))

тотальная функция «Слить строки»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Порядок сохраняется»
    дано первые равно ["а"]
    дано вторые равно ["б"]
    ожидается ["а", "б"]
  свёртка вторые начиная с первые как собрано и строка
    добавить строка к собрано

тотальная функция «С приставкой»
  принимает приставка: строка, строки: список строки
  возвращает список строки
  пример «Каждой строке — имя файла впереди»
    дано приставка равно "ф: "
    дано строки равно ["беда"]
    ожидается ["ф: беда"]
  отобразить строки как строка → (соединить [приставка, строка] по "")

тотальная функция «Строки с переводом»
  принимает строки: список строки, отступ: строка
  возвращает строка
  пример «Каждая строка кончается переводом»
    дано строки равно ["а", "б"]
    дано отступ равно "  "
    ожидается "  а\n  б\n"
  соединить (отобразить строки как строка → (соединить [отступ, строка, "\n"] по "")) по ""

тотальная функция «Вставить строку по порядку»
  принимает строка: строка, упорядочено: список строки
  возвращает список строки
  разбор упорядочено
    случай пусто
      то [строка]
    случай голова и хвост
      то если «Строка раньше» от строка и голова
        то приписать строка к упорядочено
        иначе приписать голова к («Вставить строку по порядку» от строка и хвост)

тотальная функция «Упорядочить строки»
  принимает строки: список строки
  возвращает список строки
  пример «По кодовым точкам, как sort у JavaScript»
    дано строки равно ["poddelka-b.flang", "poddelka-a.flang"]
    ожидается ["poddelka-a.flang", "poddelka-b.flang"]
  свёртка строки начиная с (пустой список) как упорядочено и строка → «Вставить строку по порядку» от строка и упорядочено

тотальная функция «Число узла»
  принимает значение: «Значение json»
  возвращает число
  пример «Число берётся из Число json»
    дано значение равно вариант «Число json» с величина равным 4
    ожидается 4
  пример «Не число — ноль»
    дано значение равно вариант «Ничто json»
    ожидается 0
  разбор значение
    случай вариант «Число json» с величина как величина
      то величина
    случай любое
      то 0

тотальная функция «Есть поле»
  принимает узел: «Значение json», имя: строка
  возвращает признак
  пример «Поле названо»
    дано узел равно вариант «Объект json» с состав равным [вариант «Поле json» с имя равным "proved" и содержимое равным (вариант «Ничто json»)]
    дано имя равно "proved"
    ожидается да
  пример «Поля нет»
    дано узел равно вариант «Объект json» с состав равным пустой список
    дано имя равно "proved"
    ожидается нет
  свёртка («Состав объекта» от узел) начиная с нет как найдено и пара → найдено или ((«Имя поля json» от пара) равен имя)

объект «Запись словаря»
  «вердикт»: строка
  «слово»: строка
  «сила»: строка

тотальная функция «Словарь»
  возвращает список «Запись словаря»
  [
    запись «Запись словаря» с «вердикт» равным "proved" и «слово» равным "доказано" и «сила» равным "вывод обо ВСЕХ входах",
    запись «Запись словаря» с «вердикт» равным "proved-induction" и «слово» равным "доказано индукцией" и «сила» равным "вывод обо всех входах бесконечного носителя",
    запись «Запись словаря» с «вердикт» равным "proved-conditional" и «слово» равным "доказано ПРИ УСЛОВИИ" и «сила» равным "вывод верен ровно настолько, насколько доказана посылка",
    запись «Запись словаря» с «вердикт» равным "grid" и «слово» равным "сетка" и «сила» равным "счёт на конечной сетке — НЕ доказательство",
    запись «Запись словаря» с «вердикт» равным "declared" и «слово» равным "объявлено, не доказано" и «сила» равным "доказательства нет вовсе",
    запись «Запись словаря» с «вердикт» равным "violated" и «слово» равным "НАРУШЕНО" и «сила» равным "прогон нашёл контрпример",
    запись «Запись словаря» с «вердикт» равным "refused" и «слово» равным "отвергнуто" и «сила» равным "ядро не свело цель"
  ]

тотальная функция «Найти в словаре»
  принимает словарь: список «Запись словаря», вердикт: строка
  возвращает список «Запись словаря»
  пример «Неизвестный вердикт — пусто»
    дано словарь равно пустой список
    дано вердикт равно "grid"
    ожидается пустой список
  свёртка словарь начиная с (пустой список) как найдено и кандидат → (если (найдено равен (пустой список)) и притом ((кандидат.«вердикт») равен вердикт) то [кандидат] иначе найдено)

тотальная функция «Слово строки»
  принимает говорит: строка
  возвращает строка
  пример «Доказано при условии»
    дано говорит равно "доказано ПРИ УСЛОВИИ вывод верен"
    ожидается "доказано ПРИ УСЛОВИИ"
  пример «Доказано индукцией»
    дано говорит равно "доказано индукцией по н"
    ожидается "доказано индукцией"
  пример «Просто доказано»
    дано говорит равно "доказано ядром"
    ожидается "доказано"
  пример «Сетка у закона»
    дано говорит равно "ПОСЧИТАНО НА СЕТКЕ 40"
    ожидается "сетка"
  пример «Слово вне словаря»
    дано говорит равно "непонятно что"
    ожидается ""
  если говорит начинается с "доказано ПРИ УСЛОВИИ"
    то "доказано ПРИ УСЛОВИИ"
    иначе если говорит начинается с "доказано индукцией"
      то "доказано индукцией"
      иначе если говорит начинается с "доказано"
        то "доказано"
        иначе если (говорит начинается с "сетка") или ((говорит начинается с "на сетке") или (говорит начинается с "ПОСЧИТАНО НА СЕТКЕ"))
          то "сетка"
          иначе если говорит начинается с "объявлено, не доказано"
            то "объявлено, не доказано"
            иначе если говорит начинается с "НАРУШЕНО"
              то "НАРУШЕНО"
              иначе если говорит начинается с "отвергнуто"
                то "отвергнуто"
                иначе ""

тотальная функция «Строчная кириллица»
  принимает знак: строка
  возвращает строка
  пример «Заглавная становится строчной»
    дано знак равно "Д"
    ожидается "д"
  пример «Латиница остаётся собой»
    дано знак равно "Q"
    ожидается "Q"
  пусть место равно («Позиция подстроки» от "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ" и знак)
  если ((длина знак) равен 1) и притом (место больше 0)
    то подстрока "абвгдеёжзийклмнопрстуфхцчшщъыьэюя" с место по место
    иначе знак

тотальная функция «Кириллица строчными»
  принимает текст: строка
  возвращает строка
  пример «Регистр кириллицы снят»
    дано текст равно "ДОКАЗАНО x"
    ожидается "доказано x"
  соединить (отобразить (разложить текст на символы) как знак → («Строчная кириллица» от знак)) по ""

тотальная функция «Пробелы одним»
  принимает текст: строка
  возвращает строка
  пример «Любая пробельная россыпь — один пробел»
    дано текст равно "не \t\n доказано"
    ожидается "не доказано"
  пусть ровные равно (соединить (отобразить (разложить текст на символы) как знак → (если «Пробельный знак» от знак то " " иначе знак)) по "")
  соединить (отфильтровать (разделить ровные по " ") где кусок → не (кусок равен "")) по " "

тотальная функция «Буква ли»
  принимает знак: строка
  возвращает признак
  пример «Кириллица — буква»
    дано знак равно "ё"
    ожидается да
  пример «Цифра — не буква»
    дано знак равно "5"
    ожидается нет
  ((длина знак) равен 1) и притом ("абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" содержит знак)

тотальная функция «Шаг сноса букв»
  принимает ход: «Обрезка», знак: строка
  возвращает «Обрезка»
  если (ход.«началось») или (не («Буква ли» от знак))
    то запись «Обрезка» с «началось» равным да и «собрано» равным (соединить [(ход.«собрано»), знак] по "")
    иначе ход

тотальная функция «Без ведущих букв»
  принимает текст: строка
  возвращает строка
  пример «Хвост слова снят до первого небуквенного знака»
    дано текст равно "анный вывод"
    ожидается " вывод"
  пусть итог равно (свёртка (разложить текст на символы) начиная с (запись «Обрезка» с «началось» равным нет и «собрано» равным "") как ход и знак → «Шаг сноса букв» от ход и знак)
  итог.«собрано»

тотальная функция «Без недоказанного»
  принимает текст: строка
  возвращает строка
  пример «Слово с приставкой не- снято целиком»
    дано текст равно "это недоказанный вывод"
    ожидается "это   вывод"
  пусть куски равно (разделить текст по "недоказ")
  соединить (приписать (голова куски) к (отобразить («Отбросить первые» от куски и 1) как кусок → («Без ведущих букв» от кусок))) по " "

тотальная функция «Знак слова по JavaScript»
  принимает знак: строка
  возвращает признак
  пример «Латиница — знак слова»
    дано знак равно "x"
    ожидается да
  пример «Кириллица для границы слова знаком не считается»
    дано знак равно "я"
    ожидается нет
  ((длина знак) равен 1) и притом ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\u017F\u212A" содержит знак)

тотальная функция «Слово с границей»
  принимает текст: строка, слово: строка
  возвращает признак
  пример «За словом латиница — граница есть»
    дано текст равно "доказаноX"
    дано слово равно "доказано"
    ожидается да
  пример «За словом пробел — границы по JavaScript нет»
    дано текст равно "доказано ядром"
    дано слово равно "доказано"
    ожидается нет
  свёртка («Отбросить первые» от (разделить текст по слово) и 1) начиная с нет как найдено и кусок → найдено или («Знак слова по JavaScript» от («Начало текста» от кусок и 1))

тотальная функция «Говорит доказано»
  принимает говорит: строка
  возвращает признак
  пример «Граница слова считается по JavaScript: за кириллицей её нет, и строка не ловится»
    дано говорит равно "доказано ядром"
    ожидается нет
  пример «За словом латинская буква — ловится»
    дано говорит равно "сетка, но ДОКАЗАНОx"
    ожидается да
  пример «Отрицание снимает слово»
    дано говорит равно "не доказаноx"
    ожидается нет
  пусть текст равно («Пробелы одним» от («Кириллица строчными» от говорит))
  пусть без1 равно («Заменить» от текст и "не доказано" и " ")
  пусть без2 равно («Заменить» от без1 и "не доказательство" и " ")
  пусть без3 равно («Заменить» от без2 и "не является доказательством" и " ")
  пусть очищено равно («Без недоказанного» от без3)
  («Слово с границей» от очищено и "доказано") или («Слово с границей» от очищено и "доказаны")

объект «Заявка»
  «of»: строка
  «name»: строка
  «verdict»: строка
  «says»: строка

тотальная функция «Заявка из узла»
  принимает узел: «Значение json»
  возвращает «Заявка»
  пример «Поля заявки читаются по имени»
    дано узел равно вариант «Объект json» с состав равным [вариант «Поле json» с имя равным "of" и содержимое равным (вариант «Текст json» с текст равным "Ф"), вариант «Поле json» с имя равным "name" и содержимое равным (вариант «Текст json» с текст равным "И"), вариант «Поле json» с имя равным "verdict" и содержимое равным (вариант «Текст json» с текст равным "proved"), вариант «Поле json» с имя равным "says" и содержимое равным (вариант «Текст json» с текст равным "доказано")]
    ожидается запись «Заявка» с «of» равным "Ф" и «name» равным "И" и «verdict» равным "proved" и «says» равным "доказано"
  запись «Заявка» с «of» равным («Текст узла» от («Поле узла» от узел и "of")) и «name» равным («Текст узла» от («Поле узла» от узел и "name")) и «verdict» равным («Текст узла» от («Поле узла» от узел и "verdict")) и «says» равным («Текст узла» от («Поле узла» от узел и "says"))

тотальная функция «Заявки ведомости»
  принимает ведомость: «Значение json»
  возвращает список «Заявка»
  пример «Пустой ответ — заявок нет»
    дано ведомость равно вариант «Ничто json»
    ожидается пустой список
  отобразить («Элементы узла» от («Поле узла» от ведомость и "claims")) как узел → («Заявка из узла» от узел)

тотальная функция «Ключ заявки»
  принимает заявка: «Заявка»
  возвращает строка
  пример «Ключ — чья функция и имяУтверждения через черту»
    дано заявка равно запись «Заявка» с «of» равным "Ф" и «name» равным "И" и «verdict» равным "proved" и «says» равным "доказано"
    ожидается "Ф|И"
  соединить [(заявка.«of»), "|", (заявка.«name»)] по ""

тотальная функция «Беда несовпадения слова»
  принимает заявка: «Заявка», ждём: «Запись словаря», сказано: строка
  возвращает список строки
  если сказано равен (ждём.«слово»)
    то пустой список
    иначе [(соединить ["«", (заявка.«name»), "»: вердикт ", (заявка.«verdict»), " (", (ждём.«сила»), "), а сказано словом «", сказано, "» — сильное слово про слабое основание"] по "")]

тотальная функция «Беда слабого со словом доказано»
  принимает заявка: «Заявка»
  возвращает список строки
  если (((заявка.«verdict») равен "grid") или ((заявка.«verdict») равен "declared")) и притом («Говорит доказано» от (заявка.«says»))
    то [(соединить ["«", (заявка.«name»), "»: вердикт ", (заявка.«verdict»), ", а в строке сказано «доказано» — слабое основание названо словом вывода"] по "")]
    иначе пустой список

тотальная функция «Беды слова заявки»
  принимает заявка: «Заявка»
  возвращает список строки
  пример «Слово сошлось с вердиктом — бед нет»
    дано заявка равно запись «Заявка» с «of» равным "Ф" и «name» равным "И" и «verdict» равным "proved" и «says» равным "доказано ядром"
    ожидается пустой список
  пример «Вердикт proved при сеточном слове — беда с силой вердикта»
    дано заявка равно запись «Заявка» с «of» равным "Ф" и «name» равным "И" и «verdict» равным "proved" и «says» равным "сетка 1 значение"
    ожидается ["«И»: вердикт proved (вывод обо ВСЕХ входах), а сказано словом «сетка» — сильное слово про слабое основание"]
  пусть сказано равно («Слово строки» от (заявка.«says»))
  разбор («Найти в словаре» от («Словарь») и (заявка.«verdict»))
    случай пусто
      то [(соединить ["«", (заявка.«name»), "»: вердикт «", (заявка.«verdict»), "» словарю неизвестен — словарь закрыт, впишите слово или почините ядро"] по "")]
    случай голова и хвост
      то если сказано равен ""
        то [(соединить ["«", (заявка.«name»), "»: строка начата словом вне словаря — «", («Начало текста» от (заявка.«says») и 40), "…»"] по "")]
        иначе «Слить строки» от («Беда несовпадения слова» от заявка и голова и сказано) и («Беда слабого со словом доказано» от заявка)

тотальная функция «Беды правила 1»
  принимает заявки: список «Заявка»
  возвращает список строки
  пример «Пустой список заявок — бед нет»
    дано заявки равно пустой список
    ожидается пустой список
  свёртка заявки начиная с (пустой список) как беды и заявка
    «Слить строки» от беды и («Беды слова заявки» от заявка)

объект «Счёт»
  «proved»: число
  «grid»: число
  «declared»: число
  «violated»: число
  «refused»: число
  «conditional»: число
  «induction»: число

тотальная функция «Счёт с одной заявкой»
  принимает счёт: «Счёт», заявка: «Заявка»
  возвращает «Счёт»
  пример «Доказано индукцией идёт и в proved, и в induction»
    дано счёт равно запись «Счёт» с «proved» равным 0 и «grid» равным 0 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 0
    дано заявка равно запись «Заявка» с «of» равным "Ф" и «name» равным "И" и «verdict» равным "proved-induction" и «says» равным "доказано индукцией"
    ожидается запись «Счёт» с «proved» равным 1 и «grid» равным 0 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 1
  пусть индуктивное равно ((заявка.«verdict») равен "proved-induction")
  пусть доказанное равно (((заявка.«verdict») равен "proved") или индуктивное)
  запись «Счёт» с «proved» равным ((счёт.«proved») плюс (если доказанное то 1 иначе 0)) и «grid» равным ((счёт.«grid») плюс (если (заявка.«verdict») равен "grid" то 1 иначе 0)) и «declared» равным ((счёт.«declared») плюс (если (заявка.«verdict») равен "declared" то 1 иначе 0)) и «violated» равным ((счёт.«violated») плюс (если (заявка.«verdict») равен "violated" то 1 иначе 0)) и «refused» равным ((счёт.«refused») плюс (если (заявка.«verdict») равен "refused" то 1 иначе 0)) и «conditional» равным ((счёт.«conditional») плюс (если (заявка.«verdict») равен "proved-conditional" то 1 иначе 0)) и «induction» равным ((счёт.«induction») плюс (если индуктивное то 1 иначе 0))

тотальная функция «Счёт заявок»
  принимает заявки: список «Заявка»
  возвращает «Счёт»
  пример «Пустой список — пустой счёт»
    дано заявки равно пустой список
    ожидается запись «Счёт» с «proved» равным 0 и «grid» равным 0 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 0
  свёртка заявки начиная с (запись «Счёт» с «proved» равным 0 и «grid» равным 0 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 0) как счёт и заявка
    «Счёт с одной заявкой» от счёт и заявка

тотальная функция «Графа сходится»
  принимает итог: «Значение json», имя: строка, счёт: число
  возвращает признак
  пример «Графы нет — считается нулём»
    дано итог равно вариант «Объект json» с состав равным пустой список
    дано имя равно "violated"
    дано счёт равно 0
    ожидается да
  разбор («Поле узла» от итог и имя)
    случай вариант «Число json» с величина как величина
      то величина равен счёт
    случай вариант «Ничто json»
      то счёт равен 0
    случай любое
      то нет

тотальная функция «Графа печатью»
  принимает итог: «Значение json», имя: строка
  возвращает строка
  пример «Графы нет — undefined, как в шаблоне JavaScript»
    дано итог равно вариант «Объект json» с состав равным пустой список
    дано имя равно "violated"
    ожидается "undefined"
  пример «Число печатается числом»
    дано итог равно вариант «Объект json» с состав равным [вариант «Поле json» с имя равным "proved" и содержимое равным (вариант «Число json» с величина равным 4)]
    дано имя равно "proved"
    ожидается "4"
  если не («Есть поле» от итог и имя)
    то "undefined"
    иначе разбор («Поле узла» от итог и имя)
      случай вариант «Текст json» с текст как текст
        то текст
      случай любое
        то «Напечатать json» от («Поле узла» от итог и имя)

тотальная функция «Беда графы»
  принимает итог: «Значение json», имя: строка, счёт: число
  возвращает список строки
  пример «Разошлось — названа беда»
    дано итог равно вариант «Объект json» с состав равным [вариант «Поле json» с имя равным "proved" и содержимое равным (вариант «Число json» с величина равным 4)]
    дано имя равно "proved"
    дано счёт равно 3
    ожидается ["итог «proved» = 4, а строк с таким вердиктом 3 — счёт разошёлся с тем, что напечатано построчно"]
  если «Графа сходится» от итог и имя и счёт
    то пустой список
    иначе [(соединить ["итог «", имя, "» = ", («Графа печатью» от итог и имя), ", а строк с таким вердиктом ", (к строке счёт), " — счёт разошёлся с тем, что напечатано построчно"] по "")]

тотальная функция «Беды правила 2»
  принимает итог: «Значение json», счёт: «Счёт», заявок: число
  возвращает список строки
  пусть графы равно («Слить строки» от («Слить строки» от («Слить строки» от («Слить строки» от («Беда графы» от итог и "proved" и (счёт.«proved»)) и («Беда графы» от итог и "grid" и (счёт.«grid»))) и («Беда графы» от итог и "declared" и (счёт.«declared»))) и («Беда графы» от итог и "violated" и (счёт.«violated»))) и («Беда графы» от итог и "refused" и (счёт.«refused»)))
  пусть условные равно (если «Графа сходится» от итог и "conditional" и (счёт.«conditional») то пустой список иначе [(соединить ["итог «conditional» = ", («Графа печатью» от итог и "conditional"), ", а строк с вердиктом proved-conditional ", (к строке (счёт.«conditional»)), " — счёт разошёлся с тем, что напечатано построчно"] по "")])
  пусть дважды равно (если ((счёт.«proved») плюс (счёт.«conditional»)) больше заявок то ["доказанных и условных вместе больше, чем утверждений — условное посчитано дважды"] иначе пустой список)
  пусть всего равно (если «Графа сходится» от итог и "total" и заявок то пустой список иначе [(соединить ["итог «total» = ", («Графа печатью» от итог и "total"), ", а строк ", (к строке заявок)] по "")])
  пусть индуктивные равно (если «Графа сходится» от итог и "induction" и (счёт.«induction») то пустой список иначе [(соединить ["итог «induction» = ", («Графа печатью» от итог и "induction"), ", а строк индукцией ", (к строке (счёт.«induction»))] по "")])
  пусть сеткой равно (если ((счёт.«proved») плюс (счёт.«grid»)) больше заявок то ["доказанных и сеточных вместе больше, чем утверждений — сетка посчитана дважды"] иначе пустой список)
  «Слить строки» от («Слить строки» от («Слить строки» от («Слить строки» от («Слить строки» от графы и условные) и дважды) и всего) и индуктивные) и сеткой

