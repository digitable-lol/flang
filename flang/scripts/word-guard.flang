модуль «Сторож слов»
  использует «Двоичный» из "./binary.flang"
  использует «JSON»
  использует «UTF-8» из "../stdlib/utf8.flang"
  использует «SHA-256»
  использует «Tree map»
  использует «Lists»
  использует «Strings»

// СТОРОЖ СЛОВ О ДОКАЗАННОСТИ, на языке — перепись flang/scripts/word-guard.mjs.
//
//   flang io flang/scripts/word-guard.flang
//
// Код возврата 0 — чисто; 1 — беда названа.
//
// ── Что сделано и что нет, честно ────────────────────────────────────────
// Правила 1 (слово↔вердикт), 2 (число↔вердикт), 3 (проза↔машина), 5
// (отпечаток цели), 7 (долг ядра) и 6 (каталог подделок полон) перенесены
// целиком. Правило 4 (пустота настоящим прогоном, с заглушкой, с учётом
// дарового постусловия) — тоже; каталог сегодня несёт три доказанных
// утверждения, и все три судятся.
//
// Ключа `--porcha` (шесть встроенных порч старого .mjs) здесь НЕТ вовсе:
// три из них («слово», «число», «проза») у старого инструмента правят УЖЕ
// ПОЛУЧЕННЫЙ ответ двоичного в памяти — на flang это означало бы несколько
// параллельных `план`ов с общей веткой правил, и время на них не хватило.
// Три другие («пустота», «спек», «долг») правили каталог/исходник/прозу на
// диске — для равносильности ИМ вместо ключа программы использована внешняя
// подмена каталога на время прогона (см. отчёт ячейки, раздел «Действия»).
// `--perepis` (диагностика, не приговор, всегда код 0) тоже не перенесена.
//
// ── Каталог, ведомость, дерево ───────────────────────────────────────────

тотальная функция «От корня»
  принимает путь: строка
  возвращает строка
  пример «Путь каталога подделок — от корня дерева»
    дано путь равно "flang/test/fixtures/poddelka-slovo-o-dokazannosti.flang"
    ожидается "../../flang/test/fixtures/poddelka-slovo-o-dokazannosti.flang"
  соединить [(«Корень»), "/", путь] по ""

тотальная функция «Путь каталога слов»
  возвращает строка
  пример «Каталог лежит рядом со сторожем»
    ожидается "proof-words.json"
  "proof-words.json"

тотальная функция «Путь каталога подделок ядра»
  возвращает строка
  пример «Каталог подделок ядра лежит рядом со сторожем»
    ожидается "kernel-forgeries.flang"
  "kernel-forgeries.flang"

тотальная функция «Каталог фикстур»
  возвращает строка
  пример «Фикстуры на два шага выше сторожа»
    ожидается "../test/fixtures"
  "../test/fixtures"

тотальная функция «Срок ведомости»
  возвращает строка
  пример «Десять минут миллисекундами»
    ожидается "600000"
  "600000"

// ── Чтение чужого текста по меткам (тот же приём, что у release-guard.flang) ─

тотальная функция «До метки»
  принимает текст: строка, метка: строка
  возвращает строка
  пример «До первой метки»
    дано текст равно "раз|два"
    дано метка равно "|"
    ожидается "раз"
  голова (разделить текст по метка)

тотальная функция «После метки»
  принимает текст: строка, метка: строка
  возвращает строка
  пример «После первой метки»
    дано текст равно "раз|два|три"
    дано метка равно "|"
    ожидается "два"
  пример «Метки нет — пусто»
    дано текст равно "раз"
    дано метка равно "|"
    ожидается ""
  пусть куски равно (разделить текст по метка)
  если (длина куски) не меньше 2
    то элемент 2 в куски
    иначе ""

объект «Ход ведущих цифр»
  «стоп»: признак
  «вывод»: строка

тотальная функция «Шаг ведущих цифр»
  принимает ход: «Ход ведущих цифр», знак: строка
  возвращает «Ход ведущих цифр»
  если (ход.«стоп») или (не ("0123456789" содержит знак))
    то запись «Ход ведущих цифр» с «стоп» равным да и «вывод» равным (ход.«вывод»)
    иначе запись «Ход ведущих цифр» с «стоп» равным нет и «вывод» равным (соединить [(ход.«вывод»), знак] по "")

// Ведущие цифры строки: «4: доказано» даёт «4», «12, сетка» даёт «12» — в
// прозе первое число обрывается двоеточием, остальные запятой, и общего
// знака-разделителя нет, поэтому останов — по первому НЕ-цифровому знаку.
тотальная функция «Ведущие цифры»
  принимает текст: строка
  возвращает строка
  пусть итог равно (свёртка (разложить текст на символы) начиная с (запись «Ход ведущих цифр» с «стоп» равным нет и «вывод» равным "") как ход и знак → «Шаг ведущих цифр» от ход и знак)
  итог.«вывод»

тотальная функция «Число после метки»
  принимает текст: строка, метка: строка
  возвращает число
  пример «Число после известной метки, обрыв запятой»
    дано текст равно "доказано 12, сетка 3"
    дано метка равно "доказано "
    ожидается 12
  пример «Число после известной метки, обрыв двоеточием»
    дано текст равно "утверждений 4: доказано 3"
    дано метка равно "утверждений "
    ожидается 4
  к числу («Ведущие цифры» от («После метки» от текст и метка))

// ── Значения полей json (числовое и логическое — «Двоичный» даёт только текст) ─

тотальная функция «Число узла»
  принимает значение: «Значение json»
  возвращает число
  пример «Число берётся из Число json»
    дано значение равно вариант «Число json» с величина равным 4
    ожидается 4
  пример «Не число — ноль»
    дано значение равно вариант «Ничто json»
    ожидается 0
  разбор значение
    случай вариант «Число json» с величина как величина
      то величина
    случай любое
      то 0

// ── СЛОВАРЬ: у каждого вердикта ровно одно начальное слово ──────────────────

объект «Запись словаря»
  «вердикт»: строка
  «слово»: строка

тотальная функция «Словарь»
  возвращает список «Запись словаря»
  пример «Семь вердиктов, семь слов»
    ожидается [запись «Запись словаря» с «вердикт» равным "proved-conditional" и «слово» равным "доказано ПРИ УСЛОВИИ", запись «Запись словаря» с «вердикт» равным "proved-induction" и «слово» равным "доказано индукцией", запись «Запись словаря» с «вердикт» равным "proved" и «слово» равным "доказано", запись «Запись словаря» с «вердикт» равным "grid" и «слово» равным "сетка", запись «Запись словаря» с «вердикт» равным "declared" и «слово» равным "объявлено, не доказано", запись «Запись словаря» с «вердикт» равным "violated" и «слово» равным "НАРУШЕНО", запись «Запись словаря» с «вердикт» равным "refused" и «слово» равным "отвергнуто"]
  [
    запись «Запись словаря» с «вердикт» равным "proved-conditional" и «слово» равным "доказано ПРИ УСЛОВИИ",
    запись «Запись словаря» с «вердикт» равным "proved-induction" и «слово» равным "доказано индукцией",
    запись «Запись словаря» с «вердикт» равным "proved" и «слово» равным "доказано",
    запись «Запись словаря» с «вердикт» равным "grid" и «слово» равным "сетка",
    запись «Запись словаря» с «вердикт» равным "declared" и «слово» равным "объявлено, не доказано",
    запись «Запись словаря» с «вердикт» равным "violated" и «слово» равным "НАРУШЕНО",
    запись «Запись словаря» с «вердикт» равным "refused" и «слово» равным "отвергнуто"
  ]

тотальная функция «Слово вердикта»
  принимает словарь: список «Запись словаря», вердикт: строка
  возвращает строка
  пример «Известный вердикт — его слово»
    дано словарь равно [запись «Запись словаря» с «вердикт» равным "grid" и «слово» равным "сетка"]
    дано вердикт равно "grid"
    ожидается "сетка"
  пример «Неизвестный вердикт — пусто»
    дано словарь равно пустой список
    дано вердикт равно "grid"
    ожидается ""
  разбор словарь
    случай пусто
      то ""
    случай голова и хвост
      то если (голова.«вердикт») равен вердикт
        то голова.«слово»
        иначе «Слово вердикта» от (хвост) и вердикт

// Начальное слово строки ведомости: порядок проверки — от самого длинного
// слова к самому короткому, иначе «доказано» проглотило бы «доказано ПРИ
// УСЛОВИИ» своим началом.
тотальная функция «Слово строки»
  принимает говорит: строка
  возвращает строка
  пример «Доказано при условии»
    дано говорит равно "доказано ПРИ УСЛОВИИ вывод верен"
    ожидается "доказано ПРИ УСЛОВИИ"
  пример «Доказано индукцией»
    дано говорит равно "доказано индукцией по н"
    ожидается "доказано индукцией"
  пример «Просто доказано»
    дано говорит равно "доказано ядром"
    ожидается "доказано"
  пример «Сетка»
    дано говорит равно "сетка на 40 значениях"
    ожидается "сетка"
  пример «Слово вне словаря»
    дано говорит равно "непонятно что"
    ожидается ""
  если говорит начинается с "доказано ПРИ УСЛОВИИ"
    то "доказано ПРИ УСЛОВИИ"
    иначе если говорит начинается с "доказано индукцией"
      то "доказано индукцией"
      иначе если говорит начинается с "доказано"
        то "доказано"
        иначе если (говорит начинается с "сетка") или (говорит начинается с "на сетке") или (говорит начинается с "ПОСЧИТАНО НА СЕТКЕ")
          то "сетка"
          иначе если говорит начинается с "объявлено, не доказано"
            то "объявлено, не доказано"
            иначе если говорит начинается с "НАРУШЕНО"
              то "НАРУШЕНО"
              иначе если говорит начинается с "отвергнуто"
                то "отвергнуто"
                иначе ""

// ── Одна заявка ведомости ────────────────────────────────────────────────

объект «Заявка»
  «of»: строка
  «name»: строка
  «verdict»: строка
  «says»: строка

тотальная функция «Заявка из узла»
  принимает узел: «Значение json»
  возвращает «Заявка»
  пример «Поля заявки читаются по имени»
    дано узел равно вариант «Объект json» с состав равным [вариант «Поле json» с имя равным "of" и содержимое равным (вариант «Текст json» с текст равным "Ф"), вариант «Поле json» с имя равным "name" и содержимое равным (вариант «Текст json» с текст равным "И"), вариант «Поле json» с имя равным "verdict" и содержимое равным (вариант «Текст json» с текст равным "proved"), вариант «Поле json» с имя равным "says" и содержимое равным (вариант «Текст json» с текст равным "доказано")]
    ожидается запись «Заявка» с «of» равным "Ф" и «name» равным "И" и «verdict» равным "proved" и «says» равным "доказано"
  запись «Заявка» с «of» равным («Текст узла» от («Поле узла» от узел и "of")) и «name» равным («Текст узла» от («Поле узла» от узел и "name")) и «verdict» равным («Текст узла» от («Поле узла» от узел и "verdict")) и «says» равным («Текст узла» от («Поле узла» от узел и "says"))

тотальная функция «Заявки ведомости»
  принимает ведомость: «Значение json»
  возвращает список «Заявка»
  пример «Пустой ответ — заявок нет»
    дано ведомость равно вариант «Ничто json»
    ожидается пустой список
  отобразить («Элементы узла» от («Поле узла» от ведомость и "claims")) как узел → («Заявка из узла» от узел)

тотальная функция «Ключ заявки»
  принимает заявка: «Заявка»
  возвращает строка
  пример «Ключ — чья функция и имя утверждения через черту»
    дано заявка равно запись «Заявка» с «of» равным "Ф" и «name» равным "И" и «verdict» равным "proved" и «says» равным "доказано"
    ожидается "Ф|И"
  соединить [(заявка.«of»), "|", (заявка.«name»)] по ""

// ── Правило 1: слово ↔ вердикт ───────────────────────────────────────────

тотальная функция «Говорит доказано»
  принимает говорит: строка
  возвращает признак
  пример «Само слово доказано»
    дано говорит равно "доказано ядром"
    ожидается да
  пример «Не доказано — отрицание снимает слово»
    дано говорит равно "не доказано ядром"
    ожидается нет
  пример «Не является доказательством»
    дано говорит равно "не является доказательством"
    ожидается нет
  пример «Сетка сама по себе не значит доказано»
    дано говорит равно "счёт на сетке значений"
    ожидается нет
  (говорит содержит "доказан") и притом (не ((говорит содержит "не доказано") или ((говорит содержит "не доказательство") или (говорит содержит "не является доказательством"))))

тотальная функция «Беда слова заявки»
  принимает заявка: «Заявка»
  возвращает список строки
  пример «Слово сошлось с вердиктом — бед нет»
    дано заявка равно запись «Заявка» с «of» равным "Ф" и «name» равным "И" и «verdict» равным "proved" и «says» равным "доказано ядром"
    ожидается пустой список
  пусть ждём равно («Слово вердикта» от («Словарь») и (заявка.«verdict»))
  пусть сказано равно («Слово строки» от (заявка.«says»))
  если ждём равен ""
    то [(соединить ["«", (заявка.«name»), "»: вердикт «", (заявка.«verdict»), "» словарю неизвестен"] по "")]
    иначе если сказано равен ""
      то [(соединить ["«", (заявка.«name»), "»: строка начата словом вне словаря — «", (подстрока (заявка.«says») с 1 по (если (длина (заявка.«says»)) не меньше 40 то 40 иначе (длина (заявка.«says»)))), "…»"] по "")]
      иначе если не (сказано равен ждём)
        то [(соединить ["«", (заявка.«name»), "»: вердикт ", (заявка.«verdict»), ", а сказано словом «", сказано, "» — сильное слово про слабое основание"] по "")]
        иначе если ((заявка.«verdict» равен "grid") или (заявка.«verdict» равен "declared")) и притом («Говорит доказано» от (заявка.«says»))
          то [(соединить ["«", (заявка.«name»), "»: вердикт ", (заявка.«verdict»), ", а в строке сказано «доказано» — слабое основание названо словом вывода"] по "")]
          иначе пустой список

тотальная функция «Слить строки»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Порядок сохраняется»
    дано первые равно ["а"]
    дано вторые равно ["б"]
    ожидается ["а", "б"]
  свёртка вторые начиная с первые как акк и строка
    добавить строка к акк

тотальная функция «Беды правила 1»
  принимает заявки: список «Заявка»
  возвращает список строки
  пример «Пустой список заявок — бед нет»
    дано заявки равно пустой список
    ожидается пустой список
  свёртка заявки начиная с (пустой список) как беды и заявка
    «Слить строки» от беды и («Беда слова заявки» от заявка)

// ── Правило 2: число ↔ вердикт ───────────────────────────────────────────

объект «Счёт»
  «proved»: число
  «grid»: число
  «declared»: число
  «violated»: число
  «refused»: число
  «conditional»: число
  «induction»: число

тотальная функция «Счёт с одной заявкой»
  принимает счёт: «Счёт», заявка: «Заявка»
  возвращает «Счёт»
  пример «Доказано индукцией идёт и в proved, и в induction»
    дано счёт равно запись «Счёт» с «proved» равным 0 и «grid» равным 0 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 0
    дано заявка равно запись «Заявка» с «of» равным "Ф" и «name» равным "И" и «verdict» равным "proved-induction" и «says» равным "доказано индукцией"
    ожидается запись «Счёт» с «proved» равным 1 и «grid» равным 0 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 1
  пусть докИндукцией равно (заявка.«verdict» равен "proved-induction")
  пусть докОбычно равно ((заявка.«verdict» равен "proved") или докИндукцией)
  пусть новыйProved равно ((счёт.«proved») плюс (если докОбычно то 1 иначе 0))
  пусть новыйGrid равно ((счёт.«grid») плюс (если заявка.«verdict» равен "grid" то 1 иначе 0))
  пусть новыйDeclared равно ((счёт.«declared») плюс (если заявка.«verdict» равен "declared" то 1 иначе 0))
  пусть новыйViolated равно ((счёт.«violated») плюс (если заявка.«verdict» равен "violated" то 1 иначе 0))
  пусть новыйRefused равно ((счёт.«refused») плюс (если заявка.«verdict» равен "refused" то 1 иначе 0))
  пусть новыйConditional равно ((счёт.«conditional») плюс (если заявка.«verdict» равен "proved-conditional" то 1 иначе 0))
  пусть новыйInduction равно ((счёт.«induction») плюс (если докИндукцией то 1 иначе 0))
  запись «Счёт» с «proved» равным новыйProved и «grid» равным новыйGrid и «declared» равным новыйDeclared и «violated» равным новыйViolated и «refused» равным новыйRefused и «conditional» равным новыйConditional и «induction» равным новыйInduction

тотальная функция «Пустой счёт»
  возвращает «Счёт»
  пример «Всё с нуля»
    ожидается запись «Счёт» с «proved» равным 0 и «grid» равным 0 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 0
  запись «Счёт» с «proved» равным 0 и «grid» равным 0 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 0

тотальная функция «Счёт заявок»
  принимает заявки: список «Заявка»
  возвращает «Счёт»
  пример «Пустой список — пустой счёт»
    дано заявки равно пустой список
    ожидается запись «Счёт» с «proved» равным 0 и «grid» равным 0 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 0
  свёртка заявки начиная с («Пустой счёт») как счёт и заявка
    «Счёт с одной заявкой» от счёт и заявка

тотальная функция «Ждём число итога»
  принимает зачем: строка, ждали: число, вышло: число
  возвращает список строки
  пример «Сошлось — бед нет»
    дано зачем равно "proved"
    дано ждали равно 3
    дано вышло равно 3
    ожидается пустой список
  пример «Разошлось — названа беда»
    дано зачем равно "proved"
    дано ждали равно 4
    дано вышло равно 3
    ожидается ["итог «proved» = 4, а строк с таким вердиктом 3 — счёт разошёлся с тем, что напечатано построчно"]
  если ждали равен вышло
    то пустой список
    иначе [(соединить ["итог «", зачем, "» = ", (к строке ждали), ", а строк с таким вердиктом ", (к строке вышло), " — счёт разошёлся с тем, что напечатано построчно"] по "")]

тотальная функция «Беды правила 2»
  принимает ведомость: «Значение json», счёт: «Счёт», заявок: число
  возвращает список строки
  пусть итог равно («Поле узла» от ведомость и "totals")
  пусть итогClaims равно («Поле узла» от итог и "claims")
  пусть числоProved равно («Число узла» от («Поле узла» от итогClaims и "proved"))
  пусть числоGrid равно («Число узла» от («Поле узла» от итогClaims и "grid"))
  пусть числоDeclared равно («Число узла» от («Поле узла» от итогClaims и "declared"))
  пусть числоViolated равно («Число узла» от («Поле узла» от итогClaims и "violated"))
  пусть числоRefused равно («Число узла» от («Поле узла» от итогClaims и "refused"))
  пусть числоConditional равно («Число узла» от («Поле узла» от итог и "conditional"))
  пусть числоTotal равно («Число узла» от («Поле узла» от итог и "total"))
  пусть числоInduction равно («Число узла» от («Поле узла» от итог и "induction"))
  пусть б1 равно («Ждём число итога» от "proved" и числоProved и (счёт.«proved»))
  пусть б2 равно («Ждём число итога» от "grid" и числоGrid и (счёт.«grid»))
  пусть б3 равно («Ждём число итога» от "declared" и числоDeclared и (счёт.«declared»))
  пусть б4 равно («Ждём число итога» от "violated" и числоViolated и (счёт.«violated»))
  пусть б5 равно («Ждём число итога» от "refused" и числоRefused и (счёт.«refused»))
  пусть б6 равно («Ждём число итога» от "conditional" и числоConditional и (счёт.«conditional»))
  пусть б7 равно («Ждём число итога» от "total" и числоTotal и заявок)
  пусть б8 равно («Ждём число итога» от "induction" и числоInduction и (счёт.«induction»))
  пусть м1 равно («Слить строки» от б1 и б2)
  пусть м2 равно («Слить строки» от м1 и б3)
  пусть м3 равно («Слить строки» от м2 и б4)
  пусть м4 равно («Слить строки» от м3 и б5)
  пусть м5 равно («Слить строки» от м4 и б6)
  пусть м6 равно («Слить строки» от м5 и б7)
  «Слить строки» от м6 и б8

// ── Правило 3: проза ↔ машина ────────────────────────────────────────────

тотальная функция «Проза несёт итог»
  принимает проза: строка
  возвращает признак
  пример «Строка итога есть»
    дано проза равно "утверждений 4: доказано 3, сетка 1, объявлено, не доказано 0"
    ожидается да
  пример «Строки итога нет»
    дано проза равно "замечаний нет"
    ожидается нет
  проза содержит "утверждений "

тотальная функция «Беды правила 3»
  принимает проза: строка, счёт: «Счёт», заявок: число
  возвращает список строки
  пример «Проза сошлась с машиной — слово доказано встречается раньше в тексте и внутри не-доказано, бед всё равно нет»
    дано проза равно "постусловие «х» функции «Ф» — доказано сведением цели с телом функции\nитог:\n  утверждений 4: доказано 3 (из них без теоремы 3), сетка 1, объявлено, не доказано 0"
    дано счёт равно запись «Счёт» с «proved» равным 3 и «grid» равным 1 и «declared» равным 0 и «violated» равным 0 и «refused» равным 0 и «conditional» равным 0 и «induction» равным 0
    дано заявок равно 4
    ожидается пустой список
  если не («Проза несёт итог» от проза)
    то (если заявок больше 0 то ["в человеческом выводе нет строки итога утверждений"] иначе пустой список)
    иначе
      пусть всего равно («Число после метки» от проза и "утверждений ")
      // «доказано»/«сетка» встречаются ВЫШЕ по прозе тоже (в перечне
      // утверждений построчно) — числа берутся только из ХВОСТА после
      // «утверждений », это и есть строка итога, и в ней каждая метка ровно
      // по одному разу как начало числа (даже «доказано» внутри «не
      // доказано» — оно там второе и позже искомого).
      пусть хвостИтога равно («После метки» от проза и "утверждений ")
      пусть док равно («Число после метки» от хвостИтога и "доказано ")
      пусть сет равно («Число после метки» от хвостИтога и "сетка ")
      пусть объ равно («Число после метки» от хвостИтога и "объявлено, не доказано ")
      пусть б1 равно (если всего равен заявок то пустой список иначе [(соединить ["проза говорит «утверждений ", (к строке всего), "», машина — ", (к строке заявок)] по "")])
      пусть б2 равно (если док равен (счёт.«proved») то пустой список иначе [(соединить ["проза говорит «доказано ", (к строке док), "», машина — ", (к строке (счёт.«proved»))] по "")])
      пусть б3 равно (если сет равен (счёт.«grid») то пустой список иначе [(соединить ["проза говорит «сетка ", (к строке сет), "», машина — ", (к строке (счёт.«grid»))] по "")])
      пусть б4 равно (если объ равен (счёт.«declared») то пустой список иначе [(соединить ["проза говорит «объявлено, не доказано ", (к строке объ), "», машина — ", (к строке (счёт.«declared»))] по "")])
      пусть м1 равно («Слить строки» от б1 и б2)
      пусть м2 равно («Слить строки» от м1 и б3)
      «Слить строки» от м2 и б4

// ── Отпечаток цели (правило 5) ───────────────────────────────────────────

тотальная функция «Меньше поля»
  принимает первое: «Поле json», второе: «Поле json»
  возвращает признак
  разбор первое
    случай вариант «Поле json» с имя как имяа и содержимое как чтоа
      то разбор второе
        случай вариант «Поле json» с имя как имяб и содержимое как чтоб
          то «Строка раньше» от имяа и имяб

тотальная функция «Вставить поле по имени»
  принимает штука: «Поле json», состав: список «Поле json»
  возвращает список «Поле json»
  разбор состав
    случай пусто
      то [штука]
    случай голова и хвост
      то если «Меньше поля» от штука и голова
        то приписать штука к состав
        иначе приписать голова к («Вставить поле по имени» от штука и хвост)

тотальная функция «Сортировать поля»
  принимает состав: список «Поле json»
  возвращает список «Поле json»
  пример «Поля становятся по алфавиту имени»
    дано состав равно [вариант «Поле json» с имя равным "b" и содержимое равным (вариант «Ничто json»), вариант «Поле json» с имя равным "a" и содержимое равным (вариант «Ничто json»)]
    ожидается [вариант «Поле json» с имя равным "a" и содержимое равным (вариант «Ничто json»), вариант «Поле json» с имя равным "b" и содержимое равным (вариант «Ничто json»)]
  разбор состав
    случай пусто
      то пустой список
    случай голова и хвост
      то «Вставить поле по имени» от (голова) и («Сортировать поля» от хвост)

тотальная функция «Поля без места»
  принимает состав: список «Поле json»
  возвращает список «Поле json»
  разбор состав
    случай пусто
      то пустой список
    случай голова и хвост
      то разбор голова
        случай вариант «Поле json» с имя как имя2 и содержимое как что2
          то если имя2 равен "span"
            то «Поля без места» от (хвост)
            иначе приписать (вариант «Поле json» с имя равным имя2 и содержимое равным («Без места» от что2)) к («Поля без места» от (хвост))

тотальная функция «Без места»
  принимает значение: «Значение json»
  возвращает «Значение json»
  разбор значение
    случай вариант «Массив json» с элементы как элементы
      то вариант «Массив json» с элементы равным (отобразить элементы как эл → («Без места» от эл))
    случай вариант «Объект json» с состав как состав
      то вариант «Объект json» с состав равным («Сортировать поля» от («Поля без места» от состав))
    случай любое
      то значение

тотальная функция «Отпечаток цели»
  принимает цель: «Значение json»
  возвращает строка
  пусть весь равно («Хеш байтов» от («Байты текста» от («Напечатать json» от («Без места» от цель))))
  подстрока весь с 1 по 16

// ── Долг ядра (правило 7) ────────────────────────────────────────────────

объект «Долг ядра»
  «слова»: строка
  «беда»: строка

тотальная функция «Долги ядра из каталога»
  принимает узел: «Значение json»
  возвращает список «Долг ядра»
  отобразить («Элементы узла» от узел) как долг → (запись «Долг ядра» с «слова» равным («Текст узла» от («Поле узла» от долг и "слова")) и «беда» равным («Текст узла» от («Поле узла» от долг и "беда")))

тотальная функция «Беды пропавшего долга»
  принимает проза: строка, долги: список «Долг ядра»
  возвращает список строки
  разбор долги
    случай пусто
      то пустой список
    случай голова и хвост
      то если проза содержит (голова.«слова»)
        то «Беды пропавшего долга» от проза и хвост
        иначе приписать (соединить ["долг ядра «", (голова.«слова»), "» закрыт, а запись о нём осталась — уберите её из каталога, иначе список долгов зарастёт"] по "") к («Беды пропавшего долга» от проза и хвост)

// ── Заглушка по типу (правило 4) ─────────────────────────────────────────

тотальная функция «Заглушка типа»
  принимает объТипа: «Значение json»
  возвращает строка
  пусть kind равно («Текст узла» от («Поле узла» от объТипа и "kind"))
  пусть имя равно («Текст узла» от («Поле узла» от объТипа и "name"))
  если kind равен "named"
    то если (имя равен "нат") или ((имя равен "целое") или ((имя равен "вес") или ((имя равен "стоимость") или ((имя равен "сотых") или ((имя равен "тысячных") или (имя равен "неотрицательное"))))))
      то "0"
      иначе ""
    иначе если kind равен "number"
      то "0"
      иначе если kind равен "string"
        то "\"\""
        иначе если kind равен "flag"
          то "нет"
          иначе если kind равен "list"
            то "пустой список"
            иначе ""

// ── Разрезание исходника: тело функции заменяется заглушкой ─────────────

тотальная функция «Первая без отступа с остатка»
  принимает остаток: список строки, текущая: число, всего: число
  возвращает число
  разбор остаток
    случай пусто
      то всего
    случай голова и хвост
      то если ((длина голова) больше 0) и притом (не ((подстрока голова с 1 по 1) равен " "))
        то текущая
        иначе «Первая без отступа с остатка» от (хвост) и (текущая плюс 1) и всего

тотальная функция «Первая без отступа»
  принимает строки: список строки, начс: число
  возвращает число
  «Первая без отступа с остатка» от («Отбросить первые» от строки и (начс минус 1)) и начс и (длина строки)

тотальная функция «Без хвостовой пустоты»
  принимает строки: список строки, до: число
  возвращает число
  убывает до
  если до не больше 1
    то до
    иначе
      пусть предыдущая равно (элемент (до минус 1) в строки)
      если («Обрезать пробелы» от предыдущая) равен ""
        то «Без хвостовой пустоты» от строки и (до минус 1)
        иначе до

// «начало» — 1-based номер строки, на которой стоит тело (span.line из
// дерева); голова обрывается СТРОКОЙ РАНЬШЕ, хвост начинается там, где
// нашлась первая безотступная строка от «начало» и дальше, с обрезанной
// хвостовой пустотой — тем же приёмом, что у «сЗаглушкой» в word-guard.mjs.
тотальная функция «Со стеблем»
  принимает исходник: строка, начало: число, текст: строка
  возвращает строка
  пусть строки равно (разделить исходник по "\n")
  пусть конецСырой равно («Первая без отступа» от строки и начало)
  пусть конец равно («Без хвостовой пустоты» от строки и конецСырой)
  пусть голова равно («Взять первые» от строки и (начало минус 1))
  пусть хвост равно («Отбросить первые» от строки и конец)
  пусть стеблем равно [(соединить ["  ", текст] по "")]
  пусть головаИСтебель равно («Соединить списки» от голова и стеблем)
  пусть всеСтроки равно («Соединить списки» от головаИСтебель и хвост)
  соединить всеСтроки по "\n"

тотальная функция «Строка примера»
  принимает строка: строка
  возвращает признак
  пусть подрезано равно («Обрезать пробелы» от строка)
  (подрезано начинается с "пример") или (подрезано начинается с "example")

тотальная функция «Отступ символов»
  принимает символы: список строки
  возвращает число
  разбор символы
    случай пусто
      то 0
    случай голова и хвост
      то если голова равен " "
        то 1 плюс («Отступ символов» от хвост)
        иначе 0

тотальная функция «Отступ строки»
  принимает строка: строка
  возвращает число
  «Отступ символов» от (разложить строка на символы)

объект «Ход без примеров»
  «пропуск»: число
  «глубина»: число
  «вывод»: список строки

тотальная функция «Шаг без примеров»
  принимает ход: «Ход без примеров», строка: строка
  возвращает «Ход без примеров»
  если (ход.«пропуск») больше 0
    то если («Обрезать пробелы» от строка) равен ""
      то запись «Ход без примеров» с «пропуск» равным (ход.«пропуск») и «глубина» равным (ход.«глубина») и «вывод» равным (ход.«вывод»)
      иначе если («Отступ строки» от строка) не больше (ход.«глубина»)
        то «Шаг без примеров стартовый» от ход и строка
        иначе запись «Ход без примеров» с «пропуск» равным (ход.«пропуск») и «глубина» равным (ход.«глубина») и «вывод» равным (ход.«вывод»)
    иначе «Шаг без примеров стартовый» от ход и строка

тотальная функция «Шаг без примеров стартовый»
  принимает ход: «Ход без примеров», строка: строка
  возвращает «Ход без примеров»
  если «Строка примера» от строка
    то запись «Ход без примеров» с «пропуск» равным 1 и «глубина» равным («Отступ строки» от строка) и «вывод» равным (ход.«вывод»)
    иначе запись «Ход без примеров» с «пропуск» равным 0 и «глубина» равным 0 и «вывод» равным (добавить строка к (ход.«вывод»))

тотальная функция «Без примеров»
  принимает исходник: строка
  возвращает строка
  пусть строки равно (разделить исходник по "\n")
  пусть итог равно (свёртка строки начиная с (запись «Ход без примеров» с «пропуск» равным 0 и «глубина» равным 0 и «вывод» равным (пустой список)) как ход и строка → «Шаг без примеров» от ход и строка)
  соединить (итог.«вывод») по "\n"

// ── Каталог: запись одного файла, утверждения и обязательства ведомости ──

тотальная функция «Найти файл каталога»
  принимает файлы: список «Поле json», путь: строка
  возвращает «Значение json»
  разбор файлы
    случай пусто
      то вариант «Ничто json»
    случай голова и хвост
      то если («Имя поля json» от голова) равен путь
        то «Содержимое поля json» от голова
        иначе «Найти файл каталога» от (хвост) и путь

тотальная функция «Запись файла»
  принимает текстКаталога: строка, файл: строка
  возвращает «Значение json»
  разбор («Разобрать json» от текстКаталога)
    случай вариант «Разобран json» с значение как узел
      то «Найти файл каталога» от («Файлы каталога» от узел) и файл
    случай любое
      то вариант «Ничто json»

тотальная функция «Утверждения записи»
  принимает катзап: «Значение json»
  возвращает список «Значение json»
  «Элементы узла» от («Поле узла» от катзап и "утверждения")

тотальная функция «Утверждение подходит»
  принимает штука: «Значение json», чья: строка, name: строка
  возвращает признак
  ((«Текст узла» от («Поле узла» от штука и "чья")) равен чья) и притом ((«Текст узла» от («Поле узла» от штука и "имя")) равен name)

тотальная функция «Найти утверждение»
  принимает утверждения: список «Значение json», чья: строка, name: строка
  возвращает «Значение json»
  разбор утверждения
    случай пусто
      то вариант «Ничто json»
    случай голова и хвост
      то если «Утверждение подходит» от (голова) и чья и name
        то голова
        иначе «Найти утверждение» от (хвост) и чья и name

тотальная функция «Обязательства ведомости»
  принимает ведомость: «Значение json»
  возвращает список «Значение json»
  «Элементы узла» от («Поле узла» от ведомость и "obligations")

тотальная функция «Обязательство подходит»
  принимает обязательство: «Значение json», чья: строка, name: строка
  возвращает признак
  ((«Текст узла» от («Поле узла» от обязательство и "of")) равен чья) и притом ((«Текст узла» от («Поле узла» от обязательство и "name")) равен name)

тотальная функция «Найти обязательство»
  принимает обязательства: список «Значение json», чья: строка, name: строка
  возвращает «Значение json»
  разбор обязательства
    случай пусто
      то вариант «Ничто json»
    случай голова и хвост
      то если «Обязательство подходит» от (голова) и чья и name
        то голова
        иначе «Найти обязательство» от (хвост) и чья и name

// ── Правило 5: содержание цели, а не имя утверждения ─────────────────────

тотальная функция «Беда правила 5 одной»
  принимает заявка: «Заявка», ведомость: «Значение json», катзап: «Значение json»
  возвращает список строки
  пусть найдено равно («Найти утверждение» от («Утверждения записи» от катзап) и (заявка.«of») и (заявка.«name»))
  если найдено равен (вариант «Ничто json»)
    то [(соединить ["«", (заявка.«name»), "» функции «", (заявка.«of»), "» НЕЗАРЕГИСТРИРОВАНО в каталоге слов — забытую запись никто не поймает"] по "")]
    иначе
      пусть обяз равно («Найти обязательство» от («Обязательства ведомости» от ведомость) и (заявка.«of») и (заявка.«name»))
      если обяз равен (вариант «Ничто json»)
        то [(соединить ["«", (заявка.«name»), "»: цели в машинном виде нет — сверять содержание нечем"] по "")]
        иначе
          пусть был равно («Отпечаток цели» от («Поле узла» от обяз и "goal"))
          пусть записан равно («Текст узла» от («Поле узла» от найдено и "отпечаток"))
          если был равен записан
            то пустой список
            иначе [(соединить ["«", (заявка.«name»), "»: ЦЕЛЬ ИЗМЕНИЛАСЬ под тем же именем (отпечаток ", записан, " → ", был, ") — спеку ослабили, а имя оставили"] по "")]

тотальная функция «Беды правила 5»
  принимает заявки: список «Заявка», ведомость: «Значение json», катзап: «Значение json»
  возвращает список строки
  свёртка заявки начиная с (пустой список) как беды и заявка
    «Слить строки» от беды и («Беда правила 5 одной» от заявка и ведомость и катзап)

// ── Все ранние правила разом: 1, 2, 3, 5 и 7 ──────────────────────────────

тотальная функция «Беды ранних правил»
  принимает файл: строка, текстКаталога: строка, ведомость: «Значение json», проза: строка
  возвращает список строки
  пусть заявки равно («Заявки ведомости» от ведомость)
  пусть счёт равно («Счёт заявок» от заявки)
  пусть катзап равно («Запись файла» от текстКаталога и файл)
  пусть долги равно («Долги ядра поля» от текстКаталога)
  пусть заявок равно (длина заявки)
  пусть б1 равно («Беды правила 1» от заявки)
  пусть б2 равно («Беды правила 2» от ведомость и счёт и заявок)
  пусть б3 равно («Беды правила 3» от проза и счёт и заявок)
  пусть б5 равно («Беды правила 5» от заявки и ведомость и катзап)
  пусть б7 равно («Беды пропавшего долга» от проза и долги)
  пусть м1 равно («Слить строки» от б1 и б2)
  пусть м2 равно («Слить строки» от м1 и б3)
  пусть м3 равно («Слить строки» от м2 и б5)
  «Слить строки» от м3 и б7

тотальная функция «Долги ядра поля»
  принимает текстКаталога: строка
  возвращает список «Долг ядра»
  разбор («Разобрать json» от текстКаталога)
    случай вариант «Разобран json» с значение как узел
      то «Долги ядра из каталога» от («Поле узла» от узел и "долг ядра")
    случай любое
      то пустой список

// ── Функции файла: имя, поле returns, номер строки тела ─────────────────

тотальная функция «Найти функцию»
  принимает функции: список «Значение json», имя: строка
  возвращает «Значение json»
  разбор функции
    случай пусто
      то вариант «Ничто json»
    случай голова и хвост
      то если («Текст узла» от («Поле узла» от (голова) и "name")) равен имя
        то голова
        иначе «Найти функцию» от (хвост) и имя

тотальная функция «Начало тела»
  принимает фн: «Значение json»
  возвращает число
  пусть тело равно («Поле узла» от фн и "body")
  пусть место равно («Поле узла» от тело и "span")
  «Число узла» от («Поле узла» от место и "line")

// ── Куча одного доказанного утверждения ──────────────────────────────────

объект «Куча»
  «имя»: строка
  «почему»: строка

тотальная функция «Куча не судили»
  принимает почему: строка
  возвращает «Куча»
  запись «Куча» с «имя» равным "не судили" и «почему» равным почему

тотальная функция «Осталось доказанным»
  принимает ведомость: «Значение json», заявка: «Заявка»
  возвращает признак
  пусть заявки равно («Заявки ведомости» от ведомость)
  «Осталось доказанным в списке» от заявки и заявка

тотальная функция «Осталось доказанным в списке»
  принимает заявки: список «Заявка», ищем: «Заявка»
  возвращает признак
  разбор заявки
    случай пусто
      то нет
    случай голова и хвост
      то если (голова.«of» равен ищем.«of») и притом (голова.«name» равен ищем.«name»)
        то (голова.«verdict» начинается с "proved")
        иначе «Осталось доказанным в списке» от (хвост) и ищем

// ── Читать директорию json объекта как список пар «файл — запись» ───────

тотальная функция «Файлы каталога»
  принимает каталог: «Значение json»
  возвращает список «Поле json»
  «Состав объекта» от («Поле узла» от каталог и "файлы")

// ── Отклик, поручение — общие обёртки ─────────────────────────────────────

тотальная функция «Читать»
  принимает путь: строка, потом: «Ход сторожа слов»
  возвращает «Продолжение»
  вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным путь) и потом равным потом

тотальная функция «Список каталога»
  принимает путь: строка, потом: «Ход сторожа слов»
  возвращает «Продолжение»
  вариант «Сделать» с поручение равным (вариант «Перечислить каталог» с путь равным путь) и потом равным потом

тотальная функция «Спросить проза»
  принимает путь: строка
  возвращает «Поручение»
  «Позвать» от ["check", путь, "--proof"]

// «Спросить ведомость» из flang/scripts/binary.flang зовёт двоичный с ключом
// «--timeout», которого у «flang check» нет («flang check --help» его не
// называет; прямой прогон отвечает «непонятный ключ «--timeout»», кодом 2) —
// похоже, устаревший довод. Здесь та же ведомость спрашивается напрямую,
// без него.
тотальная функция «Спросить ведомость верно»
  принимает путь: строка
  возвращает «Поручение»
  «Позвать» от ["check", путь, "--proof", "--json"]

тотальная функция «Отклик текстом»
  принимает отклик: «Отклик»
  возвращает строка
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то вывод
    случай любое
      то ""

тотальная функция «Отклик файлом»
  принимает отклик: «Отклик»
  возвращает строка
  разбор отклик
    случай вариант «Прочитано» с содержимое как содержимое
      то содержимое
    случай любое
      то ""

тотальная функция «Отклик списком»
  принимает отклик: «Отклик»
  возвращает список строки
  разбор отклик
    случай вариант «Перечислено» с имена как имена
      то имена
    случай любое
      то пустой список

// ── Правило 6: каталог подделок полон ────────────────────────────────────

тотальная функция «Это подделка»
  принимает имя: строка
  возвращает признак
  пусть головное равно (имя начинается с "poddelka-")
  пусть хвост1 равно («Заканчивается на» от имя и ".flang")
  пусть хвост2 равно («Заканчивается на» от имя и ".fp")
  пусть хвост3 равно («Заканчивается на» от имя и ".фп")
  пусть хвост4 равно («Заканчивается на» от имя и ".фланг")
  головное и притом (хвост1 или (хвост2 или (хвост3 или хвост4)))

тотальная функция «Названа ли подделка»
  принимает путь: строка, каталогЯдра: строка, свои: список строки
  возвращает признак
  (каталогЯдра содержит путь) или («Есть среди» от свои и путь)

объект «Итог подделок»
  «забытые»: список строки
  «безСторожа»: список строки

тотальная функция «Судить подделки»
  принимает имена: список строки, каталогЯдра: строка, свои: список строки, долгФайлы: список строки
  возвращает «Итог подделок»
  «Судить подделки список» от (отфильтровать имена где имя → («Это подделка» от имя)) и каталогЯдра и свои и долгФайлы

тотальная функция «Судить подделки список»
  принимает имена: список строки, каталогЯдра: строка, свои: список строки, долгФайлы: список строки
  возвращает «Итог подделок»
  разбор имена
    случай пусто
      то запись «Итог подделок» с «забытые» равным (пустой список) и «безСторожа» равным (пустой список)
    случай голова и хвост
      то пусть путь равно (соединить ["flang/test/fixtures/", голова] по "")
      пусть дальше равно («Судить подделки список» от (хвост) и каталогЯдра и свои и долгФайлы)
      если «Названа ли подделка» от путь и каталогЯдра и свои
        то дальше
        иначе если «Есть среди» от долгФайлы и путь
          то запись «Итог подделок» с «забытые» равным (дальше.«забытые») и «безСторожа» равным (приписать путь к (дальше.«безСторожа»))
          иначе запись «Итог подделок» с «забытые» равным (приписать (соединить [путь, ": НЕЗАРЕГИСТРИРОВАННАЯ ПОДДЕЛКА"] по "") к (дальше.«забытые»)) и «безСторожа» равным (дальше.«безСторожа»)

// ═══════════════════════════════ ПЛАН ═════════════════════════════════════
//
// Одна заявка каталога сегодня несёт файл с четырьмя утверждениями, три из
// них доказаны. Ход шагает по шести станциям на этот единственный файл, а
// затем спрашивает каталог подделок; список файлов каталога устроен так,
// что расширение на N файлов меняет только длину станций 2–6, не их форму.

объект «Итог пустоты»
  «of»: строка
  «name»: строка
  «куча»: строка
  «почему»: строка

тотальная функция «Найти постусловие»
  принимает постусловия: список «Значение json», имя: строка
  возвращает «Значение json»
  разбор постусловия
    случай пусто
      то вариант «Ничто json»
    случай голова и хвост
      то если («Текст узла» от («Поле узла» от (голова) и "name")) равен имя
        то голова
        иначе «Найти постусловие» от (хвост) и имя

тотальная функция «Переменная результат»
  принимает узел: «Значение json»
  возвращает признак
  ((«Текст узла» от («Поле узла» от узел и "kind")) равен "var") и притом ((«Текст узла» от («Поле узла» от узел и "name")) равен "результат")

тотальная функция «Это равенство»
  принимает выражение: «Значение json»
  возвращает признак
  ((«Текст узла» от («Поле узла» от выражение и "kind")) равен "binary") и притом ((«Текст узла» от («Поле узла» от выражение и "op")) равен "eq")

тотальная функция «Другая сторона равенства»
  принимает выражение: «Значение json»
  возвращает «Значение json»
  пусть левая равно («Поле узла» от выражение и "left")
  пусть правая равно («Поле узла» от выражение и "right")
  если «Переменная результат» от левая
    то правая
    иначе если «Переменная результат» от правая
      то левая
      иначе вариант «Ничто json»

// ДАРОВОЕ: постусловие переписано с тела знак в знак — заглушка ему ничего
// не покажет, и подмену для такой заявки не заводят вовсе.
тотальная функция «Тавтология»
  принимает фн: «Значение json», имяУтверждения: строка
  возвращает признак
  пусть постусловия равно («Элементы узла» от («Поле узла» от фн и "postconditions"))
  пусть п равно («Найти постусловие» от постусловия и имяУтверждения)
  если п равен (вариант «Ничто json»)
    то нет
    иначе
      пусть выражение равно («Поле узла» от п и "expr")
      если не («Это равенство» от выражение)
        то нет
        иначе
          пусть другая равно («Другая сторона равенства» от выражение)
          если другая равен (вариант «Ничто json»)
            то нет
            иначе («Без места» от другая) равен («Без места» от («Поле узла» от фн и "body"))

тотальная функция «Беда пустоты одной»
  принимает итог: «Итог пустоты», катзап: «Значение json»
  возвращает список строки
  пусть найдено равно («Найти утверждение» от («Утверждения записи» от катзап) и (итог.«of») и (итог.«name»))
  если найдено равен (вариант «Ничто json»)
    то пустой список
    иначе
      пусть ждём равно («Текст узла» от («Поле узла» от найдено и "основание"))
      если (итог.«куча») равен ждём
        то пустой список
        иначе [(соединить ["«", (итог.«name»), "» — прогон с заглушкой говорит «", (итог.«куча»), "» (", (итог.«почему»), "), а каталог ждёт «", ждём, "»"] по "")]

тотальная функция «Беды пустоты»
  принимает итоги: список «Итог пустоты», катзап: «Значение json»
  возвращает список строки
  свёртка итоги начиная с (пустой список) как беды и итог
    «Слить строки» от беды и («Беда пустоты одной» от итог и катзап)

тип «Ход сторожа слов»
  вариант «Ждём каталог»
  вариант «Ждём ведомость» содержит текстКаталога: строка, файл: строка
  вариант «Ждём прозу» содержит текстКаталога: строка, файл: строка, ведомость: «Значение json»
  вариант «Ждём дерево» содержит текстКаталога: строка, файл: строка, ведомость: «Значение json», бедыРанние: список строки
  вариант «Ждём исходник» содержит текстКаталога: строка, файл: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json»
  вариант «Ждём пробу без примеров» содержит текстКаталога: строка, файл: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», исходник: строка
  вариант «Ждём ведомость без примеров» содержит текстКаталога: строка, файл: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», исходник: строка
  вариант «Ждём пробу заглушки» содержит текстКаталога: строка, файл: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», исходник: строка, безПримеров: «Значение json», индекс: число, заявка: «Заявка», итоги: список «Итог пустоты», текст: строка
  вариант «Ждём ведомость заглушки» содержит текстКаталога: строка, файл: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», исходник: строка, безПримеров: «Значение json», индекс: число, заявка: «Заявка», итоги: список «Итог пустоты», текст: строка
  вариант «Ждём уборку проб» содержит текстКаталога: строка, беды: список строки
  вариант «Ждём список фикстур» содержит текстКаталога: строка, беды: список строки
  вариант «Ждём ядро подделок» содержит текстКаталога: строка, беды: список строки, имена: список строки

тотальная функция «Начать сторож слов»
  возвращает «Ход сторожа слов»
  вариант «Ждём каталог»

// Каталог: файл берётся ГОЛОВОЙ списка «файлы» — сегодня он там один; следующий
// станет вторым по счёту тем же путём, если каталог когда-нибудь вырастет.
тотальная функция «Первый файл каталога»
  принимает узел: «Значение json»
  возвращает «Поле json»
  голова («Файлы каталога» от узел)

тотальная функция «После каталога»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Прочитано» с содержимое как текст
      то разбор («Разобрать json» от текст)
        случай вариант «Разобран json» с значение как узел
          то разбор («Первый файл каталога» от узел)
            случай вариант «Поле json» с имя как файл и содержимое как катзап
              то вариант «Сделать» с поручение равным («Спросить ведомость верно» от («От корня» от файл)) и потом равным (вариант «Ждём ведомость» с текстКаталога равным текст и файл равным файл)
        случай любое
          то вариант «Провал» с код равным "FLANG_SLOVO_KATALOG" и сообщение равным "каталог слов не разобрался как JSON"
    случай любое
      то вариант «Провал» с код равным "FLANG_SLOVO_KATALOG" и сообщение равным "каталог слов не прочитан"

тотальная функция «После ведомости»
  принимает файл: строка, текстКаталога: строка, отклик: «Отклик»
  возвращает «Продолжение»
  разбор («Ведомость из отклика» от отклик)
    случай вариант «Ведомость есть» с ведомость как ведомость
      то вариант «Сделать» с поручение равным («Спросить проза» от («От корня» от файл)) и потом равным (вариант «Ждём прозу» с текстКаталога равным текстКаталога и файл равным файл и ведомость равным ведомость)
    случай любое
      то вариант «Провал» с код равным "FLANG_SLOVO_VEDOMOST" и сообщение равным (соединить [файл, ": ведомость не сложилась"] по "")

тотальная функция «После прозы»
  принимает файл: строка, текстКаталога: строка, ведомость: «Значение json», отклик: «Отклик»
  возвращает «Продолжение»
  пусть проза равно («Отклик текстом» от отклик)
  пусть бедыРанние равно («Беды ранних правил» от файл и текстКаталога и ведомость и проза)
  вариант «Сделать» с поручение равным («Спросить дерево» от («От корня» от файл)) и потом равным (вариант «Ждём дерево» с текстКаталога равным текстКаталога и файл равным файл и ведомость равным ведомость и бедыРанние равным бедыРанние)

тотальная функция «После дерева»
  принимает файл: строка, текстКаталога: строка, ведомость: «Значение json», бедыРанние: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор («Дерево из отклика» от отклик)
    случай вариант «Дерево разобрано» с дерево как дерево
      то «Читать» от («От корня» от файл) и (вариант «Ждём исходник» с текстКаталога равным текстКаталога и файл равным файл и ведомость равным ведомость и бедыРанние равным бедыРанние и дерево равным дерево)
    случай любое
      то вариант «Провал» с код равным "FLANG_SLOVO_DEREVO" и сообщение равным (соединить [файл, ": дерево не разобралось"] по "")

тотальная функция «После исходника»
  принимает файл: строка, текстКаталога: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», отклик: «Отклик»
  возвращает «Продолжение»
  пусть исходник равно («Отклик файлом» от отклик)
  пусть голый равно («Без примеров» от исходник)
  вариант «Сделать» с поручение равным («Записать пробу» от («Путь пробы» от («Каталог файла» от файл) и "0") и голый) и потом равным (вариант «Ждём пробу без примеров» с текстКаталога равным текстКаталога и файл равным файл и ведомость равным ведомость и бедыРанние равным бедыРанние и дерево равным дерево и исходник равным исходник)

тотальная функция «Каталог файла»
  принимает файл: строка
  возвращает строка
  «От корня» от («До последней черты» от файл)

тотальная функция «До последней черты»
  принимает путь: строка
  возвращает строка
  пусть куски равно (разделить путь по "/")
  соединить («Взять первые» от куски и ((длина куски) минус 1)) по "/"

тотальная функция «После пробы без примеров»
  принимает файл: строка, текстКаталога: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», исходник: строка, отклик: «Отклик»
  возвращает «Продолжение»
  вариант «Сделать» с поручение равным («Спросить ведомость верно» от («Путь пробы» от («Каталог файла» от файл) и "0")) и потом равным (вариант «Ждём ведомость без примеров» с текстКаталога равным текстКаталога и файл равным файл и ведомость равным ведомость и бедыРанние равным бедыРанние и дерево равным дерево и исходник равным исходник)

// Доказанные утверждения каталога — их «of»/«name» читаются из СВОЕЙ ЖЕ
// ведомости: список доказанных заявок и есть план работы правила 4.
тотальная функция «Доказанные заявки»
  принимает ведомость: «Значение json»
  возвращает список «Заявка»
  отфильтровать («Заявки ведомости» от ведомость) где заявка → (заявка.«verdict» начинается с "proved")

тотальная функция «После ведомости без примеров»
  принимает файл: строка, текстКаталога: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», исходник: строка, отклик: «Отклик»
  возвращает «Продолжение»
  разбор («Ведомость из отклика» от отклик)
    случай вариант «Ведомость есть» с ведомость как безПримеров
      то «Заглушку для» от 1 и текстКаталога и файл и ведомость и бедыРанние и дерево и исходник и безПримеров и (пустой список)
    случай любое
      то вариант «Провал» с код равным "FLANG_SLOVO_PUSTOTA" и сообщение равным (соединить [файл, ": ведомость без примеров не сложилась"] по "")

тотальная функция «Заглушку для»
  принимает индекс: число, текстКаталога: строка, файл: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», исходник: строка, безПримеров: «Значение json», итоги: список «Итог пустоты»
  возвращает «Продолжение»
  убывает (((длина («Доказанные заявки» от ведомость)) плюс 1) минус индекс)
  пусть доказанные равно («Доказанные заявки» от ведомость)
  если индекс больше (длина доказанные)
    то «Начать уборку» от текстКаталога и файл и бедыРанние и итоги
    иначе
      пусть заявка равно (элемент индекс в доказанные)
      пусть функции равно («Элементы узла» от («Поле узла» от дерево и "functions"))
      пусть фн равно («Найти функцию» от функции и (заявка.«of»))
      пусть уже равно (добавить (запись «Итог пустоты» с «of» равным (заявка.«of») и «name» равным (заявка.«name») и «куча» равным "даровое" и «почему» равным "спецификация переписана с тела знак в знак") к итоги)
      если «Тавтология» от фн и (заявка.«name»)
        то «Заглушку для» от (индекс плюс 1) и текстКаталога и файл и ведомость и бедыРанние и дерево и исходник и безПримеров и уже
        иначе
          пусть объТипа равно («Поле узла» от фн и "returns")
          пусть текст равно («Заглушка типа» от объТипа)
          если текст равен ""
            то «Заглушку для» от (индекс плюс 1) и текстКаталога и файл и ведомость и бедыРанние и дерево и исходник и безПримеров и (добавить (запись «Итог пустоты» с «of» равным (заявка.«of») и «name» равным (заявка.«name») и «куча» равным "не судили" и «почему» равным "заглушки для этого типа нет") к итоги)
            иначе
              пусть начало равно («Начало тела» от фн)
              пусть подмена равно («Без примеров» от («Со стеблем» от исходник и начало и текст))
              вариант «Сделать» с поручение равным («Записать пробу» от («Путь пробы» от («Каталог файла» от файл) и (к строке индекс)) и подмена) и потом равным (вариант «Ждём пробу заглушки» с текстКаталога равным текстКаталога и файл равным файл и ведомость равным ведомость и бедыРанние равным бедыРанние и дерево равным дерево и исходник равным исходник и безПримеров равным безПримеров и индекс равным индекс и заявка равным заявка и итоги равным итоги и текст равным текст)

тотальная функция «Начать уборку»
  принимает текстКаталога: строка, файл: строка, бедыРанние: список строки, итоги: список «Итог пустоты»
  возвращает «Продолжение»
  пусть катзап равно («Запись файла» от текстКаталога и файл)
  пусть беды равно («Слить строки» от бедыРанние и («Беды пустоты» от итоги и катзап))
  вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", («Команда уборки» от («Каталог файла» от файл))]) и потом равным (вариант «Ждём уборку проб» с текстКаталога равным текстКаталога и беды равным беды)

тотальная функция «Команда уборки»
  принимает каталог: строка
  возвращает строка
  соединить ["rm -f -- '", каталог, "'/.flang-proba-*.flang"] по ""

тотальная функция «После пробы заглушки»
  принимает файл: строка, текстКаталога: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», исходник: строка, безПримеров: «Значение json», индекс: число, заявка: «Заявка», итоги: список «Итог пустоты», текст: строка, отклик: «Отклик»
  возвращает «Продолжение»
  вариант «Сделать» с поручение равным («Спросить ведомость верно» от («Путь пробы» от («Каталог файла» от файл) и (к строке индекс))) и потом равным (вариант «Ждём ведомость заглушки» с текстКаталога равным текстКаталога и файл равным файл и ведомость равным ведомость и бедыРанние равным бедыРанние и дерево равным дерево и исходник равным исходник и безПримеров равным безПримеров и индекс равным индекс и заявка равным заявка и итоги равным итоги и текст равным текст)

тотальная функция «Почему пустоты»
  принимает куча: строка, текст: строка
  возвращает строка
  если куча равен "про подпись"
    то соединить ["доказано и при теле «", текст, "» — верно про любую функцию этой подписи"] по ""
    иначе соединить ["при теле «", текст, "» отпадает — отличает настоящее тело от подставного"] по ""

тотальная функция «После ведомости заглушки»
  принимает файл: строка, текстКаталога: строка, ведомость: «Значение json», бедыРанние: список строки, дерево: «Значение json», исходник: строка, безПримеров: «Значение json», индекс: число, заявка: «Заявка», итоги: список «Итог пустоты», текст: строка, отклик: «Отклик»
  возвращает «Продолжение»
  разбор («Ведомость из отклика» от отклик)
    случай вариант «Ведомость есть» с ведомость как сЗаглушкой
      то пусть куча равно (если «Осталось доказанным» от сЗаглушкой и заявка то "про подпись" иначе "содержательное")
      «Заглушку для» от (индекс плюс 1) и текстКаталога и файл и ведомость и бедыРанние и дерево и исходник и безПримеров и (добавить (запись «Итог пустоты» с «of» равным (заявка.«of») и «name» равным (заявка.«name») и «куча» равным куча и «почему» равным («Почему пустоты» от куча и текст)) к итоги)
    случай любое
      то «Заглушку для» от (индекс плюс 1) и текстКаталога и файл и ведомость и бедыРанние и дерево и исходник и безПримеров и (добавить (запись «Итог пустоты» с «of» равным (заявка.«of») и «name» равным (заявка.«name») и «куча» равным "не судили" и «почему» равным "исходник с заглушкой отвергнут целиком") к итоги)

тотальная функция «После уборки проб»
  принимает текстКаталога: строка, беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  «Список каталога» от («Каталог фикстур») и (вариант «Ждём список фикстур» с текстКаталога равным текстКаталога и беды равным беды)

тотальная функция «После списка фикстур»
  принимает текстКаталога: строка, беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  «Читать» от («Путь каталога подделок ядра») и (вариант «Ждём ядро подделок» с текстКаталога равным текстКаталога и беды равным беды и имена равным («Отклик списком» от отклик))

тотальная функция «Долг файлы»
  принимает узел: «Значение json»
  возвращает список строки
  отобразить («Состав объекта» от («Поле узла» от узел и "подделки без сторожа")) как штука → («Имя поля json» от штука)

тотальная функция «Итог»
  принимает беды: список строки
  возвращает «Продолжение»
  разбор беды
    случай пусто
      то вариант «Конец работы» с значение равным "сторож слов: нарушений 0"
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_SLOVO_NARUSHENO" и сообщение равным (соединить (приписать (соединить ["сторож слов ОТКАЗЫВАЕТ, бед ", (к строке (длина беды)), ":"] по "") к беды) по "\n  · ")

тотальная функция «После ядра подделок»
  принимает текстКаталога: строка, беды: список строки, имена: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор («Разобрать json» от текстКаталога)
    случай вариант «Разобран json» с значение как узел
      то пусть итог равно («Судить подделки» от имена и («Отклик файлом» от отклик) и (отобразить («Файлы каталога» от узел) как п → («Имя поля json» от п)) и («Долг файлы» от узел))
      «Итог» от («Слить строки» от беды и (итог.«забытые»))
    случай любое
      то вариант «Провал» с код равным "FLANG_SLOVO_KATALOG" и сообщение равным "каталог слов не разобрался как JSON на финальной станции"

тотальная функция «Дальше сторожа слов»
  принимает ход: «Ход сторожа слов», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём каталог»
      то разбор отклик
        случай вариант «Пока ничего»
          то «Читать» от («Путь каталога слов») и (вариант «Ждём каталог»)
        случай любое
          то «После каталога» от отклик
    случай вариант «Ждём ведомость» с текстКаталога как текстКаталога и файл как файл
