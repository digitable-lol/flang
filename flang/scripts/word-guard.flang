    запись «Заглушка» с «тип» равным "вес" и «текст» равным "0",
    запись «Заглушка» с «тип» равным "стоимость" и «текст» равным "0",
    запись «Заглушка» с «тип» равным "сотых" и «текст» равным "0",
    запись «Заглушка» с «тип» равным "тысячных" и «текст» равным "0",
    запись «Заглушка» с «тип» равным "nat" и «текст» равным "0",
    запись «Заглушка» с «тип» равным "integer" и «текст» равным "0",
    запись «Заглушка» с «тип» равным "weight" и «текст» равным "0",
    запись «Заглушка» с «тип» равным "cost" и «текст» равным "0"
  ]

тотальная функция «Заглушка типа»
  принимает типУзлом: «Значение json»
  возвращает строка
  пример «Именованный неотрицательный тип — ноль»
    дано типУзлом равно вариант «Объект json» с состав равным [вариант «Поле json» с имя равным "kind" и содержимое равным (вариант «Текст json» с текст равным "named"), вариант «Поле json» с имя равным "name" и содержимое равным (вариант «Текст json» с текст равным "неотрицательное")]
    ожидается "0"
  пример «Строка — пустая строка»
    дано типУзлом равно вариант «Объект json» с состав равным [вариант «Поле json» с имя равным "kind" и содержимое равным (вариант «Текст json» с текст равным "string")]
    ожидается "\"\""
  пусть вид равно («Текст узла» от («Поле узла» от типУзлом и "kind"))
  пусть имя равно (если вид равен "named" то «Текст узла» от («Поле узла» от типУзлом и "name") иначе вид)
  свёртка («Заглушки») начиная с "" как найдено и заглушка → (если (заглушка.«тип») равен имя то заглушка.«текст» иначе найдено)

тотальная функция «Первая без отступа»
  принимает остаток: список строки, номер: число, всего: число
  возвращает число
  разбор остаток
    случай пусто
      то всего
    случай голова и хвост
      то если ((длина голова) больше 0) и притом (не («Пробельный знак» от («Начало текста» от голова и 1)))
        то номер
        иначе «Первая без отступа» от хвост и (номер плюс 1) и всего

тотальная функция «Без хвостовой пустоты»
  принимает строки: список строки, первая: число, конец: число
  возвращает число
  убывает конец
  если (конец не больше первая) или (конец не больше 0)
    то конец
    иначе если «Пустая строка ли» от (элемент конец в строки)
      то «Без хвостовой пустоты» от строки и первая и (конец минус 1)
      иначе конец

тотальная функция «Со стеблем»
  принимает исходник: строка, строкаТела: число, текст: строка
  возвращает строка
  пример «Тело заменено заглушкой, пустая строка и следующее объявление на месте»
    дано исходник равно "функция «Ф»\n  возвращает строка\n  \"абвг\"\n\n// дальше\nфункция «Г»"
    дано строкаТела равно 3
    дано текст равно "\"\""
    ожидается "функция «Ф»\n  возвращает строка\n  \"\"\n\n// дальше\nфункция «Г»"
  пусть строки равно (разделить исходник по "\n")
  пусть первая равно (строкаТела минус 1)
  пусть сырой равно («Первая без отступа» от («Отбросить первые» от строки и первая) и первая и (длина строки))
  пусть конец равно («Без хвостовой пустоты» от строки и первая и сырой)
  соединить («Соединить списки» от («Взять первые» от строки и первая) и (приписать (соединить ["  ", текст] по "") к («Отбросить первые» от строки и конец))) по "\n"

тотальная функция «Отступ символов»
  принимает символы: список строки
  возвращает число
  разбор символы
    случай пусто
      то 0
    случай голова и хвост
      то если «Пробельный знак» от голова
        то 1 плюс («Отступ символов» от хвост)
        иначе 0

тотальная функция «Отступ строки»
  принимает строка: строка
  возвращает число
  «Отступ символов» от (разложить строка на символы)

тотальная функция «Шапка слова»
  принимает остаток: строка, слово: строка
  возвращает признак
  пусть следующий равно («Начало текста» от («Хвост после» от остаток и (длина слово)) и 1)
  (остаток начинается с слово) и притом ((следующий равен "") или («Пробельный знак» от следующий))

тотальная функция «Строка примера»
  принимает строка: строка
  возвращает признак
  пример «Шапка примера»
    дано строка равно "  пример «азбука та самая»"
    ожидается да
  пример «Слово, начатое с пример, шапкой не является»
    дано строка равно "  примерно так"
    ожидается нет
  пусть остаток равно («Хвост после» от строка и («Отступ строки» от строка))
  («Шапка слова» от остаток и "пример") или («Шапка слова» от остаток и "example")

объект «Ход без примеров»
  «пропуск»: признак
  «глубина»: число
  «вывод»: список строки

тотальная функция «Шаг без примеров стартовый»
  принимает ход: «Ход без примеров», строка: строка
  возвращает «Ход без примеров»
  если «Строка примера» от строка
    то запись «Ход без примеров» с «пропуск» равным да и «глубина» равным («Отступ строки» от строка) и «вывод» равным (ход.«вывод»)
    иначе запись «Ход без примеров» с «пропуск» равным нет и «глубина» равным 0 и «вывод» равным (добавить строка к (ход.«вывод»))

тотальная функция «Шаг без примеров»
  принимает ход: «Ход без примеров», строка: строка
  возвращает «Ход без примеров»
  если (ход.«пропуск») и притом ((«Пустая строка ли» от строка) или ((«Отступ строки» от строка) больше (ход.«глубина»)))
    то ход
    иначе «Шаг без примеров стартовый» от ход и строка

тотальная функция «Без примеров»
  принимает исходник: строка
  возвращает строка
  пример «Пример снят вместе со своими строками»
    дано исходник равно "функция «Ф»\n  пример «п»\n    ожидается 1\n\n  1"
    ожидается "функция «Ф»\n  1"
  пусть итог равно (свёртка (разделить исходник по "\n") начиная с (запись «Ход без примеров» с «пропуск» равным нет и «глубина» равным 0 и «вывод» равным (пустой список)) как ход и строка → «Шаг без примеров» от ход и строка)
  соединить (итог.«вывод») по "\n"

тотальная функция «Найти функцию»
  принимает функции: список «Значение json», имя: строка
  возвращает «Значение json»
  разбор функции
    случай пусто
      то вариант «Ничто json»
    случай голова и хвост
      то если («Текст узла» от («Поле узла» от голова и "name")) равен имя
        то голова
        иначе «Найти функцию» от хвост и имя

тотальная функция «Переменная результат»
  принимает узел: «Значение json»
  возвращает признак
  ((«Текст узла» от («Поле узла» от узел и "kind")) равен "var") и притом ((«Текст узла» от («Поле узла» от узел и "name")) равен "результат")

тотальная функция «Тавтология»
  принимает функцияУзлом: «Значение json», имяУтверждения: строка
  возвращает признак
  пусть постусловие равно («Найти функцию» от («Элементы узла» от («Поле узла» от функцияУзлом и "postconditions")) и имяУтверждения)
  пусть выражение равно («Поле узла» от постусловие и "expr")
  пусть левая равно («Поле узла» от выражение и "left")
  пусть правая равно («Поле узла» от выражение и "right")
  пусть равенство равно (((«Текст узла» от («Поле узла» от выражение и "kind")) равен "binary") и притом ((«Текст узла» от («Поле узла» от выражение и "op")) равен "eq"))
  пусть другая равно (если «Переменная результат» от левая то правая иначе (если «Переменная результат» от правая то левая иначе (вариант «Ничто json»)))
  (не (постусловие равен (вариант «Ничто json»))) и притом (равенство и притом ((не (другая равен (вариант «Ничто json»))) и притом ((«Без места» от другая) равен («Без места» от («Поле узла» от функцияУзлом и "body")))))

объект «Прогон»
  «код»: число
  «вывод»: строка
  «ошибки»: строка

тотальная функция «Прогон из отклика»
  принимает отклик: «Отклик»
  возвращает «Прогон»
  пример «Код и вывод берутся как есть»
    дано отклик равно вариант «Процесс завершён» с код равным 3 и вывод равным "{}" и ошибки равным ""
    ожидается запись «Прогон» с «код» равным 3 и «вывод» равным "{}" и «ошибки» равным ""
  пример «Убитый сигналом — код 1, как status null у spawnSync»
    дано отклик равно вариант «Процесс убит» с сигнал равным "SIG9" и вывод равным "" и ошибки равным ""
    ожидается запись «Прогон» с «код» равным 1 и «вывод» равным "" и «ошибки» равным ""
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то запись «Прогон» с «код» равным код и «вывод» равным вывод и «ошибки» равным ошибки
    случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
      то запись «Прогон» с «код» равным 1 и «вывод» равным вывод и «ошибки» равным ошибки
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то запись «Прогон» с «код» равным 1 и «вывод» равным "" и «ошибки» равным (соединить [код, ": ", сообщение] по "")
    случай любое
      то запись «Прогон» с «код» равным 1 и «вывод» равным "" и «ошибки» равным "хозяин ответил не завершением процесса"

объект «Разбор»
  «годен»: признак
  «узел»: «Значение json»
  «почему»: строка

тотальная функция «Негоден»
  принимает почему: строка
  возвращает «Разбор»
  запись «Разбор» с «годен» равным нет и «узел» равным (вариант «Ничто json») и «почему» равным почему

тотальная функция «Ошибки или вывод»
  принимает ответПроцесса: «Прогон»
  возвращает строка
  пример «Пустые ошибки уступают выводу, как || в JavaScript»
    дано ответПроцесса равно запись «Прогон» с «код» равным 1 и «вывод» равным " вывод " и «ошибки» равным ""
    ожидается "вывод"
  «Обрезать края» от (если (ответПроцесса.«ошибки») равен "" то ответПроцесса.«вывод» иначе ответПроцесса.«ошибки»)

тотальная функция «Разбор ведомости»
  принимает ответПроцесса: «Прогон»
  возвращает «Разбор»
  пример «Код 1 с ошибками — ведомости нет, причина словами двоичного»
    дано ответПроцесса равно запись «Прогон» с «код» равным 1 и «вывод» равным "" и «ошибки» равным "FLANG_TYPE: беда\n"
    ожидается запись «Разбор» с «годен» равным нет и «узел» равным (вариант «Ничто json») и «почему» равным "FLANG_TYPE: беда"
  если ((ответПроцесса.«код») равен 0) или ((ответПроцесса.«ошибки») равен "")
    то разбор («Разобрать json» от (ответПроцесса.«вывод»))
      случай вариант «Разобран json» с значение как значение
        то запись «Разбор» с «годен» равным ((ответПроцесса.«код») равен 0) и «узел» равным значение и «почему» равным ""
      случай любое
        то «Негоден» от («Ошибки или вывод» от ответПроцесса)
    иначе «Негоден» от («Обрезать края» от (ответПроцесса.«ошибки»))

тотальная функция «Разбор дерева»
  принимает ответПроцесса: «Прогон»
  возвращает «Разбор»
  если не ((ответПроцесса.«код») равен 0)
    то «Негоден» от («Ошибки или вывод» от ответПроцесса)
    иначе разбор («Разобрать json» от (ответПроцесса.«вывод»))
      случай вариант «Разобран json» с значение как значение
        то запись «Разбор» с «годен» равным да и «узел» равным значение и «почему» равным ""
      случай вариант «Не разобран json» с причина как причина
        то «Негоден» от (соединить ["дерево не разобралось как JSON: ", причина] по "")

тотальная функция «Разбор пробы»
  принимает ответПроцесса: «Прогон»
  возвращает «Разбор»
  пример «Код 1 — пробе судить нечем, JSON не разбирается вовсе»
    дано ответПроцесса равно запись «Прогон» с «код» равным 1 и «вывод» равным "{}" и «ошибки» равным ""
    ожидается запись «Разбор» с «годен» равным нет и «узел» равным (вариант «Ничто json») и «почему» равным "код 1"
  если ((ответПроцесса.«код») равен 0) или ((ответПроцесса.«код») равен 3)
    то разбор («Разобрать json» от (ответПроцесса.«вывод»))
      случай вариант «Разобран json» с значение как значение
        то запись «Разбор» с «годен» равным да и «узел» равным значение и «почему» равным ""
      случай вариант «Не разобран json» с причина как причина
        то «Негоден» от причина
    иначе «Негоден» от (соединить ["код ", (к строке (ответПроцесса.«код»))] по "")

