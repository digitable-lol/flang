        и («Связки законов текстом» от (соединить ["«", «фа», "»"] по "") и ["х"])
        и («Вызов законов текстом» от «на б» и [(«Вызов законов текстом» от «по ф» и ["х"])])
        и («Вызов законов текстом» от «по г» и [(«Вызов законов текстом» от «на а» и ["х"])]))]

