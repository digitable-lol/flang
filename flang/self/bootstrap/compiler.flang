      («Ёлочка законов текстом» от «п» и 1), "» отображается в морфизм «", («Ёлочка законов текстом» от «п» и 2),
      "»"] по ""))
  отобразить «свои» как «п» → («Ёлочка законов текстом» от «п» и 1)

тотальная функция «Квадрат функтора текстом»
  принимает «ф»: «Объявление закона текстом», «все»: список «Объявление закона текстом», «стрелка»: строка
  возвращает список «Закон текстом»
  пусть «а» равно («Конец стрелки законов текстом» от «все» и «стрелка» и 2)
  пусть «б» равно («Конец стрелки законов текстом» от «все» и «стрелка» и 3)
  пусть «тело» равно («Даёт по имени законов текстом» от «все» и «стрелка»)
  пусть «образ» равно («Даёт по имени законов текстом» от «все» и («Образ стрелки законов текстом» от «ф» и «стрелка»))
  пусть «перевод а» равно («Образ объекта законов текстом» от «ф» и «а» и 3)
  пусть «перевод б» равно («Образ объекта законов текстом» от «ф» и «б» и 3)
  если (((длина «тело») равен 0) или ((длина «образ») равен 0) или ((длина «перевод а») равен 0)
      или ((длина «перевод б») равен 0))
    то пустой список
    иначе [(«Закон законов текстом» от («Ёлочка законов текстом» от («ф».«заголовок») и 1)
        и (соединить ["квадрат на ", «стрелка»] по "") и («Связки законов текстом» от (соединить ["«", «а», "»"] по "")
        и ["х"]) и («Вызов законов текстом» от «перевод б» и [(«Вызов законов текстом» от «тело» и ["х"])])
        и («Вызов законов текстом» от «образ» и [(«Вызов законов текстом» от «перевод а» и ["х"])]))]

тотальная функция «Законы функтора текстом»
  принимает «ф»: «Объявление закона текстом», «все»: список «Объявление закона текстом»
