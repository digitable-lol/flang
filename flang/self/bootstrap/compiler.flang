  пусть «т» равно («Поле объявления законов текстом» от «о» и "носитель ")
  пусть «оп» равно («Имя поля законов текстом» от «о» и "операция ")
  пусть «е» равно («Поле объявления законов текстом» от «о» и "единица ")
  пусть «обр» равно («Имя поля законов текстом» от «о» и "обратный элемент ")
  пусть «один» равно («Связки законов текстом» от «т» и ["а"])
  пусть «три» равно («Связки законов текстом» от «т» и ["а", "б", "ц"])
  пусть «ед» равно (соединить ["(", «е», ")"] по "")
  пусть «сочетательность» равно [(«Закон законов текстом» от «имя» и "ассоциативность" и «три»
      и («Вызов законов текстом» от «оп» и [(«Вызов законов текстом» от «оп» и ["а", "б"]), "ц"])
      и («Вызов законов текстом» от «оп» и ["а", («Вызов законов текстом» от «оп» и ["б", "ц"])]))]
  пусть «единицы» равно [(«Закон законов текстом» от «имя» и "единица слева" и «один»
      и («Вызов законов текстом» от «оп» и [«ед», "а"]) и "а"),
      («Закон законов текстом» от «имя» и "единица справа" и «один» и («Вызов законов текстом» от «оп»
          и ["а", «ед»]) и "а")]
  пусть «обратные» равно [(«Закон законов текстом» от «имя» и "обратный слева" и «один»
      и («Вызов законов текстом» от «оп» и [(«Вызов законов текстом» от «обр» и ["а"]), "а"]) и «ед»),
      («Закон законов текстом» от «имя» и "обратный справа" и «один»
      и («Вызов законов текстом» от «оп» и ["а", («Вызов законов текстом» от «обр» и ["а"])]) и «ед»)]
  пусть «с единицей» равно ((длина «е») больше 0) и притом («Скобки сошлись законов текстом» от «е»)
  пусть «основа» равно ((((длина «т») больше 0) и притом ((длина «оп») больше 0))
      и притом («Скобки сошлись законов текстом» от «т»))
  пусть «первые» равно (если «основа» то «сочетательность» иначе пустой список)
  пусть «вторые» равно (если «основа» и притом «с единицей» то «единицы» иначе пустой список)
  пусть «с обратным» равно (((«основа» и притом «с единицей»)) и притом ((длина «обр») больше 0))
  пусть «третьи» равно (если «с обратным» то «обратные» иначе пустой список)
  «Сложить законы текстом» от («Сложить законы текстом» от «первые» и «вторые») и «третьи»

тотальная функция «Сложить законы текстом»
  принимает «первые»: список «Закон текстом», «вторые»: список «Закон текстом»
  возвращает список «Закон текстом»
  свёртка «вторые» начиная с «первые» как «акк» и «з» → добавить «з» к «акк»

тотальная функция «Законы свойства текстом»
  принимает «о»: «Объявление закона текстом», «вид»: строка
  возвращает список «Закон текстом»
  пусть «т» равно («Поле объявления законов текстом» от «о» и "носитель ")
  пусть «оп» равно («Имя поля законов текстом» от «о» и "операция ")
  пусть «по» равно («Имя поля законов текстом» от «о» и "по ")
  пусть «два» равно («Связки законов текстом» от «т» и ["а", "б"])
  пусть «три» равно («Связки законов текстом» от «т» и ["а", "б", "ц"])
  пусть «перестановка» равно [(«Закон законов текстом» от «оп» и "коммутативность" и «два»
      и («Вызов законов текстом» от «оп» и ["а", "б"]) и («Вызов законов текстом» от «оп» и ["б", "а"]))]
  пусть «слева» равно («Закон законов текстом» от «оп» и "дистрибутивность слева" и «три»
      и («Вызов законов текстом» от «оп» и ["а", («Вызов законов текстом» от «по» и ["б", "ц"])])
      и («Вызов законов текстом» от «по» и [(«Вызов законов текстом» от «оп» и ["а", "б"]),
          («Вызов законов текстом» от «оп» и ["а", "ц"])]))
  пусть «справа» равно («Закон законов текстом» от «оп» и "дистрибутивность справа" и «три»
      и («Вызов законов текстом» от «оп» и [(«Вызов законов текстом» от «по» и ["а", "б"]), "ц"])
      и («Вызов законов текстом» от «по» и [(«Вызов законов текстом» от «оп» и ["а", "ц"]),
          («Вызов законов текстом» от «оп» и ["б", "ц"])]))
  пусть «основа» равно ((((длина «т») больше 0) и притом ((длина «оп») больше 0))
      и притом («Скобки сошлись законов текстом» от «т»))
  пусть «первые» равно (если «основа» и притом («вид» равен "коммутативность") то «перестановка» иначе пустой список)
  пусть «дистрибутивные» равно («основа» и притом («вид» равен "дистрибутивность")) и притом ((длина «по») больше 0)
  «Сложить законы текстом» от «первые» и (если «дистрибутивные» то [«слева», «справа»] иначе пустой список)

тотальная функция «Объявления вида законов текстом»
  принимает «все»: список «Объявление закона текстом», «вид»: строка, «имя»: строка
  возвращает список «Объявление закона текстом»
  отфильтровать «все» где «о» → (((«Вид объявления законов текстом» от «о») равен «вид»)
      и притом ((«Ёлочка законов текстом» от («о».«заголовок») и 1) равен «имя»))

тотальная функция «Даёт стрелки законов текстом»
  принимает «все»: список «Объявление закона текстом», «стрелка»: строка, «из»: строка, «в»: строка
  возвращает строка
  пусть «свои» равно (отфильтровать («Объявления вида законов текстом» от «все» и "морфизм" и «стрелка»)
      где «о» → (((«Ёлочка законов текстом» от («о».«заголовок») и 2) равен «из»)
      и притом ((«Ёлочка законов текстом» от («о».«заголовок») и 3) равен «в»)))
  если пусто «свои»
    то ""
    иначе «Имя поля законов текстом» от (голова «свои») и "даёт "

тотальная функция «Конец стрелки законов текстом»
  принимает «все»: список «Объявление закона текстом», «стрелка»: строка, «номер»: число
  возвращает строка
  пусть «свои» равно («Объявления вида законов текстом» от «все» и "морфизм" и «стрелка»)
  если пусто «свои»
    то ""
    иначе «Ёлочка законов текстом» от ((голова «свои»).«заголовок») и «номер»

тотальная функция «Даёт по имени законов текстом»
  принимает «все»: список «Объявление закона текстом», «стрелка»: строка
  возвращает строка
  («Даёт стрелки законов текстом» от «все» и «стрелка» и («Конец стрелки законов текстом» от «все» и «стрелка» и 2)
      и («Конец стрелки законов текстом» от «все» и «стрелка» и 3))

тотальная функция «Законы изоморфизма текстом»
  принимает «о»: «Объявление закона текстом», «все»: список «Объявление закона текстом»
  возвращает список «Закон текстом»
  пусть «имя» равно («Ёлочка законов текстом» от («о».«заголовок») и 1)
  пусть «а» равно («Ёлочка законов текстом» от («о».«заголовок») и 2)
  пусть «б» равно («Ёлочка законов текстом» от («о».«заголовок») и 3)
  пусть «туда» равно («Даёт стрелки законов текстом» от «все» и («Имя поля законов текстом» от «о» и "прямой морфизм ")
      и «а» и «б»)
  пусть «обратно» равно («Даёт стрелки законов текстом» от «все»
      и («Имя поля законов текстом» от «о» и "обратный морфизм ") и «б» и «а»)
  если ((длина «туда») равен 0) или ((длина «обратно») равен 0)
    то пустой список
    иначе [(«Закон законов текстом» от «имя» и "обратный после прямого"
        и («Связки законов текстом» от (соединить ["«", «а», "»"] по "") и ["х"])
        и («Вызов законов текстом» от «обратно» и [(«Вызов законов текстом» от «туда» и ["х"])]) и "х"),
      («Закон законов текстом» от «имя» и "прямой после обратного"
        и («Связки законов текстом» от (соединить ["«", «б», "»"] по "") и ["х"])
        и («Вызов законов текстом» от «туда» и [(«Вызов законов текстом» от «обратно» и ["х"])]) и "х")]

тотальная функция «Образ объекта законов текстом»
  принимает «ф»: «Объявление закона текстом», «объект»: строка, «номер»: число
  возвращает строка
  пример «перевод третьим именем»
    дано «ф» равно (запись «Объявление закона текстом» с «заголовок» равным "функтор «Ф» из «А» в «Б»"
      и «поля» равным ["объект «Заказ» отображается в «Платёж» даёт «Перевести»"] и «годно» равным да)
    дано «объект» равно "Заказ"
    дано «номер» равно 3
    ожидается "Перевести"
  пусть «свои» равно (отфильтровать («ф».«поля») где «п» → («Ёлочка законов текстом» от «п» и 1) равен «объект»)
  пусть «годные» равно (отфильтровать «свои» где «п» → («Поле образа законов текстом» от «п»))
  если пусто «годные»
    то ""
    иначе «Ёлочка законов текстом» от (голова «годные») и «номер»

тотальная функция «Поле образа законов текстом»
  принимает «п»: строка
  возвращает признак
  пример «объект с переводом»
    дано «п» равно "объект «А» отображается в «Б» даёт «Ф»"
    ожидается да
  пусть «а» равно («Ёлочка законов текстом» от «п» и 1)
  пусть «б» равно («Ёлочка законов текстом» от «п» и 2)
  пусть «начало» равно (соединить ["объект «", «а», "» отображается в «", «б», "»"] по "")
  («п» равен «начало») или («п» равен (соединить [«начало», " даёт «", («Ёлочка законов текстом» от «п»
      и 3), "»"] по ""))

тотальная функция «Образ стрелки законов текстом»
  принимает «ф»: «Объявление закона текстом», «стрелка»: строка
  возвращает строка
  пусть «свои» равно (отфильтровать («ф».«поля») где «п» → «п» равен (соединить ["морфизм «", «стрелка»,
      "» отображается в морфизм «", («Ёлочка законов текстом» от «п» и 2), "»"] по ""))
  если пусто «свои»
    то ""
    иначе «Ёлочка законов текстом» от (голова «свои») и 2

тотальная функция «Стрелки функтора законов текстом»
  принимает «ф»: «Объявление закона текстом»
  возвращает список строки
