  вариант «Значение записи» с «поля» равным «поля»

тотальная функция «Узел списка»
  принимает «элементы»: список «Значение»
  возвращает «Значение»
  обеспечивает «в узле списка ровно те элементы, что дали» (длина («Элементы узла» от результат)) равен (длина «элементы»)
  пример «Список без элементов — всё ещё список»
    дано «элементы» равно пустой список
    ожидается (вариант «Значение списка» с «элементы» равным пустой список)
  вариант «Значение списка» с «элементы» равным «элементы»

тотальная функция «Узел типа поля»
  принимает «вид»: строка
  возвращает «Значение»
  обеспечивает «узел типа поля несёт ключ kind» («Есть поле у узла» от результат и "kind")
  «Узел записи» от [(«Поле документа» от "kind" и («Узел строки» от «вид»))]

тотальная функция «Узел поля варианта»
  принимает «имя»: строка, «вид»: строка
  возвращает «Значение»
  обеспечивает «узел поля варианта несёт и name, и type» («Есть поле у узла» от результат и "name") и притом («Есть поле у узла» от результат и "type")
  «Узел записи» от [(«Поле документа» от "name" и («Узел строки» от «имя»)), («Поле документа» от "type" и («Узел типа поля» от «вид»))]

тотальная функция «Тип исхода числа»
  возвращает «Значение»
  обеспечивает «тип исхода зовётся именем типа исхода» («Строка поля» от результат и "name") равен («Имя типа исхода»)
  пример «Сумма исхода числа целиком»
    ожидается (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "sum"))), (запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "Исход числа"))), (запись «Поле значения» с «ключ» равным "builtin" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр признак» с «значение» равным да))), (запись «Поле значения» с «ключ» равным "variants" и «значение» равным (вариант «Значение списка» с «элементы» равным [(вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "Разобрано"))), (запись «Поле значения» с «ключ» равным "fields" и «значение» равным (вариант «Значение списка» с «элементы» равным [(вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "значение"))), (запись «Поле значения» с «ключ» равным "type" и «значение» равным (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "number")))]))])]))]), (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "Не разобрано"))), (запись «Поле значения» с «ключ» равным "fields" и «значение» равным (вариант «Значение списка» с «элементы» равным [(вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "код"))), (запись «Поле значения» с «ключ» равным "type" и «значение» равным (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "string")))]))]), (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "сообщение"))), (запись «Поле значения» с «ключ» равным "type" и «значение» равным (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "string")))]))])]))])]))])
  «Узел записи» от [
    («Поле документа» от "kind" и («Узел строки» от "sum")),
    («Поле документа» от "name" и («Узел строки» от («Имя типа исхода»))),
    («Поле документа» от "builtin" и («Узел признака» от да)),
    («Поле документа» от "variants" и («Узел списка» от [
      («Узел записи» от [
        («Поле документа» от "name" и («Узел строки» от («Имя разобранного»))),
        («Поле документа» от "fields" и («Узел списка» от [(«Узел поля варианта» от "значение" и "number")]))
      ]),
      («Узел записи» от [
        («Поле документа» от "name" и («Узел строки» от («Имя неразобранного»))),
        («Поле документа» от "fields" и («Узел списка» от [(«Узел поля варианта» от "код" и "string"), («Узел поля варианта» от "сообщение" и "string")]))
      ])
    ]))
  ]

тотальная функция «Занятые имена типов»
  принимает «программа»: «Значение»
  возвращает список строки
  обеспечивает «программа без объявлений не занимает имён» если пусто («Элементы поля» от «программа» и "types") то пусто результат иначе да
  свёртка («Элементы поля» от «программа» и "types") начиная с пустой список как «собрано» и «тип»
    «Слить строки» от («Слить строки» от «собрано» и («Имя объявления» от «тип»)) и («Имена вариантов объявления» от «тип»)

тотальная функция «Слить строки»
  принимает «первые»: список строки, «вторые»: список строки
  возвращает список строки
  обеспечивает «слияние длиннее первого списка ровно на второй» (длина результат) равен ((длина «первые») плюс (длина «вторые»))
  пример «К пустому левому списку правый переходит целиком»
    дано «первые» равно пустой список
    дано «вторые» равно ["а"]
    ожидается ["а"]
  свёртка «вторые» начиная с «первые» как «собрано» и «строка» → добавить «строка» к «собрано»

тотальная функция «Имя объявления»
  принимает «тип»: «Значение»
  возвращает список строки
  обеспечивает «имён у объявления не больше одного» (длина результат) не больше 1
  пример «У объявления без имени имён нет»
    дано «тип» равно (вариант «Значение записи» с «поля» равным пустой список)
    ожидается пустой список
  если «Это строка» от («Взять поле» от «тип» и "name")
    то [(«Строка поля» от «тип» и "name")]
    иначе пустой список

тотальная функция «Имена вариантов объявления»
  принимает «тип»: «Значение»
  возвращает список строки
  обеспечивает «имён вариантов не больше, чем самих вариантов» (длина результат) не больше (длина («Элементы поля» от «тип» и "variants"))
  свёртка («Элементы поля» от «тип» и "variants") начиная с пустой список как «собрано» и «в»
    «Слить строки» от «собрано» и («Имя объявления» от «в»)

тотальная функция «Приписать тип исхода»
  принимает «программа»: «Значение»
  возвращает «Значение»
  обеспечивает «при занятых именах программа остаётся собой» если «Имена исхода заняты» от («Занятые имена типов» от «программа») то результат равен «программа» иначе да
  пример «Занятое имя не переопределяется молча»
    дано «программа» равно (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "types" и «значение» равным (вариант «Значение списка» с «элементы» равным [(вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "Исход числа")))])]))])
    ожидается (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "types" и «значение» равным (вариант «Значение списка» с «элементы» равным [(вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "Исход числа")))])]))])
  если «Имена исхода заняты» от («Занятые имена типов» от «программа»)
    то «программа»
    иначе «С добавленным типом» от «программа»

тотальная функция «Имена исхода заняты»
  принимает «занятые»: список строки
  возвращает признак
  обеспечивает «пустой список имён ничего не занимает» если пусто «занятые» то результат равен нет иначе да
  пример «свободные имена не заняты»
    дано «занятые» равно ["Дерево", "Лист"]
    ожидается нет
  пример «занятое имя типа ловится»
    дано «занятые» равно ["Исход числа"]
    ожидается да
  пример «занятое имя варианта ловится»
    дано «занятые» равно ["Разобрано"]
    ожидается да
  не (пусто (отфильтровать («Имена исхода») где «имя» → «занятые» содержит «имя»))

тотальная функция «С добавленным типом»
  принимает «программа»: «Значение»
  возвращает «Значение»
  обеспечивает «у программы с приписанным типом есть поле types» («Есть поле у узла» от результат и "types")
  если «Есть поле у узла» от «программа» и "types"
    то «Узел записи» от (отобразить («Поля узла» от «программа») как «поле» → если («поле».«ключ») равен "types" то («Поле документа» от "types" и («Узел списка» от (добавить («Тип исхода числа») к («Элементы поля» от «программа» и "types")))) иначе «поле»)
    иначе «Узел записи» от (добавить («Поле документа» от "types" и («Узел списка» от [(«Тип исхода числа»)])) к («Поля узла» от «программа»))

тотальная функция «Значения равны»
  принимает «левое»: «Значение», «правое»: «Значение»
  возвращает признак
  обеспечивает «список равен только списку» если («Это список» от «левое») и притом (не («Это список» от «правое»)) то результат равен нет иначе да
  разбор «левое»
    случай вариант «Значение скаляра» с «скаляр» как «скаляр»
      то «Скаляр равен значению» от «скаляр» и «правое»
    случай вариант «Значение списка» с «элементы» как «элементы»
      то если «Это список» от «правое»
        то «Списки значений равны» от «элементы» и («Элементы узла» от «правое»)
        иначе нет
    случай вариант «Значение записи» с «поля» как «поля»
      то если «Это вариант» от «левое»
        то если («Это вариант» от «правое») и притом ((«Имя варианта» от «левое») равен («Имя варианта» от «правое»))
          то «Поля варианта равны» от «поля» и («Поля узла» от («Взять поле» от «правое» и "fields"))
          иначе нет
        иначе если («Это запись» от «правое») и притом (не («Это вариант» от «правое»))
          то «Записи значений равны» от «поля» и («Поля узла» от «правое»)
          иначе нет

тотальная функция «Скаляр равен значению»
  принимает «скаляр»: «Скаляр», «правое»: «Значение»
  возвращает признак
  обеспечивает «скаляр не равен списку» если «Это список» от «правое» то результат равен нет иначе да
  разбор «правое»
    случай вариант «Значение скаляра» с «скаляр» как «другой»
      то «Скаляры равны» от «скаляр» и «другой»
    случай любое
      то нет

тотальная функция «Скаляры равны»
  принимает «левый»: «Скаляр», «правый»: «Скаляр»
  возвращает признак
  обеспечивает «ничто равно только ничему» если «Это ничто» от «левый» то результат равен («Это ничто» от «правый») иначе да
  разбор «левый»
    случай вариант «Скаляр строка» с «значение» как «значение»
      то «Строка равна скаляру» от «значение» и «правый»
    случай вариант «Скаляр число» с «значение» как «значение»
      то «Число равно скаляру» от «значение» и «правый»
    случай вариант «Скаляр признак» с «значение» как «значение»
      то «Признак равен скаляру» от «значение» и «правый»
    случай «Скаляр ничто»
      то «Это ничто» от «правый»

тотальная функция «Строка равна скаляру»
  принимает «текст»: строка, «правый»: «Скаляр»
  возвращает признак
  обеспечивает «строка сравнивается как скаляр-строка» результат равен («Скаляры равны» от (вариант «Скаляр строка» с «значение» равным «текст») и «правый»)
  пример «Пустая строка ничему не равна»
    дано «текст» равно ""
    дано «правый» равно (вариант «Скаляр ничто»)
    ожидается нет
  разбор «правый»
    случай вариант «Скаляр строка» с «значение» как «другой»
      то «текст» равен «другой»
    случай любое
      то нет

тотальная функция «Число равно скаляру»
  принимает «число»: число, «правый»: «Скаляр»
  возвращает признак
  обеспечивает «число сравнивается как скаляр-число» результат равен («Скаляры равны» от (вариант «Скаляр число» с «значение» равным «число») и «правый»)
  пример «минус ноль не равен нулю»
    дано «число» равно -0
    дано «правый» равно (вариант «Скаляр число» с «значение» равным 0)
    ожидается нет
  пример «ноль равен нулю»
    дано «число» равно 0
    дано «правый» равно (вариант «Скаляр число» с «значение» равным 0)
    ожидается да
  пример «минус ноль равен минус нулю»
    дано «число» равно -0
    дано «правый» равно (вариант «Скаляр число» с «значение» равным -0)
    ожидается да
  разбор «правый»
    случай вариант «Скаляр число» с «значение» как «другое»
      то «число» равен «другое»
    случай любое
      то нет

тотальная функция «Признак равен скаляру»
  принимает «признак»: признак, «правый»: «Скаляр»
  возвращает признак
  обеспечивает «признак сравнивается как скаляр-признак» результат равен («Скаляры равны» от (вариант «Скаляр признак» с «значение» равным «признак») и «правый»)
  пример «Истина лжи не равна»
    дано «признак» равно да
    дано «правый» равно (вариант «Скаляр признак» с «значение» равным нет)
    ожидается нет
  разбор «правый»
    случай вариант «Скаляр признак» с «значение» как «другой»
      то «признак» равен «другой»
    случай любое
      то нет

тотальная функция «Это ничто»
  принимает «скаляр»: «Скаляр»
  возвращает признак
  обеспечивает «ничто узнаётся сравнением со скаляром ничто» результат равен («Скаляры равны» от «скаляр» и (вариант «Скаляр ничто»))
  разбор «скаляр»
    случай «Скаляр ничто»
      то да
    случай любое
      то нет

тотальная функция «Списки значений равны»
  принимает «первые»: список «Значение», «вторые»: список «Значение»
  возвращает признак
  обеспечивает «списки разной длины не равны» если (длина «первые») не равен (длина «вторые») то результат равен нет иначе да
  разбор «первые»
    случай пусто
      то пусто «вторые»
    случай голова «левый» и хвост «левые»
      то разбор «вторые»
        случай пусто
          то нет
        случай голова «правый» и хвост «правые»
          то («Значения равны» от «левый» и «правый») и притом («Списки значений равны» от «левые» и «правые»)

тотальная функция «Поля варианта равны»
  принимает «поля»: список «Поле значения», «правые»: список «Поле значения»
  возвращает признак
  обеспечивает «без полей равенства вариантов нет» если пусто «поля» то результат равен нет иначе да
  свёртка «поля» начиная с нет как «итог» и «поле»
    если («поле».«ключ») равен "fields"
      то «Записи узла равны» от («поле».«значение») и «правые»
      иначе «итог»

тотальная функция «Записи узла равны»
  принимает «узел»: «Значение», «правые»: список «Поле значения»
  возвращает признак
  обеспечивает «не запись равной записи не бывает» если не («Это запись» от «узел») то результат равен нет иначе да
  разбор «узел»
    случай вариант «Значение записи» с «поля» как «поля»
      то «Записи значений равны» от «поля» и «правые»
    случай любое
      то нет

тотальная функция «Записи значений равны»
  принимает «левые»: список «Поле значения», «правые»: список «Поле значения»
  возвращает признак
  обеспечивает «записи разного числа полей не равны» если не ((длина «левые») равен (длина «правые»)) то результат равен нет иначе да
  пример «Записи разного числа полей не равны»
    дано «левые» равно пустой список
    дано «правые» равно [(запись «Поле значения» с «ключ» равным "а" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)))]
    ожидается нет
  если не ((длина «левые») равен (длина «правые»))
    то нет
    иначе пусто (отфильтровать «левые» где «поле» → не («Поле есть и равно» от «поле» и «правые»))

тотальная функция «Поле есть и равно»
  принимает «поле»: «Поле значения», «правые»: список «Поле значения»
  возвращает признак
  обеспечивает «в пустой правой стороне поля нет» если пусто «правые» то результат равен нет иначе да
  не (пусто (отфильтровать «правые» где «п» → ((«п».«ключ») равен («поле».«ключ»)) и притом («Значения равны» от («поле».«значение») и («п».«значение»))))

тотальная функция «Процентов от порядком»
  принимает «процент»: число, «значение»: число
  возвращает число
  обеспечивает «деление на сто стоит первым, умножение вторым» результат равен ((«процент» делить на 100) умножить на «значение»)
  пример «половина от двухсот»
    дано «процент» равно 50
    дано «значение» равно 200
    ожидается 100
  пример «порядок виден на последнем бите мантиссы»
    дано «процент» равно 1
    дано «значение» равно 35
    ожидается 0.35000000000000003
  («процент» делить на 100) умножить на «значение»

тотальная функция «Процентов от обратным порядком»
  принимает «процент»: число, «значение»: число
  возвращает число
  обеспечивает «умножение стоит первым, деление на сто вторым» результат равен ((«значение» умножить на «процент») делить на 100)
  пример «на этой паре обратный порядок даёт другое число»
    дано «процент» равно 1
    дано «значение» равно 35
    ожидается 0.35
  («значение» умножить на «процент») делить на 100

тотальная функция «Слово тяжести»
  возвращает строка
  обеспечивает «тяжесть отказа — error» результат равен "error"
  пример «Тяжесть отказа»
    ожидается "error"
  "error"

тотальная функция «Диагностика отказа»
  принимает «код»: строка, «сообщение»: строка
  возвращает «Значение»
  обеспечивает «диагностика несёт данный код и данное сообщение» ((«Строка поля» от результат и "code") равен «код») и притом ((«Строка поля» от результат и "message") равен «сообщение»)
  «Узел записи» от [
    («Поле документа» от "code" и («Узел строки» от «код»)),
    («Поле документа» от "message" и («Узел строки» от «сообщение»)),
    («Поле документа» от "severity" и («Узел строки» от («Слово тяжести»)))
  ]

тотальная функция «Диагностика отказа с местом»
  принимает «код»: строка, «сообщение»: строка, «место»: «Значение»
  возвращает «Значение»
  обеспечивает «диагностика с местом несёт поле span» («Есть поле у узла» от результат и "span")
  «Узел записи» от (добавить («Поле документа» от "span" и «место») к («Поля узла» от («Диагностика отказа» от «код» и «сообщение»)))

тотальная функция «Это минус ноль»
  принимает «число»: число
  возвращает признак
  обеспечивает «положительное число минус нулём не бывает» если «число» больше 0 то результат равен нет иначе да
  пример «ноль — не минус ноль»
    дано «число» равно 0
    ожидается нет
  пример «минус ноль — минус ноль»
    дано «число» равно -0
    ожидается да
  пример «пятёрка — не минус ноль»
    дано «число» равно 5
    ожидается нет
  (к строке (1 делить на «число»)) равен "-Infinity"

тотальная функция «Это не число»
  принимает «число»: число
  возвращает признак
  обеспечивает «сравнимое с нулём число — это число» если («число» больше 0) или («число» меньше 0) то результат равен нет иначе да
  пример «пятёрка — число»
    дано «число» равно 5
    ожидается нет
  (к строке «число») равен "NaN"

тотальная функция «Остаток дал минус ноль»
  принимает «делимое»: число, «делитель»: число
  возвращает признак
  обеспечивает «положительное делимое минус нуля в остатке не даёт» если «делимое» больше 0 то результат равен нет иначе да
  пример «минус четыре по модулю двух — минус ноль, а не ноль»
    дано «делимое» равно -4
    дано «делитель» равно 2
    ожидается да
  пример «четыре по модулю двух — ноль»
    дано «делимое» равно 4
    дано «делитель» равно 2
    ожидается нет
  пример «минус ноль по модулю пяти остаётся минус нулём»
    дано «делимое» равно -0
    дано «делитель» равно 5
    ожидается да
  «Это минус ноль» от («делимое» остаток от «делитель»)

тотальная функция «Делится нацело»
  принимает «делимое»: число, «делитель»: число
  возвращает признак
  обеспечивает «нулевой остаток означает делимость» если («делимое» остаток от «делитель») равен 0 то результат равен да иначе да
  пример «минус четыре делится на два»
    дано «делимое» равно -4
    дано «делитель» равно 2
    ожидается да
  пример «четыре делится на два»
    дано «делимое» равно 4
    дано «делитель» равно 2
    ожидается да
  пример «пять на два не делится»
    дано «делимое» равно 5
    дано «делитель» равно 2
    ожидается нет
  пример «на ноль не делится ничто: остаток — не число»
    дано «делимое» равно 5
    дано «делитель» равно 0
    ожидается нет
  пусть «остаток» равно («делимое» остаток от «делитель»)
  («остаток» равен 0) или («Это минус ноль» от «остаток»)

тотальная функция «Делится нацело наивно»
  принимает «делимое»: число, «делитель»: число
  возвращает признак
  обеспечивает «на минус нуле в остатке наивная запись говорит нет» если «Остаток дал минус ноль» от «делимое» и «делитель» то результат равен нет иначе да
  пример «на положительных наивная запись верна»
    дано «делимое» равно 4
    дано «делитель» равно 2
    ожидается да
  пример «на отрицательных чётных наивная запись ВРЁТ»
    дано «делимое» равно -4
    дано «делитель» равно 2
    ожидается нет
  пример «и на минус нуле тоже врёт»
    дано «делимое» равно -0
    дано «делитель» равно 5
    ожидается нет
  («делимое» остаток от «делитель») равен 0

тотальная функция «Остаток дал не число»
  принимает «делимое»: число, «делитель»: число
  возвращает признак
  обеспечивает «остаток от нуля — не число» если «делитель» равен 0 то результат равен да иначе да
  пример «остаток на нуле — не число»
    дано «делимое» равно 5
    дано «делитель» равно 0
    ожидается да
  пример «остаток на минус нуле — тоже не число»
    дано «делимое» равно 5
    дано «делитель» равно -0
    ожидается да
  пример «остаток на пятёрке — число»
    дано «делимое» равно 5
    дано «делитель» равно 5
    ожидается нет
  «Это не число» от («делимое» остаток от «делитель»)

тотальная функция «Неотрицательно»
  принимает «число»: число
  возвращает признак
  обеспечивает «отрицательное число неотрицательным не бывает» если «число» меньше 0 то результат равен нет иначе да
  пример «ноль неотрицателен»
    дано «число» равно 0
    ожидается да
  пример «минус ноль тоже неотрицателен»
    дано «число» равно -0
    ожидается да
  пример «минус пять отрицателен»
    дано «число» равно -5
    ожидается нет
  «число» не меньше 0

тотальная функция «Печать теряет знак нуля»
  возвращает признак
  обеспечивает «знак нуля печатью теряется» результат равен да
  пример «минус ноль печатается как ноль»
    ожидается да
  (к строке -0) равен (к строке 0)

тотальная функция «Круг через строку теряет минус ноль»
  возвращает признак
  обеспечивает «круг через строку минус ноль теряет» результат равен да
  пример «после круга минус ноль стал нулём»
    ожидается да
  не («Это минус ноль» от (к числу (к строке -0)))

тотальная функция «Строка минус нуля даёт минус ноль»
  возвращает признак
  обеспечивает «строка „-0“ читается минус нулём» результат равен да
  пример «минус ноль читается минус нулём»
    ожидается да
  «Это минус ноль» от (к числу "-0")
