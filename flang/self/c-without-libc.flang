тотальная функция «Голый рантайм»
  возвращает строка
  соединить ["#ifndef FL_FREESTANDING_H\n#define FL_FREESTANDING_H\n\n",
    "/* Только эти три заголовка: их даёт сам компилятор C и без libc (-ffreestanding). */\n",
    "#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n",
    "/* Функция, в которой возможна ошибка, возвращает код, а ответ кладёт в последний аргумент out. */\n",
    "typedef enum {\n  FL_FS_OK = 0,\n",
    "  FL_FS_PRECONDITION = 1,  /* не выполнено «требует»: вызвавший нарушил договор */\n",
    "  FL_FS_POSTCONDITION = 2, /* не выполнено недоказанное «обеспечивает» */\n",
    "  FL_FS_RANGE = 3,         /* число вышло за границы типа или за 2^53 */\n",
    "  FL_FS_DIVIDE_BY_ZERO = 4,\n",
    "  FL_FS_OVERFLOW = 5,      /* ответ не уместился в слово: сложение, вычитание, умножение, перевод */\n",
    "  FL_FS_SHIFT = 6,         /* сдвиг на величину не меньше ширины слова */\n",
    "  FL_FS_BAD_TAG = 7,       /* на вход пришёл вариант с чужой меткой */\n",
    "  FL_FS_NO_CASE = 8        /* разбор не нашёл случая */\n} fl_fs_status;\n\n",
    "#define FL_FS_TRY(call) \\\n  do { \\\n    fl_fs_status fl_fs_s_ = (call); \\\n",
    "    if (fl_fs_s_ != FL_FS_OK) return fl_fs_s_; \\\n  } while (0)\n",
    "#define FL_FS_LIMIT INT64_C(9007199254740992)   /* 2^53: дальше обычное число flang не точно */\n",
    "#define FL_FS_NAT_MAX INT64_C(9007199254740991) /* потолок неотрицательного и целого */\n\n",
    «Голые помощники чисел», «Голые помощники слов», «Голые помощники сдвигов»,
    "\n#endif /* FL_FREESTANDING_H */\n"] по ""

тотальная функция «Голые помощники чисел»
  возвращает строка
  соединить ["static inline fl_fs_status fl_fs_num_check(int64_t v, int64_t *out) {\n",
    "  if (v > FL_FS_LIMIT || v < -FL_FS_LIMIT) return FL_FS_RANGE;\n  *out = v;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_num_add(int64_t a, int64_t b, int64_t *out) {\n",
    "  return fl_fs_num_check(a + b, out);\n}\n",
    "static inline fl_fs_status fl_fs_num_sub(int64_t a, int64_t b, int64_t *out) {\n",
    "  return fl_fs_num_check(a - b, out);\n}\n",
    "static inline fl_fs_status fl_fs_num_mul(int64_t a, int64_t b, int64_t *out) {\n",
    "  int64_t ma = a < 0 ? -a : a;\n  int64_t mb = b < 0 ? -b : b;\n",
    "  if (ma != 0 && mb > FL_FS_LIMIT / ma) return FL_FS_RANGE;\n  return fl_fs_num_check(a * b, out);\n}\n",
    "static inline fl_fs_status fl_fs_num_mod(int64_t a, int64_t b, int64_t *out) {\n",
    "  if (b == 0) return FL_FS_DIVIDE_BY_ZERO;\n  *out = a % b;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_valid_nat(int64_t v) {\n",
    "  return (v < 0 || v > FL_FS_NAT_MAX) ? FL_FS_RANGE : FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_valid_num(int64_t v) {\n",
    "  return (v > FL_FS_LIMIT || v < -FL_FS_LIMIT) ? FL_FS_RANGE : FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_valid_int(int64_t v) {\n",
    "  return (v > FL_FS_NAT_MAX || v < -FL_FS_NAT_MAX) ? FL_FS_RANGE : FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_to_nat(int64_t v, int64_t *out) {\n",
    "  if (v < 0 || v > FL_FS_NAT_MAX) return FL_FS_RANGE;\n  *out = v;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_to_int(int64_t v, int64_t *out) {\n",
    "  if (v > FL_FS_NAT_MAX || v < -FL_FS_NAT_MAX) return FL_FS_RANGE;\n  *out = v;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_shift_amount(int64_t v, uint64_t *out) {\n",
    "  if (v < 0) return FL_FS_SHIFT;\n  *out = (uint64_t)v;\n  return FL_FS_OK;\n}\n",
    "/* Слово для сравнения и слово не шире u32 числом: через функцию, чтобы компилятор C не судил */\n",
    "/* о границах типа раньше времени. */\n",
    "static inline uint64_t fl_fs_w(uint64_t v) { return v; }\n",
    "static inline int64_t fl_fs_word_num(uint32_t v) { return (int64_t)v; }\n",
    "static inline fl_fs_status fl_fs_u64_to_num(uint64_t v, int64_t *out) {\n",
    "  if (v > (uint64_t)FL_FS_NAT_MAX) return FL_FS_OVERFLOW;\n  *out = (int64_t)v;\n  return FL_FS_OK;\n}\n\n"] по ""

тотальная функция «Голые помощники слов»
  возвращает строка
  соединить ["/* Слова u8, u16, u32, u64: переполнение — ошибка, а у действий с заворотом (…w) её нет. */\n",
    "#define FL_FS_WORD(W, T, MAX) \\\n",
    "  static inline fl_fs_status fl_fs_u##W##_add(T a, T b, T *out) { \\\n",
    "    if ((T)(MAX - a) < b) return FL_FS_OVERFLOW; \\\n",
    "    *out = (T)(a + b); \\\n    return FL_FS_OK; \\\n  } \\\n",
    "  static inline fl_fs_status fl_fs_u##W##_sub(T a, T b, T *out) { \\\n",
    "    if (a < b) return FL_FS_OVERFLOW; \\\n",
    "    *out = (T)(a - b); \\\n    return FL_FS_OK; \\\n  } \\\n",
    "  static inline fl_fs_status fl_fs_u##W##_mul(T a, T b, T *out) { \\\n",
    "    if (a != 0 && (T)(MAX / a) < b) return FL_FS_OVERFLOW; \\\n",
    "    *out = (T)((uint64_t)a * (uint64_t)b); \\\n    return FL_FS_OK; \\\n  } \\\n",
    "  static inline fl_fs_status fl_fs_u##W##_div(T a, T b, T *out) { \\\n",
    "    if (b == 0) return FL_FS_DIVIDE_BY_ZERO; \\\n",
    "    *out = (T)(a / b); \\\n    return FL_FS_OK; \\\n  } \\\n",
    "  static inline fl_fs_status fl_fs_u##W##_mod(T a, T b, T *out) { \\\n",
    "    if (b == 0) return FL_FS_DIVIDE_BY_ZERO; \\\n",
    "    *out = (T)(a % b); \\\n    return FL_FS_OK; \\\n  } \\\n",
    "  static inline T fl_fs_u##W##_addw(T a, T b) { return (T)((uint64_t)a + (uint64_t)b); } \\\n",
    "  static inline T fl_fs_u##W##_subw(T a, T b) { return (T)((uint64_t)a - (uint64_t)b); } \\\n",
    "  static inline T fl_fs_u##W##_mulw(T a, T b) { return (T)((uint64_t)a * (uint64_t)b); } \\\n",
    "  static inline fl_fs_status fl_fs_u##W##_from(uint64_t v, T *out) { \\\n",
    "    if ((uint64_t)(T)v != v) return FL_FS_OVERFLOW; \\\n",
    "    *out = (T)v; \\\n    return FL_FS_OK; \\\n  } \\\n",
    "  static inline fl_fs_status fl_fs_u##W##_from_num(int64_t v, T *out) { \\\n",
    "    if (v < 0 || (uint64_t)(T)v != (uint64_t)v) return FL_FS_OVERFLOW; \\\n",
    "    *out = (T)v; \\\n    return FL_FS_OK; \\\n  } \\\n",
    "  FL_FS_SHIFTS(W, T)\n\n"] по ""

тотальная функция «Голые помощники сдвигов»
  возвращает строка
  соединить ["/* Сдвиг на величину не меньше ширины — ошибка; поворот берёт величину по модулю ширины. */\n",
    "#define FL_FS_SHIFTS(W, T) \\\n",
    "  static inline fl_fs_status fl_fs_u##W##_shl(T a, uint64_t n, T *out) { \\\n",
    "    if (n >= W) return FL_FS_SHIFT; \\\n",
    "    *out = (T)((uint64_t)a << n); \\\n    return FL_FS_OK; \\\n  } \\\n",
    "  static inline fl_fs_status fl_fs_u##W##_shr(T a, uint64_t n, T *out) { \\\n",
    "    if (n >= W) return FL_FS_SHIFT; \\\n",
    "    *out = (T)((uint64_t)a >> n); \\\n    return FL_FS_OK; \\\n  } \\\n",
    "  static inline T fl_fs_u##W##_rotl(T a, uint64_t n) { \\\n",
    "    unsigned k = (unsigned)(n % W); \\\n",
    "    return k == 0 ? a : (T)(((uint64_t)a << k) | ((uint64_t)a >> (W - k))); \\\n  } \\\n",
    "  static inline T fl_fs_u##W##_rotr(T a, uint64_t n) { \\\n",
    "    unsigned k = (unsigned)(n % W); \\\n",
    "    return k == 0 ? a : (T)(((uint64_t)a >> k) | ((uint64_t)a << (W - k))); \\\n  }\n\n",
    "FL_FS_WORD(8, uint8_t, UINT8_MAX)\nFL_FS_WORD(16, uint16_t, UINT16_MAX)\n",
    "FL_FS_WORD(32, uint32_t, UINT32_MAX)\nFL_FS_WORD(64, uint64_t, UINT64_MAX)\n"] по ""

тотальная функция «Голая шапка»
  принимает «модуль»: строка, «файл»: строка
  возвращает строка
  соединить ["/*\n * Сгенерировано flang: C без libc (flang/self/c-without-libc.flang).\n",
    " * Модуль flang: «", «модуль», "». Файл: ", «файл», ".\n",
    " * Собирается с -ffreestanding -nostdlib: ни libc, ни потоков, ни выделения памяти.\n",
    " * Не редактировать руками — правьте исходник на flang и генерируйте заново.\n */\n"] по ""

функция «Голая среда программы»
  принимает «программа»: «Значение»
  возвращает «Голая среда»
  пусть «префикс» равно («Префикс программы» от «программа»)
  пусть «записи» равно («Голые имена типов вида» от «программа» и "record")
  пусть «суммы» равно («Голые имена типов вида» от «программа» и "sum")
  пусть «узлы» равно (отфильтровать («Элементы поля» от «программа» и "types") где «т» → ["record", "sum"]
    содержит («Вид узла» от «т»))
  пусть «типы» равно (отобразить «узлы» как «т» → «Голый тип объявления» от «т» и «префикс» и «записи» и «суммы»)
  пусть «функции» равно (отобразить («Элементы поля» от «программа» и "functions") как «ф»
    → «Голая подпись функции» от «ф» и «префикс» и «записи» и «суммы»)
  пусть «порядок» равно («Голый порядок типов» от «типы» и «типы» и пустой список)
  (запись «Голая среда» с «префикс» равным «префикс» и «типы» равным «типы» и «функции» равным «функции»
    и «имена» равным пустой список и «функция» равным "" и «ждут» равным ""
    и «проверяемые» равным («Голые проверяемые» от «порядок»))

тотальная функция «Голые слова о петле»
  возвращает строка
  "тип, который содержит сам себя (дерево, список): ему нужна куча, а код без libc её не выделяет"

тотальная функция «Голый отказ среды»
  принимает «программа»: «Значение», «среда»: «Голая среда», «порядок»: список «Голая подпись»
  возвращает строка
  пусть «объявления» равно («Голые объявления не умеет» от «программа»)
  пусть «типы» равно (отобразить («среда».«типы») как «т» → «Голый отказ типа» от «т»)
  пусть «функции» равно (отобразить («среда».«функции») как «п» → «Голый отказ подписи» от «п»)
  пусть «по типам» равно («Голый порядок типов» от («среда».«типы») и («среда».«типы») и пустой список)
  пусть «петля» равно (если (длина «по типам») равен (длина («среда».«типы»)) то "" иначе «Голый отказ»
    от «Голые слова о петле»)
  пусть «рекурсия» равно («Голый отказ рекурсии» от («среда».«функции») и «порядок»)
  пусть «все» равно («Голое слияние строк» от («Голое слияние строк» от [«объявления»] и «типы») и «функции»)
  «Голый первый отказ» от (добавить «рекурсия» к (добавить «петля» к «все»))

тотальная функция «Голое слияние строк»
  принимает «первые»: список строки, «вторые»: список строки
  возвращает список строки
  свёртка «вторые» начиная с «первые» как «акк» и «с» → добавить «с» к «акк»

тотальная функция «Голое имя файла»
  принимает «программа»: «Значение», «настройки»: «Голые настройки»
  возвращает строка
  если «настройки».«есть путь» то «настройки».«путь» иначе «Префикс программы» от «программа»

функция «Печать без libc»
  принимает «программа»: «Значение», «настройки»: «Голые настройки»
  возвращает «Итог печати»
  пусть «среда» равно («Голая среда программы» от «программа»)
  пусть «порядок» равно («Голый порядок функций» от («среда».«функции») и («среда».«функции») и пустой список)
  пусть «отказ» равно («Голый отказ среды» от «программа» и «среда» и «порядок»)
  если «отказ» равен ""
    то «Печать без libc дальше» от «программа» и «настройки» и «среда» и «порядок»
    иначе запись «Итог печати» с «файлы» равным пустой список и «ошибка» равным «отказ»

функция «Печать без libc дальше»
  принимает «программа»: «Значение», «ключи»: «Голые настройки», «среда»: «Голая среда», «ряд»: список «Голая подпись»
  возвращает «Итог печати»
  пусть «ход» равно («Голые определения функций» от «среда» и «ряд»)
  пусть «готовая» равно («Голая среда функции» от «среда» и («ход».«готовые») и "")
  если «Сорван ли» от («ход».«код»)
    то запись «Итог печати» с «файлы» равным пустой список и «ошибка» равным («ход».«код».«отказ»)
    иначе «Голые файлы» от «программа» и «ключи» и «готовая» и («ход».«код».«текст»)

тотальная функция «Голый заголовок»
  принимает «модуль»: строка, «файл»: строка, «среда»: «Голая среда», «порядок»: список «Голый тип»
  возвращает строка
  пусть «префикс» равно («среда».«префикс»)
  пусть «страж» равно (соединить [(«Змейка» от «файл»), "_h"] по "")
  пусть «типы» равно (соединить (отобразить «порядок» как «т» → соединить [(«Голое определение типа» от «т»
    и «префикс»), "\n"] по "") по "")
  пусть «строки» равно (отобразить («среда».«функции») как «п» → «Голый прототип» от «п» и «префикс»)
  пусть «прототипы» равно (соединить «строки» по "\n")
  соединить [(«Голая шапка» от «модуль» и (соединить «файл» с ".h")), "#ifndef ", «страж», "\n#define ", «страж»,
    "\n\n#include \"flang_freestanding.h\"\n\n", «типы», «прототипы», "\n#endif\n"] по ""

тотальная функция «Голые файлы»
  принимает «программа»: «Значение», «настройки»: «Голые настройки», «среда»: «Голая среда», «определения»: строка
  возвращает «Итог печати»
  пусть «файл» равно («Голое имя файла» от «программа» и «настройки»)
  пусть «модуль» равно («Имя модуля» от «программа»)
  пусть «порядок» равно («Голый порядок типов» от («среда».«типы») и («среда».«типы») и пустой список)
  пусть «заголовок» равно («Голый заголовок» от «модуль» и «файл» и «среда» и «порядок»)
  пусть «проверки» равно (соединить (отобразить «порядок» как «т» → «Голая проверка типа» от «т» и «среда») по "")
  пусть «исходник» равно (соединить [(«Голая шапка» от «модуль» и (соединить «файл» с ".c")), "#include \"", «файл»,
    ".h\"\n\n", «проверки», «определения»] по "")
  пусть «рантайм» равно (соединить [(«Голая шапка» от «модуль» и "flang_freestanding.h"), «Голый рантайм»] по "")
  (запись «Итог печати» с «файлы» равным [(запись «Файл» с «путь» равным "flang_freestanding.h" и «содержимое»
      равным «рантайм»),
    (запись «Файл» с «путь» равным (соединить «файл» с ".h") и «содержимое» равным «заголовок»),
    (запись «Файл» с «путь» равным (соединить «файл» с ".c") и «содержимое» равным «исходник»)] и «ошибка» равным "")
