// Строго меньше, а не «не больше»: доказательство обещало СТРОГОЕ убывание, а
// цепочка с равенством — это ровно та цепочка, которая не заканчивается.
тотальная функция «Сравнение сторожа»
  возвращает «Значение»
  «Записью при понижении» от [(«Текстом при понижении» от "kind" и "binary"), («Текстом при понижении» от "op" и "lt"), («Пара при понижении» от "left" и («Имя переменной при понижении» от "результат")), («Пара при понижении» от "right" и («Имя переменной при понижении» от "мера"))]

// Отказ выражен ПОСТУСЛОВИЕМ: формы «возбудить ошибку» в языке нет, а код и
// текст постусловия едут в AST данными — интерпретатор и все восемь целей
// читают одно и то же поле, поэтому отказ у них совпадает не случайно.
тотальная функция «Постусловие сторожа»
  принимает «сообщение»: строка
  возвращает «Значение»
  «Записью при понижении» от [(«Текстом при понижении» от "name" и "мера убывает"), («Текстом при понижении» от "bind" и "результат"), («Пара при понижении» от "expr" и («Сравнение сторожа»)), («Текстом при понижении» от "code" и "FLANG_MEASURE"), («Текстом при понижении» от "message" и «сообщение»)]

// Сторож — лист: возвращает свой первый аргумент и не зовёт никого, поэтому
// тотален. Отдельной функцией, а не постусловием на самой рекурсивной функции:
// постусловие проверяет РЕЗУЛЬТАТ, а стеречь надо аргумент, и функция с
// постусловиями не получает хвостовых вызовов ни у одной цели — зацикливание
// разменялось бы на переполнение стека.
тотальная функция «Печать сторожа при понижении»
  принимает «пара»: «Имя сторожа»
  возвращает «Значение»
  «Записью при понижении» от [(«Текстом при понижении» от "name" и («пара».«имя»)), («Пара при понижении» от "total" и («Признаком при понижении» от да)), («Пара при понижении» от "params" и («Списком при понижении» от [(«Параметр сторожа» от "шаг"), («Параметр сторожа» от "мера")])), («Пара при понижении» от "returns" и («Тип число при понижении»)), («Пара при понижении» от "postconditions" и («Списком при понижении» от [(«Постусловие сторожа» от («пара».«сообщение»))])), («Пара при понижении» от "body" и («Имя переменной при понижении» от "шаг")), («Пара при понижении» от "examples" и («Списком при понижении» от пустой список))]

