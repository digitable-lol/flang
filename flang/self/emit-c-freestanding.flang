тотальная функция «Голый рантайм»
  возвращает строка
  обеспечивает «рантайм без libc зовёт только три заголовка» результат содержит "#include <stdint.h>"
  соединить ["#ifndef FL_FREESTANDING_H\n#define FL_FREESTANDING_H\n\n",
    "/* Только эти три заголовка: их даёт сам компилятор C и без libc (-ffreestanding). */\n",
    "#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n",
    "/* Каждая функция возвращает код; ответ кладёт в последний аргумент out. */\n",
    "typedef enum {\n  FL_FS_OK = 0,\n",
    "  FL_FS_PRECONDITION = 1,  /* не выполнено «требует»: вызвавший нарушил договор */\n",
    "  FL_FS_POSTCONDITION = 2, /* не выполнено недоказанное «обеспечивает» */\n",
    "  FL_FS_RANGE = 3,         /* число вышло за границы типа или за 2^53 */\n",
    "  FL_FS_NEGATIVE = 4,      /* точное целое ушло бы ниже нуля */\n",
    "  FL_FS_DIVIDE_BY_ZERO = 5,\n",
    "  FL_FS_OVERFLOW = 6,      /* точное целое не уложилось в 64 бита */\n",
    "  FL_FS_BAD_TAG = 7,       /* на вход пришёл вариант с чужой меткой */\n",
    "  FL_FS_NO_CASE = 8        /* разбор не нашёл случая */\n} fl_fs_status;\n\n",
    "#define FL_FS_TRY(call) \\\n  do { \\\n    fl_fs_status fl_fs_s_ = (call); \\\n",
    "    if (fl_fs_s_ != FL_FS_OK) return fl_fs_s_; \\\n  } while (0)\n",
    "#define FL_FS_LIMIT INT64_C(9007199254740992)   /* 2^53: дальше double не точен */\n",
    "#define FL_FS_NAT_MAX INT64_C(9007199254740991) /* потолок неотрицательного и целого */\n\n",
    «Голые помощники чисел», «Голые помощники точных», "\n#endif /* FL_FREESTANDING_H */\n"] по ""

тотальная функция «Голые помощники чисел»
  возвращает строка
  соединить ["static inline fl_fs_status fl_fs_num_check(int64_t v, int64_t *out) {\n",
    "  if (v > FL_FS_LIMIT || v < -FL_FS_LIMIT) return FL_FS_RANGE;\n  *out = v;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_num_add(int64_t a, int64_t b, int64_t *out) {\n",
    "  return fl_fs_num_check(a + b, out);\n}\n",
    "static inline fl_fs_status fl_fs_num_sub(int64_t a, int64_t b, int64_t *out) {\n",
    "  return fl_fs_num_check(a - b, out);\n}\n",
    "static inline fl_fs_status fl_fs_num_mul(int64_t a, int64_t b, int64_t *out) {\n",
    "  int64_t ma = a < 0 ? -a : a;\n  int64_t mb = b < 0 ? -b : b;\n",
    "  if (ma != 0 && mb > FL_FS_LIMIT / ma) return FL_FS_RANGE;\n  return fl_fs_num_check(a * b, out);\n}\n",
    "static inline fl_fs_status fl_fs_num_mod(int64_t a, int64_t b, int64_t *out) {\n",
    "  if (b == 0) return FL_FS_DIVIDE_BY_ZERO;\n  *out = a % b;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_valid_nat(uint64_t v) {\n",
    "  return v > (uint64_t)FL_FS_NAT_MAX ? FL_FS_RANGE : FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_valid_num(int64_t v) {\n",
    "  return (v > FL_FS_LIMIT || v < -FL_FS_LIMIT) ? FL_FS_RANGE : FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_valid_int(int64_t v) {\n",
    "  return (v > FL_FS_NAT_MAX || v < -FL_FS_NAT_MAX) ? FL_FS_RANGE : FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_to_nat(int64_t v, uint64_t *out) {\n",
    "  if (v < 0 || v > FL_FS_NAT_MAX) return FL_FS_RANGE;\n  *out = (uint64_t)v;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_to_int(int64_t v, int64_t *out) {\n",
    "  if (v > FL_FS_NAT_MAX || v < -FL_FS_NAT_MAX) return FL_FS_RANGE;\n  *out = v;\n  return FL_FS_OK;\n}\n"] по ""

тотальная функция «Голые помощники точных»
  возвращает строка
  соединить ["static inline fl_fs_status fl_fs_exact_add(uint64_t a, uint64_t b, uint64_t *out) {\n",
    "  if (a + b < a) return FL_FS_OVERFLOW;\n  *out = a + b;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_exact_sub(uint64_t a, uint64_t b, uint64_t *out) {\n",
    "  if (b > a) return FL_FS_NEGATIVE;\n  *out = a - b;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_exact_mul(uint64_t a, uint64_t b, uint64_t *out) {\n",
    "  if (a != 0 && b > UINT64_MAX / a) return FL_FS_OVERFLOW;\n  *out = a * b;\n  return FL_FS_OK;\n}\n",
    "static inline fl_fs_status fl_fs_exact_mod(uint64_t a, uint64_t b, uint64_t *out) {\n",
    "  if (b == 0) return FL_FS_DIVIDE_BY_ZERO;\n  *out = a % b;\n  return FL_FS_OK;\n}\n"] по ""

