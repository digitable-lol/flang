  пусть «ветвь» равно («Печать ветви» от «случай» и «предмет» и «есть цель» и «цель» и «контекст» и («Часть следа» от («Открыть случай» от «состояние» и «случай») и "шапка" и («Строка вывода» от «отступ» и «шапка»)) и «внутри»)
  запись «Блок» с «состояние» равным («Закрыть блок следа» от («Часть следа» от («ветвь».«состояние») и "конец" и («Строка вывода» от «отступ» и "}"))) и «вывод» равным (соединить [(«Строка вывода» от «отступ» и «шапка»), («ветвь».«вывод»), («Строка вывода» от «отступ» и "}")] по "")

функция «Печать разбора»
  принимает «узел»: «Значение», «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  обеспечивает «разбор печатает сперва предмет» (результат.«вывод») начинается с ((«Печать значения в C» от («Взять поле» от «узел» и "target") и «контекст» и «состояние» и «отступ»).«вывод»)
  пусть «открыто» равно («Открыть узел» от «состояние» и «узел» и "разбор" и (если «есть цель» то (соединить " цель " с «цель») иначе ""))
  пусть «предмет» равно («Печать значения в C» от («Взять поле» от «узел» и "target") и «контекст» и «открыто» и «отступ»)
  пусть «начало» равно (запись «Сбор случаев» с «состояние» равным («предмет».«состояние») и «вывод» равным "" и «случаи» равным пустой список)
  пусть «собрано» равно (свёртка («Элементы поля» от «узел» и "cases") начиная с «начало» как «акк» и «случай» → «Шаг сбора случая» от «акк» и «случай» и («предмет».«значение») и «контекст» и «отступ»)
  пусть «цепочка» равно («Цепочка случаев» от («собрано».«случаи») и нет и («предмет».«значение») и «есть цель» и «цель» и «контекст» и («собрано».«состояние») и «отступ»)
  пусть «вывод» равно (соединить [(«предмет».«вывод»), («собрано».«вывод»), («цепочка».«вывод»)] по "")
  запись «Блок» с «состояние» равным («Закрыть блок следа» от («цепочка».«состояние»)) и «вывод» равным «вывод»

// ── хвостовая позиция: здесь живут `*result = …; return FL_OK;`, `continue` и отскоки ──

функция «Печать хвоста»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  обеспечивает «хвостовой match печатается разбором без цели» если ((«Вид узла» от «узел») равен "match") то результат равен («Печать разбора» от «узел» и нет и "" и «контекст» и «состояние» и «отступ») иначе да
  разбор («Вид узла» от «узел»)
    случай "let"
      то «Хвостовое пусть» от «узел» и «контекст» и «состояние» и «отступ»
    случай "if"
      то «Хвостовое если» от «узел» и «контекст» и «состояние» и «отступ»
    случай "match"
      то «Печать разбора» от «узел» и нет и "" и «контекст» и «состояние» и «отступ»
    случай "call"
      то «Хвостовой вызов» от «узел» и «контекст» и «состояние» и «отступ»
    случай любое
      то «Хвостовое значение» от «узел» и «контекст» и «состояние» и «отступ»

функция «Хвостовое значение»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  обеспечивает «хвостовое значение кладётся в result и возвращает FL_OK» ((результат.«вывод») содержит "*result = ") и притом ((результат.«вывод») содержит "return FL_OK;")
  пусть «итог» равно («Печать значения в C» от «узел» и «контекст» и («Открыть узел» от «состояние» и «узел» и "хвост-значение" и "") и «отступ»)
  пусть «строки» равно (соединить («Строка вывода» от «отступ» и (соединить ["*result = ", («итог».«значение»), ";"] по "")) с («Строка вывода» от «отступ» и "return FL_OK;"))
  запись «Блок» с «состояние» равным («Закрыть блок следа» от («Часть следа» от («итог».«состояние») и "возврат" и «строки»)) и «вывод» равным (соединить («итог».«вывод») с «строки»)

функция «Хвостовое пусть»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  обеспечивает «хвостовое пусть помечает объявление именем из узла» (результат.«вывод») содержит (соединить ["/* пусть «", («Строка поля» от «узел» и "name"), "» */"] по "")
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «значение» равно («Печать значения в C» от («Взять поле» от «узел» и "value") и «контекст» и («Открыть узел» от «состояние» и «узел» и "хвост-пусть" и («Слово следа» от "имя" и «имя»)) и «отступ»)
  пусть «проверено» равно («Проверить имя узла» от («значение».«состояние») и «имя» и "let" и "name")
  пусть «свежее» равно («Свежее имя» от «проверено» и «имя»)
  пусть «идентификатор» равно («свежее».«имя»)
  пусть «объявление» равно («Строка вывода» от «отступ» и (соединить ["const fl_value ", «идентификатор», " = ", («значение».«значение»), "; /* пусть «", «имя», "» */"] по ""))
  пусть «внутри» равно («Связать имя в C» от «контекст» и «имя» и «идентификатор»)
  пусть «тело» равно («Печать хвоста» от («Тело пусть» от «узел») и «внутри» и («Часть следа» от («свежее».«состояние») и "объявление" и «объявление») и «отступ»)
  пусть «хвост» равно («Гасить неиспользованные» от («тело».«вывод») и [«идентификатор»] и «отступ»)
  запись «Блок» с «состояние» равным («Закрыть блок следа» от («Часть следа» от («тело».«состояние») и "гашение" и («Гашение перед» от «хвост» и («тело».«вывод»)))) и «вывод» равным (соединить [(«значение».«вывод»), «объявление», «хвост»] по "")

функция «Хвостовое если»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  обеспечивает «хвостовое если печатает обе ветви» (результат.«вывод») содержит "} else {"
  пусть «флаг» равно («Печать признака в C» от («Взять поле» от «узел» и "cond") и "fl_cond" и «контекст» и («Открыть узел» от «состояние» и «узел» и "хвост-если" и "") и «отступ»)
  пусть «внутри» равно (соединить «отступ» с "  ")
  пусть «то» равно («Печать хвоста» от («Взять поле» от «узел» и "then") и «контекст» и («Часть следа» от («флаг».«состояние») и "шапка" и («Строка вывода» от «отступ» и (соединить ["if (", («флаг».«значение»), ") {"] по ""))) и «внутри»)
  пусть «иначе» равно («Печать хвоста» от («Взять поле» от «узел» и "else") и «контекст» и («Часть следа» от («то».«состояние») и "иначе" и («Строка вывода» от «отступ» и "} else {")) и «внутри»)
  пусть «вывод» равно (соединить [(«флаг».«вывод»), («Строка вывода» от «отступ» и (соединить ["if (", («флаг».«значение»), ") {"] по "")), («то».«вывод»), («Строка вывода» от «отступ» и "} else {"), («иначе».«вывод»), («Строка вывода» от «отступ» и "}")] по "")
  запись «Блок» с «состояние» равным («Закрыть блок следа» от («Часть следа» от («иначе».«состояние») и "конец" и («Строка вывода» от «отступ» и "}"))) и «вывод» равным «вывод»

функция «Хвостовой вызов»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  обеспечивает «самовызов в хвосте становится циклом» если («Это самовызов» от «контекст» и («Строка поля» от «узел» и "name")) то (результат.«вывод») равен ((«Хвостовой цикл» от («Печать аргументов» от («Элементы поля» от «узел» и "args") и «контекст» и («Разрешить вызов» от «узел» и «контекст» и «состояние») и «отступ») и «контекст» и «отступ»).«вывод») иначе да
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «правило» равно (если («Это самовызов» от «контекст» и «имя») то "хвост-цикл" иначе (если («Это отскок» от «контекст» и «имя») то "хвост-отскок" иначе "хвост-возврат"))
  пусть «проверено» равно («Разрешить вызов» от «узел» и «контекст» и («Открыть узел» от «состояние» и «узел» и «правило» и («Слово следа» от "имя" и «имя»)))
  пусть «аргументы» равно («Печать аргументов» от («Элементы поля» от «узел» и "args") и «контекст» и «проверено» и «отступ»)
  если «Это самовызов» от «контекст» и «имя»
    то «Блок со следом» от («Хвостовой цикл» от «аргументы» и «контекст» и «отступ») и («аргументы».«вывод»)
    иначе
      если «Это отскок» от «контекст» и «имя»
        то «Блок со следом» от («Хвостовой отскок» от «аргументы» и «имя» и «контекст» и «отступ») и («аргументы».«вывод»)
        иначе «Блок со следом» от («Хвостовой возврат» от «аргументы» и «имя» и «контекст» и «отступ») и («аргументы».«вывод»)

тотальная функция «Блок со следом»
  принимает «блок»: «Блок», «детей»: строка
  возвращает «Блок»
  обеспечивает «вывод не меняется» (результат.«вывод») равен («блок».«вывод»)
  запись «Блок» с «состояние» равным («Закрыть блок следа» от («Часть следа» от («блок».«состояние») и "хвост" и («Хвост после приставки» от («блок».«вывод») и «детей»))) и «вывод» равным («блок».«вывод»)

тотальная функция «Это самовызов»
  принимает «контекст»: «Контекст», «имя»: строка
  возвращает признак
  обеспечивает «без хвостового себя самовызова нет» если (не («контекст».«сам хвост»)) то результат равен нет иначе результат равен («имя» равен ((«контекст».«функция»).«имя»))
  пример «без хвостового себя самовызова нет»
    дано «контекст» равно (запись «Контекст» с «общее» равным (запись «Общее» с «префикс» равным "" и «функции» равным пустой список и «записи» равным пустой список и «варианты» равным пустой список и «суммы» равным пустой список и «ид функций» равным пустой список и «ид фабрик» равным пустой список и «ид вариантов» равным пустой список и «ид шагов» равным пустой список и «ид параметров» равным пустой список и «хвостовые» равным пустой список и «циклические» равным пустой список и «рекурсивные» равным пустой список) и «функция» равным (запись «Функция» с «имя» равным "" и «тотальная» равным нет и «параметры» равным пустой список и «возвращает» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)) и «тело» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)) и «постусловия» равным пустой список и «предусловия» равным пустой список) и «параметры» равным пустой список и «сам хвост» равным нет и «есть члены» равным нет и «члены» равным пустой список и «область» равным пустой список)
    дано «имя» равно "Ф"
    ожидается нет
  если («контекст».«сам хвост»)
    то «имя» равен ((«контекст».«функция»).«имя»)
    иначе нет

тотальная функция «Это отскок»
  принимает «контекст»: «Контекст», «имя»: строка
  возвращает признак
  обеспечивает «без членов батута отскока нет» если (не («контекст».«есть члены»)) то результат равен нет иначе результат равен ((«контекст».«члены») содержит «имя»)
  пример «без членов батута отскока нет»
    дано «контекст» равно (запись «Контекст» с «общее» равным (запись «Общее» с «префикс» равным "" и «функции» равным пустой список и «записи» равным пустой список и «варианты» равным пустой список и «суммы» равным пустой список и «ид функций» равным пустой список и «ид фабрик» равным пустой список и «ид вариантов» равным пустой список и «ид шагов» равным пустой список и «ид параметров» равным пустой список и «хвостовые» равным пустой список и «циклические» равным пустой список и «рекурсивные» равным пустой список) и «функция» равным (запись «Функция» с «имя» равным "" и «тотальная» равным нет и «параметры» равным пустой список и «возвращает» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)) и «тело» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)) и «постусловия» равным пустой список и «предусловия» равным пустой список) и «параметры» равным пустой список и «сам хвост» равным нет и «есть члены» равным нет и «члены» равным пустой список и «область» равным пустой список)
    дано «имя» равно "Ф"
    ожидается нет
  если («контекст».«есть члены»)
    то («контекст».«члены») содержит «имя»
    иначе нет

тотальная функция «Хвостовой возврат»
  принимает «аргументы»: «Сборка», «имя»: строка, «контекст»: «Контекст», «отступ»: строка
  возвращает «Блок»
  обеспечивает «хвостовой возврат передаёт result и error дальше» ((результат.«состояние») равен («аргументы».«состояние»)) и притом ((результат.«вывод») содержит ", result, error);")
  пусть «функция» равно («Значение по ключу» от ((«контекст».«общее»).«ид функций») и «имя»)
  пусть «строка» равно («Строка вывода» от «отступ» и (соединить ["return ", «функция», "(ctx", («Аргументы после ctx» от («аргументы».«части»)), ", result, error);"] по ""))
  запись «Блок» с «состояние» равным («аргументы».«состояние») и «вывод» равным (соединить («аргументы».«вывод») с «строка»)

тотальная функция «Шаг отскока»
  принимает «акк»: «Зип», «аргумент»: строка, «отступ»: строка
  возвращает «Зип»
  обеспечивает «шаг отскока двигает индекс на один» ((результат.«индекс») равен ((«акк».«индекс») плюс 1)) и притом ((результат.«текст») начинается с («акк».«текст»))
  пусть «строка» равно («Строка вывода» от «отступ» и (соединить ["bounce->args[", (к строке («акк».«индекс»)), "] = ", «аргумент», ";"] по ""))
  запись «Зип» с «индекс» равным ((«акк».«индекс») плюс 1) и «текст» равным (соединить («акк».«текст») с «строка»)

тотальная функция «Хвостовой отскок»
  принимает «аргументы»: «Сборка», «имя»: строка, «контекст»: «Контекст», «отступ»: строка
  возвращает «Блок»
  обеспечивает «отскок состояния не двигает и кончается FL_OK» ((результат.«состояние») равен («аргументы».«состояние»)) и притом ((результат.«вывод») содержит "return FL_OK;")
  пусть «шаг» равно («Значение по ключу» от ((«контекст».«общее»).«ид шагов») и «имя»)
  пусть «начало» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
  пусть «присвоения» равно (свёртка («аргументы».«части») начиная с «начало» как «акк» и «аргумент» → «Шаг отскока» от «акк» и «аргумент» и «отступ»)
  пусть «примечание» равно («Строка вывода» от «отступ» и (соединить ["/* хвостовой вызов «", «имя», "» — отскок, а не кадр стека */"] по ""))
  пусть «конец» равно (соединить («Строка вывода» от «отступ» и (соединить ["bounce->next = ", «шаг», ";"] по "")) с («Строка вывода» от «отступ» и "return FL_OK;"))
  запись «Блок» с «состояние» равным («аргументы».«состояние») и «вывод» равным (соединить [(«аргументы».«вывод»), «примечание», («присвоения».«текст»), «конец»] по "")

// Самовызов в хвосте — это цикл. Присваивание параметров идёт по очереди,
// поэтому аргумент, который ещё читает старое значение параметра, обязан
// сперва лечь во временное.
тотальная функция «Шаг временного аргумента»
  принимает «акк»: «Сборка», «аргумент»: строка, «контекст»: «Контекст», «отступ»: строка
  возвращает «Сборка»
  обеспечивает «шаг временного аргумента добавляет одну часть» ((результат.«индекс») равен ((«акк».«индекс») плюс 1)) и притом ((длина (результат.«части»)) равен ((длина («акк».«части»)) плюс 1))
  если «Аргумент можно оставить» от «аргумент» и «контекст»
    то запись «Сборка» с «состояние» равным («акк».«состояние») и «вывод» равным («акк».«вывод») и «индекс» равным ((«акк».«индекс») плюс 1) и «части» равным (добавить «аргумент» к («акк».«части»))
    иначе «Отложить аргумент» от «акк» и «аргумент» и «отступ»

тотальная функция «Отложить аргумент»
  принимает «акк»: «Сборка», «аргумент»: строка, «отступ»: строка
  возвращает «Сборка»
  обеспечивает «отложенный аргумент ложится во временное имя» (результат.«части») равен (добавить ((«Временное» от («акк».«состояние»)).«имя») к («акк».«части»))
  пример «отложенный аргумент ложится во временное имя»
    дано «акк» равно (запись «Сборка» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «вывод» равным "" и «индекс» равным 0 и «части» равным пустой список)
    дано «аргумент» равно "fl_x"
    дано «отступ» равно ""
    ожидается (запись «Сборка» с «состояние» равным (запись «Состояние» с «счётчик» равным 1 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «вывод» равным "const fl_value fl_t1 = fl_x;\n" и «индекс» равным 1 и «части» равным ["fl_t1"])
  пусть «свежее» равно («Временное» от («акк».«состояние»))
  пусть «строка» равно («Строка вывода» от «отступ» и (соединить ["const fl_value ", («свежее».«имя»), " = ", «аргумент», ";"] по ""))
  запись «Сборка» с «состояние» равным («свежее».«состояние») и «вывод» равным (соединить («акк».«вывод») с «строка») и «индекс» равным ((«акк».«индекс») плюс 1) и «части» равным (добавить («свежее».«имя») к («акк».«части»))

тотальная функция «Аргумент можно оставить»
  принимает «аргумент»: строка, «контекст»: «Контекст»
  возвращает признак
  обеспечивает «параметр как аргумент оставить нельзя» если ((«контекст».«параметры») содержит «аргумент») то результат равен нет иначе результат равен («Это идентификатор» от «аргумент»)
  пример «параметр как аргумент оставить нельзя»
    дано «аргумент» равно "fl_x"
    дано «контекст» равно (запись «Контекст» с «общее» равным (запись «Общее» с «префикс» равным "" и «функции» равным пустой список и «записи» равным пустой список и «варианты» равным пустой список и «суммы» равным пустой список и «ид функций» равным пустой список и «ид фабрик» равным пустой список и «ид вариантов» равным пустой список и «ид шагов» равным пустой список и «ид параметров» равным пустой список и «хвостовые» равным пустой список и «циклические» равным пустой список и «рекурсивные» равным пустой список) и «функция» равным (запись «Функция» с «имя» равным "" и «тотальная» равным нет и «параметры» равным пустой список и «возвращает» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)) и «тело» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)) и «постусловия» равным пустой список и «предусловия» равным пустой список) и «параметры» равным ["fl_x"] и «сам хвост» равным нет и «есть члены» равным нет и «члены» равным пустой список и «область» равным пустой список)
    ожидается нет
  если «Это идентификатор» от «аргумент»
    то
      если («контекст».«параметры») содержит «аргумент»
        то нет
        иначе да
    иначе нет

тотальная функция «Шаг присвоения параметра»
  принимает «акк»: «Зип», «параметр»: строка, «временные»: список строки, «отступ»: строка
  возвращает «Зип»
  обеспечивает «шаг присвоения параметра двигает индекс на один» ((результат.«индекс») равен ((«акк».«индекс») плюс 1)) и притом ((результат.«текст») начинается с («акк».«текст»))
  пусть «строка» равно («Строка вывода» от «отступ» и (соединить [«параметр», " = ", («Элемент по индексу» от «временные» и («акк».«индекс»)), ";"] по ""))
  запись «Зип» с «индекс» равным ((«акк».«индекс») плюс 1) и «текст» равным (соединить («акк».«текст») с «строка»)

тотальная функция «Хвостовой цикл»
  принимает «аргументы»: «Сборка», «контекст»: «Контекст», «отступ»: строка
  возвращает «Блок»
  обеспечивает «виток цикла отмечается тиком и кончается continue» ((результат.«вывод») содержит "fl_tick(ctx, ") и притом ((результат.«вывод») содержит "continue;")
  пусть «начало» равно («Пустая сборка» от («аргументы».«состояние»))
  пусть «временные» равно (свёртка («аргументы».«части») начиная с «начало» как «акк» и «аргумент» → «Шаг временного аргумента» от «акк» и «аргумент» и «контекст» и «отступ»)
  пусть «нуль» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
  пусть «присвоения» равно (свёртка («контекст».«параметры») начиная с «нуль» как «акк» и «параметр» → «Шаг присвоения параметра» от «акк» и «параметр» и («временные».«части») и «отступ»)
  пусть «пояснение» равно («Строка вывода» от «отступ» и "/* виток цикла — тоже шаг: незавершающийся самовызов обязан упереться в лимит */")
  пусть «виток» равно («Строка вывода» от «отступ» и (соединить ["FL_TRY(fl_tick(ctx, ", («Строка C» от ((«контекст».«функция»).«имя»)), ", error));"] по ""))
  пусть «вывод» равно (соединить [(«аргументы».«вывод»), («временные».«вывод»), («присвоения».«текст»), «пояснение», «виток», («Строка вывода» от «отступ» и "continue;")] по "")
  запись «Блок» с «состояние» равным («временные».«состояние») и «вывод» равным «вывод»

// ═══════════════════════════ печать объявлений ═══════════════════════════

объект «Файл»
  «путь»: строка
  «содержимое»: строка

// Объявленные типы параметров — четырьмя плоскими списками. Поля и варианты
// лежат сплошными отрезками, а тип называет своё начало и длину: массив нулевой
// длины в C99 незаконен, и отдельный массив на каждый тип означал бы россыпь
// имён по одному на каждый вариант каждой суммы.
//
// Приезжают они СНАРУЖИ, как и текст рантайма. Причина та же: решить, какой у
// параметра объявленный тип, — работа слоя типов (`self/types.flang`), а не
// печати в C. Печать здесь отвечает за то, что эти данные лягут в C
// правильными байтами.
объект «Поле входа»
  «имя»: строка
  «тип»: число

объект «Вариант входа»
  «имя»: строка
  «поле с»: число
  «полей»: число

объект «Тип входа»
  «вид»: строка
  «имя»: строка
  «владелец»: строка
  «ничто»: признак
  «целое»: признак
  «отрезок»: признак
  «низ»: число
  «верх»: число
  «элемент»: число
  «поле с»: число
  «полей»: число
  «вариант с»: число
  «вариантов»: число

объект «Параметр входа»
  «функция»: строка
  «параметр»: строка
  «тип»: число

объект «Настройки»
  «путь»: строка
  «есть путь»: признак
  «база»: число
  «предел глубины»: число
  «предел шагов»: число
  «прогонщик»: признак
  «рантайм заголовок»: строка
  «рантайм исходник»: строка
  «исходник прогонщика»: строка
  «оболочка»: признак
  «исходник оболочки»: строка
  «типы входа»: список «Тип входа»
  «поля входа»: список «Поле входа»
  «варианты входа»: список «Вариант входа»
  «параметры входа»: список «Параметр входа»
  // Движок процессов: заголовок и реализация одним текстом на все программы.
  // Читаются они только у программы, где объявлен хотя бы один процесс; у
  // остальных приезжают и не печатаются, как «исходник оболочки» у всех, кроме
  // самого компилятора.
  «планировщик заголовок»: строка
  «планировщик исходник»: строка

объект «Итог печати»
  «файлы»: список «Файл»
  «ошибка»: строка

объект «Тела»
  «состояние»: «Состояние»
  «части»: список строки

тотальная функция «Пробелы»
  принимает «сколько»: неотрицательное
  возвращает строка
  обеспечивает «без просьбы пробелов нет» если (не («сколько» больше 0)) то результат равен "" иначе да
  обеспечивает «пробелов ровно столько, сколько просили» если «сколько» больше 0 то (длина результат) равен «сколько» иначе да
  пример «Четыре пробела отступа»
    дано «сколько» равно 4
    ожидается "    "
  пример «Без просьбы пробелов нет»
    дано «сколько» равно 0
    ожидается ""
  если «сколько» больше 0
    то соединить " " с («Пробелы» от («сколько» минус 1))
    иначе ""

тотальная функция «Шапка файла»
  принимает «есть модуль»: признак, «модуль»: строка, «что»: строка
  возвращает строка
  обеспечивает «шапка файла называет напечатанный файл» результат содержит (соединить [" * Файл: ", «что», ".\n"] по "")
  пусть «строка модуля» равно (если «есть модуль» то (соединить [" * Модуль flang: «", «модуль», "»."] по "") иначе " * Программа flang без имени модуля.")
  соединить ["/*\n", " * Сгенерировано flang (бэкенд C, flang/self/emit-c.flang). Не редактировать руками.\n", «строка модуля», "\n * Файл: ", «что», ".\n", " * Правьте исходник на flang и печатайте заново: любая правка здесь потеряется.\n", " */"] по ""

функция «Пометка типа»
  принимает «тип»: «Значение»
  возвращает строка
  обеспечивает «пометка бывает только у записи типа» если (не («Это запись» от «тип»)) то результат равен "" иначе результат равен («Пометка вида типа» от «тип»)
  если «Это запись» от «тип»
    то «Пометка вида типа» от «тип»
    иначе ""

функция «Пометка вида типа»
  принимает «тип»: «Значение»
  возвращает строка
  обеспечивает «строковый тип помечается словом строка» если ((«Вид узла» от «тип») равен "string") то результат равен ": строка" иначе да
  разбор («Вид узла» от «тип»)
    случай "string"
      то ": строка"
    случай "number"
      то ": число"
    случай "boolean"
      то ": признак"
    случай "nothing"
      то ": ничто"
    случай "list"
      то соединить ": список" с («Пометка типа» от («Взять поле» от «тип» и "of"))
    случай любое
      то «Пометка имени типа» от «тип»

тотальная функция «Пометка имени типа»
  принимает «тип»: «Значение»
  возвращает строка
  обеспечивает «без строки в name пометки имени нет» если (не («Это строка» от («Взять поле» от «тип» и "name"))) то результат равен "" иначе результат равен (соединить [": «", («Строка поля» от «тип» и "name"), "»"] по "")
  пример «без строки в name пометки имени нет»
    дано «тип» равно (вариант «Значение записи» с «поля» равным пустой список)
    ожидается ""
  если «Это строка» от («Взять поле» от «тип» и "name")
    то соединить [": «", («Строка поля» от «тип» и "name"), "»"] по ""
    иначе ""

функция «Объявление фабрики»
  принимает «запись»: «Запись типа», «общее»: «Общее»
  возвращает строка
  обеспечивает «объявление фабрики берёт ctx и отдаёт out» (результат начинается с "fl_status ") и притом (результат содержит "(fl_ctx *ctx")
  пусть «идентификаторы» равно («Уникальные имена» от («Имена полей типа» от («запись».«поля»)))
  пусть «параметры» равно (соединить (отобразить «идентификаторы» как «идентификатор» → соединить "fl_value " с «идентификатор») по ", ")
  пусть «после» равно (если пусто «идентификаторы» то "" иначе (соединить ", " с «параметры»))
  соединить ["fl_status ", («Значение по ключу» от («общее».«ид фабрик») и («запись».«имя»)), "(fl_ctx *ctx", «после», ", fl_value *out, fl_error *error)"] по ""

функция «Объявление конструктора»
  принимает «вариант»: «Вариант типа», «общее»: «Общее»
  возвращает строка
  обеспечивает «объявление конструктора отдаёт значение через out» (результат начинается с "fl_status ") и притом (результат содержит ", fl_value *out, fl_error *error)")
  пусть «идентификаторы» равно («Уникальные имена» от («Имена полей типа» от («вариант».«поля»)))
  пусть «параметры» равно (соединить (отобразить «идентификаторы» как «идентификатор» → соединить "fl_value " с «идентификатор») по ", ")
  пусть «после» равно (если пусто «идентификаторы» то "" иначе (соединить ", " с «параметры»))
  соединить ["fl_status ", («Значение по ключу» от («общее».«ид вариантов») и («вариант».«имя»)), "(fl_ctx *ctx", «после», ", fl_value *out, fl_error *error)"] по ""

тотальная функция «Объявление функции»
  принимает «функция»: «Функция», «общее»: «Общее»
  возвращает строка
  обеспечивает «объявление функции отдаёт значение через result» (результат начинается с "fl_status ") и притом (результат содержит ", fl_value *result, fl_error *error)")
  пусть «идентификаторы» равно («Идентификаторы для» от («общее».«ид параметров») и («функция».«имя»))
  пусть «параметры» равно (соединить (отобразить «идентификаторы» как «идентификатор» → соединить "fl_value " с «идентификатор») по ", ")
  пусть «после» равно (если пусто «идентификаторы» то "" иначе (соединить ", " с «параметры»))
  соединить ["fl_status ", («Значение по ключу» от («общее».«ид функций») и («функция».«имя»)), "(fl_ctx *ctx", «после», ", fl_value *result, fl_error *error)"] по ""

тотальная функция «Самовызов в хвосте»
  принимает «функция»: «Функция», «общее»: «Общее»
  возвращает признак
  обеспечивает «функция с постусловиями в цикл не свёртывается» если (длина («функция».«постусловия»)) больше 0 то результат равен нет иначе результат равен ((«Цели» от («общее».«хвостовые») и («функция».«имя»)) содержит («функция».«имя»))
  пример «функция с постусловиями в цикл не свёртывается»
    дано «функция» равно (запись «Функция» с «имя» равным "" и «тотальная» равным нет и «параметры» равным пустой список и «возвращает» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)) и «тело» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)) и «постусловия» равным [(запись «Постусловие» с «имя» равным "" и «выражение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)) и «связывание» равным "результат" и «код» равным "FLANG_PROPERTY" и «сообщение» равным "" и «есть сообщение» равным нет)] и «предусловия» равным пустой список)
    дано «общее» равно (запись «Общее» с «префикс» равным "" и «функции» равным пустой список и «записи» равным пустой список и «варианты» равным пустой список и «суммы» равным пустой список и «ид функций» равным пустой список и «ид фабрик» равным пустой список и «ид вариантов» равным пустой список и «ид шагов» равным пустой список и «ид параметров» равным пустой список и «хвостовые» равным пустой список и «циклические» равным пустой список и «рекурсивные» равным пустой список)
    ожидается нет
  если (длина («функция».«постусловия»)) больше 0
    то нет
    иначе («Цели» от («общее».«хвостовые») и («функция».«имя»)) содержит («функция».«имя»)

тотальная функция «Члены батута»
