    (запись «Пара имён» с «ключ» равным "gte" и «значение» равным "fl_gte"),
    (запись «Пара имён» с «ключ» равным "lte" и «значение» равным "fl_lte"),
    (запись «Пара имён» с «ключ» равным "concat" и «значение» равным "fl_concat")
  ]

// ── операция, у которой тип обоих операндов ДОКАЗАН ──
//
// `fl_add` в рантайме начинается со сверки тегов обоих значений — той самой
// работы, которую вывод типов уже сделал на исходнике. Там, где сделал, на узле
// стоит отметка `числовая`, и печать ставит вместо вызова само выражение.
//
// Доказывает не печать — отметку кладёт анализ, и здесь она только читается.
// Правило то же и по той же причине, что у `доказана` у частичной формы: восьми
// целям иначе пришлось бы завести по своему выводу типов, а этой копии он не
// виден вовсе — круг импортов.
//
// Выражения — дословные тела помощников из `flang_runtime.c`, и это условие
// правильности, а не стиль: ответы обязаны совпасть побайтово, а значит порядок
// действий и округление обязаны быть теми же. Отсюда `fmod` у остатка и скобки
// у процента — `(левое / 100) * правое` переставить нельзя, меняется последний
// бит мантиссы.
тотальная функция «Снимаются числом»
  возвращает список строки
  обеспечивает «операций, снимаемых числом, ровно десять» (длина результат) равен 10
  ["add", "sub", "mul", "div", "mod", "percent", "gt", "lt", "gte", "lte"]

тотальная функция «Есть прямая арифметика»
  принимает «операция»: строка
  возвращает признак
  обеспечивает «прямая арифметика — это шесть операций» результат равен (["add", "sub", "mul", "div", "mod", "percent"] содержит «операция»)
  пример «Сложение печатается знаком»
    дано «операция» равно "add"
    ожидается да
  пример «Сравнение прямой арифметикой не считается»
    дано «операция» равно "gt"
    ожидается нет
  ["add", "sub", "mul", "div", "mod", "percent"] содержит «операция»

тотальная функция «Прямая арифметика»
  принимает «операция»: строка, «левое»: строка, «правое»: строка
  возвращает строка
  обеспечивает «сложение печатается знаком плюс» если «операция» равен "add" то результат равен (соединить [«левое», " + ", «правое»] по "") иначе да
  пример «Сложение — знаком, а не вызовом»
    дано «операция» равно "add"
    дано «левое» равно "a"
    дано «правое» равно "b"
    ожидается "a + b"
  разбор «операция»
    случай "add"
      то соединить [«левое», " + ", «правое»] по ""
    случай "sub"
      то соединить [«левое», " - ", «правое»] по ""
    случай "mul"
      то соединить [«левое», " * ", «правое»] по ""
    случай "div"
      то соединить [«левое», " / ", «правое»] по ""
    случай "mod"
      то соединить ["fmod(", «левое», ", ", «правое», ")"] по ""
    случай "percent"
      то соединить ["(", «левое», " / 100.0) * ", «правое»] по ""
    случай любое
      то ""

// Сравнения порядка: в C это те же знаки, потому что оба операнда — double.
тотальная функция «Прямой порядок»
  принимает «операция»: строка
  возвращает строка
  обеспечивает «больше печатается угловой скобкой» если «операция» равен "gt" то результат равен ">" иначе да
  разбор «операция»
    случай "gt"
      то ">"
    случай "lt"
      то "<"
    случай "gte"
      то ">="
    случай "lte"
      то "<="
    случай любое
      то ""

// Место, где проверку тегов печатать не надо: отметка стоит и операция из тех,
// у которых эта проверка вообще есть.
тотальная функция «Место снято числом»
  принимает «узел»: «Значение»
  возвращает признак
  обеспечивает «без отметки числовая место числом не снимается» если (не («Это истина» от («Взять поле» от «узел» и "числовая"))) то результат равен нет иначе да
  пример «без отметки числовая место числом не снимается»
    дано «узел» равно (вариант «Значение записи» с «поля» равным пустой список)
    ожидается нет
  если «Это истина» от («Взять поле» от «узел» и "числовая")
    то «Снимаются числом» содержит («Строка поля» от «узел» и "op")
    иначе нет

тотальная функция «Слово аргументов»
  принимает «количество»: число
  возвращает строка
  обеспечивает «один аргумент склоняется в единственном числе» если ((((«количество» остаток от 100) остаток от 10) равен 1) и притом (не («Между» от («количество» остаток от 100) и 11 и 14))) то результат равен "аргумент" иначе да
  пример «Один аргумент»
    дано «количество» равно 1
    ожидается "аргумент"
  пример «Два аргумента»
    дано «количество» равно 2
    ожидается "аргумента"
  пример «Одиннадцать аргументов»
    дано «количество» равно 11
    ожидается "аргументов"
  пусть «сто» равно («количество» остаток от 100)
  пусть «десять» равно («сто» остаток от 10)
  если «Между» от «сто» и 11 и 14
    то "аргументов"
    иначе
      если «десять» равен 1
        то "аргумент"
        иначе
          если «Между» от «десять» и 2 и 4
            то "аргумента"
            иначе "аргументов"

тотальная функция «Между»
  принимает «значение»: число, «от»: число, «до»: число
  возвращает признак
  обеспечивает «ниже нижней границы — не между» если «значение» меньше «от» то результат равен нет иначе да
  обеспечивает «выше верхней границы — не между» если (не («значение» меньше «от»)) то (если «значение» больше «до» то результат равен нет иначе да) иначе да
  обеспечивает «внутри границ — между» если (не («значение» меньше «от»)) то (если (не («значение» больше «до»)) то результат равен да иначе да) иначе да
  пример «Пять между единицей и десяткой»
    дано «значение» равно 5
    дано «от» равно 1
    дано «до» равно 10
    ожидается да
  пример «Ноль ниже нижней границы»
    дано «значение» равно 0
    дано «от» равно 1
    дано «до» равно 10
    ожидается нет
  пример «Одиннадцать выше верхней границы»
    дано «значение» равно 11
    дано «от» равно 1
    дано «до» равно 10
    ожидается нет
  если «значение» меньше «от»
    то нет
    иначе
      если «значение» больше «до»
        то нет
        иначе да

// ═══════════════════════════ мелкие помощники печати ═══════════════════════════

объект «Зип»
  «индекс»: число
  «текст»: строка

тотальная функция «Шаг выбора»
  принимает «акк»: «Зип», «элемент»: строка, «искомый»: число
  возвращает «Зип»
  обеспечивает «шаг выбора двигает индекс на один» (результат.«индекс») равен ((«акк».«индекс») плюс 1)
  пример «На искомом индексе берётся элемент»
    дано «акк» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
    дано «элемент» равно "a"
    дано «искомый» равно 0
    ожидается (запись «Зип» с «индекс» равным 1 и «текст» равным "a")
  пример «Мимо искомого индекса текст не меняется»
    дано «акк» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
    дано «элемент» равно "a"
    дано «искомый» равно 1
    ожидается (запись «Зип» с «индекс» равным 1 и «текст» равным "")
  если («акк».«индекс») равен «искомый»
    то запись «Зип» с «индекс» равным ((«акк».«индекс») плюс 1) и «текст» равным «элемент»
    иначе запись «Зип» с «индекс» равным ((«акк».«индекс») плюс 1) и «текст» равным («акк».«текст»)

// Элемент по номеру с НУЛЯ.
//
// ПОЧЕМУ ЗДЕСЬ ЭТО ВАЖНЕЕ, ЧЕМ ГДЕ-ЛИБО ЕЩЁ. Все шесть мест, зовущих эту
// функцию, стоят ВНУТРИ свёрток по тем же самым спискам — «Шаг присвоения
// поля», «Шаг присвоения параметра», «Строка параметра», «Шаг присвоения
// фабрики», «Связать параметр», «Шаг распаковки». Каждая свёртка идёт по N
// элементам и на каждом витке спрашивала N-й элемент обходом. Это не линия, а
// КВАДРАТ: печать одной записи из N полей стоила N².
//
// Линейная доля остаётся — печать N полей и не может стоить меньше N, — а
// квадратичная уходит: чем шире запись, тем больше разрыв. Само взятие стоит
// у встроенной формы постоянного времени, а обходом — линейного.
//
// СТОРОЖ ПЕРЕД ФОРМОЙ НЕ ПЕРЕСТРАХОВКА, А СОХРАНЕНИЕ ДОГОВОРА. У встроенной
// формы он ДРУГОЙ: вне списка и на дробном номере она ОТКАЗЫВАЕТ, а свёртка на
// таком номере просто ни разу не срабатывает и отдаёт заготовку — пустую
// строку. Поэтому обход оставлен ровно для тех номеров, на которых ответы
// расходятся, и достаётся им буква в букву прежний. Сюда же попадает −0:
// `(−0 остаток от 1) равен 0` ложно, номер уходит в обход и получает "".
// Прямая подмена отдала бы на −0 ПЕРВЫЙ элемент, потому что −0 — целое, а
// `−0 плюс 1` равно 1.
//
// Сам сторож стоит постоянного времени: `длина` списка — поле, а не обход.
тотальная функция «Элемент по индексу»
  принимает «строки»: список строки, «индекс»: число
  возвращает строка
  обеспечивает «в пустом списке элемента нет» если пусто «строки» то результат равен "" иначе да
  если ((«индекс» остаток от 1) равен 0) и притом («индекс» не меньше 0) и притом («индекс» меньше (длина «строки»))
    то элемент («индекс» плюс 1) в «строки»
    иначе
      пусть «начало» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
      пусть «итог» равно (свёртка «строки» начиная с «начало» как «акк» и «элемент» → «Шаг выбора» от «акк» и «элемент» и «индекс»)
      «итог».«текст»

тотальная функция «Не встречается»
  принимает «вывод»: строка, «идентификатор»: строка
  возвращает признак
  обеспечивает «невстречаемость — это отсутствие слова в выводе» результат равен (не («Есть слово» от «вывод» и «идентификатор»))
  пример «Свободное имя в выводе не встречается»
    дано «вывод» равно "  fl_t1 = 1;"
    дано «идентификатор» равно "fl_t2"
    ожидается да
  пример «Занятое имя встречается»
    дано «вывод» равно "  fl_t1 = 1;"
    дано «идентификатор» равно "fl_t1"
    ожидается нет
  если «Есть слово» от «вывод» и «идентификатор»
    то нет
    иначе да

// Связанное, но не использованное имя — обычное дело в языке с образцами
// («случай голова и хвост», а голова телу не нужна). В C это
// -Wunused-variable, то есть с -Werror ошибка сборки. Молча не объявлять такую
// переменную нельзя: привязка обязана вычислиться. Поэтому объявляем всегда, а
// неиспользованные гасим `(void)имя;` — тем же приёмом, каким это делают руками.
тотальная функция «Гасить неиспользованные»
  принимает «вывод»: строка, «идентификаторы»: список строки, «отступ»: строка
  возвращает строка
  обеспечивает «прежний вывод сохраняется целиком» результат содержит «вывод»
  пусть «лишние» равно (отфильтровать «идентификаторы» где «идентификатор» → «Не встречается» от «вывод» и «идентификатор»)
  пусть «гашение» равно (соединить (отобразить «лишние» как «идентификатор» → «Строка вывода» от «отступ» и (соединить ["(void)", «идентификатор», ";"] по "")) по "")
  соединить «гашение» с «вывод»

// Проход идёт свёрткой по списку символов, а не по индексу: «индекс дошёл до
// длины» анализ убыванием не считает, а конец списка — считает.
тотальная функция «Только символы слова»
  принимает «текст»: строка
  возвращает признак
  обеспечивает «пустой текст несловесных знаков не содержит» если «текст» равен "" то результат равен да иначе да
  пример «Имя из букв и цифр»
    дано «текст» равно "fl_b_1"
    ожидается да
  пример «Пробел словом не является»
    дано «текст» равно "a b"
    ожидается нет
  свёртка (разложить «текст» на символы) начиная с да как «акк» и «знак»
    если «акк»
      то «Это символ слова» от «знак»
      иначе нет

тотальная функция «Это идентификатор»
  принимает «текст»: строка
  возвращает признак
  обеспечивает «пустой текст идентификатором не бывает» если (длина «текст») равен 0 то результат равен нет иначе да
  пример «Имя временной переменной — идентификатор»
    дано «текст» равно "fl_t1"
    ожидается да
  пример «С цифры идентификатор не начинается»
    дано «текст» равно "1st"
    ожидается нет
  если (длина «текст») равен 0
    то нет
    иначе
      если «Цифры» содержит («Первый символ C» от «текст»)
        то нет
        иначе «Только символы слова» от «текст»

тотальная функция «Аргументы после ctx»
  принимает «аргументы»: список строки
  возвращает строка
  обеспечивает «без аргументов после ctx ничего не печатается» если пусто «аргументы» то результат равен "" иначе да
  пример «Без аргументов после ctx пусто»
    дано «аргументы» равно пустой список
    ожидается ""
  пример «Два аргумента идут через запятую после ctx»
    дано «аргументы» равно ["fl_t1", "fl_t2"]
    ожидается ", fl_t1, fl_t2"
  если пусто «аргументы»
    то ""
    иначе соединить ", " с (соединить «аргументы» по ", ")

// ═══════════════════════════ печать выражений ═══════════════════════════

объект «Итог образца»
  «состояние»: «Состояние»
  «вывод»: строка
  «есть проверка»: признак
  «проверка»: строка

объект «Итог связывания в C»
  «состояние»: «Состояние»
  «вывод»: строка
  «контекст»: «Контекст»
  «идентификаторы»: список строки

объект «Случай печати»
  «тело»: «Значение»
  «образец»: «Значение»
  «есть проверка»: признак
  «проверка»: строка

объект «Сбор случаев»
  «состояние»: «Состояние»
  «вывод»: строка
  «случаи»: список «Случай печати»

объект «Сборка»
  «состояние»: «Состояние»
  «вывод»: строка
  «индекс»: число
  «части»: список строки

тотальная функция «Пустая сборка»
  принимает «состояние»: «Состояние»
  возвращает «Сборка»
  обеспечивает «пустая сборка без вывода, индекса и частей» (((результат.«вывод») равен "") и притом ((результат.«индекс») равен 0)) и притом (пусто (результат.«части»))
  пример «пустая сборка без вывода, индекса и частей»
    дано «состояние» равно (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "")
    ожидается (запись «Сборка» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «вывод» равным "" и «индекс» равным 0 и «части» равным пустой список)
  запись «Сборка» с «состояние» равным «состояние» и «вывод» равным "" и «индекс» равным 0 и «части» равным пустой список

// ── литералы ──

тотальная функция «Печать скаляра C»
  принимает «скаляр»: «Скаляр», «состояние»: «Состояние», «префикс»: строка
  возвращает «Итог»
  обеспечивает «скаляр строк вывода не даёт» (результат.«вывод») равен ""
  разбор «скаляр»
    случай «Скаляр ничто»
      то запись «Итог» с «состояние» равным «состояние» и «вывод» равным "" и «значение» равным "fl_nothing()"
    случай вариант «Скаляр признак» с «значение» как «значение»
      то «Печать признака C» от «значение» и «состояние»
    случай вариант «Скаляр число» с «значение» как «значение»
      то «Печать числа C» от «значение» и «состояние»
    случай вариант «Скаляр строка» с «значение» как «значение»
      то «Печать текста C» от «значение» и «состояние» и «префикс»

тотальная функция «Печать признака C»
  принимает «значение»: признак, «состояние»: «Состояние»
  возвращает «Итог»
  обеспечивает «признак печатается вызовом fl_flag» ((результат.«значение») равен (если «значение» то "fl_flag(true)" иначе "fl_flag(false)")) и притом ((результат.«состояние») равен «состояние»)
  пример «ложь печатается вызовом fl_flag с false»
    дано «значение» равно нет
    дано «состояние» равно (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "")
    ожидается (запись «Итог» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «вывод» равным "" и «значение» равным "fl_flag(false)")
  пусть «текст» равно (если «значение» то "fl_flag(true)" иначе "fl_flag(false)")
  запись «Итог» с «состояние» равным «состояние» и «вывод» равным "" и «значение» равным «текст»

тотальная функция «Печать числа C»
  принимает «значение»: число, «состояние»: «Состояние»
  возвращает «Итог»
  обеспечивает «число печатается вызовом fl_number» (результат.«значение») равен (соединить ["fl_number(", («Число C» от «значение»), ")"] по "")
  пример «ноль печатается вызовом fl_number»
    дано «значение» равно 0
    дано «состояние» равно (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "")
    ожидается (запись «Итог» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «вывод» равным "" и «значение» равным "fl_number(0.0)")
  пусть «дальше» равно (если «Не конечное» от «значение» то («Включить математику» от «состояние») иначе «состояние»)
  пусть «текст» равно (соединить ["fl_number(", («Число C» от «значение»), ")"] по "")
  запись «Итог» с «состояние» равным «дальше» и «вывод» равным "" и «значение» равным «текст»

тотальная функция «Печать текста C»
  принимает «значение»: строка, «состояние»: «Состояние», «префикс»: строка
  возвращает «Итог»
  обеспечивает «текст строк вывода не даёт» (результат.«вывод») равен ""
  пример «известный текст строк вывода не даёт»
    дано «значение» равно "да"
    дано «состояние» равно (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным [(запись «Пара имён» с «ключ» равным "s:да" и «значение» равным "fl_text_1")] и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "")
    дано «префикс» равно "fl"
    ожидается (запись «Итог» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным [(запись «Пара имён» с «ключ» равным "s:да" и «значение» равным "fl_text_1")] и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «вывод» равным "" и «значение» равным "fl_text_1")
  пусть «свежее» равно («Текстовый литерал» от «состояние» и «префикс» и «значение»)
  запись «Итог» с «состояние» равным («свежее».«состояние») и «вывод» равным "" и «значение» равным («свежее».«имя»)

// ── литеральное значение: своя семья обхода, отрезанная от обхода выражений ──
//
// Ходи литерал по тем же «Печать списка» и «Печать полей», что и выражение,
// его обход попал бы в общий круг взаимной рекурсии — и не доказывался бы
// вместе с ним.
//
// Здесь он отрезан, и отрезан по правилу анализа завершаемости: вдоль круга
// одна и та же позиция (первая) обязана убывать на КАЖДОМ ребре. Отсюда три
// решения, и каждое обязательно:
//
//   1. Обход списка написан `разбор`ом по голове и хвосту, а не свёрткой с
//      вынесенным шагом. У вынесенного шага первым доводом ехал бы накопитель,
//      а узел — вторым, и позиция бы не сошлась.
//   2. Ветка пустого списка стоит ЗДЕСЬ, а не в отдельной «Печать списка»:
//      та передавала бы список дальше неизменным, и ребро бы не убыло.
//   3. Сборка текста C вынесена в спутников, которые узел уже не видят
//      («Сложить элемент литерала», «Свести список литерала», …): они принимают
//      готовые записи, в круг не входят и потому позицию не стерегут.
тотальная функция «Печать литерала»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Итог»
  обеспечивает «пустой литеральный список печатается как fl_list с NULL» если ((«Это список» от «узел») и притом (пусто («Элементы узла» от «узел»))) то (((результат.«значение») равен "fl_list(NULL, 0)") и притом ((результат.«вывод») равен "")) иначе да
  разбор «узел»
    случай вариант «Значение скаляра» с «скаляр» как «скаляр»
      то «Печать скаляра C» от «скаляр» и «состояние» и ((«контекст».«общее»).«префикс»)
    случай вариант «Значение списка» с «элементы» как «элементы»
      если пусто «элементы»
        то запись «Итог» с «состояние» равным «состояние» и «вывод» равным "" и «значение» равным "fl_list(NULL, 0)"
        иначе «Свести список литерала» от («Собрать элементы литерала» от «элементы» и («Сборка под массив литерала» от «состояние») и «контекст» и «отступ» и («Имя массива литерала» от «состояние»)) и (длина «элементы») и («Имя массива литерала» от «состояние») и «отступ»
    случай вариант «Значение записи» с «поля» как «поля»
      то «Свести поля литерала» от («Собрать поля литерала» от «поля» и («Пустая сборка» от «состояние») и «контекст» и «отступ») и (отобразить «поля» как «поле» → «поле».«ключ») и «контекст» и «отступ»

// ── список значений ──

// Убывает первый довод: сюда приезжает список (часть узла), обратно уезжают
// голова (часть списка) и хвост (часть списка). Обоих ребёр хватает.
тотальная функция «Собрать элементы литерала»
  принимает «элементы»: список «Значение», «сборка»: «Сборка», «контекст»: «Контекст», «отступ»: строка, «массив»: строка
  возвращает «Сборка»
  обеспечивает «без элементов сборка не меняется» если пусто «элементы» то результат равен «сборка» иначе да
  разбор «элементы»
    случай пусто
      то «сборка»
    случай голова «голова» и хвост «хвост»
      то «Собрать элементы литерала» от «хвост» и («Сложить элемент литерала» от «сборка» и («Печать литерала» от «голова» и «контекст» и («сборка».«состояние») и «отступ») и «отступ» и «массив») и «контекст» и «отступ» и «массив»

тотальная функция «Сложить элемент литерала»
  принимает «сборка»: «Сборка», «итог»: «Итог», «отступ»: строка, «массив»: строка
  возвращает «Сборка»
  обеспечивает «сложение элемента двигает индекс на один» ((результат.«индекс») равен ((«сборка».«индекс») плюс 1)) и притом ((результат.«части») равен («сборка».«части»))
  пример «сложение элемента двигает индекс на один»
    дано «сборка» равно (запись «Сборка» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «вывод» равным "" и «индекс» равным 0 и «части» равным пустой список)
    дано «итог» равно (запись «Итог» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «вывод» равным "" и «значение» равным "fl_t1")
    дано «отступ» равно ""
    дано «массив» равно "fl_a"
    ожидается (запись «Сборка» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным пустой список и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «вывод» равным "fl_a[0] = fl_t1;\n" и «индекс» равным 1 и «части» равным пустой список)
  пусть «строка» равно («Строка вывода» от «отступ» и (соединить [«массив», "[", (к строке («сборка».«индекс»)), "] = ", («итог».«значение»), ";"] по ""))
  пусть «вывод» равно (соединить [(«сборка».«вывод»), («итог».«вывод»), «строка»] по "")
  запись «Сборка» с «состояние» равным («итог».«состояние») и «вывод» равным «вывод» и «индекс» равным ((«сборка».«индекс») плюс 1) и «части» равным («сборка».«части»)

// Имя массива и начальная сборка берутся из одного и того же «Временное»:
