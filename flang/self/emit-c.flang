    дано «префикс» равно "fl"
    дано «имена» равно пустой список
    дано «ключ» равно "[]"
    ожидается (запись «Свежее» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным [(запись «Пара имён» с «ключ» равным "[]" и «значение» равным "fl_names_1")] и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «имя» равным "fl_names_1")
  если «Есть в таблице» от («состояние».«ключи») и «ключ»
    то запись «Свежее» с «состояние» равным «состояние» и «имя» равным («Значение по ключу» от («состояние».«ключи») и «ключ»)
    иначе «Новый массив имён» от «состояние» и «префикс» и «имена» и «ключ»

// Объявление текстовой постоянной: обычной — строковой, длинной — октетным
// массивом с приведением указателя.
//
// ВЕТКА ВЫБИРАЕТСЯ ДО СЧЁТА ОКТЕТОВ, и это не стилистика. Октеты считаются
// разложением строки на символы, то есть стоят длины текста; посчитать их для
// КАЖДОЙ постоянной значило бы заплатить эту цену на каждой из тысяч ради
// одной, которая не влезла. Здесь они считаются только в той ветке, куда
// дошло.
тотальная функция «Объявление текста»
  принимает «идентификатор»: строка, «текст»: строка, «байтов»: число, «точки»: строка
  возвращает строка
  обеспечивает «объявление кончается точкой с запятой» результат содержит "} } };"
  пример «Короткая постоянная едет строкой»
    дано «идентификатор» равно "m_text_1"
    дано «текст» равно "ab"
    дано «байтов» равно 2
    дано «точки» равно "2"
    ожидается "static const fl_value m_text_1 = { FL_STRING, { .string = { \"ab\", 2, 2 } } };"
  если «байтов» больше («Предел строковой постоянной C»)
    то соединить ["static const unsigned char ", «идентификатор», "_octets[] = { ", («Перечень октетов» от «текст»), ", 0 };\n", "static const fl_value ", «идентификатор», " = { FL_STRING, { .string = { (const char *)", «идентификатор», "_octets, ", (к строке «байтов»), ", ", «точки», " } } };"] по ""
    иначе соединить ["static const fl_value ", «идентификатор», " = { FL_STRING, { .string = { ", («Строка C» от «текст»), ", ", (к строке «байтов»), ", ", «точки», " } } };"] по ""

// Строковый литерал — константа уровня файла, а не вызов конструктора: длина в
// байтах и в кодовых точках известна при печати, считать её в рантайме на
// каждом обращении незачем.
тотальная функция «Новый текстовый литерал»
  принимает «состояние»: «Состояние», «префикс»: строка, «текст»: строка, «ключ»: строка
  возвращает «Свежее»
  обеспечивает «новый текстовый литерал добавляет один ключ» (длина (результат.«состояние».«ключи»)) равен ((длина («состояние».«ключи»)) плюс 1)
  пусть «идентификатор» равно (соединить [«префикс», "_text_", (к строке ((длина («состояние».«ключи»)) плюс 1))] по "")
  пусть «ключи» равно (добавить (запись «Пара имён» с «ключ» равным «ключ» и «значение» равным «идентификатор») к («состояние».«ключи»))
  пусть «байтов» равно («Байтов в строке» от «текст»)
  пусть «точки» равно (к строке (длина «текст»))
  пусть «объявление» равно («Объявление текста» от «идентификатор» и «текст» и «байтов» и «точки»)
  пусть «статика» равно (соединить («состояние».«статика») с («Строка вывода» от "" и «объявление»))
  запись «Свежее» с «состояние» равным («Заменить статику» от «состояние» и «статика» и «ключи») и «имя» равным «идентификатор»

тотальная функция «Текстовый литерал»
  принимает «состояние»: «Состояние», «префикс»: строка, «текст»: строка
  возвращает «Свежее»
  обеспечивает «известный текст состояния не меняет» если («Есть в таблице» от («состояние».«ключи») и (соединить "s:" с «текст»)) то (результат.«состояние») равен «состояние» иначе да
  пример «известный текст состояния не меняет»
    дано «состояние» равно (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным [(запись «Пара имён» с «ключ» равным "s:да" и «значение» равным "fl_text_1")] и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "")
    дано «префикс» равно "fl"
    дано «текст» равно "да"
    ожидается (запись «Свежее» с «состояние» равным (запись «Состояние» с «счётчик» равным 0 и «статика» равным "" и «ключи» равным [(запись «Пара имён» с «ключ» равным "s:да" и «значение» равным "fl_text_1")] и «математика» равным нет и «взято» равным пустой список и «ошибка» равным "" и «след» равным нет и «протокол» равным "") и «имя» равным "fl_text_1")
  пусть «ключ» равно (соединить "s:" с «текст»)
  если «Есть в таблице» от («состояние».«ключи») и «ключ»
    то запись «Свежее» с «состояние» равным «состояние» и «имя» равным («Значение по ключу» от («состояние».«ключи») и «ключ»)
    иначе «Новый текстовый литерал» от «состояние» и «префикс» и «текст» и «ключ»

