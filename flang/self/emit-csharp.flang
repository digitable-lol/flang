// Батут: наружу торчит обычный метод, внутри — шаг, возвращающий отскок.
// Группа методов приводится к делегату Flang.Step прямо по имени: никакого
// объекта при этом не создаётся сверх самого делегата.
тотальная функция «Печать батута CSharp»
  принимает «функция»: «Функция CSharp», «общее»: «Общее CSharp», «текст»: строка, «документ»: строка
  возвращает строка
  пусть «идентификаторы» равно («Идентификаторы для CSharp» от («общее».«ид параметров») и («функция».«имя»))
  пусть «шаг» равно («Значение по ключу CSharp» от («общее».«ид шагов») и («функция».«имя»))
  пусть «нуль» равно (запись «Зип CSharp» с «индекс» равным 0 и «текст» равным "")
  пусть «распаковка» равно ((свёртка («функция».«параметры») начиная с «нуль» как «акк» и «параметр» → «Шаг распаковки CSharp» от «акк» и «параметр» и «идентификаторы»).«текст»)
  пусть «шаговый документ» равно («Документ CSharp» от [(соединить ["Шаг батута для «", («функция».«имя»), "»: значение либо отскок к соседу по рекурсии."] по ""), "", "Возвращает Value? именно потому, что отскок — это не значение: заполнив", "bounce, шаг обязан вернуть null, и nullable-контекст делает это видимым в", "сигнатуре, а не в комментарии."] и "    ")
  пусть «шаговый» равно (соединить [«шаговый документ», («Строка вывода CSharp» от "    " и (соединить ["private static Value? ", «шаг», "(Ctx ctx, Value[] args, Flang.Bounce bounce)"] по "")), («Строка вывода CSharp» от "    " и "{"), «распаковка», «текст», "    }"] по "")
  пусть «обёртка» равно (соединить [«документ», («Строка вывода CSharp» от "" и («Подпись функции CSharp» от «функция» и «общее»)), («Строка вывода CSharp» от "    " и "{"), («Строка вывода CSharp» от "        " и (соединить ["ctx.Enter(", («Строка CSharp» от («функция».«имя»)), ");"] по "")), («Строка вывода CSharp» от "        " и "try"), («Строка вывода CSharp» от "        " и "{"), («Строка вывода CSharp» от "            " и (соединить ["return Flang.Trampoline(ctx, ", «шаг», ", new Value[] { ", (соединить «идентификаторы» по ", "), " }, ", («Строка CSharp» от («функция».«имя»)), ");"] по "")), («Строка вывода CSharp» от "        " и "}"), («Строка вывода CSharp» от "        " и "finally"), («Строка вывода CSharp» от "        " и "{"), («Строка вывода CSharp» от "            " и "ctx.Leave();"), («Строка вывода CSharp» от "        " и "}"), "    }"] по "")
  соединить [«шаговый», "\n\n", «обёртка»] по ""

// Счётчик глубины обязан уменьшаться и на ошибке, иначе первая же пойманная
// ошибка навсегда съела бы предел; ctx.Enter вне try намеренно — если он сам
// бросил FLANG_RECURSION_LIMIT, входа не было, и выхода быть не должно.
