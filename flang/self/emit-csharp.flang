    (запись «Пара имён CSharp» с «ключ» равным "к числу или беда" и «значение» равным "BToNumberOrFailure"),
    (запись «Пара имён CSharp» с «ключ» равным "к строке" и «значение» равным "BToString"),
    (запись «Пара имён CSharp» с «ключ» равным "пусто" и «значение» равным "BEmpty"),
