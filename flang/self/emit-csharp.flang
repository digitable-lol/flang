тотальная функция «Шапка файла CSharp»
  принимает «есть модуль»: признак, «модуль»: строка, «что»: строка
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить ["// Модуль flang: «", «модуль», "»."] по "") иначе "// Программа flang без имени модуля.")
  соединить [(«Строка вывода CSharp» от "" и "// Сгенерировано flang (бэкенд C#, flang/src/emit/csharp.mjs). Не редактировать руками."), («Строка вывода CSharp» от "" и «строка модуля»), («Строка вывода CSharp» от "" и (соединить ["// Файл: ", «что», "."] по "")), "// Правьте исходник на flang и печатайте заново: любая правка здесь потеряется."] по ""

тотальная функция «Строка документа CSharp»
  принимает «акк»: строка, «строка»: строка, «отступ»: строка
  возвращает строка
  соединить «акк» с («Строка вывода CSharp» от «отступ» и (если (длина «строка») равен 0 то "///" иначе (соединить "/// " с («Экранировать XML CSharp» от «строка»))))

/// Документирующий комментарий C# из готовых строк текста.
тотальная функция «Документ CSharp»
  принимает «строки»: список строки, «отступ»: строка
  возвращает строка
  пусть «тело» равно (свёртка «строки» начиная с "" как «акк» и «строка» → «Строка документа CSharp» от «акк» и «строка» и «отступ»)
  соединить [(«Строка вывода CSharp» от «отступ» и "/// <summary>"), «тело», («Строка вывода CSharp» от «отступ» и "/// </summary>")] по ""

функция «Пометка вида типа CSharp»
  принимает «тип»: «Значение»
  возвращает строка
  разбор («Вид узла CSharp» от «тип»)
    случай "string"
      то ": строка"
    случай "number"
      то ": число"
    случай "boolean"
      то ": признак"
    случай "nothing"
      то ": ничто"
    случай "list"
      то соединить ": список" с («Пометка типа CSharp» от («Взять поле CSharp» от «тип» и "of"))
    случай любое
      то «Пометка имени типа CSharp» от «тип»

тотальная функция «Пометка имени типа CSharp»
  принимает «тип»: «Значение»
  возвращает строка
  если «Это строка CSharp» от («Взять поле CSharp» от «тип» и "name")
    то соединить [": «", («Строка поля CSharp» от «тип» и "name"), "»"] по ""
    иначе ""

функция «Пометка типа CSharp»
  принимает «тип»: «Значение»
  возвращает строка
  если «Это запись CSharp» от «тип»
    то «Пометка вида типа CSharp» от «тип»
    иначе ""

