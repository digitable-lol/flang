    (запись «Пара имён CSharp» с «ключ» равным "элемент" и «значение» равным "BElement"),
    (запись «Пара имён CSharp» с «ключ» равным "добавить" и «значение» равным "BAppend"),
    (запись «Пара имён CSharp» с «ключ» равным "приписать" и «значение» равным "BPrepend"),
    (запись «Пара имён CSharp» с «ключ» равным "остаток от" и «значение» равным "BRemainder"),
    (запись «Пара имён CSharp» с «ключ» равным "процентов от" и «значение» равным "BPercentOf")
  ]

тотальная функция «Арности форм CSharp»
