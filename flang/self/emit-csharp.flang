/// Ключевые слова C# (включая контекстные) и имена базовой библиотеки, которые
/// напечатанный код видит без квалификации. Имя из модели, попавшее сюда после
/// транслитерации, обязано считаться коллизией, а не молча получить суффикс.
тотальная функция «Зарезервировано в CSharp»
  возвращает список строки
  обеспечивает «среди зарезервированных есть слово class» результат содержит "class"
  обеспечивает «длина 1109» (длина результат) равен 141
  [
    "abstract", "as", "base", "bool", "break", "byte", "case", "catch", "char", "checked",
    "class", "const", "continue", "decimal", "default", "delegate", "do", "double", "else",
    "enum", "event", "explicit", "extern", "false", "finally", "fixed", "float", "for",
    "foreach", "goto", "if", "implicit", "in", "int", "interface", "internal", "is", "lock",
    "long", "namespace", "new", "null", "object", "operator", "out", "override", "params",
    "private", "protected", "public", "readonly", "ref", "return", "sbyte", "sealed", "short",
    "sizeof", "stackalloc", "static", "string", "struct", "switch", "this", "throw", "true",
    "try", "typeof", "uint", "ulong", "unchecked", "unsafe", "ushort", "using", "virtual",
    "void", "volatile", "while",
    "add", "and", "alias", "ascending", "args", "async", "await", "by", "descending", "dynamic",
    "equals", "from", "get", "global", "group", "init", "into", "join", "let", "nameof", "not",
    "notnull", "on", "or", "orderby", "partial", "record", "remove", "required", "select", "set",
    "unmanaged", "value", "var", "when", "where", "with", "yield", "_",
    "System", "Console", "Math", "String", "Object", "Double", "Boolean", "Array", "List",
    "Exception", "Type", "Convert", "Enum", "Nullable", "Func", "Action", "StringBuilder",
    "Value", "Field", "FlangError", "Ctx", "Flang", "FlangCli",
    "ctx", "bounce"
  ]

/// Типы, которые печатает рантайм: имя модуля не имеет права их занять.
тотальная функция «Типы рантайма CSharp»
  возвращает список строки
  обеспечивает «типов рантайма ровно шесть» (длина результат) равен 6
  ["Value", "Field", "FlangError", "Ctx", "Flang", "FlangCli"]

/// Имена, которые печатает сам бэкенд в классе программы.
тотальная функция «Объявлено бэкендом CSharp»
  возвращает список строки
  обеспечивает «бэкенд объявляет ровно два имени» (длина результат) равен 2
  ["Call", "NewContext"]

тотальная функция «Занято сначала CSharp»
  возвращает список строки
  обеспечивает «занятое сначала — зарезервированное плюс объявленное бэкендом» (длина результат) равен ((длина «Зарезервировано в CSharp») плюс (длина «Объявлено бэкендом CSharp»))
  свёртка «Объявлено бэкендом CSharp» начиная с «Зарезервировано в CSharp» как «акк» и «имя»
    добавить «имя» к «акк»

/// Идентификатор C# не может начинаться с цифры и не может быть пустым.
тотальная функция «Безопасный идентификатор CSharp»
  принимает «идентификатор»: строка
  возвращает строка
  обеспечивает «пустой идентификатор становится value» если (длина «идентификатор») равен 0 то результат равен "value" иначе да
  обеспечивает «ветка то 1082» (не ((длина «идентификатор») равен 0)) или (результат равен ("value"))
  обеспечивает «ветка иначе то 1082» ((длина «идентификатор») равен 0) или ((не («Цифры CSharp» содержит («Первый символ CSharp» от «идентификатор»))) или (результат равен (соединить "v" с «идентификатор»)))
  обеспечивает «ветка иначе иначе 1082» ((длина «идентификатор») равен 0) или ((«Цифры CSharp» содержит («Первый символ CSharp» от «идентификатор»)) или (результат равен («идентификатор»)))
  пример «Пустой идентификатор становится value»
    дано «идентификатор» равно ""
    ожидается "value"
  пример «Идентификатор с цифры получает приставку v»
    дано «идентификатор» равно "1a"
    ожидается "v1a"
  пример «Цифра не в начале приставки не требует»
    дано «идентификатор» равно "a1"
    ожидается "a1"
  если (длина «идентификатор») равен 0
    то "value"
    иначе
      если «Цифры CSharp» содержит («Первый символ CSharp» от «идентификатор»)
        то соединить "v" с «идентификатор»
        иначе «идентификатор»

функция «Свободное имя CSharp»
  принимает «желаемое»: строка, «взято»: список строки, «суффикс»: число
  возвращает строка
  обеспечивает «занятого кандидата свободным именем не берут» если («взято» содержит (если «суффикс» равен 1 то «желаемое» иначе (соединить «желаемое» с (к строке «суффикс»)))) равен да то результат равен («Свободное имя CSharp» от «желаемое» и «взято» и («суффикс» плюс 1)) иначе да
  обеспечивает «ветка то 1158» (не («взято» содержит ((если «суффикс» равен 1 то «желаемое» иначе (соединить «желаемое» с (к строке «суффикс»)))))) или (результат равен («Свободное имя CSharp» от «желаемое» и «взято» и («суффикс» плюс 1)))
  обеспечивает «ветка иначе то 1158» («взято» содержит ((если «суффикс» равен 1 то «желаемое» иначе (соединить «желаемое» с (к строке «суффикс»))))) или ((не («Похоже на временное CSharp» от ((если «суффикс» равен 1 то «желаемое» иначе (соединить «желаемое» с (к строке «суффикс»)))))) или (результат равен («Свободное имя CSharp» от «желаемое» и «взято» и («суффикс» плюс 1))))
  обеспечивает «ветка иначе иначе 1158» («взято» содержит ((если «суффикс» равен 1 то «желаемое» иначе (соединить «желаемое» с (к строке «суффикс»))))) или ((«Похоже на временное CSharp» от ((если «суффикс» равен 1 то «желаемое» иначе (соединить «желаемое» с (к строке «суффикс»))))) или (результат равен (((если «суффикс» равен 1 то «желаемое» иначе (соединить «желаемое» с (к строке «суффикс»)))))))
  пример «Незанятое желаемое берётся как есть»
    дано «желаемое» равно "a"
    дано «взято» равно пустой список
    дано «суффикс» равно 1
    ожидается "a"
  пример «Занятое желаемое получает номер два»
    дано «желаемое» равно "a"
    дано «взято» равно ["a"]
    дано «суффикс» равно 1
    ожидается "a2"
  пример «Занят и первый номер — берётся третий»
    дано «желаемое» равно "a"
    дано «взято» равно ["a", "a2"]
    дано «суффикс» равно 1
    ожидается "a3"
  пусть «кандидат» равно (если «суффикс» равен 1 то «желаемое» иначе (соединить «желаемое» с (к строке «суффикс»)))
  если «взято» содержит «кандидат»
    то «Свободное имя CSharp» от «желаемое» и «взято» и («суффикс» плюс 1)
    иначе
      если «Похоже на временное CSharp» от «кандидат»
        то «Свободное имя CSharp» от «желаемое» и «взято» и («суффикс» плюс 1)
        иначе «кандидат»

объект «Набор имён CSharp»
  «взято»: список строки
  «имена»: список строки

функция «Шаг уникальных CSharp»
  принимает «акк»: «Набор имён CSharp», «имя»: строка
  возвращает «Набор имён CSharp»
  обеспечивает «шаг добавляет ровно одно имя» (длина (результат.«имена»)) равен ((длина («акк».«имена»)) плюс 1)
  обеспечивает «поле взято 1109» (результат.«взято») равен ((добавить ((«Свободное имя CSharp» от («Безопасный идентификатор CSharp» от («Верблюд CSharp» от «имя»)) и («акк».«взято») и 1)) к («акк».«взято»)))
  обеспечивает «поле имена 1109» (результат.«имена») равен ((добавить ((«Свободное имя CSharp» от («Безопасный идентификатор CSharp» от («Верблюд CSharp» от «имя»)) и («акк».«взято») и 1)) к («акк».«имена»)))
  пример «первое имя ложится в пустой набор»
    дано «акк» равно (запись «Набор имён CSharp» с «взято» равным пустой список и «имена» равным пустой список)
    дано «имя» равно "х"
    ожидается (запись «Набор имён CSharp» с «взято» равным ["h"] и «имена» равным ["h"])
  пусть «выбор» равно («Свободное имя CSharp» от («Безопасный идентификатор CSharp» от («Верблюд CSharp» от «имя»)) и («акк».«взято») и 1)
  запись «Набор имён CSharp» с «взято» равным (добавить «выбор» к («акк».«взято»)) и «имена» равным (добавить «выбор» к («акк».«имена»))

/// Транслитерация в camelCase плюс развод столкновений.
функция «Уникальные имена CSharp»
  принимает «имена»: список строки, «общие»: список строки
  возвращает список строки
  обеспечивает «уникальных имён столько же, сколько исходных» (длина результат) равен (длина «имена»)
  пусть «пусто» равно (запись «Набор имён CSharp» с «взято» равным «общие» и «имена» равным пустой список)
  пусть «итог» равно (свёртка «имена» начиная с «пусто» как «акк» и «имя» → «Шаг уникальных CSharp» от «акк» и «имя»)
  «итог».«имена»

// Роль входит в идентификатор всегда: класс C# — одно пространство имён, и в
// ядре FTS «Значение операнда» — и вариант суммы типов, и запись, и функция.
// Столкнуться поэтому могут только два имени одной роли — и это ошибка печати,
// а не молчаливое переименование.
тотальная функция «Приставка роли CSharp»
  принимает «роль»: строка
  возвращает строка
  обеспечивает «приставка функции — Fn» если «роль» равен "function" то результат равен "Fn" иначе да
  разбор «роль»
    случай "function"
      то "Fn"
    случай "variant"
      то "V"
    случай "record"
      то "Rec"
    случай "step"
      то "Step"
    случай любое
      то ""

тотальная функция «Название роли CSharp»
  принимает «роль»: строка
  возвращает строка
  обеспечивает «роль function называется функцией» если «роль» равен "function" то результат равен "функции" иначе да
  разбор «роль»
    случай "function"
      то "функции"
    случай "variant"
      то "конструктора варианта"
    случай "record"
      то "фабрики записи"
    случай "step"
      то "шага батута"
    случай любое
      то ""

тотальная функция «Идентификатор с ролью CSharp»
  принимает «роль»: строка, «имя»: строка
  возвращает строка
  обеспечивает «идентификатор не короче приставки роли» (длина результат) не меньше (длина («Приставка роли CSharp» от «роль»))
  «Безопасный идентификатор CSharp» от (соединить («Приставка роли CSharp» от «роль») с («Паскаль CSharp» от «имя»))

