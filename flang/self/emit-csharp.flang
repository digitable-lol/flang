  обеспечивает «поле вывод 3517» (результат.«вывод») равен ((соединить [((«Документ CSharp» от ["Вызов функции по её исходному имени flang.", "", "Нужен прогонщику и всякому, кто связывает программу с внешним миром", "динамически (скрипт, тест, служба). Коды и тексты — те же, что у", "интерпретатора: «не найдена функция …» и «функция … принимает N аргум.»."] и "    ")), («Строка вывода CSharp» от "    " и "public static Value Call(Ctx ctx, string name, Value[] args)"), («Строка вывода CSharp» от "    " и "{"), (((свёртка («общее».«функции») начиная с ((запись «Блок CSharp» с «состояние» равным «состояние» и «вывод» равным "")) как «акк» и «функция» → «Шаг ветки диспетчера CSharp» от «акк» и «функция» и «общее»)).«вывод»), («Строка вывода CSharp» от "        " и "throw Flang.Fail(FlangError.CodeUnknownName, \"не найдена функция «\" + name + \"»\");"), "    }"] по ""))
  пусть «документ» равно («Документ CSharp» от ["Вызов функции по её исходному имени flang.", "", "Нужен прогонщику и всякому, кто связывает программу с внешним миром", "динамически (скрипт, тест, служба). Коды и тексты — те же, что у", "интерпретатора: «не найдена функция …» и «функция … принимает N аргум.»."] и "    ")
  пусть «начало» равно (запись «Блок CSharp» с «состояние» равным «состояние» и «вывод» равным "")
  пусть «ветки» равно (свёртка («общее».«функции») начиная с «начало» как «акк» и «функция» → «Шаг ветки диспетчера CSharp» от «акк» и «функция» и «общее»)
  запись «Блок CSharp» с «состояние» равным («ветки».«состояние») и «вывод» равным (соединить [«документ», («Строка вывода CSharp» от "    " и "public static Value Call(Ctx ctx, string name, Value[] args)"), («Строка вывода CSharp» от "    " и "{"), («ветки».«вывод»), («Строка вывода CSharp» от "        " и "throw Flang.Fail(FlangError.CodeUnknownName, \"не найдена функция «\" + name + \"»\");"), "    }"] по "")

// ═══════════════════════════ файлы ═══════════════════════════

тотальная функция «Печать контекста CSharp»
  принимает «настройки»: «Настройки CSharp»
  возвращает строка
  соединить [(«Строка вывода CSharp» от "    " и "/// <summary>"), («Строка вывода CSharp» от "    " и "/// Контекст вычисления с настройками этой программы."), («Строка вывода CSharp» от "    " и "///"), («Строка вывода CSharp» от "    " и "/// Индексация строк, предел глубины вызовов и лимит шагов — это настройки"), («Строка вывода CSharp» от "    " и "/// программы, а не рантайма: печать могла идти с нулевой базой индексации, а"), («Строка вывода CSharp» от "    " и "/// пределы вызывающий вправе поменять прямо в возвращённом контексте."), («Строка вывода CSharp» от "    " и "/// </summary>"), («Строка вывода CSharp» от "    " и "public static Ctx NewContext()"), («Строка вывода CSharp» от "    " и "{"), («Строка вывода CSharp» от "        " и "var ctx = new Ctx();"), («Строка вывода CSharp» от "        " и (соединить ["ctx.IndexBase = ", (к строке («настройки».«база»)), ";"] по "")), («Строка вывода CSharp» от "        " и (соединить ["ctx.MaxDepth = ", (к строке («настройки».«предел глубины»)), ";"] по "")), («Строка вывода CSharp» от "        " и (соединить ["ctx.MaxSteps = ", (к строке («настройки».«предел шагов»)), "L;"] по "")), («Строка вывода CSharp» от "        " и "return ctx;"), "    }"] по ""

тотальная функция «Склеить тела CSharp»
  принимает «части»: список строки
  возвращает строка
  соединить (отфильтровать «части» где «часть» → (длина «часть») больше 0) по "\n\n"

тотальная функция «Исходник модуля CSharp»
  принимает «есть модуль»: признак, «модуль»: строка, «имя класса»: строка, «части»: список строки
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить ["/// Модуль flang «", («Экранировать XML CSharp» от «модуль»), "», напечатанный в C#."] по "") иначе "/// Программа flang, напечатанная в C#.")
  пусть «шапка» равно (соединить [(«Шапка файла CSharp» от «есть модуль» и «модуль» и "реализация: функции, конструкторы значений, вызов по имени"), "\n#nullable enable\n\nusing System.Collections.Generic;\n\n/// <summary>\n", «строка модуля», "\n///\n/// Контракт вызова: метод возвращает значение либо бросает FlangError с кодом и\n/// текстом, дословно совпадающими с интерпретатором flang. Все значения — Value:\n/// числа там всегда double (ни int, ни decimal в flang нет), признак отличается\n/// от числа тегом, а не типом C#, и равенство скаляров — Object.is, а не ==.\n///\n/// Value без вопросительного знака означает «здесь точно есть значение»:\n/// «ничто» в flang — полноценное значение с тегом, а не null.\n/// </summary>\npublic static class ", «имя класса», "\n{"] по "")
  соединить [(«Склеить тела CSharp» от («Слить строки CSharp» от («Слить строки CSharp» от [«шапка»] и «части») и ["}"])), "\n"] по ""

/// Проект .NET SDK. Пуст настолько, насколько это возможно: ни одной ссылки на
/// пакет — только базовая библиотека.
тотальная функция «Печать проекта CSharp»
  принимает «есть модуль»: признак, «модуль»: строка, «прогонщик»: признак
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить ["<!-- Модуль flang: «", «модуль», "». -->"] по "") иначе "<!-- Программа flang без имени модуля. -->")
  пусть «запуск» равно (если «прогонщик» то («Строка вывода CSharp» от "" и "    <StartupObject>FlangCli</StartupObject>") иначе "")
  соединить [(«Строка вывода CSharp» от "" и "<!-- Сгенерировано flang (бэкенд C#). Не редактировать руками. -->"), («Строка вывода CSharp» от "" и «строка модуля»), («Строка вывода CSharp» от "" и "<Project Sdk=\"Microsoft.NET.Sdk\">"), («Строка вывода CSharp» от "" и ""), («Строка вывода CSharp» от "" и "  <PropertyGroup>"), («Строка вывода CSharp» от "" и (соединить ["    <OutputType>", (если «прогонщик» то "Exe" иначе "Library"), "</OutputType>"] по "")), («Строка вывода CSharp» от "" и "    <TargetFramework>net8.0</TargetFramework>"), («Строка вывода CSharp» от "" и "    <RollForward>LatestMajor</RollForward>"), («Строка вывода CSharp» от "" и "    <LangVersion>latest</LangVersion>"), («Строка вывода CSharp» от "" и "    <Nullable>enable</Nullable>"), («Строка вывода CSharp» от "" и "    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>"), («Строка вывода CSharp» от "" и "    <InvariantGlobalization>true</InvariantGlobalization>"), («Строка вывода CSharp» от "" и "    <RootNamespace></RootNamespace>"), («Строка вывода CSharp» от "" и "    <AssemblyName>flang</AssemblyName>"), «запуск», («Строка вывода CSharp» от "" и "    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>"), («Строка вывода CSharp» от "" и "    <GenerateDocumentationFile>false</GenerateDocumentationFile>"), («Строка вывода CSharp» от "" и "  </PropertyGroup>"), («Строка вывода CSharp» от "" и ""), («Строка вывода CSharp» от "" и "</Project>")] по ""

тотальная функция «Печать Makefile CSharp»
  принимает «имя класса»: строка, «прогонщик»: признак
  возвращает строка
  пусть «запуск» равно (если «прогонщик» то (соединить [(«Строка вывода CSharp» от "" и "run: build"), («Строка вывода CSharp» от "" и "\t$(DOTNET) run -v quiet --nologo -- $(CLASS)"), («Строка вывода CSharp» от "" и "")] по "") иначе "")
  соединить [(«Строка вывода CSharp» от "" и "# Сгенерировано flang (бэкенд C#). Целей ровно столько, сколько нужно:"), («Строка вывода CSharp» от "" и "# напечатанный код обязан собираться и запускаться без единой правки."), («Строка вывода CSharp» от "" и "DOTNET ?= dotnet"), («Строка вывода CSharp» от "" и (соединить ["CLASS ?= ", «имя класса»] по "")), («Строка вывода CSharp» от "" и ""), («Строка вывода CSharp» от "" и "all: build"), («Строка вывода CSharp» от "" и ""), («Строка вывода CSharp» от "" и "# Сборка идёт с TreatWarningsAsErrors (см. flang.csproj): напечатанный код"), («Строка вывода CSharp» от "" и "# обязан быть чистым под самым строгим режимом, иначе он не пройдёт в чужую"), («Строка вывода CSharp» от "" и "# сборку."), («Строка вывода CSharp» от "" и "build:"), («Строка вывода CSharp» от "" и "\t$(DOTNET) build -v quiet --nologo"), («Строка вывода CSharp» от "" и ""), «запуск», («Строка вывода CSharp» от "" и "clean:"), («Строка вывода CSharp» от "" и "\t$(DOTNET) clean -v quiet --nologo || true"), («Строка вывода CSharp» от "" и "\trm -rf bin obj"), («Строка вывода CSharp» от "" и ""), («Строка вывода CSharp» от "" и (соединить [".PHONY: all build", (если «прогонщик» то " run" иначе ""), " clean"] по ""))] по ""

// ═══════════════════════════ столкновения имён ═══════════════════════════

объект «Занятое CSharp»
  «идентификатор»: строка
  «роль»: строка
  «имя»: строка

объект «Просьба CSharp»
  «роль»: строка
  «имя»: строка

тип «Может быть занятое CSharp»
  вариант «Есть занятое CSharp» содержит «занятое»: «Занятое CSharp»
  вариант «Нет занятого CSharp»

объект «Именователь CSharp»
  «таблица»: список «Занятое CSharp»
  «состояние»: «Состояние CSharp»

тотальная функция «Найти занятое CSharp»
  принимает «таблица»: список «Занятое CSharp», «идентификатор»: строка
  возвращает «Может быть занятое CSharp»
  обеспечивает «в пустой таблице занятого нет» если (длина «таблица») равен 0 то результат равен (вариант «Нет занятого CSharp») иначе да
  разбор (отфильтровать «таблица» где «занятое» → («занятое».«идентификатор») равен «идентификатор»)
    случай пусто
      то вариант «Нет занятого CSharp»
    случай голова и хвост
      то вариант «Есть занятое CSharp» с «занятое» равным «голова»

тотальная функция «Идентификаторы занятых CSharp»
  принимает «таблица»: список «Занятое CSharp»
  возвращает список строки
  обеспечивает «идентификаторов столько же, сколько занятых» (длина результат) равен (длина «таблица»)
  пример «В пустой таблице занятых идентификаторов нет»
    дано «таблица» равно пустой список
    ожидается пустой список
  пример «У занятого берётся идентификатор, а не имя»
    дано «таблица» равно [(запись «Занятое CSharp» с «идентификатор» равным "Dlina" и «роль» равным "function" и «имя» равным "Длина")]
    ожидается ["Dlina"]
  отобразить «таблица» как «занятое» → «занятое».«идентификатор»

тотальная функция «Положить занятое CSharp»
  принимает «таблица»: список «Занятое CSharp», «новое»: «Занятое CSharp»
  возвращает список «Занятое CSharp»
  обеспечивает «известный идентификатор таблицу не удлиняет, новый удлиняет на один» если («Идентификаторы занятых CSharp» от «таблица») содержит («новое».«идентификатор») то (длина результат) равен (длина «таблица») иначе (длина результат) равен ((длина «таблица») плюс 1)
  обеспечивает «ветка то 3594» (не ((«Идентификаторы занятых CSharp» от «таблица») содержит («новое».«идентификатор»))) или (результат равен (отобразить «таблица» как «прежнее» → (если («прежнее».«идентификатор») равен («новое».«идентификатор») то «новое» иначе «прежнее»)))
  обеспечивает «ветка иначе 3594» ((«Идентификаторы занятых CSharp» от «таблица») содержит («новое».«идентификатор»)) или (результат равен (добавить «новое» к «таблица»))
  пример «первое занятое ложится в пустую таблицу»
    дано «таблица» равно пустой список
    дано «новое» равно (запись «Занятое CSharp» с «идентификатор» равным "a" и «роль» равным "function" и «имя» равным "А")
    ожидается [(запись «Занятое CSharp» с «идентификатор» равным "a" и «роль» равным "function" и «имя» равным "А")]
  если («Идентификаторы занятых CSharp» от «таблица») содержит («новое».«идентификатор»)
    то отобразить «таблица» как «прежнее» → (если («прежнее».«идентификатор») равен («новое».«идентификатор») то «новое» иначе «прежнее»)
    иначе добавить «новое» к «таблица»

тотальная функция «Владелец имени CSharp»
  принимает «занятое»: «Занятое CSharp»
  возвращает строка
  обеспечивает «занятое без роли названо оговоркой C#» если (длина («занятое».«роль»)) равен 0 то результат равен (соединить "зарезервировано в C#: " с («занятое».«имя»)) иначе да
  обеспечивает «ветка то 3602» (не ((длина («занятое».«роль»)) равен 0)) или (результат равен (соединить "зарезервировано в C#: " с («занятое».«имя»)))
  обеспечивает «ветка иначе 3602» ((длина («занятое».«роль»)) равен 0) или (результат равен (соединить [(«Название роли CSharp» от («занятое».«роль»)), " «", («занятое».«имя»), "»"] по ""))
  пример «Занятое без роли названо оговоркой языка»
    дано «занятое» равно запись «Занятое CSharp» с «идентификатор» равным "Console" и «роль» равным "" и «имя» равным "Console"
    ожидается "зарезервировано в C#: Console"
  пример «У занятого ролью названы и роль, и имя»
    дано «занятое» равно запись «Занятое CSharp» с «идентификатор» равным "Dlina" и «роль» равным "function" и «имя» равным "Длина"
    ожидается "функции «Длина»"
  если (длина («занятое».«роль»)) равен 0
    то соединить "зарезервировано в C#: " с («занятое».«имя»)
    иначе соединить [(«Название роли CSharp» от («занятое».«роль»)), " «", («занятое».«имя»), "»"] по ""

тотальная функция «Ошибка столкновения CSharp»
  принимает «состояние»: «Состояние CSharp», «роль»: строка, «имя»: строка, «идентификатор»: строка, «былое»: «Занятое CSharp»
  возвращает «Состояние CSharp»
  обеспечивает «столкновение оставляет непустую ошибку» (длина (результат.«ошибка»)) больше 0
  «Записать ошибку CSharp» от «состояние» и (соединить ["имя ", («Название роли CSharp» от «роль»), " «", «имя», "» даёт идентификатор «", «идентификатор», "», уже занятый (", («Владелец имени CSharp» от «былое»), ") — переименуйте одно из имён в модели"] по "")

тотальная функция «Проверить былое CSharp»
  принимает «состояние»: «Состояние CSharp», «роль»: строка, «имя»: строка, «идентификатор»: строка, «былое»: «Занятое CSharp»
  возвращает «Состояние CSharp»
  обеспечивает «та же роль и то же имя — не столкновение» если ((«былое».«роль») равен «роль») и притом ((«былое».«имя») равен «имя») то результат.«ошибка» равен («состояние».«ошибка») иначе да
  пример «та же роль и то же имя — не столкновение»
    дано «состояние» равно (запись «Состояние CSharp» с «счётчик» равным 0 и «взято» равным пустой список и «ошибка» равным "")
    дано «роль» равно "function"
    дано «имя» равно "Ф"
    дано «идентификатор» равно "F"
    дано «былое» равно (запись «Занятое CSharp» с «идентификатор» равным "F" и «роль» равным "function" и «имя» равным "Ф")
    ожидается (запись «Состояние CSharp» с «счётчик» равным 0 и «взято» равным пустой список и «ошибка» равным "")
  если («былое».«роль») равен «роль»
    то
      если («былое».«имя») равен «имя»
        то «состояние»
        иначе «Ошибка столкновения CSharp» от «состояние» и «роль» и «имя» и «идентификатор» и «былое»
    иначе «Ошибка столкновения CSharp» от «состояние» и «роль» и «имя» и «идентификатор» и «былое»

тотальная функция «Проверить прежнее CSharp»
  принимает «состояние»: «Состояние CSharp», «роль»: строка, «имя»: строка, «идентификатор»: строка, «прежнее»: «Может быть занятое CSharp»
  возвращает «Состояние CSharp»
  обеспечивает «без прежнего занятого состояние цело» если «прежнее» равен (вариант «Нет занятого CSharp») то результат.«ошибка» равен («состояние».«ошибка») иначе да
  обеспечивает «вариант Нет занятого CSharp 4010» если «прежнее» равен (вариант «Нет занятого CSharp») то (результат равен («состояние»)) иначе да
  пример «без прежнего занятого состояние цело»
    дано «состояние» равно (запись «Состояние CSharp» с «счётчик» равным 0 и «взято» равным пустой список и «ошибка» равным "")
    дано «роль» равно "function"
    дано «имя» равно "Ф"
    дано «идентификатор» равно "F"
    дано «прежнее» равно (вариант «Нет занятого CSharp»)
    ожидается (запись «Состояние CSharp» с «счётчик» равным 0 и «взято» равным пустой список и «ошибка» равным "")
  разбор «прежнее»
    случай вариант «Есть занятое CSharp» с «занятое» как «былое»
      то «Проверить былое CSharp» от «состояние» и «роль» и «имя» и «идентификатор» и «былое»
    случай «Нет занятого CSharp»
      то «состояние»

тотальная функция «Занять имя CSharp»
  принимает «именователь»: «Именователь CSharp», «просьба»: «Просьба CSharp»
  возвращает «Именователь CSharp»
  обеспечивает «занятие имени таблицу не укорачивает» (длина (результат.«таблица»)) не меньше (длина («именователь».«таблица»))
  пусть «идентификатор» равно («Идентификатор с ролью CSharp» от («просьба».«роль») и («просьба».«имя»))
  пусть «прежнее» равно («Найти занятое CSharp» от («именователь».«таблица») и «идентификатор»)
  пусть «состояние» равно («Проверить прежнее CSharp» от («именователь».«состояние») и («просьба».«роль») и («просьба».«имя») и «идентификатор» и «прежнее»)
  пусть «новое» равно (запись «Занятое CSharp» с «идентификатор» равным «идентификатор» и «роль» равным («просьба».«роль») и «имя» равным («просьба».«имя»))
  запись «Именователь CSharp» с «таблица» равным («Положить занятое CSharp» от («именователь».«таблица») и «новое») и «состояние» равным «состояние»

тотальная функция «Слить просьбы CSharp»
  принимает «акк»: список «Просьба CSharp», «добавка»: список «Просьба CSharp»
  возвращает список «Просьба CSharp»
  обеспечивает «длина слитых просьб есть сумма длин» (длина результат) равен ((длина «акк») плюс (длина «добавка»))
  пример «без добавки список просьб не меняется»
    дано «акк» равно пустой список
    дано «добавка» равно пустой список
    ожидается пустой список
  свёртка «добавка» начиная с «акк» как «внутри» и «просьба» → добавить «просьба» к «внутри»

тотальная функция «Просьбы имён CSharp»
  принимает «общее»: «Общее CSharp»
  возвращает список «Просьба CSharp»
  // Четыре отображения стоят В САМОМ вызове по той же причине, что и у
  // «Связать поле варианта CSharp»: `пусть`-имя в возвращаемом выражении
  // держит наследование постусловия «Слить просьбы CSharp». Каждое имя
  // звалось по разу — подстановка бесплатна.
  обеспечивает «просьб столько, сколько записей, вариантов, функций и шагов» (длина результат) равен ((((длина («общее».«записи»)) плюс (длина («общее».«варианты»))) плюс (длина («общее».«функции»))) плюс (длина («общее».«ид шагов»)))
  пример «у пустого общего просьб нет»
    дано «общее» равно (запись «Общее CSharp» с «имя класса» равным "" и «функции» равным пустой список и «записи» равным пустой список и «варианты» равным пустой список и «суммы» равным пустой список и «ид функций» равным пустой список и «ид фабрик» равным пустой список и «ид вариантов» равным пустой список и «ид шагов» равным пустой список и «ид параметров» равным пустой список и «общие имена» равным пустой список и «хвостовые» равным пустой список и «циклические» равным пустой список и «рекурсивные» равным пустой список)
    ожидается пустой список
  «Слить просьбы CSharp» от («Слить просьбы CSharp» от («Слить просьбы CSharp» от (отобразить («общее».«записи») как «запись» → запись «Просьба CSharp» с «роль» равным "record" и «имя» равным («запись».«имя»)) и (отобразить («общее».«варианты») как «вариант» → запись «Просьба CSharp» с «роль» равным "variant" и «имя» равным («вариант».«имя»))) и (отобразить («общее».«функции») как «функция» → запись «Просьба CSharp» с «роль» равным "function" и «имя» равным («функция».«имя»))) и (отобразить («общее».«ид шагов») как «пара» → запись «Просьба CSharp» с «роль» равным "step" и «имя» равным («пара».«ключ»))

// Столкновение после транслитерации — ошибка печати, а не тихое
// переименование: «счёт» и «счет» обязаны остаться различимыми для человека,
// который читает сгенерированный код рядом с моделью.
тотальная функция «Проверить столкновения CSharp»
  принимает «общее»: «Общее CSharp», «состояние»: «Состояние CSharp»
  возвращает «Состояние CSharp»
  пусть «зарезервировано» равно (отобразить «Занято сначала CSharp» как «слово» → запись «Занятое CSharp» с «идентификатор» равным «слово» и «роль» равным "" и «имя» равным «слово»)
  пусть «нуль» равно (запись «Именователь CSharp» с «таблица» равным «зарезервировано» и «состояние» равным «состояние»)
  (свёртка («Просьбы имён CSharp» от «общее») начиная с «нуль» как «акк» и «просьба» → «Занять имя CSharp» от «акк» и «просьба»).«состояние»

// ═══════════════════════════ печать программы ═══════════════════════════

функция «Шаг тела функции CSharp»
  принимает «тела»: «Тела CSharp», «функция»: «Функция CSharp», «общее»: «Общее CSharp»
  возвращает «Тела CSharp»
  обеспечивает «шаг тела прибавляет ровно одну часть» (длина (результат.«части»)) равен ((длина («тела».«части»)) плюс 1)
  обеспечивает «поле состояние 3675» (результат.«состояние») равен ((((«Печать функции CSharp» от «функция» и «общее» и («тела».«состояние»))).«состояние»))
  обеспечивает «поле части 3675» (результат.«части») равен ((добавить (((«Печать функции CSharp» от «функция» и «общее» и («тела».«состояние»))).«вывод») к («тела».«части»)))
  пусть «блок» равно («Печать функции CSharp» от «функция» и «общее» и («тела».«состояние»))
  запись «Тела CSharp» с «состояние» равным («блок».«состояние») и «части» равным (добавить («блок».«вывод») к («тела».«части»))

// ═════════════════════════ граница входа ═════════════════════════

тотальная функция «Признак CSharp»
  принимает «значение»: признак
  возвращает строка
  пример «Истина»
    дано «значение» равно да
    ожидается "true"
  пример «Ложь»
    дано «значение» равно нет
    ожидается "false"
  если «значение» то "true" иначе "false"

// Вид типа — в имя члена класса `Flang`. Незнакомое имя даёт `TypeUnknown`, и
// это не заглушка: значение-функция, параметр полиморфизма и применение типа с
// аргументами приезжают сюда именно так, и сверять их нечем.
тотальная функция «Вид типа входа CSharp»
  принимает «вид»: строка
  возвращает строка
  пример «Число»
    дано «вид» равно "число"
    ожидается "Flang.TypeNumber"
  пример «Незнакомое имя — джокер»
    дано «вид» равно "неизвестно"
    ожидается "Flang.TypeUnknown"
  обеспечивает «ветка то 3699» (не («вид» равен "число")) или (результат равен ("Flang.TypeNumber"))
  обеспечивает «ветка иначе то 3699» («вид» равен "число") или ((не («вид» равен "строка")) или (результат равен ("Flang.TypeText")))
  обеспечивает «ветка иначе иначе то 3699» («вид» равен "число") или ((«вид» равен "строка") или ((не («вид» равен "признак")) или (результат равен ("Flang.TypeFlag"))))
  обеспечивает «ветка иначе иначе иначе то 3699» («вид» равен "число") или ((«вид» равен "строка") или ((«вид» равен "признак") или ((не («вид» равен "ничто")) или (результат равен ("Flang.TypeNull")))))
  если «вид» равен "число"
    то "Flang.TypeNumber"
    иначе
      если «вид» равен "строка"
        то "Flang.TypeText"
        иначе
          если «вид» равен "признак"
            то "Flang.TypeFlag"
            иначе
              если «вид» равен "ничто"
                то "Flang.TypeNull"
                иначе
                  если «вид» равен "список"
                    то "Flang.TypeList"
                    иначе
                      если «вид» равен "запись"
                        то "Flang.TypeRecord"
                        иначе (если «вид» равен "сумма" то "Flang.TypeSum" иначе "Flang.TypeUnknown")

тотальная функция «Строка типа входа CSharp»
  принимает «тип»: «Тип входа CSharp»
  возвращает строка
  соединить ["            new Flang.TypeSpec(", («Вид типа входа CSharp» от («тип».«вид»)), ", ", («Строка CSharp» от («тип».«имя»)), ", ", («Строка CSharp» от («тип».«владелец»)), ", ", («Признак CSharp» от («тип».«ничто»)), ", ", («Признак CSharp» от («тип».«целое»)), ", ", («Признак CSharp» от («тип».«отрезок»)), ", ", («Число CSharp» от («тип».«низ»)), ", ", («Число CSharp» от («тип».«верх»)), ", ", (к строке («тип».«элемент»)), ", ", (к строке («тип».«поле с»)), ", ", (к строке («тип».«полей»)), ", ", (к строке («тип».«вариант с»)), ", ", (к строке («тип».«вариантов»)), "),\n"] по ""

тотальная функция «Строка поля входа CSharp»
  принимает «поле»: «Поле входа CSharp»
  возвращает строка
  соединить ["            new Flang.TypeField(", («Строка CSharp» от («поле».«имя»)), ", ", (к строке («поле».«тип»)), "),\n"] по ""

тотальная функция «Строка варианта входа CSharp»
  принимает «вариант»: «Вариант входа CSharp»
  возвращает строка
