// ═════════════════════ имена, занятые самой целью C# ═════════════════════
//
// Имя модуля flang доезжает до цели именем в ЕЁ пространстве имён, а часть этого
// пространства цель занимает сама. Улика: `модуль «JSON»` печатался в `json.py`
// рядом с прогонщиком, тот делал `import json` и получал НАШ модуль вместо
// библиотеки — ломалось не при печати, а при запуске.
//
// Свободное имя возвращается КАК ЕСТЬ: у программы, чьё имя цель не занимала,
// вывод не меняется ни на байт. Занятое обходится СУФФИКСОМ: приставка `flang_`
// у бэкенда уже занята — так зовутся `flang_runtime` и `flang_cli`, и по ней
// напечатанное отличают от программы. Отказывать нельзя: имя автор выбрал
// законно, а набор занятого у цели свой и меняется от её версии.

тотальная функция «Занято целью CSharp»
  возвращает список строки
  обеспечивает «длина 4181» (длина результат) равен 90
  [
    "Action", "Activator", "Array", "ArgumentException", "ArgumentNullException", "ArgumentOutOfRangeException",
    "AttributeUsageAttribute", "Attribute", "Boolean", "Buffer", "Byte", "Char", "Console",
    "Convert", "DateOnly", "DateTime", "DateTimeOffset", "Decimal", "Delegate", "Double",
    "Enum", "Environment", "Exception", "Func", "GC", "Guid", "IComparable", "IDisposable",
    "IEquatable", "IFormattable", "Index", "Int16", "Int32", "Int64", "IntPtr", "Lazy",
    "Math", "MathF", "MemoryExtensions", "Nullable", "Object", "ObsoleteAttribute", "OperatingSystem",
    "OutOfMemoryException", "OverflowException", "Predicate", "Random", "Range", "SByte",
    "Single", "Span", "StackOverflowException", "String", "StringComparer", "StringComparison",
    "SystemException", "TimeOnly", "TimeSpan", "TimeZoneInfo", "Tuple", "Type", "UInt16",
    "UInt32", "UInt64", "UIntPtr", "Uri", "ValueTuple", "ValueType", "Version", "Void",
    "WeakReference", "Comparer", "Dictionary", "EqualityComparer", "HashSet", "ICollection",
    "IComparer", "IDictionary", "IEnumerable", "IEnumerator", "IEqualityComparer", "IList",
    "IReadOnlyList", "KeyValuePair", "LinkedList", "List", "Queue", "SortedDictionary",
    "SortedSet", "Stack"
  ]

// Имя модуля доезжает до C# именем класса и именем файла. Разойтись оно обязано
// не только с именами сборок, но и со всем, что занято языком и рантаймом:
// `модуль «System»` печатался в `System.cs` с классом `System`, и сборка падала
// на CS0437 — тип конфликтует с пространством имён `System` платформы.
тотальная функция «Занято именем модуля CSharp»
  возвращает список строки
  свёртка «Зарезервировано в CSharp» начиная с «Занято целью CSharp» как «акк» и «слово»
    добавить «слово» к «акк»

тотальная функция «Обойти занятое целью CSharp»
  принимает «имя»: строка
  возвращает строка
  обеспечивает «ветка то 3820» (не («Занято именем модуля CSharp» содержит «имя»)) или (результат равен (соединить «имя» с "Flang"))
  обеспечивает «ветка иначе 3820» («Занято именем модуля CSharp» содержит «имя») или (результат равен («имя»))
  пример «Занятое целью имя обходится суффиксом»
    дано «имя» равно "Console"
    ожидается "ConsoleFlang"
  пример «Свободное имя остаётся собой»
    дано «имя» равно "Otrezok"
    ожидается "Otrezok"
  если «Занято именем модуля CSharp» содержит «имя»
    то соединить «имя» с "Flang"
    иначе «имя»

тотальная функция «Имя класса CSharp»
  принимает «программа»: «Значение», «настройки»: «Настройки CSharp»
  возвращает строка
  обеспечивает «ветка то 3827» (не ((«настройки».«есть путь»))) или (результат равен («настройки».«путь»))
  обеспечивает «ветка иначе то 3827» ((«настройки».«есть путь»)) или ((не («Есть имя модуля CSharp» от «программа»)) или (результат равен («Обойти занятое целью CSharp» от («Безопасный идентификатор CSharp» от («Паскаль CSharp» от («Имя модуля CSharp» от «программа»))))))
  обеспечивает «ветка иначе иначе 3827» ((«настройки».«есть путь»)) или ((«Есть имя модуля CSharp» от «программа») или (результат равен ("FlangProgram")))
  если («настройки».«есть путь»)
    то «настройки».«путь»
    иначе
      если «Есть имя модуля CSharp» от «программа»
        то «Обойти занятое целью CSharp» от («Безопасный идентификатор CSharp» от («Паскаль CSharp» от («Имя модуля CSharp» от «программа»)))
        иначе "FlangProgram"

тотальная функция «Проверить имя класса CSharp»
  принимает «состояние»: «Состояние CSharp», «имя класса»: строка, «модуль»: строка
  возвращает «Состояние CSharp»
  обеспечивает «ветка то 3837» (не («Типы рантайма CSharp» содержит «имя класса»)) или (результат равен («Записать ошибку CSharp» от «состояние» и (соединить ["модуль «", «модуль», "» даёт класс «", «имя класса», "», занятый рантаймом бэкенда — переименуйте модуль"] по "")))
  обеспечивает «ветка иначе 3837» («Типы рантайма CSharp» содержит «имя класса») или (результат равен («состояние»))
  пример «класс не из рантайма состояние не меняет»
    дано «состояние» равно (запись «Состояние CSharp» с «счётчик» равным 0 и «взято» равным пустой список и «ошибка» равным "")
    дано «имя класса» равно "Prog"
    дано «модуль» равно "М"
    ожидается (запись «Состояние CSharp» с «счётчик» равным 0 и «взято» равным пустой список и «ошибка» равным "")
  если «Типы рантайма CSharp» содержит «имя класса»
    то «Записать ошибку CSharp» от «состояние» и (соединить ["модуль «", «модуль», "» даёт класс «", «имя класса», "», занятый рантаймом бэкенда — переименуйте модуль"] по "")
    иначе «состояние»

тотальная функция «Файл рантайма CSharp»
  принимает «есть модуль»: признак, «модуль»: строка, «путь»: строка, «что»: строка, «исходник»: строка
  возвращает «Файл CSharp»
  обеспечивает «поле путь 3844» (результат.«путь») равен («путь»)
  обеспечивает «поле содержимое 3844» (результат.«содержимое») равен ((соединить [(«Шапка файла CSharp» от «есть модуль» и «модуль» и «что»), "\n", «исходник»] по ""))
  запись «Файл CSharp» с «путь» равным «путь» и «содержимое» равным (соединить [(«Шапка файла CSharp» от «есть модуль» и «модуль» и «что»), "\n", «исходник»] по "")

тотальная функция «Слить файлы CSharp»
  принимает «первые»: список «Файл CSharp», «вторые»: список «Файл CSharp»
  возвращает список «Файл CSharp»
  свёртка «вторые» начиная с «первые» как «акк» и «файл» → добавить «файл» к «акк»

// Первым делом программа ПОНИЖАЕТСЯ: `функция «Имя»` становится вариантом,
// `ф от 5` — вызовом диспетчера, и дальше печать высшего порядка не видит
// вовсе. Место, где зовётся этот проход, важно: понизь программу в другом
// месте — и печать разошлась бы на первой же программе с функцией-значением.
//
// Последний шаг — снять сырые двунаправленные управляющие со всего вывода:
// литерал их уже экранировал сам, но имя модели уезжает ещё и в комментарий, а
// комментарий читают первым и проверить исполнением не могут.
функция «Печать программы CSharp»
  принимает «программа»: «Значение», «настройки»: «Настройки CSharp»
  возвращает «Итог печати CSharp»
  пусть «понижено» равно («Дефункционализировать» от «программа»)
  пусть «есть модуль» равно («Есть имя модуля CSharp» от «понижено»)
  пусть «модуль» равно («Имя модуля CSharp» от «понижено»)
  пусть «имя класса» равно («Имя класса CSharp» от «понижено» и «настройки»)
  пусть «общее» равно («Собрать общее CSharp» от «понижено» и «имя класса»)
  пусть «по классу» равно («Проверить имя класса CSharp» от «Пустое состояние CSharp» и «имя класса» и «модуль»)
  пусть «начало» равно («Проверить столкновения CSharp» от «общее» и «по классу»)
  пусть «тела» равно («Печать тел CSharp» от «общее» и «настройки» и «начало»)
  пусть «файлы рантайма» равно [
    («Файл рантайма CSharp» от «есть модуль» и «модуль» и "Value.cs" и "значение: тег, поля, равенство, печать числа" и («настройки».«рантайм значение»)),
    («Файл рантайма CSharp» от «есть модуль» и «модуль» и "Field.cs" и "поле записи или варианта" и («настройки».«рантайм поле»)),
    («Файл рантайма CSharp» от «есть модуль» и «модуль» и "FlangError.cs" и "диагностика: код и текст" и («настройки».«рантайм ошибка»)),
    («Файл рантайма CSharp» от «есть модуль» и «модуль» и "Ctx.cs" и "контекст вычисления: пределы и индексация строк" и («настройки».«рантайм контекст»)),
    («Файл рантайма CSharp» от «есть модуль» и «модуль» и "Flang.cs" и "операции языка: арифметика, встроенные формы, батут" и («настройки».«рантайм операции»))
  ]
  пусть «файл класса» равно (запись «Файл CSharp» с «путь» равным (соединить «имя класса» с ".cs") и «содержимое» равным («Исходник модуля CSharp» от «есть модуль» и «модуль» и «имя класса» и («тела».«части»)))
  пусть «с классом» равно («Слить файлы CSharp» от «файлы рантайма» и [«файл класса»])
  пусть «с прогонщиком» равно (если («настройки».«прогонщик») то («Слить файлы CSharp» от «с классом» и [(«Файл рантайма CSharp» от «есть модуль» и «модуль» и "FlangCli.cs" и "прогонщик: JSON на входе, JSON на выходе" и («настройки».«исходник прогонщика»))]) иначе «с классом»)
  пусть «с проектом» равно (добавить (запись «Файл CSharp» с «путь» равным "flang.csproj" и «содержимое» равным («Печать проекта CSharp» от «есть модуль» и «модуль» и («настройки».«прогонщик»))) к «с прогонщиком»)
  пусть «все» равно (добавить (запись «Файл CSharp» с «путь» равным "Makefile" и «содержимое» равным («Печать Makefile CSharp» от «имя класса» и («настройки».«прогонщик»))) к «с проектом»)
  запись «Итог печати CSharp» с «файлы» равным (отобразить «все» как «файл» → запись «Файл CSharp» с «путь» равным («файл».«путь») и «содержимое» равным («Снять двунаправленные CSharp» от («файл».«содержимое»))) и «ошибка» равным ((«тела».«состояние»).«ошибка»)
