    (запись «Замена» с «что» равным "\u202d" и «чем» равным "\\u202d"),
    (запись «Замена» с «что» равным "\u202e" и «чем» равным "\\u202e"),
    (запись «Замена» с «что» равным "\u2066" и «чем» равным "\\u2066"),
    (запись «Замена» с «что» равным "\u2067" и «чем» равным "\\u2067"),
    (запись «Замена» с «что» равным "\u2068" и «чем» равным "\\u2068"),
    (запись «Замена» с «что» равным "\u2069" и «чем» равным "\\u2069")
  ]

// Последний шаг печати: снять сырые двунаправленные управляющие со ВСЕГО
// вывода. Литерал их уже экранировал сам, но имя модели уезжает ещё и в
// комментарий, в `///`-документацию и в комментарий .csproj, — а комментарий
// читают первым и проверить исполнением не могут.
тотальная функция «Замены двунаправленных CSharp»
  возвращает список «Замена»
  обеспечивает «двунаправленных знаков ровно двенадцать» (длина результат) равен 12
  [
    (запись «Замена» с «что» равным "\u061c" и «чем» равным "\\u061c"),
    (запись «Замена» с «что» равным "\u200e" и «чем» равным "\\u200e"),
    (запись «Замена» с «что» равным "\u200f" и «чем» равным "\\u200f"),
    (запись «Замена» с «что» равным "\u202a" и «чем» равным "\\u202a"),
    (запись «Замена» с «что» равным "\u202b" и «чем» равным "\\u202b"),
    (запись «Замена» с «что» равным "\u202c" и «чем» равным "\\u202c"),
    (запись «Замена» с «что» равным "\u202d" и «чем» равным "\\u202d"),
    (запись «Замена» с «что» равным "\u202e" и «чем» равным "\\u202e"),
    (запись «Замена» с «что» равным "\u2066" и «чем» равным "\\u2066"),
    (запись «Замена» с «что» равным "\u2067" и «чем» равным "\\u2067"),
    (запись «Замена» с «что» равным "\u2068" и «чем» равным "\\u2068"),
    (запись «Замена» с «что» равным "\u2069" и «чем» равным "\\u2069")
  ]

тотальная функция «Снять двунаправленные CSharp»
  принимает «текст»: строка
  возвращает строка
  обеспечивает «снятие двунаправленных текст не укорачивает» (длина результат) не меньше (длина «текст»)
  «Применить замены CSharp» от «текст» и «Замены двунаправленных CSharp»

тотальная функция «Экранировать CSharp»
  принимает «текст»: строка
  возвращает строка
  обеспечивает «экранирование текст не укорачивает» (длина результат) не меньше (длина «текст»)
  пример «Кириллица не экранируется»
    дано «текст» равно "Длина"
    ожидается "Длина"
  пример «Кавычка и слеш»
    дано «текст» равно "\"\\"
    ожидается "\\\"\\\\"
  «Применить замены CSharp» от «текст» и «Замены CSharp»

тотальная функция «Строка CSharp»
  принимает «значение»: строка
  возвращает строка
  обеспечивает «литерал длиннее значения на две кавычки» (длина результат) не меньше ((длина «значение») плюс 2)
  пример «Имя функции»
    дано «значение» равно "Длина"
    ожидается "\"Длина\""
  соединить ["\"", («Экранировать CSharp» от «значение»), "\""] по ""

// Число как литерал C# (double). `к строке` даёт кратчайшую запись, читающуюся
// обратно тем же double, а суффикс `d` делает литерал заведомо вещественным:
// без него `2` было бы int, и целочисленное деление посчитало бы не то.
//
// Минус ноль отличается по напечатанному виду, а не сравнением: `к строке -0`
// это «0», и единственное другое значение с такой записью — сам ноль, поэтому
// проверка «текст равен 0, а значение не равно 0» и есть проверка на минус ноль.
тотальная функция «Конечное число CSharp»
  принимает «текст»: строка
  возвращает строка
  обеспечивает «к записи с точкой дописан суффикс d» если «текст» содержит "." то результат равен (соединить «текст» с "d") иначе да
  обеспечивает «ветка то 984» (не («текст» содержит ".")) или (результат равен (соединить «текст» с "d"))
  обеспечивает «ветка иначе то 984» («текст» содержит ".") или ((не («текст» содержит "e")) или (результат равен (соединить «текст» с "d")))
  обеспечивает «ветка иначе иначе 984» («текст» содержит ".") или ((«текст» содержит "e") или (результат равен (соединить «текст» с ".0d")))
  пример «Целой записи дописывается дробная часть»
    дано «текст» равно "1"
    ожидается "1.0d"
  пример «К записи с точкой дописан один суффикс d»
    дано «текст» равно "0.5"
    ожидается "0.5d"
  пример «Показательной записи дробная часть не нужна»
    дано «текст» равно "1e+21"
    ожидается "1e+21d"
  если «текст» содержит "."
    то соединить «текст» с "d"
    иначе
      если «текст» содержит "e"
        то соединить «текст» с "d"
        иначе соединить «текст» с ".0d"

тотальная функция «Число CSharp»
  принимает «значение»: число
  возвращает строка
  обеспечивает «не-число печатается как double.NaN» если (к строке «значение») равен "NaN" то результат равен "double.NaN" иначе да
  пример «Целое получает дробную часть»
    дано «значение» равно 1
    ожидается "1.0d"
  пример «Дробь печатается как есть»
    дано «значение» равно 0.5
    ожидается "0.5d"
  обеспечивает «ветка то 1057» (не (((к строке «значение»)) равен "NaN")) или (результат равен ("double.NaN"))
  обеспечивает «ветка иначе то 1057» (((к строке «значение»)) равен "NaN") или ((не (((к строке «значение»)) равен "Infinity")) или (результат равен ("double.PositiveInfinity")))
  обеспечивает «ветка иначе иначе то 1057» (((к строке «значение»)) равен "NaN") или ((((к строке «значение»)) равен "Infinity") или ((не (((к строке «значение»)) равен "-Infinity")) или (результат равен ("double.NegativeInfinity"))))
  обеспечивает «ветка иначе иначе иначе то 1057» (((к строке «значение»)) равен "NaN") или ((((к строке «значение»)) равен "Infinity") или ((((к строке «значение»)) равен "-Infinity") или ((не (((к строке «значение»)) равен "0")) или (результат равен ((если «значение» равен 0 то "0.0d" иначе "-0.0d"))))))
  обеспечивает «ветка иначе иначе иначе иначе 1057» (((к строке «значение»)) равен "NaN") или ((((к строке «значение»)) равен "Infinity") или ((((к строке «значение»)) равен "-Infinity") или ((((к строке «значение»)) равен "0") или (результат равен («Конечное число CSharp» от ((к строке «значение»)))))))
  пусть «текст» равно (к строке «значение»)
  если «текст» равен "NaN"
    то "double.NaN"
    иначе
      если «текст» равен "Infinity"
        то "double.PositiveInfinity"
        иначе
          если «текст» равен "-Infinity"
            то "double.NegativeInfinity"
            иначе
              если «текст» равен "0"
                то (если «значение» равен 0 то "0.0d" иначе "-0.0d")
                иначе «Конечное число CSharp» от «текст»

// Имя модели внутри XML-комментария не имеет права его сломать.
тотальная функция «Замены XML CSharp»
  возвращает список «Замена»
  обеспечивает «замен XML ровно три» (длина результат) равен 3
  [
    (запись «Замена» с «что» равным "&" и «чем» равным "&amp;"),
    (запись «Замена» с «что» равным "<" и «чем» равным "&lt;"),
    (запись «Замена» с «что» равным ">" и «чем» равным "&gt;")
  ]

тотальная функция «Экранировать XML CSharp»
  принимает «текст»: строка
  возвращает строка
  обеспечивает «экранирование XML текст не укорачивает» (длина результат) не меньше (длина «текст»)
  «Применить замены CSharp» от «текст» и «Замены XML CSharp»

