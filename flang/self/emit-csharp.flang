    (запись «Метка шарп» с «ключ» равным "подстрока" и «значение» равным 3),
    (запись «Метка шарп» с «ключ» равным "соединить" и «значение» равным 2),
    (запись «Метка шарп» с «ключ» равным "разделить" и «значение» равным 2),
    (запись «Метка шарп» с «ключ» равным "символы" и «значение» равным 1),
    (запись «Метка шарп» с «ключ» равным "код символа" и «значение» равным 1),
    (запись «Метка шарп» с «ключ» равным "содержит" и «значение» равным 2),
    (запись «Метка шарп» с «ключ» равным "начинается с" и «значение» равным 2),
    (запись «Метка шарп» с «ключ» равным "к числу" и «значение» равным 1),
    (запись «Метка шарп» с «ключ» равным "к числу или беда" и «значение» равным 1),
    (запись «Метка шарп» с «ключ» равным "к строке" и «значение» равным 1),
    (запись «Метка шарп» с «ключ» равным "пусто" и «значение» равным 1),
    (запись «Метка шарп» с «ключ» равным "голова" и «значение» равным 1),
    (запись «Метка шарп» с «ключ» равным "хвост" и «значение» равным 1),
    (запись «Метка шарп» с «ключ» равным "элемент" и «значение» равным 2),
    (запись «Метка шарп» с «ключ» равным "добавить" и «значение» равным 2),
    (запись «Метка шарп» с «ключ» равным "приписать" и «значение» равным 2),
    (запись «Метка шарп» с «ключ» равным "остаток от" и «значение» равным 2),
    (запись «Метка шарп» с «ключ» равным "процентов от" и «значение» равным 2)
  ]

тотальная функция «Помощники операций шарп»
  возвращает список «Пара имён шарп»
  [
    (запись «Пара имён шарп» с «ключ» равным "add" и «значение» равным "Add"),
    (запись «Пара имён шарп» с «ключ» равным "sub" и «значение» равным "Sub"),
    (запись «Пара имён шарп» с «ключ» равным "mul" и «значение» равным "Mul"),
    (запись «Пара имён шарп» с «ключ» равным "div" и «значение» равным "Div"),
    (запись «Пара имён шарп» с «ключ» равным "mod" и «значение» равным "Mod"),
    (запись «Пара имён шарп» с «ключ» равным "percent" и «значение» равным "Percent"),
    (запись «Пара имён шарп» с «ключ» равным "gt" и «значение» равным "Gt"),
    (запись «Пара имён шарп» с «ключ» равным "lt" и «значение» равным "Lt"),
