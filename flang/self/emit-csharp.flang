тотальная функция «Синонимы форм CSharp»
  возвращает список «Пара имён CSharp»
  [
    (запись «Пара имён CSharp» с «ключ» равным "символ в" и «значение» равным "символ"),
    (запись «Пара имён CSharp» с «ключ» равным "элемент в" и «значение» равным "элемент"),
    (запись «Пара имён CSharp» с «ключ» равным "начинается" и «значение» равным "начинается с"),
    (запись «Пара имён CSharp» с «ключ» равным "остаток" и «значение» равным "остаток от"),
    (запись «Пара имён CSharp» с «ключ» равным "процентов" и «значение» равным "процентов от"),
    (запись «Пара имён CSharp» с «ключ» равным "к_числу" и «значение» равным "к числу"),
    (запись «Пара имён CSharp» с «ключ» равным "к_строке" и «значение» равным "к строке")
  ]

