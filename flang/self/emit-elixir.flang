    дано «значение» равно "Длина"
    ожидается "\"Длина\""
  соединить ["\"", («Экранировать Elixir» от «значение»), "\""] по ""

// Последний шаг печати: сырые двунаправленные управляющие снимаются со ВСЕГО
// вывода, а не только с литералов. Имя модели уезжает ещё и в комментарии, и в
// @moduledoc/@doc, и для elixirc это отказ разбора и там, и там.
тотальная функция «Замены двунаправленных Elixir»
  возвращает список «Замена»
  [
    (запись «Замена» с «что» равным "\u061c" и «чем» равным "\\u{61c}"),
    (запись «Замена» с «что» равным "\u200e" и «чем» равным "\\u{200e}"),
    (запись «Замена» с «что» равным "\u200f" и «чем» равным "\\u{200f}"),
    (запись «Замена» с «что» равным "\u202a" и «чем» равным "\\u{202a}"),
    (запись «Замена» с «что» равным "\u202b" и «чем» равным "\\u{202b}"),
    (запись «Замена» с «что» равным "\u202c" и «чем» равным "\\u{202c}"),
    (запись «Замена» с «что» равным "\u202d" и «чем» равным "\\u{202d}"),
    (запись «Замена» с «что» равным "\u202e" и «чем» равным "\\u{202e}"),
    (запись «Замена» с «что» равным "\u2066" и «чем» равным "\\u{2066}"),
    (запись «Замена» с «что» равным "\u2067" и «чем» равным "\\u{2067}"),
    (запись «Замена» с «что» равным "\u2068" и «чем» равным "\\u{2068}"),
    (запись «Замена» с «что» равным "\u2069" и «чем» равным "\\u{2069}")
  ]

тотальная функция «Снять двунаправленные Elixir»
  принимает «текст»: строка
  возвращает строка
  «Применить замены Elixir» от «текст» и «Замены двунаправленных Elixir»

// Число как значение flang.
//
// NaN и бесконечности здесь не литералы вовсе, а атомы: на BEAM значения с
// плавающей точкой, равного NaN или бесконечности, не существует — машина
// возбуждает ArithmeticError вместо того, чтобы его вернуть.
//
// Минус ноль печатается ВЫЗОВОМ `Flang.Rt.neg_zero()`, а не литералом `-0.0`: до
// OTP 27 `-0.0 =:= 0.0` истинно, и компилятор BEAM вправе считать `{:num, 0.0}` и
// `{:num, -0.0}` одним термом. Отличается он по напечатанному виду, а не
// сравнением: `к строке (-0)` это «0», и единственное значение с такой записью —
// сам ноль, поэтому «текст равен 0, а значение не равно 0» и есть Object.is(-0).
тотальная функция «Экспонента Elixir»
  принимает «текст»: строка
  возвращает строка
  обеспечивает «в экспоненциальной записи остаётся буква e» результат содержит "e"
  пусть «части» равно (разделить «текст» по "e")
  пусть «мантисса» равно («Элемент по индексу Elixir» от «части» и 0)
  пусть «порядок» равно («Заменить всё» от («Элемент по индексу Elixir» от «части» и 1) и "+" и "")
  пусть «тело» равно (если «мантисса» содержит "." то «мантисса» иначе (соединить «мантисса» с ".0"))
  соединить [«тело», "e", «порядок»] по ""

тотальная функция «Конечное число Elixir»
  принимает «текст»: строка
  возвращает строка
  обеспечивает «запись с порядком печатается экспонентой» если «текст» содержит "e" то результат равен («Экспонента Elixir» от «текст») иначе да
  пример «Целому дописывается дробная часть»
    дано «текст» равно "1"
    ожидается "1.0"
  пример «Запись с точкой не меняется»
    дано «текст» равно "1.5"
    ожидается "1.5"
  пример «Запись с порядком печатается экспонентой»
    дано «текст» равно "1e21"
    ожидается "1.0e21"
  если «текст» содержит "e"
    то «Экспонента Elixir» от «текст»
    иначе
      если «текст» содержит "."
        то «текст»
        иначе соединить «текст» с ".0"

тотальная функция «Число без особых Elixir»
  принимает «значение»: число, «текст»: строка
  возвращает строка
  обеспечивает «минус ноль печатается вызовом рантайма» если «текст» равен "0" то (если «значение» равен 0 то результат равен "0.0" иначе результат равен "Flang.Rt.neg_zero()") иначе да
  пример «Ноль печатается нулём»
    дано «значение» равно 0
    дано «текст» равно "0"
    ожидается "0.0"
  пример «Минус ноль печатается вызовом рантайма»
    дано «значение» равно -0
    дано «текст» равно "0"
    ожидается "Flang.Rt.neg_zero()"
  если «текст» равен "0"
    то (если «значение» равен 0 то "0.0" иначе "Flang.Rt.neg_zero()")
    иначе «Конечное число Elixir» от «текст»

тотальная функция «Число Elixir»
  принимает «значение»: число
  возвращает строка
  обеспечивает «нечисло печатается атомом nan» если (к строке «значение») равен "NaN" то результат равен ":nan" иначе да
  пример «Целое получает дробную часть»
    дано «значение» равно 1
    ожидается "1.0"
  пример «Дробь печатается как есть»
    дано «значение» равно 0.5
    ожидается "0.5"
  пусть «текст» равно (к строке «значение»)
  если «текст» равен "NaN"
    то ":nan"
    иначе
      если «текст» равен "Infinity"
        то ":inf"
        иначе
          если «текст» равен "-Infinity"
            то ":ninf"
            иначе «Число без особых Elixir» от «значение» и «текст»

// ═══════════════════════════ идентификаторы Elixir ═══════════════════════════

тотальная функция «Строчные буквы Elixir»
  возвращает строка
  обеспечивает «строчных букв с подчёркиванием двадцать семь» (длина результат) равен 27
  пример «Латиница и подчёркивание последним»
    ожидается "abcdefghijklmnopqrstuvwxyz_"
  "abcdefghijklmnopqrstuvwxyz_"

тотальная функция «Заглавные буквы Elixir»
  возвращает строка
  обеспечивает «заглавных на одну меньше, чем строчных с подчёркиванием» (длина результат) равен ((длина «Строчные буквы Elixir») минус 1)
  пример «Латиница без подчёркивания»
    ожидается "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

// Идентификатор Elixir начинается со строчной буквы или подчёркивания.
тотальная функция «Безопасный идентификатор Elixir»
  принимает «идентификатор»: строка
  возвращает строка
  обеспечивает «пустой идентификатор становится value» если (длина «идентификатор») равен 0 то результат равен "value" иначе да
  пример «Пустой идентификатор становится value»
    дано «идентификатор» равно ""
    ожидается "value"
  пример «Заглавная получает приставку»
    дано «идентификатор» равно "Abc"
    ожидается "v_Abc"
  пример «Строчная остаётся собой»
    дано «идентификатор» равно "abc"
    ожидается "abc"
  если (длина «идентификатор») равен 0
    то "value"
    иначе
      если «Строчные буквы Elixir» содержит («Первый символ Elixir» от «идентификатор»)
        то «идентификатор»
        иначе соединить "v_" с «идентификатор»

тотальная функция «Заглавная первая Elixir»
  принимает «слово»: строка
  возвращает строка
  обеспечивает «длина слова от заглавной буквы не меняется» если (длина «слово») равен 0 то результат равен "" иначе (длина результат) равен (длина «слово»)
  если (длина «слово») равен 0
    то ""
    иначе соединить («В верхний регистр Elixir» от («Первый символ Elixir» от «слово»)) с (подстрока «слово» с 2 по (длина «слово»))

тотальная функция «Паскаль Elixir»
  принимает «значение»: строка
  возвращает строка
  обеспечивает «паскаль никогда не пуст» (длина результат) больше 0
  пример «Слова слипаются с заглавных»
    дано «значение» равно "Пара чисел"
    ожидается "ParaChisel"
  пусть «слова» равно («Слова Elixir» от («Транслитерировать Elixir» от «значение»))
  если пусто «слова»
    то "Value"
    иначе соединить (отобразить «слова» как «слово» → «Заглавная первая Elixir» от «слово») по ""

тотальная функция «Сегмент модуля Elixir»
  принимает «часть»: строка
  возвращает строка
  обеспечивает «сегмент модуля начинается с заглавной» («Заглавные буквы Elixir» содержит («Первый символ Elixir» от результат)) равен да
  пусть «имя» равно («Паскаль Elixir» от «часть»)
  если «Заглавные буквы Elixir» содержит («Первый символ Elixir» от «имя»)
    то «имя»
    иначе соединить "M" с «имя»

// Имя модуля Elixir из имени модели: PascalCase, но с точкой там, где в имени
// стоит точка (иначе «Учёт.Склад» дал бы один сегмент вместо двух).
тотальная функция «Модуль Elixir»
  принимает «имя»: строка
  возвращает строка
  обеспечивает «сегментов в модуле столько же, сколько частей имени» (длина (разделить результат по ".")) равен (длина (разделить «имя» по "."))
  соединить (отобразить (разделить «имя» по ".") как «часть» → «Сегмент модуля Elixir» от «часть») по "."

// Ключевые слова и особые формы Elixir, а также имена, которые напечатанный код
// видит из Kernel без квалификации. Имя из модели, попавшее сюда после
// транслитерации, обязано считаться коллизией, а не молча получить суффикс.
