    (запись «Метка» с «ключ» равным "голова" и «значение» равным 1),
    (запись «Метка» с «ключ» равным "хвост" и «значение» равным 1),
    (запись «Метка» с «ключ» равным "элемент" и «значение» равным 2),
    (запись «Метка» с «ключ» равным "добавить" и «значение» равным 2),
    (запись «Метка» с «ключ» равным "приписать" и «значение» равным 2),
    (запись «Метка» с «ключ» равным "остаток от" и «значение» равным 2),
    (запись «Метка» с «ключ» равным "процентов от" и «значение» равным 2)
  ]

тотальная функция «Помощники операций»
  возвращает список «Пара имён»
  [
    (запись «Пара имён» с «ключ» равным "add" и «значение» равным "add"),
    (запись «Пара имён» с «ключ» равным "sub" и «значение» равным "sub"),
    (запись «Пара имён» с «ключ» равным "mul" и «значение» равным "mul"),
    (запись «Пара имён» с «ключ» равным "div" и «значение» равным "divide"),
    (запись «Пара имён» с «ключ» равным "mod" и «значение» равным "mod"),
    (запись «Пара имён» с «ключ» равным "percent" и «значение» равным "percent"),
    (запись «Пара имён» с «ключ» равным "gt" и «значение» равным "gt"),
    (запись «Пара имён» с «ключ» равным "lt" и «значение» равным "lt"),
    (запись «Пара имён» с «ключ» равным "gte" и «значение» равным "gte"),
    (запись «Пара имён» с «ключ» равным "lte" и «значение» равным "lte"),
    (запись «Пара имён» с «ключ» равным "concat" и «значение» равным "concat")
  ]

тотальная функция «Между»
  принимает «значение»: число, «от»: число, «до»: число
  возвращает признак
  если «значение» меньше «от»
    то нет
    иначе
      если «значение» больше «до»
        то нет
        иначе да

тотальная функция «Слово аргументов»
  принимает «количество»: число
  возвращает строка
  пусть «сто» равно («количество» остаток от 100)
  пусть «десять» равно («сто» остаток от 10)
  если «Между» от «сто» и 11 и 14
    то "аргументов"
    иначе
      если «десять» равен 1
        то "аргумент"
        иначе
          если «Между» от «десять» и 2 и 4
            то "аргумента"
            иначе "аргументов"

// ═══════════════════════════ именователь верхнего уровня ═══════════════════════════

// Роль плюс транслитерация имени модели. Роль входит в идентификатор всегда,
// поэтому столкнуться могут только два имени одной роли («Сумма» и «сумма» дают
// один fn_summa), и это ошибка печати, а не молчаливое переименование:
// сгенерированный код читают рядом с моделью, и два разных имени модели обязаны
// остаться различимыми.

объект «Занятое имя»
  «идентификатор»: строка
  «роль»: строка
  «имя»: строка

тип «Может быть занятое»
  вариант «Есть занятое» содержит «занятое»: «Занятое имя»
  вариант «Нет занятого»

объект «Именование»
  «занятые»: список «Занятое имя»
  «пары»: список «Пара имён»
  «ошибка»: строка

тотальная функция «Первое из занятых»
  принимает «занятые»: список «Занятое имя»
  возвращает «Может быть занятое»
  разбор «занятые»
    случай пусто
      то вариант «Нет занятого»
    случай голова и хвост
      то вариант «Есть занятое» с «занятое» равным «голова»

тотальная функция «Найти занятое»
  принимает «занятые»: список «Занятое имя», «идентификатор»: строка
  возвращает «Может быть занятое»
  «Первое из занятых» от (отфильтровать «занятые» где «занятое» → («занятое».«идентификатор») равен «идентификатор»)

тотальная функция «Есть занятое имя»
  принимает «занятые»: список «Занятое имя», «идентификатор»: строка
  возвращает признак
  разбор («Найти занятое» от «занятые» и «идентификатор»)
    случай вариант «Есть занятое» с «занятое» как «найденное»
      то да
    случай «Нет занятого»
      то нет

тотальная функция «Обновить занятое»
  принимает «занятое»: «Занятое имя», «идентификатор»: строка, «роль»: строка, «имя»: строка
  возвращает «Занятое имя»
  если («занятое».«идентификатор») равен «идентификатор»
    то запись «Занятое имя» с «идентификатор» равным «идентификатор» и «роль» равным «роль» и «имя» равным «имя»
    иначе «занятое»

тотальная функция «Положить занятое»
  принимает «занятые»: список «Занятое имя», «идентификатор»: строка, «роль»: строка, «имя»: строка
  возвращает список «Занятое имя»
  если «Есть занятое имя» от «занятые» и «идентификатор»
    то отобразить «занятые» как «занятое» → «Обновить занятое» от «занятое» и «идентификатор» и «роль» и «имя»
    иначе добавить (запись «Занятое имя» с «идентификатор» равным «идентификатор» и «роль» равным «роль» и «имя» равным «имя») к «занятые»

тотальная функция «Владелец имени»
  принимает «занятое»: «Занятое имя»
  возвращает строка
  если (длина («занятое».«роль»)) равен 0
    то соединить "зарезервировано в Elixir: " с («занятое».«имя»)
    иначе соединить [(«Название роли» от («занятое».«роль»)), " «", («занятое».«имя»), "»"] по ""

тотальная функция «Текст столкновения»
  принимает «роль»: строка, «имя»: строка, «идентификатор»: строка, «былое»: «Занятое имя»
  возвращает строка
  соединить ["имя ", («Название роли» от «роль»), " «", «имя», "» даёт идентификатор «", «идентификатор», "», уже занятый (", («Владелец имени» от «былое»), ") — переименуйте одно из имён в модели"] по ""

тотальная функция «Это столкновение»
  принимает «былое»: «Занятое имя», «роль»: строка, «имя»: строка
  возвращает признак
  если («былое».«роль») равен «роль»
    то (если («былое».«имя») равен «имя» то нет иначе да)
    иначе да

тотальная функция «Ошибка занятия»
  принимает «прежняя»: строка, «роль»: строка, «имя»: строка, «идентификатор»: строка, «былое»: «Занятое имя»
  возвращает строка
  если «Это столкновение» от «былое» и «роль» и «имя»
    то (если (длина «прежняя») больше 0 то «прежняя» иначе («Текст столкновения» от «роль» и «имя» и «идентификатор» и «былое»))
    иначе «прежняя»

тотальная функция «Ошибка после занятия»
  принимает «прежняя»: строка, «роль»: строка, «имя»: строка, «идентификатор»: строка, «прежнее»: «Может быть занятое»
  возвращает строка
  разбор «прежнее»
    случай вариант «Есть занятое» с «занятое» как «былое»
      то «Ошибка занятия» от «прежняя» и «роль» и «имя» и «идентификатор» и «былое»
    случай «Нет занятого»
      то «прежняя»

тотальная функция «Занять роль»
  принимает «именование»: «Именование», «роль»: строка, «имя»: строка
  возвращает «Именование»
  пусть «идентификатор» равно («Безопасный идентификатор» от (соединить («Приставка роли» от «роль») с («Змейка» от «имя»)))
  пусть «прежнее» равно («Найти занятое» от («именование».«занятые») и «идентификатор»)
  пусть «ошибка» равно («Ошибка после занятия» от («именование».«ошибка») и «роль» и «имя» и «идентификатор» и «прежнее»)
  пусть «занятые» равно («Положить занятое» от («именование».«занятые») и «идентификатор» и «роль» и «имя»)
  пусть «пары» равно (добавить (запись «Пара имён» с «ключ» равным «имя» и «значение» равным «идентификатор») к («именование».«пары»))
  запись «Именование» с «занятые» равным «занятые» и «пары» равным «пары» и «ошибка» равным «ошибка»

тотальная функция «Занять роли»
  принимает «именование»: «Именование», «роль»: строка, «имена»: список строки
  возвращает «Именование»
  пусть «чистое» равно (запись «Именование» с «занятые» равным («именование».«занятые») и «пары» равным пустой список и «ошибка» равным («именование».«ошибка»))
  свёртка «имена» начиная с «чистое» как «акк» и «имя» → «Занять роль» от «акк» и «роль» и «имя»

тотальная функция «Начать именование»
  возвращает «Именование»
  пусть «слова» равно («Слить списки строк» от «Зарезервировано в Elixir» и «Объявлено бэкендом»)
  пусть «занятые» равно (отобразить «слова» как «слово» → запись «Занятое имя» с «идентификатор» равным «слово» и «роль» равным "" и «имя» равным «слово»)
  запись «Именование» с «занятые» равным «занятые» и «пары» равным пустой список и «ошибка» равным ""

тотальная функция «Все занятые идентификаторы»
  принимает «занятые»: список «Занятое имя»
  возвращает список строки
  отобразить «занятые» как «занятое» → «занятое».«идентификатор»

// ═══════════════════════════ уникальные имена в теле ═══════════════════════════

тотальная функция «Только цифры»
  принимает «текст»: строка
  возвращает признак
  свёртка (разложить «текст» на символы) начиная с да как «акк» и «знак»
    если «акк»
      то «Цифры» содержит «знак»
      иначе нет

// `/^t[0-9]+$/` эталона: имя, похожее на временное, занятым считается всегда —
// иначе `t2` из модели столкнулся бы с `t2`, выданным счётчиком.
тотальная функция «Похоже на временное»
  принимает «имя»: строка
  возвращает признак
  если («Первый символ» от «имя») равен "t"
    то (если (длина «имя») больше 1 то («Только цифры» от (подстрока «имя» с 2 по (длина «имя»))) иначе нет)
    иначе нет

тотальная функция «Имя занято»
  принимает «взято»: список строки, «кандидат»: строка
  возвращает признак
  если «взято» содержит «кандидат»
    то да
    иначе «Похоже на временное» от «кандидат»

функция «Свободное имя»
  принимает «желаемое»: строка, «взято»: список строки, «суффикс»: число
  возвращает строка
  пусть «кандидат» равно (если «суффикс» равен 1 то «желаемое» иначе (соединить «желаемое» с (к строке «суффикс»)))
  если «Имя занято» от «взято» и «кандидат»
    то «Свободное имя» от «желаемое» и «взято» и («суффикс» плюс 1)
    иначе «кандидат»

объект «Набор имён»
  «взято»: список строки
  «имена»: список строки

функция «Шаг уникальных»
  принимает «акк»: «Набор имён», «имя»: строка
  возвращает «Набор имён»
  пусть «выбор» равно («Свободное имя» от («Безопасный идентификатор» от («Змейка» от «имя»)) и («акк».«взято») и 1)
  запись «Набор имён» с «взято» равным (добавить «выбор» к («акк».«взято»)) и «имена» равным (добавить «выбор» к («акк».«имена»))

// `uniqueIdents` эталона: транслитерация плюс развод столкновений.
функция «Уникальные имена»
  принимает «имена»: список строки, «глобальные»: список строки
  возвращает список строки
  пусть «начало» равно (запись «Набор имён» с «взято» равным «глобальные» и «имена» равным пустой список)
  пусть «итог» равно (свёртка «имена» начиная с «начало» как «акк» и «имя» → «Шаг уникальных» от «акк» и «имя»)
  «итог».«имена»

// ═══════════════════════════ состояние печати ═══════════════════════════

// Всё, что в эталоне лежит в замыкании: счётчик временных имён, занятые
// идентификаторы тела и первая ошибка печати. Едет через каждую функцию печати
// и возвращается изменённым.
объект «Состояние»
  «счётчик»: число
  «взято»: список строки
  «ошибка»: строка

объект «Свежее»
  «состояние»: «Состояние»
  «имя»: строка

тотальная функция «Пустое состояние»
  возвращает «Состояние»
  запись «Состояние» с «счётчик» равным 0 и «взято» равным пустой список и «ошибка» равным ""

тотальная функция «Заменить счётчик»
  принимает «состояние»: «Состояние», «счётчик»: число
  возвращает «Состояние»
  запись «Состояние» с «счётчик» равным «счётчик» и «взято» равным («состояние».«взято») и «ошибка» равным («состояние».«ошибка»)

тотальная функция «Заменить взятое»
  принимает «состояние»: «Состояние», «взято»: список строки
  возвращает «Состояние»
  запись «Состояние» с «счётчик» равным («состояние».«счётчик») и «взято» равным «взято» и «ошибка» равным («состояние».«ошибка»)

// Первая ошибка побеждает: дальше печать продолжается, но её результат уже
// никого не интересует — наружу поедет диагностика.
тотальная функция «Записать ошибку»
  принимает «состояние»: «Состояние», «текст»: строка
  возвращает «Состояние»
  если (длина («состояние».«ошибка»)) больше 0
    то «состояние»
    иначе запись «Состояние» с «счётчик» равным («состояние».«счётчик») и «взято» равным («состояние».«взято») и «ошибка» равным «текст»

тотальная функция «Временное»
  принимает «состояние»: «Состояние»
  возвращает «Свежее»
  пусть «номер» равно ((«состояние».«счётчик») плюс 1)
  запись «Свежее» с «состояние» равным («Заменить счётчик» от «состояние» и «номер») и «имя» равным (соединить "t" с (к строке «номер»))

функция «Свежее имя»
  принимает «состояние»: «Состояние», «имя»: строка
  возвращает «Свежее»
  пусть «кандидат» равно («Свободное имя» от («Безопасный идентификатор» от («Змейка» от «имя»)) и («состояние».«взято») и 1)
  пусть «дальше» равно («Заменить взятое» от «состояние» и (добавить «кандидат» к («состояние».«взято»)))
  запись «Свежее» с «состояние» равным «дальше» и «имя» равным «кандидат»

// ═══════════════════════════ общее знание о программе ═══════════════════════════

объект «Именованные идентификаторы»
  «имя»: строка
  «идентификаторы»: список строки

объект «Общее»
  «псевдоним»: строка
  «функции»: список «Функция»
  «записи»: список «Запись типа»
  «варианты»: список «Вариант типа»
  «суммы»: список «Сумма типов»
  «ид функций»: список «Пара имён»
  «ид фабрик»: список «Пара имён»
  «ид вариантов»: список «Пара имён»
  «ид шагов»: список «Пара имён»
  «ид параметров»: список «Именованные идентификаторы»
  «глобальные»: список строки
  «хвостовые»: список «Рёбра»
  «циклические»: список «Рёбра»
  «рекурсивные»: список строки
  «ошибка»: строка

тотальная функция «Имя модуля»
  принимает «программа»: «Значение»
  возвращает строка
  «Строка поля» от «программа» и "module"

тотальная функция «Есть имя модуля»
  принимает «программа»: «Значение»
  возвращает признак
  (длина («Имя модуля» от «программа»)) больше 0

функция «Идентификаторы параметров»
  принимает «функция»: «Функция», «глобальные»: список строки
  возвращает «Именованные идентификаторы»
  пусть «имена» равно (отобразить («функция».«параметры») как «п» → «п».«имя»)
  запись «Именованные идентификаторы» с «имя» равным («функция».«имя») и «идентификаторы» равным («Уникальные имена» от «имена» и «глобальные»)

тотальная функция «Идентификаторы для»
  принимает «таблица»: список «Именованные идентификаторы», «имя»: строка
  возвращает список строки
  свёртка (отфильтровать «таблица» где «строка» → («строка».«имя») равен «имя») начиная с пустой список как «акк» и «строка»
    «строка».«идентификаторы»

функция «Хвостовые рёбра»
  принимает «функции»: список «Функция»
  возвращает список «Рёбра»
  отобразить «функции» как «функция» → запись «Рёбра» с «имя» равным («функция».«имя») и «цели» равным («Хвостовые вызовы» от «функция»)

функция «Рёбра вызовов»
  принимает «функции»: список «Функция»
  возвращает список «Рёбра»
  отобразить «функции» как «функция» → запись «Рёбра» с «имя» равным («функция».«имя») и «цели» равным («Все вызовы» от «функция»)

тотальная функция «Члены компоненты»
  принимает «компонента»: «Компонента»
  возвращает список «Рёбра»
  отобразить («компонента».«имена») как «имя» → запись «Рёбра» с «имя» равным «имя» и «цели» равным («компонента».«имена»)

тотальная функция «Слить рёбра»
  принимает «акк»: список «Рёбра», «добавка»: список «Рёбра»
  возвращает список «Рёбра»
  свёртка «добавка» начиная с «акк» как «внутри» и «ребро» → добавить «ребро» к «внутри»

// Компонента из двух и более функций — взаимная хвостовая рекурсия; одиночка
// хвостовой рекурсией является, только если зовёт себя сама.
тотальная функция «Циклические функции»
  принимает «компоненты»: список «Компонента»
  возвращает список «Рёбра»
  пусть «крупные» равно (отфильтровать «компоненты» где «компонента» → (длина («компонента».«имена»)) больше 1)
  свёртка «крупные» начиная с пустой список как «акк» и «компонента» → «Слить рёбра» от «акк» и («Члены компоненты» от «компонента»)

тотальная функция «Рекурсивная одиночка»
  принимает «компонента»: «Компонента», «рёбра»: список «Рёбра»
  возвращает список строки
  пусть «имя» равно («Последняя строка» от («компонента».«имена»))
  если («Цели» от «рёбра» и «имя») содержит «имя»
    то [«имя»]
    иначе пустой список

тотальная функция «Шаг рекурсивных»
  принимает «акк»: список строки, «компонента»: «Компонента», «рёбра»: список «Рёбра»
  возвращает список строки
  если (длина («компонента».«имена»)) больше 1
    то «Слить списки строк» от «акк» и («компонента».«имена»)
    иначе «Слить списки строк» от «акк» и («Рекурсивная одиночка» от «компонента» и «рёбра»)

// Кто способен к рекурсии и потому обязан считать глубину.
тотальная функция «Рекурсивные функции»
  принимает «компоненты»: список «Компонента», «рёбра»: список «Рёбра»
  возвращает список строки
  свёртка «компоненты» начиная с пустой список как «акк» и «компонента» → «Шаг рекурсивных» от «акк» и «компонента» и «рёбра»

тотальная функция «Имена рёбер»
  принимает «рёбра»: список «Рёбра»
  возвращает список строки
  отобразить «рёбра» как «ребро» → «ребро».«имя»

тотальная функция «Самовызов в хвосте»
  принимает «функция»: «Функция», «хвостовые»: список «Рёбра»
  возвращает признак
  («Цели» от «хвостовые» и («функция».«имя»)) содержит («функция».«имя»)

тотальная функция «Есть члены»
  принимает «функция»: «Функция», «циклические»: список «Рёбра»
  возвращает признак
  («Имена рёбер» от «циклические») содержит («функция».«имя»)

// Тело отдельной функцией нужно там, где есть хвостовая рекурсия: только так
// она переживёт `try/after` публичной функции и останется хвостовой.
тотальная функция «Нужен шаг»
  принимает «функция»: «Функция», «хвостовые»: список «Рёбра», «циклические»: список «Рёбра»
  возвращает признак
  если «Самовызов в хвосте» от «функция» и «хвостовые»
    то (если (длина («функция».«постусловия»)) больше 0 то нет иначе да)
    иначе
      если «Есть члены» от «функция» и «циклические»
        то (если (длина («функция».«постусловия»)) больше 0 то нет иначе да)
        иначе нет

тотальная функция «Имена для шагов»
  принимает «функции»: список «Функция», «хвостовые»: список «Рёбра», «циклические»: список «Рёбра»
  возвращает список строки
  пусть «нужные» равно (отфильтровать «функции» где «функция» → «Нужен шаг» от «функция» и «хвостовые» и «циклические»)
  отобразить «нужные» как «функция» → «функция».«имя»

функция «Собрать общее»
  принимает «программа»: «Значение», «псевдоним»: строка, «ошибка»: строка
  возвращает «Общее»
  пусть «функции» равно («Собрать функции» от «программа»)
  пусть «записи» равно («Собрать записи» от «программа»)
  пусть «суммы» равно («Собрать суммы» от «программа»)
  пусть «варианты» равно («Собрать варианты» от «суммы»)
  пусть «имена» равно («Имена функций» от «функции»)
  пусть «хвостовые» равно («Хвостовые рёбра» от «функции»)
  пусть «вызовы» равно («Рёбра вызовов» от «функции»)
  пусть «циклические» равно («Циклические функции» от («Компоненты связности» от «имена» и «хвостовые»))
  пусть «рекурсивные» равно («Рекурсивные функции» от («Компоненты связности» от «имена» и «вызовы») и «вызовы»)
  пусть «после фабрик» равно («Занять роли» от «Начать именование» и "record" и («Имена записей» от «записи»))
  пусть «после вариантов» равно («Занять роли» от «после фабрик» и "variant" и («Имена вариантов» от «варианты»))
  пусть «после функций» равно («Занять роли» от «после вариантов» и "function" и «имена»)
  пусть «после шагов» равно («Занять роли» от «после функций» и "step" и («Имена для шагов» от «функции» и «хвостовые» и «циклические»))
  пусть «глобальные» равно («Все занятые идентификаторы» от («после шагов».«занятые»))
  пусть «ид параметров» равно (отобразить «функции» как «функция» → «Идентификаторы параметров» от «функция» и «глобальные»)
  пусть «итоговая ошибка» равно (если (длина «ошибка») больше 0 то «ошибка» иначе («после шагов».«ошибка»))
  запись «Общее» с «псевдоним» равным «псевдоним» и «функции» равным «функции» и «записи» равным «записи» и «варианты» равным «варианты» и «суммы» равным «суммы» и «ид функций» равным («после функций».«пары») и «ид фабрик» равным («после фабрик».«пары») и «ид вариантов» равным («после вариантов».«пары») и «ид шагов» равным («после шагов».«пары») и «ид параметров» равным «ид параметров» и «глобальные» равным «глобальные» и «хвостовые» равным «хвостовые» и «циклические» равным «циклические» и «рекурсивные» равным «рекурсивные» и «ошибка» равным «итоговая ошибка»

тотальная функция «Есть шаг»
  принимает «общее»: «Общее», «имя»: строка
  возвращает признак
  «Есть в таблице» от («общее».«ид шагов») и «имя»

тотальная функция «Шаг функции»
  принимает «общее»: «Общее», «имя»: строка
  возвращает строка
  «Значение по ключу» от («общее».«ид шагов») и «имя»

тотальная функция «Идентификатор функции»
  принимает «общее»: «Общее», «имя»: строка
  возвращает строка
  «Значение по ключу» от («общее».«ид функций») и «имя»

// ═══════════════════════════ проверки самой программы ═══════════════════════════
//
// Повторяет `prepare` эталона, а тот — `prepareProgram` интерпретатора: те же
// проверки, те же коды и тексты. Первая найденная ошибка побеждает, и порядок
// обхода здесь значим — эталон бросает на первой же.

объект «Проверка программы»
  «имена»: список строки
  «ошибка»: строка

тотальная функция «Первая ошибка»
  принимает «прежняя»: строка, «новая»: строка
  возвращает строка
  если (длина «прежняя») больше 0
    то «прежняя»
    иначе «новая»

тотальная функция «Ошибка параметра»
  принимает «параметр»: «Значение», «имя функции»: строка
  возвращает строка
  если «Это строка» от «параметр»
    то ""
    иначе
      если «Это строка» от («Взять поле» от «параметр» и "name")
        то ""
        иначе соединить ["параметр функции «", «имя функции», "» должен иметь имя"] по ""

тотальная функция «Проверить параметры»
  принимает «узел»: «Значение», «имя функции»: строка
  возвращает строка
  пусть «поле» равно («Взять поле» от «узел» и "params")
  если «Это ничто» от «поле»
    то ""
    иначе
      если «Это список» от «поле»
        то свёртка («Элементы узла» от «поле») начиная с "" как «акк» и «п» → «Первая ошибка» от «акк» и («Ошибка параметра» от «п» и «имя функции»)
        иначе соединить ["поле «params» функции «", «имя функции», "» должно быть списком"] по ""

// `item.expr === undefined` эталона: ключ со значением `null` проверку проходит,
// отсутствующий — нет. JSON эти два случая различает, и печать обязана тоже.
тотальная функция «Ошибка постусловия»
  принимает «постусловие»: «Значение», «имя функции»: строка
  возвращает строка
  если «Есть поле у узла» от «постусловие» и "expr"
    то ""
    иначе соединить ["постусловие функции «", «имя функции», "» должно содержать «expr»"] по ""

тотальная функция «Проверить постусловия»
  принимает «узел»: «Значение», «имя функции»: строка
  возвращает строка
  пусть «поле» равно («Взять поле» от «узел» и "postconditions")
  если «Это ничто» от «поле»
    то ""
    иначе
      если «Это список» от «поле»
        то свёртка («Элементы узла» от «поле») начиная с "" как «акк» и «п» → «Первая ошибка» от «акк» и («Ошибка постусловия» от «п» и «имя функции»)
        иначе соединить ["поле «postconditions» функции «", «имя функции», "» должно быть списком"] по ""

тотальная функция «Ошибка тела функции»
  принимает «узел»: «Значение», «имя»: строка, «имена»: список строки
  возвращает строка
  если «имена» содержит «имя»
    то соединить ["функция «", «имя», "» объявлена дважды"] по ""
    иначе
      если «Это ничто» от («Взять поле» от «узел» и "body")
        то соединить ["у функции «", «имя», "» нет тела"] по ""
        иначе «Первая ошибка» от («Проверить параметры» от «узел» и «имя») и («Проверить постусловия» от «узел» и «имя»)

тотальная функция «Ошибка функции»
  принимает «узел»: «Значение», «имя»: строка, «имена»: список строки
  возвращает строка
  если «Это строка» от («Взять поле» от «узел» и "name")
    то «Ошибка тела функции» от «узел» и «имя» и «имена»
    иначе "функция должна быть объектом с полем «name»"

тотальная функция «Шаг проверки функции»
  принимает «акк»: «Проверка программы», «узел»: «Значение»
  возвращает «Проверка программы»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «ошибка» равно («Ошибка функции» от «узел» и «имя» и («акк».«имена»))
  запись «Проверка программы» с «имена» равным (добавить «имя» к («акк».«имена»)) и «ошибка» равным («Первая ошибка» от («акк».«ошибка») и «ошибка»)

тотальная функция «Свернуть проверку функций»
  принимает «функции»: список «Значение»
  возвращает «Проверка программы»
  пусть «нуль» равно (запись «Проверка программы» с «имена» равным пустой список и «ошибка» равным "")
  свёртка «функции» начиная с «нуль» как «акк» и «узел» → «Шаг проверки функции» от «акк» и «узел»

тотальная функция «Проверить функции программы»
  принимает «программа»: «Значение»
  возвращает строка
  пусть «поле» равно («Взять поле» от «программа» и "functions")
  если «Это ничто» от «поле»
    то ""
    иначе
      если «Это список» от «поле»
        то («Свернуть проверку функций» от («Элементы узла» от «поле»)).«ошибка»
        иначе "поле «functions» программы должно быть списком"

тотальная функция «Проверить программу»
  принимает «программа»: «Значение»
  возвращает строка
  если «Это запись» от «программа»
    то «Проверить функции программы» от «программа»
    иначе "программа должна быть объектом AST flang"

// `Array.isArray(node.args)` эталона: `args`/`items` разрешено не быть вовсе, но
// если поле есть, оно обязано быть списком.
тотальная функция «Проверить список аргументов»
  принимает «состояние»: «Состояние», «узел»: «Значение», «ключ»: строка
  возвращает «Состояние»
  пусть «поле» равно («Взять поле» от «узел» и «ключ»)
  если «Это ничто» от «поле»
    то «состояние»
    иначе
      если «Это список» от «поле»
        то «состояние»
        иначе «Записать ошибку» от «состояние» и "аргументы выражения должны быть списком"

// ═══════════════════════════ печать выражений ═══════════════════════════
//
// В Elixir всё — выражение: `if` и `cond` возвращают значение, а последнее
// выражение блока и есть результат функции. Поэтому `return`, который печатают
// остальные бэкенды, здесь не нужен вовсе.
//
// А вот хвостовая позиция нужна, и нужна как раз потому, что здесь она
// работает. BEAM переиспользует кадр, только если вызов действительно
// последнее, что делает функция; стоит положить его результат в переменную — и
// хвостовой вызов перестаёт им быть. Поэтому печать разведена на два обхода:
// «Печать хвоста» печатает выражение как последнее выражение блока, ничего не
// связывая, а «Печать значения» — как значение, которое кому-то ещё понадобится.

// Напечатанные ради выражения строки плюс само выражение Elixir.
объект «Итог»
  «состояние»: «Состояние»
  «вывод»: список строки
  «значение»: строка

объект «Блок»
  «состояние»: «Состояние»
  «вывод»: список строки

// Область видимости в состояние не входит: она передаётся вниз, а «развязать
// имя» — это просто взять прежний контекст.
объект «Контекст»
  «общее»: «Общее»
  «функция»: «Функция»
  «параметры»: список строки
  «область»: список «Пара имён»

// Связанное имя и строка вывода, где оно объявлено: гасить приставкой «_»
// приходится уже напечатанную строку.
объект «Связка»
  «идентификатор»: строка
  «строка»: число

объект «Порядок»
  «блок»: «Блок»
  «части»: список строки

тотальная функция «Блок итога»
  принимает «итог»: «Итог»
  возвращает «Блок»
  запись «Блок» с «состояние» равным («итог».«состояние») и «вывод» равным («итог».«вывод»)

тотальная функция «Итог блока»
  принимает «блок»: «Блок», «значение»: строка
  возвращает «Итог»
  запись «Итог» с «состояние» равным («блок».«состояние») и «вывод» равным («блок».«вывод») и «значение» равным «значение»

тотальная функция «Дописать в блок»
  принимает «блок»: «Блок», «строка»: строка
  возвращает «Блок»
  запись «Блок» с «состояние» равным («блок».«состояние») и «вывод» равным (добавить «строка» к («блок».«вывод»))

тотальная функция «Блок с состоянием»
  принимает «блок»: «Блок», «состояние»: «Состояние»
  возвращает «Блок»
  запись «Блок» с «состояние» равным «состояние» и «вывод» равным («блок».«вывод»)

тотальная функция «Связать имя»
  принимает «контекст»: «Контекст», «имя»: строка, «идентификатор»: строка
  возвращает «Контекст»
  запись «Контекст» с «общее» равным («контекст».«общее») и «функция» равным («контекст».«функция») и «параметры» равным («контекст».«параметры») и «область» равным («Положить в таблицу» от («контекст».«область») и «имя» и «идентификатор»)

тотальная функция «Проверить имя узла»
  принимает «состояние»: «Состояние», «имя»: строка, «вид»: строка, «поле»: строка
  возвращает «Состояние»
  если (длина «имя») больше 0
    то «состояние»
    иначе «Записать ошибку» от «состояние» и (соединить ["узел «", «вид», "» требует непустое имя в поле «", «поле», "»"] по "")

// ── атомы и гашение неиспользованных ──

тотальная функция «Символы имени»
  возвращает строка
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

тотальная функция «Только символы имени»
  принимает «текст»: строка
  возвращает признак
  свёртка (разложить «текст» на символы) начиная с да как «акк» и «знак»
    если «акк»
      то «Символы имени» содержит «знак»
      иначе нет

тотальная функция «Без знака вопроса»
  принимает «текст»: строка
  возвращает строка
  пусть «последний» равно («Последний символ» от «текст»)
  если «последний» равен "?"
    то подстрока «текст» с 1 по ((длина «текст») минус 1)
    иначе
      если «последний» равен "!"
        то подстрока «текст» с 1 по ((длина «текст») минус 1)
        иначе «текст»

// Атом — выражение, которое можно передвинуть по тексту, ничего не изменив:
// имя переменной. Литералы сюда намеренно не попадают.
тотальная функция «Это атом»
  принимает «текст»: строка
  возвращает признак
  пример «Имя переменной»
    дано «текст» равно "t12"
    ожидается да
  пример «Вызов атомом не является»
    дано «текст» равно "Flang.Rt.nothing()"
    ожидается нет
  пусть «тело» равно («Без знака вопроса» от «текст»)
  если (длина «тело») равен 0
    то нет
    иначе
      если «Строчные буквы» содержит («Первый символ» от «тело»)
        то «Только символы имени» от «тело»
        иначе нет

// Связанное, но не использованное имя — обычное дело в языке с образцами
// («случай голова и хвост», а голова телу не нужна). В Elixir это
// предупреждение, а под `--warnings-as-errors` — отказ сборки. Приставка «_» —
// принятая здесь форма «вычислено и намеренно выброшено». Убрать само
// связывание нельзя: у варианта отсутствующее поле обязано дать
// FLANG_UNKNOWN_NAME прямо здесь.
тотальная функция «Погасить связку»
  принимает «вывод»: список строки, «текст»: строка, «связка»: «Связка»
  возвращает список строки
  если «Есть слово» от «текст» и («связка».«идентификатор»)
    то «вывод»
    иначе
      пусть «прежняя» равно («Элемент по индексу» от «вывод» и («связка».«строка»))
      пусть «что» равно (соединить («связка».«идентификатор») с " = ")
      пусть «чем» равно (соединить ["_", («связка».«идентификатор»), " = "] по "")
      «Заменить строку» от «вывод» и («связка».«строка») и («Заменить первое» от «прежняя» и «что» и «чем»)

тотальная функция «Гасить неиспользованные»
  принимает «вывод»: список строки, «от»: число, «связки»: список «Связка», «добавка»: строка
  возвращает список строки
  пусть «текст» равно (соединить [(«Склеить строки» от («Срез с» от «вывод» и «от»)), "\n", «добавка»] по "")
  свёртка «связки» начиная с «вывод» как «акк» и «связка» → «Погасить связку» от «акк» и «текст» и «связка»

// Значение, которое читается больше одного раза, обязано лечь в привязку.
тотальная функция «Овеществить»
  принимает «значение»: строка, «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  если «Это атом» от «значение»
    то «Итог блока» от «блок» и «значение»
    иначе
      пусть «свежее» равно («Временное» от («блок».«состояние»))
      пусть «строка» равно (соединить [«отступ», («свежее».«имя»), " = ", «значение»] по "")
      запись «Итог» с «состояние» равным («свежее».«состояние») и «вывод» равным (добавить «строка» к («блок».«вывод»)) и «значение» равным («свежее».«имя»)

// ── поля значений ──

тотальная функция «Ключи полей»
  принимает «поля»: список «Поле значения»
  возвращает список строки
  отобразить «поля» как «поле» → «поле».«ключ»

тотальная функция «Значения полей»
  принимает «поля»: список «Поле значения»
  возвращает список «Значение»
  отобразить «поля» как «поле» → «поле».«значение»

тотальная функция «Поле из списка»
  принимает «поля»: список «Поле значения», «ключ»: строка
  возвращает «Значение»
  разбор («Первое из полей» от (отфильтровать «поля» где «поле» → («поле».«ключ») равен «ключ»))
    случай вариант «Есть узел» с «узел» как «найденный»
      то «найденный»
    случай «Нет узла»
      то «Узел ничто»

тотальная функция «Шаг пары поля»
  принимает «зип»: «Зип», «ключ»: строка, «значения»: список строки
  возвращает «Зип»
  пусть «пара» равно (соединить ["{", («Строка Elixir» от «ключ»), ", ", («Элемент по индексу» от «значения» и («зип».«индекс»)), "}"] по "")
  пусть «связка» равно (если («зип».«индекс») равен 0 то "" иначе ", ")
  запись «Зип» с «индекс» равным ((«зип».«индекс») плюс 1) и «текст» равным (соединить [(«зип».«текст»), «связка», «пара»] по "")

// Поля — список пар, а не Map: их порядок наблюдаем в диагностиках.
тотальная функция «Собрать поля Elixir»
  принимает «ключи»: список строки, «значения»: список строки, «есть вариант»: признак, «вариант»: строка
  возвращает строка
  пусть «нуль» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
  пусть «тело» равно ((свёртка «ключи» начиная с «нуль» как «акк» и «ключ» → «Шаг пары поля» от «акк» и «ключ» и «значения»).«текст»)
  если «есть вариант»
    то соединить ["Flang.Rt.variant(", («Строка Elixir» от «вариант»), ", [", «тело», "])"] по ""
    иначе соединить ["Flang.Rt.record([", «тело», "])"] по ""

// ── литералы ──

тотальная функция «Печать скаляра»
  принимает «скаляр»: «Скаляр», «блок»: «Блок»
  возвращает «Итог»
  разбор «скаляр»
    случай «Скаляр ничто»
      то «Итог блока» от «блок» и "Flang.Rt.nothing()"
    случай вариант «Скаляр признак» с «значение» как «значение»
      то «Итог блока» от «блок» и (если «значение» то "Flang.Rt.flag(true)" иначе "Flang.Rt.flag(false)")
    случай вариант «Скаляр число» с «значение» как «значение»
      то «Итог блока» от «блок» и (соединить ["{:num, ", («Число Elixir» от «значение»), "}"] по "")
    случай вариант «Скаляр строка» с «значение» как «значение»
      то «Итог блока» от «блок» и (соединить ["Flang.Rt.text(", («Строка Elixir» от «значение»), ")"] по "")

// Значение-вариант в записи JSON: объект ровно с двумя полями, «variant» —
// непустая строка, «fields» — объект. Проверка дословно повторяет encodedVariant
// из builtins.mjs: расхождение здесь означало бы, что литерал, который
// интерпретатор считает вариантом, напечатанный код считает записью.
тотальная функция «Вариант по полям»
  принимает «поля»: список «Поле значения»
  возвращает «Может быть имя»
  пусть «имя» равно («Поле из списка» от «поля» и "variant")
  пусть «внутренние» равно («Поле из списка» от «поля» и "fields")
  если «Это строка» от «имя»
    то
      если (длина («Строка узла» от «имя»)) больше 0
        то
          если «Это запись» от «внутренние»
            то вариант «Есть имя» с «имя» равным («Строка узла» от «имя»)
            иначе вариант «Нет имени»
        иначе вариант «Нет имени»
    иначе вариант «Нет имени»

тотальная функция «Вариант в литерале»
  принимает «поля»: список «Поле значения»
  возвращает «Может быть имя»
  пусть «ключи» равно («Ключи полей» от «поля»)
  если (длина «поля») равен 2
    то
      если «ключи» содержит "variant"
        то
          если «ключи» содержит "fields"
            то «Вариант по полям» от «поля»
            иначе вариант «Нет имени»
        иначе вариант «Нет имени»
    иначе вариант «Нет имени»

функция «Шаг литерала по порядку»
  принимает «акк»: «Порядок», «узел»: «Значение», «отступ»: строка
  возвращает «Порядок»
  пусть «итог» равно («Печать литерала» от «узел» и («акк».«блок») и «отступ»)
  «Положить по порядку» от «итог» и («акк».«части») и «отступ»

функция «Шаг литерала без порядка»
  принимает «акк»: «Порядок», «узел»: «Значение», «отступ»: строка
  возвращает «Порядок»
  пусть «итог» равно («Печать литерала» от «узел» и («акк».«блок») и «отступ»)
  запись «Порядок» с «блок» равным («Блок итога» от «итог») и «части» равным (добавить («итог».«значение») к («акк».«части»))

функция «Печать литералов по порядку»
  принимает «узлы»: список «Значение», «блок»: «Блок», «отступ»: строка
  возвращает «Порядок»
  пусть «нуль» равно (запись «Порядок» с «блок» равным «блок» и «части» равным пустой список)
  если (длина «узлы») меньше 2
    то свёртка «узлы» начиная с «нуль» как «акк» и «узел» → «Шаг литерала без порядка» от «акк» и «узел» и «отступ»
    иначе свёртка «узлы» начиная с «нуль» как «акк» и «узел» → «Шаг литерала по порядку» от «акк» и «узел» и «отступ»

функция «Печать литерального списка»
  принимает «элементы»: список «Значение», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «порядок» равно («Печать литералов по порядку» от «элементы» и «блок» и «отступ»)
  «Итог блока» от («порядок».«блок») и (соединить ["Flang.Rt.list([", (соединить («порядок».«части») по ", "), "])"] по "")

функция «Печать полей литерала»
  принимает «поля»: список «Поле значения», «есть вариант»: признак, «вариант»: строка, «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «порядок» равно («Печать литералов по порядку» от («Значения полей» от «поля») и «блок» и «отступ»)
  «Итог блока» от («порядок».«блок») и («Собрать поля Elixir» от («Ключи полей» от «поля») и («порядок».«части») и «есть вариант» и «вариант»)

функция «Печать литеральной записи»
  принимает «поля»: список «Поле значения», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  разбор («Вариант в литерале» от «поля»)
    случай вариант «Есть имя» с «имя» как «имя варианта»
      то «Печать полей литерала» от («Поля узла» от («Поле из списка» от «поля» и "fields")) и да и «имя варианта» и «блок» и «отступ»
    случай «Нет имени»
      то «Печать полей литерала» от «поля» и нет и "" и «блок» и «отступ»

функция «Печать литерала»
  принимает «узел»: «Значение», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  разбор «узел»
    случай вариант «Значение скаляра» с «скаляр» как «скаляр»
      то «Печать скаляра» от «скаляр» и «блок»
    случай вариант «Значение списка» с «элементы» как «элементы»
      то «Печать литерального списка» от «элементы» и «блок» и «отступ»
    случай вариант «Значение записи» с «поля» как «поля»
      то «Печать литеральной записи» от «поля» и «блок» и «отступ»

// ── порядок вычисления ──
//
// Elixir не обещает, в каком порядке вычисляются аргументы вызова, — это
// записано в его же справочнике, — а сверяются ТЕКСТЫ первых ошибок. Поэтому
// каждый аргумент, кроме голого имени, обязательно ложится в отдельную
// привязку: только последовательность привязок в блоке язык вычисляет строго
// сверху вниз.

тотальная функция «Положить по порядку»
  принимает «итог»: «Итог», «части»: список строки, «отступ»: строка
  возвращает «Порядок»
  если «Это атом» от («итог».«значение»)
    то запись «Порядок» с «блок» равным («Блок итога» от «итог») и «части» равным (добавить («итог».«значение») к «части»)
    иначе
      пусть «свежее» равно («Временное» от («итог».«состояние»))
      пусть «строка» равно (соединить [«отступ», («свежее».«имя»), " = ", («итог».«значение»)] по "")
      пусть «блок» равно (запись «Блок» с «состояние» равным («свежее».«состояние») и «вывод» равным (добавить «строка» к («итог».«вывод»)))
      запись «Порядок» с «блок» равным «блок» и «части» равным (добавить («свежее».«имя») к «части»)

функция «Шаг порядка»
  принимает «акк»: «Порядок», «узел»: «Значение», «контекст»: «Контекст», «отступ»: строка
  возвращает «Порядок»
  пусть «итог» равно («Печать значения» от «узел» и «контекст» и («акк».«блок») и «отступ»)
  «Положить по порядку» от «итог» и («акк».«части») и «отступ»

функция «Шаг без порядка»
  принимает «акк»: «Порядок», «узел»: «Значение», «контекст»: «Контекст», «отступ»: строка
  возвращает «Порядок»
  пусть «итог» равно («Печать значения» от «узел» и «контекст» и («акк».«блок») и «отступ»)
  запись «Порядок» с «блок» равным («Блок итога» от «итог») и «части» равным (добавить («итог».«значение») к («акк».«части»))

функция «Печать по порядку»
  принимает «узлы»: список «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Порядок»
  пусть «нуль» равно (запись «Порядок» с «блок» равным «блок» и «части» равным пустой список)
  если (длина «узлы») меньше 2
    то свёртка «узлы» начиная с «нуль» как «акк» и «узел» → «Шаг без порядка» от «акк» и «узел» и «контекст» и «отступ»
    иначе свёртка «узлы» начиная с «нуль» как «акк» и «узел» → «Шаг порядка» от «акк» и «узел» и «контекст» и «отступ»

// ── проверки, повторяющие интерпретатор ──

тотальная функция «Проверить арность вызова»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «имя»: строка
  возвращает «Состояние»
  пусть «нужно» равно («Число параметров» от ((«контекст».«общее»).«функции») и «имя»)
  пусть «дано» равно (длина («Элементы поля» от «узел» и "args"))
  если «нужно» равен «дано»
    то «состояние»
    иначе «Записать ошибку» от «состояние» и (соединить ["функция «", «имя», "» принимает ", (к строке «нужно»), " аргум., передано ", (к строке «дано»)] по "")

тотальная функция «Разрешить вызов»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние»
  возвращает «Состояние»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  если «Есть функция с именем» от ((«контекст».«общее»).«функции») и «имя»
    то «Проверить арность вызова» от «узел» и «контекст» и («Проверить список аргументов» от «состояние» и «узел» и "args") и «имя»
    иначе «Записать ошибку» от «состояние» и (соединить ["не найдена функция «", «имя», "»"] по "")

тотальная функция «Проверить арность формы»
  принимает «состояние»: «Состояние», «каноническое»: строка, «дано»: число
  возвращает «Состояние»
  пусть «нужно» равно («Метка или ноль» от «Арности форм» и «каноническое»)
  если «нужно» равен «дано»
    то «состояние»
    иначе «Записать ошибку» от «состояние» и (соединить ["«", «каноническое», "» ожидает ", (к строке «нужно»), " ", («Слово аргументов» от «нужно»), ", получено ", (к строке «дано»)] по "")

тотальная функция «Проверить имя записи»
  принимает «контекст»: «Контекст», «состояние»: «Состояние», «имя»: строка
  возвращает «Состояние»
  если («Имена записей» от ((«контекст».«общее»).«записи»)) содержит «имя»
    то «состояние»
    иначе «Записать ошибку» от «состояние» и (соединить ["неизвестная запись «", «имя», "»"] по "")

тотальная функция «Проверить запись»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние»
  возвращает «Состояние»
  если пусто ((«контекст».«общее»).«записи»)
    то «состояние»
    иначе
      если «Есть поле у узла» от «узел» и "type"
        то «Проверить имя записи» от «контекст» и «состояние» и («Строка поля» от «узел» и "type")
        иначе «состояние»

тотальная функция «Проверить вариант»
  принимает «контекст»: «Контекст», «состояние»: «Состояние», «имя»: строка
  возвращает «Состояние»
  если пусто ((«контекст».«общее»).«варианты»)
    то «состояние»
    иначе
      если («Имена вариантов» от ((«контекст».«общее»).«варианты»)) содержит «имя»
        то «состояние»
        иначе «Записать ошибку» от «состояние» и (соединить ["неизвестный вариант «", «имя», "»"] по "")

// ── отдельные виды выражений ──

тотальная функция «Неизвестный вид»
  принимает «узел»: «Значение», «блок»: «Блок»
  возвращает «Итог»
  пусть «текст» равно (соединить ["неизвестный вид выражения «", («Вид узла» от «узел»), "»"] по "")
  «Итог блока» от («Блок с состоянием» от «блок» и («Записать ошибку» от («блок».«состояние») и «текст»)) и "Flang.Rt.nothing()"

тотальная функция «Печать переменной»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок»
  возвращает «Итог»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  разбор («Найти в таблице» от («контекст».«область») и «имя»)
    случай вариант «Есть имя» с «имя» как «найденное»
      то «Итог блока» от «блок» и «найденное»
    случай «Нет имени»
      то «Итог блока» от («Блок с состоянием» от «блок» и («Записать ошибку» от («блок».«состояние») и (соединить ["имя «", «имя», "» не связано"] по ""))) и "Flang.Rt.nothing()"

функция «Печать поля записи»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «цель» равно («Печать значения» от («Взять поле» от «узел» и "target") и «контекст» и «блок» и «отступ»)
  «Итог блока» от («Блок итога» от «цель») и (соединить ["Flang.Rt.field_get(", («цель».«значение»), ", ", («Строка Elixir» от («Строка поля» от «узел» и "field")), ")"] по "")

функция «Печать вызова значением»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «проверено» равно («Разрешить вызов» от «узел» и «контекст» и («блок».«состояние»))
  пусть «порядок» равно («Печать по порядку» от («Элементы поля» от «узел» и "args") и «контекст» и («Блок с состоянием» от «блок» и «проверено») и «отступ»)
  «Итог блока» от («порядок».«блок») и (соединить [(«Идентификатор функции» от («контекст».«общее») и «имя»), "(", (соединить («порядок».«части») по ", "), ")"] по "")

функция «Печать известной формы»
  принимает «узел»: «Значение», «каноническое»: строка, «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «узлы» равно («Элементы поля» от «узел» и "args")
  пусть «список» равно («Проверить список аргументов» от («блок».«состояние») и «узел» и "args")
  пусть «проверено» равно («Проверить арность формы» от «список» и «каноническое» и (длина «узлы»))
  пусть «порядок» равно («Печать по порядку» от «узлы» и «контекст» и («Блок с состоянием» от «блок» и «проверено») и «отступ»)
  «Итог блока» от («порядок».«блок») и (соединить ["Flang.Rt.", («Значение по ключу» от «Помощники форм» и «каноническое»), "(", (соединить («порядок».«части») по ", "), ")"] по "")

функция «Печать формы»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «каноническое» равно («Каноническое имя формы» от «имя»)
  если «Есть в таблице» от «Помощники форм» и «каноническое»
    то «Печать известной формы» от «узел» и «каноническое» и «контекст» и «блок» и «отступ»
    иначе «Итог блока» от («Блок с состоянием» от «блок» и («Записать ошибку» от («блок».«состояние») и (соединить ["неизвестная встроенная форма «", «имя», "»"] по ""))) и "Flang.Rt.nothing()"

тотальная функция «Печать помощника операции»
  принимает «операция»: строка, «левое»: строка, «правое»: строка, «блок»: «Блок»
  возвращает «Итог»
  если «Есть в таблице» от «Помощники операций» и «операция»
    то «Итог блока» от «блок» и (соединить ["Flang.Rt.", («Значение по ключу» от «Помощники операций» и «операция»), "(", «левое», ", ", «правое», ")"] по "")
    иначе «Итог блока» от («Блок с состоянием» от «блок» и («Записать ошибку» от («блок».«состояние») и (соединить ["неизвестная операция «", «операция», "»"] по ""))) и "Flang.Rt.nothing()"

функция «Печать операции»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «пара» равно [(«Взять поле» от «узел» и "left"), («Взять поле» от «узел» и "right")]
  пусть «порядок» равно («Печать по порядку» от «пара» и «контекст» и «блок» и «отступ»)
  пусть «левое» равно («Элемент по индексу» от («порядок».«части») и 0)
  пусть «правое» равно («Элемент по индексу» от («порядок».«части») и 1)
  пусть «операция» равно («Строка поля» от «узел» и "op")
  разбор «операция»
    случай "eq"
      то «Итог блока» от («порядок».«блок») и (соединить ["Flang.Rt.eq(", «левое», ", ", «правое», ")"] по "")
    случай "neq"
      то «Итог блока» от («порядок».«блок») и (соединить ["Flang.Rt.neq(", «левое», ", ", «правое», ")"] по "")
    случай любое
      то «Печать помощника операции» от «операция» и «левое» и «правое» и («порядок».«блок»)

функция «Печать списка»
  принимает «элементы»: список «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «порядок» равно («Печать по порядку» от «элементы» и «контекст» и «блок» и «отступ»)
  «Итог блока» от («порядок».«блок») и (соединить ["Flang.Rt.list([", (соединить («порядок».«части») по ", "), "])"] по "")

функция «Печать узла списка»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «проверено» равно («Проверить список аргументов» от («блок».«состояние») и «узел» и "items")
  «Печать списка» от («Элементы поля» от «узел» и "items") и «контекст» и («Блок с состоянием» от «блок» и «проверено») и «отступ»

функция «Печать полей значения»
  принимает «поля»: список «Поле значения», «есть вариант»: признак, «вариант»: строка, «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «порядок» равно («Печать по порядку» от («Значения полей» от «поля») и «контекст» и «блок» и «отступ»)
  «Итог блока» от («порядок».«блок») и («Собрать поля Elixir» от («Ключи полей» от «поля») и («порядок».«части») и «есть вариант» и «вариант»)

функция «Печать записи»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «проверено» равно («Проверить запись» от «узел» и «контекст» и («блок».«состояние»))
  «Печать полей значения» от («Поля узла» от («Взять поле» от «узел» и "fields")) и нет и "" и «контекст» и («Блок с состоянием» от «блок» и «проверено») и «отступ»

функция «Печать конструктора»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «имя» равно («Строка поля» от «узел» и "variant")
  пусть «проверено» равно («Проверить вариант» от «контекст» и («блок».«состояние») и «имя»)
  «Печать полей значения» от («Поля узла» от («Взять поле» от «узел» и "fields")) и да и «имя» и «контекст» и («Блок с состоянием» от «блок» и «проверено») и «отступ»

функция «Печать пусть значением»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «значение» равно («Печать значения» от («Взять поле» от «узел» и "value") и «контекст» и «блок» и «отступ»)
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «проверено» равно («Проверить имя узла» от («значение».«состояние») и «имя» и "let" и "name")
  пусть «свежее» равно («Свежее имя» от «проверено» и «имя»)
  пусть «идентификатор» равно («свежее».«имя»)
  пусть «с комментарием» равно (добавить (соединить [«отступ», "# пусть «", «имя», "»"] по "") к («значение».«вывод»))
  пусть «с привязкой» равно (добавить (соединить [«отступ», «идентификатор», " = ", («значение».«значение»)] по "") к «с комментарием»)
  пусть «связка» равно (запись «Связка» с «идентификатор» равным «идентификатор» и «строка» равным ((длина «с привязкой») минус 1))
  пусть «внутри» равно («Связать имя» от «контекст» и «имя» и «идентификатор»)
  пусть «тело» равно («Печать значения» от («Тело пусть» от «узел») и «внутри» и (запись «Блок» с «состояние» равным («свежее».«состояние») и «вывод» равным «с привязкой») и «отступ»)
  пусть «погашено» равно («Гасить неиспользованные» от («тело».«вывод») и (длина «с привязкой») и [«связка»] и («тело».«значение»))
  запись «Итог» с «состояние» равным («тело».«состояние») и «вывод» равным «погашено» и «значение» равным («тело».«значение»)

// `if` в Elixir — выражение, поэтому ветви печатаются прямо в него, а не через
// переменную-приёмник, как в C-подобных целях.
функция «Печать если значением»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «условие» равно («Печать значения» от («Взять поле» от «узел» и "cond") и «контекст» и «блок» и «отступ»)
  пусть «свежее» равно («Временное» от («условие».«состояние»))
  пусть «имя» равно («свежее».«имя»)
  пусть «шапка» равно («Дописать в блок» от («Дописать в блок» от (запись «Блок» с «состояние» равным («свежее».«состояние») и «вывод» равным («условие».«вывод»)) и (соединить [«отступ», «имя», " ="] по "")) и (соединить [«отступ», "  if Flang.Rt.cond_flag(", («условие».«значение»), ") do"] по ""))
  пусть «внутри» равно (соединить «отступ» с "    ")
  пусть «то» равно («Печать значением блока» от («Взять поле» от «узел» и "then") и «контекст» и «шапка» и «внутри»)
  пусть «между» равно («Дописать в блок» от «то» и (соединить «отступ» с "  else"))
  пусть «иначе» равно («Печать значением блока» от («Взять поле» от «узел» и "else") и «контекст» и «между» и «внутри»)
  «Итог блока» от («Дописать в блок» от «иначе» и (соединить «отступ» с "  end")) и «имя»

// Печатает выражение как последнее выражение блока, но НЕ в хвостовой позиции:
// значение блока кому-то ещё понадобится. Разница с «Печать хвоста» ровно одна
// и вся в вызове: здесь он идёт в публичную функцию, там — в тело соседа.
функция «Печать значением блока»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Блок»
  пусть «итог» равно («Печать значения» от «узел» и «контекст» и «блок» и «отступ»)
  «Дописать в блок» от («Блок итога» от «итог») и (соединить «отступ» с («итог».«значение»))

функция «Печать разбора значением»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «свежее» равно («Временное» от («блок».«состояние»))
  пусть «имя» равно («свежее».«имя»)
  пусть «итог» равно («Печать разбора» от «узел» и «контекст» и («Блок с состоянием» от «блок» и («свежее».«состояние»)) и «отступ» и да и «имя»)
  «Итог блока» от «итог» и «имя»

функция «Печать значения»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  разбор («Вид узла» от «узел»)
    случай "literal"
      то «Печать литерала» от («Взять поле» от «узел» и "value") и «блок» и «отступ»
    случай "var"
      то «Печать переменной» от «узел» и «контекст» и «блок»
    случай "field"
      то «Печать поля записи» от «узел» и «контекст» и «блок» и «отступ»
    случай "let"
      то «Печать пусть значением» от «узел» и «контекст» и «блок» и «отступ»
    случай "if"
      то «Печать если значением» от «узел» и «контекст» и «блок» и «отступ»
    случай "match"
      то «Печать разбора значением» от «узел» и «контекст» и «блок» и «отступ»
    случай "call"
      то «Печать вызова значением» от «узел» и «контекст» и «блок» и «отступ»
    случай "builtin"
      то «Печать формы» от «узел» и «контекст» и «блок» и «отступ»
    случай "binary"
      то «Печать операции» от «узел» и «контекст» и «блок» и «отступ»
    случай "list"
      то «Печать узла списка» от «узел» и «контекст» и «блок» и «отступ»
    случай "record"
      то «Печать записи» от «узел» и «контекст» и «блок» и «отступ»
    случай "construct"
      то «Печать конструктора» от «узел» и «контекст» и «блок» и «отступ»
    случай "fold"
      то «Печать свёртки» от «узел» и «контекст» и «блок» и «отступ»
    случай "map"
      то «Печать цикла» от «узел» и да и «контекст» и «блок» и «отступ»
    случай "filter"
      то «Печать цикла» от «узел» и нет и «контекст» и «блок» и «отступ»
    случай любое
      то «Неизвестный вид» от «узел» и «блок»

// ═══════════════════════════ хвостовая позиция ═══════════════════════════

тотальная функция «Гасимое имя»
  принимает «идентификатор»: строка, «текст»: строка
  возвращает строка
  если «Есть слово» от «текст» и «идентификатор»
    то «идентификатор»
    иначе соединить "_" с «идентификатор»

тотальная функция «Та же компонента»
  принимает «контекст»: «Контекст», «имя»: строка
  возвращает признак
  если «имя» равен ((«контекст».«функция»).«имя»)
    то да
    иначе («Цели» от ((«контекст».«общее»).«циклические») и ((«контекст».«функция»).«имя»)) содержит «имя»

// Хвостовой вызов внутри компоненты идёт в тело соседа, а не в его публичную
// функцию: так глубина не растёт (кадр переиспользован BEAM), а счётчик считает
// шаг, а не вход.
тотальная функция «Это отскок»
  принимает «контекст»: «Контекст», «имя»: строка
  возвращает признак
  если «Есть шаг» от («контекст».«общее») и «имя»
    то
      если «Есть шаг» от («контекст».«общее») и ((«контекст».«функция»).«имя»)
        то «Та же компонента» от «контекст» и «имя»
        иначе нет
    иначе нет

тотальная функция «Печать отскока»
  принимает «имя»: строка, «аргументы»: строка, «блок»: «Блок», «отступ»: строка, «контекст»: «Контекст»
  возвращает «Блок»
  пусть «первая» равно (соединить [«отступ», "# хвостовой вызов «", «имя», "»: BEAM переиспользует кадр сам"] по "")
  пусть «вторая» равно (соединить [«отступ», "Flang.Rt.step(", («Строка Elixir» от ((«контекст».«функция»).«имя»)), ")"] по "")
  пусть «третья» равно (соединить [«отступ», («Шаг функции» от («контекст».«общее») и «имя»), "(", «аргументы», ")"] по "")
  «Дописать в блок» от («Дописать в блок» от («Дописать в блок» от «блок» и «первая») и «вторая») и «третья»

функция «Хвостовой вызов»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Блок»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «проверено» равно («Разрешить вызов» от «узел» и «контекст» и («блок».«состояние»))
  пусть «порядок» равно («Печать по порядку» от («Элементы поля» от «узел» и "args") и «контекст» и («Блок с состоянием» от «блок» и «проверено») и «отступ»)
  пусть «аргументы» равно (соединить («порядок».«части») по ", ")
  если «Это отскок» от «контекст» и «имя»
    то «Печать отскока» от «имя» и «аргументы» и («порядок».«блок») и «отступ» и «контекст»
    иначе «Дописать в блок» от («порядок».«блок») и (соединить [«отступ», («Идентификатор функции» от («контекст».«общее») и «имя»), "(", «аргументы», ")"] по "")

функция «Хвостовое пусть»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Блок»
  пусть «значение» равно («Печать значения» от («Взять поле» от «узел» и "value") и «контекст» и «блок» и «отступ»)
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «проверено» равно («Проверить имя узла» от («значение».«состояние») и «имя» и "let" и "name")
  пусть «свежее» равно («Свежее имя» от «проверено» и «имя»)
  пусть «идентификатор» равно («свежее».«имя»)
  пусть «с комментарием» равно (добавить (соединить [«отступ», "# пусть «", «имя», "»"] по "") к («значение».«вывод»))
  пусть «с привязкой» равно (добавить (соединить [«отступ», «идентификатор», " = ", («значение».«значение»)] по "") к «с комментарием»)
  пусть «связка» равно (запись «Связка» с «идентификатор» равным «идентификатор» и «строка» равным ((длина «с привязкой») минус 1))
  пусть «внутри» равно («Связать имя» от «контекст» и «имя» и «идентификатор»)
  пусть «тело» равно («Печать хвоста» от («Тело пусть» от «узел») и «внутри» и (запись «Блок» с «состояние» равным («свежее».«состояние») и «вывод» равным «с привязкой») и «отступ»)
  запись «Блок» с «состояние» равным («тело».«состояние») и «вывод» равным («Гасить неиспользованные» от («тело».«вывод») и (длина «с привязкой») и [«связка»] и "")

функция «Хвостовое если»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Блок»
  пусть «условие» равно («Печать значения» от («Взять поле» от «узел» и "cond") и «контекст» и «блок» и «отступ»)
  пусть «шапка» равно («Дописать в блок» от («Блок итога» от «условие») и (соединить [«отступ», "if Flang.Rt.cond_flag(", («условие».«значение»), ") do"] по ""))
  пусть «внутри» равно (соединить «отступ» с "  ")
  пусть «то» равно («Печать хвоста» от («Взять поле» от «узел» и "then") и «контекст» и «шапка» и «внутри»)
  пусть «между» равно («Дописать в блок» от «то» и (соединить «отступ» с "else"))
  пусть «иначе» равно («Печать хвоста» от («Взять поле» от «узел» и "else") и «контекст» и «между» и «внутри»)
  «Дописать в блок» от «иначе» и (соединить «отступ» с "end")

// Печать выражения в хвостовой позиции: результатом блока становится оно само,
// без промежуточной привязки. Только здесь хвостовой вызов внутри компоненты
// печатается вызовом тела соседа (`loop_…`), а не публичной функции.
функция «Печать хвоста»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Блок»
  пусть «вид» равно («Вид узла» от «узел»)
  если «вид» равен "let"
    то «Хвостовое пусть» от «узел» и «контекст» и «блок» и «отступ»
    иначе
      если «вид» равен "if"
        то «Хвостовое если» от «узел» и «контекст» и «блок» и «отступ»
        иначе
          если «вид» равен "match"
            то «Печать разбора» от «узел» и «контекст» и «блок» и «отступ» и нет и ""
            иначе
              если «вид» равен "call"
                то «Хвостовой вызов» от «узел» и «контекст» и «блок» и «отступ»
                иначе «Печать значением блока» от «узел» и «контекст» и «блок» и «отступ»

// ═══════════════════════════ разбор с образцами ═══════════════════════════
//
// Разбор печатается `cond`, а не цепочкой `if`: `cond` — это ровно «первая
// подошедшая ветвь» и ничего сверх того, и он же выражение. Сопоставление
// самого Elixir (`case`) здесь не годится: образец flang проверяет дискриминант
// ПО ЗНАЧЕНИЮ, а образец-литерал сравнивает значения по правилам flang (NaN
// равен NaN) — `case` разошёлся бы с интерпретатором на первом же NaN.

объект «Проверка образца»
  «есть»: признак
  «текст»: строка

объект «Итог проверки»
  «блок»: «Блок»
  «проверка»: «Проверка образца»

объект «Сбор проверок»
  «блок»: «Блок»
  «проверки»: список «Проверка образца»

объект «Обстановка разбора»
  «предмет»: строка
  «отступ»: строка
  «сдвиг»: строка
  «внутри»: строка
  «есть цель»: признак
  «всего»: число

объект «Ветви»
  «блок»: «Блок»
  «индекс»: число
  «закрыто»: признак

объект «Связывание»
  «блок»: «Блок»
  «контекст»: «Контекст»
  «связки»: список «Связка»

объект «Связка варианта»
  «поле»: строка
  «имя»: строка

объект «Выбор проверки»
  «индекс»: число
  «проверка»: «Проверка образца»

тотальная функция «Шаг выбора проверки»
  принимает «акк»: «Выбор проверки», «проверка»: «Проверка образца», «искомый»: число
  возвращает «Выбор проверки»
  если («акк».«индекс») равен «искомый»
    то запись «Выбор проверки» с «индекс» равным ((«акк».«индекс») плюс 1) и «проверка» равным «проверка»
    иначе запись «Выбор проверки» с «индекс» равным ((«акк».«индекс») плюс 1) и «проверка» равным («акк».«проверка»)

тотальная функция «Проверка по индексу»
  принимает «проверки»: список «Проверка образца», «индекс»: число
  возвращает «Проверка образца»
  пусть «нуль» равно (запись «Выбор проверки» с «индекс» равным 0 и «проверка» равным (запись «Проверка образца» с «есть» равным нет и «текст» равным ""))
  пусть «итог» равно (свёртка «проверки» начиная с «нуль» как «акк» и «проверка» → «Шаг выбора проверки» от «акк» и «проверка» и «индекс»)
  «итог».«проверка»

тотальная функция «Готовая проверка»
  принимает «блок»: «Блок», «текст»: строка
  возвращает «Итог проверки»
  запись «Итог проверки» с «блок» равным «блок» и «проверка» равным (запись «Проверка образца» с «есть» равным да и «текст» равным «текст»)

функция «Проверка литералом»
  принимает «образец»: «Значение», «предмет»: строка, «блок»: «Блок», «отступ»: строка
  возвращает «Итог проверки»
  пусть «итог» равно («Печать литерала» от («Взять поле» от «образец» и "value") и «блок» и «отступ»)
  «Готовая проверка» от («Блок итога» от «итог») и (соединить ["Flang.Rt.equal(", «предмет», ", ", («итог».«значение»), ")"] по "")

тотальная функция «Ошибка образца»
  принимает «образец»: «Значение», «блок»: «Блок»
  возвращает «Итог проверки»
  пусть «текст» равно (соединить ["неизвестный вид образца «", («Вид узла» от «образец»), "»"] по "")
  «Готовая проверка» от («Блок с состоянием» от «блок» и («Записать ошибку» от («блок».«состояние») и «текст»)) и "true"

// Проверка дискриминанта; «нет проверки» — образец совпадает всегда.
функция «Проверка образца»
  принимает «образец»: «Значение», «предмет»: строка, «блок»: «Блок», «отступ»: строка
  возвращает «Итог проверки»
  пусть «вид» равно («Вид узла» от «образец»)
  если «вид» равен "empty"
    то «Готовая проверка» от «блок» и (соединить ["Flang.Rt.chain_empty?(", «предмет», ")"] по "")
    иначе
      если «вид» равен "cons"
        то «Готовая проверка» от «блок» и (соединить ["Flang.Rt.chain_cons?(", «предмет», ")"] по "")
        иначе
          если «вид» равен "variant"
            то «Готовая проверка» от «блок» и (соединить ["Flang.Rt.variant_is?(", «предмет», ", ", («Строка Elixir» от («Строка поля» от «образец» и "name")), ")"] по "")
            иначе
              если «вид» равен "literal"
                то «Проверка литералом» от «образец» и «предмет» и «блок» и «отступ»
                иначе
                  если «вид» равен "any"
                    то запись «Итог проверки» с «блок» равным «блок» и «проверка» равным (запись «Проверка образца» с «есть» равным нет и «текст» равным "")
                    иначе «Ошибка образца» от «образец» и «блок»

функция «Шаг сбора проверок»
  принимает «акк»: «Сбор проверок», «случай»: «Значение», «предмет»: строка, «отступ»: строка
  возвращает «Сбор проверок»
  пусть «итог» равно («Проверка образца» от («Взять поле» от «случай» и "pattern") и «предмет» и («акк».«блок») и «отступ»)
  запись «Сбор проверок» с «блок» равным («итог».«блок») и «проверки» равным (добавить («итог».«проверка») к («акк».«проверки»))

функция «Добавить связку»
  принимает «связывание»: «Связывание», «имя»: строка, «код»: строка, «есть комментарий»: признак, «комментарий»: строка, «отступ»: строка
  возвращает «Связывание»
  пусть «свежее» равно («Свежее имя» от ((«связывание».«блок»).«состояние») и «имя»)
  пусть «идентификатор» равно («свежее».«имя»)
  пусть «после комментария» равно (если «есть комментарий» то (добавить (соединить [«отступ», "# ", «комментарий»] по "") к ((«связывание».«блок»).«вывод»)) иначе ((«связывание».«блок»).«вывод»))
  пусть «вывод» равно (добавить (соединить [«отступ», «идентификатор», " = ", «код»] по "") к «после комментария»)
  пусть «связка» равно (запись «Связка» с «идентификатор» равным «идентификатор» и «строка» равным ((длина «вывод») минус 1))
  запись «Связывание» с «блок» равным (запись «Блок» с «состояние» равным («свежее».«состояние») и «вывод» равным «вывод») и «контекст» равным («Связать имя» от («связывание».«контекст») и «имя» и «идентификатор») и «связки» равным (добавить «связка» к («связывание».«связки»))

// Единственное место, где Elixir дешевле остальных целей: список односвязный, и
// «хвост» — тот же список без первой ячейки, без копирования.
функция «Связать голову»
  принимает «связывание»: «Связывание», «образец»: «Значение», «предмет»: строка, «отступ»: строка
  возвращает «Связывание»
  пусть «голова» равно («Взять поле» от «образец» и "head")
  если «Это строка» от «голова»
    то «Добавить связку» от «связывание» и («Строка узла» от «голова») и (соединить ["Flang.Rt.chain_head(", «предмет», ")"] по "") и да и (соединить ["голова «", («Строка узла» от «голова»), "»"] по "") и «отступ»
    иначе «связывание»

функция «Связать хвост»
  принимает «связывание»: «Связывание», «образец»: «Значение», «предмет»: строка, «отступ»: строка
  возвращает «Связывание»
  пусть «хвост» равно («Взять поле» от «образец» и "tail")
  если «Это строка» от «хвост»
    то «Добавить связку» от «связывание» и («Строка узла» от «хвост») и (соединить ["Flang.Rt.chain_tail(", «предмет», ")"] по "") и да и (соединить ["хвост «", («Строка узла» от «хвост»), "»"] по "") и «отступ»
    иначе «связывание»

// `bind` образца приходит то записью, то списком имён — эталон принимает оба.
тотальная функция «Связки варианта»
  принимает «образец»: «Значение»
  возвращает список «Связка варианта»
  разбор («Взять поле» от «образец» и "bind")
    случай вариант «Значение списка» с «элементы» как «элементы»
      то отобразить «элементы» как «эл» → запись «Связка варианта» с «поле» равным («Строка узла» от «эл») и «имя» равным («Строка узла» от «эл»)
    случай вариант «Значение записи» с «поля» как «поля»
      то отобразить «поля» как «поле» → запись «Связка варианта» с «поле» равным («поле».«ключ») и «имя» равным («Строка узла» от («поле».«значение»))
    случай любое
      то пустой список

// Отсутствующее поле варианта — ошибка прямо при сопоставлении, а не «случай не
// подошёл»: так же ведёт себя matchPattern интерпретатора.
функция «Связать поле варианта»
  принимает «связывание»: «Связывание», «пара»: «Связка варианта», «предмет»: строка, «отступ»: строка
  возвращает «Связывание»
  «Добавить связку» от «связывание» и («пара».«имя») и (соединить ["Flang.Rt.variant_field(", «предмет», ", ", («Строка Elixir» от («пара».«поле»)), ")"] по "") и да и (соединить ["поле «", («пара».«поле»), "»"] по "") и «отступ»

функция «Связать любое»
  принимает «связывание»: «Связывание», «образец»: «Значение», «предмет»: строка, «отступ»: строка
  возвращает «Связывание»
  пусть «имя» равно («Взять поле» от «образец» и "bind")
  если «Это строка» от «имя»
    то «Добавить связку» от «связывание» и («Строка узла» от «имя») и «предмет» и нет и "" и «отступ»
    иначе «связывание»

функция «Связать образец»
  принимает «образец»: «Значение», «предмет»: строка, «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Связывание»
  пусть «нуль» равно (запись «Связывание» с «блок» равным «блок» и «контекст» равным «контекст» и «связки» равным пустой список)
  пусть «вид» равно («Вид узла» от «образец»)
  если «вид» равен "cons"
    то «Связать хвост» от («Связать голову» от «нуль» и «образец» и «предмет» и «отступ») и «образец» и «предмет» и «отступ»
    иначе
      если «вид» равен "variant"
        то свёртка («Связки варианта» от «образец») начиная с «нуль» как «акк» и «пара» → «Связать поле варианта» от «акк» и «пара» и «предмет» и «отступ»
        иначе
          если «вид» равен "any"
            то «Связать любое» от «нуль» и «образец» и «предмет» и «отступ»
            иначе «нуль»

функция «Тело ветви»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка, «есть цель»: признак
  возвращает «Блок»
  если «есть цель»
    то «Печать значением блока» от «узел» и «контекст» и «блок» и «отступ»
    иначе «Печать хвоста» от «узел» и «контекст» и «блок» и «отступ»

функция «Ветвь дальше»
  принимает «акк»: «Ветви», «случай»: «Значение», «проверки»: список «Проверка образца», «обстановка»: «Обстановка разбора», «контекст»: «Контекст»
  возвращает «Ветви»
  пусть «проверка» равно («Проверка по индексу» от «проверки» и («акк».«индекс»))
  пусть «условие» равно (если («проверка».«есть») то («проверка».«текст») иначе "true")
  пусть «шапка» равно («Дописать в блок» от («акк».«блок») и (соединить [(«обстановка».«отступ»), («обстановка».«сдвиг»), "  ", «условие», " ->"] по ""))
  пусть «связывание» равно («Связать образец» от («Взять поле» от «случай» и "pattern") и («обстановка».«предмет») и «контекст» и «шапка» и («обстановка».«внутри»))
  пусть «до тела» равно (длина ((«связывание».«блок»).«вывод»))
  пусть «тело» равно («Тело ветви» от («Взять поле» от «случай» и "body") и («связывание».«контекст») и («связывание».«блок») и («обстановка».«внутри») и («обстановка».«есть цель»))
  пусть «погашено» равно («Гасить неиспользованные» от («тело».«вывод») и «до тела» и («связывание».«связки») и "")
  пусть «после» равно (если ((«акк».«индекс») плюс 1) меньше («обстановка».«всего») то (добавить "" к «погашено») иначе «погашено»)
  запись «Ветви» с «блок» равным (запись «Блок» с «состояние» равным («тело».«состояние») и «вывод» равным «после») и «индекс» равным ((«акк».«индекс») плюс 1) и «закрыто» равным (если («проверка».«есть») то нет иначе да)

функция «Печать ветви»
  принимает «акк»: «Ветви», «случай»: «Значение», «проверки»: список «Проверка образца», «обстановка»: «Обстановка разбора», «контекст»: «Контекст»
  возвращает «Ветви»
  если («акк».«закрыто»)
    то «акк»
    иначе «Ветвь дальше» от «акк» и «случай» и «проверки» и «обстановка» и «контекст»

// Ветвь «ни один образец не подошёл» обязана быть: `cond` без подошедшей ветви
// возбуждает CondClauseError — ошибку Elixir, а не диагностику flang.
тотальная функция «Ветвь по умолчанию»
  принимает «блок»: «Блок», «обстановка»: «Обстановка разбора»
  возвращает «Блок»
  пусть «с пустой» равно (если («обстановка».«всего») больше 0 то («Дописать в блок» от «блок» и "") иначе «блок»)
  пусть «с истиной» равно («Дописать в блок» от «с пустой» и (соединить [(«обстановка».«отступ»), («обстановка».«сдвиг»), "  true ->"] по ""))
  «Дописать в блок» от «с истиной» и (соединить [(«обстановка».«внутри»), "raise Flang.Rt.match_fail(", («обстановка».«предмет»), ")"] по "")

функция «Печать разбора»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка, «есть цель»: признак, «цель»: строка
  возвращает «Блок»
  пусть «предметное» равно («Печать значения» от («Взять поле» от «узел» и "target") и «контекст» и «блок» и «отступ»)
  пусть «предмет» равно («Овеществить» от («предметное».«значение») и («Блок итога» от «предметное») и «отступ»)
  пусть «случаи» равно («Элементы поля» от «узел» и "cases")
  пусть «нуль» равно (запись «Сбор проверок» с «блок» равным («Блок итога» от «предмет») и «проверки» равным пустой список)
  пусть «сбор» равно (свёртка «случаи» начиная с «нуль» как «акк» и «случай» → «Шаг сбора проверок» от «акк» и «случай» и («предмет».«значение») и «отступ»)
  пусть «сдвиг» равно (если «есть цель» то "  " иначе "")
  пусть «внутри» равно (соединить [«отступ», «сдвиг», "    "] по "")
  пусть «с целью» равно (если «есть цель» то («Дописать в блок» от («сбор».«блок») и (соединить [«отступ», «цель», " ="] по "")) иначе («сбор».«блок»))
  пусть «с шапкой» равно («Дописать в блок» от «с целью» и (соединить [«отступ», «сдвиг», "cond do"] по ""))
  пусть «обстановка» равно (запись «Обстановка разбора» с «предмет» равным («предмет».«значение») и «отступ» равным «отступ» и «сдвиг» равным «сдвиг» и «внутри» равным «внутри» и «есть цель» равным «есть цель» и «всего» равным (длина «случаи»))
  пусть «начало ветвей» равно (запись «Ветви» с «блок» равным «с шапкой» и «индекс» равным 0 и «закрыто» равным нет)
  пусть «ветви» равно (свёртка «случаи» начиная с «начало ветвей» как «акк» и «случай» → «Печать ветви» от «акк» и «случай» и («сбор».«проверки») и «обстановка» и «контекст»)
  пусть «закрытый» равно (если («ветви».«закрыто») то («ветви».«блок») иначе («Ветвь по умолчанию» от («ветви».«блок») и «обстановка»))
  «Дописать в блок» от «закрытый» и (соединить [«отступ», «сдвиг», "end"] по "")

// ═══════════════════════════ свёртка, отобразить, отфильтровать ═══════════════════════════
//
// Циклов в Elixir нет вовсе — и это ровно тот случай, когда их отсутствие не
// стоит ничего: `свёртка` это `Enum.reduce`, `отобразить` — `Enum.map`,
// `отфильтровать` — `Enum.filter`. Остальные бэкенды печатают на их месте цикл
// с накопителем; здесь накопителя нет, потому что нет и изменяемости.

функция «Печать свёртки дальше»
  принимает «узел»: «Значение», «накопитель»: строка, «элемент»: строка, «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «по» равно («Печать значения» от («Взять поле» от «узел» и "over") и «контекст» и «блок» и «отступ»)
  пусть «список» равно («Овеществить» от (соединить ["Flang.Rt.require_list(", («по».«значение»), ", \"свёртка\")"] по "") и («Блок итога» от «по») и «отступ»)
  пусть «начальное» равно («Печать значения» от («Взять поле» от «узел» и "init") и «контекст» и («Блок итога» от «список») и «отступ»)
  пусть «нач» равно («Овеществить» от («начальное».«значение») и («Блок итога» от «начальное») и «отступ»)
  пусть «свежий акк» равно («Свежее имя» от («нач».«состояние») и «накопитель»)
  пусть «свежий элемент» равно («Свежее имя» от («свежий акк».«состояние») и «элемент»)
  пусть «свежее» равно («Временное» от («свежий элемент».«состояние»))
  пусть «внутри» равно (соединить «отступ» с "    ")
  пусть «с акк» равно («Связать имя» от «контекст» и «накопитель» и («свежий акк».«имя»))
  пусть «с элементом» равно («Связать имя» от «с акк» и «элемент» и («свежий элемент».«имя»))
  пусть «тело» равно («Печать значения» от («Взять поле» от «узел» и "body") и «с элементом» и (запись «Блок» с «состояние» равным («свежее».«состояние») и «вывод» равным пустой список) и «внутри»)
  пусть «текст тела» равно («Склеить строки» от (добавить («тело».«значение») к («тело».«вывод»)))
  пусть «шапка» равно [(соединить [«отступ», («свежее».«имя»), " ="] по ""), (соединить [«отступ», "  Enum.reduce(", («список».«значение»), ", ", («нач».«значение»), ", fn ", («Гасимое имя» от («свежий элемент».«имя») и «текст тела»), ", ", («Гасимое имя» от («свежий акк».«имя») и «текст тела»), " ->"] по "")]
  пусть «хвост» равно [(соединить «внутри» с («тело».«значение»)), (соединить «отступ» с "  end)")]
  пусть «вывод» равно («Слить списки строк» от («Слить списки строк» от («Слить списки строк» от («нач».«вывод») и «шапка») и («тело».«вывод»)) и «хвост»)
  запись «Итог» с «состояние» равным («тело».«состояние») и «вывод» равным «вывод» и «значение» равным («свежее».«имя»)

// Порядок как в интерпретаторе: сперва коллекция и проверка «это список»,
// только потом начальное значение.
функция «Печать свёртки»
  принимает «узел»: «Значение», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «накопитель» равно («Строка поля» от «узел» и "acc")
  пусть «элемент» равно («Строка поля» от «узел» и "item")
  пусть «сперва» равно («Проверить имя узла» от («блок».«состояние») и «накопитель» и "fold" и "acc")
  пусть «затем» равно («Проверить имя узла» от «сперва» и «элемент» и "fold" и "item")
  «Печать свёртки дальше» от «узел» и «накопитель» и «элемент» и «контекст» и («Блок с состоянием» от «блок» и «затем») и «отступ»

тотальная функция «Сдвинуть строку»
  принимает «строка»: строка
  возвращает строка
  если (длина «строка») равен 0
    то ""
    иначе соединить "  " с «строка»

функция «Печать цикла дальше»
  принимает «узел»: «Значение», «это отображение»: признак, «элемент»: строка, «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «ярлык» равно (если «это отображение» то "отобразить" иначе "отфильтровать")
  пусть «по» равно («Печать значения» от («Взять поле» от «узел» и "over") и «контекст» и «блок» и «отступ»)
  пусть «список» равно («Овеществить» от (соединить ["Flang.Rt.require_list(", («по».«значение»), ", ", («Строка Elixir» от «ярлык»), ")"] по "") и («Блок итога» от «по») и «отступ»)
  пусть «свежий элемент» равно («Свежее имя» от («список».«состояние») и «элемент»)
  пусть «свежее» равно («Временное» от («свежий элемент».«состояние»))
  пусть «внутри» равно (соединить «отступ» с "    ")
  пусть «с элементом» равно («Связать имя» от «контекст» и «элемент» и («свежий элемент».«имя»))
  пусть «тело» равно («Печать значения» от («Взять поле» от «узел» и "body") и «с элементом» и (запись «Блок» с «состояние» равным («свежее».«состояние») и «вывод» равным пустой список) и «внутри»)
  пусть «текст тела» равно («Склеить строки» от (добавить («тело».«значение») к («тело».«вывод»)))
  пусть «параметр» равно («Гасимое имя» от («свежий элемент».«имя») и «текст тела»)
  пусть «шапка» равно [
    (соединить [«отступ», («свежее».«имя»), " ="] по ""),
    (соединить «отступ» с "  Flang.Rt.list("),
    (соединить [«отступ», "    ", (если «это отображение» то "Enum.map(" иначе "Enum.filter("), («список».«значение»), ", fn ", «параметр», " ->"] по "")
  ]
  пусть «итоговое» равно (если «это отображение» то (соединить [«внутри», "  ", («тело».«значение»)] по "") иначе (соединить [«внутри», "  Flang.Rt.keep(", («тело».«значение»), ")"] по ""))
  пусть «хвост» равно [«итоговое», (соединить «отступ» с "    end)"), (соединить «отступ» с "  )")]
  пусть «сдвинутое» равно (отобразить («тело».«вывод») как «строка» → «Сдвинуть строку» от «строка»)
  пусть «вывод» равно («Слить списки строк» от («Слить списки строк» от («Слить списки строк» от («список».«вывод») и «шапка») и «сдвинутое») и «хвост»)
  запись «Итог» с «состояние» равным («тело».«состояние») и «вывод» равным «вывод» и «значение» равным («свежее».«имя»)

функция «Печать цикла»
  принимает «узел»: «Значение», «это отображение»: признак, «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Итог»
  пусть «элемент» равно («Строка поля» от «узел» и "item")
  пусть «проверено» равно («Проверить имя узла» от («блок».«состояние») и «элемент» и («Вид узла» от «узел») и "item")
  «Печать цикла дальше» от «узел» и «это отображение» и «элемент» и «контекст» и («Блок с состоянием» от «блок» и «проверено») и «отступ»

// ═══════════════════════════ печать функции ═══════════════════════════

объект «Кусок»
  «состояние»: «Состояние»
  «текст»: строка

объект «Связывание параметров»
  «контекст»: «Контекст»
  «индекс»: число

тотальная функция «Связать параметр»
  принимает «акк»: «Связывание параметров», «параметр»: «Параметр», «идентификаторы»: список строки
  возвращает «Связывание параметров»
  пусть «имя» равно («Элемент по индексу» от «идентификаторы» и («акк».«индекс»))
  запись «Связывание параметров» с «контекст» равным («Связать имя» от («акк».«контекст») и («параметр».«имя») и «имя») и «индекс» равным ((«акк».«индекс») плюс 1)

тотальная функция «Начальный контекст»
  принимает «функция»: «Функция», «общее»: «Общее»
  возвращает «Контекст»
  пусть «идентификаторы» равно («Идентификаторы для» от («общее».«ид параметров») и («функция».«имя»))
  пусть «пустой» равно (запись «Контекст» с «общее» равным «общее» и «функция» равным «функция» и «параметры» равным «идентификаторы» и «область» равным пустой список)
  пусть «нуль» равно (запись «Связывание параметров» с «контекст» равным «пустой» и «индекс» равным 0)
  пусть «связано» равно (свёртка («функция».«параметры») начиная с «нуль» как «акк» и «параметр» → «Связать параметр» от «акк» и «параметр» и «идентификаторы»)
  «связано».«контекст»

// Контекст ДВЕРИ: тот же контекст функции, но имена параметров связаны прямо с
// `Enum.at(args, i)` — своих имён у двери нет.
тотальная функция «Контекст двери»
  принимает «функция»: «Функция», «общее»: «Общее»
  возвращает «Контекст»
  пусть «идентификаторы» равно («Идентификаторы для» от («общее».«ид параметров») и («функция».«имя»))
  пусть «пустой» равно (запись «Контекст» с «общее» равным «общее» и «функция» равным «функция» и «параметры» равным «идентификаторы» и «область» равным пустой список)
  пусть «нуль» равно (запись «Связывание параметров» с «контекст» равным «пустой» и «индекс» равным 0)
  пусть «связано» равно (свёртка («функция».«параметры») начиная с «нуль» как «акк» и «параметр» → «Связать параметр двери» от «акк» и «параметр»)
  «связано».«контекст»

тотальная функция «Связать параметр двери»
  принимает «акк»: «Связывание параметров», «параметр»: «Параметр»
  возвращает «Связывание параметров»
  пусть «имя» равно (соединить ["Enum.at(args, ", (к строке («акк».«индекс»)), ")"] по "")
  запись «Связывание параметров» с «контекст» равным («Связать имя» от («акк».«контекст») и («параметр».«имя») и «имя») и «индекс» равным ((«акк».«индекс») плюс 1)

тотальная функция «Начальное взятое»
  принимает «состояние»: «Состояние», «общее»: «Общее», «параметры»: список строки
  возвращает «Состояние»
  «Заменить взятое» от «состояние» и («Слить списки строк» от («общее».«глобальные») и «параметры»)

// Постусловия проверяются после тела: результат уже вычислен, и первое же
// нарушение прерывает вычисление — как в интерпретаторе.
функция «Шаг постусловия»
  принимает «блок»: «Блок», «постусловие»: «Постусловие», «результат»: строка, «контекст»: «Контекст», «функция»: «Функция», «отступ»: строка
  возвращает «Блок»
  пусть «внутри» равно («Связать имя» от «контекст» и («постусловие».«связывание») и «результат»)
  пусть «проверка» равно («Печать значения» от («постусловие».«выражение») и «внутри» и «блок» и «отступ»)
  пусть «сообщение» равно (если («постусловие».«есть сообщение») то («постусловие».«сообщение») иначе (соединить ["нарушено свойство «", («постусловие».«имя»), "» функции «", («функция».«имя»), "»"] по ""))
  пусть «строки» равно [
    (соединить [«отступ», "# постусловие «", («постусловие».«имя»), "»"] по ""),
    (соединить [«отступ», "if not Flang.Rt.post(", («проверка».«значение»), ", ", («Строка Elixir» от («постусловие».«имя»)), ", ", («Строка Elixir» от («функция».«имя»)), ") do"] по ""),
    (соединить [«отступ», "  raise Flang.Rt.fail(", («Строка Elixir» от («постусловие».«код»)), ", ", («Строка Elixir» от «сообщение»), ")"] по ""),
    (соединить «отступ» с "end"),
    "",
    (соединить «отступ» с «результат»)
  ]
  запись «Блок» с «состояние» равным («проверка».«состояние») и «вывод» равным («Слить списки строк» от («проверка».«вывод») и «строки»)

функция «Тело с постусловиями»
  принимает «функция»: «Функция», «контекст»: «Контекст», «блок»: «Блок», «отступ»: строка
  возвращает «Блок»
  пусть «значение» равно («Печать значения» от («функция».«тело») и «контекст» и «блок» и «отступ»)
  пусть «свежее» равно («Временное» от («значение».«состояние»))
  пусть «результат» равно («свежее».«имя»)
  пусть «строка» равно (соединить [«отступ», «результат», " = ", («значение».«значение»)] по "")
  пусть «начало» равно (запись «Блок» с «состояние» равным («свежее».«состояние») и «вывод» равным (добавить «строка» к («значение».«вывод»)))
  свёртка («функция».«постусловия») начиная с «начало» как «акк» и «постусловие» → «Шаг постусловия» от «акк» и «постусловие» и «результат» и «контекст» и «функция» и «отступ»

функция «Тело функции»
  принимает «функция»: «Функция», «контекст»: «Контекст», «блок»: «Блок»
  возвращает «Блок»
  если (длина («функция».«постусловия»)) больше 0
    то «Тело с постусловиями» от «функция» и «контекст» и «блок» и "    "
    иначе «Печать хвоста» от («функция».«тело») и «контекст» и «блок» и "    "

// ═══════════════════════════ строки документации ═══════════════════════════

// Имя модели внутри @doc не имеет права закрыть строку документации. Порядок
// замен здесь значим и повторяет эталон: сперва тройная кавычка, потом слеш, —
// поэтому слеши, добавленные первой заменой, удваиваются второй.
тотальная функция «Экранировать доку»
  принимает «значение»: строка
  возвращает строка
  пусть «без тройной» равно («Заменить всё» от «значение» и "\"\"\"" и "\\\"\\\"\\\"")
  «Заменить всё» от «без тройной» и "\\" и "\\\\"

тотальная функция «Строка доки»
  принимает «строка»: строка, «отступ»: строка
  возвращает строка
  пусть «безопасная» равно («Экранировать доку» от «строка»)
  если (длина «безопасная») равен 0
    то ""
    иначе соединить «отступ» с «безопасная»

тотальная функция «Печать доки»
  принимает «строки»: список строки, «отступ»: строка
  возвращает список строки
  пусть «шапка» равно [(соединить «отступ» с "@doc \"\"\"")]
  пусть «тело» равно (отобразить «строки» как «строка» → «Строка доки» от «строка» и «отступ»)
  «Слить списки строк» от («Слить списки строк» от «шапка» и «тело») и [(соединить «отступ» с "\"\"\"")]

функция «Пометка вида типа»
  принимает «тип»: «Значение»
  возвращает строка
  разбор («Вид узла» от «тип»)
    случай "string"
      то ": строка"
    случай "number"
      то ": число"
    случай "boolean"
      то ": признак"
    случай "nothing"
      то ": ничто"
    случай "list"
      то соединить ": список" с («Пометка типа» от («Взять поле» от «тип» и "of"))
    случай любое
      то «Пометка имени типа» от «тип»

тотальная функция «Пометка имени типа»
  принимает «тип»: «Значение»
  возвращает строка
  если «Это строка» от («Взять поле» от «тип» и "name")
    то соединить [": «", («Строка поля» от «тип» и "name"), "»"] по ""
    иначе ""

функция «Пометка типа»
  принимает «тип»: «Значение»
  возвращает строка
  если «Это запись» от «тип»
    то «Пометка вида типа» от «тип»
    иначе ""

объект «Строки с номером»
  «индекс»: число
  «строки»: список строки

функция «Шаг параметра доки»
  принимает «акк»: «Строки с номером», «параметр»: «Параметр», «идентификаторы»: список строки
  возвращает «Строки с номером»
  пусть «строка» равно (соединить ["Параметр `", («Элемент по индексу» от «идентификаторы» и («акк».«индекс»)), "` — «", («параметр».«имя»), "»", («Пометка типа» от («параметр».«тип»)), "."] по "")
  запись «Строки с номером» с «индекс» равным ((«акк».«индекс») плюс 1) и «строки» равным (добавить «строка» к («акк».«строки»))

тотальная функция «Прочие члены»
  принимает «функция»: «Функция», «общее»: «Общее»
  возвращает строка
  пусть «прочие» равно (отфильтровать («Цели» от («общее».«циклические») и («функция».«имя»)) где «имя» → «имя» не равен («функция».«имя»))
  соединить (отобразить «прочие» как «имя» → соединить ["«", «имя», "»"] по "") по ", "

тотальная функция «Строки шага доки»
  принимает «функция»: «Функция», «общее»: «Общее»
  возвращает список строки
  пусть «шаг» равно («Шаг функции» от «общее» и («функция».«имя»))
  если «Есть члены» от «функция» и («общее».«циклические»)
    то [
      "",
      (соединить ["Взаимная хвостовая рекурсия с ", («Прочие члены» от «функция» и «общее»), ". Тело живёт отдельной функцией"] по ""),
      (соединить ["`", «шаг», "`: BEAM переиспользует кадр сам, но только"] по ""),
      "если вызов действительно хвостовой, а `try/after` вокруг тела это ломает."
    ]
    иначе [
      "",
      "Хвостовой самовызов. Ни цикла, ни батута здесь нет: BEAM переиспользует",
      (соединить ["кадр сам. Тело вынесено в `", «шаг», "` ровно затем,"] по ""),
      "чтобы `try/after` со счётчиком глубины не оказался вокруг хвостового вызова."
    ]

функция «Описание функции»
  принимает «функция»: «Функция», «общее»: «Общее»
  возвращает список строки
  пусть «шапка» равно [(соединить ["Функция flang «", («функция».«имя»), "»."] по ""), ""]
  пусть «класс» равно [(если («функция».«тотальная») то "Тотальная: завершение доказано анализом завершаемости (totality.mjs)." иначе "Обычная (не тотальная): завершение не доказано, зацикливание ловится лимитом шагов.")]
  пусть «шаги» равно (если «Есть шаг» от «общее» и («функция».«имя») то («Строки шага доки» от «функция» и «общее») иначе пустой список)
  пусть «рекурсия» равно (если («общее».«рекурсивные») содержит («функция».«имя») то ["", "Рекурсивная: считает глубину, на превышении — FLANG_RECURSION_LIMIT."] иначе пустой список)
  пусть «идентификаторы» равно («Идентификаторы для» от («общее».«ид параметров») и («функция».«имя»))
  пусть «нуль» равно (запись «Строки с номером» с «индекс» равным 0 и «строки» равным [""])
  пусть «параметры» равно (свёртка («функция».«параметры») начиная с «нуль» как «акк» и «параметр» → «Шаг параметра доки» от «акк» и «параметр» и «идентификаторы»)
  пусть «возврат» равно [(соединить ["Результат — значение", («Пометка типа» от («функция».«возвращает»)), "."] по "")]
  пусть «до параметров» равно («Слить списки строк» от («Слить списки строк» от («Слить списки строк» от «шапка» и «класс») и «шаги») и «рекурсия»)
  «Слить списки строк» от («Слить списки строк» от «до параметров» и («параметры».«строки»)) и «возврат»

// ═══════════════════════════ фабрики записей и вариантов ═══════════════════════════

тотальная функция «Перечень имён»
  принимает «имена»: список строки
  возвращает строка
  если пусто «имена»
    то "без полей"
    иначе соединить (отобразить «имена» как «имя» → соединить ["«", «имя», "»"] по "") по ", "

функция «Печать фабрики»
  принимает «запись»: «Запись типа», «общее»: «Общее»
  возвращает строка
  пусть «имена» равно («Имена полей типа» от («запись».«поля»))
  пусть «идентификаторы» равно («Уникальные имена» от «имена» и («общее».«глобальные»))
  пусть «дока» равно («Печать доки» от [
      (соединить ["Запись FTS «", («запись».«имя»), "»: ", («Перечень имён» от «имена»), "."] по ""),
      "",
      "Запись flang тотальна: пропущенное поле — это «ничто», а не дырка.",
      "Поля — список пар, а не Map: их порядок наблюдаем в диагностиках."
    ] и "  ")
  пусть «строки» равно [
    (соединить ["  def ", («Значение по ключу» от («общее».«ид фабрик») и («запись».«имя»)), "(", (соединить «идентификаторы» по ", "), ") do"] по ""),
    (соединить "    " с («Собрать поля Elixir» от «имена» и «идентификаторы» и нет и "")),
    "  end"
  ]
  «Склеить строки» от («Слить списки строк» от «дока» и «строки»)

функция «Печать конструктора варианта»
  принимает «вариант»: «Вариант типа», «сумма»: строка, «общее»: «Общее»
  возвращает строка
  пусть «имена» равно («Имена полей типа» от («вариант».«поля»))
  пусть «идентификаторы» равно («Уникальные имена» от «имена» и («общее».«глобальные»))
  пусть «дока» равно («Печать доки» от [
      (соединить ["Вариант «", («вариант».«имя»), "» суммы типов «", «сумма», "»."] по ""),
      "",
      "Дискриминант — имя варианта; проверяется через `Flang.Rt.variant_is?/2`.",
      "Структурой Elixir вариант не сделан намеренно: дискриминант в flang именной,",
      "и литерал `{variant, fields}` из JSON статического типа не имеет вовсе.",
      "Приставка `v_` в имени — это роль: у функции flang с тем же именем",
      "идентификатор начинается с `fn_`, и одно определение не съедает другое."
    ] и "  ")
  пусть «строки» равно [
    (соединить ["  def ", («Значение по ключу» от («общее».«ид вариантов») и («вариант».«имя»)), "(", (соединить «идентификаторы» по ", "), ") do"] по ""),
    (соединить "    " с («Собрать поля Elixir» от «имена» и «идентификаторы» и да и («вариант».«имя»))),
    "  end"
  ]
  «Склеить строки» от («Слить списки строк» от «дока» и «строки»)

// ═══════════════════════════ оболочки функции ═══════════════════════════

тотальная функция «Простая функция»
  принимает «функция»: «Функция», «общее»: «Общее», «тело»: список строки, «параметры»: список строки, «дока»: список строки
  возвращает строка
  пусть «шапка» равно [(соединить ["  def ", («Идентификатор функции» от «общее» и («функция».«имя»)), "(", (соединить «параметры» по ", "), ") do"] по "")]
  «Склеить строки» от («Слить списки строк» от («Слить списки строк» от («Слить списки строк» от «дока» и «шапка») и «тело») и ["  end"])

// Счётчик глубины обязан уменьшаться и на ошибке, иначе первая же пойманная
// ошибка навсегда съела бы предел; enter вне try намеренно — если он сам
// возбудил FLANG_RECURSION_LIMIT, входа не было, и выхода быть не должно.
тотальная функция «Функция со счётчиком»
  принимает «функция»: «Функция», «общее»: «Общее», «тело»: список строки, «параметры»: список строки, «дока»: список строки
  возвращает строка
  пусть «шапка» равно [
    (соединить ["  def ", («Идентификатор функции» от «общее» и («функция».«имя»)), "(", (соединить «параметры» по ", "), ") do"] по ""),
    (соединить ["    Flang.Rt.enter(", («Строка Elixir» от («функция».«имя»)), ")"] по ""),
    "",
    "    try do"
  ]
  пусть «сдвинутое» равно (отобразить «тело» как «строка» → «Сдвинуть строку» от «строка»)
  пусть «хвост» равно ["    after", "      Flang.Rt.leave()", "    end", "  end"]
  «Склеить строки» от («Слить списки строк» от («Слить списки строк» от («Слить списки строк» от «дока» и «шапка») и «сдвинутое») и «хвост»)

тотальная функция «Обёртка шага со счётчиком»
  принимает «имя»: строка, «шаг»: строка, «все»: строка, «название»: строка
  возвращает список строки
  [
    (соединить ["  def ", «имя», "(", «все», ") do"] по ""),
    (соединить ["    Flang.Rt.enter(", («Строка Elixir» от «название»), ")"] по ""),
    "",
    "    try do",
    (соединить ["      ", «шаг», "(", «все», ")"] по ""),
    "    after",
    "      Flang.Rt.leave()",
    "    end",
    "  end"
  ]

тотальная функция «Обёртка шага простая»
  принимает «имя»: строка, «шаг»: строка, «все»: строка
  возвращает список строки
  [
    (соединить ["  def ", «имя», "(", «все», ") do"] по ""),
    (соединить ["    ", «шаг», "(", «все», ")"] по ""),
    "  end"
  ]

тотальная функция «Обёртка шага»
  принимает «функция»: «Функция», «общее»: «Общее», «имя»: строка, «шаг»: строка, «все»: строка
  возвращает список строки
  если («общее».«рекурсивные») содержит («функция».«имя»)
    то «Обёртка шага со счётчиком» от «имя» и «шаг» и «все» и («функция».«имя»)
    иначе «Обёртка шага простая» от «имя» и «шаг» и «все»

// Тело живёт отдельной приватной функцией: хвостовой вызов внутри неё остаётся
// хвостовым, и BEAM переиспользует кадр. Обёртка со счётчиком глубины сюда не
// попадает — иначе хвостовой вызов перестал бы им быть.
тотальная функция «Функция с шагом»
  принимает «функция»: «Функция», «общее»: «Общее», «контекст»: «Контекст», «тело»: список строки, «параметры»: список строки, «дока»: список строки
  возвращает строка
  пусть «шаг» равно («Шаг функции» от «общее» и («функция».«имя»))
  пусть «все» равно (соединить («контекст».«параметры») по ", ")
  пусть «имя» равно («Идентификатор функции» от «общее» и («функция».«имя»))
  пусть «блок шага» равно («Склеить строки» от («Слить списки строк» от («Слить списки строк» от [(соединить ["  defp ", «шаг», "(", (соединить «параметры» по ", "), ") do"] по "")] и «тело») и ["  end"]))
  пусть «обёртка» равно («Обёртка шага» от «функция» и «общее» и «имя» и «шаг» и «все»)
  соединить [(«Склеить строки» от («Слить списки строк» от «дока» и «обёртка»)), "\n\n", «блок шага»] по ""

функция «Оболочка функции»
  принимает «функция»: «Функция», «общее»: «Общее», «контекст»: «Контекст», «тело»: список строки, «параметры»: список строки, «дока»: список строки
  возвращает строка
  если «Есть шаг» от «общее» и («функция».«имя»)
    то «Функция с шагом» от «функция» и «общее» и «контекст» и «тело» и «параметры» и «дока»
    иначе
      если («общее».«рекурсивные») содержит («функция».«имя»)
        то «Функция со счётчиком» от «функция» и «общее» и «тело» и «параметры» и «дока»
        иначе «Простая функция» от «функция» и «общее» и «тело» и «параметры» и «дока»

// Неиспользованный параметр в Elixir — предупреждение, а под
// --warnings-as-errors отказ сборки. Приставка «_» — принятая здесь форма
// «получено и намеренно не использовано».
функция «Печать функции»
  принимает «функция»: «Функция», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Кусок»
  пусть «контекст» равно («Начальный контекст» от «функция» и «общее»)
  пусть «чистое» равно («Начальное взятое» от «состояние» и «общее» и («контекст».«параметры»))
  пусть «тело» равно («Тело функции» от «функция» и «контекст» и (запись «Блок» с «состояние» равным «чистое» и «вывод» равным пустой список))
  пусть «текст тела» равно («Склеить строки» от («тело».«вывод»))
  пусть «параметры» равно (отобразить («контекст».«параметры») как «параметр» → «Гасимое имя» от «параметр» и «текст тела»)
  пусть «дока» равно («Печать доки» от («Описание функции» от «функция» и «общее») и "  ")
  запись «Кусок» с «состояние» равным («тело».«состояние») и «текст» равным («Оболочка функции» от «функция» и «общее» и «контекст» и («тело».«вывод») и «параметры» и «дока»)

// ═══════════════════════════ вызов по имени ═══════════════════════════

тотальная функция «Шаг аргумента диспетчера»
  принимает «зип»: «Зип», «параметр»: «Параметр»
  возвращает «Зип»
  пусть «часть» равно (соединить ["Enum.at(args, ", (к строке («зип».«индекс»)), ")"] по "")
  пусть «связка» равно (если («зип».«индекс») равен 0 то "" иначе ", ")
  запись «Зип» с «индекс» равным ((«зип».«индекс») плюс 1) и «текст» равным (соединить [(«зип».«текст»), «связка», «часть»] по "")

// Договор функции на двери: `требует`.
//
// Программа без единого `требует` не получает отсюда ни строки и ни одного
// временного имени — печать обязана остаться побайтово прежней.
функция «Договор на двери»
  принимает «функция»: «Функция», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  если пусто («функция».«предусловия»)
    то запись «Блок» с «состояние» равным «состояние» и «вывод» равным пустой список
    иначе «Проверки договора» от «функция» и «общее» и «состояние»

функция «Проверки договора»
  принимает «функция»: «Функция», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  пусть «контекст» равно («Контекст двери» от «функция» и «общее»)
  пусть «чистое» равно («Начальное взятое» от «состояние» и «общее» и («контекст».«параметры»))
  пусть «нуль» равно (запись «Блок» с «состояние» равным «чистое» и «вывод» равным пустой список)
  свёртка («функция».«предусловия») начиная с «нуль» как «акк» и «предусловие» → «Шаг предусловия» от «акк» и «предусловие» и «контекст» и «функция»

// Отказ у предусловия свой, и помощник у него свой — `Flang.Rt.pre` рядом с
// `Flang.Rt.post`: одно сообщение на две разные вещи разошлось бы молча.
функция «Шаг предусловия»
  принимает «блок»: «Блок», «предусловие»: «Предусловие», «контекст»: «Контекст», «функция»: «Функция»
  возвращает «Блок»
  пусть «отступ» равно "    "
  пусть «проверка» равно («Печать значения» от («предусловие».«выражение») и «контекст» и «блок» и «отступ»)
  пусть «сообщение» равно (если («предусловие».«есть сообщение») то («предусловие».«сообщение») иначе (соединить ["не выполнено требование «", («предусловие».«имя»), "» функции «", («функция».«имя»), "»"] по ""))
  пусть «строки» равно [
    (соединить [«отступ», "# требует «", («предусловие».«имя»), "»"] по ""),
    (соединить [«отступ», "if not Flang.Rt.pre(", («проверка».«значение»), ", ", («Строка Elixir» от («предусловие».«имя»)), ", ", («Строка Elixir» от («функция».«имя»)), ") do"] по ""),
    (соединить [«отступ», "  raise Flang.Rt.fail(", («Строка Elixir» от («предусловие».«код»)), ", ", («Строка Elixir» от «сообщение»), ")"] по ""),
    (соединить «отступ» с "end"),
    ""
  ]
  запись «Блок» с «состояние» равным («проверка».«состояние») и «вывод» равным («Слить списки строк» от («проверка».«вывод») и «строки»)

// Склейка, а не интерполяция: имя модели вправе содержать «#{», и подстановка
// этого бы не пережила.
//
// Порядок проверок на двери: сначала арность, потом объявленные типы (их
// сверяет прогонщик ДО `call`), и только потом договор.
функция «Ветка диспетчера»
  принимает «функция»: «Функция», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  пусть «арность» равно (к строке (длина («функция».«параметры»)))
  пусть «нуль» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
  пусть «список» равно ((свёртка («функция».«параметры») начиная с «нуль» как «акк» и «параметр» → «Шаг аргумента диспетчера» от «акк» и «параметр»).«текст»)
  пусть «сообщение» равно (соединить ["функция «", («функция».«имя»), "» принимает ", «арность», " аргум., получено "] по "")
  пусть «договор» равно («Договор на двери» от «функция» и «общее» и «состояние»)
  пусть «шапка» равно [
    (соединить ["  def call(", («Строка Elixir» от («функция».«имя»)), ", args) do"] по ""),
    (соединить ["    if length(args) != ", «арность», " do"] по ""),
    "      raise Flang.Rt.fail(",
    "        Flang.Rt.code_type(),",
    (соединить ["        ", («Строка Elixir» от «сообщение»), " <>"] по ""),
    "          Integer.to_string(length(args))",
    "      )",
    "    end",
    ""
  ]
  пусть «конец» равно [
    (соединить ["    ", («Идентификатор функции» от «общее» и («функция».«имя»)), "(", «список», ")"] по ""),
    "  end",
    ""
  ]
  запись «Блок» с «состояние» равным («договор».«состояние») и «вывод» равным («Слить списки строк» от («Слить списки строк» от «шапка» и («договор».«вывод»)) и «конец»)

функция «Шаг ветки диспетчера»
  принимает «блок»: «Блок», «функция»: «Функция», «общее»: «Общее»
  возвращает «Блок»
  пусть «ветка» равно («Ветка диспетчера» от «функция» и «общее» и («блок».«состояние»))
  запись «Блок» с «состояние» равным («ветка».«состояние») и «вывод» равным («Слить списки строк» от («блок».«вывод») и («ветка».«вывод»))

// Вызов по имени — это не вызов внутри программы, а ГРАНИЦА: внутренние вызовы
// идут прямо на функцию модуля, сюда заходит только тот, у кого имя функции
// строка.
функция «Печать диспетчера»
  принимает «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  пусть «дока» равно («Печать доки» от [
      "Вызов функции по её исходному имени flang.",
      "",
      "Нужен прогонщику и всякому, кто связывает программу с внешним миром",
      "динамически (скрипт, тест, служба). Коды и тексты — те же, что у",
      "интерпретатора: «не найдена функция …» и «функция … принимает N аргум.»."
    ] и "  ")
  пусть «начало» равно (запись «Блок» с «состояние» равным «состояние» и «вывод» равным «дока»)
  пусть «ветки» равно (свёртка («общее».«функции») начиная с «начало» как «акк» и «функция» → «Шаг ветки диспетчера» от «акк» и «функция» и «общее»)
  пусть «хвост» равно [
    "  def call(name, _args) do",
    "    raise Flang.Rt.fail(Flang.Rt.code_unknown_name(), \"не найдена функция «\" <> name <> \"»\")",
    "  end"
  ]
  запись «Блок» с «состояние» равным («ветки».«состояние») и «вывод» равным [(«Склеить строки» от («Слить списки строк» от («ветки».«вывод») и «хвост»))]

// ═══════════════════════════ файлы ═══════════════════════════

объект «Файл»
  «путь»: строка
  «содержимое»: строка

объект «Настройки»
  «путь»: строка
  «есть путь»: признак
  «база»: число
  «предел глубины»: число
  «предел шагов»: число
  «прогонщик»: признак
  «рантайм исходник»: строка
  «исходник прогонщика»: строка
  «исходник конкурентности»: строка

объект «Итог печати»
  «файлы»: список «Файл»
  «ошибка»: строка

объект «Тела»
  «состояние»: «Состояние»
  «части»: список строки

тотальная функция «Шапка файла»
  принимает «есть модуль»: признак, «модуль»: строка, «что»: строка
  возвращает строка
  «Склеить строки» от [
    "# Сгенерировано flang (бэкенд Elixir, flang/src/emit/elixir.mjs). Не редактировать руками.",
    (если «есть модуль» то (соединить ["# Модуль flang: «", «модуль», "»."] по "") иначе "# Программа flang без имени модуля."),
    (соединить ["# Файл: ", «что», "."] по ""),
    "# Правьте исходник на flang и печатайте заново: любая правка здесь потеряется."
  ]

тотальная функция «Печать контекста»
  принимает «база»: число, «глубина»: число, «шаги»: число
  возвращает строка
  «Склеить строки» от [
    "  @doc \"\"\"",
    "  Готовит контекст вычисления с настройками этой программы.",
    "",
    "  Индексация строк, предел глубины вызовов и лимит шагов — это настройки",
    "  программы, а не рантайма: печать могла идти с нулевой базой индексации, а",
    "  пределы вызывающий вправе поменять через `Flang.Rt.set_max_depth/1` и",
    "  `Flang.Rt.set_max_steps/1`.",
    "",
    "  Счётчики при этом обнуляются, поэтому вызывать её нужно перед каждым",
    "  самостоятельным вычислением, а не один раз на процесс.",
    "  \"\"\"",
    "  def new_context do",
    (соединить ["    Flang.Rt.new_context(", (к строке «база»), ", ", (к строке «глубина»), ", ", (к строке «шаги»), ")"] по ""),
    "  end"
  ]

тотальная функция «Шапка модуля»
  принимает «есть модуль»: признак, «модуль»: строка, «псевдоним»: строка
  возвращает строка
  «Склеить строки» от [
    («Шапка файла» от «есть модуль» и «модуль» и "реализация: функции, конструкторы значений, вызов по имени"),
    "",
    (соединить ["defmodule ", «псевдоним», " do"] по ""),
    "  @moduledoc \"\"\"",
    (если «есть модуль» то (соединить ["  Модуль flang «", («Экранировать доку» от «модуль»), "», напечатанный в Elixir."] по "") иначе "  Программа flang, напечатанная в Elixir."),
    "",
    "  Контракт вызова: функция возвращает значение либо возбуждает `Flang.Error` с",
    "  кодом и текстом, дословно совпадающими с интерпретатором flang. Все значения",
    "  — размеченные кортежи `Flang.Rt`: число там всегда `float()` либо один из",
    "  атомов `:nan`, `:inf`, `:ninf` (на BEAM таких значений с плавающей точкой не",
    "  существует), признак отличается от числа тегом, а равенство скаляров —",
    "  Object.is, а не `===`.",
    "",
    "  Пределы вычисления живут в словаре процесса и обнуляются `new_context/0`:",
    "  вызывать её обязан всякий, кто начинает новое вычисление.",
    "  \"\"\""
  ]

тотальная функция «Исходник модуля»
  принимает «шапка»: строка, «тела»: список строки
  возвращает строка
  пусть «непустые» равно (отфильтровать «тела» где «тело» → (длина «тело») больше 0)
  пусть «части» равно («Слить списки строк» от («Слить списки строк» от [«шапка»] и «непустые») и ["end"])
  соединить (соединить «части» по "\n\n") с "\n"

тотальная функция «Печать Makefile»
  принимает «псевдоним»: строка, «файл»: строка, «прогонщик»: признак, «конкурентно»: признак
  возвращает строка
  пусть «сборка» равно (соединить ["\t$(ELIXIRC) $(ELIXIRCFLAGS) -o _build flang_runtime.ex", (если «конкурентно» то " flang_conc.ex" иначе ""), " ", «файл», ".ex", (если «прогонщик» то " flang_cli.ex" иначе "")] по "")
  пусть «шапка» равно [
    "# Сгенерировано flang (бэкенд Elixir). Целей ровно столько, сколько нужно:",
    "# напечатанный код обязан собираться и запускаться без единой правки.",
    "#",
    "# mix здесь не нужен: зависимостей нет ни одной, а mix.exs потребовал бы",
    "# структуры проекта там, где хватает трёх файлов рядом.",
    "ELIXIRC ?= elixirc",
    "ELIXIR ?= elixir",
    (соединить "MODULE ?= " с «псевдоним»),
    "",
    "# --warnings-as-errors — не придирка: связанное, но не использованное имя",
    "# в Elixir даёт предупреждение, и напечатанный код обязан быть чистым.",
    "ELIXIRCFLAGS ?= --warnings-as-errors",
    "",
    "all: build",
    "",
    "build:",
    "\tmkdir -p _build",
    «сборка»,
    ""
  ]
  пусть «прогон» равно (если «прогонщик» то ["run: build", "\t$(ELIXIR) -pa _build -e 'Flang.Cli.main([\"$(MODULE)\"])'", ""] иначе пустой список)
  пусть «хвост» равно ["clean:", "\trm -rf _build", "", (соединить [".PHONY: all build", (если «прогонщик» то " run" иначе ""), " clean"] по ""), ""]
  «Склеить строки» от («Слить списки строк» от («Слить списки строк» от «шапка» и «прогон») и «хвост»)

// ═══════════════════════════ конкурентность ═══════════════════════════
//
// Процессы, надзоры и прогоны печатаются ДАННЫМИ — одной функцией `conc_plan/0`.
// Дерево супервизоров OTP строит из них рантайм (flang_conc.ex): надзор в flang
// — объявление, и одно объявление обязано остаться одним местом в напечатанном
// коде. Печать готовых `defmodule … use Supervisor` размазала бы его по трём
// модулям, и правка строки в исходнике перестала бы читаться как правка одной
// строки на выходе.

тотальная функция «Это число в скаляре»
  принимает «скаляр»: «Скаляр»
  возвращает признак
  разбор «скаляр»
    случай вариант «Скаляр число» с «значение» как «значение»
      то да
    случай любое
      то нет

тотальная функция «Это число»
  принимает «узел»: «Значение»
  возвращает признак
  разбор «узел»
    случай вариант «Значение скаляра» с «скаляр» как «скаляр»
      то «Это число в скаляре» от «скаляр»
    случай любое
      то нет

тотальная функция «Не конечное»
  принимает «значение»: число
  возвращает признак
  пусть «текст» равно (к строке «значение»)
  если «текст» равен "NaN"
    то да
    иначе
      если «текст» равен "Infinity"
        то да
        иначе «текст» равен "-Infinity"

// `Number.isFinite` эталона: и не число, и NaN, и бесконечность — не в счёт.
тотальная функция «Это конечное число»
  принимает «узел»: «Значение»
  возвращает признак
  если «Это число» от «узел»
    то (если «Не конечное» от («Число узла» от «узел») то нет иначе да)
    иначе нет

// `Math.trunc` эталона — сразу в записи, потому что печатается именно она.
тотальная функция «Целая часть»
  принимает «значение»: число
  возвращает строка
  пусть «текст» равно (к строке «значение»)
  если «текст» содержит "."
    то «Элемент по индексу» от (разделить «текст» по ".") и 0
    иначе «текст»

// Ограниченный ящик в BEAM не ложится ни на что, и печатать здесь что-нибудь
// похожее было бы враньём: ящик процесса BEAM неограничен устройством машины, а
// `отправить` там не может отказать. Поэтому печать отказывается, а не
// выдумывает.
тотальная функция «Ошибка ящика»
  принимает «состояние»: «Состояние», «процесс»: «Значение»
  возвращает «Состояние»
  пусть «ящик» равно («Взять поле» от «процесс» и "mailbox")
  если «Это конечное число» от «ящик»
    то
      если («Число узла» от «ящик») больше 0
        то «Записать ошибку» от «состояние» и (соединить ["процесс «", («Строка поля» от «процесс» и "name"), "» объявил ящик на ", («Целая часть» от («Число узла» от «ящик»)), " сообщений, а у процесса BEAM ящик неограничен и «отправить» там отказать не может: печати в Elixir у ограниченного ящика нет"] по "")
        иначе «состояние»
    иначе «состояние»

// Запас витков ставится ТОЛЬКО нетотальному обработчику: про тотальный
// доказано, что он завершится, и считать ему нечего — ровно так же решает
// планировщик эталона, и разойтись здесь было бы нельзя.
тотальная функция «Запись процесса»
  принимает «процесс»: «Значение», «тотальные»: список строки
  возвращает строка
  пусть «обработчик» равно («Строка поля» от «процесс» и "handler")
  пусть «тотальный» равно («тотальные» содержит «обработчик»)
  пусть «запас» равно («Взять поле» от «процесс» и "budget")
  пусть «текст запаса» равно (если «тотальный» то "nil" иначе (если «Это конечное число» от «запас» то («Целая часть» от («Число узла» от «запас»)) иначе "nil"))
  «Склеить строки» от [
    "        %{",
    (соединить ["          name: ", («Строка Elixir» от («Строка поля» от «процесс» и "name")), ","] по ""),
    (соединить ["          handler: ", («Строка Elixir» от «обработчик»), ","] по ""),
    (соединить ["          initial: ", («Строка Elixir» от («Строка поля» от «процесс» и "initial")), ","] по ""),
    (соединить ["          total: ", (если «тотальный» то "true" иначе "false"), ","] по ""),
    (соединить ["          budget: ", «текст запаса»] по ""),
    "        }"
  ]

тотальная функция «Порог надзора»
  принимает «надзор»: «Значение»
  возвращает строка
  пусть «порог» равно («Взять поле» от «надзор» и "threshold")
  если «Это запись» от «порог»
    то соединить ["%{failures: ", («Целая часть» от («Число узла» от («Взять поле» от «порог» и "failures"))), ", window: ", («Целая часть» от («Число узла» от («Взять поле» от «порог» и "window"))), ", otherwise: ", («Строка Elixir» от («Строка поля» от «порог» и "otherwise")), "}"] по ""
    иначе "nil"

тотальная функция «Запись надзора»
  принимает «надзор»: «Значение»
  возвращает строка
  пусть «дети» равно (соединить (отобразить («Элементы поля» от «надзор» и "watch") как «п» → соединить ["{", («Строка Elixir» от («Строка поля» от «п» и "process")), ", ", («Строка Elixir» от («Строка поля» от «п» и "strategy")), "}"] по "") по ", ")
  пусть «вложенные» равно (соединить (отобразить («Элементы поля» от «надзор» и "nested") как «п» → соединить ["{", («Строка Elixir» от («Строка поля» от «п» и "supervisor")), ", ", («Строка Elixir» от («Строка поля» от «п» и "strategy")), "}"] по "") по ", ")
  «Склеить строки» от [
    "        %{",
    (соединить ["          name: ", («Строка Elixir» от («Строка поля» от «надзор» и "name")), ","] по ""),
    (соединить ["          watch: [", «дети», "],"] по ""),
    (соединить ["          nested: [", «вложенные», "],"] по ""),
    (соединить ["          threshold: ", («Порог надзора» от «надзор»)] по ""),
    "        }"
  ]

объект «Сообщения прогона»
  «блок»: «Блок»
  «части»: список строки

функция «Шаг сообщения»
  принимает «акк»: «Сообщения прогона», «сообщение»: «Значение»
  возвращает «Сообщения прогона»
  пусть «итог» равно («Печать литерала» от («Взять поле» от «сообщение» и "message") и («акк».«блок») и "    ")
  пусть «часть» равно (соединить ["{", («Строка Elixir» от («Строка поля» от «сообщение» и "process")), ", ", («итог».«значение»), "}"] по "")
  запись «Сообщения прогона» с «блок» равным («Блок итога» от «итог») и «части» равным (добавить «часть» к («акк».«части»))

// Входные сообщения прогона — отдельной приватной функцией на прогон. Литерал
// значения печатается тем же «Печать литерала», что и всюду: сообщение прогона
// — обычное значение языка.
функция «Печать ящика прогона»
  принимает «прогон»: «Значение», «номер»: число, «блок»: «Блок»
  возвращает «Кусок»
  пусть «идентификатор» равно (соединить "conc_inbox_" с (к строке «номер»))
  пусть «нуль» равно (запись «Сообщения прогона» с «блок» равным (запись «Блок» с «состояние» равным («блок».«состояние») и «вывод» равным пустой список) и «части» равным пустой список)
  пусть «собрано» равно (свёртка («Элементы поля» от «прогон» и "inbox") начиная с «нуль» как «акк» и «сообщение» → «Шаг сообщения» от «акк» и «сообщение»)
  пусть «шапка» равно [
    (соединить ["  # входные сообщения прогона «", («Строка поля» от «прогон» и "name"), "»"] по ""),
    (соединить ["  defp ", «идентификатор», " do"] по "")
  ]
  пусть «с запятыми» равно («Строки ящика» от («собрано».«части»))
  запись «Кусок» с «состояние» равным ((«собрано».«блок»).«состояние») и «текст» равным («Склеить строки» от («Слить списки строк» от («Слить списки строк» от («Слить списки строк» от «шапка» и ((«собрано».«блок»).«вывод»)) и «с запятыми») и ["  end"]))

тотальная функция «Строки ящика»
  принимает «части»: список строки
  возвращает список строки
  пусть «внутри» равно (отобразить «части» как «часть» → соединить "      " с «часть»)
  если пусто «части»
    то ["    []"]
    иначе «Расставить запятые» от («Слить списки строк» от («Слить списки строк» от ["    ["] и «внутри») и ["    ]"])

// Все элементы списка, кроме последнего, кончаются запятой; строки «    [» и
// «    ]» запятых не получают.
тотальная функция «Шаг запятой»
  принимает «акк»: «Строки с индексом», «строка»: строка, «предел»: число
  возвращает «Строки с индексом»
  пусть «нужна» равно (если («акк».«индекс») больше 0 то (если ((«акк».«индекс») плюс 1) меньше «предел» то да иначе нет) иначе нет)
  пусть «итог» равно (если «нужна» то (соединить «строка» с ",") иначе «строка»)
  запись «Строки с индексом» с «индекс» равным ((«акк».«индекс») плюс 1) и «строки» равным (добавить «итог» к («акк».«строки»))

тотальная функция «Расставить запятые»
  принимает «строки»: список строки
  возвращает список строки
  пусть «нуль» равно (запись «Строки с индексом» с «индекс» равным 0 и «строки» равным пустой список)
  пусть «итог» равно (свёртка «строки» начиная с «нуль» как «акк» и «строка» → «Шаг запятой» от «акк» и «строка» и ((длина «строки») минус 1))
  «итог».«строки»

объект «Ящики»
  «состояние»: «Состояние»
  «части»: список строки
  «записи»: список строки
  «номер»: число

функция «Шаг ящика»
  принимает «акк»: «Ящики», «прогон»: «Значение»
  возвращает «Ящики»
  пусть «номер» равно ((«акк».«номер») плюс 1)
  пусть «кусок» равно («Печать ящика прогона» от «прогон» и «номер» и (запись «Блок» с «состояние» равным («акк».«состояние») и «вывод» равным пустой список))
  пусть «запись» равно (соединить ["        %{name: ", («Строка Elixir» от («Строка поля» от «прогон» и "name")), ", inbox: conc_inbox_", (к строке «номер»), "()}"] по "")
  запись «Ящики» с «состояние» равным («кусок».«состояние») и «части» равным (добавить («кусок».«текст») к («акк».«части»)) и «записи» равным (добавить «запись» к («акк».«записи»)) и «номер» равным «номер»

тотальная функция «Список записей»
  принимает «записи»: список строки, «имя»: строка, «хвост»: строка
  возвращает строка
  если пусто «записи»
    то соединить ["      ", «имя», ": []", «хвост»] по ""
    иначе соединить ["      ", «имя», ": [\n", (соединить «записи» по ",\n"), "\n      ]", «хвост»] по ""

функция «Печать плана»
  принимает «процессы»: список строки, «надзоры»: список строки, «прогоны»: список строки
  возвращает строка
  пусть «дока» равно («Печать доки» от [
      "Процессы, надзоры и прогоны программы — данными.",
      "",
      "Отсюда `Flang.Conc` строит дерево супервизоров OTP: процесс становится",
      "GenServer, надзор — супервизором (а точнее, тремя: у OTP интенсивность",
      "перезапусков принадлежит супервизору, а в flang стратегия названа за",
      "каждым ребёнком по отдельности — см. flang_conc.ex).",
      "",
      "Запас витков стоит только у нетотального обработчика: про тотальный",
      "завершение доказано, и считать ему нечего."
    ] и "  ")
  пусть «строки» равно [
    "  def conc_plan do",
    "    %{",
    (соединить ["      processes: [\n", (соединить «процессы» по ",\n"), "\n      ],"] по ""),
    («Список записей» от «надзоры» и "supervisors" и ","),
    («Список записей» от «прогоны» и "runs" и ""),
    "    }",
    "  end"
  ]
  «Склеить строки» от («Слить списки строк» от «дока» и «строки»)

тотальная функция «Печать подъёма»
  возвращает строка
  пусть «дока» равно («Печать доки» от [
      "Поднимает дерево процессов и надзоров и возвращает корневой супервизор.",
      "",
      "Это точка входа для настоящей работы: дальше программа живёт сама, а",
      "сообщения ей шлют через `Flang.Conc.send_to/2` либо прямо в почтовый ящик",
      "процесса BEAM. Дерево связывается с тем, кто позвал."
    ] и "  ")
  «Склеить строки» от («Слить списки строк» от «дока» и ["  def conc_start do", "    Flang.Conc.start(__MODULE__)", "  end"])

тотальная функция «Печать прогона»
  возвращает строка
  пусть «дока» равно («Печать доки» от [
      "Один прогон программы: поднять дерево, разнести входные сообщения,",
      "дождаться покоя, снять итог, погасить дерево.",
      "",
      "Ожидания прогона (`ожидается …`) сюда не напечатаны намеренно: они про",
      "одно чередование, выбранное семенем, а на BEAM чередование выбирает",
      "планировщик машины, и любое из возможных законно. Сверка идёт по НАБОРУ",
      "исходов и живёт в тесте печати, а не в напечатанной программе."
    ] и "  ")
  «Склеить строки» от («Слить списки строк» от «дока» и ["  def conc_run(name) do", "    Flang.Conc.run(__MODULE__, name)", "  end"])

функция «Печать конкурентности»
  принимает «программа»: «Значение», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Тела»
  пусть «процессы» равно («Элементы поля» от «программа» и "processes")
  пусть «тотальные» равно (отобразить (отфильтровать («общее».«функции») где «функция» → «функция».«тотальная») как «функция» → «функция».«имя»)
  пусть «с ящиками» равно (свёртка «процессы» начиная с «состояние» как «акк» и «процесс» → «Ошибка ящика» от «акк» и «процесс»)
  пусть «нуль» равно (запись «Ящики» с «состояние» равным «с ящиками» и «части» равным пустой список и «записи» равным пустой список и «номер» равным 0)
  пусть «ящики» равно (свёртка («Элементы поля» от «программа» и "runs") начиная с «нуль» как «акк» и «прогон» → «Шаг ящика» от «акк» и «прогон»)
  пусть «записи процессов» равно (отобразить «процессы» как «процесс» → «Запись процесса» от «процесс» и «тотальные»)
  пусть «записи надзоров» равно (отобразить («Элементы поля» от «программа» и "supervisors") как «надзор» → «Запись надзора» от «надзор»)
  пусть «план» равно («Печать плана» от «записи процессов» и «записи надзоров» и («ящики».«записи»))
  пусть «части» равно («Слить списки строк» от («Слить списки строк» от [«план»] и («ящики».«части»)) и [«Печать подъёма», «Печать прогона»])
  запись «Тела» с «состояние» равным («ящики».«состояние») и «части» равным «части»

