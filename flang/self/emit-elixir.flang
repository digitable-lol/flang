  ["Flang", "Flang.Rt", "Flang.Error", "Flang.Cli", "Flang.Json", "Flang.Proc", "Flang.Conc"]

// Роль обязана входить в идентификатор: модуль Elixir — одно пространство имён,
// и вариант «Значение операнда» с функцией «Значение операнда» (в ядре FTS есть
// и то, и другое) при одной арности дали бы две клаузы одной функции, из
// которых уцелела бы вторая.
тотальная функция «Приставка роли Elixir»
  принимает «роль»: строка
  возвращает строка
  обеспечивает «приставка роли функции — fn_» если «роль» равен "function" то результат равен "fn_" иначе да
  разбор «роль»
    случай "function"
      то "fn_"
    случай "variant"
      то "v_"
    случай "record"
      то "rec_"
    случай любое
      то "loop_"

тотальная функция «Название роли Elixir»
  принимает «роль»: строка
  возвращает строка
  обеспечивает «роль function зовётся функцией» если «роль» равен "function" то результат равен "функции" иначе да
  разбор «роль»
    случай "function"
      то "функции"
    случай "variant"
      то "конструктора варианта"
    случай "record"
      то "фабрики записи"
    случай любое
      то "тела рекурсивной функции"

