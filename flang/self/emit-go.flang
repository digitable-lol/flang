// Счётчик глубины обязан уменьшаться и на ошибке — в Go для этого есть defer,
// и отдельная внутренняя функция, без которой не обходится C, здесь не нужна.
тотальная функция «Вход в функцию Go»
  принимает «имя»: строка
  возвращает строка
  соединить [(«Строка вывода» от «Таб» и (соединить ["if err := ctx.Enter(", («Строка Go» от «имя»), "); err != nil {"] по "")), («Строка вывода» от (соединить «Таб» с «Таб») и "return rt.Value{}, err"), («Строка вывода» от «Таб» и "}"), («Строка вывода» от «Таб» и "defer ctx.Leave()")] по ""

