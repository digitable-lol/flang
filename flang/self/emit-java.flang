  пусть «объявления» равно (соединить («Строка вывода Java» от «отступ» и (соединить ["java.util.ArrayList<Value> ", «набор», " = new java.util.ArrayList<>(", («список».«значение»), ".length);"] по "")) с («Строка вывода Java» от «отступ» и (соединить ["for (Value ", «имя элемента», " : ", («список».«значение»), ") {"] по "")))
  пусть «внутри» равно (соединить «отступ» с "  ")
  пусть «с элементом» равно («Связать имя Java» от «контекст» и «элемент» и «имя элемента»)
  пусть «тело» равно («Тело цикла Java» от «узел» и «отображение» и «набор» и «имя элемента» и «с элементом» и («свежий элемент».«состояние») и «внутри»)
  пусть «вывод» равно (соединить [(«по».«вывод»), («список».«вывод»), «объявления», («тело».«вывод»), («Строка вывода Java» от «отступ» и "}")] по "")
  запись «Итог Java» с «состояние» равным («тело».«состояние») и «вывод» равным «вывод» и «значение» равным (соединить ["Value.list(", «набор», ".toArray(new Value[0]))"] по "")

// Тело фильтра — предикат: для отброшенных элементов ничего больше не
// вычисляется.
функция «Тело цикла Java»
  принимает «узел»: «Значение», «отображение»: признак, «набор»: строка, «имя элемента»: строка, «контекст»: «Контекст Java», «состояние»: «Состояние Java», «внутри»: строка
  возвращает «Блок Java»
  обеспечивает «отображение копит, отбор сперва спрашивает Flang.keep» если «отображение» то результат.«вывод» содержит ".add(" иначе результат.«вывод» содержит "Flang.keep(ctx, "
  если «отображение»
    то
      пусть «итог» равно («Печать значения Java» от («Взять поле Java» от «узел» и "body") и «контекст» и «состояние» и «внутри»)
      запись «Блок Java» с «состояние» равным («итог».«состояние») и «вывод» равным (соединить («итог».«вывод») с («Строка вывода Java» от «внутри» и (соединить [«набор», ".add(", («итог».«значение»), ");"] по "")))
    иначе
      пусть «флаг» равно («Печать значения Java» от («Взять поле Java» от «узел» и "body") и «контекст» и «состояние» и «внутри»)
      пусть «строки» равно (соединить [(«Строка вывода Java» от «внутри» и (соединить ["if (Flang.keep(ctx, ", («флаг».«значение»), ")) {"] по "")), («Строка вывода Java» от «внутри» и (соединить ["  ", «набор», ".add(", «имя элемента», ");"] по "")), («Строка вывода Java» от «внутри» и "}")] по "")
      запись «Блок Java» с «состояние» равным («флаг».«состояние») и «вывод» равным (соединить («флаг».«вывод») с «строки»)

функция «Печать значения Java»
  принимает «узел»: «Значение», «контекст»: «Контекст Java», «состояние»: «Состояние Java», «отступ»: строка
  возвращает «Итог Java»
  обеспечивает «узел вида var печатается печатью переменной» если («Вид узла Java» от «узел») равен "var" то результат равен («Печать переменной Java» от «узел» и «контекст» и «состояние») иначе да
  разбор («Вид узла Java» от «узел»)
    случай "literal"
      то «Печать литерала Java» от («Взять поле Java» от «узел» и "value") и «контекст» и «состояние» и «отступ»
    случай "var"
      то «Печать переменной Java» от «узел» и «контекст» и «состояние»
    случай "field"
      то «Печать поля записи Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "let"
      то «Печать пусть Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "if"
      то «Печать если Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "match"
      то «Печать разбора значением Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "call"
      то «Печать вызова Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "builtin"
      то «Печать формы Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "binary"
      то «Печать операции Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "list"
      то «Печать списка Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "record"
      то «Печать записи Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "construct"
      то «Печать конструктора Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "fold"
      то «Печать свёртки Java» от «узел» и «контекст» и «состояние» и «отступ»
    случай "map"
      то «Печать цикла Java» от «узел» и да и «контекст» и «состояние» и «отступ»
    случай "filter"
      то «Печать цикла Java» от «узел» и нет и «контекст» и «состояние» и «отступ»
    случай любое
      то «Неизвестный вид Java» от «узел» и «состояние»

