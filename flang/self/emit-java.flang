  пусть «итог» равно (свёртка «параметры» начиная с «нуль» как «акк» и «параметр» → «Шаг аргумента диспетчера Java» от «акк» и «параметр»)
  «итог».«текст»

// Договор функции на двери: `требует`.
//
// Программа без единого `требует` не получает отсюда ни строки и ни одного
// временного имени — печать обязана остаться побайтово прежней.
функция «Договор на двери Java»
  принимает «функция»: «Функция Java», «общее»: «Общее Java», «состояние»: «Состояние Java»
  возвращает «Блок Java»
  если пусто («функция».«предусловия»)
    то запись «Блок Java» с «состояние» равным «состояние» и «вывод» равным ""
    иначе «Проверки договора Java» от «функция» и «общее» и «состояние»

функция «Проверки договора Java»
  принимает «функция»: «Функция Java», «общее»: «Общее Java», «состояние»: «Состояние Java»
  возвращает «Блок Java»
  пусть «контекст» равно («Контекст двери Java» от «функция» и «общее»)
  пусть «чистое» равно («Начальное взятое Java» от «состояние» и «общее» и («контекст».«параметры»))
  пусть «нуль» равно (запись «Блок Java» с «состояние» равным «чистое» и «вывод» равным "")
  свёртка («функция».«предусловия») начиная с «нуль» как «акк» и «предусловие» → «Шаг предусловия Java» от «акк» и «предусловие» и «контекст» и «функция»

// Отказ у предусловия свой, и помощник у него свой — `Flang.pre` рядом с
// `Flang.post`: одно сообщение на две разные вещи разошлось бы молча.
функция «Шаг предусловия Java»
  принимает «блок»: «Блок Java», «предусловие»: «Предусловие Java», «контекст»: «Контекст Java», «функция»: «Функция Java»
  возвращает «Блок Java»
  пусть «отступ» равно "      "
  пусть «проверка» равно («Печать значения Java» от («предусловие».«выражение») и «контекст» и («блок».«состояние») и «отступ»)
  пусть «сообщение» равно (если («предусловие».«есть сообщение») то («предусловие».«сообщение») иначе (соединить ["не выполнено требование «", («предусловие».«имя»), "» функции «", («функция».«имя»), "»"] по ""))
  пусть «строки» равно (соединить [(«Строка вывода Java» от «отступ» и (соединить ["// требует «", («предусловие».«имя»), "»"] по "")), («Строка вывода Java» от «отступ» и (соединить ["if (!Flang.pre(ctx, ", («проверка».«значение»), ", ", («Строка Java» от («предусловие».«имя»)), ", ", («Строка Java» от («функция».«имя»)), ")) {"] по "")), («Строка вывода Java» от «отступ» и (соединить ["  throw Flang.fail(", («Строка Java» от («предусловие».«код»)), ", ", («Строка Java» от «сообщение»), ");"] по "")), («Строка вывода Java» от «отступ» и "}")] по "")
  запись «Блок Java» с «состояние» равным («проверка».«состояние») и «вывод» равным (соединить [(«блок».«вывод»), («проверка».«вывод»), «строки»] по "")

// Порядок проверок на двери: сначала арность, потом объявленные типы
// (`Flang.checkEntry`, зовёт прогонщик ДО `call`), и только потом договор.
функция «Ветка диспетчера Java»
  принимает «функция»: «Функция Java», «общее»: «Общее Java», «состояние»: «Состояние Java»
  возвращает «Блок Java»
  пусть «арность» равно (длина («функция».«параметры»))
  пусть «текст арности» равно (к строке «арность»)
  пусть «сообщение» равно (соединить ["функция «", («функция».«имя»), "» принимает ", «текст арности», " аргум., получено "] по "")
  пусть «договор» равно («Договор на двери Java» от «функция» и «общее» и «состояние»)
  запись «Блок Java» с «состояние» равным («договор».«состояние») и «вывод» равным (соединить ["    if (name.equals(", («Строка Java» от («функция».«имя»)), ")) {\n", "      if (args.length != ", «текст арности», ") {\n", "        throw Flang.fail(\n", "            FlangError.CODE_TYPE,\n", "            ", («Строка Java» от «сообщение»), "\n", "                + args.length);\n", "      }\n", («договор».«вывод»), "      return ", («Значение по ключу Java» от («общее».«ид функций») и («функция».«имя»)), "(ctx", («Аргументы диспетчера Java» от («функция».«параметры»)), ");\n", "    }\n"] по "")

функция «Шаг ветки диспетчера Java»
  принимает «блок»: «Блок Java», «функция»: «Функция Java», «общее»: «Общее Java»
  возвращает «Блок Java»
  пусть «ветка» равно («Ветка диспетчера Java» от «функция» и «общее» и («блок».«состояние»))
  запись «Блок Java» с «состояние» равным («ветка».«состояние») и «вывод» равным (соединить («блок».«вывод») с («ветка».«вывод»))

// Вызов по имени — это не вызов внутри программы, а ГРАНИЦА: внутренние вызовы
// идут прямо на метод класса, сюда заходит только тот, у кого имя функции
// строка.
функция «Печать диспетчера Java»
  принимает «общее»: «Общее Java», «состояние»: «Состояние Java»
  возвращает «Блок Java»
  пусть «документ» равно («Javadoc Java» от ["Вызов функции по её исходному имени flang.", "", "Нужен прогонщику и всякому, кто связывает программу с внешним миром", "динамически (скрипт, тест, служба). Коды и тексты — те же, что у", "интерпретатора: «не найдена функция …» и «функция … принимает N аргум.».", "", "@param ctx контекст вычисления (newContext)", "@param name исходное имя функции flang", "@param args аргументы по порядку объявления", "@return значение функции"] и "  ")
  пусть «начало» равно (запись «Блок Java» с «состояние» равным «состояние» и «вывод» равным "")
  пусть «ветки» равно (свёртка («общее».«функции») начиная с «начало» как «акк» и «функция» → «Шаг ветки диспетчера Java» от «акк» и «функция» и «общее»)
  запись «Блок Java» с «состояние» равным («ветки».«состояние») и «вывод» равным (соединить [«документ», "  public static Value call(Ctx ctx, String name, Value[] args) {\n", («ветки».«вывод»), "    throw Flang.fail(FlangError.CODE_UNKNOWN_NAME, \"не найдена функция «\" + name + \"»\");\n", "  }\n"] по "")

// ═══════════════════════════ файлы ═══════════════════════════

объект «Файл Java»
  «путь»: строка
  «содержимое»: строка

// Рантайм и прогонщик печатаются байт в байт из flang/src/emit/java/ и потому
// приходят параметром: читать файлы язык не умеет и не должен.
объект «Настройки Java»
  «путь»: строка
  «есть путь»: признак
  «база»: число
  «предел глубины»: число
  «предел шагов»: число
  «прогонщик»: признак
  «рантайм значение»: строка
  «рантайм поле»: строка
  «рантайм ошибка»: строка
  «рантайм контекст»: строка
  «рантайм формы»: строка
  «исходник прогонщика»: строка
  «типы входа»: список «Тип входа»
  «поля входа»: список «Поле входа»
  «варианты входа»: список «Вариант входа»
  «параметры входа»: список «Параметр входа»

объект «Итог печати Java»
  «файлы»: список «Файл Java»
  «ошибка»: строка

объект «Тела Java»
  «состояние»: «Состояние Java»
  «части»: список строки

тотальная функция «Шапка файла Java»
  принимает «есть модуль»: признак, «модуль»: строка, «что»: строка
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить ["// Модуль flang: «", «модуль», "»."] по "") иначе "// Программа flang без имени модуля.")
  соединить ["// Сгенерировано flang (бэкенд Java, flang/self/emit-java.flang). Не редактировать руками.\n", «строка модуля», "\n// Файл: ", «что», ".\n", "// Правьте исходник на flang и печатайте заново: любая правка здесь потеряется."] по ""

тотальная функция «Файл рантайма Java»
  принимает «путь»: строка, «что»: строка, «есть модуль»: признак, «модуль»: строка, «исходник»: строка
  возвращает «Файл Java»
  запись «Файл Java» с «путь» равным «путь» и «содержимое» равным (соединить [(«Шапка файла Java» от «есть модуль» и «модуль» и «что»), "\n", «исходник»] по "")

тотальная функция «Правило прогонщика Java»
  принимает «прогонщик»: признак
  возвращает строка
  если «прогонщик»
    то соединить ["# -Xss не нужен: прогонщик сам считает в потоке с большим стеком.\n", "run: build\n", "\t$(JAVA) -cp . FlangCli $(CLASS)\n", "\n"] по ""
    иначе ""

тотальная функция «Печать Makefile Java»
  принимает «класс»: строка, «прогонщик»: признак
  возвращает строка
  соединить ["# Сгенерировано flang (бэкенд Java). Целей ровно столько, сколько нужно:\n", "# напечатанный код обязан собираться и запускаться без единой правки.\n", "JAVAC ?= javac\n", "JAVA ?= java\n", "CLASS ?= ", «класс», "\n", "\n", "# -encoding UTF-8 обязателен: имена в напечатанном коде кириллические, а\n", "# кодировка исходника по умолчанию зависит от локали машины.\n", "# -Xlint:all -Werror — не придирка: напечатанный код обязан быть чистым\n", "# под самым строгим режимом javac, иначе он не пройдёт в чужую сборку.\n", "JAVACFLAGS ?= -encoding UTF-8 -Xlint:all -Werror\n", "\n", "all: build\n", "\n", "build:\n", "\t$(JAVAC) $(JAVACFLAGS) -d . *.java\n", "\n", («Правило прогонщика Java» от «прогонщик»), "clean:\n", "\trm -f *.class\n", "\n", ".PHONY: all build", (если «прогонщик» то " run" иначе ""), " clean\n"] по ""

тотальная функция «Печать контекста Java»
  принимает «настройки»: «Настройки Java»
  возвращает строка
  соединить ["  /**\n", "   * Контекст вычисления с настройками этой программы.\n", "   *\n", "   * Индексация строк, предел глубины вызовов и лимит шагов — это настройки\n", "   * программы, а не рантайма: печать могла идти с нулевой базой индексации, а\n", "   * пределы вызывающий вправе поменять прямо в возвращённом контексте.\n", "   */\n", "  public static Ctx newContext() {\n", "    Ctx ctx = new Ctx();\n", "    ctx.indexBase = ", (к строке («настройки».«база»)), ";\n", "    ctx.maxDepth = ", (к строке («настройки».«предел глубины»)), ";\n", "    ctx.maxSteps = ", (к строке («настройки».«предел шагов»)), "L;\n", "    return ctx;\n", "  }\n"] по ""

тотальная функция «Шапка класса Java»
  принимает «есть модуль»: признак, «модуль»: строка, «класс»: строка
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить [" * Модуль flang «", («Экранировать комментарий Java» от «модуль»), "», напечатанный в Java."] по "") иначе " * Программа flang, напечатанная в Java.")
  соединить [(«Шапка файла Java» от «есть модуль» и «модуль» и "реализация: функции, конструкторы значений, вызов по имени"), "\n", "\n", "/**\n", «строка модуля», "\n", " *\n", " * Контракт вызова: метод возвращает значение либо бросает FlangError с кодом и\n", " * текстом, дословно совпадающими с интерпретатором flang. Все значения — Value:\n", " * числа там всегда double (целых чисел в flang нет), признак отличается от числа\n", " * тегом, а не типом Java, и равенство скаляров — Object.is, а не ==.\n", " *\n", " * FlangError непроверяемая (см. FlangError.java), поэтому ни один метод здесь не\n", " * объявляет throws: ошибку языка умеет дать любая операция, и объявление не\n", " * сообщило бы вызывающему ничего нового.\n", " */\n", "public final class ", «класс», " {\n", "\n", "  private ", «класс», "() {}"] по ""

тотальная функция «Склеить класс Java»
  принимает «шапка»: строка, «части»: список строки
  возвращает строка
  пусть «непустые» равно (отфильтровать «части» где «часть» → (длина «часть») больше 0)
  пусть «обрезанные» равно (отобразить «непустые» как «часть» → «Без перевода в конце Java» от «часть»)
  пусть «всё» равно (добавить "}" к («Слить строки Java» от [«шапка»] и «обрезанные»))
  соединить [(соединить «всё» по "\n\n"), "\n"] по ""

// ═════════════════════════ граница входа ═════════════════════════
//
// Объявленные типы параметров — ТАБЛИЦЕЙ, а не кодом. В напечатанной программе
// типов нет: прогонщик разбирает JSON и зовёт функцию, поэтому «Факториал»
// принимает н: нат считался бы при «н» равном −3 и 2.5. Сверяет таблицу
// `Flang.checkEntry` из рантайма, один и тот же текст для всех программ.
//
// Приезжает таблица СНАРУЖИ, как и текст рантайма, и по той же причине: решить,
// какой у параметра объявленный тип, — работа слоя типов, а не печати. Печать
// отвечает за то, что эти данные лягут в Java правильными байтами.
//
// Массив нулевой длины в Java законен (`new T[] { }`), поэтому особого случая
// «сверять нечего» здесь нет — в отличие от печати в C, где такой массив
// незаконен.

тотальная функция «Признак Java»
  принимает «значение»: признак
  возвращает строка
  пример «Истина»
    дано «значение» равно да
    ожидается "true"
  пример «Ложь»
    дано «значение» равно нет
    ожидается "false"
  если «значение» то "true" иначе "false"

тотальная функция «Вид типа входа Java»
  принимает «вид»: строка
  возвращает строка
  пример «Число»
    дано «вид» равно "число"
    ожидается "Flang.TYPE_NUMBER"
  пример «Незнакомое имя — джокер»
    дано «вид» равно "неизвестно"
    ожидается "Flang.TYPE_UNKNOWN"
  если «вид» равен "число"
    то "Flang.TYPE_NUMBER"
    иначе
      если «вид» равен "строка"
        то "Flang.TYPE_TEXT"
        иначе
          если «вид» равен "признак"
            то "Flang.TYPE_FLAG"
            иначе
              если «вид» равен "ничто"
                то "Flang.TYPE_NULL"
                иначе
                  если «вид» равен "список"
                    то "Flang.TYPE_LIST"
                    иначе
                      если «вид» равен "запись"
                        то "Flang.TYPE_RECORD"
                        иначе (если «вид» равен "сумма" то "Flang.TYPE_SUM" иначе "Flang.TYPE_UNKNOWN")

// Целые поля таблицы печатаются «к строке», а не «Числом Java»: это индексы
// массивов, они уезжают в `int`, и суффикс `d` сделал бы из них double — то
// есть некомпилируемый Java. Дробные — «низ» и «верх» — наоборот
// печатаются литералом double, потому что границы отрезка бывают нецелыми.
тотальная функция «Строка типа входа Java»
  принимает «тип»: «Тип входа»
  возвращает строка
  соединить ["            new Flang.TypeSpec(", («Вид типа входа Java» от («тип».«вид»)), ", ", («Строка Java» от («тип».«имя»)), ", ", («Строка Java» от («тип».«владелец»)), ", ", («Признак Java» от («тип».«ничто»)), ", ", («Признак Java» от («тип».«целое»)), ", ", («Признак Java» от («тип».«отрезок»)), ", ", («Число Java» от («тип».«низ»)), ", ", («Число Java» от («тип».«верх»)), ", ", (к строке («тип».«элемент»)), ", ", (к строке («тип».«поле с»)), ", ", (к строке («тип».«полей»)), ", ", (к строке («тип».«вариант с»)), ", ", (к строке («тип».«вариантов»)), "),"] по ""

тотальная функция «Строка поля входа Java»
  принимает «поле»: «Поле входа»
  возвращает строка
  соединить ["            new Flang.TypeField(", («Строка Java» от («поле».«имя»)), ", ", (к строке («поле».«тип»)), "),"] по ""

тотальная функция «Строка варианта входа Java»
  принимает «вариант»: «Вариант входа»
  возвращает строка
  соединить ["            new Flang.TypeVariant(", («Строка Java» от («вариант».«имя»)), ", ", (к строке («вариант».«поле с»)), ", ", (к строке («вариант».«полей»)), "),"] по ""

тотальная функция «Строка параметра входа Java»
  принимает «параметр»: «Параметр входа»
  возвращает строка
  соединить ["            new Flang.EntryParam(", («Строка Java» от («параметр».«функция»)), ", ", («Строка Java» от («параметр».«параметр»)), ", ", (к строке («параметр».«тип»)), "),"] по ""

тотальная функция «Шапка границы входа Java»
  возвращает список строки
  [
    "  /* Граница входа: объявленные типы параметров данными. Прогонщик сверяет по",
    "     ним значения, пришедшие снаружи, ДО вызова (Flang.checkEntry). Виды",
    "     Flang.TYPE_UNKNOWN (значение-функция, параметр полиморфизма, применение",
    "     типа с аргументами) не сверяются — ровно как молчит о них проверка",
    "     значений свидетеля. */",
    "  private static final Flang.EntryTable ENTRY =",
    "      new Flang.EntryTable(",
    "          new Flang.TypeSpec[] {"
  ]

тотальная функция «Хвост границы входа Java»
  возвращает список строки
  [
    "          });",
    "",
    "  /**",
    "   * Объявленные типы параметров: по ним сверяется вход извне.",
    "   *",
    "   * @return таблица границы входа",
    "   */",
    "  public static Flang.EntryTable entry() {",
    "    return ENTRY;",
    "  }"
  ]

тотальная функция «Строки границы входа Java»
  принимает «настройки»: «Настройки Java»
  возвращает список строки
  пусть «с типами» равно («Слить строки Java» от («Шапка границы входа Java») и (отобразить («настройки».«типы входа») как «тип» → «Строка типа входа Java» от «тип»))
  пусть «с полями» равно («Слить строки Java» от («Слить строки Java» от «с типами» и ["          },", "          new Flang.TypeField[] {"]) и (отобразить («настройки».«поля входа») как «поле» → «Строка поля входа Java» от «поле»))
  пусть «с вариантами» равно («Слить строки Java» от («Слить строки Java» от «с полями» и ["          },", "          new Flang.TypeVariant[] {"]) и (отобразить («настройки».«варианты входа») как «вариант» → «Строка варианта входа Java» от «вариант»))
  пусть «с параметрами» равно («Слить строки Java» от («Слить строки Java» от «с вариантами» и ["          },", "          new Flang.EntryParam[] {"]) и (отобразить («настройки».«параметры входа») как «параметр» → «Строка параметра входа Java» от «параметр»))
  «Слить строки Java» от «с параметрами» и («Хвост границы входа Java»)

// Хвостовой перевод строки обязателен: «Склеить класс Java» снимает у каждой
// части ПОСЛЕДНИЙ СИМВОЛ («Без перевода в конце Java»), а не хвостовой перевод
// по признаку. Без него срезалась бы закрывающая скобка метода `entry()`.
тотальная функция «Печать границы входа Java»
  принимает «настройки»: «Настройки Java»
  возвращает строка
  соединить [(соединить («Строки границы входа Java» от «настройки») по "\n"), "\n"] по ""

// ═══════════════════════════ печать программы ═══════════════════════════

функция «Шаг тела фабрики Java»
  принимает «тела»: «Тела Java», «запись»: «Запись типа Java», «общее»: «Общее Java»
  возвращает «Тела Java»
  запись «Тела Java» с «состояние» равным («тела».«состояние») и «части» равным (добавить («Печать фабрики Java» от «запись» и «общее») к («тела».«части»))

функция «Шаг тела варианта Java»
  принимает «тела»: «Тела Java», «вариант»: «Вариант типа Java», «сумма»: строка, «общее»: «Общее Java»
  возвращает «Тела Java»
  запись «Тела Java» с «состояние» равным («тела».«состояние») и «части» равным (добавить («Печать конструктора варианта Java» от «вариант» и «сумма» и «общее») к («тела».«части»))

функция «Шаг тел суммы Java»
  принимает «тела»: «Тела Java», «сумма»: «Сумма типов Java», «общее»: «Общее Java»
  возвращает «Тела Java»
  свёртка («сумма».«варианты») начиная с «тела» как «акк» и «вариант» → «Шаг тела варианта Java» от «акк» и «вариант» и («сумма».«имя») и «общее»

функция «Шаг тела функции Java»
  принимает «тела»: «Тела Java», «функция»: «Функция Java», «общее»: «Общее Java»
  возвращает «Тела Java»
  пусть «блок» равно («Печать функции Java» от «функция» и «общее» и («тела».«состояние»))
  запись «Тела Java» с «состояние» равным («блок».«состояние») и «части» равным (добавить («блок».«вывод») к («тела».«части»))

функция «Печать тел Java»
  принимает «общее»: «Общее Java», «состояние»: «Состояние Java», «настройки»: «Настройки Java»
  возвращает «Тела Java»
  пусть «нуль» равно (запись «Тела Java» с «состояние» равным «состояние» и «части» равным [(«Печать контекста Java» от «настройки»)])
  пусть «фабрики» равно (свёртка («общее».«записи») начиная с «нуль» как «акк» и «запись» → «Шаг тела фабрики Java» от «акк» и «запись» и «общее»)
  пусть «конструкторы» равно (свёртка («общее».«суммы») начиная с «фабрики» как «акк» и «сумма» → «Шаг тел суммы Java» от «акк» и «сумма» и «общее»)
  пусть «функции» равно (свёртка («общее».«функции») начиная с «конструкторы» как «акк» и «функция» → «Шаг тела функции Java» от «акк» и «функция» и «общее»)
  пусть «диспетчер» равно («Печать диспетчера Java» от «общее» и («функции».«состояние»))
  // Граница входа печатается ПОСЛЕ диспетчера и всегда: типы параметров нужны
  // прогонщику, а `FlangCli.java` зовёт `entry()` по имени. Без этого блока
  // напечатанный класс с прогонщиком не собирался бы вовсе.
  пусть «с диспетчером» равно (добавить («диспетчер».«вывод») к («функции».«части»))
  запись «Тела Java» с «состояние» равным («диспетчер».«состояние») и «части» равным (добавить («Печать границы входа Java» от «настройки») к «с диспетчером»)

// Печать в цель без планировщика конкурентности невозможна, и молчать об этом
// нельзя: обработчик стал бы обычной функцией, которую никто не зовёт, а
// программа собралась бы и кончилась кодом 0, делая не то, что написано.
тотальная функция «Часть конкурентности Java»
  принимает «сколько»: число, «слово»: строка
  возвращает список строки
  если «сколько» больше 0
    то [(соединить [«слово», " ", (к строке «сколько»)] по "")]
    иначе пустой список

тотальная функция «Имя процесса Java»
  принимает «узел»: «Значение»
  возвращает «Может быть имя Java»
  если «Это строка Java» от («Взять поле Java» от «узел» и "name")
    то вариант «Есть имя Java» с «имя» равным («Строка поля Java» от «узел» и "name")
    иначе вариант «Нет имени Java»

тотальная функция «Имя первого процесса Java»
  принимает «программа»: «Значение»
  возвращает «Может быть имя Java»
  разбор («Элементы поля Java» от «программа» и "processes")
    случай пусто
      то вариант «Нет имени Java»
    случай голова и хвост
      то «Имя процесса Java» от «голова»

тотальная функция «Про первый процесс Java»
  принимает «программа»: «Значение»
  возвращает строка
  разбор («Имя первого процесса Java» от «программа»)
    случай вариант «Есть имя Java» с «имя» как «имя»
      то соединить [", первый — процесс «", «имя», "»"] по ""
    случай «Нет имени Java»
      то ""

тотальная функция «Ошибка планировщика Java»
  принимает «программа»: «Значение», «состояние»: «Состояние Java», «процессов»: число, «надзоров»: число, «прогонов»: число
  возвращает «Состояние Java»
  пусть «части» равно («Слить строки Java» от («Слить строки Java» от («Часть конкурентности Java» от «процессов» и "процессов") и («Часть конкурентности Java» от «надзоров» и "надзоров")) и («Часть конкурентности Java» от «прогонов» и "прогонов"))
  пусть «что» равно (соединить «части» по ", ")
  «Записать ошибку Java» от «состояние» и (соединить ["у цели «java» нет планировщика конкурентности, а в программе объявлена конкурентность (", «что», ")", («Про первый процесс Java» от «программа»), ". Напечатать процессы в «java» нечем: обработчик стал бы обычной функцией, которую никто не зовёт, и программа собралась бы, делая не то, что написано. Цели с планировщиком: c, elixir, js"] по "")

тотальная функция «Проверить планировщик Java»
  принимает «программа»: «Значение», «состояние»: «Состояние Java»
  возвращает «Состояние Java»
  пусть «процессов» равно (длина («Элементы поля Java» от «программа» и "processes"))
  пусть «надзоров» равно (длина («Элементы поля Java» от «программа» и "supervisors"))
  пусть «прогонов» равно (длина («Элементы поля Java» от «программа» и "runs"))
  если ((«процессов» плюс «надзоров») плюс «прогонов») равен 0
    то «состояние»
    иначе «Ошибка планировщика Java» от «программа» и «состояние» и «процессов» и «надзоров» и «прогонов»

тотальная функция «Слить файлы Java»
  принимает «первые»: список «Файл Java», «вторые»: список «Файл Java»
  возвращает список «Файл Java»
  свёртка «вторые» начиная с «первые» как «акк» и «файл» → добавить «файл» к «акк»

// Последний шаг — снять сырые двунаправленные управляющие со ВСЕГО вывода.
тотальная функция «Очистить файл Java»
  принимает «файл»: «Файл Java»
  возвращает «Файл Java»
  запись «Файл Java» с «путь» равным («файл».«путь») и «содержимое» равным («Снять двунаправленные Java» от («файл».«содержимое»))

тотальная функция «Файлы рантайма Java»
  принимает «есть модуль»: признак, «модуль»: строка, «настройки»: «Настройки Java»
  возвращает список «Файл Java»
  [
    («Файл рантайма Java» от "Value.java" и "значение: тег, поля, равенство, печать числа" и «есть модуль» и «модуль» и («настройки».«рантайм значение»)),
    («Файл рантайма Java» от "Field.java" и "поле записи или варианта" и «есть модуль» и «модуль» и («настройки».«рантайм поле»)),
    («Файл рантайма Java» от "FlangError.java" и "диагностика: код и текст" и «есть модуль» и «модуль» и («настройки».«рантайм ошибка»)),
    («Файл рантайма Java» от "Ctx.java" и "контекст вычисления: пределы и индексация строк" и «есть модуль» и «модуль» и («настройки».«рантайм контекст»)),
    («Файл рантайма Java» от "Flang.java" и "операции языка: арифметика, встроенные формы, батут" и «есть модуль» и «модуль» и («настройки».«рантайм формы»))
  ]

// Первым делом программа ПОНИЖАЕТСЯ: `функция «Имя»` становится вариантом,
// `ф от 5` — вызовом диспетчера, и дальше печать высшего порядка не видит
// вовсе.
функция «Печать программы в Java»
  принимает «программа»: «Значение», «настройки»: «Настройки Java»
  возвращает «Итог печати Java»
  пусть «до понижения» равно («Проверить планировщик Java» от «программа» и «Пустое состояние Java»)
  пусть «понижено» равно («Дефункционализировать» от «программа»)
  пусть «есть модуль» равно («Есть имя модуля Java» от «понижено»)
  пусть «модуль» равно («Имя модуля Java» от «понижено»)
  пусть «класс» равно («Имя класса Java» от «понижено» и («настройки».«есть путь») и («настройки».«путь»))
  пусть «начало» равно («Проверить класс Java» от «до понижения» и «класс» и (если «есть модуль» то «модуль» иначе "null"))
  пусть «свод» равно («Собрать общее Java» от «понижено» и «класс» и «начало»)
  пусть «общее» равно («свод».«общее»)
  пусть «тела» равно («Печать тел Java» от «общее» и («свод».«состояние») и «настройки»)
  пусть «состояние» равно («тела».«состояние»)
  пусть «класс текст» равно («Склеить класс Java» от («Шапка класса Java» от «есть модуль» и «модуль» и «класс») и («тела».«части»))
  пусть «файл класса» равно (запись «Файл Java» с «путь» равным (соединить «класс» с ".java") и «содержимое» равным «класс текст»)
  пусть «с классом» равно («Слить файлы Java» от («Файлы рантайма Java» от «есть модуль» и «модуль» и «настройки») и [«файл класса»])
  пусть «с прогонщиком» равно (если («настройки».«прогонщик») то («Слить файлы Java» от «с классом» и [(«Файл рантайма Java» от "FlangCli.java" и "прогонщик: JSON на входе, JSON на выходе" и «есть модуль» и «модуль» и («настройки».«исходник прогонщика»))]) иначе «с классом»)
  пусть «все» равно (добавить (запись «Файл Java» с «путь» равным "Makefile" и «содержимое» равным («Печать Makefile Java» от «класс» и («настройки».«прогонщик»))) к «с прогонщиком»)
  запись «Итог печати Java» с «файлы» равным (отобразить «все» как «файл» → «Очистить файл Java» от «файл») и «ошибка» равным («состояние».«ошибка»)






