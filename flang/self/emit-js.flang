тотальная функция «Помощники операций JS»
  возвращает список «Пара имён»
  обеспечивает «помощников операций ровно одиннадцать» (длина результат) равен 11
  [
    (запись «Пара имён» с «ключ» равным "add" и «значение» равным "$add"),
    (запись «Пара имён» с «ключ» равным "sub" и «значение» равным "$sub"),
    (запись «Пара имён» с «ключ» равным "mul" и «значение» равным "$mul"),
    (запись «Пара имён» с «ключ» равным "div" и «значение» равным "$div"),
    (запись «Пара имён» с «ключ» равным "mod" и «значение» равным "$mod"),
    (запись «Пара имён» с «ключ» равным "percent" и «значение» равным "$percent"),
    (запись «Пара имён» с «ключ» равным "gt" и «значение» равным "$gt"),
    (запись «Пара имён» с «ключ» равным "lt" и «значение» равным "$lt"),
    (запись «Пара имён» с «ключ» равным "gte" и «значение» равным "$gte"),
    (запись «Пара имён» с «ключ» равным "lte" и «значение» равным "$lte"),
    (запись «Пара имён» с «ключ» равным "concat" и «значение» равным "$concat")
  ]

тотальная функция «Слово аргументов JS»
  принимает «количество»: число
  возвращает строка
  обеспечивает «от одиннадцати до четырнадцати — множественное число» если «Между» от («количество» остаток от 100) и 11 и 14 то результат равен "аргументов" иначе да
  пример «Одиннадцать — нижний край особой четвёрки»
    дано «количество» равно 11
    ожидается "аргументов"
  пример «Четырнадцать — верхний край особой четвёрки»
    дано «количество» равно 14
    ожидается "аргументов"
  пример «Двадцать один — единица уже вне особой четвёрки»
    дано «количество» равно 21
    ожидается "аргумент"
  пусть «сто» равно («количество» остаток от 100)
  пусть «десять» равно («сто» остаток от 10)
  если «Между» от «сто» и 11 и 14
    то "аргументов"
    иначе
      если «десять» равен 1
        то "аргумент"
        иначе
          если «Между» от «десять» и 2 и 4
            то "аргумента"
            иначе "аргументов"

// ═══════════════════════════ рантайм печатаемого модуля ═══════════════════════════

объект «Кусок рантайма JS»
  «имя»: строка
  «нужно»: список строки
  «исходник»: строка

тотальная функция «Текст FlangError JS»
  возвращает строка
  обеспечивает «рантайм FlangError несёт class $FlangError» результат содержит "class $FlangError"
  соединить [
    "class $FlangError extends Error {",
    "  constructor(code, message, span) {",
    "    super(message)",
    "    this.name = \"FlangError\"",
    "    this.code = code",
    "    const diagnostic = { code, message, severity: \"error\" }",
    "    if (span !== undefined && span !== null) {",
    "      diagnostic.span = span",
    "      this.span = span",
    "    }",
    "    this.diagnostics = [diagnostic]",
    "  }",
    "}"
  ] по "\n"

тотальная функция «Текст fail JS»
  возвращает строка
  обеспечивает «рантайм fail объявляет функцию $fail» результат содержит "function $fail("
  соединить [
    "function $fail(code, message, span) {",
    "  throw new $FlangError(code, message, span)",
    "}"
  ] по "\n"

тотальная функция «Текст FlangVariant JS»
  возвращает строка
  обеспечивает «рантайм FlangVariant несёт class $FlangVariant» результат содержит "class $FlangVariant"
  соединить [
    "class $FlangVariant {",
    "  constructor(name, fields = {}) {",
    "    this.variant = name",
    "    this.fields = fields",
    "  }",
    "}"
  ] по "\n"

тотальная функция «Текст isList JS»
  возвращает строка
  обеспечивает «рантайм isList объявляет функцию $isList» результат содержит "function $isList("
  соединить [
    "function $isList(value) {",
    "  return Array.isArray(value)",
    "}"
  ] по "\n"

тотальная функция «Текст isVariant JS»
  возвращает строка
  обеспечивает «рантайм isVariant несёт function $isVariant» результат содержит "function $isVariant("
  соединить [
    "function $isVariant(value) {",
    "  return value instanceof $FlangVariant",
    "}"
  ] по "\n"

тотальная функция «Текст isRecord JS»
  возвращает строка
  обеспечивает «рантайм isRecord несёт function $isRecord» результат содержит "function $isRecord("
  соединить [
    "function $isRecord(value) {",
    "  return typeof value === \"object\" && value !== null && !Array.isArray(value) && !(value instanceof $FlangVariant)",
    "}"
  ] по "\n"

тотальная функция «Текст isScalar JS»
  возвращает строка
  обеспечивает «рантайм isScalar несёт function $isScalar» результат содержит "function $isScalar("
  соединить [
    "function $isScalar(value) {",
    "  return value === null || typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\"",
    "}"
  ] по "\n"

тотальная функция «Текст chainEmpty JS»
  возвращает строка
  обеспечивает «рантайм chainEmpty несёт function $chainEmpty» результат содержит "function $chainEmpty("
  соединить [
    "function $chainEmpty(value) {",
    "  if (typeof value === \"string\") return value.length === 0",
    "  return $isList(value) && value.length === 0",
    "}"
  ] по "\n"

тотальная функция «Текст chainCons JS»
  возвращает строка
  обеспечивает «рантайм chainCons несёт function $chainCons» результат содержит "function $chainCons("
  соединить [
    "function $chainCons(value) {",
    "  if (typeof value === \"string\") return value.length > 0",
    "  return $isList(value) && value.length > 0",
    "}"
  ] по "\n"

тотальная функция «Текст chainHead JS»
  возвращает строка
  обеспечивает «рантайм chainHead несёт function $chainHead» результат содержит "function $chainHead("
  соединить [
    "function $chainHead(value) {",
    "  return typeof value === \"string\" ? Array.from(value)[0] : value[0]",
    "}"
  ] по "\n"

тотальная функция «Текст chainTail JS»
  возвращает строка
  обеспечивает «рантайм chainTail несёт function $chainTail» результат содержит "function $chainTail("
  соединить [
    "function $chainTail(value) {",
    "  return typeof value === \"string\" ? Array.from(value).slice(1).join(\"\") : value.slice(1)",
    "}"
  ] по "\n"

тотальная функция «Текст typeName JS»
  возвращает строка
  обеспечивает «рантайм typeName несёт function $typeName» результат содержит "function $typeName("
  соединить [
    "function $typeName(value) {",
    "  if (value === null) return \"ничто\"",
    "  if (typeof value === \"string\") return \"строка\"",
    "  if (typeof value === \"number\") return \"число\"",
    "  if (typeof value === \"boolean\") return \"признак\"",
    "  if ($isList(value)) return \"список\"",
    "  if ($isVariant(value)) return `вариант «${value.variant}»`",
    "  if ($isRecord(value)) return \"запись\"",
    "  return \"неизвестное значение\"",
    "}"
  ] по "\n"

тотальная функция «Текст describe JS»
  возвращает строка
  обеспечивает «рантайм describe несёт function $describe» результат содержит "function $describe("
  соединить [
    "function $describe(value) {",
    "  if (typeof value === \"string\") return JSON.stringify(value)",
    "  if ($isVariant(value)) {",
    "    const fields = Object.keys(value.fields)",
    "    return fields.length === 0 ? value.variant : `${value.variant}(${fields.join(\", \")})`",
    "  }",
    "  if ($isList(value)) return `список из ${value.length}`",
    "  if ($isRecord(value)) return `запись {${Object.keys(value).join(\", \")}}`",
    "  if (value === null) return \"ничто\"",
    "  if (value === true) return \"да\"",
    "  if (value === false) return \"нет\"",
    "  return String(value)",
    "}"
  ] по "\n"

тотальная функция «Текст equal JS»
  возвращает строка
  обеспечивает «рантайм equal несёт function $equal» результат содержит "function $equal("
  соединить [
    "function $equal(left, right) {",
    "  if ($isScalar(left) || $isScalar(right)) {",
    "    if (!$isScalar(left) || !$isScalar(right)) return false",
    "    return Object.is(left, right)",
    "  }",
    "  if ($isList(left) && $isList(right)) {",
    "    if (left.length !== right.length) return false",
    "    for (let index = 0; index < left.length; index += 1) {",
    "      if (!$equal(left[index], right[index])) return false",
    "    }",
    "    return true",
    "  }",
    "  if ($isVariant(left) && $isVariant(right)) {",
    "    if (left.variant !== right.variant) return false",
    "    return $recordsEqual(left.fields, right.fields)",
    "  }",
    "  if ($isRecord(left) && $isRecord(right)) return $recordsEqual(left, right)",
    "  return false",
    "}"
  ] по "\n"

тотальная функция «Текст recordsEqual JS»
  возвращает строка
  обеспечивает «рантайм recordsEqual несёт function $recordsEqual» результат содержит "function $recordsEqual("
  соединить [
    "function $recordsEqual(left, right) {",
    "  const leftKeys = Object.keys(left)",
    "  const rightKeys = Object.keys(right)",
    "  if (leftKeys.length !== rightKeys.length) return false",
    "  return leftKeys.every((key) => key in right && $equal(left[key], right[key]))",
    "}"
  ] по "\n"

тотальная функция «Текст field JS»
  возвращает строка
  обеспечивает «рантайм field несёт function $field» результат содержит "function $field("
  соединить [
    "function $field(target, name) {",
    "  if ($isVariant(target)) {",
    "    if (Object.hasOwn(target.fields, name)) return target.fields[name]",
    "    $fail(\"FLANG_TYPE\", `поле «${name}» нельзя взять у варианта «${target.variant}» — нужен разбор`)",
    "  }",
    "  if (!$isRecord(target)) {",
    "    $fail(\"FLANG_TYPE\", `поле «${name}» можно взять только у записи, получено ${$typeName(target)}`)",
    "  }",
    "  if (!Object.hasOwn(target, name)) $fail(\"FLANG_UNKNOWN_NAME\", `запись не содержит поле «${name}»`)",
    "  return target[name]",
    "}"
  ] по "\n"

тотальная функция «Текст cond JS»
  возвращает строка
  обеспечивает «рантайм cond несёт function $cond» результат содержит "function $cond("
  соединить [
    "function $cond(value) {",
    "  if (typeof value !== \"boolean\") {",
    "    $fail(\"FLANG_TYPE\", `условие «если» должно быть признаком, получено ${$typeName(value)}`)",
    "  }",
    "  return value",
    "}"
  ] по "\n"

тотальная функция «Текст matchFail JS»
  возвращает строка
  обеспечивает «рантайм matchFail несёт function $matchFail» результат содержит "function $matchFail("
  соединить [
    "function $matchFail(value) {",
    "  $fail(\"FLANG_MATCH_NOT_EXHAUSTIVE\", `разбор не покрывает значение ${$describe(value)}`)",
    "}"
  ] по "\n"

тотальная функция «Текст variantField JS»
  возвращает строка
  обеспечивает «рантайм variantField несёт function $variantField» результат содержит "function $variantField("
  соединить [
    "function $variantField(value, field) {",
    "  if (!Object.hasOwn(value.fields, field)) {",
    "    $fail(\"FLANG_UNKNOWN_NAME\", `вариант «${value.variant}» не содержит поле «${field}»`)",
    "  }",
    "  return value.fields[field]",
    "}"
  ] по "\n"

тотальная функция «Текст requireList JS»
  возвращает строка
  обеспечивает «рантайм requireList несёт function $requireList» результат содержит "function $requireList("
  соединить [
    "function $requireList(value, label) {",
    "  if (!$isList(value)) {",
    "    $fail(\"FLANG_TYPE\", `«${label}» работает только со списком, получено ${$typeName(value)}`)",
    "  }",
    "  return value",
    "}"
  ] по "\n"

тотальная функция «Текст keep JS»
  возвращает строка
  обеспечивает «рантайм keep несёт function $keep» результат содержит "function $keep("
  соединить [
    "function $keep(value) {",
    "  if (typeof value !== \"boolean\") {",
    "    $fail(\"FLANG_TYPE\", `условие «отфильтровать» должно быть признаком, получено ${$typeName(value)}`)",
    "  }",
    "  return value",
    "}"
  ] по "\n"

тотальная функция «Текст post JS»
  возвращает строка
  обеспечивает «рантайм post несёт function $post» результат содержит "function $post("
  соединить [
    "function $post(value, property, name) {",
    "  if (typeof value !== \"boolean\") {",
    "    $fail(\"FLANG_TYPE\", `постусловие «${property}» функции «${name}» должно давать признак, получено ${$typeName(value)}`)",
    "  }",
    "  return value",
    "}"
  ] по "\n"

// Отдельный помощник, а не `$post` со вторым текстом: слова отказа дословно те
// же, что у интерпретатора, и одно сообщение на две разные вещи расходилось бы
// молча. Печатается он ТОЛЬКО в программу, у которой есть `требует`.
тотальная функция «Текст pre JS»
