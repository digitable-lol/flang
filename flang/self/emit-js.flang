  соединить [
    "function $b_k_chislu(text) {",
    "  $expectString(\"к числу\", text, \"строка\")",
    "  const trimmed = text.trim()",
    "  if (!/^[+-]?(\\d+(\\.\\d+)?|\\.\\d+)([eE][+-]?\\d+)?$/u.test(trimmed)) {",
    "    $fail(\"FLANG_BUILTIN_ARGS\", `«к числу»: строка ${JSON.stringify(text)} не является числом`)",
    "  }",
    "  const result = Number(trimmed)",
    "  if (!Number.isFinite(result)) {",
    "    $fail(\"FLANG_BUILTIN_ARGS\", `«к числу»: строка ${JSON.stringify(text)} не является конечным числом`)",
    "  }",
    "  return result",
    "}"
  ] по "\n"

тотальная функция «Текст b_k_chislu_ili_beda»
  возвращает строка
  соединить [
    "function $b_k_chislu_ili_beda(text) {",
    "  try {",
    "    return new $FlangVariant(\"Разобрано\", { \"значение\": $b_k_chislu(text) })",
    "  } catch (error) {",
    "    return new $FlangVariant(\"Не разобрано\", {",
    "      \"код\": error?.code ?? \"FLANG_BUILTIN_ARGS\",",
    "      \"сообщение\": String(error?.message ?? \"\"),",
    "    })",
    "  }",
    "}"
  ] по "\n"

тотальная функция «Текст b_k_stroke»
  возвращает строка
  соединить [
    "function $b_k_stroke(value) {",
    "  if (typeof value === \"string\") return value",
    "  if (typeof value === \"number\") return String(value)",
    "  if (typeof value === \"boolean\") return value ? \"да\" : \"нет\"",
    "  if (value === null) return \"ничто\"",
    "  $fail(\"FLANG_BUILTIN_ARGS\", `«к строке»: ожидается скаляр, получено ${$typeName(value)}`)",
    "}"
  ] по "\n"

тотальная функция «Текст b_pusto»
  возвращает строка
  соединить [
    "function $b_pusto(value) {",
    "  if ($isList(value)) return value.length === 0",
    "  if (typeof value === \"string\") return Array.from(value).length === 0",
    "  $fail(\"FLANG_BUILTIN_ARGS\", `«пусто»: ожидается строка или список, получено ${$typeName(value)}`)",
    "}"
  ] по "\n"

тотальная функция «Текст b_golova»
  возвращает строка
  соединить [
    "function $b_golova(value) {",
    "  const list = $expectList(\"голова\", value, \"аргумент\")",
    "  if (list.length === 0) $fail(\"FLANG_BUILTIN_ARGS\", \"«голова»: список пуст\")",
    "  return list[0]",
    "}"
  ] по "\n"

тотальная функция «Текст b_hvost»
  возвращает строка
  соединить [
    "function $b_hvost(value) {",
    "  const list = $expectList(\"хвост\", value, \"аргумент\")",
    "  if (list.length === 0) $fail(\"FLANG_BUILTIN_ARGS\", \"«хвост»: список пуст\")",
    "  return list.slice(1)",
    "}"
  ] по "\n"

тотальная функция «Текст b_element»
  возвращает строка
  соединить [
    "function $b_element(index, value) {",
    "  $expectInteger(\"элемент\", index, \"индекс\")",
    "  const list = $expectList(\"элемент\", value, \"список\")",
    "  const at = index - $INDEX_BASE",
    "  if (at < 0 || at >= list.length) {",
    "    $fail(\"FLANG_BUILTIN_ARGS\", `«элемент»: индекс ${index} вне списка длиной ${list.length}`)",
    "  }",
    "  return list[at]",
    "}"
  ] по "\n"

тотальная функция «Текст b_dobavit»
  возвращает строка
  соединить [
    "function $b_dobavit(item, value) {",
    "  const list = $expectList(\"добавить\", value, \"второй аргумент\")",
    "  return [...list, item]",
    "}"
  ] по "\n"

тотальная функция «Текст b_ostatok_ot»
  возвращает строка
  соединить [
    "function $b_ostatok_ot(left, right) {",
    "  $expectNumber(\"остаток от\", left, \"делимое\")",
    "  $expectNumber(\"остаток от\", right, \"делитель\")",
    "  return left % right",
    "}"
  ] по "\n"

тотальная функция «Текст b_procentov_ot»
  возвращает строка
  соединить [
    "function $b_procentov_ot(percent, value) {",
    "  $expectNumber(\"процентов от\", percent, \"процент\")",
    "  $expectNumber(\"процентов от\", value, \"значение\")",
    "  return (percent / 100) * value",
    "}"
  ] по "\n"

тотальная функция «Текст Bounce»
  возвращает строка
  соединить [
    "class $Bounce {",
    "  constructor(step, args) {",
    "    this.step = step",
    "    this.args = args",
    "  }",
    "}"
  ] по "\n"

тотальная функция «Текст trampoline»
  возвращает строка
  соединить [
    "function $trampoline(result, name) {",
    "  while (result instanceof $Bounce) {",
    "    // Отскок — виток: глубину батут не растит, и упереться ему больше не во что.",
    "    $step(name)",
    "    result = result.step(...result.args)",
    "  }",
    "  return result",
    "}"
  ] по "\n"

тотальная функция «Текст enter»
  возвращает строка
  соединить [
    "function $enter(name) {",
    "  $step(name)",
    "  if ($maxDepth > 0 && $depth + 1 > $maxDepth) {",
    "    $fail(",
    "      \"FLANG_RECURSION_LIMIT\",",
    "      `функция «${name}» превысила предел глубины вызовов (${$maxDepth}) на глубине ${$depth + 1}`,",
    "    )",
    "  }",
    "  $depth += 1",
    "}"
  ] по "\n"

тотальная функция «Текст leave»
  возвращает строка
  соединить [
    "function $leave(value) {",
    "  $depth -= 1",
    "  return value",
    "}"
  ] по "\n"

тотальная функция «Текст step»
  возвращает строка
  соединить [
    "function $step(name) {",
    "  $steps += 1",
    "  if ($maxSteps > 0 && $steps > $maxSteps) {",
    "    $fail(",
    "      \"FLANG_RECURSION_LIMIT\",",
    "      `функция «${name}» исчерпала лимит шагов (${$maxSteps}) на глубине вызовов ${$depth}`,",
    "    )",
    "  }",
    "}"
  ] по "\n"

тотальная функция «Текст hostDepth»
  возвращает строка
  соединить [
    "function $hostDepth(error, name) {",
    "  try {",
    "    if (!(error instanceof RangeError)) return error",
    "    if (!$STACK_OVERFLOW.test(error.message) && $depth < 256) return error",
    "  } catch {}",
    "  return new $FlangError(",
    "    \"FLANG_RECURSION_LIMIT\",",
    "    `функция «${name}» исчерпала стек хозяина на глубине ${$depth}, не дойдя до предела глубины вызовов (${$maxDepth})`,",
    "  )",
    "}"
  ] по "\n"

тотальная функция «Текст top»
  возвращает строка
  соединить [
    "function $top(fn, args, name) {",
    "  $guarded = true",
    "  $depth = 0",
    "  $steps = 0",
    "  try {",
    "    return fn(...args)",
    "  } catch ($err) {",
    "    throw $hostDepth($err, name)",
    "  } finally {",
    "    $guarded = false",
    "  }",
    "}"
  ] по "\n"

// Реестр рантайма: имя, чего требует, исходный текст. Порядок записей — порядок
// печати: один AST обязан давать побайтово один вывод.
тотальная функция «Рантайм»
  возвращает список «Кусок рантайма»
  [
    (запись «Кусок рантайма» с «имя» равным "$FlangError" и «нужно» равным пустой список и «исходник» равным «Текст FlangError»),
    (запись «Кусок рантайма» с «имя» равным "$fail" и «нужно» равным ["$FlangError"] и «исходник» равным «Текст fail»),
    (запись «Кусок рантайма» с «имя» равным "$FlangVariant" и «нужно» равным пустой список и «исходник» равным «Текст FlangVariant»),
    (запись «Кусок рантайма» с «имя» равным "$isList" и «нужно» равным пустой список и «исходник» равным «Текст isList»),
    (запись «Кусок рантайма» с «имя» равным "$isVariant" и «нужно» равным ["$FlangVariant"] и «исходник» равным «Текст isVariant»),
    (запись «Кусок рантайма» с «имя» равным "$isRecord" и «нужно» равным ["$FlangVariant"] и «исходник» равным «Текст isRecord»),
    (запись «Кусок рантайма» с «имя» равным "$isScalar" и «нужно» равным пустой список и «исходник» равным «Текст isScalar»),
    (запись «Кусок рантайма» с «имя» равным "$chainEmpty" и «нужно» равным ["$isList"] и «исходник» равным «Текст chainEmpty»),
    (запись «Кусок рантайма» с «имя» равным "$chainCons" и «нужно» равным ["$isList"] и «исходник» равным «Текст chainCons»),
    (запись «Кусок рантайма» с «имя» равным "$chainHead" и «нужно» равным пустой список и «исходник» равным «Текст chainHead»),
    (запись «Кусок рантайма» с «имя» равным "$chainTail" и «нужно» равным пустой список и «исходник» равным «Текст chainTail»),
    (запись «Кусок рантайма» с «имя» равным "$typeName" и «нужно» равным ["$isList", "$isVariant", "$isRecord"] и «исходник» равным «Текст typeName»),
    (запись «Кусок рантайма» с «имя» равным "$describe" и «нужно» равным ["$isList", "$isVariant", "$isRecord"] и «исходник» равным «Текст describe»),
    (запись «Кусок рантайма» с «имя» равным "$equal" и «нужно» равным ["$isScalar", "$isList", "$isVariant", "$isRecord", "$recordsEqual"] и «исходник» равным «Текст equal»),
    (запись «Кусок рантайма» с «имя» равным "$recordsEqual" и «нужно» равным ["$equal"] и «исходник» равным «Текст recordsEqual»),
    (запись «Кусок рантайма» с «имя» равным "$field" и «нужно» равным ["$fail", "$isVariant", "$isRecord", "$typeName"] и «исходник» равным «Текст field»),
    (запись «Кусок рантайма» с «имя» равным "$cond" и «нужно» равным ["$fail", "$typeName"] и «исходник» равным «Текст cond»),
    (запись «Кусок рантайма» с «имя» равным "$matchFail" и «нужно» равным ["$fail", "$describe"] и «исходник» равным «Текст matchFail»),
    (запись «Кусок рантайма» с «имя» равным "$variantField" и «нужно» равным ["$fail"] и «исходник» равным «Текст variantField»),
    (запись «Кусок рантайма» с «имя» равным "$requireList" и «нужно» равным ["$fail", "$isList", "$typeName"] и «исходник» равным «Текст requireList»),
    (запись «Кусок рантайма» с «имя» равным "$keep" и «нужно» равным ["$fail", "$typeName"] и «исходник» равным «Текст keep»),
    (запись «Кусок рантайма» с «имя» равным "$post" и «нужно» равным ["$fail", "$typeName"] и «исходник» равным «Текст post»),
    (запись «Кусок рантайма» с «имя» равным "$nums" и «нужно» равным ["$fail", "$typeName"] и «исходник» равным «Текст nums»),
    (запись «Кусок рантайма» с «имя» равным "$ord" и «нужно» равным ["$fail"] и «исходник» равным «Текст ord»),
    (запись «Кусок рантайма» с «имя» равным "$add" и «нужно» равным ["$nums"] и «исходник» равным «Текст add»),
    (запись «Кусок рантайма» с «имя» равным "$sub" и «нужно» равным ["$nums"] и «исходник» равным «Текст sub»),
    (запись «Кусок рантайма» с «имя» равным "$mul" и «нужно» равным ["$nums"] и «исходник» равным «Текст mul»),
    (запись «Кусок рантайма» с «имя» равным "$div" и «нужно» равным ["$nums"] и «исходник» равным «Текст div»),
    (запись «Кусок рантайма» с «имя» равным "$mod" и «нужно» равным ["$nums"] и «исходник» равным «Текст mod»),
    (запись «Кусок рантайма» с «имя» равным "$percent" и «нужно» равным ["$nums"] и «исходник» равным «Текст percent»),
    (запись «Кусок рантайма» с «имя» равным "$gt" и «нужно» равным ["$ord"] и «исходник» равным «Текст gt»),
    (запись «Кусок рантайма» с «имя» равным "$lt" и «нужно» равным ["$ord"] и «исходник» равным «Текст lt»),
    (запись «Кусок рантайма» с «имя» равным "$gte" и «нужно» равным ["$ord"] и «исходник» равным «Текст gte»),
    (запись «Кусок рантайма» с «имя» равным "$lte" и «нужно» равным ["$ord"] и «исходник» равным «Текст lte»),
    (запись «Кусок рантайма» с «имя» равным "$concat" и «нужно» равным ["$fail", "$typeName"] и «исходник» равным «Текст concat»),
    (запись «Кусок рантайма» с «имя» равным "$expectString" и «нужно» равным ["$fail", "$typeName"] и «исходник» равным «Текст expectString»),
    (запись «Кусок рантайма» с «имя» равным "$expectNumber" и «нужно» равным ["$fail", "$typeName"] и «исходник» равным «Текст expectNumber»),
    (запись «Кусок рантайма» с «имя» равным "$expectInteger" и «нужно» равным ["$fail", "$expectNumber"] и «исходник» равным «Текст expectInteger»),
    (запись «Кусок рантайма» с «имя» равным "$expectList" и «нужно» равным ["$fail", "$isList", "$typeName"] и «исходник» равным «Текст expectList»),
    (запись «Кусок рантайма» с «имя» равным "$b_dlina" и «нужно» равным ["$fail", "$isList", "$typeName"] и «исходник» равным «Текст b_dlina»),
    (запись «Кусок рантайма» с «имя» равным "$b_simvol" и «нужно» равным ["$fail", "$expectInteger", "$expectString", "$INDEX_BASE"] и «исходник» равным «Текст b_simvol»),
    (запись «Кусок рантайма» с «имя» равным "$b_podstroka" и «нужно» равным ["$fail", "$expectInteger", "$expectString", "$INDEX_BASE"] и «исходник» равным «Текст b_podstroka»),
    (запись «Кусок рантайма» с «имя» равным "$b_soedinit" и «нужно» равным ["$fail", "$isList", "$expectString", "$typeName"] и «исходник» равным «Текст b_soedinit»),
    (запись «Кусок рантайма» с «имя» равным "$b_razdelit" и «нужно» равным ["$fail", "$expectString"] и «исходник» равным «Текст b_razdelit»),
    (запись «Кусок рантайма» с «имя» равным "$b_simvoly" и «нужно» равным ["$expectString"] и «исходник» равным «Текст b_simvoly»),
    (запись «Кусок рантайма» с «имя» равным "$b_kod_simvola" и «нужно» равным ["$fail", "$expectString"] и «исходник» равным «Текст b_kod_simvola»),
    (запись «Кусок рантайма» с «имя» равным "$b_soderzhit" и «нужно» равным ["$isList", "$equal", "$expectString"] и «исходник» равным «Текст b_soderzhit»),
    (запись «Кусок рантайма» с «имя» равным "$b_nachinaetsya_s" и «нужно» равным ["$expectString"] и «исходник» равным «Текст b_nachinaetsya_s»),
    (запись «Кусок рантайма» с «имя» равным "$b_k_chislu" и «нужно» равным ["$fail", "$expectString"] и «исходник» равным «Текст b_k_chislu»),
    (запись «Кусок рантайма» с «имя» равным "$b_k_chislu_ili_beda" и «нужно» равным ["$FlangVariant", "$b_k_chislu"] и «исходник» равным «Текст b_k_chislu_ili_beda»),
    (запись «Кусок рантайма» с «имя» равным "$b_k_stroke" и «нужно» равным ["$fail", "$typeName"] и «исходник» равным «Текст b_k_stroke»),
    (запись «Кусок рантайма» с «имя» равным "$b_pusto" и «нужно» равным ["$fail", "$isList", "$typeName"] и «исходник» равным «Текст b_pusto»),
    (запись «Кусок рантайма» с «имя» равным "$b_golova" и «нужно» равным ["$fail", "$expectList"] и «исходник» равным «Текст b_golova»),
    (запись «Кусок рантайма» с «имя» равным "$b_hvost" и «нужно» равным ["$fail", "$expectList"] и «исходник» равным «Текст b_hvost»),
    (запись «Кусок рантайма» с «имя» равным "$b_element" и «нужно» равным ["$fail", "$expectInteger", "$expectList", "$INDEX_BASE"] и «исходник» равным «Текст b_element»),
    (запись «Кусок рантайма» с «имя» равным "$b_dobavit" и «нужно» равным ["$expectList"] и «исходник» равным «Текст b_dobavit»),
    (запись «Кусок рантайма» с «имя» равным "$b_ostatok_ot" и «нужно» равным ["$expectNumber"] и «исходник» равным «Текст b_ostatok_ot»),
    (запись «Кусок рантайма» с «имя» равным "$b_procentov_ot" и «нужно» равным ["$expectNumber"] и «исходник» равным «Текст b_procentov_ot»),
    (запись «Кусок рантайма» с «имя» равным "$Bounce" и «нужно» равным пустой список и «исходник» равным «Текст Bounce»),
    (запись «Кусок рантайма» с «имя» равным "$trampoline" и «нужно» равным ["$Bounce", "$step"] и «исходник» равным «Текст trampoline»),
    (запись «Кусок рантайма» с «имя» равным "$enter" и «нужно» равным ["$fail", "$step", "$LIMITS"] и «исходник» равным «Текст enter»),
    (запись «Кусок рантайма» с «имя» равным "$leave" и «нужно» равным ["$LIMITS"] и «исходник» равным «Текст leave»),
    (запись «Кусок рантайма» с «имя» равным "$step" и «нужно» равным ["$fail", "$LIMITS"] и «исходник» равным «Текст step»),
    (запись «Кусок рантайма» с «имя» равным "$hostDepth" и «нужно» равным ["$FlangError", "$LIMITS"] и «исходник» равным «Текст hostDepth»),
    (запись «Кусок рантайма» с «имя» равным "$top" и «нужно» равным ["$hostDepth", "$LIMITS"] и «исходник» равным «Текст top»)
  ]


тотальная функция «Нужное для»
  принимает «имя»: строка
  возвращает список строки
  свёртка (отфильтровать «Рантайм» где «кусок» → («кусок».«имя») равен «имя») начиная с пустой список как «акк» и «кусок»
    «кусок».«нужно»

функция «Замкнуть имя»
  принимает «имя»: строка, «набрано»: список строки
  возвращает список строки
  если «набрано» содержит «имя»
    то «набрано»
    иначе «Замкнуть нужное» от («Нужное для» от «имя») и (добавить «имя» к «набрано»)

функция «Замкнуть нужное»
  принимает «нужно»: список строки, «набрано»: список строки
  возвращает список строки
  свёртка «нужно» начиная с «набрано» как «акк» и «имя» → «Замкнуть имя» от «имя» и «акк»

тотальная функция «Шапка рантайма»
  возвращает строка
  соединить [
    "/* ── рантайм: то и только то, что нужно этому модулю ──",
    "   Представление значений повторяет интерпретатор flang дословно: список —",
    "   массив, запись — обычный объект, вариант — экземпляр класса, «ничто» — null.",
    "   Тексты и коды ошибок тоже дословные: они часть наблюдаемого поведения. */"
  ] по "\n"

тотальная функция «Блок базы»
  принимает «база»: число
  возвращает строка
  соединить [
    "// Индексация строк — с 1 и включительно с обоих концов (SPEC, раздел 5):",
    "// «первый символ» на языке предметной области это первый, а не нулевой.",
    (соединить "const $INDEX_BASE = " с (к строке «база»))
  ] по "\n"

тотальная функция «Блок пределов»
  принимает «предел глубины»: число, «предел шагов»: число
  возвращает строка
  соединить [
    "// Пределы вычисления — те же, что у интерпретатора. Без счётчиков модуль на",
    "// незавершающейся функции крутился бы вечно (в браузере — смерть вкладки), а",
    "// на глубокой рекурсии давал RangeError с пустым `code`: не отказ языка.",
    (соединить "const $DEFAULT_MAX_DEPTH = " с (к строке «предел глубины»)),
    (соединить "const $DEFAULT_MAX_STEPS = " с (к строке «предел шагов»)),
    "let $maxDepth = $DEFAULT_MAX_DEPTH",
    "let $maxSteps = $DEFAULT_MAX_STEPS",
    "let $depth = 0",
    "let $steps = 0",
    "// Стоит ли на расчёте граница ($top). Вызов извне приходит с `false` и",
    "// границу ставит; рекурсивные вызовы видят `true` и идут прямо в тело.",
    "let $guarded = false",
    "",
    "// Как хозяин называет исчерпание стека: V8 и JavaScriptCore — «Maximum call",
    "// stack size exceeded», SpiderMonkey — «too much recursion». Компилируется",
    "// здесь, при загрузке: компиляция образца сама требует стека, которого на",
    "// месте отказа уже нет — и тогда наружу шёл SyntaxError вместо отказа языка.",
    "const $STACK_OVERFLOW = /call stack|too much recursion|recursion too deep/iu",
    "",
    "/**",
    " * Свежий контекст вычисления: пределы и сброшенные счётчики.",
    " *",
    " * То же, что `new_context` у остальных семи целей, только контекст здесь —",
    " * сам модуль. Не переданный предел берётся ПО УМОЛЧАНИЮ, а не остаётся с",
    " * прошлого раза: контекст на то и свежий. Ноль или отрицательное значение",
    " * снимает предел.",
    " *",
    " * @param {{maxDepth?: number, maxSteps?: number}} [limits]",
    " * @returns {{maxDepth: number, maxSteps: number}}",
    " */",
    "export function $newContext(limits = {}) {",
    "  $maxDepth = typeof limits.maxDepth === \"number\" ? limits.maxDepth : $DEFAULT_MAX_DEPTH",
    "  $maxSteps = typeof limits.maxSteps === \"number\" ? limits.maxSteps : $DEFAULT_MAX_STEPS",
    "  $depth = 0",
    "  $steps = 0",
    "  return { maxDepth: $maxDepth, maxSteps: $maxSteps }",
    "}"
  ] по "\n"

тотальная функция «Куски замыкания»
  принимает «замыкание»: список строки
  возвращает список строки
  отобразить (отфильтровать «Рантайм» где «кусок» → «замыкание» содержит («кусок».«имя»)) как «кусок» → «кусок».«исходник»

// Хвостовые пробелы у планировщика снимаются, как это делает `trimEnd()`
// эталона: файл на диске кончается переводом строки, а блоки склеиваются
// пустой строкой между ними, и второй перевод дал бы лишнюю пустую строку.
тотальная функция «Пробельные»
  возвращает строка
  " \t\n\r"

функция «Без хвостовых пробелов»
  принимает «текст»: строка
  возвращает строка
  если (длина «текст») равен 0
    то «текст»
    иначе
      если «Пробельные» содержит («Последний символ» от «текст»)
        то «Без хвостовых пробелов» от (подстрока «текст» с 1 по ((длина «текст») минус 1))
        иначе «текст»

// Планировщик — последним: он зовёт помощников рантайма, а объявления функций
// в JS поднимаются, поэтому порядок здесь читательский, а не обязательный.
функция «Печать рантайма»
  принимает «нужно»: список строки, «настройки»: «Настройки», «конкурентная»: признак
  возвращает строка
  пусть «замыкание» равно («Замкнуть нужное» от «нужно» и пустой список)
  пусть «нечего» равно (если пусто «замыкание» то (если «конкурентная» то нет иначе да) иначе нет)
  если «нечего»
    то ""
    иначе
      пусть «с базой» равно (если «замыкание» содержит "$INDEX_BASE" то [«Шапка рантайма», («Блок базы» от («настройки».«база»))] иначе [«Шапка рантайма»])
      пусть «с пределами» равно (если «замыкание» содержит "$LIMITS" то (добавить («Блок пределов» от («настройки».«предел глубины») и («настройки».«предел шагов»)) к «с базой») иначе «с базой»)
      пусть «блоки» равно («Слить строки» от «с пределами» и («Куски замыкания» от «замыкание»))
      соединить (если «конкурентная» то (добавить («Без хвостовых пробелов» от («настройки».«исходник планировщика»)) к «блоки») иначе «блоки») по "\n\n"

// ═══════════════════════════ типы в документации ═══════════════════════════

// Имена уточнённого числа. Приходят они сюда ИМЕНЕМ, а не видом: `нат` и
// `целое` не ключевые слова. В JavaScript отдельного типа у них нет — значение
// то же самое число, — и написать `*` значило бы сказать «неизвестно» там, где
// известно всё.
тотальная функция «Числовые имена»
  возвращает список строки
  ["нат", "натуральное", "nat", "naturo", "自然数", "целое", "integer", "entjero", "整数"]

функция «Пометка вида типа»
  принимает «тип»: «Значение», «общее»: «Общее»
  возвращает строка
  пусть «вид» равно («Вид узла» от «тип»)
  если «вид» равен "string"
    то "string"
    иначе
      если «вид» равен "number"
        то "number"
        иначе
          если «вид» равен "boolean"
            то "boolean"
            иначе
              если «вид» равен "nothing"
                то "null"
                иначе
                  если «вид» равен "list"
                    то соединить ["Array<", («Пометка типа» от («Взять поле» от «тип» и "of") и «общее»), ">"] по ""
                    иначе «Пометка имени» от «тип» и «общее»

тотальная функция «Пометка имени»
  принимает «тип»: «Значение», «общее»: «Общее»
  возвращает строка
  если «Это строка» от («Взять поле» от «тип» и "name")
    то «Пометка известного имени» от («Строка поля» от «тип» и "name") и «общее»
    иначе "*"

тотальная функция «Пометка известного имени»
  принимает «имя»: строка, «общее»: «Общее»
  возвращает строка
  если «Есть в таблице» от («общее».«ид записей») и «имя»
    то «Значение по ключу» от («общее».«ид записей») и «имя»
    иначе
      если «Есть в таблице» от («общее».«ид сумм») и «имя»
        то «Значение по ключу» от («общее».«ид сумм») и «имя»
        иначе
          если «Числовые имена» содержит «имя»
            то "number"
            иначе "*"

функция «Пометка типа»
  принимает «тип»: «Значение», «общее»: «Общее»
  возвращает строка
  если «Это запись» от «тип»
    то «Пометка с необязательностью» от «тип» и «общее»
    иначе "*"

функция «Пометка с необязательностью»
  принимает «тип»: «Значение», «общее»: «Общее»
  возвращает строка
  пусть «внутри» равно («Пометка вида типа» от «тип» и «общее»)
  если «Это истина» от («Взять поле» от «тип» и "optional")
    то соединить ["(", «внутри», "|null)"] по ""
    иначе «внутри»

// ═══════════════════════════ записи и суммы ═══════════════════════════

функция «Поля в документации»
  принимает «поля»: список «Поле типа», «общее»: «Общее»
  возвращает строка
  соединить (отобразить «поля» как «поле» → соединить [(«Печать строки» от («поле».«имя»)), ": ", («Пометка типа» от («поле».«тип») и «общее»)] по "") по ", "

функция «Печать записи»
  принимает «запись типа»: «Запись типа», «общее»: «Общее»
  возвращает строка
  пусть «имя» равно («запись типа».«имя»)
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид записей») и «имя»)
  пусть «фабрика» равно («Значение по ключу» от («общее».«ид фабрик») и «имя»)
  пусть «поля» равно («запись типа».«поля»)
  пусть «присвоения» равно (соединить (отобразить «поля» как «поле» → соединить ["    ", («Печать строки» от («поле».«имя»)), ": fields[", («Печать строки» от («поле».«имя»)), "] ?? null,\n"] по "") по "")
  соединить [
    "/** Запись FTS «", «имя», "». */\n",
    "/** @typedef {{ ", («Поля в документации» от «поля» и «общее»), " }} ", «идентификатор», " */\n",
    "\n",
    "/**\n",
    " * Фабрика записи «", «имя», "».\n",
    " *\n",
    " * Запись flang тотальна: у неё есть все объявленные поля. Отсутствующее\n",
    " * поле — это «ничто» (null), а не дырка в объекте, иначе доступ к полю дал\n",
    " * бы FLANG_UNKNOWN_NAME там, где интерпретатор возвращает значение.\n",
    " *\n",
    " * @param {Partial<", «идентификатор», ">} [fields]\n",
    " * @returns {", «идентификатор», "}\n",
    " */\n",
    "export function ", «фабрика», "(fields = {}) {\n",
    "  return {\n",
    «присвоения»,
    "  }\n",
    "}"
  ] по ""

тотальная функция «Перечень вариантов»
  принимает «варианты»: список «Вариант типа»
  возвращает строка
  если пусто «варианты»
    то "без вариантов"
    иначе соединить (отобразить «варианты» как «вариант» → соединить ["«", («вариант».«имя»), "»"] по "") по " | "

функция «Печать конструктора»
  принимает «вариант»: «Вариант типа», «сумма»: строка, «общее»: «Общее»
  возвращает строка
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид вариантов») и («вариант».«имя»))
  пусть «поля» равно («вариант».«поля»)
  пусть «подпись» равно (если пусто «поля» то " * @returns {$FlangVariant}\n" иначе (соединить [" * @param {{ ", («Поля в документации» от «поля» и «общее»), " }} fields\n * @returns {$FlangVariant}\n"] по ""))
  соединить [
    "/**\n",
    " * Конструктор варианта «", («вариант».«имя»), "» суммы «", «сумма», "».\n",
    " *\n",
    " * Поля не копируются, а берутся как есть: интерпретатор строит объект полей\n",
    " * в порядке узла AST, и порядок ключей виден в диагностиках разбора.\n",
    " *\n",
    «подпись»,
    " */\n",
    "export function ", «идентификатор», "(fields = {}) {\n",
    "  return new $FlangVariant(", («Печать строки» от («вариант».«имя»)), ", fields)\n",
    "}"
  ] по ""

функция «Печать суммы»
  принимает «сумма»: «Сумма типов», «общее»: «Общее»
  возвращает строка
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид сумм») и («сумма».«имя»))
  пусть «шапка» равно (соединить [
    "/** Сумма типов FTS «", («сумма».«имя»), "»: ", («Перечень вариантов» от («сумма».«варианты»)), ". */\n",
    "/** Дискриминант — поле «variant»; поля варианта лежат в «fields». */\n",
    "/** @typedef {$FlangVariant} ", «идентификатор», " */"
  ] по "")
  пусть «известные» равно (отфильтровать («сумма».«варианты») где «вариант» → «Есть в таблице» от («общее».«ид вариантов») и («вариант».«имя»))
  пусть «конструкторы» равно (отобразить «известные» как «вариант» → «Печать конструктора» от «вариант» и («сумма».«имя») и «общее»)
  соединить («Слить строки» от [«шапка»] и «конструкторы») по "\n\n"

