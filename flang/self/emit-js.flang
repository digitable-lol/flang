    иначе «состояние»

тотальная функция «Снять перевод JS»
  принимает «текст»: строка
  возвращает строка
  если (длина «текст») больше 0
    то подстрока «текст» с 1 по ((длина «текст») минус 1)
    иначе «текст»

функция «Печать функции JS»
  принимает «функция»: «Функция JS», «общее»: «Общее JS», «состояние»: «Состояние JS»
  возвращает «Блок JS»
  пусть «свежее состояние» равно («Заменить взятое JS» от («Заменить счётчик JS» от «состояние» и 0) и («Начальное взятое JS» от «общее»))
  пусть «нуль» равно (запись «Связывание параметров JS» с «состояние» равным «свежее состояние» и «контекст» равным («Начальный контекст JS» от «функция» и «общее») и «идентификаторы» равным пустой список)
  пусть «связано» равно (свёртка («функция».«параметры») начиная с «нуль» как «акк» и «параметр» → «Связать параметр JS» от «акк» и «параметр»)
  пусть «идентификаторы» равно («связано».«идентификаторы»)
  пусть «контекст» равно («Заменить параметры JS» от («связано».«контекст») и «идентификаторы»)
  пусть «подпись» равно (соединить «идентификаторы» по ", ")
  пусть «тело» равно («Тело функции JS» от «функция» и «контекст» и («связано».«состояние»))
  пусть «рекурсивная» равно ((«общее».«рекурсивные») содержит («функция».«имя»))
  пусть «после преамбулы» равно («Затребовать преамбулу JS» от («тело».«состояние») и «рекурсивная»)
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид функций») и («функция».«имя»))
  пусть «метка» равно («Печать строки» от («функция».«имя»))
  пусть «описание» равно («Описание функции JS» от «функция» и «контекст» и «идентификаторы» и «общее»)
  пусть «преамбула» равно («Преамбула JS» от «рекурсивная» и «идентификатор» и «подпись» и «метка»)
  если («контекст».«есть члены»)
    то «Печать батута JS» от «функция» и «общее» и «после преамбулы» и «описание» и «идентификатор» и «подпись» и «метка» и «преамбула» и («тело».«вывод») и «рекурсивная»
    иначе запись «Блок JS» с «состояние» равным «после преамбулы» и «вывод» равным («Снять перевод JS» от (соединить [«описание», "\n", («Строка вывода» от "" и (соединить ["export function ", «идентификатор», "(", «подпись», ") {"] по "")), «преамбула», («тело».«вывод»), («Строка вывода» от "" и "}")] по ""))

/* ── граница входа: предусловия ──────────────────────────────────────────────
 *
 * ГДЕ ПРОВЕРЯЕТСЯ ДОГОВОР, И ПОЧЕМУ НЕ В ТЕЛЕ ФУНКЦИИ. В flang предусловие
 * снимает ВЫЗЫВАЮЩИЙ: каждое место вызова обязано доказать `требует`
 * вызываемой, иначе программа отвергается кодом FLANG_PRECONDITION_CALL и до
 * печати не доезжает. Значит внутри программы требование уже ИСТИННО — не
 * «проверено», а известно, — и печатать его проверку в тело значило бы платить
 * временем каждого вызова за доказанное статически.
 *
 * ФОРМА У JavaScript СВОЯ, и не по прихоти: у семи остальных целей дверь — это
 * ветка диспетчера вызова по имени, а здесь диспетчера нет вовсе (имена держит
 * таблица `$PROGRAM`, и прогонщик берёт функцию оттуда). Дверью служит отдельная
 * функция модуля: она возвращает `null`, когда все требования выполнены, и
 * первое нарушенное — объектом отказа. Тело функции при этом остаётся байт в
 * байт прежним: ни разворот хвостового самовызова в цикл, ни батут, ни счётчик
 * глубины не сдвигаются.
 */
тотальная функция «Начальный контекст двери JS»
  принимает «функция»: «Функция JS», «общее»: «Общее JS»
  возвращает «Контекст JS»
  запись «Контекст JS» с «общее» равным «общее» и «функция» равным «функция» и «параметры» равным пустой список и «сам хвост» равным нет и «есть члены» равным нет и «члены» равным пустой список и «выходит» равным нет и «область» равным пустой список

тотальная функция «Начальное взятое двери JS»
  принимает «общее»: «Общее JS»
  возвращает список строки
  «Слить строки» от («Начальное взятое JS» от «общее») и (отобразить («общее».«ид границ») как «пара» → «пара».«значение»)

функция «Шаг гейта JS»
  принимает «блок»: «Блок JS», «предусловие»: «Предусловие JS», «контекст»: «Контекст JS», «имя функции»: строка
  возвращает «Блок JS»
  пусть «проверка» равно («Печать значения JS» от («предусловие».«выражение») и «контекст» и («блок».«состояние») и "  ")
  пусть «состояние» равно («Затребовать JS» от («проверка».«состояние») и "$pre")
  пусть «сообщение» равно (если («предусловие».«есть сообщение») то («предусловие».«сообщение») иначе (соединить ["не выполнено требование «", («предусловие».«имя»), "» функции «", «имя функции», "»"] по ""))
  пусть «след» равно (если («предусловие».«есть след») то («Печать литерала JS» от («предусловие».«след»)) иначе "null")
  пусть «строки» равно (соединить [
    («Строка вывода» от "  " и (соединить ["// требует «", («предусловие».«имя»), "»"] по "")),
    («Строка вывода» от "  " и (соединить ["if (!$pre(", («проверка».«значение»), ", ", («Печать строки» от («предусловие».«имя»)), ", ", («Печать строки» от «имя функции»), ")) {"] по "")),
    («Строка вывода» от "    " и (соединить ["return { code: ", («Печать строки» от («предусловие».«код»)), ", message: ", («Печать строки» от «сообщение»), ", span: ", «след», " }"] по "")),
    («Строка вывода» от "  " и "}")
  ] по "")
  запись «Блок JS» с «состояние» равным «состояние» и «вывод» равным (соединить [(«блок».«вывод»), («проверка».«вывод»), «строки»] по "")

// Подпись короткая нарочно: доводы, по которым проверка стоит здесь, а не в
// теле, лежат в шапке выше и уезжать в каждую напечатанную программу не обязаны.
функция «Печать гейта JS»
  принимает «функция»: «Функция JS», «общее»: «Общее JS», «состояние»: «Состояние JS»
  возвращает «Блок JS»
  пусть «свежее состояние» равно («Заменить взятое JS» от («Заменить счётчик JS» от «состояние» и 0) и («Начальное взятое двери JS» от «общее»))
  пусть «нуль» равно (запись «Связывание параметров JS» с «состояние» равным «свежее состояние» и «контекст» равным («Начальный контекст двери JS» от «функция» и «общее») и «идентификаторы» равным пустой список)
  пусть «связано» равно (свёртка («функция».«параметры») начиная с «нуль» как «акк» и «параметр» → «Связать параметр JS» от «акк» и «параметр»)
  пусть «идентификаторы» равно («связано».«идентификаторы»)
  пусть «контекст» равно («Заменить параметры JS» от («связано».«контекст») и «идентификаторы»)
  пусть «начало» равно (запись «Блок JS» с «состояние» равным («связано».«состояние») и «вывод» равным "")
  пусть «тело» равно (свёртка («функция».«предусловия») начиная с «начало» как «акк» и «предусловие» → «Шаг гейта JS» от «акк» и «предусловие» и «контекст» и («функция».«имя»))
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид границ») и («функция».«имя»))
  пусть «описание» равно (соединить [
    "/**",
    (соединить [" * Предусловия функции flang «", («функция».«имя»), "»: их проверяет прогонщик ДО вызова —"] по ""),
    " * значения пришли снаружи, и вызывающего, который снял бы требование на",
    " * проверке, у них нет. В теле функции на это не потрачено ни одной строки.",
    " *",
    " * @returns {null | {code: string, message: string, span: object|null}}",
    " */"
  ] по "\n")
  запись «Блок JS» с «состояние» равным («тело».«состояние») и «вывод» равным («Снять перевод JS» от (соединить [«описание», "\n", («Строка вывода» от "" и (соединить ["export function ", «идентификатор», "(", (соединить «идентификаторы» по ", "), ") {"] по "")), («тело».«вывод»), («Строка вывода» от "" и "  return null"), («Строка вывода» от "" и "}")] по ""))

// Батут: наружу торчит обычная функция, внутри — шаг, возвращающий отскок.
// Счётчик глубины стоит на внешней функции, а не на шаге: шаг кадра не растит,
// и считать его глубиной значило бы считать то, чего нет.
тотальная функция «Печать батута JS»
  принимает «функция»: «Функция JS», «общее»: «Общее JS», «состояние»: «Состояние JS», «описание»: строка, «идентификатор»: строка, «подпись»: строка, «метка»: строка, «преамбула»: строка, «тело»: строка, «рекурсивная»: признак
  возвращает «Блок JS»
  пусть «шаг» равно («Значение по ключу» от («общее».«ид шагов») и («функция».«имя»))
  пусть «отскок» равно (соединить ["$trampoline(", «шаг», "(", «подпись», "), ", «метка», ")"] по "")
  пусть «возврат» равно (если «рекурсивная» то (соединить ["  return $leave(", «отскок», ")"] по "") иначе (соединить "  return " с «отскок»))
  пусть «вывод» равно (соединить [
    «описание», "\n",
    («Строка вывода» от "" и (соединить ["export function ", «идентификатор», "(", «подпись», ") {"] по "")),
    «преамбула»,
    («Строка вывода» от "" и «возврат»),
    («Строка вывода» от "" и "}"),
    "\n",
    («Строка вывода» от "" и (соединить ["/** Шаг батута для «", («функция».«имя»), "»: значение либо отскок к соседу по взаимной рекурсии. */"] по "")),
    («Строка вывода» от "" и (соединить ["function ", «шаг», "(", «подпись», ") {"] по "")),
    «тело»,
    («Строка вывода» от "" и "}")
  ] по "")
  запись «Блок JS» с «состояние» равным («Затребовать JS» от «состояние» и "$trampoline") и «вывод» равным («Снять перевод JS» от «вывод»)

// ═══════════════════════════ печать программы ═══════════════════════════

объект «Файл JS»
  «путь»: строка
  «содержимое»: строка

объект «Настройки JS»
  «путь»: строка
  «есть путь»: признак
  «база»: число
  «предел глубины»: число
  «предел шагов»: число
  «исходник планировщика»: строка
  «прогонщик»: признак
  «исходник прогонщика»: строка
  «исходник исполнителя»: строка
  «типы входа»: список «Тип входа»
  «поля входа»: список «Поле входа»
  «варианты входа»: список «Вариант входа»
  «параметры входа»: список «Параметр входа»

объект «Итог печати JS»
  «файлы»: список «Файл JS»
  «ошибка»: строка

объект «Секции JS»
  «состояние»: «Состояние JS»
  «части»: список строки

функция «Шаг записи JS»
  принимает «акк»: «Секции JS», «запись типа»: «Запись типа JS», «общее»: «Общее JS»
  возвращает «Секции JS»
  запись «Секции JS» с «состояние» равным («акк».«состояние») и «части» равным (добавить («Печать записи JS» от «запись типа» и «общее») к («акк».«части»))

функция «Шаг суммы JS»
  принимает «акк»: «Секции JS», «сумма»: «Сумма типов JS», «общее»: «Общее JS»
  возвращает «Секции JS»
  запись «Секции JS» с «состояние» равным («Затребовать JS» от («акк».«состояние») и "$FlangVariant") и «части» равным (добавить («Печать суммы JS» от «сумма» и «общее») к («акк».«части»))

// Гейт печатается вместе с прогонщиком и отменяется вместе с ним
// (`прогонщик` равно нет): звать его некому, кроме двери, а дверь — это
// прогонщик.
функция «Шаг функции JS»
  принимает «акк»: «Секции JS», «функция»: «Функция JS», «общее»: «Общее JS», «прогонщик»: признак
  возвращает «Секции JS»
  пусть «блок» равно («Печать функции JS» от «функция» и «общее» и («акк».«состояние»))
  пусть «после тела» равно (запись «Секции JS» с «состояние» равным («блок».«состояние») и «части» равным (добавить («блок».«вывод») к («акк».«части»)))
  если (если «прогонщик» то ((длина («функция».«предусловия»)) больше 0) иначе нет)
    то «Шаг гейта функции JS» от «после тела» и «функция» и «общее»
    иначе «после тела»

функция «Шаг гейта функции JS»
  принимает «акк»: «Секции JS», «функция»: «Функция JS», «общее»: «Общее JS»
  возвращает «Секции JS»
  пусть «гейт» равно («Печать гейта JS» от «функция» и «общее» и («акк».«состояние»))
  запись «Секции JS» с «состояние» равным («гейт».«состояние») и «части» равным (добавить («гейт».«вывод») к («акк».«части»))

функция «Печать секций JS»
  принимает «общее»: «Общее JS», «состояние»: «Состояние JS», «прогонщик»: признак
  возвращает «Секции JS»
  пусть «после записей» равно (свёртка («общее».«записи») начиная с (запись «Секции JS» с «состояние» равным «состояние» и «части» равным пустой список) как «акк» и «запись типа» → «Шаг записи JS» от «акк» и «запись типа» и «общее»)
  пусть «после сумм» равно (свёртка («общее».«суммы») начиная с «после записей» как «акк» и «сумма» → «Шаг суммы JS» от «акк» и «сумма» и «общее»)
  свёртка («общее».«функции») начиная с «после сумм» как «акк» и «функция» → «Шаг функции JS» от «акк» и «функция» и «общее» и «прогонщик»

тотальная функция «Шапка модуля JS»
  принимает «есть модуль»: признак, «модуль»: строка, «конкурентная»: признак, «прогонщик»: признак, «плановая»: признак
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить ["// Модуль flang: «", «модуль», "»."] по "") иначе "// Программа flang без имени модуля.")
  пусть «общее» равно (соединить [
    "// Сгенерировано flang (бэкенд JavaScript, flang/self/emit-js.flang). Не редактировать руками.",
    «строка модуля»,
    "// Правьте исходник на flang и печатайте заново: любая правка здесь потеряется.",
    "// Модуль самодостаточен — ни одной зависимости, работает и в Node, и в браузере."
  ] по "\n")
  пусть «с прогонщиком» равно (если «прогонщик» то (соединить [«общее», "\n// Рядом напечатан прогонщик: node flang_cli.js ./<этот файл> — JSON на входе, JSON на выходе."] по "") иначе «общее»)
  пусть «с конкурентностью» равно (если «конкурентная» то (соединить [«с прогонщиком», "\n// Программа с процессами: планировщик конкурентности напечатан внутрь модуля.\n// Конкурентность есть, параллелизма нет и не будет — один поток (concRun, concPlan)."] по "") иначе «с прогонщиком»)
  если «плановая»
    то соединить [«с конкурентностью», "\n// Программа с планом: исполнитель ввода-вывода напечатан внутрь модуля.\n// Поручения описывает программа, исполняет хозяин — среда снаружи (ioRun, ioPlan)."] по ""
    иначе «с конкурентностью»

// ── прогонщик рядом с модулем ─────────────────────────────────────────────
//
// Прогонщик (`flang_cli.js`) печатается ВТОРЫМ файлом и байт в байт одинаково
// для любой программы — как `flang_cli.c` у C и `flang_cli.py` у Python. Его
// исходник приезжает параметром по той же причине, по какой приезжает
// планировщик: читать файлы язык не умеет и не должен.
//
// Всё, что прогонщик знает об этой конкретной программе, — таблица
// `$PROGRAM` в самом модуле: имена flang → функции, фабрика и узнавание
// варианта, и размер стека, посчитанный ЗДЕСЬ, при печати.

// Сколько мегабайт стека просить под объявленный предел глубины. Кадр считаем
// по 8 КиБ — вдвое с лишним больше худшего измеренного, тем же правилом, каким
// взяты 16 КиБ у `FL_STACK_PER_FRAME` в C. Ноль и меньше значат «предела нет»:
// тогда просим потолок и оставляем ответ сторожу.
тотальная функция «Стек в МиБ JS»
  принимает «предел глубины»: число
  возвращает число
  если «предел глубины» не больше 0
    то 1024
    иначе
      пусть «остаток» равно («предел глубины» остаток от 128)
      пусть «вниз» равно ((«предел глубины» минус «остаток») делить на 128)
      пусть «вверх» равно (если «остаток» равен 0 то «вниз» иначе («вниз» плюс 1))
      пусть «низом» равно (если «вверх» больше 8 то «вверх» иначе 8)
      если «низом» больше 1024 то 1024 иначе «низом»

тотальная функция «Строка таблицы JS»
  принимает «функция»: «Функция JS», «общее»: «Общее JS»
  возвращает строка
  соединить ["    [", («Печать строки» от («функция».«имя»)), ", ", («Значение по ключу» от («общее».«ид функций») и («функция».«имя»)), "],"] по ""

// Таблица, по которой прогонщик находит эту программу: имена flang → функции
// модуля (арность он возьмёт у самой функции), фабрика варианта — построить
// вариант с ЛЮБЫМ именем иначе нечем, — узнавание варианта на обратном пути и
// размер стека под объявленный предел глубины.
//
// Ряд таблицы гейтов: имя flang → функция-граница модуля.
тотальная функция «Строка гейта JS»
  принимает «пара»: «Пара имён»
  возвращает строка
  соединить ["    [", («Печать строки» от («пара».«ключ»)), ", ", («пара».«значение»), "],"] по ""

// Гейты предусловий — только у программы, где есть хоть одно `требует`.
// Программа без него не получает ни поля, ни строки: печать обязана остаться
// побайтово прежней.
тотальная функция «Блок гейтов JS»
  принимает «общее»: «Общее JS»
  возвращает список строки
  если пусто («общее».«ид границ»)
    то пустой список
    иначе [
      "  /* Предусловия (`требует`) — той же дверью, что и типы: прогонщик зовёт",
      "     гейт ДО вызова, потому что значение приехало снаружи и вызывающего,",
      "     который снял бы требование на проверке, у него нет. В тело функции",
      "     предусловие не печатается: внутри программы оно доказано. */",
      "  pre: new Map([",
      (соединить (отобразить («общее».«ид границ») как «пара» → «Строка гейта JS» от «пара») по "\n"),
      "  ]),"
    ]

// ═══════════════════════════ граница входа ═══════════════════════════
//
// Объявленные типы параметров — данными, полем `entry` таблицы `$PROGRAM`.
// Прогонщик сверяет по ним значения, пришедшие снаружи, ДО вызова: обещание
// «тотальная» доказано НА ТИПЕ, и значение вне типа выносит вместе с типом и
// доказательство.
//
// Сама таблица здесь не считается, а приезжает настройками — ровно как у
// печати в C. Считает её тот, кто уже прошёл по объявлениям программы: слой
// типов, а у двоичного — впечатанная таблица собственной программы. Второй
// такой обход разошёлся бы с первым на первом же параметре, чей тип объявлен
// через синоним.

тотальная функция «Ряд границы JS»
  принимает «поля»: список строки
  возвращает строка
  соединить ["      { ", (соединить «поля» по ", "), " },"] по ""

// Пустой список печатается ОДНОЙ строкой `имя: [],`, а не тремя: рядов просто
// нет, а не есть пустой ряд.
тотальная функция «Список границы JS»
  принимает «имя»: строка, «ряды»: список строки
  возвращает список строки
  если пусто «ряды»
    то [(соединить ["    ", «имя», ": [],"] по "")]
    иначе «Слить строки» от («Слить строки» от [(соединить ["    ", «имя», ": ["] по "")] и «ряды») и ["    ],"]

тотальная функция «Признак JS»
  принимает «значение»: признак
  возвращает строка
  если «значение» то "true" иначе "false"

тотальная функция «Ряд типа входа JS»
  принимает «тип»: «Тип входа»
  возвращает строка
  «Ряд границы JS» от [
    (соединить ["kind: ", («Печать строки» от («тип».«вид»))] по ""),
    (соединить ["name: ", («Печать строки» от («тип».«имя»))] по ""),
    (соединить ["owner: ", («Печать строки» от («тип».«владелец»))] по ""),
    (соединить ["nothing: ", («Признак JS» от («тип».«ничто»))] по ""),
    (соединить ["integer: ", («Признак JS» от («тип».«целое»))] по ""),
    (соединить ["range: ", («Признак JS» от («тип».«отрезок»))] по ""),
    (соединить ["low: ", («Число JS» от («тип».«низ»))] по ""),
    (соединить ["high: ", («Число JS» от («тип».«верх»))] по ""),
    (соединить ["item: ", (к строке («тип».«элемент»))] по ""),
    (соединить ["fieldAt: ", (к строке («тип».«поле с»))] по ""),
    (соединить ["fieldCount: ", (к строке («тип».«полей»))] по ""),
    (соединить ["variantAt: ", (к строке («тип».«вариант с»))] по ""),
    (соединить ["variantCount: ", (к строке («тип».«вариантов»))] по "")
  ]

тотальная функция «Ряд поля входа JS»
  принимает «поле»: «Поле входа»
  возвращает строка
  «Ряд границы JS» от [
    (соединить ["name: ", («Печать строки» от («поле».«имя»))] по ""),
    (соединить ["type: ", (к строке («поле».«тип»))] по "")
  ]

тотальная функция «Ряд варианта входа JS»
  принимает «вариант»: «Вариант входа»
  возвращает строка
  «Ряд границы JS» от [
    (соединить ["name: ", («Печать строки» от («вариант».«имя»))] по ""),
    (соединить ["fieldAt: ", (к строке («вариант».«поле с»))] по ""),
    (соединить ["fieldCount: ", (к строке («вариант».«полей»))] по "")
  ]

тотальная функция «Ряд параметра входа JS»
  принимает «параметр»: «Параметр входа»
  возвращает строка
  «Ряд границы JS» от [
    (соединить ["fn: ", («Печать строки» от («параметр».«функция»))] по ""),
    (соединить ["name: ", («Печать строки» от («параметр».«параметр»))] по ""),
    (соединить ["type: ", (к строке («параметр».«тип»))] по "")
  ]

тотальная функция «Граница входа JS»
  принимает «настройки»: «Настройки JS»
  возвращает список строки
  пусть «шапка» равно [
    "  /* Граница входа: объявленные типы параметров данными. Прогонщик сверяет",
    "     по ним значения, пришедшие снаружи, ДО вызова (`checkEntry` в",
    "     flang_cli.js); вид «неизвестно» не сверяется — одной таблицы ему мало. */",
    "  entry: {"
  ]
  пусть «типы» равно («Список границы JS» от "types" и (отобразить («настройки».«типы входа») как «тип» → «Ряд типа входа JS» от «тип»))
  пусть «поля» равно («Список границы JS» от "fields" и (отобразить («настройки».«поля входа») как «поле» → «Ряд поля входа JS» от «поле»))
  пусть «варианты» равно («Список границы JS» от "variants" и (отобразить («настройки».«варианты входа») как «вариант» → «Ряд варианта входа JS» от «вариант»))
  пусть «параметры» равно («Список границы JS» от "params" и (отобразить («настройки».«параметры входа») как «параметр» → «Ряд параметра входа JS» от «параметр»))
  пусть «до полей» равно («Слить строки» от «шапка» и «типы»)
  пусть «до вариантов» равно («Слить строки» от «до полей» и «поля»)
  пусть «до параметров» равно («Слить строки» от «до вариантов» и «варианты»)
  «Слить строки» от («Слить строки» от «до параметров» и «параметры») и ["  },"]

тотальная функция «Таблица программы JS»
  принимает «общее»: «Общее JS», «стек»: число, «настройки»: «Настройки JS»
  возвращает строка
  соединить («Слить строки» от («Слить строки» от [
    "/**",
    " * Связь этого модуля с прогонщиком (`flang_cli.js`): имена flang → функции,",
    " * фабрика и узнавание варианта, стек под объявленный предел глубины (МиБ) и",
    " * объявленные типы параметров — граница входа.",
    " * Прогонщик — соседний файл, а не часть модуля: в браузер он не едет.",
    " *",
    " * @type {{functions: Map<string, Function>, variant: Function, isVariant: Function, stackMb: number, entry: object}}",
    " */",
    "export const $PROGRAM = {",
    // Приведение стоит на САМОМ литерале массива, а не только на `$PROGRAM`:
    // пометка `@type` выше до пар внутри `new Map([…])` не доходит. TypeScript
    // берёт тип пары из ПЕРВОЙ строки таблицы, и каждая следующая функция с
    // другой подписью становится замечанием TS2769.
    //
    // Программа без единой функции даёт `new Map(… ([` и `])),` подряд, БЕЗ пустой
    // строки между ними: рядов просто нет в списке, а не пустой ряд.
    (соединить («Непустые части JS» от ["  functions: new Map(/** @type {[string, Function][]} */ ([", (соединить (отобразить («общее».«функции») как «функция» → «Строка таблицы JS» от «функция» и «общее») по "\n")]) по "\n"),
    "  ])),"
  ] и («Блок гейтов JS» от «общее»)) и («Хвост таблицы JS» от «стек» и «настройки»)) по "\n"

// Хвост таблицы `$PROGRAM`: фабрика варианта, узнавание варианта, стек и
// граница входа. Отдельной функцией, потому что склейка трёх списков в теле
// «Таблицы программы JS» читалась бы как одна строка на сто знаков.
тотальная функция «Хвост таблицы JS»
  принимает «стек»: число, «настройки»: «Настройки JS»
  возвращает список строки
  пусть «начало» равно [
    "  variant: (name, fields) => new $FlangVariant(name, fields),",
    "  isVariant: $isVariant,",
    (соединить ["  stackMb: ", (к строке «стек»), ","] по "")
  ]
  «Слить строки» от («Слить строки» от «начало» и («Граница входа JS» от «настройки»)) и ["}"]

// Шапка прогонщика: чей он и как его звать. Тело — байт в байт тот файл,
// который приехал параметром.
тотальная функция «Шапка прогонщика JS»
  принимает «есть модуль»: признак, «модуль»: строка, «путь»: строка
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить ["// Модуль flang: «", «модуль», "»."] по "") иначе "// Программа flang без имени модуля.")
  соединить [
    "// Сгенерировано flang (бэкенд JavaScript, flang/self/emit-js.flang). Не редактировать руками.",
    «строка модуля»,
    "// Файл: прогонщик — JSON на входе, JSON на выходе.",
    (соединить ["// Запуск: node flang_cli.js ./", «путь»] по "")
  ] по "\n"

тотальная функция «Имя модуля JS»
  принимает «программа»: «Значение»
  возвращает строка
  «Строка поля» от «программа» и "module"

тотальная функция «Есть имя модуля JS»
  принимает «программа»: «Значение»
  возвращает признак
  (длина («Имя модуля JS» от «программа»)) больше 0


// ═════════════════════ имена, занятые самой целью JS ═════════════════════
//
// Имя модуля flang доезжает до цели именем в ЕЁ пространстве имён, а часть этого
// пространства цель занимает сама. Улика: `модуль «JSON»` печатался в `json.py`
// рядом с прогонщиком, тот делал `import json` и получал НАШ модуль вместо
// библиотеки — ломалось не при печати, а при запуске.
//
// Свободное имя возвращается КАК ЕСТЬ: у программы, чьё имя цель не занимала,
// вывод не меняется ни на байт. Занятое обходится СУФФИКСОМ: приставка `flang_`
// у бэкенда уже занята — так зовутся `flang_runtime` и `flang_cli`, и по ней
// напечатанное отличают от программы. Отказывать нельзя: имя автор выбрал
// законно, а набор занятого у цели свой и меняется от её версии.

// Занятое у JavaScript: имён стандартной библиотеки, которые ехали бы файлом
// рядом, у этой цели нет — программа самодостаточна, — но прогонщик печать
// кладёт рядом всегда. Улика: `модуль «Flang cli»` печатался в `flang_cli.js`
// ПОВЕРХ прогонщика, и в каталоге оставался один файл вместо двух. Отказ сборки
// такое не даёт: `node --check` на уцелевшем файле проходит.
тотальная функция «Занято целью JS»
  возвращает список строки
  ["flang_cli"]

тотальная функция «Обойти занятое целью JS»
  принимает «имя»: строка
  возвращает строка
  если «Занято целью JS» содержит «имя»
    то соединить «имя» с "_flang"
    иначе «имя»

тотальная функция «Имя файла программы JS»
  принимает «программа»: «Значение», «настройки»: «Настройки JS»
  возвращает строка
  если («настройки».«есть путь»)
    то «настройки».«путь»
    иначе
      если «Есть имя модуля JS» от «программа»
        то соединить («Обойти занятое целью JS» от («Змейка» от («Имя модуля JS» от «программа»))) с ".js"
        иначе "program.js"

тотальная функция «Непустые части JS»
  принимает «части»: список строки
  возвращает список строки
  отфильтровать «части» где «часть» → (длина «часть») больше 0

// Первым делом программа ПОНИЖАЕТСЯ: `функция «Имя»` становится вариантом,
// `ф от 5` — вызовом диспетчера, и дальше печать высшего порядка не видит
// вовсе.
функция «Печать программы JS»
  принимает «программа»: «Значение», «настройки»: «Настройки JS»
  возвращает «Итог печати JS»
  пусть «понижено» равно («Дефункционализировать» от «программа»)
  пусть «общее» равно («Собрать общее JS» от «понижено»)
  пусть «секции» равно («Печать секций JS» от «общее» и «Пустое состояние JS» и («настройки».«прогонщик»))
  пусть «конкурентная» равно («общее».«конкурентная»)
  пусть «плановая» равно («общее».«плановая»)
  /* Планировщик отказывает через `$fail`, как и всё остальное в модуле, и
     считает ОБЩИЙ счётчик витков (`$step`, `$top`, `$LIMITS`). Затребованы они
     здесь явно: программа с процессами может не иметь ни одной рекурсивной
     функции — а планировщику счётчик нужен всё равно, потому что запас витков
     объявлен автором и обязан работать. */
  пусть «до плана» равно (если «конкурентная» то («Затребовать JS» от («Затребовать JS» от («секции».«состояние») и "$fail") и "$top") иначе («секции».«состояние»))
  пусть «план» равно (если «конкурентная» то («Печать конкурентности JS» от «понижено» и «общее» и «до плана») иначе (запись «Блок JS» с «состояние» равным «до плана» и «вывод» равным ""))
  /* Рычаг глубины печатается там, где глубине есть куда расти, — то есть при
     рекурсии. Программе без единого цикла в графе вызовов он не нужен: у неё
     глубина ограничена самим графом, и счётчика она не получает вовсе. */
  /* Исполнитель отказывает через `$fail`, как и всё остальное в модуле, и узнаёт
     вариант через `$isVariant`. Оба затребованы здесь явно: сумм в программе с
     планом всегда хватает (словарь ввода-вывода приписывает ей разборщик), а вот
     рекурсии в ней может не быть ни одной — и `$fail` тогда не пришёл бы ни от кого. */
  пусть «до ввода-вывода» равно (если «плановая» то («Затребовать JS» от («Затребовать JS» от («Затребовать JS» от («план».«состояние») и "$fail") и "$isVariant") и "$FlangVariant") иначе («план».«состояние»))
  пусть «ввод-вывод» равно (если «плановая» то («Печать планов» от «понижено» и «общее» и «до ввода-вывода») иначе (запись «Блок JS» с «состояние» равным «до ввода-вывода» и «вывод» равным ""))
  пусть «после рычага» равно (если (длина («общее».«рекурсивные»)) больше 0 то («Затребовать JS» от («ввод-вывод».«состояние») и "$callDeep") иначе («ввод-вывод».«состояние»))
  /* Таблица для прогонщика — единственное, что модуль знает о нём. Печатается
     она вместе с ним и отменяется вместе с ним (`прогонщик` равно нет).

     `$FlangVariant` и `$isVariant` затребованы ЯВНО, а не потому, что в
     программе есть суммы: их там может не быть вовсе, а вариант всё равно
     обязан доехать по проводу — и обязан быть узнан как вариант. Иначе
     напечатанный код разобрал бы его как запись и ответил не тем отказом, чем
     интерпретатор, ровно на тех входах, где сверка и ищет расхождения. */
  пусть «состояние» равно (если («настройки».«прогонщик») то («Затребовать JS» от («Затребовать JS» от «после рычага» и "$FlangVariant") и "$isVariant") иначе «после рычага»)
  пусть «таблица» равно (если («настройки».«прогонщик») то («Таблица программы JS» от «общее» и («Стек в МиБ JS» от («настройки».«предел глубины»)) и «настройки») иначе "")
  пусть «рантайм» равно («Печать рантайма JS» от («состояние».«нужно») и «настройки» и «конкурентная» и «плановая»)
  пусть «шапка» равно («Шапка модуля JS» от («Есть имя модуля JS» от «понижено») и («Имя модуля JS» от «понижено») и «конкурентная» и («настройки».«прогонщик») и «плановая»)
  пусть «части» равно («Слить строки» от («Слить строки» от («Слить строки» от («Слить строки» от [«шапка», «рантайм»] и («секции».«части»)) и [(«план».«вывод»)]) и [(«ввод-вывод».«вывод»)]) и [«таблица»])
  пусть «содержимое» равно (соединить («Непустые части JS» от «части») по "\n\n")
  пусть «путь» равно («Имя файла программы JS» от «понижено» и «настройки»)
  пусть «файл» равно (запись «Файл JS» с «путь» равным «путь» и «содержимое» равным («Снять двунаправленные JS» от (соединить «содержимое» с "\n")))
  /* Прогонщик — ВТОРЫМ файлом, и порядок здесь не вкус: модуль остаётся
     первым для всех, кто берёт напечатанное программно. */
  пусть «текст прогонщика» равно («Снять двунаправленные JS» от (соединить [(«Шапка прогонщика JS» от («Есть имя модуля JS» от «понижено») и («Имя модуля JS» от «понижено») и «путь»), "\n", («настройки».«исходник прогонщика»)] по ""))
  пусть «файлы» равно (если («настройки».«прогонщик») то [«файл», (запись «Файл JS» с «путь» равным "flang_cli.js" и «содержимое» равным «текст прогонщика»)] иначе [«файл»])
  запись «Итог печати JS» с «файлы» равным «файлы» и «ошибка» равным («Первая ошибка JS» от («общее».«ошибка») и («состояние».«ошибка»))

// ═══════════════════════════ конкурентность ═══════════════════════════
//
// Процессы, надзоры и прогоны печатаются ДАННЫМИ — одним объектом уровня
// модуля, — а планировщик приезжает готовым (`js/flang_conc.js`) и печатается
// целиком. Тот же приём, что в C и в Elixir, и по той же причине: надзор в
// flang — объявление, и одно объявление обязано остаться одним местом в
// напечатанном коде.
//
// Разница с C ровно одна и она в пользу JavaScript: обработчик кладётся в план
// САМОЙ ФУНКЦИЕЙ, а не именем. В C планировщику нужен диспетчер по имени,
// потому что указателя на функцию с переменной арностью там не выразить; здесь
// функция — значение, и второй словарь «имя → функция» был бы лишней сущностью.

тотальная функция «Это число в скаляре JS»
  принимает «скаляр»: «Скаляр»
  возвращает признак
  разбор «скаляр»
    случай вариант «Скаляр число» с «значение» как «значение»
      то да
    случай любое
      то нет

тотальная функция «Это число JS»
  принимает «узел»: «Значение»
  возвращает признак
  разбор «узел»
    случай вариант «Значение скаляра» с «скаляр» как «скаляр»
      то «Это число в скаляре JS» от «скаляр»
    случай любое
      то нет

// `Number.isFinite`: проверка идёт по напечатанному виду, а не сравнением —
// равенство скаляров в flang это Object.is, и `NaN равен NaN` даёт «да».
тотальная функция «Конечное JS»
  принимает «значение»: число
  возвращает признак
  пусть «текст» равно (к строке «значение»)
  если «текст» равен "NaN"
    то нет
    иначе
      если «текст» равен "Infinity"
        то нет
        иначе
          если «текст» равен "-Infinity"
            то нет
            иначе да

// `Math.trunc`: отбрасывание дробной части к нулю. Остаток от единицы имеет
// знак делимого, поэтому вычитание работает в обе стороны.
тотальная функция «Целая часть JS»
  принимает «значение»: число
  возвращает число
  пример «Дробь вниз»
    дано «значение» равно 5.7
    ожидается 5
  пример «Отрицательная дробь к нулю»
    дано «значение» равно -5.7
    ожидается -5
  «значение» минус («значение» остаток от 1)

объект «План JS»
  «состояние»: «Состояние JS»
  «вывод»: строка

// Функция, которой в программе нет, — это отказ ПЕЧАТИ, а не пустое место в
// плане: молча напечатать процесс без обработчика значило бы вернуться к тому
// самому поведению, из-за которого шесть целей теряли процессы.
тотальная функция «Имя из плана JS»
  принимает «состояние»: «Состояние JS», «общее»: «Общее JS», «имя»: строка, «роль»: строка, «процесс»: строка
  возвращает «Свежее JS»
  если «Есть в таблице» от («общее».«ид функций») и «имя»
    то запись «Свежее JS» с «состояние» равным «состояние» и «имя» равным («Значение по ключу» от («общее».«ид функций») и «имя»)
    иначе запись «Свежее JS» с «состояние» равным («Записать ошибку JS» от «состояние» и (соединить [«роль», " «", «имя», "» процесса «", «процесс», "» в программе не объявлен: напечатать процесс нечем"] по "")) и «имя» равным ""

// Имена вариантов объявленного типа — то, чем планировщик сверяет письмо с
// объявлением адресата при доставке (`неПодходит` в flang_conc.js). Пустой
// список значит «сверять нечем»: типа с таким именем нет либо он не сумма, и
// имени варианта у письма тогда нет тоже.
тотальная функция «Варианты типа JS»
  принимает «программа»: «Значение», «имя»: строка
  возвращает список строки
  свёртка («Элементы поля» от «программа» и "types") начиная с пустой список как «акк» и «тип» → (если ((«Строка поля» от «тип» и "name") равен «имя») и притом ((«Строка поля» от «тип» и "kind") равен "sum") то (свёртка («Элементы поля» от «тип» и "variants") начиная с «акк» как «набор» и «в» → добавить («Строка поля» от «в» и "name") к «набор») иначе «акк»)

// Список имён вариантов литералом JavaScript.
тотальная функция «Печать вариантов JS»
  принимает «варианты»: список строки
  возвращает строка
  соединить ["[", (соединить (отобразить «варианты» как «в» → («Печать строки» от «в»)) по ", "), "]"] по ""

тотальная функция «Тотальный обработчик JS»
  принимает «общее»: «Общее JS», «имя»: строка
  возвращает признак
  разбор («Найти функцию JS» от («общее».«функции») и «имя»)
    случай вариант «Есть функция JS» с «функция» как «найденная»
      то «найденная».«тотальная»
    случай «Нет функции JS»
      то нет

// Запас витков ставится ТОЛЬКО нетотальному обработчику: про тотальный
// доказано, что он завершится, и отсчитывать нечего.
тотальная функция «Запас процесса JS»
  принимает «узел»: «Значение», «тотальный»: признак
  возвращает число
  если «тотальный»
    то 0
    иначе «Целое поле или ноль JS» от «узел» и "budget"

тотальная функция «Целое поле или ноль JS»
  принимает «узел»: «Значение», «ключ»: строка
  возвращает число
  пусть «поле» равно («Взять поле» от «узел» и «ключ»)
  если «Это число JS» от «поле»
    то (если «Конечное JS» от («Число узла» от «поле») то («Целая часть JS» от («Число узла» от «поле»)) иначе 0)
    иначе 0

// Ноль — «ящик неограничен», ровно как ноль в запасе значит «считать нечего»:
// ящик в ноль сообщений проверка типов не пропускает, поэтому два смысла нуля
// здесь не сталкиваются.
тотальная функция «Ящик процесса JS»
  принимает «узел»: «Значение»
  возвращает число
  пусть «размер» равно («Целое поле или ноль JS» от «узел» и "mailbox")
  если «размер» больше 0
    то «размер»
    иначе 0

тотальная функция «Печать процесса JS»
  принимает «план»: «План JS», «узел»: «Значение», «общее»: «Общее JS», «программа»: «Значение»
  возвращает «План JS»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «обработчик» равно («Строка поля» от «узел» и "handler")
  пусть «начало» равно («Строка поля» от «узел» и "initial")
  пусть «вызвать» равно («Имя из плана JS» от («план».«состояние») и «общее» и «обработчик» и "обработчик" и «имя»)
  пусть «завести» равно («Имя из плана JS» от («вызвать».«состояние») и «общее» и «начало» и "начальное состояние" и «имя»)
  пусть «тотальный» равно («Тотальный обработчик JS» от «общее» и «обработчик»)
  пусть «строки» равно (соединить [
    («Строка вывода» от "    " и "{"),
    («Строка вывода» от "      " и (соединить ["имя: ", («Печать строки» от «имя»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["обработчик: ", («Печать строки» от «обработчик»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["вызвать: ", («вызвать».«имя»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["начало: ", («Печать строки» от «начало»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["завести: ", («завести».«имя»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["приниматьТип: ", («Печать строки» от («Строка поля» от «узел» и "accepts")), ","] по "")),
    («Строка вывода» от "      " и (соединить ["принимать: ", («Печать вариантов JS» от («Варианты типа JS» от «программа» и («Строка поля» от «узел» и "accepts"))), ","] по "")),
    («Строка вывода» от "      " и (соединить ["тотальный: ", (если «тотальный» то "true" иначе "false"), ","] по "")),
    («Строка вывода» от "      " и (соединить ["запас: ", (к строке («Запас процесса JS» от «узел» и «тотальный»)), ","] по "")),
    («Строка вывода» от "      " и (соединить ["ящик: ", (к строке («Ящик процесса JS» от «узел»)), ","] по "")),
    («Строка вывода» от "    " и "},")
  ] по "")
  запись «План JS» с «состояние» равным («завести».«состояние») и «вывод» равным (соединить («план».«вывод») с «строки»)

тотальная функция «Пары надзора JS»
  принимает «узлы»: список «Значение», «ключ»: строка
  возвращает строка
  соединить (отобразить «узлы» как «узел» → соединить ["[", («Печать строки» от («Строка поля» от «узел» и «ключ»)), ", ", («Печать строки» от («Строка поля» от «узел» и "strategy")), "]"] по "") по ", "

тотальная функция «Порог надзора JS»
  принимает «узел»: «Значение»
  возвращает строка
  пусть «порог» равно («Взять поле» от «узел» и "threshold")
  если «Это запись» от «порог»
    то соединить ["{ отказов: ", («Число JS» от («Число узла» от («Взять поле» от «порог» и "failures"))), ", окно: ", («Число JS» от («Число узла» от («Взять поле» от «порог» и "window"))), ", иначе: ", («Печать строки» от («Строка поля» от «порог» и "otherwise")), " }"] по ""
    иначе "null"

тотальная функция «Печать надзора JS»
  принимает «план»: «План JS», «узел»: «Значение», «общее»: «Общее JS»
  возвращает «План JS»
  пусть «строки» равно (соединить [
    («Строка вывода» от "    " и "{"),
    («Строка вывода» от "      " и (соединить ["имя: ", («Печать строки» от («Строка поля» от «узел» и "name")), ","] по "")),
    («Строка вывода» от "      " и (соединить ["процессы: [", («Пары надзора JS» от («Элементы поля» от «узел» и "watch") и "process"), "],"] по "")),
    («Строка вывода» от "      " и (соединить ["вложенные: [", («Пары надзора JS» от («Элементы поля» от «узел» и "nested") и "supervisor"), "],"] по "")),
    («Строка вывода» от "      " и (соединить ["порог: ", («Порог надзора JS» от «узел»), ","] по "")),
    («Строка вывода» от "    " и "},")
  ] по "")
  запись «План JS» с «состояние» равным («план».«состояние») и «вывод» равным (соединить («план».«вывод») с «строки»)

// Литерал входного сообщения прогона — отдельно от «Печать литерала JS», а не
// вместо неё, по одной причине: вариант в AST записан объектом
// `{ variant, fields }`, и «Печать литерала JS» напечатала бы такой объект
// ЗАПИСЬЮ с полями «variant» и «fields». Для сообщения прогона это была бы
// прямая ошибка — обработчик не сопоставил бы его ни с одним образцом.

// Объект ровно с двумя полями `variant` и `fields` — это вариант, а не запись.
тотальная функция «Вариант непустой JS»
  принимает «узел»: «Значение»
  возвращает признак
  пусть «имя» равно («Взять поле» от «узел» и "variant")
  если «Это строка» от «имя»
    то (если (длина («Строка узла» от «имя»)) больше 0 то («Это запись» от («Взять поле» от «узел» и "fields")) иначе нет)
    иначе нет

тотальная функция «Это закодированный вариант JS»
  принимает «узел»: «Значение»
  возвращает признак
  пусть «поля» равно («Поля узла» от «узел»)
  если (длина «поля») равен 2
    то
      пусть «ключи» равно (отобразить «поля» как «поле» → «поле».«ключ»)
      если «ключи» содержит "variant"
        то (если «ключи» содержит "fields" то («Вариант непустой JS» от «узел») иначе нет)
        иначе нет
    иначе нет

функция «Шаг сообщения JS»
  принимает «акк»: «Сборка JS», «узел»: «Значение», «общее»: «Общее JS»
  возвращает «Сборка JS»
  пусть «итог» равно («Сообщение прогона JS» от («акк».«состояние») и «узел» и «общее»)
  запись «Сборка JS» с «состояние» равным («итог».«состояние») и «вывод» равным («акк».«вывод») и «индекс» равным ((«акк».«индекс») плюс 1) и «части» равным (добавить («итог».«имя») к («акк».«части»))

функция «Шаг поля сообщения JS»
  принимает «акк»: «Сборка JS», «поле»: «Поле значения», «общее»: «Общее JS»
  возвращает «Сборка JS»
  пусть «итог» равно («Сообщение прогона JS» от («акк».«состояние») и («поле».«значение») и «общее»)
  запись «Сборка JS» с «состояние» равным («итог».«состояние») и «вывод» равным («акк».«вывод») и «индекс» равным ((«акк».«индекс») плюс 1) и «части» равным (добавить (соединить [(«Печать строки» от («поле».«ключ»)), ": ", («итог».«имя»)] по "") к («акк».«части»))

функция «Сообщения списком JS»
  принимает «состояние»: «Состояние JS», «элементы»: список «Значение», «общее»: «Общее JS»
  возвращает «Свежее JS»
  пусть «собрано» равно (свёртка «элементы» начиная с («Пустая сборка JS» от «состояние») как «акк» и «узел» → «Шаг сообщения JS» от «акк» и «узел» и «общее»)
  запись «Свежее JS» с «состояние» равным («собрано».«состояние») и «имя» равным (соединить ["[", (соединить («собрано».«части») по ", "), "]"] по "")

функция «Сообщение записью JS»
  принимает «состояние»: «Состояние JS», «поля»: список «Поле значения», «общее»: «Общее JS»
  возвращает «Свежее JS»
  пусть «собрано» равно (свёртка «поля» начиная с («Пустая сборка JS» от «состояние») как «акк» и «поле» → «Шаг поля сообщения JS» от «акк» и «поле» и «общее»)
  запись «Свежее JS» с «состояние» равным («собрано».«состояние») и «имя» равным (если пусто «поля» то "{}" иначе (соединить ["{ ", (соединить («собрано».«части») по ", "), " }"] по ""))

функция «Сообщение вариантом JS»
  принимает «состояние»: «Состояние JS», «узел»: «Значение», «общее»: «Общее JS»
  возвращает «Свежее JS»
  пусть «имя» равно («Строка узла» от («Взять поле» от «узел» и "variant"))
  пусть «известен» равно («Есть в таблице» от («общее».«ид вариантов») и «имя»)
  пусть «проверено» равно (если «известен» то «состояние» иначе («Записать ошибку JS» от «состояние» и (соединить ["входное сообщение прогона называет вариант «", «имя», "», которого в программе нет"] по "")))
  пусть «поля» равно («Поля узла» от («Взять поле» от «узел» и "fields"))
  пусть «собрано» равно (свёртка «поля» начиная с («Пустая сборка JS» от «проверено») как «акк» и «поле» → «Шаг поля сообщения JS» от «акк» и «поле» и «общее»)
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид вариантов») и «имя»)
  запись «Свежее JS» с «состояние» равным («собрано».«состояние») и «имя» равным (если пусто «поля» то (соединить «идентификатор» с "()") иначе (соединить [«идентификатор», "({ ", (соединить («собрано».«части») по ", "), " })"] по ""))

функция «Сообщение прогона JS»
  принимает «состояние»: «Состояние JS», «узел»: «Значение», «общее»: «Общее JS»
  возвращает «Свежее JS»
  разбор «узел»
    случай вариант «Значение списка» с «элементы» как «элементы»
      то «Сообщения списком JS» от «состояние» и «элементы» и «общее»
    случай вариант «Значение записи» с «поля» как «поля»
      то (если «Это закодированный вариант JS» от «узел» то («Сообщение вариантом JS» от «состояние» и «узел» и «общее») иначе («Сообщение записью JS» от «состояние» и «поля» и «общее»))
    случай любое
      то запись «Свежее JS» с «состояние» равным «состояние» и «имя» равным («Печать литерала JS» от «узел»)

функция «Шаг входа JS»
  принимает «акк»: «Сборка JS», «запись входа»: «Значение», «общее»: «Общее JS»
  возвращает «Сборка JS»
  пусть «итог» равно («Сообщение прогона JS» от («акк».«состояние») и («Взять поле» от «запись входа» и "message") и «общее»)
  запись «Сборка JS» с «состояние» равным («итог».«состояние») и «вывод» равным («акк».«вывод») и «индекс» равным ((«акк».«индекс») плюс 1) и «части» равным (добавить (соединить ["[", («Печать строки» от («Строка поля» от «запись входа» и "process")), ", ", («итог».«имя»), "]"] по "") к («акк».«части»))

тотальная функция «До семени JS»
  принимает «узел»: «Значение»
  возвращает число
  пусть «до» равно («Взять поле» от «узел» и "seedTo")
  если «Это ничто» от «до»
    то «Число узла» от («Взять поле» от «узел» и "seed")
    иначе «Число узла» от «до»

// Входные сообщения — ЗАМЫКАНИЕ, а не готовый список: значение строится
// конструктором этого же модуля, и строить его при загрузке значило бы платить
// за прогоны, которых никто не звал.
функция «Печать прогона JS»
  принимает «план»: «План JS», «узел»: «Значение», «общее»: «Общее JS»
  возвращает «План JS»
  пусть «вход» равно (свёртка («Элементы поля» от «узел» и "inbox") начиная с («Пустая сборка JS» от («план».«состояние»)) как «акк» и «запись входа» → «Шаг входа JS» от «акк» и «запись входа» и «общее»)
  пусть «строки» равно (соединить [
    («Строка вывода» от "    " и "{"),
    («Строка вывода» от "      " и (соединить ["имя: ", («Печать строки» от («Строка поля» от «узел» и "name")), ","] по "")),
    («Строка вывода» от "      " и (соединить ["семя: ", («Число JS» от («Число узла» от («Взять поле» от «узел» и "seed"))), ","] по "")),
    («Строка вывода» от "      " и (соединить ["доСемени: ", («Число JS» от («До семени JS» от «узел»)), ","] по "")),
    («Строка вывода» от "      " и (соединить ["вход: () => [", (соединить («вход».«части») по ", "), "],"] по "")),
    («Строка вывода» от "    " и "},")
  ] по "")
  запись «План JS» с «состояние» равным («вход».«состояние») и «вывод» равным (соединить («план».«вывод») с «строки»)

тотальная функция «Хвост плана JS»
  возвращает строка
  соединить [
    "",
    "/**",
    " * План конкурентности этого модуля: процессы, надзоры, прогоны.",
    " *",
    " * Отдаётся как есть, а не копией: план не меняется ни планировщиком, ни",
    " * прогоном — состояние прогона живёт в самом прогоне.",
    " */",
    "export function concPlan() {",
    "  return $conc",
    "}",
    "",
    "/**",
    " * Прогон объявленной программы: одно семя — один журнал доставок, побайтово.",
    " *",
    " * Конкурентность здесь есть, параллелизма нет: один поток. Наблюдаемая",
    " * семантика от этого не беднее — набор возможных исходов определён",
    " * чередованием, а не числом ядер, и чередование выбирает семя.",
    " *",
    " * @param {string} имя имя объявленного прогона",
    " * @param {{ семя?: number, пробегов?: number, журнал?: boolean }} [настройки]",
    " * @returns {object} исход, состояния, живые, отказы, решения, наверх, время,",
    " *   пробегов, витки и — если не отключён признаком `журнал` — журнал доставок",
    " */",
    "export function concRun(имя, настройки = {}) {",
    "  return $concПрогон($conc, имя, настройки)",
    "}"
  ] по "\n"

функция «Печать конкурентности JS»
  принимает «программа»: «Значение», «общее»: «Общее JS», «состояние»: «Состояние JS»
  возвращает «Блок JS»
  пусть «пусто» равно (запись «План JS» с «состояние» равным «состояние» и «вывод» равным "")
  пусть «процессы» равно (свёртка («Элементы поля» от «программа» и "processes") начиная с «пусто» как «акк» и «узел» → «Печать процесса JS» от «акк» и «узел» и «общее» и «программа»)
  пусть «после процессов» равно (запись «План JS» с «состояние» равным («процессы».«состояние») и «вывод» равным "")
  пусть «надзоры» равно (свёртка («Элементы поля» от «программа» и "supervisors") начиная с «после процессов» как «акк» и «узел» → «Печать надзора JS» от «акк» и «узел» и «общее»)
  пусть «после надзоров» равно (запись «План JS» с «состояние» равным («надзоры».«состояние») и «вывод» равным "")
  пусть «прогоны» равно (свёртка («Элементы поля» от «программа» и "runs") начиная с «после надзоров» как «акк» и «узел» → «Печать прогона JS» от «акк» и «узел» и «общее»)
  пусть «вывод» равно (соединить [
    («Строка вывода» от "" и "/* ── План конкурентности: процессы, надзоры и прогоны данными ── */"),
    («Строка вывода» от "" и "const $conc = {"),
    («Строка вывода» от "" и "  процессы: ["),
    («процессы».«вывод»),
    («Строка вывода» от "" и "  ],"),
    («Строка вывода» от "" и "  надзоры: ["),
    («надзоры».«вывод»),
    («Строка вывода» от "" и "  ],"),
    («Строка вывода» от "" и "  прогоны: ["),
    («прогоны».«вывод»),
    («Строка вывода» от "" и "  ],"),
    («Строка вывода» от "" и "}"),
    «Хвост плана JS»
  ] по "")
  запись «Блок JS» с «состояние» равным («прогоны».«состояние») и «вывод» равным «вывод»

// ═══════════════════════════ план ввода-вывода ═══════════════════════════
//
// План — объявление из четырёх строк: имя, тип состояния, функция начала и
// функция шага. Печатается он ДАННЫМИ, ровно как план конкурентности выше, и
// по той же причине: объявление в flang обязано остаться одним местом в
// напечатанном коде.
//
// Разница с планом конкурентности ровно одна: там цикл выбирает СЛЕДУЮЩИЙ
// процесс и потому живёт внутри модуля целиком, а здесь между двумя шагами
// управление обязано выйти НАРУЖУ — к хозяину, у которого есть экран, часы и
// сеть. Поэтому наружу торчат две двери, а не одна: `ioPlan()` отдаёт описатель
// тому, кто хочет собрать цикл сам, а `ioRun(имя, хозяин)` крутит готовый цикл,
// дожидаясь хозяина на каждом поручении.

тотальная функция «Имя из плана ввода-вывода»
  принимает «состояние»: «Состояние JS», «общее»: «Общее JS», «имя»: строка, «роль»: строка, «план»: строка
  возвращает «Свежее JS»
  если «Есть в таблице» от («общее».«ид функций») и «имя»
    то запись «Свежее JS» с «состояние» равным «состояние» и «имя» равным («Значение по ключу» от («общее».«ид функций») и «имя»)
    иначе запись «Свежее JS» с «состояние» равным («Записать ошибку JS» от «состояние» и (соединить [«роль», " «", «имя», "» плана «", «план», "» в программе не объявлена: напечатать план нечем"] по "")) и «имя» равным ""

// Тип состояния едет ИМЕНЕМ, а не устройством: хозяину он нужен не для разбора
// значения, а для того, чтобы назвать его в диагностике. Разбирать состояние
// хозяин не вправе — оно принадлежит программе.
тотальная функция «Печать одного плана»
  принимает «план»: «План JS», «узел»: «Значение», «общее»: «Общее JS»
  возвращает «План JS»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «начало» равно («Имя из плана ввода-вывода» от («план».«состояние») и «общее» и («Строка поля» от «узел» и "initial") и "начальное состояние" и «имя»)
  пусть «шаг» равно («Имя из плана ввода-вывода» от («начало».«состояние») и «общее» и («Строка поля» от «узел» и "handler") и "функция шага" и «имя»)
  пусть «строки» равно (соединить [
    («Строка вывода» от "    " и "{"),
    («Строка вывода» от "      " и (соединить ["имя: ", («Печать строки» от «имя»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["состояние: ", («Печать строки» от («Строка поля» от «узел» и "state")), ","] по "")),
    («Строка вывода» от "      " и (соединить ["начало: ", («начало».«имя»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["шаг: ", («шаг».«имя»), ","] по "")),
    («Строка вывода» от "    " и "},")
  ] по "")
  запись «План JS» с «состояние» равным («шаг».«состояние») и «вывод» равным (соединить («план».«вывод») с «строки»)

тотальная функция «Хвост плана ввода-вывода»
  возвращает строка
  соединить [
    "",
    "/**",
    " * Планы ввода-вывода этого модуля: имя, тип состояния, начало и шаг.",
    " *",
    " * Отдаётся как есть, а не копией: план — объявление, и меняться ему негде.",
    " * Нужен тому, кто крутит цикл поручений сам, — например хозяину, у которого",
    " * своё представление о том, когда остановиться.",
    " */",
    "export function ioPlan() {",
    "  return $io",
    "}",
    "",
    "/**",
    " * Прогон плана: поручения наружу, отклики внутрь.",
    " *",
    " * Язык остаётся чистым: поручение — это ОПИСАНИЕ действия, обычное значение",
    " * обычной суммы, а исполняет его `исполнить` — хозяин, среда, в которую",
    " * напечатан модуль. Хозяин вправе ответить обещанием, и тогда тянущий цикл",
    " * становится толкающим: стек на время ожидания пуст.",
    " *",
    " * @param {string} имя имя объявленного плана; пусто — единственный",
    " * @param {(поручение: object) => object|Promise<object>} исполнить хозяин",
    " * @param {{ поручений?: number, журнал?: boolean }} [настройки] ноль поручений —",
    " *   без предела; журнал по умолчанию не ведётся",
    " * @returns {Promise<object>} значение плана, число поручений и журнал",
    " */",
    "export function ioRun(имя, исполнить, настройки = {}) {",
    "  return $ioПрогон($io, имя, исполнить, настройки)",
    "}"
  ] по "\n"

функция «Печать планов»
  принимает «программа»: «Значение», «общее»: «Общее JS», «состояние»: «Состояние JS»
  возвращает «Блок JS»
  пусть «пусто» равно (запись «План JS» с «состояние» равным «состояние» и «вывод» равным "")
  пусть «планы» равно (свёртка («Элементы поля» от «программа» и "plans") начиная с «пусто» как «акк» и «узел» → «Печать одного плана» от «акк» и «узел» и «общее»)
  пусть «вывод» равно (соединить [
    («Строка вывода» от "" и "/* ── План ввода-вывода: объявления данными ── */"),
    («Строка вывода» от "" и "const $io = {"),
    («Строка вывода» от "" и "  планы: ["),
    («планы».«вывод»),
    («Строка вывода» от "" и "  ],"),
    («Строка вывода» от "" и "  /* Фабрика варианта: начальный отклик «Пока ничего» строит сам исполнитель,"),
    («Строка вывода» от "" и "     а построить вариант иначе нечем. Второго словаря «имя → конструктор»"),
    («Строка вывода» от "" и "     рядом с этим полем нет намеренно — исполнителю нужен ровно один. */"),
    («Строка вывода» от "" и "  вариант: (имя, поля) => new $FlangVariant(имя, поля),"),
    («Строка вывода» от "" и "}"),
    «Хвост плана ввода-вывода»
  ] по "")
  запись «Блок JS» с «состояние» равным («планы».«состояние») и «вывод» равным «вывод»
