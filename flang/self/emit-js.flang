  если «есть проверка»
    то (если «открыто» то («Строка вывода» от «отступ» и (соединить ["} else if (", «проверка», ") {"] по "")) иначе («Строка вывода» от «отступ» и (соединить ["if (", «проверка», ") {"] по "")))
    иначе (если «открыто» то («Строка вывода» от «отступ» и "} else {") иначе («Строка вывода» от «отступ» и "{"))

функция «Печать разбора»
  принимает «узел»: «Значение», «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
