объект «Секции»
  «состояние»: «Состояние»
  «части»: список строки

функция «Шаг записи»
  принимает «акк»: «Секции», «запись типа»: «Запись типа», «общее»: «Общее»
  возвращает «Секции»
  запись «Секции» с «состояние» равным («акк».«состояние») и «части» равным (добавить («Печать записи» от «запись типа» и «общее») к («акк».«части»))

функция «Шаг суммы»
  принимает «акк»: «Секции», «сумма»: «Сумма типов», «общее»: «Общее»
  возвращает «Секции»
  запись «Секции» с «состояние» равным («Затребовать» от («акк».«состояние») и "$FlangVariant") и «части» равным (добавить («Печать суммы» от «сумма» и «общее») к («акк».«части»))

функция «Шаг функции»
  принимает «акк»: «Секции», «функция»: «Функция», «общее»: «Общее»
  возвращает «Секции»
  пусть «блок» равно («Печать функции» от «функция» и «общее» и («акк».«состояние»))
  запись «Секции» с «состояние» равным («блок».«состояние») и «части» равным (добавить («блок».«вывод») к («акк».«части»))

функция «Печать секций»
  принимает «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Секции»
  пусть «после записей» равно (свёртка («общее».«записи») начиная с (запись «Секции» с «состояние» равным «состояние» и «части» равным пустой список) как «акк» и «запись типа» → «Шаг записи» от «акк» и «запись типа» и «общее»)
  пусть «после сумм» равно (свёртка («общее».«суммы») начиная с «после записей» как «акк» и «сумма» → «Шаг суммы» от «акк» и «сумма» и «общее»)
  свёртка («общее».«функции») начиная с «после сумм» как «акк» и «функция» → «Шаг функции» от «акк» и «функция» и «общее»

тотальная функция «Шапка модуля»
  принимает «есть модуль»: признак, «модуль»: строка, «конкурентная»: признак
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить ["// Модуль flang: «", «модуль», "»."] по "") иначе "// Программа flang без имени модуля.")
  пусть «общее» равно (соединить [
    "// Сгенерировано flang (бэкенд JavaScript, flang/src/emit/js.mjs). Не редактировать руками.",
    «строка модуля»,
    "// Правьте исходник на flang и печатайте заново: любая правка здесь потеряется.",
    "// Модуль самодостаточен — ни одной зависимости, работает и в Node, и в браузере."
  ] по "\n")
  если «конкурентная»
    то соединить [«общее», "\n// Программа с процессами: планировщик конкурентности напечатан внутрь модуля.\n// Конкурентность есть, параллелизма нет и не будет — один поток (concRun, concPlan)."] по ""
    иначе «общее»

тотальная функция «Имя модуля»
  принимает «программа»: «Значение»
  возвращает строка
  «Строка поля» от «программа» и "module"

тотальная функция «Есть имя модуля»
  принимает «программа»: «Значение»
  возвращает признак
  (длина («Имя модуля» от «программа»)) больше 0

тотальная функция «Имя файла программы»
  принимает «программа»: «Значение», «настройки»: «Настройки»
  возвращает строка
  если («настройки».«есть путь»)
    то «настройки».«путь»
    иначе
      если «Есть имя модуля» от «программа»
        то соединить («Змейка» от («Имя модуля» от «программа»)) с ".js"
        иначе "program.js"

тотальная функция «Непустые части»
  принимает «части»: список строки
  возвращает список строки
  отфильтровать «части» где «часть» → (длина «часть») больше 0

// Первым делом программа ПОНИЖАЕТСЯ: `функция «Имя»` становится вариантом,
// `ф от 5` — вызовом диспетчера, и дальше печать высшего порядка не видит
// вовсе. Ровно там же зовёт проход и эталон, и это не совпадение, а условие
// побайтовой сверки.
функция «Печать программы»
  принимает «программа»: «Значение», «настройки»: «Настройки»
  возвращает «Итог печати»
  пусть «понижено» равно («Дефункционализировать» от «программа»)
  пусть «общее» равно («Собрать общее» от «понижено»)
  пусть «секции» равно («Печать секций» от «общее» и «Пустое состояние»)
  пусть «конкурентная» равно («общее».«конкурентная»)
  /* Планировщик отказывает через `$fail`, как и всё остальное в модуле, и
     считает ОБЩИЙ счётчик витков (`$step`, `$top`, `$LIMITS`). Затребованы они
     здесь явно: программа с процессами может не иметь ни одной рекурсивной
     функции — а планировщику счётчик нужен всё равно, потому что запас витков
     объявлен автором и обязан работать. */
  пусть «до плана» равно (если «конкурентная» то («Затребовать» от («Затребовать» от («секции».«состояние») и "$fail") и "$top") иначе («секции».«состояние»))
  пусть «план» равно (если «конкурентная» то («Печать конкурентности» от «понижено» и «общее» и «до плана») иначе (запись «Блок» с «состояние» равным «до плана» и «вывод» равным ""))
  пусть «состояние» равно («план».«состояние»)
  пусть «рантайм» равно («Печать рантайма» от («состояние».«нужно») и «настройки» и «конкурентная»)
  пусть «шапка» равно («Шапка модуля» от («Есть имя модуля» от «понижено») и («Имя модуля» от «понижено») и «конкурентная»)
  пусть «части» равно («Слить строки» от («Слить строки» от [«шапка», «рантайм»] и («секции».«части»)) и [(«план».«вывод»)])
  пусть «содержимое» равно (соединить («Непустые части» от «части») по "\n\n")
  пусть «файл» равно (запись «Файл» с «путь» равным («Имя файла программы» от «понижено» и «настройки») и «содержимое» равным («Снять двунаправленные» от (соединить «содержимое» с "\n")))
  запись «Итог печати» с «файлы» равным [«файл»] и «ошибка» равным («Первая ошибка» от («общее».«ошибка») и («состояние».«ошибка»))

// ═══════════════════════════ конкурентность ═══════════════════════════
//
// Процессы, надзоры и прогоны печатаются ДАННЫМИ — одним объектом уровня
// модуля, — а планировщик приезжает готовым (`js/flang_conc.js`) и печатается
// целиком. Тот же приём, что в C и в Elixir, и по той же причине: надзор в
// flang — объявление, и одно объявление обязано остаться одним местом в
// напечатанном коде.
//
// Разница с C ровно одна и она в пользу JavaScript: обработчик кладётся в план
// САМОЙ ФУНКЦИЕЙ, а не именем. В C планировщику нужен диспетчер по имени,
// потому что указателя на функцию с переменной арностью там не выразить; здесь
// функция — значение, и второй словарь «имя → функция» был бы лишней сущностью.

тотальная функция «Это число в скаляре»
  принимает «скаляр»: «Скаляр»
  возвращает признак
  разбор «скаляр»
    случай вариант «Скаляр число» с «значение» как «значение»
      то да
    случай любое
      то нет

тотальная функция «Это число»
  принимает «узел»: «Значение»
  возвращает признак
  разбор «узел»
    случай вариант «Значение скаляра» с «скаляр» как «скаляр»
      то «Это число в скаляре» от «скаляр»
    случай любое
      то нет

// `Number.isFinite`: проверка идёт по напечатанному виду, а не сравнением —
// равенство скаляров в flang это Object.is, и `NaN равен NaN` даёт «да».
тотальная функция «Конечное»
  принимает «значение»: число
  возвращает признак
  пусть «текст» равно (к строке «значение»)
  если «текст» равен "NaN"
    то нет
    иначе
      если «текст» равен "Infinity"
        то нет
        иначе
          если «текст» равен "-Infinity"
            то нет
            иначе да

// `Math.trunc`: отбрасывание дробной части к нулю. Остаток от единицы имеет
// знак делимого, поэтому вычитание работает в обе стороны.
тотальная функция «Целая часть»
  принимает «значение»: число
  возвращает число
  пример «Дробь вниз»
    дано «значение» равно 5.7
    ожидается 5
  пример «Отрицательная дробь к нулю»
    дано «значение» равно -5.7
    ожидается -5
  «значение» минус («значение» остаток от 1)

объект «План»
  «состояние»: «Состояние»
  «вывод»: строка

// Функция, которой в программе нет, — это отказ ПЕЧАТИ, а не пустое место в
// плане: молча напечатать процесс без обработчика значило бы вернуться к тому
// самому поведению, из-за которого шесть целей теряли процессы.
тотальная функция «Имя из плана»
  принимает «состояние»: «Состояние», «общее»: «Общее», «имя»: строка, «роль»: строка, «процесс»: строка
  возвращает «Свежее»
  если «Есть в таблице» от («общее».«ид функций») и «имя»
    то запись «Свежее» с «состояние» равным «состояние» и «имя» равным («Значение по ключу» от («общее».«ид функций») и «имя»)
    иначе запись «Свежее» с «состояние» равным («Записать ошибку» от «состояние» и (соединить [«роль», " «", «имя», "» процесса «", «процесс», "» в программе не объявлен: напечатать процесс нечем"] по "")) и «имя» равным ""

тотальная функция «Тотальный обработчик»
  принимает «общее»: «Общее», «имя»: строка
  возвращает признак
  разбор («Найти функцию» от («общее».«функции») и «имя»)
    случай вариант «Есть функция» с «функция» как «найденная»
      то «найденная».«тотальная»
    случай «Нет функции»
      то нет

// Запас витков ставится ТОЛЬКО нетотальному обработчику: про тотальный
// доказано, что он завершится, и отсчитывать нечего.
тотальная функция «Запас процесса»
  принимает «узел»: «Значение», «тотальный»: признак
  возвращает число
  если «тотальный»
    то 0
    иначе «Целое поле или ноль» от «узел» и "budget"

тотальная функция «Целое поле или ноль»
  принимает «узел»: «Значение», «ключ»: строка
  возвращает число
  пусть «поле» равно («Взять поле» от «узел» и «ключ»)
  если «Это число» от «поле»
    то (если «Конечное» от («Число узла» от «поле») то («Целая часть» от («Число узла» от «поле»)) иначе 0)
    иначе 0

// Ноль — «ящик неограничен», ровно как ноль в запасе значит «считать нечего»:
// ящик в ноль сообщений проверка типов не пропускает, поэтому два смысла нуля
// здесь не сталкиваются.
тотальная функция «Ящик процесса»
  принимает «узел»: «Значение»
  возвращает число
  пусть «размер» равно («Целое поле или ноль» от «узел» и "mailbox")
  если «размер» больше 0
    то «размер»
    иначе 0

тотальная функция «Печать процесса»
  принимает «план»: «План», «узел»: «Значение», «общее»: «Общее»
  возвращает «План»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «обработчик» равно («Строка поля» от «узел» и "handler")
  пусть «начало» равно («Строка поля» от «узел» и "initial")
  пусть «вызвать» равно («Имя из плана» от («план».«состояние») и «общее» и «обработчик» и "обработчик" и «имя»)
  пусть «завести» равно («Имя из плана» от («вызвать».«состояние») и «общее» и «начало» и "начальное состояние" и «имя»)
  пусть «тотальный» равно («Тотальный обработчик» от «общее» и «обработчик»)
  пусть «строки» равно (соединить [
    («Строка вывода» от "    " и "{"),
    («Строка вывода» от "      " и (соединить ["имя: ", («Печать строки» от «имя»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["обработчик: ", («Печать строки» от «обработчик»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["вызвать: ", («вызвать».«имя»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["начало: ", («Печать строки» от «начало»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["завести: ", («завести».«имя»), ","] по "")),
    («Строка вывода» от "      " и (соединить ["тотальный: ", (если «тотальный» то "true" иначе "false"), ","] по "")),
    («Строка вывода» от "      " и (соединить ["запас: ", (к строке («Запас процесса» от «узел» и «тотальный»)), ","] по "")),
    («Строка вывода» от "      " и (соединить ["ящик: ", (к строке («Ящик процесса» от «узел»)), ","] по "")),
    («Строка вывода» от "    " и "},")
  ] по "")
  запись «План» с «состояние» равным («завести».«состояние») и «вывод» равным (соединить («план».«вывод») с «строки»)

тотальная функция «Пары надзора»
  принимает «узлы»: список «Значение», «ключ»: строка
  возвращает строка
  соединить (отобразить «узлы» как «узел» → соединить ["[", («Печать строки» от («Строка поля» от «узел» и «ключ»)), ", ", («Печать строки» от («Строка поля» от «узел» и "strategy")), "]"] по "") по ", "

тотальная функция «Порог надзора»
  принимает «узел»: «Значение»
  возвращает строка
  пусть «порог» равно («Взять поле» от «узел» и "threshold")
  если «Это запись» от «порог»
    то соединить ["{ отказов: ", («Число JS» от («Число узла» от («Взять поле» от «порог» и "failures"))), ", окно: ", («Число JS» от («Число узла» от («Взять поле» от «порог» и "window"))), ", иначе: ", («Печать строки» от («Строка поля» от «порог» и "otherwise")), " }"] по ""
    иначе "null"

тотальная функция «Печать надзора»
  принимает «план»: «План», «узел»: «Значение», «общее»: «Общее»
  возвращает «План»
  пусть «строки» равно (соединить [
    («Строка вывода» от "    " и "{"),
    («Строка вывода» от "      " и (соединить ["имя: ", («Печать строки» от («Строка поля» от «узел» и "name")), ","] по "")),
    («Строка вывода» от "      " и (соединить ["процессы: [", («Пары надзора» от («Элементы поля» от «узел» и "watch") и "process"), "],"] по "")),
    («Строка вывода» от "      " и (соединить ["вложенные: [", («Пары надзора» от («Элементы поля» от «узел» и "nested") и "supervisor"), "],"] по "")),
    («Строка вывода» от "      " и (соединить ["порог: ", («Порог надзора» от «узел»), ","] по "")),
    («Строка вывода» от "    " и "},")
  ] по "")
  запись «План» с «состояние» равным («план».«состояние») и «вывод» равным (соединить («план».«вывод») с «строки»)

// Литерал входного сообщения прогона — отдельно от «Печать литерала», а не
// вместо неё, по одной причине: вариант в AST записан объектом
// `{ variant, fields }`, и «Печать литерала» напечатала бы такой объект
// ЗАПИСЬЮ с полями «variant» и «fields». Для сообщения прогона это была бы
// прямая ошибка — обработчик не сопоставил бы его ни с одним образцом.

// Объект ровно с двумя полями `variant` и `fields` — это вариант, а не запись.
тотальная функция «Вариант непустой»
  принимает «узел»: «Значение»
  возвращает признак
  пусть «имя» равно («Взять поле» от «узел» и "variant")
  если «Это строка» от «имя»
    то (если (длина («Строка узла» от «имя»)) больше 0 то («Это запись» от («Взять поле» от «узел» и "fields")) иначе нет)
    иначе нет

тотальная функция «Это закодированный вариант»
  принимает «узел»: «Значение»
  возвращает признак
  пусть «поля» равно («Поля узла» от «узел»)
  если (длина «поля») равен 2
    то
      пусть «ключи» равно (отобразить «поля» как «поле» → «поле».«ключ»)
      если «ключи» содержит "variant"
        то (если «ключи» содержит "fields" то («Вариант непустой» от «узел») иначе нет)
        иначе нет
    иначе нет

функция «Шаг сообщения»
  принимает «акк»: «Сборка», «узел»: «Значение», «общее»: «Общее»
  возвращает «Сборка»
  пусть «итог» равно («Сообщение прогона» от («акк».«состояние») и «узел» и «общее»)
  запись «Сборка» с «состояние» равным («итог».«состояние») и «вывод» равным («акк».«вывод») и «индекс» равным ((«акк».«индекс») плюс 1) и «части» равным (добавить («итог».«имя») к («акк».«части»))

функция «Шаг поля сообщения»
  принимает «акк»: «Сборка», «поле»: «Поле значения», «общее»: «Общее»
  возвращает «Сборка»
  пусть «итог» равно («Сообщение прогона» от («акк».«состояние») и («поле».«значение») и «общее»)
  запись «Сборка» с «состояние» равным («итог».«состояние») и «вывод» равным («акк».«вывод») и «индекс» равным ((«акк».«индекс») плюс 1) и «части» равным (добавить (соединить [(«Печать строки» от («поле».«ключ»)), ": ", («итог».«имя»)] по "") к («акк».«части»))

функция «Сообщения списком»
  принимает «состояние»: «Состояние», «элементы»: список «Значение», «общее»: «Общее»
  возвращает «Свежее»
  пусть «собрано» равно (свёртка «элементы» начиная с («Пустая сборка» от «состояние») как «акк» и «узел» → «Шаг сообщения» от «акк» и «узел» и «общее»)
  запись «Свежее» с «состояние» равным («собрано».«состояние») и «имя» равным (соединить ["[", (соединить («собрано».«части») по ", "), "]"] по "")

функция «Сообщение записью»
  принимает «состояние»: «Состояние», «поля»: список «Поле значения», «общее»: «Общее»
  возвращает «Свежее»
  пусть «собрано» равно (свёртка «поля» начиная с («Пустая сборка» от «состояние») как «акк» и «поле» → «Шаг поля сообщения» от «акк» и «поле» и «общее»)
  запись «Свежее» с «состояние» равным («собрано».«состояние») и «имя» равным (если пусто «поля» то "{}" иначе (соединить ["{ ", (соединить («собрано».«части») по ", "), " }"] по ""))

функция «Сообщение вариантом»
  принимает «состояние»: «Состояние», «узел»: «Значение», «общее»: «Общее»
  возвращает «Свежее»
  пусть «имя» равно («Строка узла» от («Взять поле» от «узел» и "variant"))
  пусть «известен» равно («Есть в таблице» от («общее».«ид вариантов») и «имя»)
  пусть «проверено» равно (если «известен» то «состояние» иначе («Записать ошибку» от «состояние» и (соединить ["входное сообщение прогона называет вариант «", «имя», "», которого в программе нет"] по "")))
  пусть «поля» равно («Поля узла» от («Взять поле» от «узел» и "fields"))
  пусть «собрано» равно (свёртка «поля» начиная с («Пустая сборка» от «проверено») как «акк» и «поле» → «Шаг поля сообщения» от «акк» и «поле» и «общее»)
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид вариантов») и «имя»)
  запись «Свежее» с «состояние» равным («собрано».«состояние») и «имя» равным (если пусто «поля» то (соединить «идентификатор» с "()") иначе (соединить [«идентификатор», "({ ", (соединить («собрано».«части») по ", "), " })"] по ""))

функция «Сообщение прогона»
  принимает «состояние»: «Состояние», «узел»: «Значение», «общее»: «Общее»
  возвращает «Свежее»
  разбор «узел»
    случай вариант «Значение списка» с «элементы» как «элементы»
      то «Сообщения списком» от «состояние» и «элементы» и «общее»
    случай вариант «Значение записи» с «поля» как «поля»
      то (если «Это закодированный вариант» от «узел» то («Сообщение вариантом» от «состояние» и «узел» и «общее») иначе («Сообщение записью» от «состояние» и «поля» и «общее»))
    случай любое
      то запись «Свежее» с «состояние» равным «состояние» и «имя» равным («Печать литерала» от «узел»)

функция «Шаг входа»
  принимает «акк»: «Сборка», «запись входа»: «Значение», «общее»: «Общее»
  возвращает «Сборка»
  пусть «итог» равно («Сообщение прогона» от («акк».«состояние») и («Взять поле» от «запись входа» и "message") и «общее»)
  запись «Сборка» с «состояние» равным («итог».«состояние») и «вывод» равным («акк».«вывод») и «индекс» равным ((«акк».«индекс») плюс 1) и «части» равным (добавить (соединить ["[", («Печать строки» от («Строка поля» от «запись входа» и "process")), ", ", («итог».«имя»), "]"] по "") к («акк».«части»))

тотальная функция «До семени»
  принимает «узел»: «Значение»
  возвращает число
  пусть «до» равно («Взять поле» от «узел» и "seedTo")
  если «Это ничто» от «до»
    то «Число узла» от («Взять поле» от «узел» и "seed")
    иначе «Число узла» от «до»

// Входные сообщения — ЗАМЫКАНИЕ, а не готовый список: значение строится
// конструктором этого же модуля, и строить его при загрузке значило бы платить
// за прогоны, которых никто не звал.
функция «Печать прогона»
  принимает «план»: «План», «узел»: «Значение», «общее»: «Общее»
  возвращает «План»
  пусть «вход» равно (свёртка («Элементы поля» от «узел» и "inbox") начиная с («Пустая сборка» от («план».«состояние»)) как «акк» и «запись входа» → «Шаг входа» от «акк» и «запись входа» и «общее»)
  пусть «строки» равно (соединить [
    («Строка вывода» от "    " и "{"),
    («Строка вывода» от "      " и (соединить ["имя: ", («Печать строки» от («Строка поля» от «узел» и "name")), ","] по "")),
    («Строка вывода» от "      " и (соединить ["семя: ", («Число JS» от («Число узла» от («Взять поле» от «узел» и "seed"))), ","] по "")),
    («Строка вывода» от "      " и (соединить ["доСемени: ", («Число JS» от («До семени» от «узел»)), ","] по "")),
    («Строка вывода» от "      " и (соединить ["вход: () => [", (соединить («вход».«части») по ", "), "],"] по "")),
    («Строка вывода» от "    " и "},")
  ] по "")
  запись «План» с «состояние» равным («вход».«состояние») и «вывод» равным (соединить («план».«вывод») с «строки»)

тотальная функция «Хвост плана»
  возвращает строка
  соединить [
    "",
    "/**",
    " * План конкурентности этого модуля: процессы, надзоры, прогоны.",
    " *",
    " * Отдаётся как есть, а не копией: план не меняется ни планировщиком, ни",
    " * прогоном — состояние прогона живёт в самом прогоне.",
    " */",
    "export function concPlan() {",
    "  return $conc",
    "}",
    "",
    "/**",
    " * Прогон объявленной программы: одно семя — один журнал доставок, побайтово.",
    " *",
    " * Конкурентность здесь есть, параллелизма нет: один поток. Наблюдаемая",
    " * семантика от этого не беднее — набор возможных исходов определён",
    " * чередованием, а не числом ядер, и чередование выбирает семя.",
    " *",
    " * @param {string} имя имя объявленного прогона",
    " * @param {{ семя?: number, пробегов?: number, журнал?: boolean }} [настройки]",
    " * @returns {object} исход, состояния, живые, отказы, решения, наверх, время,",
    " *   пробегов, витки и — если не отключён признаком `журнал` — журнал доставок",
    " */",
    "export function concRun(имя, настройки = {}) {",
    "  return $concПрогон($conc, имя, настройки)",
    "}"
  ] по "\n"

функция «Печать конкурентности»
  принимает «программа»: «Значение», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  пусть «пусто» равно (запись «План» с «состояние» равным «состояние» и «вывод» равным "")
  пусть «процессы» равно (свёртка («Элементы поля» от «программа» и "processes") начиная с «пусто» как «акк» и «узел» → «Печать процесса» от «акк» и «узел» и «общее»)
  пусть «после процессов» равно (запись «План» с «состояние» равным («процессы».«состояние») и «вывод» равным "")
  пусть «надзоры» равно (свёртка («Элементы поля» от «программа» и "supervisors") начиная с «после процессов» как «акк» и «узел» → «Печать надзора» от «акк» и «узел» и «общее»)
  пусть «после надзоров» равно (запись «План» с «состояние» равным («надзоры».«состояние») и «вывод» равным "")
  пусть «прогоны» равно (свёртка («Элементы поля» от «программа» и "runs") начиная с «после надзоров» как «акк» и «узел» → «Печать прогона» от «акк» и «узел» и «общее»)
  пусть «вывод» равно (соединить [
    («Строка вывода» от "" и "/* ── План конкурентности: процессы, надзоры и прогоны данными ── */"),
    («Строка вывода» от "" и "const $conc = {"),
    («Строка вывода» от "" и "  процессы: ["),
    («процессы».«вывод»),
    («Строка вывода» от "" и "  ],"),
    («Строка вывода» от "" и "  надзоры: ["),
    («надзоры».«вывод»),
    («Строка вывода» от "" и "  ],"),
    («Строка вывода» от "" и "  прогоны: ["),
    («прогоны».«вывод»),
    («Строка вывода» от "" и "  ],"),
    («Строка вывода» от "" и "}"),
    «Хвост плана»
  ] по "")
  запись «Блок» с «состояние» равным («прогоны».«состояние») и «вывод» равным «вывод»
