тотальная функция «Нужное для JS»
  принимает «имя»: строка
  возвращает список строки
  свёртка (отфильтровать «Рантайм JS» где «кусок» → («кусок».«имя») равен «имя») начиная с пустой список как «акк» и «кусок»
    «кусок».«нужно»

функция «Замкнуть имя JS»
  принимает «имя»: строка, «набрано»: список строки
  возвращает список строки
  если «набрано» содержит «имя»
    то «набрано»
    иначе «Замкнуть нужное JS» от («Нужное для JS» от «имя») и (добавить «имя» к «набрано»)

функция «Замкнуть нужное JS»
  принимает «нужно»: список строки, «набрано»: список строки
  возвращает список строки
  свёртка «нужно» начиная с «набрано» как «акк» и «имя» → «Замкнуть имя JS» от «имя» и «акк»

тотальная функция «Шапка рантайма JS»
  возвращает строка
  обеспечивает «шапка объясняет, что рантайм печатается по потребности» результат содержит "то и только то, что нужно этому модулю"
  соединить [
    "/* ── рантайм: то и только то, что нужно этому модулю ──",
    "   Представление значений повторяет интерпретатор flang дословно: список —",
    "   массив, запись — обычный объект, вариант — экземпляр класса, «ничто» — null.",
    "   Тексты и коды ошибок тоже дословные: они часть наблюдаемого поведения. */"
  ] по "\n"

тотальная функция «Блок базы JS»
  принимает «база»: число
  возвращает строка
  обеспечивает «блок базы объявляет константу с заданной базой» результат содержит (соединить "const $INDEX_BASE = " с (к строке «база»))
  соединить [
    "// Индексация строк — с 1 и включительно с обоих концов (SPEC, раздел 5):",
    "// «первый символ» на языке предметной области это первый, а не нулевой.",
    (соединить "const $INDEX_BASE = " с (к строке «база»))
  ] по "\n"

тотальная функция «Блок пределов JS»
  принимает «предел глубины»: число, «предел шагов»: число
  возвращает строка
  обеспечивает «блок пределов объявляет заданную глубину» результат содержит (соединить "const $DEFAULT_MAX_DEPTH = " с (к строке «предел глубины»))
  соединить [
    "// Пределы вычисления — те же, что у интерпретатора. Без счётчиков модуль на",
    "// незавершающейся функции крутился бы вечно (в браузере — смерть вкладки), а",
    "// на глубокой рекурсии давал RangeError с пустым `code`: не отказ языка.",
    (соединить "const $DEFAULT_MAX_DEPTH = " с (к строке «предел глубины»)),
    (соединить "const $DEFAULT_MAX_STEPS = " с (к строке «предел шагов»)),
    "let $maxDepth = $DEFAULT_MAX_DEPTH",
    "let $maxSteps = $DEFAULT_MAX_STEPS",
    "let $depth = 0",
    "let $steps = 0",
    "// Стоит ли на расчёте граница ($top). Вызов извне приходит с `false` и",
    "// границу ставит; рекурсивные вызовы видят `true` и идут прямо в тело.",
    "let $guarded = false",
    "",
    "// Как хозяин называет исчерпание стека: V8 и JavaScriptCore — «Maximum call",
    "// stack size exceeded», SpiderMonkey — «too much recursion». Компилируется",
    "// здесь, при загрузке: компиляция образца сама требует стека, которого на",
    "// месте отказа уже нет — и тогда наружу шёл SyntaxError вместо отказа языка.",
    "const $STACK_OVERFLOW = /call stack|too much recursion|recursion too deep/iu",
    "",
    "/**",
    " * Свежий контекст вычисления: пределы и сброшенные счётчики.",
    " *",
    " * То же, что `new_context` у остальных семи целей, только контекст здесь —",
    " * сам модуль. Не переданный предел берётся ПО УМОЛЧАНИЮ, а не остаётся с",
    " * прошлого раза: контекст на то и свежий. Ноль или отрицательное значение",
    " * снимает предел.",
    " *",
    " * @param {{maxDepth?: number, maxSteps?: number}} [limits]",
    " * @returns {{maxDepth: number, maxSteps: number}}",
    " */",
    "export function $newContext(limits = {}) {",
    "  $maxDepth = typeof limits.maxDepth === \"number\" ? limits.maxDepth : $DEFAULT_MAX_DEPTH",
    "  $maxSteps = typeof limits.maxSteps === \"number\" ? limits.maxSteps : $DEFAULT_MAX_STEPS",
    "  $depth = 0",
    "  $steps = 0",
    "  return { maxDepth: $maxDepth, maxSteps: $maxSteps }",
    "}"
  ] по "\n"

тотальная функция «Куски замыкания JS»
  принимает «замыкание»: список строки
  возвращает список строки
  отобразить (отфильтровать «Рантайм JS» где «кусок» → «замыкание» содержит («кусок».«имя»)) как «кусок» → «кусок».«исходник»

// Хвостовые пробелы у планировщика снимаются, как это делает `trimEnd()`:
// файл на диске кончается переводом строки, а блоки склеиваются
// пустой строкой между ними, и второй перевод дал бы лишнюю пустую строку.
тотальная функция «Пробельные JS»
  возвращает строка
  // Тело возвращает ШЕСТЬ знаков: к четырём названным добавлены вертикальная
  // табуляция и подача страницы — они стоят в литерале сырыми байтами
  // (0x0B, 0x0C). Обещание называет тот же литерал, что и тело, знак в знак:
  // назови оно четыре, сторож при работе падал бы на каждом вызове с
  // FLANG_PROPERTY.
  обеспечивает «пробельные — пробел, табуляция, перевод строки, возврат каретки, вертикальная табуляция и подача страницы» результат равен " \t\n\r"
  " \t\n\r"

функция «Без хвостовых пробелов JS»
  принимает «текст»: строка
  возвращает строка
  обеспечивает «пустой текст обрезать не от чего» если (длина «текст») равен 0 то результат равен «текст» иначе да
  пример «У пустого текста хвоста нет»
    дано «текст» равно ""
    ожидается ""
  пример «Хвостовой пробел срезается»
    дано «текст» равно "а "
    ожидается "а"
  пример «Без хвоста текст не трогают»
    дано «текст» равно "а"
    ожидается "а"
  если (длина «текст») равен 0
    то «текст»
    иначе
      если «Пробельные JS» содержит («Последний символ C» от «текст»)
        то «Без хвостовых пробелов JS» от (подстрока «текст» с 1 по ((длина «текст») минус 1))
        иначе «текст»

// Планировщик — последним: он зовёт помощников рантайма, а объявления функций
// в JS поднимаются, поэтому порядок здесь читательский, а не обязательный.
функция «Печать рантайма JS»
  принимает «нужно»: список строки, «настройки»: «Настройки JS», «конкурентная»: признак, «плановая»: признак
  возвращает строка
  пусть «замыкание» равно («Замкнуть нужное JS» от «нужно» и пустой список)
  пусть «нечего» равно (если пусто «замыкание» то (если «конкурентная» то нет иначе (если «плановая» то нет иначе да)) иначе нет)
  если «нечего»
    то ""
    иначе
      пусть «с базой» равно (если «замыкание» содержит "$INDEX_BASE" то [«Шапка рантайма JS», («Блок базы JS» от («настройки».«база»))] иначе [«Шапка рантайма JS»])
      пусть «с пределами» равно (если «замыкание» содержит "$LIMITS" то (добавить («Блок пределов JS» от («настройки».«предел глубины») и («настройки».«предел шагов»)) к «с базой») иначе «с базой»)
      пусть «блоки» равно («Слить строки» от «с пределами» и («Куски замыкания JS» от «замыкание»))
      пусть «с планировщиком» равно (если «конкурентная» то (добавить («Без хвостовых пробелов JS» от («настройки».«исходник планировщика»)) к «блоки») иначе «блоки»)
      // Исполнитель плана — за планировщиком и по тому же доводу: он зовёт
      // помощников рантайма, а объявления функций в JS поднимаются, поэтому
      // порядок здесь читательский, а не обязательный.
      соединить (если «плановая» то (добавить («Без хвостовых пробелов JS» от («настройки».«исходник исполнителя»)) к «с планировщиком») иначе «с планировщиком») по "\n\n"

// ═══════════════════════════ типы в документации ═══════════════════════════

// Имена уточнённого числа. Приходят они сюда ИМЕНЕМ, а не видом: `неотрицательное` и
// `целое` не ключевые слова. В JavaScript отдельного типа у них нет — значение
// то же самое число, — и написать `*` значило бы сказать «неизвестно» там, где
// известно всё.
тотальная функция «Числовые имена JS»
  возвращает список строки
  обеспечивает «числовых имён ровно десять» (длина результат) равен 10
  ["неотрицательное", "нат", "натуральное", "nat", "naturo", "自然数", "целое", "integer", "entjero", "整数"]

функция «Пометка вида типа JS»
  принимает «тип»: «Значение», «общее»: «Общее JS»
  возвращает строка
  пусть «вид» равно («Вид узла» от «тип»)
  если «вид» равен "string"
    то "string"
    иначе
      если «вид» равен "number"
        то "number"
        иначе
          если «вид» равен "boolean"
            то "boolean"
            иначе
              если «вид» равен "nothing"
                то "null"
                иначе
                  если «вид» равен "list"
                    то соединить ["Array<", («Пометка типа JS» от («Взять поле» от «тип» и "of") и «общее»), ">"] по ""
                    иначе «Пометка имени JS» от «тип» и «общее»

тотальная функция «Пометка имени JS»
  принимает «тип»: «Значение», «общее»: «Общее JS»
  возвращает строка
  если «Это строка» от («Взять поле» от «тип» и "name")
    то «Пометка известного имени JS» от («Строка поля» от «тип» и "name") и «общее»
    иначе "*"

тотальная функция «Пометка известного имени JS»
  принимает «имя»: строка, «общее»: «Общее JS»
  возвращает строка
  если «Есть в таблице» от («общее».«ид записей») и «имя»
    то «Значение по ключу» от («общее».«ид записей») и «имя»
    иначе
      если «Есть в таблице» от («общее».«ид сумм») и «имя»
        то «Значение по ключу» от («общее».«ид сумм») и «имя»
        иначе
          если «Числовые имена JS» содержит «имя»
            то "number"
            иначе "*"

функция «Пометка типа JS»
  принимает «тип»: «Значение», «общее»: «Общее JS»
  возвращает строка
  если «Это запись» от «тип»
    то «Пометка с необязательностью JS» от «тип» и «общее»
    иначе "*"

функция «Пометка с необязательностью JS»
  принимает «тип»: «Значение», «общее»: «Общее JS»
  возвращает строка
  пусть «внутри» равно («Пометка вида типа JS» от «тип» и «общее»)
  если «Это истина» от («Взять поле» от «тип» и "optional")
    то соединить ["(", «внутри», "|null)"] по ""
    иначе «внутри»

// ═══════════════════════════ записи и суммы ═══════════════════════════

функция «Поля в документации JS»
  принимает «поля»: список «Поле типа JS», «общее»: «Общее JS»
  возвращает строка
  соединить (отобразить «поля» как «поле» → соединить [(«Печать строки» от («поле».«имя»)), ": ", («Пометка типа JS» от («поле».«тип») и «общее»)] по "") по ", "

функция «Печать записи JS»
  принимает «запись типа»: «Запись типа JS», «общее»: «Общее JS»
  возвращает строка
  пусть «имя» равно («запись типа».«имя»)
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид записей») и «имя»)
  пусть «фабрика» равно («Значение по ключу» от («общее».«ид фабрик») и «имя»)
  пусть «поля» равно («запись типа».«поля»)
  пусть «присвоения» равно (соединить (отобразить «поля» как «поле» → соединить ["    ", («Печать строки» от («поле».«имя»)), ": fields[", («Печать строки» от («поле».«имя»)), "] ?? null,\n"] по "") по "")
  соединить [
    "/** Запись FTS «", «имя», "». */\n",
    "/** @typedef {{ ", («Поля в документации JS» от «поля» и «общее»), " }} ", «идентификатор», " */\n",
    "\n",
    "/**\n",
    " * Фабрика записи «", «имя», "».\n",
    " *\n",
    " * Запись flang тотальна: у неё есть все объявленные поля. Отсутствующее\n",
    " * поле — это «ничто» (null), а не дырка в объекте, иначе доступ к полю дал\n",
    " * бы FLANG_UNKNOWN_NAME там, где интерпретатор возвращает значение.\n",
    " *\n",
    " * @param {Partial<", «идентификатор», ">} [fields]\n",
    " * @returns {", «идентификатор», "}\n",
    " */\n",
    "export function ", «фабрика», "(fields = {}) {\n",
    "  return {\n",
    «присвоения»,
    "  }\n",
    "}"
  ] по ""

тотальная функция «Перечень вариантов JS»
  принимает «варианты»: список «Вариант типа JS»
  возвращает строка
  если пусто «варианты»
    то "без вариантов"
    иначе соединить (отобразить «варианты» как «вариант» → соединить ["«", («вариант».«имя»), "»"] по "") по " | "

функция «Печать конструктора JS»
  принимает «вариант»: «Вариант типа JS», «сумма»: строка, «общее»: «Общее JS»
  возвращает строка
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид вариантов») и («вариант».«имя»))
  пусть «поля» равно («вариант».«поля»)
  пусть «подпись» равно (если пусто «поля» то " * @returns {$FlangVariant}\n" иначе (соединить [" * @param {{ ", («Поля в документации JS» от «поля» и «общее»), " }} fields\n * @returns {$FlangVariant}\n"] по ""))
  // У варианта С ПОЛЯМИ значения по умолчанию нет, и это не мелочь стиля.
  // `(fields = {})` при пометке, требующей все поля, — противоречие в самой
  // напечатанной строке: TypeScript судит подстановку по объявленному типу и
  // отвечает TS2739 на КАЖДЫЙ такой конструктор.
  // Работу это не меняет: `$FlangVariant` подставляет `{}` сам
  // (`constructor(name, fields = {})`), поэтому вызов без довода даёт тот же
  // вариант с пустыми полями. Зато замечание переезжает с бессмысленной
  // подстановки на настоящий вызов с недостающим полем.
  пусть «параметр» равно (если пусто «поля» то "(fields = {}) {\n" иначе "(fields) {\n")
  соединить [
    "/**\n",
    " * Конструктор варианта «", («вариант».«имя»), "» суммы «", «сумма», "».\n",
    " *\n",
    " * Поля не копируются, а берутся как есть: интерпретатор строит объект полей\n",
    " * в порядке узла AST, и порядок ключей виден в диагностиках разбора.\n",
    " *\n",
    «подпись»,
    " */\n",
    "export function ", «идентификатор», «параметр»,
    "  return new $FlangVariant(", («Печать строки» от («вариант».«имя»)), ", fields)\n",
    "}"
  ] по ""

функция «Печать суммы JS»
  принимает «сумма»: «Сумма типов JS», «общее»: «Общее JS»
  возвращает строка
  пусть «идентификатор» равно («Значение по ключу» от («общее».«ид сумм») и («сумма».«имя»))
  пусть «шапка» равно (соединить [
    "/** Сумма типов FTS «", («сумма».«имя»), "»: ", («Перечень вариантов JS» от («сумма».«варианты»)), ". */\n",
    "/** Дискриминант — поле «variant»; поля варианта лежат в «fields». */\n",
    "/** @typedef {$FlangVariant} ", «идентификатор», " */"
  ] по "")
  пусть «известные» равно (отфильтровать («сумма».«варианты») где «вариант» → «Есть в таблице» от («общее».«ид вариантов») и («вариант».«имя»))
  пусть «конструкторы» равно (отобразить «известные» как «вариант» → «Печать конструктора JS» от «вариант» и («сумма».«имя») и «общее»)
  соединить («Слить строки» от [«шапка»] и «конструкторы») по "\n\n"

