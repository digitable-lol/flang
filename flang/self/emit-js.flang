объект «Кусок рантайма»
  «имя»: строка
  «нужно»: список строки
  «исходник»: строка

тотальная функция «Текст FlangError»
  возвращает строка
  соединить [
    "class $FlangError extends Error {",
    "  constructor(code, message, span) {",
    "    super(message)",
    "    this.name = \"FlangError\"",
    "    this.code = code",
    "    const diagnostic = { code, message, severity: \"error\" }",
    "    if (span !== undefined && span !== null) {",
    "      diagnostic.span = span",
    "      this.span = span",
    "    }",
    "    this.diagnostics = [diagnostic]",
    "  }",
    "}"
  ] по "\n"

тотальная функция «Текст fail»
  возвращает строка
  соединить [
    "function $fail(code, message, span) {",
    "  throw new $FlangError(code, message, span)",
    "}"
  ] по "\n"

тотальная функция «Текст FlangVariant»
  возвращает строка
  соединить [
    "class $FlangVariant {",
    "  constructor(name, fields = {}) {",
    "    this.variant = name",
    "    this.fields = fields",
    "  }",
    "}"
  ] по "\n"

