    (запись «Пара имён» с «ключ» равным "символ по коду" и «значение» равным "$b_simvol_po_kodu"),
    (запись «Пара имён» с «ключ» равным "содержит" и «значение» равным "$b_soderzhit"),
    (запись «Пара имён» с «ключ» равным "начинается с" и «значение» равным "$b_nachinaetsya_s"),
    (запись «Пара имён» с «ключ» равным "к числу" и «значение» равным "$b_k_chislu"),
    (запись «Пара имён» с «ключ» равным "к числу или беда" и «значение» равным "$b_k_chislu_ili_beda"),
    (запись «Пара имён» с «ключ» равным "к строке" и «значение» равным "$b_k_stroke"),
    (запись «Пара имён» с «ключ» равным "пусто" и «значение» равным "$b_pusto"),
    (запись «Пара имён» с «ключ» равным "голова" и «значение» равным "$b_golova"),
    (запись «Пара имён» с «ключ» равным "хвост" и «значение» равным "$b_hvost"),
    (запись «Пара имён» с «ключ» равным "элемент" и «значение» равным "$b_element"),
    (запись «Пара имён» с «ключ» равным "добавить" и «значение» равным "$b_dobavit"),
    (запись «Пара имён» с «ключ» равным "приписать" и «значение» равным "$b_pripisat"),
    (запись «Пара имён» с «ключ» равным "остаток от" и «значение» равным "$b_ostatok_ot"),
    (запись «Пара имён» с «ключ» равным "процентов от" и «значение» равным "$b_procentov_ot")
  ]

