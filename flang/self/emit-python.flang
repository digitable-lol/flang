    (запись «Замена» с «что» равным "\u0016" и «чем» равным "\\x16"),
    (запись «Замена» с «что» равным "\u0017" и «чем» равным "\\x17"),
    (запись «Замена» с «что» равным "\u0018" и «чем» равным "\\x18"),
