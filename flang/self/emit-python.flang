    "# молчит о них проверка значений свидетеля.",
    "_ENTRY = rt.EntryTable(",
    "    ["
  ]

тотальная функция «Хвост границы входа Python»
  возвращает список строки
  обеспечивает «длина 4214» (длина результат) равен 7
  [
    "    ],",
    ")",
    "",
    "",
    "def entry():",
    "    \"\"\"Объявленные типы параметров: по ним сверяется вход извне.\"\"\"",
