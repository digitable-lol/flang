  пусть «шапка» равно (соединить («Строка вывода» от «отступ» и (соединить [«массив», " = []"] по "")) с («Строка вывода» от «отступ» и (соединить ["for ", «имя элемента», " in ", («список».«значение»), ":"] по "")))
  пусть «с элементом» равно («Связать имя» от «контекст» и «элемент» и «имя элемента»)
  пусть «тело» равно («Тело цикла» от «узел» и «отображение» и «массив» и «имя элемента» и «с элементом» и («свежий элемент».«состояние») и («Глубже» от «отступ»))
  запись «Итог» с «состояние» равным («тело».«состояние») и «вывод» равным (соединить [(«список».«вывод»), «шапка», («тело».«вывод»)] по "") и «значение» равным (соединить ["rt.list_of(", «массив», ")"] по "")

функция «Тело цикла»
  принимает «узел»: «Значение», «отображение»: признак, «массив»: строка, «имя элемента»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «внутри»: строка
  возвращает «Блок»
  если «отображение»
    то «Тело отображения» от «узел» и «массив» и «контекст» и «состояние» и «внутри»
    иначе «Тело фильтра» от «узел» и «массив» и «имя элемента» и «контекст» и «состояние» и «внутри»

функция «Тело отображения»
  принимает «узел»: «Значение», «массив»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «внутри»: строка
  возвращает «Блок»
  пусть «итог» равно («Печать значения» от («Взять поле» от «узел» и "body") и «контекст» и «состояние» и «внутри»)
  пусть «строка» равно («Строка вывода» от «внутри» и (соединить [«массив», ".append(", («итог».«значение»), ")"] по ""))
  запись «Блок» с «состояние» равным («итог».«состояние») и «вывод» равным (соединить («итог».«вывод») с «строка»)

// Тело фильтра — предикат: для отброшенных элементов ничего больше не
// вычисляется.
функция «Тело фильтра»
  принимает «узел»: «Значение», «массив»: строка, «имя элемента»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «внутри»: строка
  возвращает «Блок»
  пусть «итог» равно («Печать значения» от («Взять поле» от «узел» и "body") и «контекст» и «состояние» и «внутри»)
  пусть «строки» равно (соединить («Строка вывода» от «внутри» и (соединить ["if rt.keep(ctx, ", («итог».«значение»), "):"] по "")) с («Строка вывода» от («Глубже» от «внутри») и (соединить [«массив», ".append(", «имя элемента», ")"] по "")))
  запись «Блок» с «состояние» равным («итог».«состояние») и «вывод» равным (соединить («итог».«вывод») с «строки»)

// ═══════════════════════════ разбор ═══════════════════════════

объект «Итог образца»
  «состояние»: «Состояние»
  «вывод»: строка
  «есть проверка»: признак
  «проверка»: строка

объект «Случай печати»
  «тело»: «Значение»
  «образец»: «Значение»
  «есть проверка»: признак
  «проверка»: строка

объект «Сбор случаев»
  «состояние»: «Состояние»
  «вывод»: строка
  «случаи»: список «Случай печати»

объект «Связывание»
  «состояние»: «Состояние»
  «контекст»: «Контекст»
  «куски»: список «Кусок вывода»

// Литерал в образце может потребовать собственных операторов, поэтому все
// проверки готовятся до цепочки `if` — иначе оператор оказался бы внутри ветви
// соседнего условия.
функция «Проверка образца»
  принимает «образец»: «Значение», «предмет»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Итог образца»
  разбор («Вид узла» от «образец»)
    случай "empty"
      то «Готовая проверка» от «состояние» и (соединить ["rt.chain_empty(", «предмет», ")"] по "")
    случай "cons"
      то «Готовая проверка» от «состояние» и (соединить ["rt.chain_cons(", «предмет», ")"] по "")
    случай "variant"
      то «Готовая проверка» от «состояние» и (соединить ["rt.variant_is(", «предмет», ", ", («Строка Python» от («Строка поля» от «образец» и "name")), ")"] по "")
    случай "literal"
      то «Проверка литералом» от «образец» и «предмет» и «контекст» и «состояние» и «отступ»
    случай "any"
      то запись «Итог образца» с «состояние» равным «состояние» и «вывод» равным "" и «есть проверка» равным нет и «проверка» равным ""
    случай любое
      то «Ошибка образца» от «образец» и «состояние»

тотальная функция «Готовая проверка»
  принимает «состояние»: «Состояние», «проверка»: строка
  возвращает «Итог образца»
  запись «Итог образца» с «состояние» равным «состояние» и «вывод» равным "" и «есть проверка» равным да и «проверка» равным «проверка»

тотальная функция «Ошибка образца»
  принимает «образец»: «Значение», «состояние»: «Состояние»
  возвращает «Итог образца»
  пусть «текст» равно (соединить ["неизвестный вид образца «", («Вид узла» от «образец»), "»"] по "")
  запись «Итог образца» с «состояние» равным («Записать ошибку» от «состояние» и «текст») и «вывод» равным "" и «есть проверка» равным нет и «проверка» равным ""

функция «Проверка литералом»
  принимает «образец»: «Значение», «предмет»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Итог образца»
  пусть «итог» равно («Печать литерала» от («Взять поле» от «образец» и "value") и «контекст» и «состояние» и «отступ»)
  пусть «проверка» равно (соединить ["rt.equal(", «предмет», ", ", («итог».«значение»), ")"] по "")
  запись «Итог образца» с «состояние» равным («итог».«состояние») и «вывод» равным («итог».«вывод») и «есть проверка» равным да и «проверка» равным «проверка»

тотальная функция «Связки варианта»
  принимает «образец»: «Значение»
  возвращает список «Пара имён»
  пусть «связки» равно («Взять поле» от «образец» и "bind")
  если «Это список» от «связки»
    то отобразить («Элементы узла» от «связки») как «поле» → запись «Пара имён» с «ключ» равным («Строка узла» от «поле») и «значение» равным («Строка узла» от «поле»)
    иначе отобразить («Поля узла» от «связки») как «поле» → запись «Пара имён» с «ключ» равным («поле».«ключ») и «значение» равным («Строка узла» от («поле».«значение»))

// Связывание с комментарием: строку присвоения разрешено погасить, а строку
// комментария — нет, она поясняет имя из модели.
функция «Связать с примечанием»
  принимает «итог»: «Связывание», «имя»: строка, «код»: строка, «примечание»: строка, «отступ»: строка
  возвращает «Связывание»
  пусть «свежее» равно («Свежее имя» от («итог».«состояние») и «имя»)
  пусть «идентификатор» равно («свежее».«имя»)
  пусть «строка» равно (запись «Кусок вывода» с «текст» равным («Строка вывода» от «отступ» и (соединить [«идентификатор», " = ", «код»] по "")) и «идентификатор» равным «идентификатор»)
  пусть «куски» равно (добавить «строка» к (добавить («Просто кусок» от («Строка вывода» от «отступ» и «примечание»)) к («итог».«куски»)))
  запись «Связывание» с «состояние» равным («свежее».«состояние») и «контекст» равным («Связать имя» от («итог».«контекст») и «имя» и «идентификатор») и «куски» равным «куски»

функция «Связать без примечания»
  принимает «итог»: «Связывание», «имя»: строка, «код»: строка, «отступ»: строка
  возвращает «Связывание»
  пусть «свежее» равно («Свежее имя» от («итог».«состояние») и «имя»)
  пусть «идентификатор» равно («свежее».«имя»)
  пусть «строка» равно (запись «Кусок вывода» с «текст» равным («Строка вывода» от «отступ» и (соединить [«идентификатор», " = ", «код»] по "")) и «идентификатор» равным «идентификатор»)
  запись «Связывание» с «состояние» равным («свежее».«состояние») и «контекст» равным («Связать имя» от («итог».«контекст») и «имя» и «идентификатор») и «куски» равным (добавить «строка» к («итог».«куски»))

// Отсутствующее поле варианта — ошибка прямо при сопоставлении, а не «случай не
// подошёл»: так же ведёт себя matchPattern интерпретатора.
функция «Связать поле варианта»
  принимает «итог»: «Связывание», «связка»: «Пара имён», «предмет»: строка, «отступ»: строка
  возвращает «Связывание»
  пусть «код» равно (соединить ["rt.variant_field(ctx, ", «предмет», ", ", («Строка Python» от («связка».«ключ»)), ")"] по "")
  пусть «примечание» равно (соединить ["# поле «", («связка».«ключ»), "»"] по "")
  «Связать с примечанием» от «итог» и («связка».«значение») и «код» и «примечание» и «отступ»

функция «Связывание образца»
  принимает «образец»: «Значение», «предмет»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Связывание»
  пусть «пусто» равно (запись «Связывание» с «состояние» равным «состояние» и «контекст» равным «контекст» и «куски» равным пустой список)
  разбор («Вид узла» от «образец»)
    случай "cons"
      то «Связывание головы и хвоста» от «образец» и «предмет» и «пусто» и «отступ»
    случай "variant"
      то свёртка («Связки варианта» от «образец») начиная с «пусто» как «акк» и «связка» → «Связать поле варианта» от «акк» и «связка» и «предмет» и «отступ»
    случай "any"
      то «Связывание любого» от «образец» и «предмет» и «пусто» и «отступ»
    случай любое
      то «пусто»

функция «Связывание любого»
  принимает «образец»: «Значение», «предмет»: строка, «пусто»: «Связывание», «отступ»: строка
  возвращает «Связывание»
  если «Это строка» от («Взять поле» от «образец» и "bind")
    то «Связать без примечания» от «пусто» и («Строка поля» от «образец» и "bind") и «предмет» и «отступ»
    иначе «пусто»

// Хвост копирует, как и в JS: срез списка Python — новый список. Наблюдаемое
// значение то же, а «хвост» интерпретатора копирует ровно так же. У строки
// голова — один символ, хвост — остаток.
функция «Связывание головы и хвоста»
  принимает «образец»: «Значение», «предмет»: строка, «пусто»: «Связывание», «отступ»: строка
  возвращает «Связывание»
  пусть «с головой» равно («Связывание головы» от «образец» и «предмет» и «пусто» и «отступ»)
  если «Это строка» от («Взять поле» от «образец» и "tail")
    то «Связать с примечанием» от «с головой» и («Строка поля» от «образец» и "tail") и (соединить ["rt.chain_tail(", «предмет», ")"] по "") и (соединить ["# хвост «", («Строка поля» от «образец» и "tail"), "»"] по "") и «отступ»
    иначе «с головой»

функция «Связывание головы»
  принимает «образец»: «Значение», «предмет»: строка, «пусто»: «Связывание», «отступ»: строка
  возвращает «Связывание»
  если «Это строка» от («Взять поле» от «образец» и "head")
    то «Связать с примечанием» от «пусто» и («Строка поля» от «образец» и "head") и (соединить ["rt.chain_head(", «предмет», ")"] по "") и (соединить ["# голова «", («Строка поля» от «образец» и "head"), "»"] по "") и «отступ»
    иначе «пусто»

тотальная функция «Проверить случай»
  принимает «состояние»: «Состояние», «случай»: «Значение»
  возвращает «Состояние»
  если «Есть поле у узла» от «случай» и "pattern"
    то «состояние»
    иначе «Записать ошибку» от «состояние» и "случай разбора должен содержать «pattern» и «body»"

функция «Шаг сбора случая»
  принимает «акк»: «Сбор случаев», «случай»: «Значение», «предмет»: строка, «контекст»: «Контекст», «отступ»: строка
  возвращает «Сбор случаев»
  пусть «проверено» равно («Проверить случай» от («акк».«состояние») и «случай»)
  пусть «образец» равно («Взять поле» от «случай» и "pattern")
  пусть «итог» равно («Проверка образца» от «образец» и «предмет» и «контекст» и «проверено» и «отступ»)
  пусть «готовый» равно (запись «Случай печати» с «тело» равным («Взять поле» от «случай» и "body") и «образец» равным «образец» и «есть проверка» равным («итог».«есть проверка») и «проверка» равным («итог».«проверка»))
  запись «Сбор случаев» с «состояние» равным («итог».«состояние») и «вывод» равным (соединить («акк».«вывод») с («итог».«вывод»)) и «случаи» равным (добавить «готовый» к («акк».«случаи»))

функция «Печать ветви»
  принимает «случай»: «Случай печати», «предмет»: строка, «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  пусть «связывание» равно («Связывание образца» от («случай».«образец») и «предмет» и «контекст» и «состояние» и «отступ»)
  пусть «тело» равно («Тело ветви» от («случай».«тело») и «есть цель» и «цель» и («связывание».«контекст») и («связывание».«состояние») и «отступ»)
  запись «Блок» с «состояние» равным («тело».«состояние») и «вывод» равным (соединить («Собрать куски» от («связывание».«куски») и («тело».«вывод»)) с («тело».«вывод»))

функция «Тело ветви»
  принимает «узел»: «Значение», «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  если «есть цель»
    то «Положить в» от «узел» и «цель» и «контекст» и «состояние» и «отступ»
    иначе «Печать хвоста» от «узел» и «контекст» и «состояние» и «отступ»

тотальная функция «Хвост цепочки»
  принимает «открыто»: признак, «предмет»: строка, «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  пусть «отказ» равно (соединить ["raise rt.match_fail(ctx, ", «предмет», ")"] по "")
  пусть «вывод» равно (если «открыто» то (соединить («Строка вывода» от «отступ» и "else:") с («Строка вывода» от («Глубже» от «отступ») и «отказ»)) иначе («Строка вывода» от «отступ» и «отказ»))
  запись «Блок» с «состояние» равным «состояние» и «вывод» равным «вывод»

функция «Цепочка случаев»
  принимает «случаи»: список «Случай печати», «открыто»: признак, «предмет»: строка, «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  разбор «случаи»
    случай пусто
      то «Хвост цепочки» от «открыто» и «предмет» и «состояние» и «отступ»
    случай голова и хвост
      то «Шаг цепочки» от «голова» и «хвост» и «открыто» и «предмет» и «есть цель» и «цель» и «контекст» и «состояние» и «отступ»

функция «Шаг цепочки»
  принимает «случай»: «Случай печати», «остальные»: список «Случай печати», «открыто»: признак, «предмет»: строка, «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  если («случай».«есть проверка»)
    то «Ветвь с проверкой» от «случай» и «остальные» и «открыто» и «предмет» и «есть цель» и «цель» и «контекст» и «состояние» и «отступ»
    иначе «Ветвь без проверки» от «случай» и «открыто» и «предмет» и «есть цель» и «цель» и «контекст» и «состояние» и «отступ»

функция «Ветвь с проверкой»
  принимает «случай»: «Случай печати», «остальные»: список «Случай печати», «открыто»: признак, «предмет»: строка, «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  пусть «шапка» равно (если «открыто» то (соединить ["elif ", («случай».«проверка»), ":"] по "") иначе (соединить ["if ", («случай».«проверка»), ":"] по ""))
  пусть «ветвь» равно («Печать ветви» от «случай» и «предмет» и «есть цель» и «цель» и «контекст» и «состояние» и («Глубже» от «отступ»))
  пусть «дальше» равно («Цепочка случаев» от «остальные» и да и «предмет» и «есть цель» и «цель» и «контекст» и («ветвь».«состояние») и «отступ»)
  запись «Блок» с «состояние» равным («дальше».«состояние») и «вывод» равным (соединить [(«Строка вывода» от «отступ» и «шапка»), («ветвь».«вывод»), («дальше».«вывод»)] по "")

// Образец, совпадающий всегда: `else` честнее, чем `if True`, а первый такой
// образец не нуждается и в `else`.
функция «Ветвь без проверки»
  принимает «случай»: «Случай печати», «открыто»: признак, «предмет»: строка, «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  если «открыто»
    то «Ветвь через иначе» от «случай» и «предмет» и «есть цель» и «цель» и «контекст» и «состояние» и «отступ»
    иначе «Печать ветви» от «случай» и «предмет» и «есть цель» и «цель» и «контекст» и «состояние» и «отступ»

функция «Ветвь через иначе»
  принимает «случай»: «Случай печати», «предмет»: строка, «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  пусть «ветвь» равно («Печать ветви» от «случай» и «предмет» и «есть цель» и «цель» и «контекст» и «состояние» и («Глубже» от «отступ»))
  запись «Блок» с «состояние» равным («ветвь».«состояние») и «вывод» равным (соединить («Строка вывода» от «отступ» и "else:") с («ветвь».«вывод»))

функция «Печать разбора»
  принимает «узел»: «Значение», «есть цель»: признак, «цель»: строка, «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  пусть «предмет» равно («Материализовать» от («Печать значения» от («Взять поле» от «узел» и "target") и «контекст» и «состояние» и «отступ») и «отступ»)
  пусть «начало» равно (запись «Сбор случаев» с «состояние» равным («предмет».«состояние») и «вывод» равным "" и «случаи» равным пустой список)
  пусть «собрано» равно (свёртка («Элементы поля» от «узел» и "cases") начиная с «начало» как «акк» и «случай» → «Шаг сбора случая» от «акк» и «случай» и («предмет».«значение») и «контекст» и «отступ»)
  пусть «цепочка» равно («Цепочка случаев» от («собрано».«случаи») и нет и («предмет».«значение») и «есть цель» и «цель» и «контекст» и («собрано».«состояние») и «отступ»)
  запись «Блок» с «состояние» равным («цепочка».«состояние») и «вывод» равным (соединить [(«предмет».«вывод»), («собрано».«вывод»), («цепочка».«вывод»)] по "")

// ── хвостовая позиция: здесь живут `return`, `continue` и отскоки ──

функция «Печать хвоста»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  разбор («Вид узла» от «узел»)
    случай "let"
      то «Хвостовое пусть» от «узел» и «контекст» и «состояние» и «отступ»
    случай "if"
      то «Хвостовое если» от «узел» и «контекст» и «состояние» и «отступ»
    случай "match"
      то «Печать разбора» от «узел» и нет и "" и «контекст» и «состояние» и «отступ»
    случай "call"
      то «Хвостовой вызов» от «узел» и «контекст» и «состояние» и «отступ»
    случай любое
      то «Хвостовое значение» от «узел» и «контекст» и «состояние» и «отступ»

функция «Хвостовое значение»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  пусть «итог» равно («Печать значения» от «узел» и «контекст» и «состояние» и «отступ»)
  пусть «строка» равно («Строка вывода» от «отступ» и (соединить ["return ", («итог».«значение»)] по ""))
  запись «Блок» с «состояние» равным («итог».«состояние») и «вывод» равным (соединить («итог».«вывод») с «строка»)

функция «Хвостовое пусть»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  пусть «значение» равно («Печать значения» от («Взять поле» от «узел» и "value") и «контекст» и «состояние» и «отступ»)
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «проверено» равно («Проверить имя узла» от («значение».«состояние») и «имя» и "let" и "name")
  пусть «свежее» равно («Свежее имя» от «проверено» и «имя»)
  пусть «идентификатор» равно («свежее».«имя»)
  пусть «куски» равно («Куски связывания» от «имя» и «идентификатор» и («значение».«значение») и «отступ»)
  пусть «внутри» равно («Связать имя» от «контекст» и «имя» и «идентификатор»)
  пусть «тело» равно («Печать хвоста» от («Тело пусть» от «узел») и «внутри» и («свежее».«состояние») и «отступ»)
  запись «Блок» с «состояние» равным («тело».«состояние») и «вывод» равным (соединить [(«значение».«вывод»), («Собрать куски» от «куски» и («тело».«вывод»)), («тело».«вывод»)] по "")

функция «Хвостовое если»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  пусть «флаг» равно («Печать значения» от («Взять поле» от «узел» и "cond") и «контекст» и «состояние» и «отступ»)
  пусть «внутри» равно («Глубже» от «отступ»)
  пусть «то» равно («Печать хвоста» от («Взять поле» от «узел» и "then") и «контекст» и («флаг».«состояние») и «внутри»)
  пусть «иначе» равно («Печать хвоста» от («Взять поле» от «узел» и "else") и «контекст» и («то».«состояние») и «внутри»)
  пусть «вывод» равно (соединить [(«флаг».«вывод»), («Строка вывода» от «отступ» и (соединить ["if rt.cond(ctx, ", («флаг».«значение»), "):"] по "")), («то».«вывод»), («Строка вывода» от «отступ» и "else:"), («иначе».«вывод»)] по "")
  запись «Блок» с «состояние» равным («иначе».«состояние») и «вывод» равным «вывод»

тотальная функция «Это самовызов»
  принимает «контекст»: «Контекст», «имя»: строка
  возвращает признак
  если («контекст».«сам хвост»)
    то «имя» равен ((«контекст».«функция»).«имя»)
    иначе нет

тотальная функция «Это отскок»
  принимает «контекст»: «Контекст», «имя»: строка
  возвращает признак
  если («контекст».«есть члены»)
    то («контекст».«члены») содержит «имя»
    иначе нет

функция «Хвостовой вызов»
  принимает «узел»: «Значение», «контекст»: «Контекст», «состояние»: «Состояние», «отступ»: строка
  возвращает «Блок»
  пусть «имя» равно («Строка поля» от «узел» и "name")
  пусть «проверено» равно («Разрешить вызов» от «узел» и «контекст» и «состояние»)
  пусть «аргументы» равно («Упорядоченные значения» от («Элементы поля» от «узел» и "args") и «контекст» и «проверено» и «отступ»)
  если «Это самовызов» от «контекст» и «имя»
    то «Хвостовой цикл» от «аргументы» и «контекст» и «отступ»
    иначе
      если «Это отскок» от «контекст» и «имя»
        то «Хвостовой отскок» от «аргументы» и «имя» и «контекст» и «отступ»
        иначе «Хвостовой возврат» от «аргументы» и «имя» и «контекст» и «отступ»

тотальная функция «Хвостовой возврат»
  принимает «аргументы»: «Сборка», «имя»: строка, «контекст»: «Контекст», «отступ»: строка
  возвращает «Блок»
  пусть «функция» равно («Значение по ключу» от ((«контекст».«общее»).«ид функций») и «имя»)
  пусть «строка» равно («Строка вывода» от «отступ» и (соединить ["return ", «функция», "(ctx", («Аргументы после ctx» от («аргументы».«части»)), ")"] по ""))
  запись «Блок» с «состояние» равным («аргументы».«состояние») и «вывод» равным (соединить («аргументы».«вывод») с «строка»)

тотальная функция «Хвостовой отскок»
  принимает «аргументы»: «Сборка», «имя»: строка, «контекст»: «Контекст», «отступ»: строка
  возвращает «Блок»
  пусть «шаг» равно («Значение по ключу» от ((«контекст».«общее»).«ид шагов») и «имя»)
  пусть «строки» равно (соединить [(«Строка вывода» от «отступ» и (соединить ["# хвостовой вызов «", «имя», "» — отскок, а не кадр стека"] по "")), («Строка вывода» от «отступ» и (соединить ["bounce.args = [", (соединить («аргументы».«части») по ", "), "]"] по "")), («Строка вывода» от «отступ» и (соединить ["bounce.next = ", «шаг»] по "")), («Строка вывода» от «отступ» и "return None")] по "")
  запись «Блок» с «состояние» равным («аргументы».«состояние») и «вывод» равным (соединить («аргументы».«вывод») с «строки»)

// Самовызов в хвосте — это цикл. Присваивание параметров идёт по очереди,
// поэтому аргумент, который ещё читает старое значение параметра, обязан
// сперва лечь во временное.
тотальная функция «Аргумент можно оставить»
  принимает «аргумент»: строка, «контекст»: «Контекст»
  возвращает признак
  если «Это идентификатор» от «аргумент»
    то
      если («контекст».«параметры») содержит «аргумент»
        то нет
        иначе да
    иначе нет

тотальная функция «Шаг временного аргумента»
  принимает «акк»: «Сборка», «аргумент»: строка, «контекст»: «Контекст», «отступ»: строка
  возвращает «Сборка»
  если «Аргумент можно оставить» от «аргумент» и «контекст»
    то запись «Сборка» с «состояние» равным («акк».«состояние») и «вывод» равным («акк».«вывод») и «части» равным (добавить «аргумент» к («акк».«части»))
    иначе «Поднять часть» от «акк» и «аргумент» и «отступ»

тотальная функция «Шаг присвоения параметра»
  принимает «акк»: «Зип», «параметр»: строка, «временные»: список строки, «отступ»: строка
  возвращает «Зип»
  пусть «строка» равно («Строка вывода» от «отступ» и (соединить [«параметр», " = ", («Элемент по индексу» от «временные» и («акк».«индекс»))] по ""))
  запись «Зип» с «индекс» равным ((«акк».«индекс») плюс 1) и «текст» равным (соединить («акк».«текст») с «строка»)

тотальная функция «Хвостовой цикл»
  принимает «аргументы»: «Сборка», «контекст»: «Контекст», «отступ»: строка
  возвращает «Блок»
  пусть «начало» равно («Пустая сборка» от («аргументы».«состояние»))
  пусть «временные» равно (свёртка («аргументы».«части») начиная с «начало» как «акк» и «аргумент» → «Шаг временного аргумента» от «акк» и «аргумент» и «контекст» и «отступ»)
  пусть «нуль» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
  пусть «присвоения» равно (свёртка («контекст».«параметры») начиная с «нуль» как «акк» и «параметр» → «Шаг присвоения параметра» от «акк» и «параметр» и («временные».«части») и «отступ»)
  пусть «конец» равно (соединить [(«Строка вывода» от «отступ» и "# виток цикла — тоже шаг вычисления: незавершающийся хвостовой"), («Строка вывода» от «отступ» и "# самовызов обязан упереться в лимит, а не крутиться вечно"), («Строка вывода» от «отступ» и (соединить ["ctx.step(", («Строка Python» от ((«контекст».«функция»).«имя»)), ")"] по "")), («Строка вывода» от «отступ» и "continue")] по "")
  пусть «вывод» равно (соединить [(«аргументы».«вывод»), («временные».«вывод»), («присвоения».«текст»), «конец»] по "")
  запись «Блок» с «состояние» равным («временные».«состояние») и «вывод» равным «вывод»

// ═══════════════════════════ строки документации ═══════════════════════════

// Экранируется ровно то, что может её закрыть или испортить: тройная кавычка и
// обратный слэш. Имена модели попадают сюда как есть — ради них всё и
// затевалось.
тотальная функция «Безопасная строка документации»
  принимает «строка»: строка
  возвращает строка
  пусть «без слешей» равно («Заменить всё» от «строка» и "\\" и "\\\\")
  пусть «без тройных» равно («Заменить всё» от «без слешей» и "\"\"\"" и "\\\"\\\"\\\"")
  если («Последний символ» от «без тройных») равен "\""
    то соединить (подстрока «без тройных» с 1 по ((длина «без тройных») минус 1)) с "\\\""
    иначе «без тройных»

тотальная функция «Строка документации»
  принимает «строка»: строка, «отступ»: строка
  возвращает строка
  если (длина «строка») равен 0
    то "\n"
    иначе «Строка вывода» от «отступ» и «строка»

тотальная функция «Документация»
  принимает «строки»: список строки, «отступ»: строка
  возвращает строка
  пусть «безопасные» равно (отобразить «строки» как «с» → «Безопасная строка документации» от «с»)
  разбор «безопасные»
    случай пусто
      то ""
    случай голова и хвост
      то «Документация с началом» от «голова» и «хвост» и «отступ»

тотальная функция «Документация с началом»
  принимает «голова»: строка, «хвост»: список строки, «отступ»: строка
  возвращает строка
  если пусто «хвост»
    то «Строка вывода» от «отступ» и (соединить ["\"\"\"", «голова», "\"\"\""] по "")
    иначе соединить [(«Строка вывода» от «отступ» и (соединить "\"\"\"" с «голова»)), (соединить (отобразить «хвост» как «с» → «Строка документации» от «с» и «отступ») по ""), («Строка вывода» от «отступ» и "\"\"\"")] по ""

// ═══════════════════════════ описание функции ═══════════════════════════

функция «Пометка типа»
  принимает «тип»: «Значение»
  возвращает строка
  если «Это запись» от «тип»
    то «Пометка вида типа» от «тип»
    иначе ""

функция «Пометка вида типа»
  принимает «тип»: «Значение»
  возвращает строка
  разбор («Вид узла» от «тип»)
    случай "string"
      то ": строка"
    случай "number"
      то ": число"
    случай "boolean"
      то ": признак"
    случай "nothing"
      то ": ничто"
    случай "list"
      то соединить ": список" с («Пометка типа» от («Взять поле» от «тип» и "of"))
    случай любое
      то «Пометка имени типа» от «тип»

тотальная функция «Пометка имени типа»
  принимает «тип»: «Значение»
  возвращает строка
  если «Это строка» от («Взять поле» от «тип» и "name")
    то соединить [": «", («Строка поля» от «тип» и "name"), "»"] по ""
    иначе ""

объект «Строки с индексом»
  «индекс»: число
  «строки»: список строки

функция «Строка параметра»
