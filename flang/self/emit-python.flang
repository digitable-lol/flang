тотальная функция «Шапка Python»
  принимает «есть модуль»: признак, «модуль»: строка, «что»: строка
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить ["# Модуль flang: «", «модуль», "»."] по "") иначе "# Программа flang без имени модуля.")
  соединить ["# Сгенерировано flang (бэкенд Python, flang/src/emit/python.mjs). Не редактировать руками.\n", «строка модуля», "\n# Файл: ", «что», ".\n# Правьте исходник на flang и печатайте заново: любая правка здесь потеряется."] по ""

тотальная функция «Печать Makefile Python»
  принимает «файл»: строка, «прогонщик»: признак
  возвращает строка
  пусть «проверка» равно (если «прогонщик» то "\t$(PYTHON) -B -c \"import $(MODULE), flang_runtime, flang_cli\"\n" иначе "\t$(PYTHON) -B -c \"import $(MODULE), flang_runtime\"\n")
  пусть «прогон» равно (если «прогонщик» то "\nrun:\n\t$(PYTHON) -B flang_cli.py $(MODULE)\n" иначе "")
  пусть «цели» равно (если «прогонщик» то ".PHONY: all check run lint clean\n" иначе ".PHONY: all check lint clean\n")
  соединить ["# Сгенерировано flang (бэкенд Python). Целей ровно столько, сколько нужно:\n", "# напечатанный код обязан импортироваться и запускаться без единой правки.\n", "PYTHON ?= python3\n", "MODULE ?= ", «файл», "\n", "\n", "all: check\n", "\n", "# Импорт без записи .pyc: кэш байткода — мусор в чужом каталоге.\n", "check:\n", «проверка», «прогон», "\n", "# Линтер необязателен: его отсутствие не делает напечатанный код неверным.\n", "lint:\n", "\truff check . || true\n", "\n", "clean:\n", "\trm -rf __pycache__\n", "\n", «цели»] по ""

тотальная функция «Заголовок исходника Python»
  принимает «есть модуль»: признак, «модуль»: строка
  возвращает строка
  пусть «первая» равно (если «есть модуль» то (соединить ["Модуль flang «", «модуль», "», напечатанный в Python."] по "") иначе "Программа flang, напечатанная в Python.")
  соединить [(«Шапка Python» от «есть модуль» и «модуль» и "реализация: функции, конструкторы значений, вызов по имени"), "\n\"\"\"\n", «первая», "\n\nКонтракт вызова: функция возвращает значение либо возбуждает\nflang_runtime.FlangError с кодом и текстом, дословно совпадающими с\nинтерпретатором flang. Все значения — flang_runtime.Value: числа там всегда\nfloat (целых чисел в flang нет), признак отличается от числа тегом, а не\nтипом Python, и равенство скаляров — Object.is, а не ==.\n\"\"\"\n\nimport flang_runtime as rt"] по ""

тотальная функция «Исходник модуля Python»
  принимает «есть модуль»: признак, «модуль»: строка, «части»: список строки
  возвращает строка
  пусть «непустые» равно (отфильтровать «части» где «часть» → (длина «часть») больше 0)
  соединить [(соединить («Части с заголовком Python» от («Заголовок исходника Python» от «есть модуль» и «модуль») и «непустые») по "\n\n\n"), "\n"] по ""

