  запись «Зип» с «индекс» равным ((«акк».«индекс») плюс 1) и «текст» равным (соединить («акк».«текст») с «строки»)

// Батут: наружу торчит обычная функция, внутри — шаг, возвращающий отскок.
функция «Печать батута»
  принимает «функция»: «Функция», «общее»: «Общее», «текст»: строка, «описание»: строка, «подпись»: строка
  возвращает строка
  пусть «идентификаторы» равно («Идентификаторы для» от («общее».«ид параметров») и («функция».«имя»))
  пусть «шаг» равно («Значение по ключу» от («общее».«ид шагов») и («функция».«имя»))
  пусть «нуль» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
  пусть «распаковка» равно ((свёртка («функция».«параметры») начиная с «нуль» как «акк» и «параметр» → «Шаг распаковки» от «акк» и «параметр» и «идентификаторы»).«текст»)
  пусть «шаговый» равно (соединить [(«Строка вывода» от "" и (соединить ["def ", «шаг», "(ctx, args, bounce):"] по "")), («Документация» от [(соединить ["Шаг батута для «", («функция».«имя»), "»: значение либо отскок к соседу по рекурсии."] по "")] и "    "), «распаковка», «текст»] по "")
  пусть «имя C» равно («Строка Python» от («функция».«имя»))
  пусть «обёртка» равно (соединить [(«Строка вывода» от "" и «подпись»), «описание», («Строка вывода» от "    " и (соединить ["ctx.enter(", «имя C», ")"] по "")), («Строка вывода» от "    " и "try:"), («Строка вывода» от "        " и (соединить ["return rt.trampoline(ctx, ", «шаг», ", [", (соединить «идентификаторы» по ", "), "], ", «имя C», ")"] по "")), («Строка вывода» от "    " и "finally:"), («Строка вывода» от "        " и "ctx.leave()")] по "")
  соединить [(«Без перевода в конце» от «шаговый»), "\n\n\n", («Без перевода в конце» от «обёртка»)] по ""

// Счётчик глубины обязан уменьшаться и на ошибке, иначе первая же пойманная
// ошибка навсегда съела бы предел; ctx.enter вне try намеренно — если он сам
// возбудил FLANG_RECURSION_LIMIT, входа не было, и выхода быть не должно.
тотальная функция «Печать со сторожем»
  принимает «функция»: «Функция», «текст»: строка, «описание»: строка, «подпись»: строка
  возвращает строка
  пусть «вывод» равно (соединить [(«Строка вывода» от "" и «подпись»), «описание», («Строка вывода» от "    " и (соединить ["ctx.enter(", («Строка Python» от («функция».«имя»)), ")"] по "")), («Строка вывода» от "    " и "try:"), «текст», («Строка вывода» от "    " и "finally:"), («Строка вывода» от "        " и "ctx.leave()")] по "")
  «Без перевода в конце» от «вывод»

тотальная функция «Печать простой функции»
  принимает «текст»: строка, «описание»: строка, «подпись»: строка
  возвращает строка
  «Без перевода в конце» от (соединить [(«Строка вывода» от "" и «подпись»), «описание», «текст»] по "")

функция «Выбор оболочки»
  принимает «функция»: «Функция», «общее»: «Общее», «текст»: строка, «описание»: строка, «подпись»: строка, «есть батут»: признак, «сторож»: признак
  возвращает строка
  если «есть батут»
    то «Печать батута» от «функция» и «общее» и «текст» и «описание» и «подпись»
    иначе
      если «сторож»
        то «Печать со сторожем» от «функция» и «текст» и «описание» и «подпись»
        иначе «Печать простой функции» от «текст» и «описание» и «подпись»

// Тело функции с батутом печатается внутри шага, у остальных — внутри самой
// функции; отступ у обоих один, а вот обёртка вокруг разная.
тотальная функция «Отступ тела»
  принимает «есть батут»: признак, «сторож»: признак
  возвращает строка
  если «есть батут»
    то "    "
    иначе
      если «сторож»
        то "        "
        иначе "    "

функция «Печать функции»
  принимает «функция»: «Функция», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  пусть «контекст» равно («Начальный контекст» от «функция» и «общее»)
  пусть «чистое» равно («Начальное взятое» от «состояние» и «общее» и («контекст».«параметры»))
  пусть «есть батут» равно («Есть батут» от «функция» и «общее»)
  пусть «сторож» равно ((«общее».«рекурсивные») содержит («функция».«имя»))
  пусть «отступ» равно («Отступ тела» от «есть батут» и «сторож»)
  пусть «тело» равно («Тело функции» от «функция» и «контекст» и «чистое» и «отступ»)
  пусть «описание» равно («Документация» от («Описание функции» от «функция» и «общее») и "    ")
  пусть «подпись» равно (соединить ["def ", («Значение по ключу» от («общее».«ид функций») и («функция».«имя»)), "(ctx", («Аргументы после ctx» от («контекст».«параметры»)), "):"] по "")
  запись «Блок» с «состояние» равным («тело».«состояние») и «вывод» равным («Выбор оболочки» от «функция» и «общее» и («тело».«вывод») и «описание» и «подпись» и «есть батут» и «сторож»)

// ═══════════════════════════ фабрики записей и вариантов ═══════════════════════════

тотальная функция «Шаг присвоения поля»
  принимает «акк»: «Зип», «поле»: «Поле типа», «идентификаторы»: список строки
  возвращает «Зип»
  пусть «строка» равно («Строка вывода» от "        " и (соединить [(«Строка Python» от («поле».«имя»)), ": ", («Элемент по индексу» от «идентификаторы» и («акк».«индекс»)), ","] по ""))
  запись «Зип» с «индекс» равным ((«акк».«индекс») плюс 1) и «текст» равным (соединить («акк».«текст») с «строка»)

тотальная функция «Перечень полей»
  принимает «поля»: список «Поле типа»
  возвращает строка
  если пусто «поля»
    то "без полей"
    иначе соединить (отобразить «поля» как «поле» → соединить ["«", («поле».«имя»), "»"] по "") по ", "

тотальная функция «Тело фабрики»
  принимает «поля»: список «Поле типа», «идентификаторы»: список строки, «начало»: строка
  возвращает строка
  пусть «нуль» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
  пусть «присвоения» равно ((свёртка «поля» начиная с «нуль» как «акк» и «поле» → «Шаг присвоения поля» от «акк» и «поле» и «идентификаторы»).«текст»)
  соединить [(«Строка вывода» от "    " и (соединить ["return ", «начало», "{"] по "")), «присвоения», («Строка вывода» от "    " и "})")] по ""

функция «Печать фабрики»
  принимает «запись»: «Запись типа», «общее»: «Общее»
  возвращает строка
  пусть «поля» равно («запись».«поля»)
  пусть «идентификаторы» равно («Уникальные имена» от («Имена полей типа» от «поля») и («общее».«глобальные»))
  пусть «подпись» равно (соединить ["def ", («Значение по ключу» от («общее».«ид фабрик») и («запись».«имя»)), "(", (соединить «идентификаторы» по ", "), "):"] по "")
  пусть «описание» равно («Документация» от [(соединить ["Запись FTS «", («запись».«имя»), "»: ", («Перечень полей» от «поля»), "."] по ""), "", "Запись flang тотальна: пропущенное поле — это «ничто», а не дырка."] и "    ")
  пусть «тело» равно (если пусто «поля» то («Строка вывода» от "    " и "return rt.record({})") иначе («Тело фабрики» от «поля» и «идентификаторы» и "rt.record("))
  «Без перевода в конце» от (соединить [(«Строка вывода» от "" и «подпись»), «описание», «тело»] по "")

функция «Печать конструктора варианта»
  принимает «вариант»: «Вариант типа», «сумма»: строка, «общее»: «Общее»
  возвращает строка
  пусть «поля» равно («вариант».«поля»)
  пусть «идентификаторы» равно («Уникальные имена» от («Имена полей типа» от «поля») и («общее».«глобальные»))
  пусть «подпись» равно (соединить ["def ", («Значение по ключу» от («общее».«ид вариантов») и («вариант».«имя»)), "(", (соединить «идентификаторы» по ", "), "):"] по "")
  пусть «описание» равно («Документация» от [(соединить ["Вариант «", («вариант».«имя»), "» суммы типов «", «сумма», "»."] по ""), "", "Дискриминант — имя варианта; проверяется через rt.variant_is(значение, «Имя»).", "Приставка v_ в имени — это роль: у функции flang с тем же именем идентификатор", "начинается с fn_, и одно объявление не съедает другое."] и "    ")
  пусть «имя» равно («Строка Python» от («вариант».«имя»))
  пусть «тело» равно (если пусто «поля» то («Строка вывода» от "    " и (соединить ["return rt.variant(", «имя», ", {})"] по "")) иначе («Тело фабрики» от «поля» и «идентификаторы» и (соединить ["rt.variant(", «имя», ", "] по "")))
  «Без перевода в конце» от (соединить [(«Строка вывода» от "" и «подпись»), «описание», «тело»] по "")

// ═══════════════════════════ контекст и вызов по имени ═══════════════════════════

тотальная функция «Печать нового контекста»
  принимает «настройки»: «Настройки»
  возвращает строка
  пусть «описание» равно («Документация» от ["Контекст вычисления с настройками этой программы.", "", "Индексация строк, предел глубины вызовов и лимит шагов — это настройки", "программы, а не рантайма: печать могла идти с нулевой базой индексации, а", "пределы вызывающий вправе поменять прямо в возвращённом контексте."] и "    ")
  пусть «вывод» равно (соединить [(«Строка вывода» от "" и "def new_context():"), «описание», («Строка вывода» от "    " и "ctx = rt.new_ctx()"), («Строка вывода» от "    " и (соединить ["ctx.index_base = ", (к строке («настройки».«база»))] по "")), («Строка вывода» от "    " и (соединить ["ctx.max_depth = ", (к строке («настройки».«предел глубины»))] по "")), («Строка вывода» от "    " и (соединить ["ctx.max_steps = ", (к строке («настройки».«предел шагов»))] по "")), («Строка вывода» от "    " и "return ctx")] по "")
  «Без перевода в конце» от «вывод»

тотальная функция «Строка аргумента вызова»
  принимает «акк»: «Зип», «идентификатор»: строка
  возвращает «Зип»
  пусть «разделитель» равно (если («акк».«индекс») равен 0 то "" иначе ", ")
  запись «Зип» с «индекс» равным ((«акк».«индекс») плюс 1) и «текст» равным (соединить [(«акк».«текст»), «разделитель», "args[", (к строке («акк».«индекс»)), "]"] по "")

// Договор функции на двери: `требует`.
//
// Программа без единого `требует` не получает отсюда ни строки и ни одного
// временного имени — печать обязана остаться побайтово прежней.
функция «Договор на двери»
  принимает «функция»: «Функция», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  если пусто («функция».«предусловия»)
    то запись «Блок» с «состояние» равным «состояние» и «вывод» равным ""
    иначе «Проверки договора» от «функция» и «общее» и «состояние»

функция «Проверки договора»
  принимает «функция»: «Функция», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  пусть «контекст» равно («Контекст двери» от «функция» и «общее»)
  пусть «чистое» равно («Начальное взятое» от «состояние» и «общее» и («контекст».«параметры»))
  пусть «нуль» равно (запись «Блок» с «состояние» равным «чистое» и «вывод» равным "")
  свёртка («функция».«предусловия») начиная с «нуль» как «акк» и «предусловие» → «Шаг предусловия» от «акк» и «предусловие» и «контекст» и «функция»

// Отказ у предусловия свой, и помощник у него свой — `rt.pre` рядом с
// `rt.post`: одно сообщение на две разные вещи разошлось бы молча.
функция «Шаг предусловия»
  принимает «блок»: «Блок», «предусловие»: «Предусловие», «контекст»: «Контекст», «функция»: «Функция»
  возвращает «Блок»
  пусть «отступ» равно "        "
  пусть «проверка» равно («Печать значения» от («предусловие».«выражение») и «контекст» и («блок».«состояние») и «отступ»)
  пусть «сообщение» равно (если («предусловие».«есть сообщение») то («предусловие».«сообщение») иначе (соединить ["не выполнено требование «", («предусловие».«имя»), "» функции «", («функция».«имя»), "»"] по ""))
  пусть «строки» равно (соединить [(«Строка вывода» от «отступ» и (соединить ["# требует «", («предусловие».«имя»), "»"] по "")), («Строка вывода» от «отступ» и (соединить ["if not rt.pre(ctx, ", («проверка».«значение»), ", ", («Строка Python» от («предусловие».«имя»)), ", ", («Строка Python» от («функция».«имя»)), "):"] по "")), («Строка вывода» от («Глубже» от «отступ») и (соединить ["raise rt.fail(", («Строка Python» от («предусловие».«код»)), ", ", («Строка Python» от «сообщение»), ")"] по ""))] по "")
  запись «Блок» с «состояние» равным («проверка».«состояние») и «вывод» равным (соединить [(«блок».«вывод»), («проверка».«вывод»), «строки»] по "")

// Склейка, а не f-строка: имя модели вправе содержать фигурные скобки, и
// подстановка их бы не пережила.
//
// Порядок проверок на двери: сначала арность, потом объявленные типы
// (`rt.check_entry`, зовёт прогонщик ДО `call`), и только потом договор.
функция «Ветка диспетчера»
  принимает «функция»: «Функция», «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  пусть «арность» равно (к строке (длина («функция».«параметры»)))
  пусть «нуль» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
  пусть «список» равно ((свёртка («функция».«параметры») начиная с «нуль» как «акк» и «параметр» → «Строка аргумента вызова» от «акк» и («параметр».«имя»)).«текст»)
  пусть «аргументы» равно (если пусто («функция».«параметры») то "" иначе (соединить ", " с «список»))
  пусть «сообщение» равно (соединить ["функция «", («функция».«имя»), "» принимает ", «арность», " аргум., получено "] по "")
  пусть «договор» равно («Договор на двери» от «функция» и «общее» и «состояние»)
  запись «Блок» с «состояние» равным («договор».«состояние») и «вывод» равным (соединить [(«Строка вывода» от "    " и (соединить ["if name == ", («Строка Python» от («функция».«имя»)), ":"] по "")), («Строка вывода» от "        " и (соединить ["if len(args) != ", «арность», ":"] по "")), («Строка вывода» от "            " и "raise rt.fail("), («Строка вывода» от "                " и "rt.CODE_TYPE,"), («Строка вывода» от "                " и («Строка Python» от «сообщение»)), («Строка вывода» от "                " и "+ str(len(args)),"), («Строка вывода» от "            " и ")"), («договор».«вывод»), («Строка вывода» от "        " и (соединить ["return ", («Значение по ключу» от («общее».«ид функций») и («функция».«имя»)), "(ctx", «аргументы», ")"] по ""))] по "")

функция «Шаг ветки диспетчера»
  принимает «блок»: «Блок», «функция»: «Функция», «общее»: «Общее»
  возвращает «Блок»
  пусть «ветка» равно («Ветка диспетчера» от «функция» и «общее» и («блок».«состояние»))
  запись «Блок» с «состояние» равным («ветка».«состояние») и «вывод» равным (соединить («блок».«вывод») с («ветка».«вывод»))

// Вызов по имени — это не вызов внутри программы, а ГРАНИЦА: внутренние вызовы
// идут прямо на `fn_…`, сюда заходит только тот, у кого имя функции строка.
функция «Печать диспетчера»
  принимает «общее»: «Общее», «состояние»: «Состояние»
  возвращает «Блок»
  пусть «описание» равно («Документация» от ["Вызов функции по её исходному имени flang.", "", "Нужен прогонщику и всякому, кто связывает программу с внешним миром", "динамически (скрипт, тест, служба). Коды и тексты — те же, что у", "интерпретатора: «не найдена функция …» и «функция … принимает N аргум.»."] и "    ")
  пусть «начало» равно (запись «Блок» с «состояние» равным «состояние» и «вывод» равным "")
  пусть «ветки» равно (свёртка («общее».«функции») начиная с «начало» как «акк» и «функция» → «Шаг ветки диспетчера» от «акк» и «функция» и «общее»)
  запись «Блок» с «состояние» равным («ветки».«состояние») и «вывод» равным («Без перевода в конце» от (соединить [(«Строка вывода» от "" и "def call(ctx, name, args):"), «описание», («ветки».«вывод»), («Строка вывода» от "    " и "raise rt.fail(rt.CODE_UNKNOWN_NAME, \"не найдена функция «\" + name + \"»\")")] по ""))

// ═══════════════════════════ файлы ═══════════════════════════

объект «Файл»
  «путь»: строка
  «содержимое»: строка

объект «Настройки»
  «путь»: строка
  «есть путь»: признак
  «база»: число
  «предел глубины»: число
  «предел шагов»: число
  «прогонщик»: признак
  «рантайм исходник»: строка
  «исходник прогонщика»: строка

объект «Итог печати»
  «файлы»: список «Файл»
  «ошибка»: строка

объект «Тела»
  «состояние»: «Состояние»
  «части»: список строки

тотальная функция «Шапка»
  принимает «есть модуль»: признак, «модуль»: строка, «что»: строка
  возвращает строка
  пусть «строка модуля» равно (если «есть модуль» то (соединить ["# Модуль flang: «", «модуль», "»."] по "") иначе "# Программа flang без имени модуля.")
  соединить ["# Сгенерировано flang (бэкенд Python, flang/src/emit/python.mjs). Не редактировать руками.\n", «строка модуля», "\n# Файл: ", «что», ".\n# Правьте исходник на flang и печатайте заново: любая правка здесь потеряется."] по ""

тотальная функция «Печать Makefile»
  принимает «файл»: строка, «прогонщик»: признак
  возвращает строка
  пусть «проверка» равно (если «прогонщик» то "\t$(PYTHON) -B -c \"import $(MODULE), flang_runtime, flang_cli\"\n" иначе "\t$(PYTHON) -B -c \"import $(MODULE), flang_runtime\"\n")
  пусть «прогон» равно (если «прогонщик» то "\nrun:\n\t$(PYTHON) -B flang_cli.py $(MODULE)\n" иначе "")
  пусть «цели» равно (если «прогонщик» то ".PHONY: all check run lint clean\n" иначе ".PHONY: all check lint clean\n")
  соединить ["# Сгенерировано flang (бэкенд Python). Целей ровно столько, сколько нужно:\n", "# напечатанный код обязан импортироваться и запускаться без единой правки.\n", "PYTHON ?= python3\n", "MODULE ?= ", «файл», "\n", "\n", "all: check\n", "\n", "# Импорт без записи .pyc: кэш байткода — мусор в чужом каталоге.\n", "check:\n", «проверка», «прогон», "\n", "# Линтер необязателен: его отсутствие не делает напечатанный код неверным.\n", "lint:\n", "\truff check . || true\n", "\n", "clean:\n", "\trm -rf __pycache__\n", "\n", «цели»] по ""

тотальная функция «Заголовок исходника»
  принимает «есть модуль»: признак, «модуль»: строка
  возвращает строка
  пусть «первая» равно (если «есть модуль» то (соединить ["Модуль flang «", «модуль», "», напечатанный в Python."] по "") иначе "Программа flang, напечатанная в Python.")
  соединить [(«Шапка» от «есть модуль» и «модуль» и "реализация: функции, конструкторы значений, вызов по имени"), "\n\"\"\"\n", «первая», "\n\nКонтракт вызова: функция возвращает значение либо возбуждает\nflang_runtime.FlangError с кодом и текстом, дословно совпадающими с\nинтерпретатором flang. Все значения — flang_runtime.Value: числа там всегда\nfloat (целых чисел в flang нет), признак отличается от числа тегом, а не\nтипом Python, и равенство скаляров — Object.is, а не ==.\n\"\"\"\n\nimport flang_runtime as rt"] по ""

тотальная функция «Исходник модуля»
  принимает «есть модуль»: признак, «модуль»: строка, «части»: список строки
  возвращает строка
  пусть «непустые» равно (отфильтровать «части» где «часть» → (длина «часть») больше 0)
  соединить [(соединить («Части с заголовком» от («Заголовок исходника» от «есть модуль» и «модуль») и «непустые») по "\n\n\n"), "\n"] по ""

тотальная функция «Части с заголовком»
  принимает «первый»: строка, «остальные»: список строки
  возвращает список строки
  свёртка «остальные» начиная с [«первый»] как «акк» и «часть» → добавить «часть» к «акк»

// ═══════════════════════════ печать программы ═══════════════════════════

тотальная функция «Имя модуля»
  принимает «программа»: «Значение»
  возвращает строка
  «Строка поля» от «программа» и "module"

тотальная функция «Есть имя модуля»
  принимает «программа»: «Значение»
  возвращает признак
  (длина («Имя модуля» от «программа»)) больше 0

тотальная функция «Имя файла программы»
  принимает «программа»: «Значение», «настройки»: «Настройки»
  возвращает строка
  если («настройки».«есть путь»)
    то «настройки».«путь»
    иначе
      если «Есть имя модуля» от «программа»
        то «Безопасный идентификатор» от («Змейка» от («Имя модуля» от «программа»))
        иначе "program"

тотальная функция «Ошибка имени файла»
  принимает «файл»: строка, «модуль»: строка
  возвращает строка
  если «Занято рантаймом» от «файл»
    то соединить ["модуль «", «модуль», "» даёт файл «", «файл», ".py», занятый рантаймом бэкенда — переименуйте модуль"] по ""
    иначе ""

тотальная функция «Занято рантаймом»
  принимает «файл»: строка
  возвращает признак
  если «файл» равен "flang_runtime"
    то да
    иначе «файл» равен "flang_cli"

функция «Шаг тела функции»
  принимает «тела»: «Тела», «функция»: «Функция», «общее»: «Общее»
  возвращает «Тела»
  пусть «блок» равно («Печать функции» от «функция» и «общее» и («тела».«состояние»))
  запись «Тела» с «состояние» равным («блок».«состояние») и «части» равным (добавить («блок».«вывод») к («тела».«части»))

функция «Тела вариантов суммы»
  принимает «сумма»: «Сумма типов», «общее»: «Общее»
  возвращает список строки
  отобразить (отфильтровать («сумма».«варианты») где «в» → «Есть в таблице» от («общее».«ид вариантов») и («в».«имя»)) как «в» → «Печать конструктора варианта» от «в» и («сумма».«имя») и «общее»

функция «Тела конструкторов»
  принимает «общее»: «Общее»
  возвращает список строки
  свёртка («общее».«суммы») начиная с пустой список как «акк» и «сумма» → «Слить строки» от «акк» и («Тела вариантов суммы» от «сумма» и «общее»)

функция «Печать тел»
  принимает «общее»: «Общее», «состояние»: «Состояние», «настройки»: «Настройки»
  возвращает «Тела»
  пусть «фабрики» равно (отобразить («общее».«записи») как «запись» → «Печать фабрики» от «запись» и «общее»)
  пусть «начальные» равно («Слить строки» от («Слить строки» от [(«Печать нового контекста» от «настройки»)] и «фабрики») и («Тела конструкторов» от «общее»))
  пусть «нуль» равно (запись «Тела» с «состояние» равным «состояние» и «части» равным «начальные»)
  пусть «после функций» равно (свёртка («общее».«функции») начиная с «нуль» как «акк» и «функция» → «Шаг тела функции» от «акк» и «функция» и «общее»)
  пусть «диспетчер» равно («Печать диспетчера» от «общее» и («после функций».«состояние»))
  запись «Тела» с «состояние» равным («диспетчер».«состояние») и «части» равным (добавить («диспетчер».«вывод») к («после функций».«части»))

тотальная функция «Слить файлы»
  принимает «первые»: список «Файл», «вторые»: список «Файл»
  возвращает список «Файл»
  свёртка «вторые» начиная с «первые» как «акк» и «файл» → добавить «файл» к «акк»

// Первым делом программа ПОНИЖАЕТСЯ: `функция «Имя»` становится вариантом,
// `ф от 5` — вызовом диспетчера, и дальше печать высшего порядка не видит
// вовсе. Ровно там же зовёт проход и эталон (`emitPython`), и это не
// совпадение, а условие побайтовой сверки.
функция «Печать программы»
  принимает «программа»: «Значение», «настройки»: «Настройки»
  возвращает «Итог печати»
  пусть «понижено» равно («Дефункционализировать» от «программа»)
  пусть «общее» равно («Собрать общее» от «понижено»)
  пусть «файл» равно («Имя файла программы» от «понижено» и «настройки»)
  пусть «есть модуль» равно («Есть имя модуля» от «понижено»)
  пусть «модуль» равно («Имя модуля» от «понижено»)
  пусть «по файлу» равно («Записать ошибку» от «Пустое состояние» и («Ошибка имени файла» от «файл» и «модуль»))
  пусть «начало» равно («Записать ошибку» от «по файлу» и («общее».«ошибка имён»))
  пусть «тела» равно («Печать тел» от «общее» и «начало» и «настройки»)
  пусть «рантайм» равно (запись «Файл» с «путь» равным "flang_runtime.py" и «содержимое» равным (соединить [(«Шапка» от «есть модуль» и «модуль» и "рантайм: значения, числа, строки, диагностики"), "\n", («настройки».«рантайм исходник»)] по ""))
  пусть «модульный» равно (запись «Файл» с «путь» равным (соединить «файл» с ".py") и «содержимое» равным («Исходник модуля» от «есть модуль» и «модуль» и («тела».«части»)))
  пусть «прогонщик» равно (запись «Файл» с «путь» равным "flang_cli.py" и «содержимое» равным (соединить [(«Шапка» от «есть модуль» и «модуль» и "прогонщик: JSON на входе, JSON на выходе"), "\n", («настройки».«исходник прогонщика»)] по ""))
  пусть «makefile» равно (запись «Файл» с «путь» равным "Makefile" и «содержимое» равным («Печать Makefile» от «файл» и («настройки».«прогонщик»)))
  пусть «с прогонщиком» равно (если («настройки».«прогонщик») то («Слить файлы» от [«рантайм», «модульный»] и [«прогонщик»]) иначе [«рантайм», «модульный»])
  запись «Итог печати» с «файлы» равным (добавить «makefile» к «с прогонщиком») и «ошибка» равным ((«тела».«состояние»).«ошибка»)

// ═══════════════════════════ долги ═══════════════════════════
//
// Названо здесь, а не умолчано: побайтовая сверка идёт по корпусу, и то, чего в
// корпусе нет, ею не поймано.
//
//   • `требуетПланировщика` — отказ печатать программу с процессами. Ни одна
//     программа корпуса конкурентности не объявляет, поэтому проверки здесь
//     нет; у `emit-c.flang` тот же долг.
//   • Проверки `prepare` эталона, которые ловят битый AST (функция без имени,
//     объявленная дважды, тело-ничто, `params` не списком): их даёт разборщик
//     раньше печати, и на корпусе они молчат.
//   • Общий проход `escapeBidiInFiles` по ВСЕМ файлам: двунаправленные
//     управляющие снимаются только в строковых литералах (таблица «Замены
//     Python»), а не в комментариях и строках документации.
