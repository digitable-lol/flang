    "static ENTRY: rt::EntryTable = rt::EntryTable {",
    "    types: &["
  ]

тотальная функция «Хвост границы входа Rust»
  возвращает список строки
  обеспечивает «строк хвоста границы входа ровно семь» (длина результат) равен 7
  [
    "    ],",
    "};",
    "",
    "/// Объявленные типы параметров: по ним сверяется вход извне.",
    "pub fn entry() -> &'static rt::EntryTable {",
    "    &ENTRY",
    "}"
  ]

тотальная функция «Строки границы входа Rust»
  принимает «настройки»: «Настройки Rust»
  возвращает список строки
  обеспечивает «строк границы не меньше, чем в шапке и хвосте вместе» (длина результат) не меньше ((длина «Шапка границы входа Rust») плюс (длина «Хвост границы входа Rust»))
  пусть «с типами» равно («Слить строки» от («Шапка границы входа Rust») и (отобразить («настройки».«типы входа») как «тип» → «Строка типа входа Rust» от «тип»))
  пусть «с полями» равно («Слить строки» от («Слить строки» от «с типами» и ["    ],", "    fields: &["]) и (отобразить («настройки».«поля входа») как «поле» → «Строка поля входа Rust» от «поле»))
  пусть «с вариантами» равно («Слить строки» от («Слить строки» от «с полями» и ["    ],", "    variants: &["]) и (отобразить («настройки».«варианты входа») как «вариант» → «Строка варианта входа Rust» от «вариант»))
  пусть «с параметрами» равно («Слить строки» от («Слить строки» от «с вариантами» и ["    ],", "    params: &["]) и (отобразить («настройки».«параметры входа») как «параметр» → «Строка параметра входа Rust» от «параметр»))
  «Слить строки» от «с параметрами» и («Хвост границы входа Rust»)

тотальная функция «Печать границы входа Rust»
  принимает «настройки»: «Настройки Rust»
  возвращает строка
  обеспечивает «граница входа объявляет таблицу ENTRY» результат содержит "static ENTRY"
  соединить («Строки границы входа Rust» от «настройки») по "\n"


// ═════════════════════ имена, занятые самой целью Rust ═════════════════════
//
// Имя модуля flang доезжает до цели именем в ЕЁ пространстве имён, а часть этого
// пространства цель занимает сама. Улика: `модуль «JSON»` печатался в `json.py`
// рядом с прогонщиком, тот делал `import json` и получал НАШ модуль вместо
// библиотеки — ломалось не при печати, а при запуске.
//
// Свободное имя возвращается КАК ЕСТЬ: у программы, чьё имя цель не занимала,
// вывод не меняется ни на байт. Занятое обходится СУФФИКСОМ: приставка `flang_`
// у бэкенда уже занята — так зовутся `flang_runtime` и `flang_cli`, и по ней
// напечатанное отличают от программы. Отказывать нельзя: имя автор выбрал
// законно, а набор занятого у цели свой и меняется от её версии.

тотальная функция «Занято целью Rust»
  возвращает список строки
  обеспечивает «целью занято ровно восемь имён» (длина результат) равен 8
  [
    "std", "core", "alloc", "proc_macro", "test", "main", "lib", "build"
  ]

// Имя модуля доезжает до Rust идентификатором в `pub mod <имя>;`, а значит
// обязано разойтись не только с именами ящиков, но и с ключевыми словами языка
// и с тем, что бэкенд объявляет рядом. Улики: `модуль «Enum»` давал
// `pub mod enum;` («expected identifier, found keyword `enum`»), то же с `Type`,
// `Do`, `Fn`, `Match`; `модуль «Program»` сталкивался с собственным `program`
// бэкенда («the name `program` is defined multiple times»).
тотальная функция «Занято именем модуля Rust»
  возвращает список строки
  обеспечивает «занятое именем модуля не уже занятого целью» (длина результат) не меньше (длина «Занято целью Rust»)
  «Слить строки» от («Слить строки» от «Занято целью Rust» и «Зарезервировано в Rust») и «Занято бэкендом»

тотальная функция «Обойти занятое целью Rust»
  принимает «имя»: строка
  возвращает строка
  обеспечивает «свободное имя модуля остаётся собой» если не («Занято именем модуля Rust» содержит «имя») то результат равен «имя» иначе да
  пример «Имя ящика уступает место»
    дано «имя» равно "std"
    ожидается "std_flang"
  пример «Свободное имя модуля остаётся собой»
    дано «имя» равно "para_chisel"
    ожидается "para_chisel"
  если «Занято именем модуля Rust» содержит «имя»
    то соединить «имя» с "_flang"
    иначе «имя»

тотальная функция «Имя файла программы Rust»
  принимает «программа»: «Значение», «настройки»: «Настройки Rust»
  возвращает строка
  обеспечивает «заданный путь берётся как есть» если («настройки».«есть путь») то результат равен («настройки».«путь») иначе да
  пример «Заданный путь берётся как есть, имя модуля не смотрится»
    дано «программа» равно (вариант «Значение записи» с «поля» равным пустой список)
    дано «настройки» равно (запись «Настройки Rust» с «путь» равным "src/lib.rs" и «есть путь» равным да и «база» равным 0 и «предел глубины» равным 0 и «предел шагов» равным 0 и «прогонщик» равным нет и «рантайм исходник» равным "" и «исходник прогонщика» равным "" и «типы входа» равным пустой список и «поля входа» равным пустой список и «варианты входа» равным пустой список и «параметры входа» равным пустой список)
    ожидается "src/lib.rs"
  если («настройки».«есть путь»)
    то «настройки».«путь»
    иначе
      если «Есть имя модуля» от «программа»
        то «Обойти занятое целью Rust» от («Змейка Rust» от («Имя модуля» от «программа»))
        иначе "program"

// Прогонщик — три строки поверх библиотеки, а не второй её экземпляр: один и
// тот же файл в двух целях сборки cargo считает неоднозначностью.
тотальная функция «Файлы прогонщика Rust»
  принимает «файлы»: список «Файл», «прогонщик»: признак, «есть модуль»: признак, «модуль»: строка, «настройки»: «Настройки Rust»
  возвращает список «Файл»
  обеспечивает «без прогонщика список файлов не меняется» если не «прогонщик» то результат равен «файлы» иначе да
  пример «Без прогонщика список файлов не удлиняется»
    дано «файлы» равно [(запись «Файл» с «путь» равным "src/lib.rs" и «содержимое» равным "")]
    дано «прогонщик» равно нет
    дано «есть модуль» равно нет
    дано «модуль» равно ""
    дано «настройки» равно (запись «Настройки Rust» с «путь» равным "src/lib.rs" и «есть путь» равным да и «база» равным 0 и «предел глубины» равным 0 и «предел шагов» равным 0 и «прогонщик» равным нет и «рантайм исходник» равным "" и «исходник прогонщика» равным "" и «типы входа» равным пустой список и «поля входа» равным пустой список и «варианты входа» равным пустой список и «параметры входа» равным пустой список)
    ожидается [(запись «Файл» с «путь» равным "src/lib.rs" и «содержимое» равным "")]
  если «прогонщик»
    то «Слить файлы» от «файлы» и [
      (запись «Файл» с «путь» равным "src/cli.rs" и «содержимое» равным (соединить [(«Шапка файла Rust» от «есть модуль» и «модуль» и "прогонщик: JSON на входе, JSON на выходе"), "\n\n", («настройки».«исходник прогонщика»)] по "")),
      (запись «Файл» с «путь» равным "src/main.rs" и «содержимое» равным («Печать main» от «есть модуль» и «модуль»))
    ]
    иначе «файлы»

тотальная функция «Снять двунаправленные в файле»
  принимает «файл»: «Файл»
  возвращает «Файл»
  обеспечивает «путь файла снятие двунаправленных не трогает» результат.«путь» равен («файл».«путь»)
  пример «Двунаправленный в содержимом уезжает экранированным, путь цел»
    дано «файл» равно (запись «Файл» с «путь» равным "src/lib.rs" и «содержимое» равным "fl\u202eok")
    ожидается (запись «Файл» с «путь» равным "src/lib.rs" и «содержимое» равным "fl\\u{202e}ok")
  запись «Файл» с «путь» равным («файл».«путь») и «содержимое» равным («Снять двунаправленные Rust» от («файл».«содержимое»))

// Первым делом программа ПОНИЖАЕТСЯ: `функция «Имя»` становится вариантом,
// `ф от 5` — вызовом диспетчера, и дальше печать высшего порядка не видит
// вовсе.
функция «Печать программы в Rust»
  принимает «программа»: «Значение», «настройки»: «Настройки Rust»
  возвращает «Итог печати»
  обеспечивает «отказ по конкурентности не даёт ни одного файла» если (длина («Отказ по конкурентности» от «программа»)) больше 0 то (пусто результат.«файлы») иначе да
  пусть «отказ» равно («Отказ по конкурентности» от «программа»)
  если (длина «отказ») больше 0
    то запись «Итог печати» с «файлы» равным пустой список и «ошибка» равным «отказ»
    иначе «Печать понижённой программы» от («Дефункционализировать» от «программа») и «настройки»

функция «Печать понижённой программы»
  принимает «программа»: «Значение», «настройки»: «Настройки Rust»
  возвращает «Итог печати»
  пусть «общее» равно («Собрать общее Rust» от «программа»)
  пусть «файл» равно («Имя файла программы Rust» от «программа» и «настройки»)
  пусть «есть модуль» равно («Есть имя модуля» от «программа»)
  пусть «модуль» равно («Имя модуля» от «программа»)
  пусть «начало» равно («Проверить столкновения Rust» от «общее» и «Пустое состояние Rust»)
  пусть «настроечный» равно («Блок настроек Rust» от («настройки».«база») и («настройки».«предел глубины») и («настройки».«предел шагов»))
  пусть «тела» равно («Печать тел Rust» от «общее» и «начало»)
  пусть «состояние» равно («тела».«состояние»)
  пусть «прогонщик» равно («настройки».«прогонщик»)
  // Граница входа печатается ПОСЛЕ диспетчера и всегда: типы параметров нужны
  // прогонщику, а прогонщик у крейта по умолчанию есть, и `src/cli.rs` зовёт
  // `program::entry()` прямо. Без этого блока напечатанный крейт с прогонщиком
  // не собирался бы вовсе.
  пусть «все тела» равно (добавить («Печать границы входа Rust» от «настройки») к («Слить строки» от (добавить «настроечный» к пустой список) и («тела».«части»)))
  пусть «файлы начала» равно [
    (запись «Файл» с «путь» равным "Cargo.toml" и «содержимое» равным («Печать Cargo» от «есть модуль» и «модуль» и «прогонщик»)),
    (запись «Файл» с «путь» равным "src/runtime.rs" и «содержимое» равным (соединить [(«Шапка файла Rust» от «есть модуль» и «модуль» и "рантайм: значения, числа, строки, диагностики"), "\n\n", («настройки».«рантайм исходник»)] по "")),
    (запись «Файл» с «путь» равным (соединить ["src/", «файл», ".rs"] по "") и «содержимое» равным («Печать исходника Rust» от «есть модуль» и «модуль» и «все тела»)),
    (запись «Файл» с «путь» равным "src/lib.rs" и «содержимое» равным («Печать lib» от «есть модуль» и «модуль» и «файл» и «прогонщик»))
  ]
  пусть «с прогонщиком» равно («Файлы прогонщика Rust» от «файлы начала» и «прогонщик» и «есть модуль» и «модуль» и «настройки»)
  пусть «все» равно (добавить (запись «Файл» с «путь» равным "Makefile" и «содержимое» равным («Печать Makefile Rust» от «прогонщик»)) к «с прогонщиком»)
  запись «Итог печати» с «файлы» равным (отобразить «все» как «файл» → «Снять двунаправленные в файле» от «файл») и «ошибка» равным («состояние».«ошибка»)
