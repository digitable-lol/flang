тотальная функция «Перечень полей Rust»
  принимает «поля»: список «Поле типа в C»
  возвращает строка
  обеспечивает «без полей перечень так и говорит» если пусто «поля» то результат равен "без полей" иначе да
  пример «Без полей перечень так и говорит»
    дано «поля» равно пустой список
    ожидается "без полей"
  пример «Поля перечислены в ёлочках через запятую»
    дано «поля» равно [(запись «Поле типа в C» с «имя» равным "левое" и «тип» равным (вариант «Значение записи» с «поля» равным [])), (запись «Поле типа в C» с «имя» равным "правое" и «тип» равным (вариант «Значение записи» с «поля» равным []))]
    ожидается "«левое», «правое»"
  если пусто «поля»
    то "без полей"
    иначе соединить (отобразить «поля» как «поле» → соединить ["«", («поле».«имя»), "»"] по "") по ", "

тотальная функция «Шаг присвоения фабрики Rust»
  принимает «зип»: «Зип», «поле»: «Поле типа в C», «идентификаторы»: список строки
  возвращает «Зип»
  обеспечивает «присвоение фабрики двигает индекс на один» результат.«индекс» равен ((«зип».«индекс») плюс 1)
  пример «Первое поле: индекс с нуля, кириллица в литерале не экранируется»
    дано «зип» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
    дано «поле» равно (запись «Поле типа в C» с «имя» равным "ключ" и «тип» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»)))
    дано «идентификаторы» равно ["t1"]
    ожидается (запись «Зип» с «индекс» равным 1 и «текст» равным "    fields.push(rt::field(\"ключ\", t1));\n")
  пусть «строка» равно (соединить ["    fields.push(rt::field(", («Строка Rust» от («поле».«имя»)), ", ", («Элемент по индексу» от «идентификаторы» и («зип».«индекс»)), "));\n"] по "")
  запись «Зип» с «индекс» равным ((«зип».«индекс») плюс 1) и «текст» равным (соединить («зип».«текст») с «строка»)

тотальная функция «Тело фабрики Rust»
  принимает «поля»: список «Поле типа в C», «идентификаторы»: список строки, «итог»: строка
  возвращает строка
  если пусто «поля»
    то соединить ["    ", «итог», "\n"] по ""
    иначе
      пусть «нуль» равно (запись «Зип» с «индекс» равным 0 и «текст» равным "")
      пусть «строки» равно (свёртка «поля» начиная с «нуль» как «акк» и «поле» → «Шаг присвоения фабрики Rust» от «акк» и «поле» и «идентификаторы»)
      соединить ["    let mut fields: Vec<rt::Field> = Vec::with_capacity(", (к строке (длина «поля»)), ");\n", («строки».«текст»), "    ", «итог», "\n"] по ""

функция «Печать фабрики Rust»
  принимает «запись»: «Запись типа», «общее»: «Общее Rust»
  возвращает строка
  обеспечивает «фабрика объявляется как pub fn» результат содержит "pub fn "
  пусть «поля» равно («запись».«поля»)
  пусть «идентификаторы» равно («Уникальные имена Rust» от («Имена полей типа» от «поля»))
  пусть «параметры» равно (соединить (отобразить «идентификаторы» как «идентификатор» → соединить [«идентификатор», ": rt::Value"] по "") по ", ")
  пусть «итог» равно (если пусто «поля» то "rt::record(Vec::new())" иначе "rt::record(fields)")
  соединить [
    "/// Запись FTS «", («запись».«имя»), "»: ", («Перечень полей Rust» от «поля»), ".\n",
    "///\n",
    "/// Запись flang тотальна: пропущенное поле — это «ничто», а не дырка.\n",
    "pub fn ", («Значение по ключу» от («общее».«ид фабрик») и («запись».«имя»)), "(", «параметры», ") -> rt::Value {\n",
    («Тело фабрики Rust» от «поля» и «идентификаторы» и «итог»),
    "}"
  ] по ""

функция «Печать конструктора варианта Rust»
  принимает «вариант»: «Вариант типа», «сумма»: строка, «общее»: «Общее Rust»
  возвращает строка
  пусть «поля» равно («вариант».«поля»)
  пусть «идентификаторы» равно («Уникальные имена Rust» от («Имена полей типа» от «поля»))
  пусть «параметры» равно (соединить (отобразить «идентификаторы» как «идентификатор» → соединить [«идентификатор», ": rt::Value"] по "") по ", ")
  пусть «имя» равно («Строка Rust» от («вариант».«имя»))
  пусть «итог» равно (если пусто «поля» то (соединить ["rt::variant(", «имя», ", Vec::new())"] по "") иначе (соединить ["rt::variant(", «имя», ", fields)"] по ""))
  соединить [
    "/// Вариант «", («вариант».«имя»), "» суммы типов «", «сумма», "».\n",
    "///\n",
    "/// Дискриминант — имя варианта; проверяется через `rt::variant_is`.\n",
    "pub fn ", («Значение по ключу» от («общее».«ид вариантов») и («вариант».«имя»)), "(", «параметры», ") -> rt::Value {\n",
    («Тело фабрики Rust» от «поля» и «идентификаторы» и «итог»),
    "}"
  ] по ""

