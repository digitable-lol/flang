    (запись «Блок таблицы» с «основание» равным 8192 и «символы» равным "\u0020\u2000\u0020\u2001\u0020\u2002\u0020\u2003\u0020\u2004\u0020\u2005\u0020\u2006\u0020\u2007\u0020\u2008\u0020\u2009\u0020\u200a\u0020\u200b\u0020\u200c\u0020\u200d\u0020\u200e\u0020\u200f\u0020\u2010\u0020\u2011\u0020\u2012\u0020\u2013\u0020\u2014\u0020\u2015\u0020\u2016\u0020\u2017\u0020\u2018\u0020\u2019\u0020\u201a\u0020\u201b\u0020\u201c\u0020\u201d\u0020\u201e\u0020\u201f\u0020\u2020\u0020\u2021\u0020\u2022\u0020\u2023\u0020\u2024\u0020\u2025\u0020\u2026\u0020\u2027\u0020\u2028\u0020\u2029\u0020\u202a\u0020\u202b\u0020\u202c\u0020\u202d\u0020\u202e\u0020\u202f\u0020\u2030\u0020\u2031\u0020\u2032\u0020\u2033\u0020\u2034\u0020\u2035\u0020\u2036\u0020\u2037\u0020\u2038\u0020\u2039\u0020\u203a\u0020\u203b\u0020\u203c\u0020\u203d\u0020\u203e\u0020\u203f\u0020\u2040\u0020\u2041\u0020\u2042\u0020\u2043\u0020\u2044\u0020\u2045\u0020\u2046\u0020\u2047\u0020\u2048\u0020\u2049\u0020\u204a\u0020\u204b\u0020\u204c\u0020\u204d\u0020\u204e\u0020\u204f\u0020\u2050\u0020\u2051\u0020\u2052\u0020\u2053\u0020\u2054\u0020\u2055\u0020\u2056\u0020\u2057\u0020\u2058\u0020\u2059\u0020\u205a\u0020\u205b\u0020\u205c\u0020\u205d\u0020\u205e\u0020\u205f\u0020\u2060\u0020\u2061\u0020\u2062\u0020\u2063\u0020\u2064\u0020\u2065\u0020\u2066\u0020\u2067\u0020\u2068\u0020\u2069\u0020\u206a\u0020\u206b\u0020\u206c\u0020\u206d\u0020\u206e\u0020\u206f\u0020\u2070\u0020\u2071\u0020\u2072\u0020\u2073\u0020\u2074\u0020\u2075\u0020\u2076\u0020\u2077\u0020\u2078\u0020\u2079\u0020\u207a\u0020\u207b\u0020\u207c\u0020\u207d\u0020\u207e\u0020\u207f"),
