  пример «Текст на строке открывающих кавычек — беда на месте этого текста»
    дано исходник равно "пусть а равно \"\"\" текст\n"
    ожидается [
      (запись «Диагностика» с «код» равным """
      FLANG_LEX""" и «строка» равным 1 и «столбец» равным 19 и «сообщение» равным """
      текст блока начинается со следующей строки: за открывающими тремя кавычками на строке ничего не стоит""")]
  пример «Сломанный знак в блоке — беда на его строке и в его столбце»
    дано исходник равно "пусть а равно \"\"\"\n  первая\n  вторая \\u12\n  \"\"\"\n"
    ожидается [
      (запись «Диагностика» с «код» равным """
      FLANG_LEX""" и «сообщение» равным "неверный Unicode-escape" и «строка» равным 3 и «столбец» равным 10)]
  («Разобрать» от исходник).«диагностики»

тотальная функция «Коды диагностик»
  принимает исходник: строка
  возвращает список строки
  обеспечивает «кодов ровно столько, сколько диагностик» (длина результат) равен (длина («Диагностики» от исходник))
  пример «Ровный отступ — тишина»
    дано исходник равно "функция «Ф»\n  возвращает число\n  1\n"
    ожидается пустой список
  пример «Рваный отступ»
    дано исходник равно "функция «Ф»\n    возвращает число\n  1\n"
    ожидается ["FLANG_LEX"]
  отобразить («Диагностики» от исходник) как диагностика → диагностика.«код»

тотальная функция «Показать токен»
  принимает токен: «Токен»
  возвращает строка
  обеспечивает «отступ показывается уголком» если токен.«вид» равен "indent" то результат равен ">" иначе да
  пример «Отступ показывается уголком»
    дано токен равно (запись «Токен» с «вид» равным "indent" и «значение» равным "" и «число» равным 0 и «текст» равным "" и «в ёлочках» равным нет и «нижний» равным "" и «строка» равным 2 и «столбец» равным 1)
    ожидается ">"
  пример «Число показывается своим текстом»
    дано токен равно (запись «Токен» с «вид» равным "number" и «значение» равным "" и «число» равным 3.5 и «текст» равным "3.5" и «в ёлочках» равным нет и «нижний» равным "" и «строка» равным 4 и «столбец» равным 2)
    ожидается "число 3.5"
  пример «Имя в ёлочках показывается ёлочкой»
    дано токен равно (запись «Токен» с «вид» равным "name" и «значение» равным "Печать в C" и «число» равным 0 и «текст» равным "" и «в ёлочках» равным да и «нижний» равным "печать в c" и «строка» равным 4 и «столбец» равным 3)
    ожидается "ёлочка Печать в C"
  пример «Знак показывается знаком»
    дано токен равно (запись «Токен» с «вид» равным "punct" и «значение» равным "+" и «число» равным 0 и «текст» равным "" и «в ёлочках» равным нет и «нижний» равным "" и «строка» равным 3 и «столбец» равным 7)
    ожидается "знак +"
  если токен.«вид» равен "indent"
    то ">"
    иначе
      если токен.«вид» равен "dedent"
        то "<"
        иначе
          если токен.«вид» равен "newline"
            то "/"
            иначе
              если токен.«вид» равен "eof"
                то "."
                иначе
                  если токен.«вид» равен "number"
                    то соединить "число " с токен.«текст»
                    иначе
                      если токен.«вид» равен "keyword"
                        то соединить "слово " с токен.«значение»
                        иначе
                          если токен.«вид» равен "string"
                            то соединить "строка " с токен.«значение»
                            иначе
                              если токен.«вид» равен "arrow"
                                то "стрелка"
                                иначе
                                  если токен.«вид» равен "punct"
                                    то соединить "знак " с токен.«значение»
                                    иначе
                                      если токен.«в ёлочках»
                                        то соединить "ёлочка " с токен.«значение»
                                        иначе соединить "имя " с токен.«значение»

тотальная функция «Разметка»
  принимает исходник: строка
  возвращает список строки
  обеспечивает «размеченных строк ровно столько, сколько токенов» (длина результат) равен (длина («Токены» от исходник))
  пример «Заголовок функции»
    дано исходник равно "функция «Длина»\n  возвращает число\n"
    ожидается ["слово function", "ёлочка Длина", "/", ">", "слово returns", "слово tNumber", "/", "<", "."]
  пример «Числа, строки и знаки»
    дано исходник равно "[1, -2.5, \"текст\"]\n"
    ожидается ["знак [", "число 1", "знак ,", "число -2.5", "знак ,", "строка текст", "знак ]", "/", "."]
  пример «Многословное ключевое слово»
    дано исходник равно "свёртка список начиная с 0 как акк и эл → акк\n"
    ожидается ["слово fold", "слово list", "слово startingWith", "число 0", "слово as", "имя акк", "слово and", "имя эл", "стрелка", "имя акк", "/", "."]
  пример «Комментарии и пустые строки токенов не дают»
    дано исходник равно "// шапка\n\nмодуль «М»\n\n/* хвост */\n"
    ожидается ["слово module", "ёлочка М", "/", "."]
  пример «Примечание токены даёт: слово, строка, перевод»
    дано исходник равно "примечание \"минус ноль ломает сравнение\"\n"
    ожидается ["слово note", "строка минус ноль ломает сравнение", "/", "."]
  пример «Комментарий пропадает, примечание на его месте остаётся»
    дано исходник равно "// это пропадёт\nпримечание \"а это останется\"\n"
    ожидается ["слово note", "строка а это останется", "/", "."]
  пример «Примечание на английской поверхности — то же понятие»
    дано исходник равно "note \"why, not what\"\n"
    ожидается ["слово note", "строка why, not what", "/", "."]
  пример «Пустой исходник — только конец»
    дано исходник равно ""
    ожидается ["."]
  пример «Блок текста: общий отступ снят, отступ внутри текста цел, в конце перевод строки»
    дано исходник равно "пусть справка равно \"\"\"\n    Команды:\n      .выход   закончить\n    \"\"\"\n"
    ожидается ["слово let", "имя справка", "слово cmpEq", "строка Команды:\n  .выход   закончить\n", "/", "."]
  пример «Тот же текст литералом с переводами строк — тот же поток»
    дано исходник равно "пусть справка равно \"Команды:\\n  .выход   закончить\\n\"\n"
    ожидается ["слово let", "имя справка", "слово cmpEq", "строка Команды:\n  .выход   закончить\n", "/", "."]
  пример «Закрывающие кавычки на последней строке текста — перевода строки в конце нет»
    дано исходник равно "пусть справка равно \"\"\"\n    первая\n    вторая\"\"\"\n"
    ожидается ["слово let", "имя справка", "слово cmpEq", "строка первая\nвторая", "/", "."]
  пример «Закрывающие кавычки левее текста оставляют тексту отступ»
    дано исходник равно "пусть справка равно \"\"\"\n      первая\n    \"\"\"\n"
    ожидается ["слово let", "имя справка", "слово cmpEq", "строка   первая\n", "/", "."]
  пример «Кавычки в блоке пишутся как есть, заслоны работают как в литерале»
    дано исходник равно "пусть справка равно \"\"\"\n    \"текст\" и 'текст'\\tс табуляцией\n    \"\"\"\n"
    ожидается ["слово let", "имя справка", "слово cmpEq", "строка \"текст\" и 'текст'\tс табуляцией\n", "/", "."]
  пример «Пустая строка посреди блока общий отступ не обнуляет»
    дано исходник равно "пусть справка равно \"\"\"\n    а\n\n    б\n    \"\"\"\n"
    ожидается ["слово let", "имя справка", "слово cmpEq", "строка а\n\nб\n", "/", "."]
  пример «Пустой блок — пустая строка, и разбор идёт дальше по строке с закрывающими кавычками»
    дано исходник равно "[\"\"\"\n\"\"\", 1]\n"
    ожидается ["знак [", "строка ", "знак ,", "число 1", "знак ]", "/", "."]
  отобразить («Токены» от исходник) как токен → «Показать токен» от токен

тотальная функция «Разметка одной строкой»
  принимает исходник: строка
  возвращает строка
  обеспечивает «одна строка — та же разметка, склеенная чертой» результат равен («Соединить строки» от («Разметка» от исходник) и " | ")
  пример «Поток одной строкой»
    дано исходник равно "модуль «М»\n"
    ожидается "слово module | ёлочка М | / | ."
  «Соединить строки» от («Разметка» от исходник) и " | "
