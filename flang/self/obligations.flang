    случай пусто
      то пустой список
    случай голова «г» и хвост «х»
      то «Слить имена вызовов» от («Имена вызовов тела» от «г») и («Имена вызовов в элементах» от «х»)

тотальная функция «Имена вызовов в полях»
  принимает «поля»: список «Поле значения»
  возвращает список строки
  разбор «поля»
    случай пусто
      то пустой список
    случай голова «г» и хвост «х»
      то «Слить имена вызовов» от («Имена вызовов тела» от («г».«значение»)) и («Имена вызовов в полях» от «х»)

тотальная функция «Слить имена вызовов»
  принимает «левые»: список строки, «правые»: список строки
  возвращает список строки
  свёртка «правые» начиная с «левые» как «акк» и «имя» → добавить «имя» к «акк»

тотальная функция «Все зовомые чисты»
  принимает «функция»: «Значение», «чистые»: список строки
  возвращает признак
  пусто (отфильтровать («Имена вызовов тела» от («Взять поле» от «функция» и "body")) где «имя» → не («чистые» содержит «имя»))

функция «Чистые имена»
  принимает «функции»: список «Значение», «кандидаты»: список строки
  возвращает список строки
  пусть «оставшиеся» равно (отфильтровать «функции» где «ф» → «кандидаты» содержит («Строка поля» от «ф» и "name"))
  пусть «новые» равно (отобразить (отфильтровать «оставшиеся» где «ф» → («Все зовомые чисты» от «ф» и «кандидаты»)) как «ф» → («Строка поля» от «ф» и "name"))
  если (длина «новые») равен (длина «кандидаты»)
    то «кандидаты»
    иначе «Чистые имена» от «функции» и «новые»

функция «Обязательства тотальности»
  принимает «программа»: «Значение»
  возвращает список «Значение»
  пусть «функции» равно («Элементы поля» от «программа» и "functions")
  пусть «в циклах» равно («Имена в циклах» от ((«Носители программы» от «программа»).«циклы»))
  пусть «композиции» равно (отобразить (отфильтровать «функции» где «ф» → («Функция-композиция» от «ф» и «в циклах»)) как «ф» → («Строка поля» от «ф» и "name"))
  пусть «чистые» равно («Чистые имена» от «функции» и «композиции»)
  отобразить (отфильтровать «функции» где «ф» → «чистые» содержит («Строка поля» от «ф» и "name")) как «ф» → («Обязательство тотальности» от «ф» и «функции»)

тотальная функция «Узел места строкой»
  принимает «строка»: число
  возвращает «Значение»
  «Запись как узел» от (добавить («Собрать поле ядра» от "line" и («Число как узел» от «строка»)) к пустой список)

тотальная функция «Узел витка структуры»
  принимает «виток»: «Виток структуры носителя»
  возвращает «Значение»
  «Запись как узел» от (добавить («Собрать поле ядра» от "variant" и («Строка как узел» от («виток».«вариант»))) к (добавить («Собрать поле ядра» от "field" и («Строка как узел» от («виток».«поле»))) к (добавить («Собрать поле ядра» от "part" и («Строка как узел» от («виток».«имя части»))) к (добавить («Собрать поле ядра» от "argtext" и («Строка как узел» от («виток».«аргтекст»))) к (добавить («Собрать поле ядра» от "line" и («Число как узел» от («виток».«строка»))) к пустой список)))))

тотальная функция «Узел витка шага»
  принимает «виток»: «Виток шага носителя»
  возвращает «Значение»
  «Запись как узел» от (добавить («Собрать поле ядра» от "argtext" и («Строка как узел» от («виток».«аргтекст»))) к (добавить («Собрать поле ядра» от "line" и («Число как узел» от («виток».«строка»))) к пустой список))

тотальная функция «Узел структуры»
  принимает «имя»: строка, «строка»: число, «аргумент»: число, «имя аргумента»: строка, «дно»: строка, «витки»: список «Виток структуры носителя», «самовызов»: число
  возвращает «Значение»
  «Запись как узел» от [
    («Собрать поле ядра» от "kind" и («Строка как узел» от "totality")),
    («Собрать поле ядра» от "mode" и («Строка как узел» от "structure")),
    («Собрать поле ядра» от "name" и («Строка как узел» от «имя»)),
    («Собрать поле ядра» от "span" и («Узел места строкой» от «строка»)),
    («Собрать поле ядра» от "arg" и («Число как узел» от «аргумент»)),
    («Собрать поле ядра» от "argname" и («Строка как узел» от «имя аргумента»)),
    («Собрать поле ядра» от "floor" и («Строка как узел» от «дно»)),
    («Собрать поле ядра» от "selfcall" и («Число как узел» от «самовызов»)),
    («Собрать поле ядра» от "loops" и («Список как узел» от (отобразить «витки» как «в» → («Узел витка структуры» от «в»))))]

тотальная функция «Узел шага»
  принимает «имя»: строка, «строка»: число, «аргумент»: число, «имя аргумента»: строка, «дно»: строка, «витки»: список «Виток шага носителя», «самовызов»: число
  возвращает «Значение»
  «Запись как узел» от [
    («Собрать поле ядра» от "kind" и («Строка как узел» от "totality")),
    («Собрать поле ядра» от "mode" и («Строка как узел» от "step")),
    («Собрать поле ядра» от "name" и («Строка как узел» от «имя»)),
    («Собрать поле ядра» от "span" и («Узел места строкой» от «строка»)),
    («Собрать поле ядра» от "arg" и («Число как узел» от «аргумент»)),
    («Собрать поле ядра» от "argname" и («Строка как узел» от «имя аргумента»)),
    («Собрать поле ядра» от "floor" и («Строка как узел» от «дно»)),
    («Собрать поле ядра» от "selfcall" и («Число как узел» от «самовызов»)),
    («Собрать поле ядра» от "loops" и («Список как узел» от (отобразить «витки» как «в» → («Узел витка шага» от «в»))))]

тотальная функция «Обязательство рекурсии»
  принимает «носитель»: «Носитель рекурсии»
  возвращает «Значение»
  разбор «носитель»
    случай вариант «Носитель структуры» с «имя» как «имя» и «строка» как «строка» и «аргумент» как «аргумент» и «имя аргумента» как «имя аргумента» и «дно» как «дно» и «витки» как «витки» и «самовызов» как «самовызов»
      то «Узел структуры» от «имя» и «строка» и «аргумент» и «имя аргумента» и «дно» и «витки» и «самовызов»
    случай вариант «Носитель шага» с «имя» как «имя» и «строка» как «строка» и «аргумент» как «аргумент» и «имя аргумента» как «имя аргумента» и «дно» как «дно» и «витки» как «витки» и «самовызов» как «самовызов»
      то «Узел шага» от «имя» и «строка» и «аргумент» и «имя аргумента» и «дно» и «витки» и «самовызов»

функция «Обязательства рекурсии»
  принимает «программа»: «Значение»
  возвращает список «Значение»
  отобразить («Рекурсии программы» от «программа») как «н» → («Обязательство рекурсии» от «н»)

функция «Обязательства»
  принимает «программа»: «Значение», «спуски»: список «Значение»
  возвращает «Значение»
  пусть «обязательства функций» равно («Обязательства функций» от («Элементы поля» от «программа» и "functions") и «спуски»)
  пусть «обязательства утверждений» равно («Обязательства утверждений» от «программа»)
  пусть «список» равно («Слить узлы» от «обязательства функций» и «обязательства утверждений»)
  пусть «ложные границы» равно («Беды границ» от («Элементы поля» от «программа» и "functions"))
  пусть «беды до теорем» равно («Слить узлы» от «ложные границы» и («Беды одного имени» от «обязательства функций» и «обязательства утверждений»))
  пусть «свод» равно («Свести теоремы» от («Элементы поля» от «программа» и "theorems") и (запись «Свод обязательств» с «обязательства» равным «список» и «диагностика» равным «беды до теорем»))
  пусть «поле version» равно («Собрать поле ядра» от "version" и («Число как узел» от («Версия обязательств»)))
  пусть «хвост тотальности» равно («Слить узлы» от («Обязательства тотальности» от «программа») и («Обязательства рекурсии» от «программа»))
  пусть «поле obligations» равно («Собрать поле ядра» от "obligations" и («Список как узел» от («Слить узлы» от («свод».«обязательства») и «хвост тотальности»)))
  пусть «поле diagnostics» равно («Собрать поле ядра» от "diagnostics" и («Список как узел» от («свод».«диагностика»)))
  «Запись как узел» от (добавить «поле diagnostics» к (добавить «поле obligations» к (добавить «поле version» к пустой список)))
