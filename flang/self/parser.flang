  ["Прочитать файл", "Записать файл", "Прочитать октеты из файла", "Записать октеты в файл", "Запросить", "Текущее время", "Случайное число", "Показать", "Ждать событие", "Перечислить каталог", "Запустить процесс", "Запустить процесс с вводом", "Открыть соединение", "Принять соединение", "Прочитать из соединения", "Ответить в соединение", "Прочитать октеты из соединения", "Ответить октетами в соединение", "Удалить файл", "Завести временный каталог", "Прочитать переменную среды", "Прочитать доводы"]

