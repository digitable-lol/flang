тотальная функция «Итоги значением»
  принимает «итоги»: «Итоги ведомости»
  возвращает «Значение»
  «Запись значением» от [
    («Поле» от "functions" и («Число значением» от («итоги».«функций»))),
    («Поле» от "total" и («Число значением» от («итоги».«тотальных»))),
    («Поле» от "ordinary" и («Число значением» от («итоги».«обычных»))),
    («Поле» от "carriers" и («Носители значением» от («итоги».«носители»))),
    («Поле» от "unaccounted" и («Число значением» от («итоги».«неназванных»))),
    («Поле» от "guardSites" и («Число значением» от («итоги».«мест сторожа»))),
