    («Поле» от "guardSites" и («Число значением» от («итоги».«мест сторожа»))),
    («Поле» от "laws" и («Итоги законов значением» от («итоги».«законы»))),
    («Поле» от "claims" и («Итоги утверждений значением» от («итоги».«утверждения»)))
  ]

// Ведомость машине. Та же ведомость и те же слова: `says` едет полем, а не
// собирается здесь во второй раз.
тотальная функция «Ведомость значением»
  принимает «ведомость»: «Ведомость»
  возвращает «Значение»
  обеспечивает «ведомость ложится записью» («Это запись» от результат) равен да
  «Запись значением» от [
    («Поле» от "ledger" и («Число значением» от («ведомость».«версия»))),
    («Поле» от "module" и («Текст или ничто» от («ведомость».«модуль»))),
    («Поле» от "functions" и («Список значением» от (отобразить («ведомость».«функции») как «строка» → «Функция значением» от «строка»))),
    («Поле» от "laws" и («Список значением» от (отобразить («ведомость».«законы») как «закон» → «Закон значением» от «закон»))),
    («Поле» от "assumed" и («Список значением» от (отобразить («ведомость».«вера») как «запись» → «Вера значением» от «запись»))),
    («Поле» от "totals" и («Итоги значением» от («ведомость».«итоги»))),
    («Утверждения полем» от («ведомость».«утверждения»)),
    («Разрешения полем» от («ведомость».«разрешения»)),
    («Обязательства полем» от («ведомость».«обязательства»)),
    («Спуски полем» от («ведомость».«спуски»))
  ]

// Раздел появляется только у программы, где утверждение высказано. Ведомость
// программы без постусловий и теорем обязана остаться той же, что была: на её
// форму уже сослались проверки дословно, и добавить всем пустой раздел значило бы
// переписать их за компанию.
тотальная функция «Утверждения полем»
  принимает «утверждения»: список «Строка утверждения»
  возвращает «Поле значения»
  обеспечивает «без утверждений поля не выходит» если пусто «утверждения» то (результат.«ключ») равен "" иначе (результат.«ключ») равен "claims"
  пример «Ни одного утверждения»
    дано «утверждения» равно пустой список
    ожидается запись «Поле значения» с «ключ» равным "" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»))
  если пусто «утверждения»
    то «Нет поля»
    иначе «Поле» от "claims" и («Список значением» от (отобразить «утверждения» как «запись» → «Утверждение значением» от «запись»))

// И это — по тому же правилу и последним ключом: ведомость программы, где ни
// одного свойства не объявлено, обязана остаться той же, что была.
тотальная функция «Разрешения полем»
  принимает «разрешения»: список «Строка разрешения»
  возвращает «Поле значения»
  обеспечивает «без разрешений поля не выходит» если пусто «разрешения» то (результат.«ключ») равен "" иначе (результат.«ключ») равен "permits"
  пример «Ни одного разрешения»
    дано «разрешения» равно пустой список
    ожидается запись «Поле значения» с «ключ» равным "" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»))
  если пусто «разрешения»
    то «Нет поля»
    иначе «Поле» от "permits" и («Список значением» от (отобразить «разрешения» как «запись» → «Разрешение значением» от «запись»))

// ОБЯЗАТЕЛЬСТВА ЦЕЛИКОМ, а не только вердикт о них.
//
// Раздел `claims` называет, что с утверждением стало: доказано, отвергнуто,
// принято объявлением. Чего в нём нет — САМОГО утверждения: цели выражением,
// связанных имён, посылок, места. Прочитать вердикт по нему можно, а спросить
// «а какие ещё цели у этой функции замкнулись бы» — нельзя, потому что цель в
// вердикт не едет.
//
// Считать обязательства второй раз, снаружи, нечем и не нужно: их считает слой
// `self/obligations.flang`, и он же кладёт в каждое поле `discharge`. Печатается
// здесь ровно то, что он посчитал, — узлами, как они у него и лежат. Второго
// перевода нет: перевод в запись `«Обязательство»` рядом (`«Все утверждения»`)
// теряет цель, посылки и место, и печатать по нему значило бы печатать огрызок.
//
// Ключ есть только у программы, где обязательство хоть одно. Пустой массив у
// каждой ведомости приучил бы к себе за неделю, а порядок здесь тот же, что у
// разделов `claims` и `permits`: раздела нет — значит нечего было считать.
тотальная функция «Обязательства полем»
  принимает «узлы»: список «Значение»
  возвращает «Поле значения»
  обеспечивает «без обязательств поля не выходит» если пусто «узлы» то (результат.«ключ») равен "" иначе (результат.«ключ») равен "obligations"
  пример «Ни одного обязательства»
    дано «узлы» равно пустой список
    ожидается запись «Поле значения» с «ключ» равным "" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»))
  если пусто «узлы»
    то «Нет поля»
    иначе «Поле» от "obligations" и («Список значением» от «узлы»)

// СПУСКИ ЗАВЕРШАЕМОСТИ: чья объявленная мера и чему она равна на витке.
//
// Ими закрывается обязательство объявленной меры, и другого источника у него
// нет. В ведомости они до сих пор были видны только следом — строкой функции с
// носителем `measure`; сама мера, узел выражения, оставалась внутри анализа.
//
// Форма та же, в какой спуски уезжают слою обязательств (`«Спуски узлами»` в
// точке входа): `{from, current}`. Одна форма, а не две, — иначе внешний
// читатель и слой обязательств читали бы про одно разными словами.
тотальная функция «Спуски полем»
  принимает «спуски»: список «Спуск»
  возвращает «Поле значения»
  обеспечивает «без спусков поля не выходит» если пусто «спуски» то (результат.«ключ») равен "" иначе (результат.«ключ») равен "descents"
  пример «Ни одного спуска»
    дано «спуски» равно пустой список
    ожидается запись «Поле значения» с «ключ» равным "" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр ничто»))
  если пусто «спуски»
    то «Нет поля»
    иначе «Поле» от "descents" и («Список значением» от (отобразить «спуски» как «с» → («Спуск значением» от «с»)))

тотальная функция «Спуск значением»
  принимает «спуск»: «Спуск»
  возвращает «Значение»
  обеспечивает «спуск ложится записью» («Это запись» от результат) равен да
  «Запись значением» от [
    («Поле» от "from" и («Текст значением» от («спуск».«откуда»))),
    («Поле» от "current" и («спуск».«мера»))
  ]

// Ведомость в JSON — тем же принтером, каким печатает AST ядро
// (`flang/core/json.flang`). Второго принтера здесь нет и не будет: порядок
// ключей и вид чисел — часть контракта обмена, и две печати разошлись бы.
тотальная функция «Ведомость в JSON»
  принимает «ведомость»: «Ведомость»
  возвращает строка
  обеспечивает «напечатанная ведомость непуста» 1 не больше (длина результат)
  «Печать значения» от («Ведомость значением» от «ведомость»)
