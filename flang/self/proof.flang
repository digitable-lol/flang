    («Сведено полем» от («запись».«по»)),
    («Типом полем» от («запись».«по») и («запись».«по типу»)),
    («Поле» от "grid" и («Число значением» от («запись».«сетка»))),
    («Искали полем» от («запись».«есть искали») и («запись».«искали»)),
