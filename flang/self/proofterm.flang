  пусть «связка» равно (если «Это строка» от («Взять поле» от «обязательство» и "bind") то («Строка поля» от «обязательство» и "bind") иначе "результат")
  пусть «по телу» равно («Подставить начальной» от «формула» и (добавить (запись «Замена терма» с «имя» равным «связка» и «узел» равным «тело» и «переименовать» равным нет) к пустой список))
  пусть «прежнее» равно («Заключение прежнего шага ведомости» от «заключения» и «шаг»)
  если не ((длина «посылки») равен 2) или («шаг» равен 0) или («строка» равен 0)
    то "Разв2 берёт посылку и строку тела — основание обязано быть «из N и строки M»"
    иначе
      если «Это ничто» от «тело»
        то "Разв2 — у этого места нет функции с телом: развёртывать нечего"
        иначе
          если не ((«Строка узла ведомости» от «тело») равен «строка»)
            то соединить ["Разв2 — тело функции стоит на строке ", (к строке («Строка узла ведомости» от «тело»)), ", а основание указывает на строку ", (к строке «строка»)] по ""
            иначе
              если «Есть вызов» от «тело»
                то "Разв2 берёт плоское тело, а тело этой функции зовёт другую"
                иначе
                  если «Это ничто» от «прежнее»
                    то соединить ["Разв2 — шага ", (к строке «шаг»), " раньше этого нет"] по ""
                    иначе
                      если «Одинаковы» от («Нормализовать» от «по телу») и («Нормализовать» от «прежнее»)
                        то ""
                        иначе соединить ["Разв2 — по телу функции заключение есть «", («Терм словами ведомости» от «по телу»), "», а шаг ", (к строке «шаг»), " заключает «", («Терм словами ведомости» от «прежнее»), "»"] по ""

функция «Шаг ведомости»
  принимает «шаг»: «Значение», «номер»: число, «формула»: «Значение», «заключения»: список «Значение», «функция»: «Значение», «обязательство»: «Значение»
  возвращает «Исход шага ведомости»
  пусть «по» равно («Взять поле» от «шаг» и "by")
  пусть «имя» равно («Строка поля» от «по» и "name")
  пусть «посылки» равно («Элементы поля» от «по» и "from")
  пусть «почему» равно (если «имя» равен "Н1" то («Ведомость Н1» от «формула» и «посылки») иначе (если «имя» равен "Н3" то («Ведомость Н3» от «формула» и «посылки» и «функция») иначе (если «имя» равен "Н5" то («Ведомость Н5» от «формула» и «посылки» и «заключения») иначе (если «имя» равен "О1" то («Ведомость О1» от «формула» и «посылки» и «функция») иначе (если «имя» равен "О10" то («Ведомость О10» от «формула» и «посылки» и «заключения») иначе (если «имя» равен "Разв2" то («Ведомость Разв2» от «формула» и «посылки» и «заключения» и «функция» и «обязательство») иначе (соединить ["правило «", «имя», "» ведомости ядро пока не проверяет; проверяет шесть: Н1, Н3, Н5, О1, О10, Разв2"] по "")))))))
  запись «Исход шага ведомости» с «принято» равным («почему» равен "") и «почему» равным (если «почему» равен "" то "" иначе (соединить ["шаг ", (к строке «номер»), " (", «имя», ", ", («Основание словами ведомости» от «посылки»), "): ", «почему»] по "")) и «место» равным («Взять поле» от «шаг» и "span")

тотальная функция «Отказ шага ведомости»
  принимает «шаг»: «Значение», «номер»: число, «почему»: строка
  возвращает «Исход шага ведомости»
  обеспечивает «отказ шага ведомости не принят» (результат.«принято») равен нет
  запись «Исход шага ведомости» с «принято» равным нет и «почему» равным (соединить ["шаг ", (к строке «номер»), ": ", «почему»] по "") и «место» равным («Взять поле» от «шаг» и "span")

функция «Шаги ведомости по порядку»
  принимает «шаги»: список «Значение», «номер»: число, «заключения»: список «Значение», «функция»: «Значение», «обязательство»: «Значение», «цель»: «Значение»
  возвращает «Исход шага ведомости»
  разбор «шаги»
    случай пусто
      то запись «Исход шага ведомости» с «принято» равным да и «почему» равным "" и «место» равным («Узел ничто»)
    случай голова «шаг» и хвост «остаток»
      то «Шаг ведомости за шагом» от «шаг» и «остаток» и «номер» и «заключения» и «функция» и «обязательство» и «цель»

функция «Шаг ведомости за шагом»
  принимает «шаг»: «Значение», «остаток»: список «Значение», «номер»: число, «заключения»: список «Значение», «функция»: «Значение», «обязательство»: «Значение», «цель»: «Значение»
  возвращает «Исход шага ведомости»
  пусть «выписано» равно («Взять поле» от «шаг» и "claim")
  пусть «формула» равно (если «Это ничто» от «выписано» то «цель» иначе «выписано»)
  пусть «исход» равно (если («Это ничто» от «выписано») и притом (не (пусто «остаток»)) то («Отказ шага ведомости» от «шаг» и «номер» и "шаг без формулы стоит не последним: формулу не выписывает только закрывающий шаг, а он один и последний") иначе (если (не («Это ничто» от «выписано»)) и притом (пусто «остаток») то («Отказ шага ведомости» от «шаг» и «номер» и "последний шаг выписывает формулу, и цель так не закрыта: закрывающий шаг пишется без формулы — «по закону «Имя» из …»") иначе («Шаг ведомости» от «шаг» и «номер» и «формула» и «заключения» и «функция» и «обязательство»)))
  если «исход».«принято»
    то «Шаги ведомости по порядку» от «остаток» и («номер» плюс 1) и (добавить «формула» к «заключения») и «функция» и «обязательство» и «цель»
    иначе «исход»

функция «Проверить вывод по ведомости»
  принимает «шаги»: список «Значение», «обстановка»: «Обстановка терма»
  возвращает «Итог цепочки»
  обеспечивает «число шагов вывода по ведомости неотрицательно» (результат.«шагов») не меньше 0
  пусть «программа» равно («обстановка».«программа»)
  пусть «обязательство» равно («обстановка».«обязательство»)
  пусть «чужие» равно (отфильтровать «шаги» где «ш» → не («Это шаг ведомости» от «ш» и «программа»))
  пусть «функция» равно (если «Это утверждение» от «обязательство» то («Узел ничто») иначе («Функция терма по имени» от «программа» и («Строка поля» от «обязательство» и "of")))
  пусть «исход» равно (если пусто «чужие» то («Шаги ведомости по порядку» от «шаги» и 1 и пустой список и «функция» и «обязательство» и («Взять поле» от «обязательство» и "goal")) иначе (запись «Исход шага ведомости» с «принято» равным нет и «почему» равным "в одной теореме стоят и шаги по правилам ведомости, и обоснования ядра (по свойству, по примеру, по предположению): пишите либо все шаги правилами ведомости, либо все — обоснованиями" и «место» равным («Взять поле» от (голова «чужие») и "span")))
  если «исход».«принято»
    то запись «Итог цепочки» с «сила» равным («Доказано») и «отказы» равным пустой список и «шагов» равным (длина «шаги») и «правило» равным "" и «случаи» равным пустой список и «индукция» равным («Узел ничто») и «источники» равным пустой список и «по допущениям» равным пустой список и «правила шагов» равным пустой список
    иначе запись «Итог цепочки» с «сила» равным («Отвергнуто») и «отказы» равным [(«Отказ терма» от («Код шага») и (соединить [(«обстановка».«место»), ": ", («исход».«почему»)] по "") и («исход».«место»))] и «шагов» равным (длина «шаги») и «правило» равным "" и «случаи» равным пустой список и «индукция» равным («Узел ничто») и «источники» равным пустой список и «по допущениям» равным пустой список и «правила шагов» равным пустой список

функция «Проверить цепочку обоснованиями»
  принимает «шаги»: список «Значение», «обстановка»: «Обстановка терма»
  возвращает «Итог цепочки»
  обеспечивает «число шагов цепочки обоснованиями неотрицательно» (результат.«шагов») не меньше 0
  пусть «известно» равно («Слить узлы» от («Элементы поля» от («обстановка».«обязательство») и "hypotheses") и («Факты предусловий» от («обстановка».«обязательство»)))
  пусть «начало» равно (запись «Ход цепочки» с «сила» равным («Доказано») и «правило» равным "" и «известно» равным «известно» и «отказы» равным пустой список и «номер» равным 0 и «закрыто» равным нет и «факты» равным пустой список и «по допущениям» равным пустой список и «правила шагов» равным пустой список)
  пусть «сначала» равно (отфильтровать «шаги» где «ш» → не («Это ничто» от («Взять поле» от «ш» и "claim")))
  пусть «потом» равно (отфильтровать «шаги» где «ш» → («Это ничто» от («Взять поле» от «ш» и "claim")))
  пусть «ход» равно («Пройти цепочку» от («Слить узлы» от «сначала» и «потом») и «начало» и «обстановка»)
  если пусто «шаги»
    то запись «Итог цепочки» с «сила» равным («Отвергнуто») и «отказы» равным (добавить («Отказ терма» от («Код шага») и (соединить [(«обстановка».«место»), ": ни одного шага"] по "") и («Узел ничто»)) к («ход».«отказы»)) и «шагов» равным 0 и «правило» равным («ход».«правило») и «случаи» равным пустой список и «индукция» равным («Узел ничто») и «источники» равным («Источники решения» от («ход».«известно»)) и «по допущениям» равным пустой список и «правила шагов» равным («Правила шагов» от «шаги» и («ход».«правила шагов»))
    иначе «Итог по закрытию» от «шаги» и «ход» и «обстановка»

функция «Итог по закрытию»
  принимает «шаги»: список «Значение», «ход»: «Ход цепочки», «обстановка»: «Обстановка терма»
  возвращает «Итог цепочки»
  обеспечивает «число шагов цепочки итог по закрытию неотрицательно» (результат.«шагов») не меньше 0
  если («ход».«закрыто») или не ((«ход».«сила») равен («Доказано»))
    то запись «Итог цепочки» с «сила» равным («ход».«сила») и «отказы» равным («ход».«отказы») и «шагов» равным (длина «шаги») и «правило» равным («ход».«правило») и «случаи» равным пустой список и «индукция» равным («Узел ничто») и «источники» равным («Источники решения» от («ход».«известно»)) и «по допущениям» равным («Шаги по допущениям» от «шаги» и («ход».«по допущениям»)) и «правила шагов» равным («Правила шагов» от «шаги» и («ход».«правила шагов»))
    иначе запись «Итог цепочки» с «сила» равным («Отвергнуто») и «отказы» равным (добавить («Отказ терма» от («Код шага») и (соединить [(«обстановка».«место»), ": ни один шаг не закрыл заключение этого места. Промежуточные факты доказаны, но цель ими только обставлена, а не выведена; последним шагом обязано стоять обоснование БЕЗ выписанного утверждения — оно и закрывает то, что построило ядро"] по "") и («Узел ничто»)) к («ход».«отказы»)) и «шагов» равным (длина «шаги») и «правило» равным («ход».«правило») и «случаи» равным пустой список и «индукция» равным («Узел ничто») и «источники» равным («Источники решения» от («ход».«известно»)) и «по допущениям» равным («Шаги по допущениям» от «шаги» и («ход».«по допущениям»)) и «правила шагов» равным («Правила шагов» от «шаги» и («ход».«правила шагов»))

тотальная функция «Свернуть принцип»
  принимает «покрытие»: признак, «база»: список строки, «шаг»: список строки
  возвращает строка
  обеспечивает «без покрытия принцип отвергнут» если не «покрытие» то (результат равен («Отвергнуто»)) иначе да
  пример «без покрытия принцип отвергнут, что бы ни стояло в посылках»
    дано «покрытие» равно нет
    дано «база» равно ["доказано"]
    дано «шаг» равно ["доказано"]
    ожидается "отвергнуто"
  если «покрытие»
    то («Свернуть посылки» от («Слить строки посылок» от «база» и «шаг»))
    иначе («Отвергнуто»)

тотальная функция «Слить строки посылок»
  принимает «база»: список строки, «шаг»: список строки
  возвращает список строки
  обеспечивает «слитых строк ровно столько, сколько было в обеих» (длина результат) равен ((длина «база») плюс (длина «шаг»))
  пример «слияние базы и шага сохраняет обе строки»
    дано «база» равно ["база"]
    дано «шаг» равно ["шаг"]
    ожидается ["база", "шаг"]
  свёртка «шаг» начиная с «база» как «акк» и «э» → добавить «э» к «акк»

тотальная функция «Свернуть посылки»
  принимает «силы»: список строки
  возвращает строка
  обеспечивает «без посылок свёртка отвергнута» если пусто «силы» то (результат равен («Отвергнуто»)) иначе да
  пример «без посылок свёртка отвергает»
    дано «силы» равно пустой список
    ожидается "отвергнуто"
  если пусто «силы»
    то («Отвергнуто»)
    иначе свёртка «силы» начиная с («Доказано») как «акк» и «с» → («Ослабить» от «акк» и «с»)

тотальная функция «Имя именованного типа»
  принимает «тип»: «Значение»
  возвращает строка
  обеспечивает «у неименованного типа имени нет» если не ((«Строка поля» от «тип» и "kind") равен "named") то (результат равен "") иначе да
  если («Строка поля» от «тип» и "kind") равен "named"
    то «Строка поля» от «тип» и "name"
    иначе ""

тотальная функция «Узел типа переменной индукции»
  принимает «обязательство»: «Значение», «параметр»: строка
  возвращает «Значение»
  пусть «свои» равно (отфильтровать («Элементы поля» от «обязательство» и "vars") где «п» → («Строка поля» от «п» и "name") равен «параметр»)
  если пусто «свои»
    то «Узел ничто»
    иначе «Взять поле» от (голова «свои») и "type"

тотальная функция «Имя образца случая»
  принимает «случай»: «Значение»
  возвращает строка
  обеспечивает «у образца не по варианту имени нет» если не ((«Строка поля» от («Взять поле» от «случай» и "pattern") и "kind") равен "variant") то (результат равен "") иначе да
  если («Строка поля» от («Взять поле» от «случай» и "pattern") и "kind") равен "variant"
    то «Строка поля» от («Взять поле» от «случай» и "pattern") и "name"
    иначе ""

тотальная функция «Есть строка»
  принимает «строки»: список строки, «имя»: строка
  возвращает признак
  если пусто (отфильтровать «строки» где «с» → «с» равен «имя»)
    то нет
    иначе да

тотальная функция «Лишним словами»
  принимает «имя»: строка
  возвращает строка
  обеспечивает «слова о лишнем непусты» 1 не больше (длина результат)
  пример «у безымянного образца названа его беда, а не пустые ёлочки»
    дано «имя» равно ""
    ожидается "образец не по варианту"
  если «имя» равен ""
    то "образец не по варианту"
    иначе «В ёлочках обязательств» от «имя»

тотальная функция «Метка случая»
  принимает «случай»: «Значение»
  возвращает строка
  обеспечивает «метка случая непуста» 1 не больше (длина результат)
  пусть «образец» равно («Взять поле» от «случай» и "pattern")
  пусть «вид» равно («Строка поля» от «образец» и "kind")
  если «вид» равен "variant"
    то «В ёлочках обязательств» от («Строка поля» от «образец» и "name")
    иначе
      если «вид» равен "literal"
        то соединить ["литерал ", («Литерал случая словами» от («Взять поле» от «образец» и "value"))] по ""
        иначе
          если «вид» равен "any"
            то (если «Это строка» от («Взять поле» от «образец» и "bind") то (соединить ["«любое ", («Строка поля» от «образец» и "bind"), "»"] по "") иначе "«любое»")
            иначе "образец не по варианту"

тотальная функция «Литерал случая словами»
  принимает «значение»: «Значение»
  возвращает строка
  если «Это строка» от «значение»
    то соединить ["\"", («Строка узла» от «значение»), "\""] по ""
    иначе («Строка узла» от «значение»)

тотальная функция «Части непокрытия»
  принимает «непокрытые»: список «Непокрытая», «лишние»: список «Значение»
  возвращает список строки
  обеспечивает «частей непокрытия не больше двух» (длина результат) не больше 2
