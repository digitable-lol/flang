        «Source line» с «text» равным "класс «Точка»" и
        «line» равным 1 и «shift» равным 0 и «raw» равным нет) и «lines» равным [(запись «Source line» с «text» равным
        "объект «Точка»" и «line» равным 1 и «shift» равным 0 и «raw» равным нет), (запись «Source line» с «text» равным
        "  х: число" и «line» равным 2 и «shift» равным 0 и «raw» равным нет)])
  пусть objectLines равно (приписать («Made line» от model.«head» и (соединить "объект " с model.«name»))
