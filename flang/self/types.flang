  «Вывод» от («Тип списка длиной» от («Элемент типа» от («итог».«тип»)) и («было» минус 1)) и («Отметить место» от («итог».«беды») и "хвост" и («было» не меньше 1) и «узел»)

функция «Форма элемент»
  принимает «узел»: «Значение», «аргументы»: список «Значение», «имена»: «Имена», «таблицы»: «Таблицы», «беды»: список «Беда»
  возвращает «Итог вывода»
  обеспечивает «беды не убывают — Форма элемент» (длина «беды») не больше (длина (результат.«беды»))
  пусть «об арности» равно («Сказать об арности» от "элемент" и 2 и (длина «аргументы») и «узел» и «беды»)
  если (длина «аргументы») не равен 2
    то «Вывод» от «Тип неизвестного» и «об арности»
    иначе «Элемент по границам» от «узел» и («Хотеть аргумент» от «аргументы» и 0 и «Тип числа» и "элемент" и «узел» и «имена» и «таблицы» и «об арности») и («Список целиком» от «аргументы» и 1 и "элемент" и «узел» и «имена» и «таблицы» и («Хотеть аргумент» от «аргументы» и 0 и «Тип числа» и "элемент" и «узел» и «имена» и «таблицы» и «об арности»).«беды») и («Имя узла» от («Аргумент по номеру» от «аргументы» и 1)) и («таблицы».«база номера»)

тотальная функция «Элемент по границам»
  принимает «узел»: «Значение», «о номере»: «Итог вывода», «о списке»: «Итог вывода», «имя списка»: строка, «база»: число
  возвращает «Итог вывода»
  «Вывод» от («Элемент целого списка» от «о списке»).«тип» и («Отметить место» от («о списке».«беды») и "элемент" и («В границах» от («о номере».«тип») и («о списке».«тип») и «имя списка» и «база») и «узел»)

функция «Форма пусто»
  принимает «узел»: «Значение», «аргументы»: список «Значение», «имена»: «Имена», «таблицы»: «Таблицы», «беды»: список «Беда»
  возвращает «Итог вывода»
  обеспечивает «беды не убывают — Форма пусто» (длина «беды») не больше (длина (результат.«беды»))
  пусть «об арности» равно («Сказать об арности» от "пусто" и 1 и (длина «аргументы») и «узел» и «беды»)
  если (длина «аргументы») не равен 1
    то «Вывод» от «Тип признака» и «об арности»
    иначе «Строка или список» от «узел» и «аргументы» и "пусто" и «Тип признака» и нет и «имена» и «таблицы» и «об арности»

функция «Форма добавить»
  принимает «форма»: строка, «узел»: «Значение», «аргументы»: список «Значение», «имена»: «Имена», «таблицы»: «Таблицы», «беды»: список «Беда»
  возвращает «Итог вывода»
  обеспечивает «беды не убывают — Форма добавить» (длина «беды») не больше (длина (результат.«беды»))
  пусть «об арности» равно («Сказать об арности» от «форма» и 2 и (длина «аргументы») и «узел» и «беды»)
  если (длина «аргументы») не равен 2
    то «Вывод» от «Тип неизвестного» и «об арности»
    иначе «Два аргумента добавления» от «форма» и «узел» и «аргументы» и «имена» и «таблицы» и «об арности»

функция «Два аргумента добавления»
  принимает «форма»: строка, «узел»: «Значение», «аргументы»: список «Значение», «имена»: «Имена», «таблицы»: «Таблицы», «беды»: список «Беда»
  возвращает «Итог вывода»
  обеспечивает «беды не убывают — Два аргумента добавления» (длина «беды») не больше (длина (результат.«беды»))
  пусть «элемент» равно («Просто вывести» от «аргументы» и 0 и «имена» и «таблицы» и «беды»)
  пусть «список» равно («Тип выражения» от («Аргумент по номеру» от «аргументы» и 1) и «имена» и (вариант «Тип задан» с «тип» равным («Тип списка» от («элемент».«тип»))) и «таблицы» и («элемент».«беды»))
  пусть «метка» равно («Метка типа» от («список».«тип»))
  если «метка» равен "unknown"
    то «Вывод» от («Тип списка» от («элемент».«тип»)) и («список».«беды»)
    иначе
      если «метка» не равен "list"
        то «Вывод» от («Тип списка» от («элемент».«тип»)) и («Сказать» от («список».«беды») и "FLANG_BUILTIN_ARGS" и (соединить ["«", «форма», "» добавляет в список, а второй аргумент — ", («Название типа» от («список».«тип»))] по "") и («Место аргумента» от «аргументы» и 1 и «узел»))
        иначе «Вывод» от («С длиной» от («список».«тип») и ((«Нижняя длина» от («список».«тип»)) плюс 1)) и (если («Годится» от («элемент».«тип») и («Элемент типа» от («список».«тип»))) то («список».«беды») иначе («Сказать» от («список».«беды») и "FLANG_BUILTIN_ARGS" и (соединить ["«", «форма», "»: элемент имеет тип ", («Название типа» от («элемент».«тип»)), ", а список — ", («Название типа» от («список».«тип»))] по "") и «узел»))

функция «Проверить значение»
  принимает «значение»: «Значение», «задано»: признак, «тип»: «Тип», «метка»: строка, «таблицы»: «Таблицы», «место»: «Значение», «беды»: список «Беда»
  возвращает список «Беда»
  обеспечивает «список бед не укорачивается — Проверить значение» (длина «беды») не больше (длина результат)
  если «Тип неизвестен» от «тип»
    то «беды»
    иначе (если (если («тип».«необязательный») то (если «задано» то («Это ничто» от «значение») иначе да) иначе нет) то «беды» иначе («Проверить по виду» от «значение» и «задано» и «тип» и «метка» и «таблицы» и «место» и «беды»))

тотальная функция «Не соответствует»
  принимает «метка»: строка, «тип»: «Тип», «место»: «Значение», «беды»: список «Беда»
  возвращает список «Беда»
  обеспечивает «список бед не укорачивается — Не соответствует» (длина «беды») не больше (длина результат)
  пример «Жалоба на несоответствие называет тип»
    дано «метка» равно "литерал"
    дано «тип» равно (запись «Тип» с «вид» равным (вариант «Вид числа») и «необязательный» равным нет)
    дано «место» равно (вариант «Значение записи» с «поля» равным пустой список)
    дано «беды» равно пустой список
    ожидается [(запись «Беда» с «код» равным "FLANG_TYPE" и «сообщение» равным "литерал не соответствует типу число" и «место» равным (запись «Место» с «есть» равным нет и «строка» равным 0 и «столбец» равным 0))]
  «Сказать» от «беды» и "FLANG_TYPE" и (соединить [«метка», " не соответствует типу ", («Название типа» от «тип»)] по "") и «место»

тотальная функция «Это конечное число»
  принимает «значение»: «Значение», «задано»: признак
  возвращает признак
  обеспечивает «незаданное конечным числом не бывает» если (не «задано») то результат равен нет иначе да
  пример «Незаданное конечным числом не бывает»
    дано «значение» равно (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр число» с «значение» равным 1))
    дано «задано» равно нет
    ожидается нет
  пример «Заданное число конечным числом бывает»
    дано «значение» равно (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр число» с «значение» равным 1))
    дано «задано» равно да
    ожидается да
  если «задано»
    то «Это конечное в узле» от «значение»
    иначе нет

тотальная функция «Это конечное в узле»
  принимает «значение»: «Значение»
  возвращает признак
  разбор «значение»
    случай вариант «Значение скаляра» с «скаляр» как «скаляр»
      то «Это конечное в скаляре» от «скаляр»
    случай любое
      то нет

тотальная функция «Это конечное в скаляре»
  принимает «скаляр»: «Скаляр»
  возвращает признак
  разбор «скаляр»
    случай вариант «Скаляр число» с «значение» как «значение»
      то (если «Не конечное» от «значение» то нет иначе да)
    случай любое
      то нет

тотальная функция «Проверить отрезок значения»
  принимает «значение»: «Значение», «тип»: «Тип», «метка»: строка, «место»: «Значение», «беды»: список «Беда»
  возвращает список «Беда»
  обеспечивает «список бед не укорачивается — Проверить отрезок значения» (длина «беды») не больше (длина результат)
  если «Это отрезок» от «тип»
    то «Проверить число в отрезке» от («Число скаляра значения» от «значение») и «тип» и «метка» и «место» и «беды»
    иначе «беды»

тотальная функция «Число скаляра значения»
  принимает «значение»: «Значение»
  возвращает число
  «Число узла» от «значение»

тотальная функция «Проверить число в отрезке»
  принимает «число»: число, «тип»: «Тип», «метка»: строка, «место»: «Значение», «беды»: список «Беда»
  возвращает список «Беда»
  обеспечивает «список бед не укорачивается — Проверить число в отрезке» (длина «беды») не больше (длина результат)
  пример «Число ровно на нижнем крае отрезка жалобы не даёт»
    дано «число» равно 0
    дано «тип» равно (запись «Тип» с «вид» равным (вариант «Вид отрезка» с «низ» равным 0 и «верх» равным 10 и «подДлиной» равным пустой список и «неДлиннее» равным пустой список и «масштаб» равным 0 и «неБольше» равным пустой список и «неМинусНоль» равным нет) и «необязательный» равным нет)
    дано «метка» равно "аргумент"
    дано «место» равно (вариант «Значение записи» с «поля» равным пустой список)
    дано «беды» равно пустой список
    ожидается пустой список
  пример «Первое число за верхним краем уже вне отрезка»
    дано «число» равно 11
    дано «тип» равно (запись «Тип» с «вид» равным (вариант «Вид отрезка» с «низ» равным 0 и «верх» равным 10 и «подДлиной» равным пустой список и «неДлиннее» равным пустой список и «масштаб» равным 0 и «неБольше» равным пустой список и «неМинусНоль» равным нет) и «необязательный» равным нет)
    дано «метка» равно "аргумент"
    дано «место» равно (вариант «Значение записи» с «поля» равным пустой список)
    дано «беды» равно пустой список
    ожидается [(запись «Беда» с «код» равным "FLANG_TYPE" и «сообщение» равным "аргумент: 11 вне неотрицательное" и «место» равным (запись «Место» с «есть» равным нет и «строка» равным 0 и «столбец» равным 0))]
  если («Целое ли число» от «число») равен нет
    то «Сказать» от «беды» и "FLANG_TYPE" и (соединить [«метка», ": ", (к строке «число»), " не целое, а тип ", («Название типа» от «тип»), " — целый"] по "") и «место»
    иначе
      если «число» меньше («Низ отрезка» от «тип»)
        то «Сказать» от «беды» и "FLANG_TYPE" и (соединить [«метка», ": ", (к строке «число»), " вне ", («Название типа» от «тип»)] по "") и «место»
        иначе (если «число» больше («Верх отрезка» от «тип») то («Сказать» от «беды» и "FLANG_TYPE" и (соединить [«метка», ": ", (к строке «число»), " вне ", («Название типа» от «тип»)] по "") и «место») иначе «беды»)

тотальная функция «Это признак в узле»
  принимает «значение»: «Значение», «задано»: признак
  возвращает признак
  обеспечивает «незаданное признаком не бывает» если (не «задано») то результат равен нет иначе да
  пример «Незаданное признаком не бывает»
    дано «значение» равно (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр признак» с «значение» равным да))
    дано «задано» равно нет
    ожидается нет
  если «задано»
    то «Это признак в значении» от «значение»
    иначе нет

тотальная функция «Это признак в значении»
  принимает «значение»: «Значение»
  возвращает признак
  разбор «значение»
    случай вариант «Значение скаляра» с «скаляр» как «скаляр»
      то «Это признак в скаляре» от «скаляр»
    случай любое
      то нет

тотальная функция «Это признак в скаляре»
  принимает «скаляр»: «Скаляр»
  возвращает признак
  разбор «скаляр»
    случай вариант «Скаляр признак» с «значение» как «значение»
      то да
    случай любое
      то нет

функция «Проверить по виду»
  принимает «значение»: «Значение», «задано»: признак, «тип»: «Тип», «метка»: строка, «таблицы»: «Таблицы», «место»: «Значение», «беды»: список «Беда»
  возвращает список «Беда»
  обеспечивает «список бед не укорачивается — Проверить по виду» (длина «беды») не больше (длина результат)
  пусть «метка вида» равно («Метка типа» от «тип»)
  если «метка вида» равен "number"
    то (если («Это конечное число» от «значение» и «задано») то («Проверить отрезок значения» от «значение» и «тип» и «метка» и «место» и «беды») иначе («Не соответствует» от «метка» и «тип» и «место» и «беды»))
    иначе
      если «метка вида» равен "string"
        то (если (если «задано» то («Это строка» от «значение») иначе нет) то «беды» иначе («Не соответствует» от «метка» и «тип» и «место» и «беды»))
        иначе
          если «метка вида» равен "boolean"
            то (если («Это признак в узле» от «значение» и «задано») то «беды» иначе («Не соответствует» от «метка» и «тип» и «место» и «беды»))
            иначе
              если «метка вида» равен "null"
                то (если (если «задано» то («Это ничто» от «значение») иначе нет) то «беды» иначе («Не соответствует» от «метка» и «тип» и «место» и «беды»))
                иначе
                  пусть «это список» равно (если «задано» то («Это список» от «значение») иначе нет)
                  пусть «не то» равно («Не соответствует» от «метка» и «тип» и «место» и «беды»)
                  если («метка вида» равен "exact") или («метка вида» равен "fraction")
                    то (если «это список» то («Канон счётного» от «тип» и «значение» и «место» и «беды») иначе «не то»)
                    иначе «Проверить составное значение» от «значение» и «задано» и «тип» и «метка вида» и «метка» и «таблицы» и «место» и «беды»

тотальная функция «Канон счётного»
  принимает «тип»: «Тип», «узел»: «Значение», «место»: «Значение», «беды»: список «Беда»
  возвращает список «Беда»
  обеспечивает «список бед не укорачивается — Канон счётного» (длина «беды») не больше (длина результат)
  если «Это точное дробное» от «тип»
    то «Сказать о каноне дробного» от («Элементы узла» от «узел») и «место» и «беды»
    иначе «Сказать о каноне точного» от («Элементы узла» от «узел») и «место» и «беды»

функция «Проверить составное значение»
  принимает «значение»: «Значение», «задано»: признак, «тип»: «Тип», «метка вида»: строка, «метка»: строка, «таблицы»: «Таблицы», «место»: «Значение», «беды»: список «Беда»
  возвращает список «Беда»
  обеспечивает «список бед не укорачивается — Проверить составное значение» (длина «беды») не больше (длина результат)
  если «метка вида» равен "list"
    то (если (если «задано» то («Это список» от «значение») иначе нет) то («Проверить элементы значения» от («Элементы узла» от «значение») и 0 и («Элемент типа» от «тип») и «метка» и «таблицы» и «место» и «беды») иначе («Не соответствует» от «метка» и «тип» и «место» и «беды»))
    иначе
      если «метка вида» равен "record"
        то «Проверить значение записи» от «значение» и «задано» и «тип» и «метка» и «таблицы» и «место» и «беды»
        иначе
          если «метка вида» равен "sum"
            то «Проверить значение суммы» от «значение» и «задано» и «тип» и «метка» и «таблицы» и «место» и «беды»
