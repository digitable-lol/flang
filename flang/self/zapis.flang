                        иначе
                          если «отношение» равен " не больше "
                            то («Признак вычислителя записи» от ((«лево».«число») не больше («право».«число»)))
                            иначе
                              если «отношение» равен " меньше "
                                то («Признак вычислителя записи» от ((«лево».«число») меньше («право».«число»)))
                                иначе
                                  если «отношение» равен " больше "
                                    то («Признак вычислителя записи» от ((«лево».«число») больше («право».«число»)))
                                    иначе
                                      если «отношение» равен " плюс "
                                        то («Число вычислителя записи» от ((«лево».«число») плюс («право».«число»)))
                                        иначе («Число вычислителя записи» от ((«лево».«число») минус («право».«число»)))

тотальная функция «Значение терма записи»
  принимает «сырой»: строка, «горючее»: нат
  возвращает «Значение записи вычислителя»
  пример «Замкнутое сравнение считается до признака»
    дано «сырой» равно "( 0 минус 1 ) не больше 1"
    дано «горючее» равно 8
    ожидается запись «Значение записи вычислителя» с «есть» равным да и «вид» равным "признак" и «число» равным 1 и «текст» равным "да"
  пример «Длина выписанного списка — число его членов»
    дано «сырой» равно "длина ( [а, б] )"
    дано «горючее» равно 8
    ожидается запись «Значение записи вычислителя» с «есть» равным да и «вид» равным "число" и «число» равным 2 и «текст» равным "2"
  пример «Начало строкового литерала»
    дано «сырой» равно "\"привет\" начинается с \"при\""
    дано «горючее» равно 8
    ожидается запись «Значение записи вычислителя» с «есть» равным да и «вид» равным "признак" и «число» равным 1 и «текст» равным "да"
  пример «Свободное имя не считается»
    дано «сырой» равно "н больше 0"
    дано «горючее» равно 8
    ожидается запись «Значение записи вычислителя» с «есть» равным нет и «вид» равным "" и «число» равным 0 и «текст» равным ""
  пусть «текст» равно («Ужать записи» от «сырой»)
  пусть «отношение» равно («Первое отношение записи» от «текст»)
  пусть «члены» равно («Члены списка записи» от «текст»)
  пусть «под длиной» равно (если «текст» начинается с "длина " то («Ужать записи» от («Слова после записи» от «текст» и 1)) иначе "")
  пусть «члены под длиной» равно («Члены списка записи» от «под длиной»)
  если «горючее» не больше 0
    то («Не берусь записи»)
    иначе
      если (длина «текст») равен 0
        то («Не берусь записи»)
        иначе
          если («отношение».«место») больше 0
            то («Сравнить значения записи» от («отношение».«отношение») и («Значение терма записи» от («Кусок записи» от «текст» и 1 и ((«отношение».«место») минус 1)) и («горючее» минус 1)) и («Значение терма записи» от («Кусок записи» от «текст» и ((«отношение».«место») плюс (длина («отношение».«отношение»))) и (длина «текст»)) и («горючее» минус 1)))
            иначе
              если «текст» равен "да"
                то («Признак вычислителя записи» от да)
                иначе
                  если «текст» равен "нет"
                    то («Признак вычислителя записи» от нет)
                    иначе
                      если «Это строковый литерал записи» от «текст»
                        то запись «Значение записи вычислителя» с «есть» равным да и «вид» равным "строка" и «число» равным 0 и «текст» равным («Без краёв записи» от «текст»)
                        иначе
                          если «Это число записи» от «текст»
                            то («Число вычислителя записи» от (к числу «текст»))
                            иначе
                              если не (пусто «члены»)
                                то запись «Значение записи вычислителя» с «есть» равным да и «вид» равным "список" и «число» равным (длина «члены») и «текст» равным «текст»
                                иначе
                                  если не (пусто «члены под длиной»)
                                    то («Число вычислителя записи» от (длина «члены под длиной»))
                                    иначе
                                      если («текст» начинается с "длина ") и притом («Это строковый литерал записи» от «под длиной»)
                                        то («Число вычислителя записи» от (длина («Без краёв записи» от «под длиной»)))
                                        иначе («Не берусь записи»)

объект «План разбора записи»
  «удалось»: признак
  «ходы»: список строки

тотальная функция «Нет плана записи»
  возвращает «План разбора записи»
  обеспечивает «пустой план не удался» не (результат.«удалось»)
  запись «План разбора записи» с «удалось» равным нет и «ходы» равным пустой список

тотальная функция «План одним ходом записи»
  принимает «ход»: строка
  возвращает «План разбора записи»
  обеспечивает «план из одного хода» (длина (результат.«ходы»)) равен 1
  запись «План разбора записи» с «удалось» равным да и «ходы» равным [«ход»]

тотальная функция «Ход перед планом записи»
  принимает «ход»: строка, «план»: «План разбора записи»
  возвращает «План разбора записи»
  обеспечивает «неудавшийся план остаётся неудавшимся» если («план».«удалось») то да иначе (не (результат.«удалось»))
  пример «Ход встаёт перед ходами удавшегося плана»
    дано «ход» равно "деление ⟨н больше 0⟩"
    дано «план» равно запись «План разбора записи» с «удалось» равным да и «ходы» равным ["закрыть истиной"]
    ожидается запись «План разбора записи» с «удалось» равным да и «ходы» равным ["деление ⟨н больше 0⟩", "закрыть истиной"]
  если («план».«удалось»)
    то запись «План разбора записи» с «удалось» равным да и «ходы» равным (приписать «ход» к («план».«ходы»))
    иначе («Нет плана записи»)

тотальная функция «Склеить планы записи»
  принимает «ход»: строка, «первый»: «План разбора записи», «второй»: «План разбора записи»
  возвращает «План разбора записи»
  обеспечивает «оба плана обязаны удаться» если (результат.«удалось») то (((«первый».«удалось») и притом («второй».«удалось»))) иначе да
  если («первый».«удалось») и притом («второй».«удалось»)
    то запись «План разбора записи» с «удалось» равным да и «ходы» равным (приписать «ход» к («Соединить списки записи» от («первый».«ходы») и («второй».«ходы»)))
    иначе («Нет плана записи»)

тотальная функция «Закон меры подходит записи»
  принимает «цель»: строка
  возвращает признак
  пример «Мера простого терма не меньше нуля»
    дано «цель» равно "( длина элементы ) не меньше 0"
    ожидается да
  пример «Справа не ноль»
    дано «цель» равно "( длина элементы ) не меньше 1"
    ожидается нет
  пусть «разрез» равно («Разрез по записи» от «цель» и "не меньше")
  пусть «лево» равно («Ужать записи» от («разрез».«лево»))
  («разрез».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от «цель») и "не меньше")) равен 2) и притом ((«Ужать записи» от («разрез».«право»)) равен "0") и притом («лево» начинается с "длина ") и притом («Простой терм записи» от («Слова после записи» от «лево» и 1))

тотальная функция «Закон квадрата подходит записи»
  принимает «цель»: строка
  возвращает признак
  пример «Квадрат того же терма под оговоркой о конечности»
    дано «цель» равно "не ( ( е минус е ) равен 0 ) или ( ( е умножить на е ) не меньше 0 )"
    ожидается да
  пример «Сомножители разные»
    дано «цель» равно "не ( ( е минус е ) равен 0 ) или ( ( е умножить на д ) не меньше 0 )"
    ожидается нет
  пусть «или» равно («Разрез по записи» от «цель» и "или")
  пусть «лево» равно («Ужать записи» от («или».«лево»))
  пусть «под не» равно («Ужать записи» от («Слова после записи» от «лево» и 1))
  пусть «равенство» равно («Разрез по записи» от «под не» и "равен")
  пусть «разность» равно («Разрез по записи» от («равенство».«лево») и "минус")
  пусть «терм» равно («Ужать записи» от («разность».«лево»))
  пусть «не меньше» равно («Разрез по записи» от («или».«право») и "не меньше")
  пусть «произведение» равно («Разрез по записи» от («не меньше».«лево») и "умножить на")
  («или».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от «цель») и "или")) равен 2) и притом («лево» начинается с "не ") и притом («равенство».«есть») и притом ((длина («Разделить сверху записи» от «под не» и "равен")) равен 2) и притом ((«Ужать записи» от («равенство».«право»)) равен "0") и притом («разность».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от («равенство».«лево»)) и "минус")) равен 2) и притом («терм» равен («Ужать записи» от («разность».«право»))) и притом («не меньше».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от («или».«право»)) и "не меньше")) равен 2) и притом ((«Ужать записи» от («не меньше».«право»)) равен "0") и притом («произведение».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от («не меньше».«лево»)) и "умножить на")) равен 2) и притом ((«Ужать записи» от («произведение».«лево»)) равен «терм») и притом ((«Ужать записи» от («произведение».«право»)) равен «терм»)

тотальная функция «Остаток начала склейки записи»
  принимает «цель»: строка
  возвращает «Разрез записи»
  пример «Склейка начинается левым куском — остатка нет»
    дано «цель» равно "( соединить начало с конец ) начинается с начало"
    ожидается запись «Разрез записи» с «есть» равным да и «лево» равным "" и «право» равным ""
  пример «Литералы разные — остаётся проверка начала»
    дано «цель» равно "( соединить \"аб\" с хвост ) начинается с \"а\""
    ожидается запись «Разрез записи» с «есть» равным да и «лево» равным "\"аб\" начинается с \"а\"" и «право» равным ""
  пример «Слева не склейка — закон не подходит»
    дано «цель» равно "текст начинается с \"\""
    ожидается запись «Разрез записи» с «есть» равным нет и «лево» равным "" и «право» равным ""
  пусть «разрез» равно («Разрез по записи» от «цель» и "начинается с")
  пусть «лево» равно («Ужать записи» от («разрез».«лево»))
  пусть «приставка» равно («Ужать записи» от («разрез».«право»))
  пусть «куски» равно («Разрез по записи» от («Слова после записи» от «лево» и 1) и "с")
  пусть «левый кусок» равно («Ужать записи» от («куски».«лево»))
  если («разрез».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от «цель») и "начинается с")) равен 2) и притом («лево» начинается с "соединить ") и притом («куски».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от («Слова после записи» от «лево» и 1)) и "с")) равен 2)
    то запись «Разрез записи» с «есть» равным да и «лево» равным (если «левый кусок» равен «приставка» то "" иначе («Слить строки записи» от [(«В скобки записи» от «левый кусок»), " начинается с ", («В скобки записи» от «приставка»)])) и «право» равным ""
    иначе («Нет разреза записи»)

тотальная функция «Закон пустой приставки подходит записи»
  принимает «цель»: строка
  возвращает признак
  пример «Пустая приставка у любого терма»
    дано «цель» равно "текст начинается с \"\""
    ожидается да
  пусть «разрез» равно («Разрез по записи» от «цель» и "начинается с")
  («разрез».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от «цель») и "начинается с")) равен 2) и притом ((«Ужать записи» от («разрез».«право»)) равен "\"\"")

тотальная функция «Ход вычисления стороны записи»
  принимает «цель»: строка
  возвращает «Форма записи»
  пример «Левая сторона равенства считается»
    дано «цель» равно "( длина ( [а, б] ) ) равен 2"
    ожидается запись «Форма записи» с «есть» равным да и «вид» равным "вычислить" и «левая» равным "длина ( [а, б] )" и «правая» равным "2" и «закон» равным ""
  пример «Терм под отрицанием считается»
    дано «цель» равно "не ( 2 больше 2 )"
    ожидается запись «Форма записи» с «есть» равным да и «вид» равным "вычислить" и «левая» равным "2 больше 2" и «правая» равным "нет" и «закон» равным ""
  пример «Замкнутая цель считается целиком»
    дано «цель» равно "( 2 не меньше 0 ) и притом ( 2 не больше 2 )"
    ожидается запись «Форма записи» с «есть» равным да и «вид» равным "вычислить" и «левая» равным "( 2 не меньше 0 ) и притом ( 2 не больше 2 )" и «правая» равным "да" и «закон» равным ""
  пусть «целиком» равно («Значение терма записи» от «цель» и 8)
  пусть «стороны» равно («Стороны равенства записи» от «цель»)
  пусть «левая» равно («Ужать записи» от («стороны».«лево»))
  пусть «слева» равно («Значение терма записи» от «левая» и 8)
  пусть «под не» равно («Ужать записи» от («Слова после записи» от «цель» и 1))
  пусть «отрицаемое» равно («Значение терма записи» от «под не» и 8)
  если («стороны».«есть») и притом («слева».«есть») и притом (не ((«слева».«вид») равен "список")) и притом (не ((«слева».«текст») равен «левая»))
    то запись «Форма записи» с «есть» равным да и «вид» равным "вычислить" и «левая» равным «левая» и «правая» равным («слева».«текст») и «закон» равным ""
    иначе
      если («целиком».«есть») и притом (не ((«целиком».«вид») равен "список")) и притом (не ((«целиком».«текст») равен «цель»))
        то запись «Форма записи» с «есть» равным да и «вид» равным "вычислить" и «левая» равным «цель» и «правая» равным («целиком».«текст») и «закон» равным ""
        иначе
          если («цель» начинается с "не ") и притом («отрицаемое».«есть») и притом ((«отрицаемое».«вид») равен "признак")
            то запись «Форма записи» с «есть» равным да и «вид» равным "вычислить" и «левая» равным «под не» и «правая» равным («отрицаемое».«текст») и «закон» равным ""
            иначе («Нет формы записи»)

тотальная функция «Решить цель записи»
  принимает «цель»: строка, «горючее»: нат
  возвращает «План разбора записи»
  пример «Литерал да закрывается истиной»
    дано «цель» равно "да"
    дано «горючее» равно 16
    ожидается запись «План разбора записи» с «удалось» равным да и «ходы» равным ["закрыть истиной"]
  пример «Охрана делится, ветви выбираются, половины закрываются»
    дано «цель» равно "если порог больше 0 то ( если порог больше 0 то ( длина элементы ) иначе 0 ) равен ( длина элементы ) иначе да"
    дано «горючее» равно 16
    ожидается запись «План разбора записи» с «удалось» равным да и «ходы» равным ["деление ⟨порог больше 0⟩", "выбор ⟨если да то ( длина элементы ) иначе 0⟩", "выбор ⟨если да то ( длина элементы ) равен ( длина элементы ) иначе да⟩", "закрыть тождеством", "выбор ⟨если нет то ( длина элементы ) иначе 0⟩", "выбор ⟨если нет то 0 равен ( длина элементы ) иначе да⟩", "закрыть истиной"]
  пример «Импликация — закон признака дважды на каждой половине»
    дано «цель» равно "( если посылка то следствие иначе да ) равен ( ( не посылка ) или следствие )"
    дано «горючее» равно 16
    ожидается запись «План разбора записи» с «удалось» равным да и «ходы» равным ["деление ⟨посылка⟩", "выбор ⟨если да то следствие иначе да⟩", "переписать формой ⟨не да⟩ = ⟨нет⟩ законом «Закон признака»", "переписать формой ⟨нет или следствие⟩ = ⟨следствие⟩ законом «Закон признака»", "закрыть тождеством", "выбор ⟨если нет то следствие иначе да⟩", "переписать формой ⟨не нет⟩ = ⟨да⟩ законом «Закон признака»", "переписать формой ⟨да или следствие⟩ = ⟨да⟩ законом «Закон признака»", "закрыть тождеством"]
  пример «Дизъюнкция — половина, которая закрывается»
    дано «цель» равно "( 2 равен 0 ) или ( 2 равен 2 )"
    дано «горючее» равно 16
    ожидается запись «План разбора записи» с «удалось» равным да и «ходы» равным ["связка ⟨или⟩ правая", "закрыть тождеством"]
  пример «Свободное имя без формы — плана нет»
    дано «цель» равно "( «Все неотрицательны» от ( пустой список ) ) равен да"
    дано «горючее» равно 16
    ожидается запись «План разбора записи» с «удалось» равным нет и «ходы» равным пустой список
  пусть «выбор» равно («Выбор с литералом записи» от «цель»)
  пусть «условие» равно («Первое условие записи» от «цель»)
  пусть «делится» равно ((длина «условие») больше 0) и притом ((«цель» содержит («Слить строки записи» от ["если ", «условие», " то "])) или («цель» содержит («Слить строки записи» от ["если ( ", «условие», " ) то "])))
  пусть «склейка» равно («Остаток начала склейки записи» от «цель»)
  пусть «признак» равно («Первая форма признака записи» от («Группы скобок записи» от «цель»))
  пусть «связка и» равно («Разрез по записи» от «цель» и "и притом")
  пусть «связка или» равно («Разрез по записи» от «цель» и "или")
  пусть «простые и» равно («связка и».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от «цель») и "и притом")) равен 2) и притом («Простой терм записи» от («связка и».«лево»)) и притом («Простой терм записи» от («связка и».«право»))
  пусть «простые или» равно («связка или».«есть») и притом ((длина («Разделить сверху записи» от («Ужать записи» от «цель») и "или")) равен 2) и притом («Простой терм записи» от («связка или».«лево»)) и притом («Простой терм записи» от («связка или».«право»))
  пусть «счёт» равно («Ход вычисления стороны записи» от «цель»)
  если «горючее» не больше 0
    то («Нет плана записи»)
    иначе
      если «цель» равен "да"
        то («План одним ходом записи» от "закрыть истиной")
        иначе
          если «Тождественны стороны записи» от «цель»
            то («План одним ходом записи» от "закрыть тождеством")
            иначе
              если (длина «выбор») больше 0
                то («Ход перед планом записи» от («Слить строки записи» от ["выбор ⟨", «выбор», "⟩"]) и («Решить цель записи» от («Терм записи» от («Вставить вместо записи» от «цель» и «выбор» и («Ветвь выбора записи» от «выбор»))) и («горючее» минус 1)))
                иначе
                  если «делится»
                    то («Склеить планы записи» от («Слить строки записи» от ["деление ⟨", «условие», "⟩"]) и («Решить цель записи» от («Терм записи» от («Вставить вместо записи» от «цель» и «условие» и "да")) и («горючее» минус 1)) и («Решить цель записи» от («Терм записи» от («Вставить вместо записи» от «цель» и «условие» и "нет")) и («горючее» минус 1)))
                    иначе
                      если «Закон меры подходит записи» от «цель»
                        то («План одним ходом записи» от "закон «мера неотрицательна»")
                        иначе
                          если «Закон квадрата подходит записи» от «цель»
                            то («План одним ходом записи» от "закон «квадрат под оговоркой»")
                            иначе
                              если «Закон пустой приставки подходит записи» от «цель»
                                то («План одним ходом записи» от "закон «пустая приставка»")
                                иначе
                                  если («склейка».«есть») и притом ((длина («склейка».«лево»)) равен 0)
                                    то («План одним ходом записи» от "закон «начало склейки»")
                                    иначе
                                      если («склейка».«есть»)
                                        то («Ход перед планом записи» от "закон «начало склейки»" и («Решить цель записи» от («Терм записи» от («склейка».«лево»)) и («горючее» минус 1)))
                                        иначе
                                          если («признак».«есть»)
                                            то («Ход перед планом записи» от («Строка хода формы записи» от «признак») и («Решить цель записи» от («Терм записи» от («Вставить вместо записи» от «цель» и («признак».«левая») и («признак».«правая»))) и («горючее» минус 1)))
                                            иначе
                                              если «Вхождение в выписанный список записи» от «цель»
                                                то запись «План разбора записи» с «удалось» равным да и «ходы» равным [(«Слить строки записи» от ["переписать формой ⟨", «цель», "⟩ = ⟨да⟩ законом «Вхождение в выписанный список»"]), "закрыть истиной"]
                                                иначе
                                                  если («счёт».«есть») и притом ((«счёт».«левая») равен «цель»)
                                                    то («Ход перед планом записи» от («Строка хода формы записи» от «счёт») и («Решить цель записи» от («счёт».«правая») и («горючее» минус 1)))
                                                    иначе
                                                      если «простые и»
                                                        то («Склеить планы записи» от "связка ⟨и притом⟩" и («Решить цель записи» от («Терм записи» от («связка и».«лево»)) и («горючее» минус 1)) и («Решить цель записи» от («Терм записи» от («связка и».«право»)) и («горючее» минус 1)))
                                                        иначе
                                                          если «простые или» и притом ((«Решить цель записи» от («Терм записи» от («связка или».«лево»)) и («горючее» минус 1)).«удалось»)
                                                            то («Ход перед планом записи» от "связка ⟨или⟩ левая" и («Решить цель записи» от («Терм записи» от («связка или».«лево»)) и («горючее» минус 1)))
                                                            иначе
                                                              если «простые или»
                                                                то («Ход перед планом записи» от "связка ⟨или⟩ правая" и («Решить цель записи» от («Терм записи» от («связка или».«право»)) и («горючее» минус 1)))
                                                                иначе
                                                                  если («счёт».«есть»)
                                                                    то («Ход перед планом записи» от («Строка хода формы записи» от «счёт») и («Решить цель записи» от («Терм записи» от («Вставить вместо записи» от «цель» и («счёт».«левая») и («счёт».«правая»))) и («горючее» минус 1)))
                                                                    иначе («Нет плана записи»)

объект «Тело с подстановками записи»
  «где»: число
  «тело»: строка
  «подстановки»: список строки

объект «Сбор тела записи»
  «номер»: число
  «внутри»: признак
  «строки»: список строки
  «номера»: список число

тотальная функция «Шаг сбора тела записи»
  принимает «сбор»: «Сбор тела записи», «сырая»: строка, «функция»: строка
  возвращает «Сбор тела записи»
  обеспечивает «счёт строк идёт ровно на одну» (результат.«номер») равен ((«сбор».«номер») плюс 1)
  пусть «номер» равно ((«сбор».«номер») плюс 1)
  пусть «верхняя» равно (((длина «сырая») больше 0) и притом (не («сырая» начинается с " ")))
  пусть «заголовок» равно ((«сырая» начинается с "функция «") или («сырая» начинается с "тотальная функция «"))
  если «верхняя» и притом (не («сырая» начинается с "//"))
    то запись «Сбор тела записи» с «номер» равным «номер» и «внутри» равным («заголовок» и притом ((«Имя заголовка записи» от «сырая») равен «функция»)) и «строки» равным («сбор».«строки») и «номера» равным («сбор».«номера»)
    иначе
      если («сбор».«внутри») и притом («Это тело записи» от «сырая»)
        то запись «Сбор тела записи» с «номер» равным «номер» и «внутри» равным да и «строки» равным (добавить («Обрезать края записи» от «сырая») к («сбор».«строки»)) и «номера» равным (добавить «номер» к («сбор».«номера»))
        иначе запись «Сбор тела записи» с «номер» равным «номер» и «внутри» равным («сбор».«внутри») и «строки» равным («сбор».«строки») и «номера» равным («сбор».«номера»)

тотальная функция «Строка подстановки записи»
  принимает «номер»: число, «строка»: строка
  возвращает строка
  пример «Строка пусть даёт номер, имя и значение через табуляцию»
    дано «номер» равно 40
    дано «строка» равно "пусть сколько равно (длина элементы)"
    ожидается "40\tсколько\tдлина элементы"
  пример «Не пусть — пусто»
    дано «номер» равно 41
    дано «строка» равно "если порог больше 0 то сколько иначе 0"
    ожидается ""
  пусть «слова» равно (разделить («Сжать пробелы записи» от «строка») по " ")
  пусть «имя» равно (если (длина «слова») больше 2 то (элемент 2 в «слова») иначе "")
  пусть «равно» равно (если (длина «слова») больше 2 то (элемент 3 в «слова») иначе "")
  пусть «значение» равно («Терм записи» от («Слова после записи» от («Сжать пробелы записи» от «строка») и 3))
  если («строка» начинается с "пусть ") и притом («равно» равен "равно") и притом ((длина «имя») больше 0) и притом (не («имя» содержит "(")) и притом (не («имя» содержит "«")) и притом ((длина «значение») больше 0)
    то («Слить строки записи» от [(«Число строкой» от «номер»), "\t", «имя», "\t", «значение»])
    иначе ""

тотальная функция «Шаг подстановок тела записи»
  принимает «нумерация»: «Нумерация ходов записи», «где»: число, «строки»: список строки
  возвращает «Нумерация ходов записи»
  обеспечивает «номер растёт ровно на строку» (результат.«номер») равен ((«нумерация».«номер») плюс 1)
  пример «Все строки тела, кроме последней, идут в подстановки»
    дано «нумерация» равно запись «Нумерация ходов записи» с «номер» равным 0 и «строки» равным пустой список
    дано «где» равно 40
    дано «строки» равно ["пусть сколько равно (длина элементы)", "если порог больше 0 то сколько иначе 0"]
    ожидается запись «Нумерация ходов записи» с «номер» равным 1 и «строки» равным ["40\tсколько\tдлина элементы"]
  пусть «номер» равно ((«нумерация».«номер») плюс 1)
  если «номер» меньше (длина «строки»)
    то запись «Нумерация ходов записи» с «номер» равным «номер» и «строки» равным (добавить («Строка подстановки записи» от «где» и (элемент «номер» в «строки»)) к («нумерация».«строки»))
    иначе запись «Нумерация ходов записи» с «номер» равным «номер» и «строки» равным («нумерация».«строки»)

тотальная функция «Тело с подстановками записи»
  принимает «строки»: список строки, «функция»: строка
  возвращает «Тело с подстановками записи»
  пример «Однострочное тело — без подстановок»
    дано «строки» равно ["тотальная функция «Тот же список»", "  принимает элементы: список число", "  элементы"]
    дано «функция» равно "Тот же список"
    ожидается запись «Тело с подстановками записи» с «где» равным 3 и «тело» равным "элементы" и «подстановки» равным пустой список
  пример «Пусть перед телом становится подстановкой»
    дано «строки» равно ["тотальная функция «Длина при пороге под пусть»", "  принимает порог: число, элементы: список число", "  пусть сколько равно (длина элементы)", "  если порог больше 0 то сколько иначе 0"]
    дано «функция» равно "Длина при пороге под пусть"
    ожидается запись «Тело с подстановками записи» с «где» равным 4 и «тело» равным "если порог больше 0 то сколько иначе 0" и «подстановки» равным ["3\tсколько\tдлина элементы"]
  пример «Многострочное тело не из пусть — тела нет»
    дано «строки» равно ["тотальная функция «Первый знак»", "  принимает текст: строка", "  разбор текст", "    случай пусто", "      то \"\""]
    дано «функция» равно "Первый знак"
    ожидается запись «Тело с подстановками записи» с «где» равным 0 и «тело» равным "" и «подстановки» равным пустой список
  пусть «сбор» равно (свёртка «строки» начиная с (запись «Сбор тела записи» с «номер» равным 0 и «внутри» равным нет и «строки» равным пустой список и «номера» равным пустой список) как «сбор» и «сырая» → («Шаг сбора тела записи» от «сбор» и «сырая» и «функция»))
  пусть «сколько» равно (длина («сбор».«строки»))
  пусть «нумерованные» равно (свёртка («сбор».«номера») начиная с (запись «Нумерация ходов записи» с «номер» равным 0 и «строки» равным пустой список) как «нумерация» и «где» → («Шаг подстановок тела записи» от «нумерация» и «где» и («сбор».«строки»)))
  пусть «подстановки» равно (отфильтровать («нумерованные».«строки») где «строка» → ((длина «строка») больше 0))
  если «сколько» равен 0
    то запись «Тело с подстановками записи» с «где» равным 0 и «тело» равным "" и «подстановки» равным пустой список
    иначе
      если (длина «подстановки») равен («сколько» минус 1)
        то запись «Тело с подстановками записи» с «где» равным (элемент «сколько» в («сбор».«номера»)) и «тело» равным (элемент «сколько» в («сбор».«строки»)) и «подстановки» равным «подстановки»
        иначе запись «Тело с подстановками записи» с «где» равным 0 и «тело» равным "" и «подстановки» равным пустой список

объект «Подстановки в цели записи»
  «цель»: строка
  «ходы»: список строки

тотальная функция «Подставить пусть в цель записи»
  принимает «цель»: строка, «подстановки»: список строки, «первый»: строка, «хвост»: строка
  возвращает «Подстановки в цели записи»
  пример «Имя из цели подставляется своим значением»
    дано «цель» равно "если порог больше 0 то ( если порог больше 0 то сколько иначе 0 ) равен ( длина элементы ) иначе да"
    дано «подстановки» равно ["40\tсколько\tдлина элементы"]
    дано «первый» равно "порог"
    дано «хвост» равно " и элементы"
    ожидается запись «Подстановки в цели записи» с «цель» равным "если порог больше 0 то ( если порог больше 0 то ( длина элементы ) иначе 0 ) равен ( длина элементы ) иначе да" и «ходы» равным ["подставить пусть строка 40"]
  пример «Имя вне цели хода не получает»
    дано «цель» равно "если порог больше 0 то сколько иначе 0"
    дано «подстановки» равно ["53\tсвёрнутое\tсвёртка элементы начиная с 0 как накопитель и элемент → ( накопитель плюс 1 )"]
    дано «первый» равно "порог"
    дано «хвост» равно " и элементы"
    ожидается запись «Подстановки в цели записи» с «цель» равным "если порог больше 0 то сколько иначе 0" и «ходы» равным пустой список
  свёртка «подстановки» начиная с (запись «Подстановки в цели записи» с «цель» равным «цель» и «ходы» равным пустой список) как «итог» и «подстановка» → (если ((длина (разделить «подстановка» по "\t")) равен 3) и притом («Есть терм записи» от («итог».«цель») и (элемент 2 в (разделить «подстановка» по "\t"))) и притом (не ((элемент 2 в (разделить «подстановка» по "\t")) равен «первый»)) и притом (не («Есть терм записи» от «хвост» и (элемент 2 в (разделить «подстановка» по "\t")))) и притом (не («Есть терм записи» от (элемент 3 в (разделить «подстановка» по "\t")) и (элемент 2 в (разделить «подстановка» по "\t")))) то (запись «Подстановки в цели записи» с «цель» равным («Терм записи» от («Вставить вместо записи» от («итог».«цель») и (элемент 2 в (разделить «подстановка» по "\t")) и (элемент 3 в (разделить «подстановка» по "\t")))) и «ходы» равным (добавить («Слить строки записи» от ["подставить пусть строка ", (элемент 1 в (разделить «подстановка» по "\t"))]) к («итог».«ходы»))) иначе «итог»)

тотальная функция «Цепочка разбора записи»
  принимает «утверждение»: строка, «функция»: строка, «первый»: строка, «хвост»: строка, «где»: число, «тело текстом»: строка, «подстановки»: строка
  возвращает список строки
  обеспечивает «ходов либо ноль, либо не меньше четырёх» если пусто результат то да иначе 4 не больше (длина результат)
  пример «Охрана снаружи — деление, выборы, тождество и истина»
    дано «утверждение» равно "если порог больше 0 то результат равен (длина элементы) иначе да"
    дано «функция» равно "Порог снаружи"
    дано «первый» равно "порог"
    дано «хвост» равно " и элементы"
    дано «где» равно 35
    дано «тело текстом» равно "если порог больше 0 то (длина элементы) иначе 0"
    дано «подстановки» равно ""
    ожидается ["    ход цель", "    ход 1 развернуть ⟨«Порог снаружи» от ( порог ) и элементы⟩ строка 35 ⟨если порог больше 0 то (длина элементы) иначе 0⟩", "    ход 2 деление ⟨порог больше 0⟩", "    ход 3 выбор ⟨если да то ( длина элементы ) иначе 0⟩", "    ход 4 выбор ⟨если да то ( длина элементы ) равен ( длина элементы ) иначе да⟩", "    ход 5 закрыть тождеством", "    ход 6 выбор ⟨если нет то ( длина элементы ) иначе 0⟩", "    ход 7 выбор ⟨если нет то 0 равен ( длина элементы ) иначе да⟩", "    ход 8 закрыть истиной", "    ход конец"]
  пример «Мера списка — один закон»
    дано «утверждение» равно "результат не меньше 0"
    дано «функция» равно "Мера списка"
    дано «первый» равно "элементы"
    дано «хвост» равно ""
    дано «где» равно 26
    дано «тело текстом» равно "длина элементы"
    дано «подстановки» равно ""
    ожидается ["    ход цель", "    ход 1 развернуть ⟨«Мера списка» от ( элементы )⟩ строка 26 ⟨длина элементы⟩", "    ход 2 закон «мера неотрицательна»", "    ход конец"]
  пример «Знак числа — два деления и три вычисления»
    дано «утверждение» равно "результат не больше 1"
    дано «функция» равно "Знак числа"
    дано «первый» равно "н"
    дано «хвост» равно ""
    дано «где» равно 49
    дано «тело текстом» равно "если н больше 0 то 1 иначе (если н меньше 0 то (0 минус 1) иначе 0)"
    дано «подстановки» равно ""
    ожидается ["    ход цель", "    ход 1 развернуть ⟨«Знак числа» от ( н )⟩ строка 49 ⟨если н больше 0 то 1 иначе (если н меньше 0 то (0 минус 1) иначе 0)⟩", "    ход 2 деление ⟨н больше 0⟩", "    ход 3 выбор ⟨если да то 1 иначе ( если н меньше 0 то ( 0 минус 1 ) иначе 0 )⟩", "    ход 4 вычислить ⟨1 не больше 1⟩ = ⟨да⟩", "    ход 5 закрыть истиной", "    ход 6 выбор ⟨если нет то 1 иначе ( если н меньше 0 то ( 0 минус 1 ) иначе 0 )⟩", "    ход 7 деление ⟨н меньше 0⟩", "    ход 8 выбор ⟨если да то ( 0 минус 1 ) иначе 0⟩", "    ход 9 вычислить ⟨( 0 минус 1 ) не больше 1⟩ = ⟨да⟩", "    ход 10 закрыть истиной", "    ход 11 выбор ⟨если нет то ( 0 минус 1 ) иначе 0⟩", "    ход 12 вычислить ⟨0 не больше 1⟩ = ⟨да⟩", "    ход 13 закрыть истиной", "    ход конец"]
  пример «Пусть подставляется до деления»
    дано «утверждение» равно "если порог больше 0 то результат равен (длина элементы) иначе да"
    дано «функция» равно "Порог под пусть"
    дано «первый» равно "порог"
    дано «хвост» равно " и элементы"
    дано «где» равно 43
    дано «тело текстом» равно "если порог больше 0 то сколько иначе 0"
    дано «подстановки» равно "42\tсколько\tдлина элементы"
    ожидается ["    ход цель", "    ход 1 развернуть ⟨«Порог под пусть» от ( порог ) и элементы⟩ строка 43 ⟨если порог больше 0 то сколько иначе 0⟩", "    ход 2 подставить пусть строка 42", "    ход 3 деление ⟨порог больше 0⟩", "    ход 4 выбор ⟨если да то ( длина элементы ) иначе 0⟩", "    ход 5 выбор ⟨если да то ( длина элементы ) равен ( длина элементы ) иначе да⟩", "    ход 6 закрыть тождеством", "    ход 7 выбор ⟨если нет то ( длина элементы ) иначе 0⟩", "    ход 8 выбор ⟨если нет то 0 равен ( длина элементы ) иначе да⟩", "    ход 9 закрыть истиной", "    ход конец"]
  пример «Свёртка в теле — плана нет»
    дано «утверждение» равно "результат не меньше 0"
    дано «функция» равно "Порог под свёрткой"
    дано «первый» равно "порог"
    дано «хвост» равно " и элементы"
    дано «где» равно 79
    дано «тело текстом» равно "свёртка элементы начиная с 0 как накопитель и элемент → (если порог больше 0 то (накопитель плюс 1) иначе накопитель)"
    дано «подстановки» равно ""
    ожидается пустой список
  пусть «вызов» равно («Вызов функции записи» от «функция» и «первый» и «хвост»)
  пусть «начальная» равно («Терм записи» от («Вставить вместо записи» от («Терм записи» от «утверждение») и "результат" и «вызов»))
  пусть «после подстановок» равно («Подставить пусть в цель записи» от («Цель после развёртки записи» от «утверждение» и «вызов» и «тело текстом») и (отфильтровать (разделить «подстановки» по "\n") где «строка» → ((длина «строка») больше 0)) и «первый» и «хвост»)
  пусть «план» равно («Решить цель записи» от («после подстановок».«цель») и 16)
  если («план».«удалось») и притом («Есть терм записи» от «начальная» и («Терм записи» от «вызов»)) и притом («утверждение» содержит "результат")
    то («Соединить списки записи» от («Соединить списки записи» от ["    ход цель", («Строка развёртки вызовом записи» от «вызов» и «где» и «тело текстом»)] и («Пронумеровать ходы записи» от («Соединить списки записи» от («после подстановок».«ходы») и («план».«ходы»)) и 2)) и ["    ход конец"])
    иначе пустой список

тотальная функция «Правило разбора цели записи»
  принимает «правило»: строка
  возвращает признак
  пример «Разбор цели по условию — правило разбора»
    дано «правило» равно "разбор цели по условию"
    ожидается да
  пример «Тождество после переписки — не разбор»
    дано «правило» равно "тождество после переписки допущением"
    ожидается нет
  («правило» равен "разбор цели по условию") или («правило» равен "разбор случаев по внутреннему условию цели") или («правило» равен "неотрицательность по построению") или («правило» равен "ограниченность точным потолком по построению") или («правило» равен "начало по построению")

тотальная функция «Тело планировщику по силам записи»
  принимает «тело»: строка, «утверждение»: строка
  возвращает признак
  пример «Однострочное условие по силам»
    дано «тело» равно "если порог больше 0 то (длина элементы) иначе 0"
    дано «утверждение» равно "если порог больше 0 то результат равен (длина элементы) иначе да"
    ожидается да
  пример «Свёртка в теле — не по силам»
    дано «тело» равно "свёртка элементы начиная с 0 как накопитель и элемент → если элемент равен значение то (накопитель плюс 1) иначе накопитель"
    дано «утверждение» равно "результат не меньше 0"
    ожидается нет
  пример «Разбор в теле — не по силам»
    дано «тело» равно "разбор текст"
    дано «утверждение» равно "(длина результат) не больше 1"
    ожидается нет
  (не («тело» содержит "свёртка ")) и притом (не («тело» содержит "разбор ")) и притом (не («тело» содержит "отобразить ")) и притом (не («тело» содержит "→")) и притом (((длина «тело») плюс (длина «утверждение»)) не больше 300)

тотальная функция «Ходы разбора цели постусловия записи»
  принимает «обязательство»: «Значение», «строки»: список строки, «функция»: строка
  возвращает список строки
  обеспечивает «ходов либо ноль, либо не меньше четырёх» если пусто результат то да иначе 4 не больше (длина результат)
  пример «Не постусловие разбора — ходов нет»
    дано «обязательство» равно вариант «Значение записи» с «поля» равным пустой список
    дано «строки» равно пустой список
    дано «функция» равно "Мера списка"
    ожидается пустой список
  пример «Мера списка под неотрицательностью по построению»
    дано «обязательство» равно вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "of" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "Мера списка"))), (запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "В1 результат не меньше нуля"))), (запись «Поле значения» с «ключ» равным "discharge" и «значение» равным (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "by" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "declaration"))), (запись «Поле значения» с «ключ» равным "rule" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "неотрицательность по построению"))), (запись «Поле значения» с «ключ» равным "verdict" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "доказано")))]))]
    дано «строки» равно ["тотальная функция «Мера списка»", "  принимает элементы: список число", "  возвращает число", "  обеспечивает «В1 результат не меньше нуля» результат не меньше 0", "  длина элементы"]
    дано «функция» равно "Мера списка"
    ожидается ["    ход цель", "    ход 1 развернуть ⟨«Мера списка» от ( элементы )⟩ строка 5 ⟨длина элементы⟩", "    ход 2 закон «мера неотрицательна»", "    ход конец"]
  пусть «вердикт» равно («Взять поле» от «обязательство» и "discharge")
  пусть «тело» равно («Тело с подстановками записи» от «строки» и «функция»)
  пусть «первый» равно («Первый довод функции записи» от «строки» и «функция»)
  пусть «хвост» равно («Прочие доводы функции» от «строки» и «функция»)
  пусть «утверждение» равно («Текст утверждения записи» от «строки» и («Строка поля» от «обязательство» и "name"))
  если не ((«Это запись» от «вердикт») и притом (("declaration") равен («Строка поля» от «вердикт» и "by")) и притом («Правило разбора цели записи» от («Строка поля» от «вердикт» и "rule")) и притом (("доказано") равен («Строка поля» от «вердикт» и "verdict")) и притом ((«тело».«где») больше 0) и притом ((длина «утверждение») больше 0) и притом («Тело планировщику по силам записи» от («тело».«тело») и «утверждение»))
    то пустой список
    иначе «Цепочка разбора записи» от «утверждение» и «функция» и «первый» и «хвост» и («тело».«где») и («тело».«тело») и (соединить («тело».«подстановки») по "\n")

тотальная функция «Строки поля записи»
  принимает «узел»: «Значение», «ключ»: строка
  возвращает список строки
  обеспечивает «строк ровно столько, сколько элементов в поле» (длина результат) равен (длина («Элементы поля» от «узел» и «ключ»))
  пример «Строк ровно столько, сколько элементов в поле»
    дано «узел» равно вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "rules" и «значение» равным (вариант «Значение списка» с «элементы» равным [(вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "спуск по построению"))]))]
    дано «ключ» равно "rules"
    ожидается ["спуск по построению"]
  отобразить («Элементы поля» от «узел» и «ключ») как «э» → («Строка узла» от «э»)

// ═══════════════════════════ теорема автора ═══════════════════════════

тотальная функция «Строки дано»
  принимает «теорема»: «Значение»
  возвращает список строки
  обеспечивает «строка дано на каждую переменную теоремы» (длина результат) равен (длина («Элементы поля» от «теорема» и "vars"))
  пример «Без переменных теоремы строк дано нет»
    дано «теорема» равно вариант «Значение записи» с «поля» равным пустой список
    ожидается пустой список
  отобразить («Элементы поля» от «теорема» и "vars") как «в» → («Слить строки записи» от ["  дано ", («В ёлочках записи» от («Строка поля» от «в» и "name")), " строка ", («Число строкой» от («Строка узла записи» от «в»))])

тотальная функция «Строки индукции автора»
  принимает «индукция»: «Значение», «строки исходника»: список строки, «функция»: строка
  возвращает список строки
  обеспечивает «заголовок индукции да строки её случаев» (длина результат) равен ((длина («Строки случаев» от («Элементы поля» от «индукция» и "cases") и «строки исходника» и «функция»)) плюс 1)
  пример «Без случаев остаётся один заголовок индукции»
    дано «индукция» равно вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "param" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "список")))]
    дано «строки исходника» равно пустой список
    дано «функция» равно "Длина"
    ожидается ["  индукция по «список» строка 0"]
  «Соединить списки записи» от [(«Слить строки записи» от ["  индукция по ", («В ёлочках записи» от («Строка поля» от «индукция» и "param")), " строка ", («Число строкой» от («Строка узла записи» от «индукция»))])] и («Строки случаев» от («Элементы поля» от «индукция» и "cases") и «строки исходника» и «функция»)

// ПОРЯДОК СТРОК ЗДЕСЬ — ПОРЯДОК ЧТЕНИЯ ИСХОДНИКА, и это не косметика: сверщик
// сличает список записанных строк со списком строк, вычитанных им из исходника,
// и порядок в этом сличении значим. Теорема, «дано», цель, индукция со
// случаями и шагами, «следовательно доказано» — ровно так они и написаны.
тотальная функция «Строки теоремы»
  принимает «теорема»: «Значение», «строки исходника»: список строки, «функция»: строка
  возвращает список строки
  обеспечивает «теорема пишется не короче трёх строк: шапка, цель и следовательно» 3 не больше (длина результат)
  пример «Теорема без индукции пишется шапкой, целью и следовательно»
    дано «теорема» равно вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "длина не убывает"))), (запись «Поле значения» с «ключ» равным "qed" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр признак» с «значение» равным да)))]
    дано «строки исходника» равно пустой список
    дано «функция» равно "Длина"
    ожидается ["  теорема «длина не убывает» строка 0", "  цель строка 0", "  следовательно доказано да"]
  пусть «шапка» равно [(«Слить строки записи» от ["  теорема ", («В ёлочках записи» от («Строка поля» от «теорема» и "name")), " строка ", («Число строкой» от («Строка узла записи» от «теорема»))])]
  пусть «с дано» равно («Соединить списки записи» от «шапка» и («Строки дано» от «теорема»))
  пусть «с целью» равно («Соединить списки записи» от «с дано» и [(«Слить строки записи» от ["  цель строка ", («Число строкой» от («Строка узла записи» от («Взять поле» от «теорема» и "claim")))])])
  пусть «с телом» равно (если «Это ничто» от («Взять поле» от «теорема» и "induction") то («Соединить списки записи» от «с целью» и («Строки шагов» от («Элементы поля» от «теорема» и "steps") и «строки исходника» и «функция»)) иначе («Соединить списки записи» от «с целью» и («Строки индукции автора» от («Взять поле» от «теорема» и "induction") и «строки исходника» и «функция»)))
  «Соединить списки записи» от «с телом» и [(«Слить строки записи» от ["  следовательно доказано ", (если «Это истина» от («Взять поле» от «теорема» и "qed") то "да" иначе "нет")])]

// ═══════════════════════════ одно утверждение ═══════════════════════════

функция «Строки утверждения»
  принимает «обязательство»: «Значение», «строки исходника»: список строки
  возвращает список строки
  обеспечивает «утверждение пишется не короче шести строк» 6 не больше (длина результат)
  обеспечивает «первой строкой стоит имя утверждения в ёлочках» (элемент 1 в результат) содержит («В ёлочках записи» от («Строка поля» от «обязательство» и "name"))
  пример «Утверждение без вердикта и без теоремы — ровно шесть строк»
    дано «обязательство» равно вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "длина не убывает"))), (запись «Поле значения» с «ключ» равным "of" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "Длина"))), (запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "postcondition")))]
    дано «строки исходника» равно пустой список
    ожидается ["утверждение «длина не убывает» функции «Длина» строка 0", "  вид postcondition", "  вердикт нет вердикта", "  теоремы нет", "конец утверждения", ""]
  пусть «вердикт» равно («Взять поле» от «обязательство» и "discharge")
  пусть «теорема» равно («Взять поле» от «обязательство» и "proof")
  пусть «шапка» равно [
    («Слить строки записи» от ["утверждение ", («В ёлочках записи» от («Строка поля» от «обязательство» и "name")), " функции ", («В ёлочках записи» от («Строка поля» от «обязательство» и "of")), " строка ", («Число строкой» от («Строка узла записи» от «обязательство»))]),
    («Слить строки записи» от ["  вид ", («Строка поля» от «обязательство» и "kind")]),
    («Слить строки записи» от ["  вердикт ", (если «Это запись» от «вердикт» то («Строка поля» от «вердикт» и "verdict") иначе "нет вердикта")])]
  пусть «с теоремой» равно (если «Это ничто» от «теорема» то («Соединить списки записи» от «шапка» и ["  теоремы нет"]) иначе («Соединить списки записи» от «шапка» и («Строки теоремы» от «теорема» и «строки исходника» и («Строка поля» от «обязательство» и "of"))))
  пусть «с принципом» равно (если «Это запись» от «вердикт» то («Соединить списки записи» от («Соединить списки записи» от («Соединить списки записи» от «с теоремой» и («Строки принципа» от «вердикт»)) и («Строки правил сведения» от «вердикт»)) и («Строки посылок» от («Элементы поля» от «вердикт» и "cases") и «строки исходника» и («Строка поля» от «обязательство» и "of"))) иначе «с теоремой»)
  пусть «с объявлением» равно (если «Это запись» от «вердикт» то («Соединить списки записи» от «с принципом» и («Строки объявленного правила» от «вердикт»)) иначе «с принципом»)
  пусть «ходы тождества» равно (если «Это запись» от «вердикт» то («Ходы правила тождества постусловия записи» от «обязательство» и «строки исходника» и («Строка поля» от «обязательство» и "of")) иначе пустой список)
  пусть «ходы леммы» равно (если «Это запись» от «вердикт» то («Ходы по свойству постусловия записи» от «обязательство» и «строки исходника» и («Строка поля» от «обязательство» и "of")) иначе пустой список)
  пусть «ходы разбора» равно (если («Это запись» от «вердикт») и притом (пусто «ходы тождества») и притом (пусто «ходы леммы») то («Ходы разбора цели постусловия записи» от «обязательство» и «строки исходника» и («Строка поля» от «обязательство» и "of")) иначе пустой список)
  пусть «с ходами» равно («Соединить списки записи» от «с объявлением» и «ходы тождества»)
  пусть «с леммой» равно («Соединить списки записи» от «с ходами» и «ходы леммы»)
  пусть «с разбором» равно («Соединить списки записи» от «с леммой» и «ходы разбора»)
  «Соединить списки записи» от «с разбором» и ["конец утверждения", ""]

// ═══ ОГЛАВЛЕНИЕ СПИСОЧНЫХ ЛИТЕРАЛОВ ════════════════════════════════════════
//
// ЧТО ЭТО. Запись получает оглавление: у какой функции тело — списочный
// литерал, какая строка его открывает, какая закрывает и сколько строк между
// скобками. Больше НИЧЕГО: ни значений звеньев, ни вывода из них.
//
// ЗАЧЕМ ЗДЕСЬ, А НЕ В ЧЕКЕРЕ. Печать записи лежит вне тройки доверенных файлов,
// и правка здесь границу доверия не двигает. Ложь оглавления
// ловится тем же приёмом, что терм при номере строки: чекер читает
// названные строки исходника САМ, обязан увидеть на них ровно «[» и «]», сам
// считает строки-звенья и сам сличает свой счёт с объявленным здесь.
//
// ГРАНИЦА, ПОСТАВЛЕННАЯ НАРОЧНО. Печать УКАЗЫВАЕТ, а не судит. Разбор звеньев,
// счёт длин, сравнение таблиц остаются работой чекера. Как только печать начнёт
// решать, она станет вторым ядром — и проверять её будет нечем, потому что
// второго чтения у решения нет, а у указателя есть.
объект «Таблица записи»
  «имя»: строка
  «открыта»: число
  «закрыта»: число

объект «Обход таблиц записи»
  «счёт»: число
  «имя»: строка
  «доводы»: признак
  «открыта»: число
  «закрыта»: число
  «найдено»: список «Таблица записи»

тотальная функция «Пустой обход таблиц записи»
  возвращает «Обход таблиц записи»
  обеспечивает «пустой обход ничего не нашёл» пусто (результат.«найдено»)
  запись «Обход таблиц записи» с «счёт» равным 0 и «имя» равным "" и «доводы» равным нет и «открыта» равным 0 и «закрыта» равным 0 и «найдено» равным пустой список

// Имя из заголовка функции: первое, что стоит в ёлочках.
тотальная функция «Имя заголовка записи»
  принимает «строка»: строка
  возвращает строка
  пример «Имя берётся из ёлочек заголовка»
    дано «строка» равно "тотальная функция «Знаки»"
    ожидается "Знаки"
  голова (разделить (элемент 2 в (разделить «строка» по "«")) по "»")

// Закрыть накопленную функцию. Таблицей она становится, только если у функции
// нет доводов (у функции с доводами `результат` не одно значение) и обе скобки
// нашлись, а между ними есть хоть одна строка.
тотальная функция «Закрыть таблицу записи»
  принимает «в»: «Обход таблиц записи»
  возвращает список «Таблица записи»
  обеспечивает «закрытие не укорачивает найденного» (длина результат) не меньше (длина («в».«найдено»))
  пример «Функция с доводами в оглавление не попадает»
    дано «в» равно (запись «Обход таблиц записи» с «счёт» равным 9 и «имя» равным "Ф" и «доводы» равным да и «открыта» равным 2 и «закрыта» равным 5 и «найдено» равным пустой список)
    ожидается пустой список
  если ((не («в».«доводы»)) и притом (не ((«в».«имя») равен ""))) и притом ((((«в».«открыта») больше 0) и притом ((«в».«закрыта») больше ((«в».«открыта») плюс 1))))
    то (добавить (запись «Таблица записи» с «имя» равным («в».«имя») и «открыта» равным («в».«открыта») и «закрыта» равным («в».«закрыта»)) к («в».«найдено»))
    иначе («в».«найдено»)

тотальная функция «Шаг обхода таблиц записи»
  принимает «в»: «Обход таблиц записи», «сырая»: строка
  возвращает «Обход таблиц записи»
  обеспечивает «счёт растёт ровно на строку» (результат.«счёт») равен ((«в».«счёт») плюс 1)
  пример «Заголовок функции начинает новую таблицу»
    дано «в» равно (запись «Обход таблиц записи» с «счёт» равным 0 и «имя» равным "" и «доводы» равным нет и «открыта» равным 0 и «закрыта» равным 0 и «найдено» равным пустой список)
    дано «сырая» равно "тотальная функция «Знаки»"
    ожидается (запись «Обход таблиц записи» с «счёт» равным 1 и «имя» равным "Знаки" и «доводы» равным нет и «открыта» равным 0 и «закрыта» равным 0 и «найдено» равным пустой список)
  пусть «н» равно ((«в».«счёт») плюс 1)
  пусть «строка» равно («Обрезать края записи» от «сырая»)
  если («сырая» начинается с "функция «") или («сырая» начинается с "тотальная функция «")
    то (запись «Обход таблиц записи» с «счёт» равным «н» и «имя» равным («Имя заголовка записи» от «сырая») и «доводы» равным нет и «открыта» равным 0 и «закрыта» равным 0 и «найдено» равным («Закрыть таблицу записи» от «в»))
    иначе
      если «строка» начинается с "принимает "
        то (запись «Обход таблиц записи» с «счёт» равным «н» и «имя» равным («в».«имя») и «доводы» равным да и «открыта» равным («в».«открыта») и «закрыта» равным («в».«закрыта») и «найдено» равным («в».«найдено»))
        иначе
          если «строка» равен "["
            то (запись «Обход таблиц записи» с «счёт» равным «н» и «имя» равным («в».«имя») и «доводы» равным («в».«доводы») и «открыта» равным «н» и «закрыта» равным 0 и «найдено» равным («в».«найдено»))
            иначе
              если «строка» равен "]"
                то (запись «Обход таблиц записи» с «счёт» равным «н» и «имя» равным («в».«имя») и «доводы» равным («в».«доводы») и «открыта» равным («в».«открыта») и «закрыта» равным «н» и «найдено» равным («в».«найдено»))
                иначе (запись «Обход таблиц записи» с «счёт» равным «н» и «имя» равным («в».«имя») и «доводы» равным («в».«доводы») и «открыта» равным («в».«открыта») и «закрыта» равным («в».«закрыта») и «найдено» равным («в».«найдено»))

тотальная функция «Таблицы записи»
  принимает «строки»: список строки
  возвращает список «Таблица записи»
  обеспечивает «нет строк — нет таблиц» если пусто «строки» то пусто результат иначе да
  пример «Списочное тело функции без доводов попадает в оглавление»
    дано «строки» равно ["тотальная функция «Знаки»", "  возвращает список строки", "  [", "    \"а\",", "    \"б\"", "  ]"]
    ожидается [(запись «Таблица записи» с «имя» равным "Знаки" и «открыта» равным 3 и «закрыта» равным 6)]
  «Закрыть таблицу записи» от (свёртка «строки» начиная с («Пустой обход таблиц записи») как «в» и «л» → («Шаг обхода таблиц записи» от «в» и «л»))

тотальная функция «Строка таблицы записи»
  принимает «т»: «Таблица записи»
  возвращает строка
  обеспечивает «строка таблицы начинается словом таблица» результат начинается с "  таблица «"
  пример «Таблица печатается именем и двумя скобками»
    дано «т» равно (запись «Таблица записи» с «имя» равным "Знаки" и «открыта» равным 3 и «закрыта» равным 6)
    ожидается "  таблица «Знаки» открыта 3 закрыта 6 звеньев 2"
  «Слить строки записи» от ["  таблица ", («В ёлочках записи» от («т».«имя»)), " открыта ", («Число строкой» от («т».«открыта»)), " закрыта ", («Число строкой» от («т».«закрыта»)), " звеньев ", («Число строкой» от (((«т».«закрыта») минус («т».«открыта»)) минус 1))]

// Оглавления НЕТ вовсе, если списочных тел в исходнике нет: запись файла без
// таблиц остаётся побайтово прежней.
тотальная функция «Строки оглавления записи»
  принимает «таблицы»: список «Таблица записи»
  возвращает список строки
  обеспечивает «нет таблиц — нет и строк» если пусто «таблицы» то пусто результат иначе да
  пример «Без списочных тел оглавление не печатается»
    дано «таблицы» равно пустой список
    ожидается пустой список
  если пусто «таблицы»
    то пустой список
    иначе («Соединить списки записи» от («Соединить списки записи» от [(«Слить строки записи» от ["таблиц ", («Число строкой» от (длина «таблицы»))])] и (отобразить «таблицы» как «т» → («Строка таблицы записи» от «т»))) и [""])

// ═══════════════════════════ вся запись ═══════════════════════════

тотальная функция «Версия записи»
  возвращает число
  обеспечивает «версия записи не меньше первой» 1 не больше результат
  пример «Первая»
    ожидается 1
  1

тотальная функция «Строки шапки»
  принимает «путь»: строка, «текст»: строка, «ядро»: число, «сколько»: число, «тотальностей»: число
  возвращает список строки
  обеспечивает «шапка — девять строк» (длина результат) равен 9
  обеспечивает «первой строкой шапки объявлена версия записи» (элемент 1 в результат) содержит («Число строкой» от («Версия записи»))
  // Отпечаток пустого текста — начальное значение свёртки, и оно одно и то же
  // у обоих многочленов: складывать и умножать ещё нечего.
  // Девятая строка — пустая, ПОКА нет композиций; при них на её место встаёт
  // «тотальностей N» (счёт блоков секции тотальности, [Ш3]). Число строк — 9 в
  // обоих случаях, поэтому «ядро»/«утверждений» и криптоотпечаток, что чекер
  // читает по номеру строки, не двигаются.
  пример «Без композиций девятая строка шапки пуста»
    дано «путь» равно "а.flang"
    дано «текст» равно ""
    дано «ядро» равно 3
    дано «сколько» равно 0
    дано «тотальностей» равно 0
    ожидается ["запись доказательства 1", "исходник а.flang", "строк 1", "знаков 0", "отпечаток 7 7", "ядро 3", "утверждений 0", "отпечаток256 e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", ""]
  пример «При композициях девятой строкой стоит их счёт»
    дано «путь» равно "а.flang"
    дано «текст» равно ""
    дано «ядро» равно 3
    дано «сколько» равно 0
    дано «тотальностей» равно 2
    ожидается ["запись доказательства 1", "исходник а.flang", "строк 1", "знаков 0", "отпечаток 7 7", "ядро 3", "утверждений 0", "отпечаток256 e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "тотальностей 2"]
  [
    («Слить строки записи» от ["запись доказательства ", («Число строкой» от («Версия записи»))]),
    («Слить строки записи» от ["исходник ", «путь»]),
    («Слить строки записи» от ["строк ", («Число строкой» от (длина (разделить «текст» по "\n")))]),
    («Слить строки записи» от ["знаков ", («Число строкой» от (длина «текст»))]),
    («Слить строки записи» от ["отпечаток ", («Число строкой» от («Отпечаток текста» от «текст» и («Первый множитель») и («Первый модуль»))), " ", («Число строкой» от («Отпечаток текста» от «текст» и («Второй множитель») и («Второй модуль»)))]),
    («Слить строки записи» от ["ядро ", («Число строкой» от «ядро»)]),
    («Слить строки записи» от ["утверждений ", («Число строкой» от «сколько»)]),
    // Восьмой строкой, а не пятой: чекер читает «ядро» и «утверждений» ПО
    // НОМЕРУ строки шапки, а сам криптоотпечаток ищет по началу строки. Стоя
    // последним, он не двигает ни одного поля, которое кто-то уже читает.
    («Слить строки записи» от ["отпечаток256 ", («Отпечаток 256 текста» от «текст»)]),
    // Девятая строка: пустая без композиций (запись прежняя), «тотальностей N»
    // при них. Секция [Ш3] стоит без пустой строки, оттого её счёт занимает
    // ровно место этой пустой строки, а не добавляет десятую.
    (если «тотальностей» больше 0 то («Слить строки записи» от ["тотальностей ", («Число строкой» от «тотальностей»)]) иначе "")]

// Записываются ПОСТУСЛОВИЯ, и только они: мера функции — обязательство того же
// слоя, но доказывает её анализ завершаемости, а не терм, и сверять там нечего.
тотальная функция «Утверждения записи»
  принимает «обязательства»: список «Значение»
  возвращает список «Значение»
  обеспечивает «утверждений не больше, чем обязательств» (длина результат) не больше (длина «обязательства»)
  // Мера функции — обязательство того же слоя, но доказывает её анализ
  // завершаемости, а не терм, и сверять там нечего.
  пример «Записываются постусловия, и только они»
    дано «обязательства» равно [(вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "postcondition")))]), (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "measure")))])]
    ожидается [(вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "postcondition")))])]
  отфильтровать «обязательства» где «о» → («Строка поля» от «о» и "kind") равен "postcondition"

// ═══════════════ секция тотальности-композиции ([Ш3]) ═══════════════
//
// СЕРТИФИКАТ ТОТАЛЬНОСТИ ПО КОМПОЗИЦИИ — «доказано композицией: рекурсии нет».
// Не цепочка переписок цели (как у постусловия), а три проверяемых утверждения
// о функции F: кого зовёт тело (пользовательские G со строкой их объявления и
// примитивы языка), что среди зовомых нет самой F, привязка к строке объявления
// F. Печать лишь РАСКЛАДЫВАЕТ по формату — судит чекер («сверщик.c»,
// `sverit_totalnost`), перечитывая тело сам. Та же граница, что у оглавления
// таблиц: печать указывает, а не решает.
//
// ФОРМАТ — байт-в-байт под разбор чекера и golden «пробы/семьи/totalnost.запись»:
//   тотальность «F» строка M
//     вид composition
//     зовёт «G» строка K тотальна      // на каждый пользовательский вызов
//     зовёт примитив «плюс»            // на каждый примитив языка
//     самовызова нет
//     конец тотальности
// Блоки — в ТОПОЛОГИЧЕСКОМ порядке (зовомый раньше зовущего); этот порядок даёт
// анализ («Упорядоченные компоненты», carriers.flang), печать его лишь хранит.
тип «Зов тотальности записи»
  вариант «Зов функции записи» содержит «имя»: строка, «строка»: число
  вариант «Зов примитива записи» содержит «имя»: строка

// Один виток структурной рекурсии: строка самовызова в исходнике, текст
// убывающего аргумента и НАЗВАННАЯ часть значения (имя, поле, вариант из
// разбора тела). Часть — то, чем структура фундирует дно; чекер перечитывает
// её из исходника и пересверяет (проект §2.1). Печать её только раскладывает.
объект «Виток структуры записи»
  «строка»: число
  «аргтекст»: строка
  «имя части»: строка
  «поле»: строка
  «вариант»: строка

// Один виток шаговой рекурсии: строка самовызова и текст убывающего аргумента
// («имя минус <положительное>»). Дно и неотрицательность даёт ТИП, отдельной
// части значения тут нет (проект §2.2).
объект «Виток шага записи»
  «строка»: число
  «аргтекст»: строка

// Тотальность одной функции — трёх семей ([Ш3] композиция, [Ш3+] structure/step).
// Композиция: рекурсии нет, несёт список зовомых и «самовызова нет». Структура и
// шаг: рекурсия ЕСТЬ и она опора (инверсия composition) — несут убывающий аргумент,
// дно (фундирующий тип), витки и одну строку «самовызов строка K». Печать
// РАСКЛАДЫВАЕТ по формату, судит чекер («сверщик.c»): composition — четыре проверки,
// structure/step переигрывает `sverit_rekursiyu`.
тип «Тотальность записи»
  вариант «Тотальность композиции» содержит «имя»: строка, «строка»: число, «вызовы»: список «Зов тотальности записи»
  вариант «Тотальность структуры» содержит «имя»: строка, «строка»: число, «аргумент»: число, «имя аргумента»: строка, «дно»: строка, «витки»: список «Виток структуры записи», «самовызов»: число
  вариант «Тотальность шага» содержит «имя»: строка, «строка»: число, «аргумент»: число, «имя аргумента»: строка, «дно»: строка, «витки»: список «Виток шага записи», «самовызов»: число

// Одна строка «зовёт …». Пользовательская функция несёт своё имя, строку
// ПЕРВОГО объявления и слово «тотальна» (чекер перепроверит её по реестру
// доказанных РАНЬШЕ); примитив языка — только имя (тотален по определению, строки
// объявления у него нет). Имена печатаются как есть — теми, что ждёт закрытый
// список примитивов чекера (`PRIMITIVY[]`: «плюс», «остаток», «длина», …).
тотальная функция «Строка зова тотальности»
  принимает «зов»: «Зов тотальности записи»
  возвращает строка
  обеспечивает «строка зова — с отступом и словом зовёт» результат начинается с "  зовёт "
  пример «Пользовательский вызов несёт строку и слово тотальна»
    дано «зов» равно (вариант «Зов функции записи» с «имя» равным "Сложить" и «строка» равным 12)
    ожидается "  зовёт «Сложить» строка 12 тотальна"
  пример «Примитив языка печатается одним именем»
    дано «зов» равно (вариант «Зов примитива записи» с «имя» равным "плюс")
    ожидается "  зовёт примитив «плюс»"
  разбор «зов»
    случай вариант «Зов функции записи» с «имя» как «имя» и «строка» как «н»
      то («Слить строки записи» от ["  зовёт ", («В ёлочках записи» от «имя»), " строка ", («Число строкой» от «н»), " тотальна"])
    случай вариант «Зов примитива записи» с «имя» как «имя»
      то («Слить строки записи» от ["  зовёт примитив ", («В ёлочках записи» от «имя»)])

// Заголовок блока: «тотальность «F» строка M». Общий для всех трёх семей — имя
// одевается в ёлочки, номер строки объявления пишется цифрами.
тотальная функция «Заголовок блока тотальности»
  принимает «имя»: строка, «строка»: число
  возвращает строка
  «Слить строки записи» от ["тотальность ", («В ёлочках записи» от «имя»), " строка ", («Число строкой» от «строка»)]

// Блок тотальности функции-композиции: заголовок, вид composition, строки
// зовомых В ПОРЯДКЕ ТЕЛА, свидетельство «самовызова нет», конец. «самовызова
// нет» стоит всегда: у композиции самовызова нет по определению, а чекер это
// перепроверяет чтением тела.
тотальная функция «Строки блока композиции»
  принимает «имя»: строка, «строка»: число, «вызовы»: список «Зов тотальности записи»
  возвращает список строки
  пусть «заголовок» равно [(«Заголовок блока тотальности» от «имя» и «строка»), "  вид composition"]
  пусть «зовы» равно (отобразить «вызовы» как «з» → («Строка зова тотальности» от «з»))
  «Соединить списки записи» от («Соединить списки записи» от «заголовок» и «зовы») и ["  самовызова нет", "  конец тотальности"]

// Две строки одного витка структуры: «виток строка K «F» от <аргтекст>» и под
// ним, с отступом, «часть «имя» поле «поле» варианта «В»». Отступ витка — два
// пробела, части — четыре: так их читает golden и так их разбирает чекер (строку
// части он берёт СЛЕДУЮЩЕЙ за витком).
тотальная функция «Строки витка структуры»
  принимает «имя»: строка, «виток»: «Виток структуры записи»
  возвращает список строки
  [(«Слить строки записи» от ["  виток строка ", («Число строкой» от («виток».«строка»)), " ", («В ёлочках записи» от «имя»), " от ", («виток».«аргтекст»)]), («Слить строки записи» от ["    часть ", («В ёлочках записи» от («виток».«имя части»)), " поле ", («В ёлочках записи» от («виток».«поле»)), " варианта ", («В ёлочках записи» от («виток».«вариант»))])]

// Блок тотальности структурной рекурсии: заголовок, вид structure, убывающий
// аргумент, дно (индуктивный тип, фундирующий рекурсию), по два ряда на каждый
// виток, одна строка «самовызов строка K», конец.
тотальная функция «Строки блока структуры»
  принимает «имя»: строка, «строка»: число, «аргумент»: число, «имя аргумента»: строка, «дно»: строка, «витки»: список «Виток структуры записи», «самовызов»: число
  возвращает список строки
  пусть «заголовок» равно [(«Заголовок блока тотальности» от «имя» и «строка»), "  вид structure", («Слить строки записи» от ["  убывает аргумент ", («Число строкой» от «аргумент»), " ", («В ёлочках записи» от «имя аргумента»)]), («Слить строки записи» от ["  дно тип ", («В ёлочках записи» от «дно»)])]
  пусть «ряды витков» равно (свёртка «витки» начиная с пустой список как «акк» и «в» → («Соединить списки записи» от «акк» и («Строки витка структуры» от «имя» и «в»)))
  пусть «хвост» равно [(«Слить строки записи» от ["  самовызов строка ", («Число строкой» от «самовызов»)]), "  конец тотальности"]
  «Соединить списки записи» от («Соединить списки записи» от «заголовок» и «ряды витков») и «хвост»

// Блок тотальности шаговой рекурсии: заголовок, вид step, убывающий аргумент,
// дно (числовой отрезок с дном 0), по ОДНОЙ строке на виток (часть значения не
// называется — убывание доказывает тип), строка «мера не меньше 0 тип «T»» тем
// же типом, что и дно, одна строка «самовызов строка K», конец.
тотальная функция «Строки блока шага»
  принимает «имя»: строка, «строка»: число, «аргумент»: число, «имя аргумента»: строка, «дно»: строка, «витки»: список «Виток шага записи», «самовызов»: число
  возвращает список строки
  пусть «заголовок» равно [(«Заголовок блока тотальности» от «имя» и «строка»), "  вид step", («Слить строки записи» от ["  убывает аргумент ", («Число строкой» от «аргумент»), " ", («В ёлочках записи» от «имя аргумента»)]), («Слить строки записи» от ["  дно тип ", («В ёлочках записи» от «дно»)])]
  пусть «ряды витков» равно (отобразить «витки» как «в» → («Слить строки записи» от ["  виток строка ", («Число строкой» от («в».«строка»)), " ", («В ёлочках записи» от «имя»), " от ", («в».«аргтекст»)]))
  пусть «хвост» равно [(«Слить строки записи» от ["  мера не меньше 0 тип ", («В ёлочках записи» от «дно»)]), («Слить строки записи» от ["  самовызов строка ", («Число строкой» от «самовызов»)]), "  конец тотальности"]
  «Соединить списки записи» от («Соединить списки записи» от «заголовок» и «ряды витков») и «хвост»

// Блок тотальности одной функции — диспетчер по семье. Композиция раскладывается
// как прежде (формат тот же); structure/step — новые семьи ([Ш3+]). Примеры
// structure/step собраны БАЙТ-В-БАЙТ под golden «пробы/семьи/rec-structure.запись»
// и «rec-step.запись» (строки блока тотальности): это и есть доказательство
// контракта печати без реприпта.
тотальная функция «Строки блока тотальности»
  принимает «т»: «Тотальность записи»
  возвращает список строки
  обеспечивает «блок начинается словом тотальность» (элемент 1 в результат) начинается с "тотальность «"
  пример «Композиция, зовущая только примитив»
    дано «т» равно (вариант «Тотальность композиции» с «имя» равным "Сложить" и «строка» равным 12 и «вызовы» равным [(вариант «Зов примитива записи» с «имя» равным "плюс")])
    ожидается ["тотальность «Сложить» строка 12", "  вид composition", "  зовёт примитив «плюс»", "  самовызова нет", "  конец тотальности"]
  пример «Структурная рекурсия: блок совпадает с golden rec-structure»
    дано «т» равно (вариант «Тотальность структуры» с «имя» равным "Длина" и «строка» равным 16 и «аргумент» равным 1 и «имя аргумента» равным "сп" и «дно» равным "Числа" и «витки» равным [(запись «Виток структуры записи» с «строка» равным 23 и «аргтекст» равным "ост" и «имя части» равным "ост" и «поле» равным "дальше" и «вариант» равным "Ещё")] и «самовызов» равным 23)
    ожидается ["тотальность «Длина» строка 16", "  вид structure", "  убывает аргумент 1 «сп»", "  дно тип «Числа»", "  виток строка 23 «Длина» от ост", "    часть «ост» поле «дальше» варианта «Ещё»", "  самовызов строка 23", "  конец тотальности"]
  пример «Шаговая рекурсия: блок совпадает с golden rec-step»
    дано «т» равно (вариант «Тотальность шага» с «имя» равным "Отсчёт" и «строка» равным 10 и «аргумент» равным 1 и «имя аргумента» равным "н" и «дно» равным "нат" и «витки» равным [(запись «Виток шага записи» с «строка» равным 15 и «аргтекст» равным "(н минус 1)")] и «самовызов» равным 15)
    ожидается ["тотальность «Отсчёт» строка 10", "  вид step", "  убывает аргумент 1 «н»", "  дно тип «нат»", "  виток строка 15 «Отсчёт» от (н минус 1)", "  мера не меньше 0 тип «нат»", "  самовызов строка 15", "  конец тотальности"]
  разбор «т»
    случай вариант «Тотальность композиции» с «имя» как «имя» и «строка» как «строка» и «вызовы» как «вызовы»
      то «Строки блока композиции» от «имя» и «строка» и «вызовы»
    случай вариант «Тотальность структуры» с «имя» как «имя» и «строка» как «строка» и «аргумент» как «аргумент» и «имя аргумента» как «имя аргумента» и «дно» как «дно» и «витки» как «витки» и «самовызов» как «самовызов»
      то «Строки блока структуры» от «имя» и «строка» и «аргумент» и «имя аргумента» и «дно» и «витки» и «самовызов»
    случай вариант «Тотальность шага» с «имя» как «имя» и «строка» как «строка» и «аргумент» как «аргумент» и «имя аргумента» как «имя аргумента» и «дно» как «дно» и «витки» как «витки» и «самовызов» как «самовызов»
      то «Строки блока шага» от «имя» и «строка» и «аргумент» и «имя аргумента» и «дно» и «витки» и «самовызов»

// Секция целиком: блоки всех функций-композиций подряд, без пустых строк между
// ними. Пусто, если композиций нет, — тогда запись остаётся ПОБАЙТОВО прежней
// (секция появляется, только если тотальности есть); счёт блоков идёт в шапку
// строкой «тотальностей N», встающей на место пустой строки шапки.
тотальная функция «Строки тотальности записи»
  принимает «тотальности»: список «Тотальность записи»
  возвращает список строки
  обеспечивает «нет композиций — нет и строк» если пусто «тотальности» то пусто результат иначе да
  пример «Пусто на входе — пусто на выходе»
    дано «тотальности» равно пустой список
    ожидается пустой список
  пример «Демо спеки §5: Сложить раньше Удвоить — блоки совпадают с golden»
    дано «тотальности» равно [(вариант «Тотальность композиции» с «имя» равным "Сложить" и «строка» равным 12 и «вызовы» равным [(вариант «Зов примитива записи» с «имя» равным "плюс")]), (вариант «Тотальность композиции» с «имя» равным "Удвоить" и «строка» равным 17 и «вызовы» равным [(вариант «Зов функции записи» с «имя» равным "Сложить" и «строка» равным 12)])]
    ожидается ["тотальность «Сложить» строка 12", "  вид composition", "  зовёт примитив «плюс»", "  самовызова нет", "  конец тотальности", "тотальность «Удвоить» строка 17", "  вид composition", "  зовёт «Сложить» строка 12 тотальна", "  самовызова нет", "  конец тотальности"]
  свёртка «тотальности» начиная с пустой список как «акк» и «т» → («Соединить списки записи» от «акк» и («Строки блока тотальности» от «т»))

// Один виток структуры из узла обязательства: строка, текст довода и названная
// часть — теми же ключами, какими их кладёт `«Узел витка структуры»`.
тотальная функция «Виток структуры из узла»
  принимает «узел»: «Значение»
  возвращает «Виток структуры записи»
  запись «Виток структуры записи» с «строка» равным («Число узла» от («Взять поле» от «узел» и "line")) и «аргтекст» равным («Строка поля» от «узел» и "argtext") и «имя части» равным («Строка поля» от «узел» и "part") и «поле» равным («Строка поля» от «узел» и "field") и «вариант» равным («Строка поля» от «узел» и "variant")

// Один виток шага из узла обязательства: строка и текст довода.
тотальная функция «Виток шага из узла»
  принимает «узел»: «Значение»
  возвращает «Виток шага записи»
  запись «Виток шага записи» с «строка» равным («Число узла» от («Взять поле» от «узел» и "line")) и «аргтекст» равным («Строка поля» от «узел» и "argtext")

// Узел "totality" → «Тотальность записи» по полю "mode": structure/step несут
// полный свидетель ([Ш3+]), всё прочее (в том числе БЕЗ "mode") — composition
// как было. Разводит семьи ровно здесь; блок раскладывают «Строки блока …».
тотальная функция «Тотальность из узла»
  принимает «о»: «Значение»
  возвращает «Тотальность записи»
  пусть «вид» равно («Строка поля» от «о» и "mode")
  если «вид» равен "structure"
    то (вариант «Тотальность структуры» с «имя» равным («Строка поля» от «о» и "name") и «строка» равным («Строка узла записи» от «о») и «аргумент» равным («Число узла» от («Взять поле» от «о» и "arg")) и «имя аргумента» равным («Строка поля» от «о» и "argname") и «дно» равным («Строка поля» от «о» и "floor") и «витки» равным (отобразить («Элементы поля» от «о» и "loops") как «в» → («Виток структуры из узла» от «в»)) и «самовызов» равным («Число узла» от («Взять поле» от «о» и "selfcall")))
    иначе
      если «вид» равен "step"
        то (вариант «Тотальность шага» с «имя» равным («Строка поля» от «о» и "name") и «строка» равным («Строка узла записи» от «о») и «аргумент» равным («Число узла» от («Взять поле» от «о» и "arg")) и «имя аргумента» равным («Строка поля» от «о» и "argname") и «дно» равным («Строка поля» от «о» и "floor") и «витки» равным (отобразить («Элементы поля» от «о» и "loops") как «в» → («Виток шага из узла» от «в»)) и «самовызов» равным («Число узла» от («Взять поле» от «о» и "selfcall")))
        иначе (вариант «Тотальность композиции» с «имя» равным («Строка поля» от «о» и "name") и «строка» равным («Строка узла записи» от «о») и «вызовы» равным (отобразить («Элементы поля» от «о» и "calls") как «в» → (если («Строка поля» от «в» и "kind") равен "primitive" то (вариант «Зов примитива записи» с «имя» равным («Строка поля» от «в» и "name")) иначе (вариант «Зов функции записи» с «имя» равным («Строка поля» от «в» и "name") и «строка» равным («Строка узла записи» от «в»)))))

// СЕМЯ ДАННЫХ. Тотальности считает самоанализ — «Носители программы»/«Рекурсии
// программы» (carriers.flang). Сюда они приходят ГОТОВЫМИ обязательствами вида
// "totality" (наравне с "postcondition"/"measure", obligations.flang): у
// композиции поле "name" — имя F, "span" — её объявление, "calls" — список
// зовомых В ПОРЯДКЕ ТЕЛА; у рекурсии — "mode" (structure|step), "arg"/"argname"
// (убывающий довод), "floor" (дно), "loops" (витки), "selfcall". Печать их
// только читает и раскладывает. Пусто тотальностей — запись прежняя.
тотальная функция «Тотальности записи»
  принимает «обязательства»: список «Значение»
  возвращает список «Тотальность записи»
  обеспечивает «без обязательств тотальности — секции нет» если пусто «обязательства» то пусто результат иначе да
  пример «Обязательство вида totality разбирается в блок»
    дано «обязательства» равно [(вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "totality"))), (запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "Сложить"))), (запись «Поле значения» с «ключ» равным "span" и «значение» равным (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "line" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр число» с «значение» равным 12)))])), (запись «Поле значения» с «ключ» равным "calls" и «значение» равным (вариант «Значение списка» с «элементы» равным [(вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "kind" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "primitive"))), (запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "плюс")))])]))])]
    ожидается [(вариант «Тотальность композиции» с «имя» равным "Сложить" и «строка» равным 12 и «вызовы» равным [(вариант «Зов примитива записи» с «имя» равным "плюс")])]
  отобразить (отфильтровать «обязательства» где «к» → («Строка поля» от «к» и "kind") равен "totality") как «о» → («Тотальность из узла» от «о»)

функция «Запись доказательства»
  принимает «обязательства»: список «Значение», «путь»: строка, «текст»: строка, «ядро»: число
  возвращает строка
  обеспечивает «запись открывается шапкой» результат начинается с "запись доказательства "
  обеспечивает «запись закрывается словами конец записи» результат содержит "конец записи"
  пусть «свои» равно («Утверждения записи» от «обязательства»)
  // Секция тотальности-композиции ([Ш3]): её блоки в топологическом порядке.
  // Пусто, пока ядро не кладёт обязательств вида "totality" — тогда прежние
  // записи не меняются ни на байт.
  пусть «тотальности» равно («Тотальности записи» от «обязательства»)
  // Исходник разбирается на строки ОДИН раз и уезжает вниз: по номерам строк
  // из дерева читается тот же текст, который потом читает сверщик.
  пусть «строки исходника» равно (разделить «текст» по "\n")
  пусть «начало» равно («Соединить списки записи» от («Строки шапки» от «путь» и «текст» и «ядро» и (длина «свои») и (длина «тотальности»)) и («Строки оглавления записи» от («Таблицы записи» от «строки исходника»)))
  пусть «строки» равно (свёртка «свои» начиная с «начало» как «акк» и «о» → («Соединить списки записи» от «акк» и («Строки утверждения» от «о» и «строки исходника»)))
  // Секция вкладывается МЕЖДУ блоками утверждений и «конец записи»: у неё нет
  // ни пустой строки в начале, ни в конце, поэтому она встаёт вплотную к
  // «конец записи», как в golden.
  пусть «с тотальностью» равно («Соединить списки записи» от «строки» и («Строки тотальности записи» от «тотальности»))
  соединить («Соединить списки записи» от «с тотальностью» и ["конец записи", ""]) по "\n"
