  пусть «равны» равно (если «числа» то ((«лево».«число») равен («право».«число»)) иначе ((«лево».«текст») равен («право».«текст»)))
  если (не («лево».«есть»)) или (не («право».«есть»))
    то («Не берусь записи»)
    иначе
      если («отношение» равен " содержит ") или («отношение» равен " начинается с ")
        то (если «строки» то («Признак вычислителя записи» от (если «отношение» равен " содержит " то ((«лево».«текст») содержит («право».«текст»)) иначе ((«лево».«текст») начинается с («право».«текст»)))) иначе («Не берусь записи»))
        иначе
          если («отношение» равен " равен ") или («отношение» равен " не равен ")
            то (если ((«лево».«вид») равен («право».«вид»)) и притом (не ((«лево».«вид») равен "список")) то («Признак вычислителя записи» от (если «отношение» равен " равен " то «равны» иначе (не «равны»))) иначе («Не берусь записи»))
            иначе
              если «отношение» равен " и притом "
