  пример «Пустой документ — пустая таблица»
    дано текст равно ""
    ожидается вариант «Разобран toml» с значение равным (вариант «Таблица toml» с состав равным пустой список)
  пример «Документ из одних комментариев — пустая таблица»
    дано текст равно "# один\n  # два\n"
    ожидается вариант «Разобран toml» с значение равным (вариант «Таблица toml» с состав равным пустой список)
  пример «Таблица после своей подтаблицы объявляется законно»
    дано текст равно "[a.b]\nc = 1\n[a]\nd = 2\n"
    ожидается вариант «Разобран toml» с значение равным (вариант «Таблица toml» с состав равным [вариант «Пара toml» с имя равным "a" и содержимое равным (вариант «Таблица toml» с состав равным [вариант «Пара toml» с имя равным "d" и содержимое равным (вариант «Целое toml» с величина равным 2), вариант «Пара toml» с имя равным "b" и содержимое равным (вариант «Таблица toml» с состав равным [вариант «Пара toml» с имя равным "c" и содержимое равным (вариант «Целое toml» с величина равным 1)])])])
  пример «Незакрытая строка на первой строке»
    дано текст равно "name = \"abc"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Строка не закрыта») и строка равным 1
  пример «Таблица объявлена дважды: отказ на третьей строке с путём a»
    дано текст равно "[a]\nx = 1\n[a]\n"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Таблица объявлена дважды» с путь равным "a") и строка равным 3
  пример «Буква в числе — число записано неверно»
    дано текст равно "x = 12a"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Число записано неверно» с текст равным "12a") и строка равным 1
  пример «Две точки в числе — число записано неверно»
    дано текст равно "x = 1..2"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Число записано неверно» с текст равным "1..2") и строка равным 1
  пример «Нет знака равенства»
    дано текст равно "x 1"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Нет знака равенства») и строка равным 1
  пример «Ключ повторён на второй строке»
    дано текст равно "x = 1\nx = 2"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Ключ повторён» с имя равным "x") и строка равным 2
  пример «Массив не закрыт»
    дано текст равно "x = [1, 2"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Массив не закрыт») и строка равным 1
  пример «Скобка заголовка не закрыта»
    дано текст равно "[a"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Скобка заголовка не закрыта») и строка равным 1
  пример «Inline table вне подмножества: отказ с номером строки, а не тихая порча»
    дано текст равно "x = {a = 1}"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Синтаксис вне подмножества» с что равным "inline table") и строка равным 1
  пример «Массив таблиц [[имя]] вне подмножества: отказ с номером строки»
    дано текст равно "[[a]]"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Синтаксис вне подмножества» с что равным "массив таблиц [[имя]]") и строка равным 1
  пример «Дата вне подмножества: отказ назван границей подмножества, а не неверным числом»
    дано текст равно "x = 1979-05-27"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Синтаксис вне подмножества» с что равным "дата или время") и строка равным 1
  пример «Многострочная строка вне подмножества: отказ с номером строки»
    дано текст равно "a = 1\nx = \"\"\"abc\n\"\"\""
    ожидается вариант «Не разобран toml» с причина равным (вариант «Синтаксис вне подмножества» с что равным "многострочная строка") и строка равным 2
  пример «Экран юникода вне подмножества: отказ с номером строки»
    дано текст равно "x = \"\\u00e9\""
    ожидается вариант «Не разобран toml» с причина равным (вариант «Синтаксис вне подмножества» с что равным "экран \\u") и строка равным 1
  пример «Точечный ключ слева вне подмножества: отказ с номером строки»
    дано текст равно "[a]\nb.c = 1"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Синтаксис вне подмножества» с что равным "точечный ключ") и строка равным 2
  пример «tru — значение не опознано»
    дано текст равно "x = tru"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Значение не опознано» с текст равным "tru") и строка равным 1
  пример «Пустое значение — значение не опознано»
    дано текст равно "x = "
    ожидается вариант «Не разобран toml» с причина равным (вариант «Значение не опознано» с текст равным "") и строка равным 1
  пример «Ключ записан неверно»
    дано текст равно "a b = 1"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Ключ записан неверно» с текст равным "a b") и строка равным 1
  пример «Номер строки считает пустые строки и комментарии»
    дано текст равно "a = 1\n\n# заметка\nb = \"x"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Строка не закрыта») и строка равным 4
  пример «Заголовок поверх ключа — ключ повторён»
    дано текст равно "a = 1\n[a]"
    ожидается вариант «Не разобран toml» с причина равным (вариант «Ключ повторён» с имя равным "a") и строка равным 2
  пример «Переводы строк CRLF читаются как LF»
    дано текст равно "a = 1\r\nb = 'x'\r\n"
    ожидается вариант «Разобран toml» с значение равным (вариант «Таблица toml» с состав равным [вариант «Пара toml» с имя равным "a" и содержимое равным (вариант «Целое toml» с величина равным 1), вариант «Пара toml» с имя равным "b" и содержимое равным (вариант «Строка toml» с текст равным "x")])
  пусть ход равно свёртка (разделить текст по "\n") начиная с (вариант «Ход toml» с документ равным пустой список и путь равным пустой список и объявлены равным пустой список и номер равным 0 и беда равным (вариант «Беды нет toml»)) как прежний и строчка → «Шаг разбора toml» от прежний и строчка
  разбор ход
    случай вариант «Ход toml» с документ как документ и путь как путь и объявлены как объявлены и номер как номер и беда как беда
      то разбор беда
        случай вариант «Беда случилась toml» с причина как причина
          то вариант «Не разобран toml» с причина равным причина и строка равным номер
        случай вариант «Беды нет toml»
          то вариант «Разобран toml» с значение равным (вариант «Таблица toml» с состав равным документ)

тотальная функция «Значение по пути»
  принимает таблица: «Значение toml», путь: список строки
  возвращает «Возможное значение toml»
  обеспечивает «пустой путь даёт саму таблицу» (не ((длина путь) равен 0)) или (результат равен (вариант «Есть значение toml» с значение равным таблица))
  пример «Два шага вглубь»
    дано таблица равно вариант «Таблица toml» с состав равным [вариант «Пара toml» с имя равным "a" и содержимое равным (вариант «Таблица toml» с состав равным [вариант «Пара toml» с имя равным "b" и содержимое равным (вариант «Целое toml» с величина равным 1)])]
    дано путь равно ["a", "b"]
    ожидается вариант «Есть значение toml» с значение равным (вариант «Целое toml» с величина равным 1)
  пример «Пустой путь — сама таблица»
    дано таблица равно вариант «Таблица toml» с состав равным пустой список
    дано путь равно пустой список
    ожидается вариант «Есть значение toml» с значение равным (вариант «Таблица toml» с состав равным пустой список)
  пример «Путь сквозь целое — значения нет»
    дано таблица равно вариант «Таблица toml» с состав равным [вариант «Пара toml» с имя равным "a" и содержимое равным (вариант «Целое toml» с величина равным 1)]
    дано путь равно ["a", "b"]
    ожидается вариант «Нет значения toml»
  пример «Нет такого ключа — значения нет»
    дано таблица равно вариант «Таблица toml» с состав равным пустой список
    дано путь равно ["x"]
    ожидается вариант «Нет значения toml»
  разбор путь
    случай пусто
      то вариант «Есть значение toml» с значение равным таблица
    случай голова и хвост
      то разбор таблица
        случай вариант «Таблица toml» с состав как состав
          то разбор («Найти в таблице toml» от состав и голова)
            случай вариант «Есть значение toml» с значение как найденное
              то «Значение по пути» от найденное и хвост
            случай вариант «Нет значения toml»
              то вариант «Нет значения toml»
        случай любое
          то вариант «Нет значения toml»

тотальная функция «Значение по пути в тексте toml»
  принимает текст: строка, путь: список строки
  возвращает «Возможное значение toml»
  обеспечивает «неразобранный текст значения не даёт» разбор («Разобрать toml» от текст)
    случай вариант «Не разобран toml» с причина как причина и строка как номер
      то результат равен (вариант «Нет значения toml»)
    случай любое
      то да
  пример «title — строка TOML Example»
    дано текст равно "# Это TOML-документ\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Tom Preston-Werner\"\norganization = 'GitHub'\n\n[database]\nenabled = true\nports = [ 8000, 8001, 8002 ]\nconnection_max = 5_000\ntemperature = 79.5\n\n[servers]\n\n[servers.alpha]\nip = \"10.0.0.1\"\nrole = \"frontend\"\n\n[servers.beta]\nip = \"10.0.0.2\"\nrole = \"backend\"\n"
    дано путь равно ["title"]
    ожидается вариант «Есть значение toml» с значение равным (вариант «Строка toml» с текст равным "TOML Example")
  пример «database.connection_max — целое 5000»
    дано текст равно "# Это TOML-документ\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Tom Preston-Werner\"\norganization = 'GitHub'\n\n[database]\nenabled = true\nports = [ 8000, 8001, 8002 ]\nconnection_max = 5_000\ntemperature = 79.5\n\n[servers]\n\n[servers.alpha]\nip = \"10.0.0.1\"\nrole = \"frontend\"\n\n[servers.beta]\nip = \"10.0.0.2\"\nrole = \"backend\"\n"
    дано путь равно ["database", "connection_max"]
    ожидается вариант «Есть значение toml» с значение равным (вариант «Целое toml» с величина равным 5000)
  пример «database.temperature — вещественное 79.5»
    дано текст равно "# Это TOML-документ\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Tom Preston-Werner\"\norganization = 'GitHub'\n\n[database]\nenabled = true\nports = [ 8000, 8001, 8002 ]\nconnection_max = 5_000\ntemperature = 79.5\n\n[servers]\n\n[servers.alpha]\nip = \"10.0.0.1\"\nrole = \"frontend\"\n\n[servers.beta]\nip = \"10.0.0.2\"\nrole = \"backend\"\n"
    дано путь равно ["database", "temperature"]
    ожидается вариант «Есть значение toml» с значение равным (вариант «Вещественное toml» с величина равным 79.5)
  пример «database.enabled — признак да»
    дано текст равно "# Это TOML-документ\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Tom Preston-Werner\"\norganization = 'GitHub'\n\n[database]\nenabled = true\nports = [ 8000, 8001, 8002 ]\nconnection_max = 5_000\ntemperature = 79.5\n\n[servers]\n\n[servers.alpha]\nip = \"10.0.0.1\"\nrole = \"frontend\"\n\n[servers.beta]\nip = \"10.0.0.2\"\nrole = \"backend\"\n"
    дано путь равно ["database", "enabled"]
    ожидается вариант «Есть значение toml» с значение равным (вариант «Признак toml» с истина равным да)
  пример «database.ports — массив трёх целых»
    дано текст равно "# Это TOML-документ\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Tom Preston-Werner\"\norganization = 'GitHub'\n\n[database]\nenabled = true\nports = [ 8000, 8001, 8002 ]\nconnection_max = 5_000\ntemperature = 79.5\n\n[servers]\n\n[servers.alpha]\nip = \"10.0.0.1\"\nrole = \"frontend\"\n\n[servers.beta]\nip = \"10.0.0.2\"\nrole = \"backend\"\n"
    дано путь равно ["database", "ports"]
    ожидается вариант «Есть значение toml» с значение равным (вариант «Массив toml» с элементы равным [вариант «Целое toml» с величина равным 8000, вариант «Целое toml» с величина равным 8001, вариант «Целое toml» с величина равным 8002])
  пример «servers.beta.role — backend»
    дано текст равно "# Это TOML-документ\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Tom Preston-Werner\"\norganization = 'GitHub'\n\n[database]\nenabled = true\nports = [ 8000, 8001, 8002 ]\nconnection_max = 5_000\ntemperature = 79.5\n\n[servers]\n\n[servers.alpha]\nip = \"10.0.0.1\"\nrole = \"frontend\"\n\n[servers.beta]\nip = \"10.0.0.2\"\nrole = \"backend\"\n"
    дано путь равно ["servers", "beta", "role"]
    ожидается вариант «Есть значение toml» с значение равным (вариант «Строка toml» с текст равным "backend")
  пример «Испорченный текст — значения нет»
    дано текст равно "x = tru"
    дано путь равно ["x"]
    ожидается вариант «Нет значения toml»
  разбор («Разобрать toml» от текст)
    случай вариант «Разобран toml» с значение как документ
      то «Значение по пути» от документ и путь
    случай вариант «Не разобран toml» с причина как причина и строка как номер
      то вариант «Нет значения toml»
