модуль «Проверка множества отказов»
  использует «Множество отказов процесса» из "../self/failures.flang"
  использует «Печать JSON» из "../core/json.flang"

тотальная функция «Вердикт отказов»
  принимает «имя»: строка, «сошлось»: признак
  возвращает строка
  пример «Сошлось»
    дано «имя» равно "коды: видов ровно одиннадцать"
    дано «сошлось» равно да
    ожидается "коды: видов ровно одиннадцать — да"
  пример «Не сошлось»
    дано «имя» равно "коды: видов ровно одиннадцать"
    дано «сошлось» равно нет
    ожидается "коды: видов ровно одиннадцать — НЕТ"
  если «сошлось»
    то соединить «имя» с " — да"
    иначе соединить «имя» с " — НЕТ"

тотальная функция «Узел с запасом»
  возвращает «Значение»
  пример «у узла с запасом поле budget не ничто»
    ожидается (вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "budget" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр число» с «значение» равным 2000)))])
  вариант «Значение записи» с «поля» равным [(запись «Поле значения» с «ключ» равным "budget" и «значение» равным (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр число» с «значение» равным 2000)))]

тотальная функция «Пустой узел отказов»
  возвращает «Значение»
  пример «пустая запись»
    ожидается (вариант «Значение записи» с «поля» равным пустой список)
  вариант «Значение записи» с «поля» равным пустой список

тотальная функция «Вид первого отказа»
  принимает «отказы»: список «Запись отказа»
  возвращает строка
  обеспечивает «у пустого списка вида нет» если пусто «отказы» то результат равен "" иначе да
  пример «у пустого списка вида нет»
    дано «отказы» равно пустой список
    ожидается ""
  разбор «отказы»
    случай пусто
      то ""
    случай голова «первое» и хвост «остальное»
      то «первое».«вид»

тотальная функция «Ведомость отказов процесса»
  возвращает список строки
  [
    «Вердикт отказов» от "коды: видов отказа ровно одиннадцать" и ((длина («Коды отказа»)) равно 11),
    «Вердикт отказов» от "коды: каждый код начинается с FLANG_" и (пусто (отфильтровать («Коды отказа») где «пара» → не ((«пара».«код») начинается с "FLANG_"))),
    «Вердикт отказов» от "коды: FLANG_MEMORY в замкнутое множество НЕ входит" и (пусто (отфильтровать («Коды отказа») где «пара» → («пара».«код») равен "FLANG_MEMORY")),
    «Вердикт отказов» от "коды: FLANG_INTERNAL видом отказа не считается" и (пусто (отфильтровать («Коды отказа») где «пара» → («пара».«код») равен "FLANG_INTERNAL")),
    «Вердикт отказов» от "коды: запас витков назван кодом FLANG_BUDGET_EXHAUSTED" и (не (пусто (отфильтровать («Коды отказа») где «пара» → ((«пара».«вид») равен («Вид запас»)) и притом ((«пара».«код») равен "FLANG_BUDGET_EXHAUSTED")))),
    «Вердикт отказов» от "коды: потерянная связь названа кодом «Код связи», а не литералом" и (не (пусто (отфильтровать («Коды отказа») где «пара» → ((«пара».«вид») равен («Вид связь»)) и притом ((«пара».«код») равен («Код связи»))))),

    «Вердикт отказов» от "начальное: код отказа начального состояния — FLANG_INITIAL_FAILURE" и ((«Код начального») равно "FLANG_INITIAL_FAILURE"),
    «Вердикт отказов» от "связь: код потерянной связи — FLANG_LINK_DOWN" и ((«Код связи») равно "FLANG_LINK_DOWN"),

    «Вердикт отказов» от "пределы: глубина режет раньше витков" и ((«Предел глубины обработчика») меньше («Предел витков обработчика»)),

    «Вердикт отказов» от "тотальность: в пустом списке тотальных никого нет" и (не («Тотальна ли» от пустой список и "Шаг")),
    «Вердикт отказов» от "тотальность: своё имя в списке находится" и («Тотальна ли» от ["Шаг"] и "Шаг"),

    «Вердикт отказов» от "запас: у тотального обработчика запаса не отнимают" и (пусто («Отказ запаса» от («Узел с запасом») и "Шаг" и да)),
    «Вердикт отказов» от "запас: нетотальный обработчик с запасом даёт ровно один отказ" и ((длина («Отказ запаса» от («Узел с запасом») и "Шаг" и нет)) равно 1),
    «Вердикт отказов» от "запас: и отказ этот вида «запас витков»" и ((«Вид первого отказа» от («Отказ запаса» от («Узел с запасом») и "Шаг" и нет)) равно («Вид запас»)),
    «Вердикт отказов» от "запас: без поля budget нетотальный обработчик отказа не даёт" и (пусто («Отказ запаса» от («Пустой узел отказов») и "Шаг" и нет)),

    «Вердикт отказов» от "предел: у нетотального обработчика предела планировщика нет" и (пусто («Отказ предела» от («Пустой узел отказов») и "Шаг" и нет и («Пустой узел отказов»))),

    «Вердикт отказов» от "связь: у программы без процессов отказов связи нет" и (пусто («Отказы связи таблицей» от («Пустой узел отказов») и («Пустой узел отказов»))),
    «Вердикт отказов» от "связь: у размещения без узлов несущих нет" и (пусто («Несущие узлы» от пустой список))
  ]
