модуль «Toolchain guard»
  использует «JSON» из "../stdlib/json.flang"
  использует «Strings» из "../stdlib/strings.flang"
  использует «Lists» из "../stdlib/lists.flang"

// Перенос «flang/test/toolchain-guard.mjs» (обвязка Ч385, задача 9960): что
// делать, когда тулчейна целевого языка нет — пропустить тест честно, или
// потребовать его правилом FTS_REQUIRE_TOOLCHAINS, и где ещё искать компилятор
// кроме PATH.
//
// ГРАНИЦА ВЫЗОВА. Три вещи здесь — чистые функции над уже прочитанными
// строками (переменные среды читает ХОЗЯИН — JS-обвязка или тест, — а не этот
// файл: поручения «Прочитать переменную среды» и «Прочитать доводы» в словаре
// языка ЕСТЬ, но нынешний двоичный `bootstrap/flang` их не реализует ни
// одного — проверено прогоном, отвечает «Сбой» кодом FLANG_IO_UNKNOWN; так
// писать на них было бы миной, а не обвязкой):
//
//   «Токены тулчейнов»              значение FTS_REQUIRE_TOOLCHAINS → список
//   «Тулчейн обязателен ли»         то же значение + id цели → да/нет
//   «Домашние каталоги бинарников»  FTS_TOOLCHAIN_PATH + $HOME → список путей
//
// «Найти исполняемый» — тот случай, где реально нужен мир (проверка, есть ли
// файл): план «Найти исполняемый», вход.json = {"имя": "…", "каталоги":
// [PATH-каталоги, затем extra, в этом порядке]}. Существование проверяется
// НЕ чтением файла, а тем, есть ли «имя» среди имён, которые отдаёт
// «Перечислить каталог» для очередного каталога-кандидата: отдельного
// поручения «есть ли файл» в словаре нет, а читать СОДЕРЖИМОЕ кандидата ради
// одной проверки — путь, испробованный и отвергнутый ЗДЕСЬ ЖЕ прогоном:
// «Прочитать октеты из файла» на `/usr/local/bin/node` (205 380 840 байт)
// означало бы построить список из 205 миллионов чисел ради да/нет, и первая
// же настоящая проверка `findExecutable("node")` встала на этом намертво —
// не медленно, а не отвечая вовсе в разумное время. Перечисление каталога,
// где исполняемых от силы десятки, стоит на порядки дешевле независимо от
// размера самих файлов.
//
// Судьбу «тест пропущен или упал» (missingToolchain: assert.fail/t.skip)
// оставляем в JS-обвязке НАРОЧНО: она зовёт `node:test`, которого этот язык
// не знает и не обязан знать. Флаг-решение «обязателен ли этот id» здесь,
// текст сообщения и вызов `t.skip`/`assert.fail` — там.

// ── «1»/«all»/«true»/«yes» — синонимы «обязательны все бэкенды» ────────────

тотальная функция «Это ключевое слово „всё“»
  принимает токен: строка
  возвращает признак
  пример «all»
    дано токен равно "all"
    ожидается да
  пример «1»
    дано токен равно "1"
    ожидается да
  пример «Имя цели — не ключевое слово»
    дано токен равно "rust"
    ожидается нет
  (токен равен "1") или ((токен равен "all") или ((токен равен "true") или (токен равен "yes")))

// Разбор значения FTS_REQUIRE_TOOLCHAINS: запятые и пробелы — один разделитель
// (как у оригинала `/[,\s]+/u`, за вычетом табов и переводов строк — их в
// значении переменной окружения этого рода не бывает на практике, а форма
// строкового литерала языка не даёт вписать их знаком), регистр не важен,
// пустые куски отбрасываются.
тотальная функция «Токены тулчейнов»
  принимает значение: строка
  возвращает список строки
  пример «Список через запятую, пробелы, регистр, пустые куски»
    дано значение равно " Rust,  GO ,,"
    ожидается ["rust", "go"]
  пример «Пусто»
    дано значение равно ""
    ожидается пустой список
  пример «Одно имя»
    дано значение равно "rust"
    ожидается ["rust"]
  отфильтровать (отобразить (разделить («Заменить» от значение и "," и " ") по " ") как исходный → («Обрезать пробелы» от («В нижний регистр» от исходный))) где очищенный → не (очищенный равен "")

// Обязан ли тулчейн бэкенда «идентификатор» быть в системе.
тотальная функция «Тулчейн обязателен ли»
  принимает значение: строка, идентификатор: строка
  возвращает признак
  пример «„all“ требует все»
    дано значение равно "all"
    дано идентификатор равно "rust"
    ожидается да
  пример «Назван по имени»
    дано значение равно "rust,go"
    дано идентификатор равно "go"
    ожидается да
  пример «Назван по имени в другом регистре»
    дано значение равно "Go"
    дано идентификатор равно "go"
    ожидается да
  пример «Не назван и не ключевое слово — не обязателен»
    дано значение равно "rust"
    дано идентификатор равно "go"
    ожидается нет
  пример «Переменная не задана»
    дано значение равно ""
    дано идентификатор равно "go"
    ожидается нет
  пусть токены равно («Токены тулчейнов» от значение)
  пусть свой равно («В нижний регистр» от идентификатор)
  свёртка токены начиная с нет как найдено и токен → если найдено то да иначе (если («Это ключевое слово „всё“» от токен) то да иначе (токен равен свой))

// ── куда ещё смотреть, кроме PATH ───────────────────────────────────────────

тотальная функция «Домашние каталоги бинарников»
  принимает путьТулчейнов: строка, домашний: строка
  возвращает список строки
  пример «С домашним каталогом и явно заданными»
    дано путьТулчейнов равно "/a:/b"
    дано домашний равно "/home/m"
    ожидается ["/a", "/b", "/home/m/.local/bin", "/home/m/go/bin", "/usr/local/go/bin", "/usr/lib/jvm/default/bin", "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin"]
  пример «Без домашнего каталога и без явно заданных»
    дано путьТулчейнов равно ""
    дано домашний равно ""
    ожидается ["/usr/local/go/bin", "/usr/lib/jvm/default/bin", "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin"]
  пусть явные равно (отфильтровать (разделить путьТулчейнов по ":") где кандидат → не (кандидат равен ""))
  пусть изДома равно (если домашний равен "" то пустой список иначе [(соединить домашний с "/.local/bin"), (соединить домашний с "/go/bin")])
  пусть стандартные равно ["/usr/local/go/bin", "/usr/lib/jvm/default/bin", "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin"]
  «Соединить списки» от («Соединить списки» от явные и изДома) и стандартные

// ── план: пробует кандидатов по очереди, первый прочитавшийся — победитель ─
//
// вход.json — ПРЯМО список путей-кандидатов (JSON-массив строк), уже
// собранный обвязкой: PATH-каталоги × имя, затем extra-каталоги × имя, в этом
// порядке, — то же самое, что делали два цикла for оригинала.

тип «Итог поиска»
  вариант «Итог поиска» содержит найдено: признак, путь: строка

// Ждём отклик на «Перечислить каталог», а не на чтение файла: словарь
// поручений не даёт отдельного «есть ли файл», а читать СОДЕРЖИМОЕ ради
// одного этого — дорого до неприемлемости на настоящих исполняемых файлах.
// Замерено на этом дереве: `/usr/local/bin/node` весит 205 380 840 байт, и
// «Прочитать октеты из файла» превратил бы его в СПИСОК из 205 миллионов
// чисел — первая же настоящая проверка `findExecutable("node")` вставала на
// это намертво. Каталог, где исполняемых от силы десятки, стоит на порядки
// дешевле: существование проверяется тем, есть ли искомое ИМЯ в списке имён
// каталога, который его содержит.
тип «Ход поиска»
  вариант «Читаем вход»
  вариант «Ждём список» содержит имя: строка, текущий: строка, очередь: список строки

функция «Найти поле входа»
  принимает состав: список «Поле json», имя: строка
  возвращает «Значение json»
  разбор состав
    случай пусто
      то вариант «Ничто json»
    случай голова п и хвост дальше
      то если («Имя поля json» от п) равен имя
        то «Содержимое поля json» от п
        иначе «Найти поле входа» от дальше и имя

тотальная функция «Текст значения json»
  принимает значение: «Значение json»
  возвращает строка
  пример «Текст своим текстом»
    дано значение равно вариант «Текст json» с текст равным "x"
    ожидается "x"
  пример «Не текст — пусто»
    дано значение равно вариант «Число json» с величина равным 1
    ожидается ""
  разбор значение
    случай вариант «Текст json» с текст как т
      то т
    случай любое
      то ""

функция «Текст поля входа»
  принимает состав: список «Поле json», имя: строка
  возвращает строка
  «Текст значения json» от («Найти поле входа» от состав и имя)

функция «Список строк поля входа»
  принимает состав: список «Поле json», имя: строка
  возвращает список строки
  разбор («Найти поле входа» от состав и имя)
    случай вариант «Массив json» с элементы как эл
      то отобразить эл как е → («Текст значения json» от е)
    случай любое
      то пустой список

функция «Начать поиск»
  возвращает «Ход поиска»
  вариант «Читаем вход»

// Продолжение по остатку очереди каталогов: пусто — не нашли нигде; иначе —
// просим перечислить голову и переходим ждать её отклик.
функция «Продолжить поиск»
  принимает имя: строка, очередь: список строки
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то вариант «Конец работы» с значение равным (вариант «Итог поиска» с найдено равным нет и путь равным "")
    случай голова каталог и хвост дальше
      то вариант «Сделать» с поручение равным (вариант «Перечислить каталог» с путь равным каталог) и потом равным (вариант «Ждём список» с имя равным имя и текущий равным каталог и очередь равным дальше)

функция «Шаг поиска»
  принимает ход: «Ход поиска», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Читаем вход»
      то разбор отклик
        случай вариант «Пока ничего»
          то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "вход.json") и потом равным (вариант «Читаем вход»)
        случай вариант «Прочитано» с содержимое как текст
          то разбор («Разобрать json» от текст)
            случай вариант «Не разобран json» с причина как причинаОтказа
              то вариант «Провал» с код равным "FLANG_TOOLCHAIN_INPUT" и сообщение равным причинаОтказа
            случай вариант «Разобран json» с значение как корень
              то разбор корень
                случай вариант «Объект json» с состав как составВхода
                  то «Продолжить поиск» от («Текст поля входа» от составВхода и "имя") и («Список строк поля входа» от составВхода и "каталоги")
                случай любое
                  то вариант «Провал» с код равным "FLANG_TOOLCHAIN_INPUT" и сообщение равным "вход.json обязан быть объектом с полями «имя» и «каталоги»"
        случай вариант «Сбой» с код как кодСбоя и сообщение как сообщениеСбоя
          то вариант «Провал» с код равным кодСбоя и сообщение равным сообщениеСбоя
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали содержимое вход.json"
    случай вариант «Ждём список» с имя как имя и текущий как тек и очередь как оч
      то разбор отклик
        случай вариант «Перечислено» с имена как имена
          то если имена содержит имя
            то вариант «Конец работы» с значение равным (вариант «Итог поиска» с найдено равным да и путь равным («Соединить строки» от [тек, имя] и "/"))
            иначе «Продолжить поиск» от имя и оч
        случай любое
          то «Продолжить поиск» от имя и оч

план «Найти исполняемый»
  состояние «Ход поиска»
  начинает с «Начать поиск»
  обрабатывает «Шаг поиска»
