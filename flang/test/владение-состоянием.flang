модуль «Проверка владения состоянием»
  использует «Проверка процессов» из "../self/processes.flang"
  использует «Проверка типов» из "../self/types.flang"
  использует «Печать JSON» из "../core/json.flang"

тотальная функция «Вердикт владения»
  принимает «имя»: строка, «сошлось»: признак
  возвращает строка
  пример «Сошлось»
    дано «имя» равно "владение: честному обработчику жалобы нет"
    дано «сошлось» равно да
    ожидается "владение: честному обработчику жалобы нет — да"
  пример «Не сошлось»
    дано «имя» равно "владение: честному обработчику жалобы нет"
    дано «сошлось» равно нет
    ожидается "владение: честному обработчику жалобы нет — НЕТ"
  если «сошлось»
    то соединить «имя» с " — да"
    иначе соединить «имя» с " — НЕТ"

тотальная функция «Строкой»
  принимает «текст»: строка
  возвращает «Значение»
  пример «строка становится скаляром»
    дано «текст» равно "С"
    ожидается (вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным "С"))
  вариант «Значение скаляра» с «скаляр» равным (вариант «Скаляр строка» с «значение» равным «текст»)

тотальная функция «Полем»
  принимает «ключ»: строка, «значение»: «Значение»
  возвращает «Поле значения»
  пример «поле несёт ключ и значение»
    дано «ключ» равно "name"
    дано «значение» равно (вариант «Значение записи» с «поля» равным пустой список)
    ожидается (запись «Поле значения» с «ключ» равным "name" и «значение» равным (вариант «Значение записи» с «поля» равным пустой список))
  запись «Поле значения» с «ключ» равным «ключ» и «значение» равным «значение»

тотальная функция «Записью»
  принимает «поля»: список «Поле значения»
  возвращает «Значение»
  пример «запись без полей»
    дано «поля» равно пустой список
    ожидается (вариант «Значение записи» с «поля» равным пустой список)
  вариант «Значение записи» с «поля» равным «поля»

тотальная функция «Списком»
  принимает «элементы»: список «Значение»
  возвращает «Значение»
  пример «список без элементов»
    дано «элементы» равно пустой список
    ожидается (вариант «Значение списка» с «элементы» равным пустой список)
  вариант «Значение списка» с «элементы» равным «элементы»

тотальная функция «Процессом»
  принимает «имя»: строка, «состояние»: строка, «принимаемое»: строка, «обработчик»: строка
  возвращает «Значение»
  «Записью» от [(«Полем» от "name" и («Строкой» от «имя»)), («Полем» от "state" и («Строкой» от «состояние»)), («Полем» от "accepts" и («Строкой» от «принимаемое»)), («Полем» от "handler" и («Строкой» от «обработчик»))]

тотальная функция «Доводом»
  принимает «тип»: строка
  возвращает «Значение»
  «Записью» от [(«Полем» от "type" и («Записью» от [(«Полем» от "name" и («Строкой» от «тип»))]))]

тотальная функция «Функцией»
  принимает «имя»: строка, «доводы»: список «Значение»
  возвращает «Значение»
  «Записью» от [(«Полем» от "name" и («Строкой» от «имя»)), («Полем» от "params" и («Списком» от «доводы»))]

тотальная функция «Первая жалоба»
  принимает «беды»: список «Беда»
  возвращает строка
  пример «у пустого списка жалобы нет»
    дано «беды» равно пустой список
    ожидается ""
  разбор «беды»
    случай пусто
      то ""
    случай голова «первая» и хвост «остальные»
      то «первая».«сообщение»

тотальная функция «Работник»
  возвращает список «Значение»
  [(«Процессом» от "Работник" и "С" и "Т" и "шаг")]

тотальная функция «Своё состояние»
  возвращает список «Значение»
  [(«Функцией» от "шаг" и [(«Доводом» от "С"), («Доводом» от "Т")])]

тотальная функция «Чужое состояние»
  возвращает список «Значение»
  [(«Функцией» от "шаг" и [(«Доводом» от "Д"), («Доводом» от "Т")])]

тотальная функция «Третий довод»
  возвращает список «Значение»
  [(«Функцией» от "шаг" и [(«Доводом» от "С"), («Доводом» от "С"), («Доводом» от "Т")])]

тотальная функция «Чужое письмо»
  возвращает список «Значение»
  [(«Функцией» от "шаг" и [(«Доводом» от "С"), («Доводом» от "У")])]

тотальная функция «Ведомость владения состоянием»
  возвращает список строки
  [
    «Вердикт владения» от "владение: честному обработчику жалобы нет" и (пусто («Беды владения» от («Работник») и («Своё состояние») и пустой список)),
    «Вердикт владения» от "владение: чужое состояние даёт ровно одну жалобу" и ((длина («Беды владения» от («Работник») и («Чужое состояние») и пустой список)) равно 1),
    «Вердикт владения» от "владение: жалоба называет чужой тип и объявленное состояние" и ((«Первая жалоба» от («Беды владения» от («Работник») и («Чужое состояние») и пустой список)) равно "обработчик «шаг» процесса «Работник» принимает первым доводом «Д», а состояние процесса объявлено «С»: чужого состояния обработчик не принимает"),
    «Вердикт владения» от "владение: третий довод даёт ровно одну жалобу" и ((длина («Беды владения» от («Работник») и («Третий довод») и пустой список)) равно 1),
    «Вердикт владения» от "владение: чужой тип письма даёт ровно одну жалобу" и ((длина («Беды владения» от («Работник») и («Чужое письмо») и пустой список)) равно 1),
    «Вердикт владения» от "владение: ненайденному обработчику жалобы нет" и (пусто («Беды владения» от («Работник») и пустой список и пустой список))
  ]
