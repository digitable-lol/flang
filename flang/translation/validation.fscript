модуль «Translation validation»
  использует «Rules» из "../../scripts/rules.fscript"
  использует «Inquiry» из "../../scripts/inquiry.fscript"
  использует «Reading» из "../../scripts/reading.fscript"
  использует «Tables» из "../../scripts/tables.fscript"
  использует «Lists» только «Соединить списки»

объект «Row»
  «unit»: строка
  «function»: строка
  «class»: строка
  «reference»: строка
  «answer»: строка

объект «Summary»
  «unit»: строка
  «function»: строка
  «class»: строка
  «compared»: число
  «agreed»: число
  «skipped»: число
  «reason»: строка
  «differ»: список строки

объект «Count»
  «reason»: строка
  «count»: число

объект «Forgery»
  «name»: строка
  «unit»: строка
  «file»: строка
  «original»: строка
  «forged»: строка
  «function»: строка

тотальная функция «Forgery of»
  принимает name: строка, unit: строка, file: строка, original: строка, forged: строка, target: строка
  возвращает «Forgery»
  пример «A forgery names the unit, the printed file, the edit and the function it must break»
    дано name равно "sign"
    дано unit равно "precondition"
    дано file равно "preduslovie.c"
    дано original равно "+"
    дано forged равно "-"
    дано target равно "Удвоить"
    ожидается (запись «Forgery» с «name» равным "sign" и «unit» равным "precondition" и «file» равным "preduslovie.c"
        и «original» равным "+" и «forged» равным "-" и «function» равным "Удвоить")
  (запись «Forgery» с «name» равным name и «unit» равным unit и «file» равным file и «original» равным original
      и «forged» равным forged и «function» равным target)

тотальная функция «Forgeries»
  возвращает список «Forgery»
  обеспечивает «eight forgeries» (длина результат) равен 8
  ([(«Forgery of» от "operation sign" и "flang-proof-examples-precondition" и "preduslovie.c"
      и "n.as.number + n.as.number" и "n.as.number - n.as.number" и "Удвоить"),
    («Forgery of» от "branch literal" и "flang-proof-examples-traffic-light" и "svetofor.c" и "fl_number(500.0)"
      и "fl_number(501.0)" и "Штраф"),
    («Forgery of» от "precondition bound" и "flang-proof-examples-precondition" и "preduslovie.c"
      и "args[0].as.number >= 0.0), \"вход" и "args[0].as.number > 0.0), \"вход" и "Удвоить"),
    («Forgery of» от "recursion step" и "flang-proof-examples-precondition" и "preduslovie.c"
      и "fl_t1.as.number + 1.0" и "fl_t1.as.number + 2.0" и "Высота от дна"),
    («Forgery of» от "text constant" и "flang-proof-examples-corpus-alphabet" и "alfavit_leksera.c"
      и "{\"abcdefg" и "{\"abcdefq" и "Строчные"),
    («Forgery of» от "swapped operands" и "flang-proof-examples-precondition" и "preduslovie.c"
      и "shirina.as.number - dlina.as.number" и "dlina.as.number - shirina.as.number" и "Сколько дополнить"),
    («Forgery of» от "hidden point" и "flang-proof-examples-precondition" и "preduslovie.c"
      и "fl_flag(fl_t2.as.number >= 0.0)" и "fl_flag(fl_t2.as.number >= 0.0 && fl_t2.as.number != 777.0)"
      и "Сколько дополнить"),
    («Forgery of» от "bound inside a sum" и "docs-examples-pythagoras-euclid-formula" и "formula_evklida.c"
      и "<= 94906265.0), \"тройка укладывается в точность\", \"Гипотенуза\""
      и "< 94906265.0), \"тройка укладывается в точность\", \"Гипотенуза\"" и "Гипотенуза")])

тотальная функция «Specification»
  принимает forgery: «Forgery»
  возвращает строка
  пример «Six fields joined by a bar»
    дано forgery равно (запись «Forgery» с «name» равным "a" и «unit» равным "b" и «file» равным "c.c"
        и «original» равным "x" и «forged» равным "y" и «function» равным "Ф")
    ожидается "a|b|c.c|x|y|Ф"
  соединить [(forgery.«name»), (forgery.«unit»), (forgery.«file»), (forgery.«original»), (forgery.«forged»),
      (forgery.«function»)] по "|"

тотальная функция «Corpus»
  принимает answers: список «Answer»
  возвращает список строки
  пример «By default the proof examples and the Pythagoras examples»
    дано answers равно пустой список
    ожидается ["flang/proof/examples", "docs/examples/pythagoras"]
  пример «With --all every example of the documentation»
    дано answers равно [(запись «Answer» с «name» равным "arguments"
        и «reply» равным (вариант «Доводы» с доводы равным ["--all"]))]
    ожидается ["flang/proof/examples", "docs/examples"]
  если («Given of» от "arguments" и answers) содержит "--all"
    то ["flang/proof/examples", "docs/examples"]
    иначе ["flang/proof/examples", "docs/examples/pythagoras"]

тотальная функция «Modules»
  возвращает список строки
  пример «The reference and the validator are five Lean modules»
    ожидается ["Binary64", "Semantics/Eval", "Semantics/Json", "Semantics/Symbolic", "Semantics/Validate"]
  ["Binary64", "Semantics/Eval", "Semantics/Json", "Semantics/Symbolic", "Semantics/Validate"]

тотальная функция «Whole corpus program»
  возвращает строка
  обеспечивает «the program has twenty-two lines» (длина (разделить результат по "\n")) равен 22
  соединить ["W=$0; B=$1; shift 1",
      "case $B in /*) ;; *) B=$PWD/$B;; esac",
      "cd ../.. || exit 1",
      "say() { printf '%s\\t%s\\t%s\\t%s\\t\\n' \"$1\" \"$2\" \"$3\" \"$4\"; }",
      "for g in \"$@\"; do find \"$g\" -name '*.flang' | LC_ALL=C sort; done | while read -r f; do",
      "u=${f%.flang}; d=$W/c/$(printf '%s' \"$u\" | tr '/' '-'); [ -d \"$d\" ] && continue; mkdir -p \"$d\"",
      "timeout 120 \"$B\" ast \"$f\" > \"$d/ast.json\" 2>/dev/null ||",
      "{ say \"$u\" \"\" \"не прочитано\" \"$?\"; continue; }",
      "timeout 300 \"$B\" emit \"$f\" --target c --out \"$d\" > /dev/null 2>&1 ||",
      "{ say \"$u\" \"\" \"не напечатано\" \"$?\"; continue; }",
      "timeout 300 \"$B\" check --proof --json \"$f\" > \"$d/proof.json\" 2>/dev/null",
      "(cd \"$d\" && cc -std=c99 -O2 -o run *.c -lm -lpthread > cc.log 2>&1) ||",
      "{ say \"$u\" \"\" \"не собрано\" \"\"; continue; }",
      "cat $(ls \"$d\"/*.c | grep -v '/flang_') > \"$d/module.txt\"",
      "timeout 600 \"$W/validate\" plan \"$d/ast.json\" \"$d/module.txt\" \"$d/proof.json\" \\",
      "> \"$d/plan.tsv\" || { say \"$u\" \"\" \"эталон не уложился\" \"$?\"; continue; }",
      "cut -f3 \"$d/plan.tsv\" | grep -a '^{' | timeout 600 \"$d/run\" --json > \"$d/c.jsonl\"",
      "timeout 600 \"$W/validate\" canon \"$d/c.jsonl\" > \"$d/c.txt\"",
      "awk -F'\\t' -v OFS='\\t' -v b=\"$u\" -v c=\"$d/c.txt\" '",
      "$2==\"вне\" || $2==\"символ\" {print b, $1, $2, $3, $4; next}",
      "{x=\"\"; getline x < c; print b, $1, $2, $4, x}' \"$d/plan.tsv\"",
      "done"] по "\n"

тотальная функция «Forgery program»
  возвращает строка
  обеспечивает «the program has twenty lines» (длина (разделить результат по "\n")) равен 20
  соединить ["W=$0", "cd ../.. || exit 1",
      "say() { printf '%s\\t%s\\t%s\\t\\t\\n' \"$1\" \"$2\" \"$3\"; }",
      "mkdir -p \"$W/f\"",
      "forge() { d=$W/f/$(printf '%s' \"$1\" | tr ' ' '-'); o=$W/c/$2/$3",
      "k=$(grep -cF -- \"$4\" \"$o\" 2>/dev/null)",
      "[ \"$k\" = 1 ] && cp -r \"$W/c/$2\" \"$d\" || { say \"$1\" \"$6\" \"не построена\"; return; }",
      "awk -v a=\"$4\" -v z=\"$5\" '{i=index($0, a); if (i) $0=substr($0, 1, i-1) z substr($0, i+length(a))",
      "print}' \"$o\" > \"$d/$3\"",
      "cmp -s \"$o\" \"$d/$3\" && { say \"$1\" \"$6\" \"не построена\"; return; }",
      "(cd \"$d\" && cc -std=c99 -O2 -o run *.c -lm -lpthread > cc.log 2>&1) ||",
      "{ say \"$1\" \"$6\" \"не собрано\"; return; }",
      "cat $(ls \"$d\"/*.c | grep -v '/flang_') > \"$d/module.txt\"",
      "timeout 600 \"$W/validate\" plan \"$d/ast.json\" \"$d/module.txt\" \"$d/proof.json\" > \"$d/plan.tsv\"",
      "cut -f3 \"$d/plan.tsv\" | grep -a '^{' | \"$d/run\" --json > \"$d/c.jsonl\"",
      "timeout 600 \"$W/validate\" canon \"$d/c.jsonl\" > \"$d/c.txt\"",
      "awk -F'\\t' -v OFS='\\t' -v n=\"$1\" -v g=\"$6\" -v c=\"$d/c.txt\" '$2==\"вне\"{next} $2==\"символ\"{if ($1==g)",
      "print n, $1, $2, $3, $4; next} {x=\"\"; getline x < c} $1==g{print n, $1, $2, $4, x}' \"$d/plan.tsv\"; }",
      "for s in \"$@\"; do ( IFS='|'; set -f; set -- $s; set +f; IFS=' '; forge \"$@\" ); done",
      "exit 0"] по "\n"

