    дано answers равно пустой список
    ожидается ["flang/proof/examples", "docs/examples/pythagoras", "docs/examples/leetcode/069-sqrtx.flang",
      "flang/translation/runtime-contracts.flang"]
  пример «With --all every example of the documentation»
    дано answers равно [(запись «Answer» с «name» равным "arguments"
        и «reply» равным (вариант «Доводы» с доводы равным ["--all"]))]
    ожидается ["flang/proof/examples", "docs/examples"]
  пример «With --path the named file and the files the forgeries edit»
    дано answers равно [(запись «Answer» с «name» равным "arguments"
        и «reply» равным (вариант «Доводы» с доводы равным ["--path", "my/program.flang"]))]
    ожидается ["flang/proof/examples/precondition.flang", "flang/proof/examples/traffic-light.flang",
      "flang/proof/examples/corpus-alphabet.flang", "flang/proof/examples/corpus-lists.flang",
      "flang/proof/examples/binder-wall-map.flang", "flang/proof/examples/corpus-hof.flang",
      "docs/examples/pythagoras/euclid-formula.flang", "docs/examples/leetcode/069-sqrtx.flang", "my/program.flang"]
  пусть words равно («Given of» от "arguments" и answers)
  пусть path равно («Key value» от "--path" и words)
  пусть usual равно ["flang/proof/examples", "docs/examples/pythagoras", "docs/examples/leetcode/069-sqrtx.flang",
      "flang/translation/runtime-contracts.flang"]
  «Chosen» от [(«When» от (не (пусто path)) и (добавить path к («Forgery hosts»))),
      («When» от (words содержит "--all") и ["flang/proof/examples", "docs/examples"])] и usual

тотальная функция «Modules»
  возвращает список строки
  пример «The reference and the validator are five Lean modules»
    ожидается ["Binary64", "Semantics/Eval", "Semantics/Fuel", "Semantics/Walk", "Semantics/Json", "Semantics/Symbolic",
      "Semantics/Bridge", "Semantics/Validate"]
  ["Binary64", "Semantics/Eval", "Semantics/Fuel", "Semantics/Walk", "Semantics/Json", "Semantics/Symbolic",
    "Semantics/Bridge", "Semantics/Validate"]

тотальная функция «Whole corpus program»
  возвращает строка
  обеспечивает «the program has twenty-four lines» (длина (разделить результат по "\n")) равен 24
  соединить ["W=$0; B=$1; shift 1",
      "case $B in /*) ;; *) B=$PWD/$B;; esac",
      "cd ../.. || exit 1",
      "say() { printf '%s\\t%s\\t%s\\t%s\\t\\n' \"$1\" \"$2\" \"$3\" \"$4\"; }",
      "for g in \"$@\"; do find \"$g\" -name '*.flang' | LC_ALL=C sort; done | while read -r f; do",
      "u=${f%.flang}; d=$W/c/$(printf '%s' \"$u\" | tr '/' '-'); [ -d \"$d\" ] && continue; mkdir -p \"$d\"",
      "echo \"$u\" >&2; timeout 120 \"$B\" ast \"$f\" > \"$d/ast.json\" 2>/dev/null ||",
      "{ say \"$u\" \"\" \"не прочитано\" \"$?\"; continue; }",
      "timeout 300 \"$B\" emit \"$f\" --target c --out \"$d\" > /dev/null 2>&1 ||",
      "{ say \"$u\" \"\" \"не напечатано\" \"$?\"; continue; }",
      "timeout 300 \"$B\" check --proof --json \"$f\" > \"$d/proof.json\" 2>/dev/null",
      "(cd \"$d\" && cc -std=c99 -O2 -o run *.c -lm -lpthread > cc.log 2>&1) ||",
      "{ say \"$u\" \"\" \"не собрано\" \"\"; continue; }",
      "cat $(ls \"$d\"/*.c | grep -v '/flang_') > \"$d/module.txt\"",
      "timeout 600 \"$W/validate\" plan \"$d/ast.json\" \"$d/module.txt\" \"$d/proof.json\" \\",
      "> \"$d/plan.tsv\" || { say \"$u\" \"\" \"эталон не уложился\" \"$?\"; continue; }",
      "cut -f3 \"$d/plan.tsv\" | grep -a '^{' | timeout 600 \"$d/run\" --json > \"$d/c.jsonl\"",
      "timeout 600 \"$W/validate\" canon \"$d/c.jsonl\" > \"$d/c.txt\"",
      "awk -F'\\t' -v OFS='\\t' -v b=\"$u\" -v c=\"$d/c.txt\" '",
      "$2==\"вне\" || $2==\"символ\" {print b, $1, $2, $3, $4; next}",
      "{x=\"\"; getline x < c; print b, $1, $2, $4, x}' \"$d/plan.tsv\"",
      "grep -o 'fl_[a-z0-9_]*(' \"$d/module.txt\" | tr -d '(' | sort -u | while read -r h; do",
      "grep -q \"^[a-z_ *]*$h(\" \"$d\"/flang_runtime.[ch] && say \"$u\" \"$h\" \"рантайм\" \"\"; done",
      "done > \"$W/corpus.tsv\""] по "\n"

тотальная функция «Forgery program»
  возвращает строка
  обеспечивает «the program has twenty lines» (длина (разделить результат по "\n")) равен 20
  соединить ["W=$0", "cd ../.. || exit 1",
      "say() { printf '%s\\t%s\\t%s\\t\\t\\n' \"$1\" \"$2\" \"$3\"; }",
      "mkdir -p \"$W/f\"",
      "forge() { d=$W/f/$(printf '%s' \"$1\" | tr ' ' '-'); o=$W/c/$2/$3",
      "k=$(grep -cF -- \"$4\" \"$o\" 2>/dev/null)",
      "[ \"$k\" = 1 ] && cp -r \"$W/c/$2\" \"$d\" || { say \"$1\" \"$6\" \"не построена\"; return; }",
      "awk -v a=\"$4\" -v z=\"$5\" '{i=index($0, a); if (i) $0=substr($0, 1, i-1) z substr($0, i+length(a))",
      "print}' \"$o\" > \"$d/$3\"",
      "cmp -s \"$o\" \"$d/$3\" && { say \"$1\" \"$6\" \"не построена\"; return; }",
      "(cd \"$d\" && cc -std=c99 -O2 -o run *.c -lm -lpthread > cc.log 2>&1) ||",
      "{ say \"$1\" \"$6\" \"не собрано\"; return; }",
      "cat $(ls \"$d\"/*.c | grep -v '/flang_') > \"$d/module.txt\"",
      "timeout 600 \"$W/validate\" plan \"$d/ast.json\" \"$d/module.txt\" \"$d/proof.json\" > \"$d/plan.tsv\"",
      "cut -f3 \"$d/plan.tsv\" | grep -a '^{' | \"$d/run\" --json > \"$d/c.jsonl\"",
      "timeout 600 \"$W/validate\" canon \"$d/c.jsonl\" > \"$d/c.txt\"",
      "awk -F'\\t' -v OFS='\\t' -v n=\"$1\" -v g=\"$6\" -v c=\"$d/c.txt\" '$2==\"вне\"{next} $2==\"символ\"{if ($1==g)",
      "print n, $1, $2, $3, $4; next} {x=\"\"; getline x < c} $1==g{print n, $1, $2, $4, x}' \"$d/plan.tsv\"; }",
      "for s in \"$@\"; do ( IFS='|'; set -f; set -- $s; set +f; IFS=' '; forge \"$@\" ); done",
      "exit 0"] по "\n"

