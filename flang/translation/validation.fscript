модуль «Translation validation»
  использует «Rules» из "../../scripts/rules.fscript"
  использует «Inquiry» из "../../scripts/inquiry.fscript"
  использует «Reading» из "../../scripts/reading.fscript"
  использует «Tables» из "../../scripts/tables.fscript"
  использует «Kernel verdict» из "../proof/kernel-verdict.fscript" только «Key value», «Pick», «Picked»
  использует «Lists» только «Соединить списки»

объект «Row»
  «unit»: строка
  «function»: строка
  «class»: строка
  «reference»: строка
  «answer»: строка

объект «Summary»
  «unit»: строка
  «function»: строка
  «class»: строка
  «compared»: число
  «agreed»: число
  «skipped»: число
  «reason»: строка
  «differ»: список строки

объект «Count»
  «reason»: строка
  «count»: число

объект «Forgery»
  «name»: строка
  «unit»: строка
  «file»: строка
  «original»: строка
  «forged»: строка
  «function»: строка

тотальная функция «Forgery of»
  принимает name: строка, unit: строка, file: строка, original: строка, forged: строка, target: строка
  возвращает «Forgery»
  пример «A forgery names the unit, the printed file, the edit and the function it must break»
    дано name равно "sign"
    дано unit равно "precondition"
    дано file равно "program.c"
    дано original равно "+"
    дано forged равно "-"
    дано target равно "Удвоить"
    ожидается (запись «Forgery» с «name» равным "sign" и «unit» равным "precondition" и «file» равным "program.c"
        и «original» равным "+" и «forged» равным "-" и «function» равным "Удвоить")
  (запись «Forgery» с «name» равным name и «unit» равным unit и «file» равным file и «original» равным original
      и «forged» равным forged и «function» равным target)

тотальная функция «Forgeries»
  возвращает список «Forgery»
  обеспечивает «fourteen forgeries» (длина результат) равен 14
  ([(«Forgery of» от "operation sign" и "flang-proof-examples-precondition" и "program.c"
      и "n.as.number + n.as.number" и "n.as.number - n.as.number" и "Удвоить"),
    («Forgery of» от "branch literal" и "flang-proof-examples-traffic-light" и "program.c" и "fl_number(500.0)"
      и "fl_number(501.0)" и "Штраф"),
    («Forgery of» от "precondition bound" и "flang-proof-examples-precondition" и "program.c"
      и "args[0].as.number >= 0.0), \"вход" и "args[0].as.number > 0.0), \"вход" и "Удвоить"),
    («Forgery of» от "recursion step" и "flang-proof-examples-precondition" и "program.c"
      и "fl_t1.as.number + 1.0" и "fl_t1.as.number + 2.0" и "Высота от дна"),
    («Forgery of» от "text constant" и "flang-proof-examples-corpus-alphabet" и "program.c"
      и "{\"abcdefg" и "{\"abcdefq" и "Строчные"),
    («Forgery of» от "swapped operands" и "flang-proof-examples-precondition" и "program.c"
      и "shirina.as.number - dlina.as.number" и "dlina.as.number - shirina.as.number" и "Сколько дополнить"),
    («Forgery of» от "hidden point" и "flang-proof-examples-precondition" и "program.c"
      и "fl_flag(fl_t2.as.number >= 0.0)" и "fl_flag(fl_t2.as.number >= 0.0 && fl_t2.as.number != 777.0)"
      и "Сколько дополнить"),
    («Forgery of» от "bound inside a sum" и "docs-examples-pythagoras-euclid-formula" и "program.c"
      и "<= 94906265.0), \"тройка укладывается в точность\", \"Гипотенуза\""
      и "< 94906265.0), \"тройка укладывается в точность\", \"Гипотенуза\"" и "Гипотенуза"),
    («Forgery of» от "hidden length" и "flang-proof-examples-corpus-lists" и "program.c"
      и "fl_number(1.0 + fl_t1.as.number)" и "fl_number(1.0 + fl_t1.as.number + (fl_t1.as.number == 3.0))"
      и "Длина"),
    («Forgery of» от "fold step" и "flang-proof-examples-corpus-lists" и "program.c"
      и "fl_b_dobavit(ctx, el, akk, &fl_t6" и "fl_b_dobavit(ctx, el, pervyy, &fl_t6" и "Соединить списки"),
    («Forgery of» от "hidden filter point" и "flang-proof-examples-corpus-lists" и "program.c"
      и "fl_flag(!fl_equal(el, znachenie))" и "fl_flag(!fl_equal(el, znachenie) && !fl_equal(el, fl_number(1000.0)))"
      и "Без значения"),
    («Forgery of» от "hidden map point" и "flang-proof-examples-binder-wall-map" и "program.c"
      и "fl_flag(fl_t44.as.number > 0.0)" и "fl_flag(fl_t44.as.number > 0.0 && fl_t44.as.number != 5000.0)"
      и "Порог под отображением"),
    («Forgery of» от "dispatch target" и "flang-proof-examples-corpus-hof" и "program.c"
      и "return utverzhdeniya_o_vysshem_poryadke_udvoit(ctx, a1, result, error);"
      и "return utverzhdeniya_o_vysshem_poryadke_vozvesti_v_kvadrat(ctx, a1, result, error);" и "Отобразить"),
    («Forgery of» от "hidden loop step" и "docs-examples-leetcode-069-sqrtx" и "integer_square_root.c"
      и "const fl_value dovod_2 = fl_number(seredina.as.number + 1.0);"
      и "const fl_value dovod_2 = fl_number(seredina.as.number + 1.0 + (seredina.as.number == 777.0));"
      и "Корень в отрезке")])

тотальная функция «Specification»
  принимает forgery: «Forgery»
  возвращает строка
