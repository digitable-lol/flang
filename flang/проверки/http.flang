модуль «Корпус HTTP»
  использует «Requests and responses» из "../stdlib/http.flang"

// SPDX-FileCopyrightText: 2026 Digitable (Marat Zimnurov)
// SPDX-License-Identifier: BSD-2-Clause

примечание "Content-Length здесь считается по числу знаков строки, а не по октетам, поэтому «Content-Length: 2» с двухбайтовой кириллицей в теле — целый запрос, а не обрезанный"

тотальная функция «Исход»
  принимает вход: строка
  возвращает строка
  обеспечивает «неполный вход назван неполным» если («Разобрать запрос» от вход) равен (вариант «Запрос неполон») то результат равен "неполон" иначе да
  пример «Целый запрос — разобран»
    дано вход равно "GET / HTTP/1.1\r\n\r\n"
    ожидается "разобран"
  пример «Обрезанный — неполон»
    дано вход равно "GET / HT"
    ожидается "неполон"
  разбор («Разобрать запрос» от вход)
    случай вариант «Запрос разобран» с запрос как разобранный
      то "разобран"
    случай вариант «Запрос неполон»
      то "неполон"
    случай вариант «Запрос испорчен» с код как код и причина как причина
      то соединить ["испорчен ", (к строке код)] по ""

тотальная функция «Пара заголовка»
  принимает заголовок: «Заголовок»
  возвращает строка
  обеспечивает «пара печатается через равенство» результат содержит "="
  пример «Пара печатается через двоеточие»
    дано заголовок равно вариант «Заголовок» с имя равным "Host" и значение равным "узел"
    ожидается "Host=узел"
  соединить [(«Имя заголовка» от заголовок), "=", («Значение заголовка» от заголовок)] по ""

тотальная функция «Метод и цель из запроса»
  принимает запрос: «Запрос»
  возвращает строка
  пример «Метод и цель разделены пробелом»
    дано запрос равно вариант «Запрос» с метод равным "GET" и цель равным "/заказы" и версия равным "HTTP/1.1" и заголовки равным [] и тело равным ""
    ожидается "GET /заказы"
  соединить [запрос.метод, " ", запрос.цель] по ""

тотальная функция «Тело из запроса»
  принимает запрос: «Запрос»
  возвращает строка
  пример «Тело возвращается как есть»
    дано запрос равно вариант «Запрос» с метод равным "POST" и цель равным "/" и версия равным "HTTP/1.1" и заголовки равным [] и тело равным "аб"
    ожидается "аб"
  запрос.тело

тотальная функция «Заголовки из запроса»
  принимает запрос: «Запрос»
  возвращает строка
  пример «Заголовки печатаются парами через |»
    дано запрос равно вариант «Запрос» с метод равным "GET" и цель равным "/" и версия равным "HTTP/1.1" и заголовки равным [вариант «Заголовок» с имя равным "Host" и значение равным "узел"] и тело равным ""
    ожидается "Host=узел"
  соединить (отобразить запрос.заголовки как заголовок → («Пара заголовка» от заголовок)) по "|"

тотальная функция «Поле разобранного»
  принимает вход: строка, извлечь: функция из «Запрос» в строка
  возвращает строка
  пример «Успешный разбор отдаётся извлекающей функции»
    дано вход равно "GET / HTTP/1.1\r\n\r\n"
    дано извлечь равно функция «Метод и цель из запроса»
    ожидается "GET /"
  пример «Неполный запрос отвечает запасным словом»
    дано вход равно "GET / HT"
    дано извлечь равно функция «Метод и цель из запроса»
    ожидается "запрос не разобран"
  разбор («Разобрать запрос» от вход)
    случай вариант «Запрос разобран» с запрос как разобранный
      то извлечь от разобранный
    случай любое
      то "запрос не разобран"

тотальная функция «Метод и цель»
  принимает вход: строка
  возвращает строка
  обеспечивает «у неполного запроса метода и цели нет» если («Разобрать запрос» от вход) равен (вариант «Запрос неполон») то результат равен "запрос не разобран" иначе да
  пример «Метод и цель целого запроса»
    дано вход равно "GET /заказы HTTP/1.1\r\n\r\n"
    ожидается "GET /заказы"
  «Поле разобранного» от вход и функция «Метод и цель из запроса»

тотальная функция «Тело запроса»
  принимает вход: строка
  возвращает строка
  обеспечивает «у неполного запроса тела нет» если («Разобрать запрос» от вход) равен (вариант «Запрос неполон») то результат равен "запрос не разобран" иначе да
  пример «Тело по длине»
    дано вход равно "POST / HTTP/1.1\r\nContent-Length: 11\r\n\r\nтовар=книга"
    ожидается "товар=книга"
  «Поле разобранного» от вход и функция «Тело из запроса»

тотальная функция «Заголовки запроса»
  принимает вход: строка
  возвращает строка
  обеспечивает «у неполного запроса заголовков нет» если («Разобрать запрос» от вход) равен (вариант «Запрос неполон») то результат равен "запрос не разобран" иначе да
  пример «Один заголовок»
    дано вход равно "GET / HTTP/1.1\r\nHost: узел\r\n\r\n"
    ожидается "Host=узел"
  «Поле разобранного» от вход и функция «Заголовки из запроса»

тотальная функция «Параметры»
  принимает строказапроса: строка
  возвращает строка
  обеспечивает «без разобранных пар параметров нет» если («Разобрать параметры» от строказапроса) равен пустой список то результат равен "" иначе да
  пример «Две пары»
    дано строказапроса равно "а=1&б=2"
    ожидается "а=1|б=2"
  пример «Пустая строка запроса — пусто»
    дано строказапроса равно ""
    ожидается ""
  соединить (отобразить («Разобрать параметры» от строказапроса) как пара → («Пара заголовка» от пара)) по "|"

тотальная функция «Удвоить»
  принимает кусок: строка, раз: нат
  возвращает строка
  обеспечивает «ноль удвоений отдаёт сам кусок» если раз не больше 0 то результат равен кусок иначе да
  обеспечивает «удвоение — это склейка куска с собой и шаг вниз» если не (раз не больше 0) то результат равен («Удвоить» от (соединить [кусок, кусок] по "") и (раз минус 1)) иначе да
  пример «Ноль удвоений — сам кусок»
    дано кусок равно "х"
    дано раз равно 0
    ожидается "х"
  пример «Три удвоения — восемь знаков»
    дано кусок равно "х"
    дано раз равно 3
    ожидается "хххххххх"
  если раз не больше 0
    то кусок
    иначе «Удвоить» от (соединить [кусок, кусок] по "") и (раз минус 1)

тотальная функция «Длина удвоенного»
  возвращает число
  обеспечивает «тринадцать удвоений одного знака дают ровно предел» результат равен 8192
  пример «Тринадцать удвоений одного знака — ровно предел 8192»
    ожидается 8192
  длина («Удвоить» от "х" и 13)

тотальная функция «Заголовок в предел»
  возвращает строка
  обеспечивает «вход в предел — целый запрос GET» результат содержит "GET / HTTP/1.1"
  обеспечивает «длинный заголовок назван» результат содержит "X-Много: "
  соединить ["GET / HTTP/1.1\r\nX-Много: ", («Удвоить» от "х" и 12), "\r\n\r\n"] по ""

тотальная функция «Заголовок за предел»
  возвращает строка
  обеспечивает «вход за предел — тоже запрос GET» результат содержит "GET / HTTP/1.1"
  обеспечивает «вход за предел — восемь тысяч двести двадцать один знак» (длина результат) равен 8221
  соединить ["GET / HTTP/1.1\r\nX-Много: ", («Удвоить» от "х" и 13), "\r\n\r\n"] по ""

тотальная функция «Цель за предел»
  возвращает строка
  обеспечивает «цель за пределом начинается с метода» результат содержит "GET /"
  соединить ["GET /", («Удвоить» от "х" и 13), " HTTP/1.1\r\n\r\n"] по ""

тотальная функция «Тысяча заголовков»
  возвращает строка
  обеспечивает «много заголовков — это всё ещё запрос GET» результат содержит "GET / HTTP/1.1"
  соединить ["GET / HTTP/1.1\r\n", («Удвоить» от "X-А: б\r\n" и 10), "\r\n"] по ""

тотальная функция «Вердикт»
  принимает имя: строка, сошлось: признак
  возвращает строка
  обеспечивает «сошлось печатается словом да» если сошлось то результат равен (соединить имя с " — да") иначе да
  обеспечивает «не сошлось печатается заглавным НЕТ» если не сошлось то результат равен (соединить имя с " — НЕТ") иначе да
  пример «Сошлось»
    дано имя равно "минимальный GET"
    дано сошлось равно да
    ожидается "минимальный GET — да"
  пример «Не сошлось»
    дано имя равно "минимальный GET"
    дано сошлось равно нет
    ожидается "минимальный GET — НЕТ"
  если сошлось
    то соединить имя с " — да"
    иначе соединить имя с " — НЕТ"

тотальная функция «Ведомость корпуса HTTP»
  возвращает список строки
  обеспечивает «в ведомости пятьдесят пять строк» (длина результат) равен 55
  [
    «Вердикт» от "целый: минимальный GET" и ((«Исход» от "GET / HTTP/1.1\r\n\r\n") равно "разобран"),
    «Вердикт» от "целый: минимальный GET — метод и цель" и ((«Метод и цель» от "GET / HTTP/1.1\r\n\r\n") равно "GET /"),
    «Вердикт» от "целый: GET с заголовком" и ((«Метод и цель» от "GET /заказы HTTP/1.1\r\nHost: узел\r\n\r\n") равно "GET /заказы"),
    «Вердикт» от "целый: двоеточие внутри значения" и ((«Заголовки запроса» от "GET / HTTP/1.1\r\nHost: узел:8080\r\n\r\n") равно "Host=узел:8080"),
    «Вердикт» от "целый: пробелы вокруг значения обрезаются" и ((«Заголовки запроса» от "GET / HTTP/1.1\r\nHost:   узел   \r\n\r\n") равно "Host=узел"),
    «Вердикт» от "целый: пустое значение заголовка законно" и ((«Заголовки запроса» от "GET / HTTP/1.1\r\nX-Пусто:\r\n\r\n") равно "X-Пусто="),
    «Вердикт» от "целый: регистр имени заголовка не важен" и ((«Тело запроса» от "POST / HTTP/1.1\r\ncOnTeNt-LeNgTh: 2\r\n\r\nаб") равно "аб"),
    «Вердикт» от "целый: POST с телом по длине" и ((«Тело запроса» от "POST /заказы HTTP/1.1\r\nContent-Length: 11\r\n\r\nтовар=книга") равно "товар=книга"),
    «Вердикт» от "целый: тело нулевой длины" и ((«Тело запроса» от "POST / HTTP/1.1\r\nContent-Length: 0\r\n\r\n") равно ""),
    «Вердикт» от "целый: цель со строкой запроса" и ((«Метод и цель» от "GET /заказы?номер=77 HTTP/1.1\r\n\r\n") равно "GET /заказы?номер=77"),
    «Вердикт» от "целый: чанкованное тело целиком" и ((«Тело запроса» от "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nабвгд\r\n0\r\n\r\n") равно "абвгд"),
    «Вердикт» от "целый: два чанка подряд" и ((«Тело запроса» от "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nаб\r\n3\r\nвгд\r\n0\r\n\r\n") равно "абвгд"),
    «Вердикт» от "целый: перевод строки внутри тела по длине" и ((«Тело запроса» от "POST / HTTP/1.1\r\nContent-Length: 4\r\n\r\nа\r\nб") равно "а\r\nб"),
    «Вердикт» от "целый: заголовок ровно в предел (8192) проходит" и ((«Исход» от («Заголовок в предел»)) равно "разобран"),

    «Вердикт» от "неполон: пустой вход" и ((«Исход» от "") равно "неполон"),
    «Вердикт» от "неполон: начало строки запроса" и ((«Исход» от "GET / HT") равно "неполон"),
    «Вердикт» от "неполон: заголовки без пустой строки" и ((«Исход» от "GET / HTTP/1.1\r\nHost: узел\r\n") равно "неполон"),
    «Вердикт» от "неполон: обрезано на середине имени заголовка" и ((«Исход» от "GET / HTTP/1.1\r\nHos") равно "неполон"),
    «Вердикт» от "неполон: тело короче обещанного" и ((«Исход» от "POST / HTTP/1.1\r\nContent-Length: 11\r\n\r\nтовар") равно "неполон"),
    «Вердикт» от "неполон: обрезанный чанк (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nабв") равно "неполон"),
    «Вердикт» от "неполон: чанки без завершающего нуля (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nаб\r\n") равно "неполон"),
    «Вердикт» от "неполон: размер чанка назван, данных нет (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\n") равно "неполон"),

    «Вердикт» от "испорчен 400: строка запроса из одного слова" и ((«Исход» от "GET\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: строка запроса из двух слов" и ((«Исход» от "GET /\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: строка запроса из пяти слов (злой)" и ((«Исход» от "GET / HTTP/1.1 лишнее ещё\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: пустая строка запроса" и ((«Исход» от "\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: заголовок без двоеточия (злой)" и ((«Исход» от "GET / HTTP/1.1\r\nHost узел\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: заголовок с пустым именем (злой)" и ((«Исход» от "GET / HTTP/1.1\r\n: узел\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: пробел в имени заголовка (злой)" и ((«Исход» от "GET / HTTP/1.1\r\nHost : узел\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: голый перевод строки в блоке заголовков (злой)" и ((«Исход» от "GET / HTTP/1.1\r\nHost: узел\nX-Тень: да\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: отрицательная длина тела (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nContent-Length: -1\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: длина тела не число (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nContent-Length: абв\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: длина тела со знаком плюс (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nContent-Length: +5\r\n\r\nабвгд") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: два Content-Length (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nContent-Length: 2\r\nContent-Length: 3\r\n\r\nабв") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: два Content-Length с одним значением (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nContent-Length: 2\r\ncontent-length: 2\r\n\r\nаб") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: длина и чанки разом (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: размер чанка не шестнадцатеричный (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nзз\r\nаб\r\n0\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 400: отрицательный размер чанка (злой)" и ((«Исход» от "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n-2\r\nаб\r\n0\r\n\r\n") равно "испорчен 400"),
    «Вердикт» от "испорчен 431: заголовок за пределом длины (злой)" и ((«Исход» от («Заголовок за предел»)) равно "испорчен 431"),
    «Вердикт» от "испорчен 431: тысяча с лишним заголовков (злой)" и ((«Исход» от («Тысяча заголовков»)) равно "испорчен 431"),
    «Вердикт» от "испорчен 414: цель за пределом длины (злой)" и ((«Исход» от («Цель за предел»)) равно "испорчен 414"),

    «Вердикт» от "адрес: обычная пара" и ((«Параметры» от "имя=Марат") равно "имя=Марат"),
    «Вердикт» от "адрес: две пары" и ((«Параметры» от "а=1&б=2") равно "а=1|б=2"),
    «Вердикт» от "адрес: равенство внутри значения" и ((«Параметры» от "подпись=а=б") равно "подпись=а=б"),
    «Вердикт» от "адрес: ключ без значения" и ((«Параметры» от "флаг") равно "флаг="),
    «Вердикт» от "адрес: пустая строка запроса" и ((«Параметры» от "") равно ""),
    «Вердикт» от "адрес: одни разделители (злой)" и ((«Параметры» от "&&&") равно ""),
    «Вердикт» от "адрес: пустые имена (злой)" и ((«Параметры» от "=1&=2") равно ""),
    «Вердикт» от "адрес: плюс — это пробел" и ((«Параметры» от "имя=два+слова") равно "имя=два слова"),
    «Вердикт» от "адрес: проценты раскодируются" и ((«Параметры» от "имя=%41%42") равно "имя=AB"),
    «Вердикт» от "адрес: процент в конце (злой)" и ((«Параметры» от "имя=а%") равно "имя=а%"),
    «Вердикт» от "адрес: процент и одна цифра (злой)" и ((«Параметры» от "имя=%4") равно "имя=%4"),
    «Вердикт» от "адрес: не шестнадцатеричные цифры (злой)" и ((«Параметры» от "имя=%ZZ") равно "имя=%ZZ"),
    «Вердикт» от "адрес: закодированный разделитель не делит (злой)" и ((«Параметры» от "имя=а%26б") равно "имя=а&б"),
    «Вердикт» от "адрес: закодированное равенство не делит (злой)" и ((«Параметры» от "имя=а%3Dб") равно "имя=а=б")
  ]
