модуль «Корпус HTTP»
  использует «Requests and responses» из "../stdlib/http.flang"

// SPDX-FileCopyrightText: 2026 Digitable (Marat Zimnurov)
// SPDX-License-Identifier: BSD-2-Clause

примечание "Content-Length здесь считается по числу знаков строки, а не по октетам, поэтому «Content-Length: 2» с двухбайтовой кириллицей в теле — целый запрос, а не обрезанный"

тотальная функция «Исход»
  принимает вход: строка
  возвращает строка
  обеспечивает «неполный вход назван неполным» если («Разобрать запрос» от вход) равен (вариант «Запрос неполон») то результат равен "неполон" иначе да
  пример «Целый запрос — разобран»
    дано вход равно "GET / HTTP/1.1\r\n\r\n"
    ожидается "разобран"
  пример «Обрезанный — неполон»
    дано вход равно "GET / HT"
    ожидается "неполон"
  разбор («Разобрать запрос» от вход)
    случай вариант «Запрос разобран» с запрос как разобранный
      то "разобран"
    случай вариант «Запрос неполон»
      то "неполон"
    случай вариант «Запрос испорчен» с код как код и причина как причина
      то соединить ["испорчен ", (к строке код)] по ""

тотальная функция «Пара заголовка»
  принимает заголовок: «Заголовок»
  возвращает строка
  обеспечивает «пара печатается через равенство» результат содержит "="
  пример «Пара печатается через двоеточие»
    дано заголовок равно вариант «Заголовок» с имя равным "Host" и значение равным "узел"
    ожидается "Host=узел"
  соединить [(«Имя заголовка» от заголовок), "=", («Значение заголовка» от заголовок)] по ""

тотальная функция «Метод и цель из запроса»
  принимает запрос: «Запрос»
  возвращает строка
  пример «Метод и цель разделены пробелом»
    дано запрос равно вариант «Запрос» с метод равным "GET" и цель равным "/заказы" и версия равным "HTTP/1.1" и заголовки равным [] и тело равным ""
    ожидается "GET /заказы"
  соединить [запрос.метод, " ", запрос.цель] по ""

тотальная функция «Тело из запроса»
  принимает запрос: «Запрос»
  возвращает строка
  пример «Тело возвращается как есть»
    дано запрос равно вариант «Запрос» с метод равным "POST" и цель равным "/" и версия равным "HTTP/1.1" и заголовки равным [] и тело равным "аб"
    ожидается "аб"
  запрос.тело

тотальная функция «Заголовки из запроса»
  принимает запрос: «Запрос»
  возвращает строка
  пример «Заголовки печатаются парами через |»
    дано запрос равно вариант «Запрос» с метод равным "GET" и цель равным "/" и версия равным "HTTP/1.1" и заголовки равным [вариант «Заголовок» с имя равным "Host" и значение равным "узел"] и тело равным ""
    ожидается "Host=узел"
  соединить (отобразить запрос.заголовки как заголовок → («Пара заголовка» от заголовок)) по "|"

тотальная функция «Поле разобранного»
  принимает вход: строка, извлечь: функция из «Запрос» в строка
  возвращает строка
  пример «Успешный разбор отдаётся извлекающей функции»
    дано вход равно "GET / HTTP/1.1\r\n\r\n"
    дано извлечь равно функция «Метод и цель из запроса»
    ожидается "GET /"
  пример «Неполный запрос отвечает запасным словом»
    дано вход равно "GET / HT"
    дано извлечь равно функция «Метод и цель из запроса»
    ожидается "запрос не разобран"
  разбор («Разобрать запрос» от вход)
    случай вариант «Запрос разобран» с запрос как разобранный
      то извлечь от разобранный
    случай любое
      то "запрос не разобран"

тотальная функция «Метод и цель»
  принимает вход: строка
  возвращает строка
  обеспечивает «у неполного запроса метода и цели нет» если («Разобрать запрос» от вход) равен (вариант «Запрос неполон») то результат равен "запрос не разобран" иначе да
  пример «Метод и цель целого запроса»
    дано вход равно "GET /заказы HTTP/1.1\r\n\r\n"
    ожидается "GET /заказы"
  «Поле разобранного» от вход и функция «Метод и цель из запроса»

тотальная функция «Тело запроса»
  принимает вход: строка
  возвращает строка
  обеспечивает «у неполного запроса тела нет» если («Разобрать запрос» от вход) равен (вариант «Запрос неполон») то результат равен "запрос не разобран" иначе да
  пример «Тело по длине»
    дано вход равно "POST / HTTP/1.1\r\nContent-Length: 11\r\n\r\nтовар=книга"
    ожидается "товар=книга"
  «Поле разобранного» от вход и функция «Тело из запроса»

тотальная функция «Заголовки запроса»
  принимает вход: строка
  возвращает строка
  обеспечивает «у неполного запроса заголовков нет» если («Разобрать запрос» от вход) равен (вариант «Запрос неполон») то результат равен "запрос не разобран" иначе да
  пример «Один заголовок»
    дано вход равно "GET / HTTP/1.1\r\nHost: узел\r\n\r\n"
    ожидается "Host=узел"
  «Поле разобранного» от вход и функция «Заголовки из запроса»

тотальная функция «Параметры»
  принимает строказапроса: строка
  возвращает строка
  обеспечивает «без разобранных пар параметров нет» если («Разобрать параметры» от строказапроса) равен пустой список то результат равен "" иначе да
  пример «Две пары»
    дано строказапроса равно "а=1&б=2"
    ожидается "а=1|б=2"
  пример «Пустая строка запроса — пусто»
    дано строказапроса равно ""
    ожидается ""
  соединить (отобразить («Разобрать параметры» от строказапроса) как пара → («Пара заголовка» от пара)) по "|"

тотальная функция «Удвоить»
  принимает кусок: строка, раз: нат
  возвращает строка
  обеспечивает «ноль удвоений отдаёт сам кусок» если раз не больше 0 то результат равен кусок иначе да
  обеспечивает «удвоение — это склейка куска с собой и шаг вниз» если не (раз не больше 0) то результат равен («Удвоить» от (соединить [кусок, кусок] по "") и (раз минус 1)) иначе да
  пример «Ноль удвоений — сам кусок»
    дано кусок равно "х"
    дано раз равно 0
    ожидается "х"
  пример «Три удвоения — восемь знаков»
    дано кусок равно "х"
    дано раз равно 3
    ожидается "хххххххх"
  если раз не больше 0
    то кусок
    иначе «Удвоить» от (соединить [кусок, кусок] по "") и (раз минус 1)

тотальная функция «Длина удвоенного»
  возвращает число
  обеспечивает «тринадцать удвоений одного знака дают ровно предел» результат равен 8192
  пример «Тринадцать удвоений одного знака — ровно предел 8192»
    ожидается 8192
  длина («Удвоить» от "х" и 13)

тотальная функция «Заголовок в предел»
  возвращает строка
  обеспечивает «вход в предел — целый запрос GET» результат содержит "GET / HTTP/1.1"
  обеспечивает «длинный заголовок назван» результат содержит "X-Много: "
  соединить ["GET / HTTP/1.1\r\nX-Много: ", («Удвоить» от "х" и 12), "\r\n\r\n"] по ""

тотальная функция «Заголовок за предел»
  возвращает строка
  обеспечивает «вход за предел — тоже запрос GET» результат содержит "GET / HTTP/1.1"
  обеспечивает «вход за предел — восемь тысяч двести двадцать один знак» (длина результат) равен 8221
  соединить ["GET / HTTP/1.1\r\nX-Много: ", («Удвоить» от "х" и 13), "\r\n\r\n"] по ""

тотальная функция «Цель за предел»
  возвращает строка
  обеспечивает «цель за пределом начинается с метода» результат содержит "GET /"
  соединить ["GET /", («Удвоить» от "х" и 13), " HTTP/1.1\r\n\r\n"] по ""

тотальная функция «Тысяча заголовков»
  возвращает строка
  обеспечивает «много заголовков — это всё ещё запрос GET» результат содержит "GET / HTTP/1.1"
  соединить ["GET / HTTP/1.1\r\n", («Удвоить» от "X-А: б\r\n" и 10), "\r\n"] по ""

тотальная функция «Вердикт»
  принимает имя: строка, сошлось: признак
  возвращает строка
  обеспечивает «сошлось печатается словом да» если сошлось то результат равен (соединить имя с " — да") иначе да
  обеспечивает «не сошлось печатается заглавным НЕТ» если не сошлось то результат равен (соединить имя с " — НЕТ") иначе да
  пример «Сошлось»
    дано имя равно "минимальный GET"
    дано сошлось равно да
    ожидается "минимальный GET — да"
  пример «Не сошлось»
    дано имя равно "минимальный GET"
    дано сошлось равно нет
    ожидается "минимальный GET — НЕТ"
  если сошлось
    то соединить имя с " — да"
    иначе соединить имя с " — НЕТ"
тотальная функция «крлф»
  принимает строки: список строки
  возвращает строка
  пример «Минимальный запрос — три строки, конец блока заголовков»
    дано строки равно ["GET / HTTP/1.1", "", ""]
    ожидается "GET / HTTP/1.1\r\n\r\n"
  пример «Одна строка — без разделителя»
    дано строки равно ["GET / HTTP/1.1"]
    ожидается "GET / HTTP/1.1"
  соединить строки по "\r\n"

тотальная функция «Вердикт исхода»
  принимает описание: строка, вход: строка, ожид: строка
  возвращает строка
  пример «Сошедшийся случай печатается словом да»
    дано описание равно "проба"
    дано вход равно ""
    дано ожид равно "неполон"
    ожидается "проба — да"
  «Вердикт» от описание и ((«Исход» от вход) равно ожид)

тотальная функция «Вердикт метода и цели»
  принимает описание: строка, вход: строка, ожид: строка
  возвращает строка
  пример «Сошедшийся случай печатается словом да»
    дано описание равно "проба"
    дано вход равно ""
    дано ожид равно "запрос не разобран"
    ожидается "проба — да"
  «Вердикт» от описание и ((«Метод и цель» от вход) равно ожид)

тотальная функция «Вердикт тела»
  принимает описание: строка, вход: строка, ожид: строка
  возвращает строка
  пример «Сошедшийся случай печатается словом да»
    дано описание равно "проба"
    дано вход равно ""
    дано ожид равно "запрос не разобран"
    ожидается "проба — да"
  «Вердикт» от описание и ((«Тело запроса» от вход) равно ожид)

тотальная функция «Вердикт заголовков»
  принимает описание: строка, вход: строка, ожид: строка
  возвращает строка
  пример «Сошедшийся случай печатается словом да»
    дано описание равно "проба"
    дано вход равно ""
    дано ожид равно "запрос не разобран"
    ожидается "проба — да"
  «Вердикт» от описание и ((«Заголовки запроса» от вход) равно ожид)

тотальная функция «Вердикт параметров»
  принимает описание: строка, вход: строка, ожид: строка
  возвращает строка
  пример «Сошедшийся случай печатается словом да»
    дано описание равно "проба"
    дано вход равно "имя=Марат"
    дано ожид равно "имя=Марат"
    ожидается "проба — да"
  «Вердикт» от описание и ((«Параметры» от вход) равно ожид)

примечание "Где кривой конец строки сам есть предмет теста (внутренности чанков, голый перевод строки, перевод строки внутри тела по длине) — точные байты явны последней строкой списка «крлф»."

тотальная функция «Ведомость корпуса HTTP»
  возвращает список строки
  обеспечивает «в ведомости пятьдесят пять строк» (длина результат) равен 55
  [
    «Вердикт исхода» от "целый: минимальный GET" и («крлф» от ["GET / HTTP/1.1", "", ""]) и "разобран",
    «Вердикт метода и цели» от "целый: минимальный GET — метод и цель" и («крлф» от ["GET / HTTP/1.1", "", ""]) и "GET /",
    «Вердикт метода и цели» от "целый: GET с заголовком" и («крлф» от ["GET /заказы HTTP/1.1", "Host: узел", "", ""]) и "GET /заказы",
    «Вердикт заголовков» от "целый: двоеточие внутри значения" и («крлф» от ["GET / HTTP/1.1", "Host: узел:8080", "", ""]) и "Host=узел:8080",
    «Вердикт заголовков» от "целый: пробелы вокруг значения обрезаются" и («крлф» от ["GET / HTTP/1.1", "Host:   узел   ", "", ""]) и "Host=узел",
    «Вердикт заголовков» от "целый: пустое значение заголовка законно" и («крлф» от ["GET / HTTP/1.1", "X-Пусто:", "", ""]) и "X-Пусто=",
    «Вердикт тела» от "целый: регистр имени заголовка не важен" и («крлф» от ["POST / HTTP/1.1", "cOnTeNt-LeNgTh: 2", "", "аб"]) и "аб",
    «Вердикт тела» от "целый: POST с телом по длине" и («крлф» от ["POST /заказы HTTP/1.1", "Content-Length: 11", "", "товар=книга"]) и "товар=книга",
    «Вердикт тела» от "целый: тело нулевой длины" и («крлф» от ["POST / HTTP/1.1", "Content-Length: 0", "", ""]) и "",
    «Вердикт метода и цели» от "целый: цель со строкой запроса" и («крлф» от ["GET /заказы?номер=77 HTTP/1.1", "", ""]) и "GET /заказы?номер=77",
    «Вердикт тела» от "целый: чанкованное тело целиком" и («крлф» от ["POST / HTTP/1.1", "Transfer-Encoding: chunked", "", "5\r\nабвгд\r\n0\r\n\r\n"]) и "абвгд",
    «Вердикт тела» от "целый: два чанка подряд" и («крлф» от ["POST / HTTP/1.1", "Transfer-Encoding: chunked", "", "2\r\nаб\r\n3\r\nвгд\r\n0\r\n\r\n"]) и "абвгд",
    «Вердикт тела» от "целый: перевод строки внутри тела по длине" и («крлф» от ["POST / HTTP/1.1", "Content-Length: 4", "", "а\r\nб"]) и "а\r\nб",
    «Вердикт исхода» от "целый: заголовок ровно в предел (8192) проходит" и («Заголовок в предел») и "разобран",
    «Вердикт исхода» от "неполон: пустой вход" и "" и "неполон",
    «Вердикт исхода» от "неполон: начало строки запроса" и "GET / HT" и "неполон",
    «Вердикт исхода» от "неполон: заголовки без пустой строки" и («крлф» от ["GET / HTTP/1.1", "Host: узел", ""]) и "неполон",
    «Вердикт исхода» от "неполон: обрезано на середине имени заголовка" и («крлф» от ["GET / HTTP/1.1", "Hos"]) и "неполон",
    «Вердикт исхода» от "неполон: тело короче обещанного" и («крлф» от ["POST / HTTP/1.1", "Content-Length: 11", "", "товар"]) и "неполон",
    «Вердикт исхода» от "неполон: обрезанный чанк (злой)" и («крлф» от ["POST / HTTP/1.1", "Transfer-Encoding: chunked", "", "5\r\nабв"]) и "неполон",
    «Вердикт исхода» от "неполон: чанки без завершающего нуля (злой)" и («крлф» от ["POST / HTTP/1.1", "Transfer-Encoding: chunked", "", "2\r\nаб\r\n"]) и "неполон",
    «Вердикт исхода» от "неполон: размер чанка назван, данных нет (злой)" и («крлф» от ["POST / HTTP/1.1", "Transfer-Encoding: chunked", "", "5\r\n"]) и "неполон",
    «Вердикт исхода» от "испорчен 400: строка запроса из одного слова" и («крлф» от ["GET", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: строка запроса из двух слов" и («крлф» от ["GET /", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: строка запроса из пяти слов (злой)" и («крлф» от ["GET / HTTP/1.1 лишнее ещё", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: пустая строка запроса" и («крлф» от ["", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: заголовок без двоеточия (злой)" и («крлф» от ["GET / HTTP/1.1", "Host узел", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: заголовок с пустым именем (злой)" и («крлф» от ["GET / HTTP/1.1", ": узел", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: пробел в имени заголовка (злой)" и («крлф» от ["GET / HTTP/1.1", "Host : узел", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: голый перевод строки в блоке заголовков (злой)" и («крлф» от ["GET / HTTP/1.1", "Host: узел\nX-Тень: да", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: отрицательная длина тела (злой)" и («крлф» от ["POST / HTTP/1.1", "Content-Length: -1", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: длина тела не число (злой)" и («крлф» от ["POST / HTTP/1.1", "Content-Length: абв", "", ""]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: длина тела со знаком плюс (злой)" и («крлф» от ["POST / HTTP/1.1", "Content-Length: +5", "", "абвгд"]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: два Content-Length (злой)" и («крлф» от ["POST / HTTP/1.1", "Content-Length: 2", "Content-Length: 3", "", "абв"]) и "испорчен 400",
    «Вердикт исхода» от "испорчен 400: два Content-Length с одним значением (злой)" и («крлф» от ["POST / HTTP/1.1", "Content-Length: 2", "content-length: 2", "", "аб"]) и "испорчен 400",
