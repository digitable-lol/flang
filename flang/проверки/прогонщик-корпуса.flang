модуль «Проверка прогонщика корпуса»
  использует «Корпус flang» из "../self/bootstrap/corpus.flang"

// Проверки ПРОГОНЩИКА КОРПУСА, написанные на самом flang.
//
// ── Что здесь проверяется и почему именно здесь ─────────────────────────────
//
// Прогонщик корпуса разложен на две половины. Эффектная (перечислить каталог,
// прочитать файл, спросить часы) живёт в `flang_repl.c` и на flang невыразима.
// Всё остальное — какой довод считать корпусом, куда идти обходу, какие пути
// брать, в каком порядке, какими словами отчитаться, что напечатать машине и с
// каким кодом выйти — живёт в `flang/self/bootstrap/corpus.flang`, и вот оно
// проверяется здесь, вычислением, без единого процесса и без единого файла на
// диске.
//
// Уклад тот же, что у `встроенные-формы.flang`: утверждение пишется на flang,
// снаружи остаётся тонкий обходчик, который свидетеля ищет и возит
// (`flang/проверки/обход.sh`). Node не нужен ни на одном шаге — двоичный
// считает это сам.
//
// ── Чего здесь НЕТ ──────────────────────────────────────────────────────────
//
// Конца в конец: настоящий каталог, настоящие два файла, настоящий код возврата
// процесса. Каталога в языке нет, кода возврата у вычисления нет, и подделывать
// их значением было бы проверкой подделки. Эта половина проверяется прогоном
// двоичного на `flang/test/fixtures/korpus/` — `flang/test/cli-test-corpus.test.mjs`.
//
// ── Главный случай ──────────────────────────────────────────────────────────
//
// Корпус из двух файлов, у одного пример заведомо ложен. Прогонщик обязан
// НАЗВАТЬ упавший поимённо и дать ненулевой код. Ровно это и стоит ниже
// строками «свод: …».

тотальная функция «Вердикт корпуса»
  принимает «имя»: строка, «сошлось»: признак
  возвращает строка
  пример «Сошлось»
    дано «имя» равно "маска берёт файл"
    дано «сошлось» равно да
    ожидается "маска берёт файл — да"
  пример «Не сошлось»
    дано «имя» равно "маска берёт файл"
    дано «сошлось» равно нет
    ожидается "маска берёт файл — НЕТ"
  если «сошлось»
    то соединить «имя» с " — да"
    иначе соединить «имя» с " — НЕТ"

// Два файла подделки: один чистый, второй с одним не сошедшимся примером.
// Имена те же, что у настоящей фикстуры на диске, — чтобы вывод этой проверки
// и вывод двоичного читались одним взглядом.
тотальная функция «Чистый файл подделки»
  возвращает «Итог файла корпуса»
  запись «Итог файла корпуса» с «путь» равным "к/чистый.flang" и «взят» равным да и «код» равным "" и «сообщение» равным "" и «всего» равным 2 и «прошло» равным 2 и «сорвалось» равным 0 и «сорванные» равным пустой список

тотальная функция «Ложный файл подделки»
  возвращает «Итог файла корпуса»
  запись «Итог файла корпуса» с «путь» равным "к/ложный.flang" и «взят» равным да и «код» равным "" и «сообщение» равным "" и «всего» равным 2 и «прошло» равным 1 и «сорвалось» равным 1 и «сорванные» равным [(запись «Сорванный пример» с «функция» равным "Утроить" и «пример» равным "Заведомо ложный" и «код» равным "" и «сообщение» равным "значение не совпало с ожидаемым: ожидалось 7")]

тотальная функция «Невзятый файл подделки»
  возвращает «Итог файла корпуса»
  запись «Итог файла корпуса» с «путь» равным "к/невзятый.flang" и «взят» равным нет и «код» равным "FLANG_TYPE" и «сообщение» равным "тип не сошёлся" и «всего» равным 0 и «прошло» равным 0 и «сорвалось» равным 0 и «сорванные» равным пустой список

тотальная функция «Корпус из двух подделок»
  возвращает список «Итог файла корпуса»
  [(«Чистый файл подделки»), («Ложный файл подделки»)]

тотальная функция «Корпус с невзятым»
  возвращает список «Итог файла корпуса»
  [(«Чистый файл подделки»), («Невзятый файл подделки»)]

тотальная функция «Ведомость прогонщика корпуса»
  возвращает список строки
  [
    «Вердикт корпуса» от "довод: файл .flang — это файл, а не корпус" и (не («Довод корпусом» от "flang/stdlib/lists.flang")),
    «Вердикт корпуса» от "довод: каталог — это корпус" и («Довод корпусом» от "flang/stdlib/"),
    «Вердикт корпуса» от "довод: маска — это корпус даже с .flang на конце" и («Довод корпусом» от "flang/examples/**/*.flang"),

    «Вердикт корпуса» от "корень: каталог остаётся собой" и ((«Корень обхода» от "flang/stdlib") равно "flang/stdlib"),
    «Вердикт корпуса» от "корень: косая в конце снимается" и ((«Корень обхода» от "flang/stdlib/") равно "flang/stdlib"),
    «Вердикт корпуса» от "корень: маска обрезается по последней косой" и ((«Корень обхода» от "flang/examples/**/*.flang") равно "flang/examples"),

    «Вердикт корпуса» от "маска: одна звезда не переходит через косую" и (не («Путь под маской» от "flang/*.flang" и "flang/self/lexer.flang")),
    «Вердикт корпуса» от "маска: две звезды переходят через косую" и («Путь под маской» от "flang/examples/**/*.flang" и "flang/examples/leetcode/207.flang"),
    «Вердикт корпуса» от "маска: две звезды берут и нулевой каталог" и («Путь под маской» от "flang/examples/**/*.flang" и "flang/examples/hello.flang"),
    «Вердикт корпуса» от "маска: вопрос — ровно один знак, и не косая" и ((«Путь под маской» от "а?в" и "абв") и притом (не («Путь под маской» от "а?в" и "а/в"))),

    «Вердикт корпуса» от "отбор: не .flang не берётся" и (не («Путь корпуса годен» от "flang/stdlib/README.md" и "flang/stdlib")),
    «Вердикт корпуса» от "отбор: чужое поддерево не берётся" и (не («Путь корпуса годен» от "flang/self/a.flang" и "flang/stdlib")),
    «Вердикт корпуса» от "отбор: порядок не зависит от порядка перечисления" и ((соединить («Отбор корпуса» от ["к/в.flang", "к/а.flang", "к/б.flang"] и "к") по "|") равно "к/а.flang|к/б.flang|к/в.flang"),
    «Вердикт корпуса» от "отбор: мимо корпуса идут .git и node_modules" и (((«Каталоги мимо корпуса») содержит ".git") и притом ((«Каталоги мимо корпуса») содержит "node_modules")),

    «Вердикт корпуса» от "свод: чистый корпус считает файлы и примеры" и ((((«Свести корпус» от "к" и [(«Чистый файл подделки»)] и 0).«всего») равно 2) и притом ((((«Свести корпус» от "к" и [(«Чистый файл подделки»)] и 0).«код») равно 0))),
    «Вердикт корпуса» от "свод: корпус с ложным примером даёт НЕНУЛЕВОЙ код" и (((«Свести корпус» от "к" и («Корпус из двух подделок») и 0).«код») равно 1),
    «Вердикт корпуса» от "свод: упавший файл назван поимённо" и (((«Свести корпус» от "к" и («Корпус из двух подделок») и 0).«замечания») содержит "к/ложный.flang"),
    «Вердикт корпуса» от "свод: назван и упавший пример, и его функция" и (((((«Свести корпус» от "к" и («Корпус из двух подделок») и 0).«замечания») содержит "Заведомо ложный") и притом (((«Свести корпус» от "к" и («Корпус из двух подделок») и 0).«замечания») содержит "Утроить"))),
    «Вердикт корпуса» от "свод: чистый файл в замечания не попадает" и (не (((«Свести корпус» от "к" и («Корпус из двух подделок») и 0).«замечания») содержит "к/чистый.flang")),
    «Вердикт корпуса» от "свод: итог считает оба файла и оба провала" и (((«Свести корпус» от "к" и («Корпус из двух подделок») и 0).«итог») равно "корпус «к»: файлов 2, взято 2, отказано 0, примеров 4, прошло 3, не прошло 1, за 0 мс"),

    «Вердикт корпуса» от "невзятый файл — НЕ чистый корпус" и (((«Свести корпус» от "к" и («Корпус с невзятым») и 0).«код») равно 1),
    «Вердикт корпуса» от "невзятый файл назван словом «не взят», а не нулём примеров" и (((«Свести корпус» от "к" и («Корпус с невзятым») и 0).«замечания») содержит "не взят"),
    «Вердикт корпуса» от "невзятый файл несёт свой код отказа" и (((«Свести корпус» от "к" и («Корпус с невзятым») и 0).«замечания») содержит "FLANG_TYPE"),
    «Вердикт корпуса» от "невзятый файл считается отдельным числом" и (((«Свести корпус» от "к" и («Корпус с невзятым») и 0).«итог») содержит "отказано 1"),

    «Вердикт корпуса» от "JSON: чистый корпус помечен valid" и (((«Свести корпус» от "к" и [(«Чистый файл подделки»)] и 0).«в JSON») содержит "\"valid\":true"),
    «Вердикт корпуса» от "JSON: корпус с провалом помечен не-valid" и (((«Свести корпус» от "к" и («Корпус из двух подделок») и 0).«в JSON») содержит "\"valid\":false"),
    «Вердикт корпуса» от "JSON: упавший пример едет обеими сторонами, какие есть" и (((«Свести корпус» от "к" и («Корпус из двух подделок») и 0).«в JSON») содержит "\"example\":\"Заведомо ложный\""),
    «Вердикт корпуса» от "JSON: невзятый файл помечен taken:false" и (((«Свести корпус» от "к" и («Корпус с невзятым») и 0).«в JSON») содержит "\"taken\":false")
  ]
