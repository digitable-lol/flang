WORDS=$(printf '%s' "$LANGUAGE_WORDS" | tr -d '\n')

LIGHT='|и|с|в|к|у|по|от|не|то|как|из|только|где|да|нет|это|после|затем|сначала|любое|ничто|a|an|of|to|at|by|as|in|into|onto|is|or|and|not|no|yes|true|false|first|next|null|any|'

PARSE_AWK='
BEGIN {
  n = split(words, arr, "|")
  for (i = 1; i <= n; i++) if (arr[i] != "") kw[arr[i]] = 1
  n = split(light, arr, "|")
  for (i = 1; i <= n; i++) if (arr[i] != "") light_set[arr[i]] = 1
  has_lang = 0
  m_words = ""; m_names = ""; m_numbers = ""; m_strings = ""
}
function remember(tok, tag) {
  if (tag == "k") m_words = m_words (m_words == "" ? "" : ", ") tok
  if (tag == "n") m_names = m_names (m_names == "" ? "" : ", ") tok
  if (tag == "c") m_numbers = m_numbers (m_numbers == "" ? "" : ", ") tok
  if (tag == "s") m_strings = m_strings (m_strings == "" ? "" : ", ") tok
}
function paint(tok, tag) {
  remember(tok, tag)
  if (mode == "probe" || mode == "read") return tok
  if (tag == "k") return CW tok RESET
  if (tag == "n") return CN tok RESET
  if (tag == "s") return CS tok RESET
  if (tag == "c") return CNUM tok RESET
  return tok
}
{
  s = $0; out = ""
  if (mode == "code" && substr(s, 1, 4) != "    ") { print s; next }
  while (length(s) > 0) {
    c = substr(s, 1, 1)
    if (index(s, "«") == 1) {
      j = index(s, "»"); if (j == 0) j = length(s)
      out = out paint(substr(s, 1, j), "n"); s = substr(s, j + 1); has_lang = 1; continue
    }
    if (c == "\"") {
      j = index(substr(s, 2), "\""); if (j == 0) j = length(s); else j = j + 1
      out = out paint(substr(s, 1, j), "s"); s = substr(s, j + 1); has_lang = 1; continue
    }
    if (c ~ /[0-9]/) {
      match(s, /^[0-9]+(\.[0-9]+)?/)
      out = out paint(substr(s, 1, RLENGTH), "c"); s = substr(s, RLENGTH + 1); has_lang = 1; continue
    }
    if (c ~ /[][()]/) has_lang = 1
    if (c ~ /[ \t()\[\],:]/) { out = out c; s = substr(s, 2); continue }
    if (match(s, /^[^ \t()\[\],:"]+/) == 0) { out = out c; s = substr(s, 2); continue }
    w1 = substr(s, 1, RLENGTH); rest = substr(s, RLENGTH + 1)
    best = 0; phrase = w1; plen = RLENGTH; r = rest
    for (k = 1; k <= 4; k++) {
      if (phrase in kw) { best = plen; best_phrase = phrase }
      if (match(r, /^ +[^ \t()\[\],:"]+/) == 0) break
      if (index(substr(r, RSTART, RLENGTH), "«") > 0) break
      phrase = phrase substr(r, 1, RLENGTH); plen += RLENGTH; r = substr(r, RLENGTH + 1)
    }
    if (best > 0) {
      if (!(best_phrase in light_set)) has_lang = 1
      out = out paint(substr(s, 1, best), "k"); s = substr(s, best + 1)
    } else { out = out w1; s = rest }
  }
  if (mode != "probe" && mode != "read") print out
}
END {
  if (mode == "probe") exit (has_lang ? 0 : 1)
  if (mode == "read") {
    summary = ""
    if (m_words != "") summary = summary (summary == "" ? "" : "; ") L_WORDS " " m_words
    if (m_names != "") summary = summary (summary == "" ? "" : "; ") L_NAMES " " m_names
    if (m_numbers != "") summary = summary (summary == "" ? "" : "; ") L_NUMBERS " " m_numbers
    if (m_strings != "") summary = summary (summary == "" ? "" : "; ") L_STRINGS " " m_strings
    print summary
  }
}
'
parse() {
  awk -v mode="$1" -v words="$WORDS" -v light="$LIGHT" \
      -v CW="$C_WORD" -v CN="$C_NAME" -v CNUM="$C_NUMBER" -v CS="$C_STRING" -v RESET="$PLAIN" \
      -v L_WORDS="$(phrase 'слова языка:' 'language words:')" -v L_NAMES="$(phrase 'имена:' 'names:')" \
                           -v L_NUMBERS="$(phrase 'числа:' 'numbers:')" -v L_STRINGS="$(phrase 'строки:' 'strings:')" \
                                                  "$PARSE_AWK"
}
what_was_read() {
  printf '%s\n' "$1" | parse read
}
highlight() {
  if [ -n "$C_WORD" ]; then parse paint; else cat; fi
}
highlight_lesson() {
  if [ -n "$C_WORD" ]; then parse code; else cat; fi
}
looks_like_flang() {
  printf '%s\n' "$1" | parse probe
}

in_guillemets() {
  case $1 in
    «*|\"*|\'*) printf '%s\n' "$1" ;;
    *) printf '«%s»\n' "$1" ;;
  esac
}
expects_name() {
  printf '%s\n' "$1" | grep -E -q '(^|[[:space:]])(модуль|функция|тип|объект|запись|теорема|пример|обеспечивает|требует|module|function|type|object|record|theorem|example|ensures|requires)[[:space:]]+___'
}

[ -d "$LESSONS" ] || { say "$(phrase "нет каталога уроков: $LESSONS" "no lesson directory: $LESSONS")" >&2; exit 3; }
LIST=$(/bin/ls "$LESSONS" | grep '\.урок$' | sort)
[ -n "$LIST" ] || { say "$(phrase "в $LESSONS нет ни одного урока" "no lessons in $LESSONS")" >&2; exit 3; }
TOTAL=$(printf '%s\n' "$LIST" | wc -l | tr -d ' ')

section() {
  awk -v m="=$2=" '$0 == m { v = 1; next } /^=[^=]*=$/ { v = 0 } v { print }' "$1"
}
lesson_file() {
  printf '%s\n' "$LIST" | sed -n "$1p" | sed "s|^|$LESSONS/|"
}

PLACE=
if [ -n "${FLANG_TUTOR_STATE+есть}" ]; then
  case ${FLANG_TUTOR_STATE} in
    ''|нет|no|0) PLACE= ;;
    *) PLACE=$FLANG_TUTOR_STATE ;;
  esac
elif [ -n "${XDG_STATE_HOME:-}" ]; then
  PLACE=$XDG_STATE_HOME/flang/tutor
elif [ -n "${HOME:-}" ]; then
  PLACE=$HOME/.local/state/flang/tutor
fi

read_place() {
  [ -n "$PLACE" ] && [ -f "$PLACE" ] || { echo 0; return; }
  z=$(head -1 "$PLACE" 2>/dev/null | tr -dc '0-9')
  [ -n "$z" ] || z=0
  echo "$z"
}
write_place() {
  [ -n "$PLACE" ] || return 0
  mkdir -p "$(dirname "$PLACE")" 2>/dev/null || return 0
  printf '%s\n' "$1" > "$PLACE" 2>/dev/null || return 0
}

if [ "$MODE" = list ]; then
  done_count=$(read_place)
  n=1
  while [ "$n" -le "$TOTAL" ]; do
    f=$(lesson_file "$n")
    mark=
    [ "$n" -le "$done_count" ] && mark=" · $(phrase 'пройден' 'done')"
    printf '%s %s · %s%s\n' "$(phrase урок lesson)" "$n" "$(section "$f" "имя-$OUTPUT_LANG")" "$mark"
    n=$((n + 1))
  done
  if [ "$done_count" -ge "$TOTAL" ]; then
    say "$(phrase "пройдены все $TOTAL; заново: ./flangtutor --сначала" "all $TOTAL done; start over: ./flangtutor --restart")"
  elif [ "$done_count" -gt 0 ]; then
    say "$(phrase "пройдено $done_count из $TOTAL; дальше урок $((done_count + 1)): ./flangtutor" \
                  "$done_count of $TOTAL done; next is lesson $((done_count + 1)): ./flangtutor")"
  fi
  exit 0
fi

[ -x "$BINARY" ] || {
  say "$(phrase "нет двоичного $BINARY — судить ответы нечем. Соберите: make -C bootstrap" \
                "no binary at $BINARY — nothing to judge answers with. Build it: make -C bootstrap")" >&2
  exit 3
}

[ "$MODE" = restart ] && write_place 0
if [ -z "$START" ]; then
  START=$(($(read_place) + 1))
fi
case $START in
  ''|*[!0-9]*) say "flangtutor: номер урока — число, а не «$START»" >&2; exit 2 ;;
esac
[ "$START" -ge 1 ] || START=1
if [ "$START" -gt "$TOTAL" ]; then
  say "$(phrase "все $TOTAL уроков уже пройдены. Начать заново: ./flangtutor --сначала" \
                "all $TOTAL lessons are already done. Start over: ./flangtutor --restart")"
  exit 0
fi

WORK=${FLANG_TMP:-${TMPDIR:-/tmp}}/flangtutor.$$
mkdir -p "$WORK" || { say "$(phrase "негде разложить ответ: $WORK" "nowhere to put the answer: $WORK")" >&2; exit 3; }
trap 'rm -rf "$WORK"' EXIT INT TERM

judge() {
  lesson=$1; answer=$2
  cat "$answer" > "$WORK/lesson.flang"
  printf '\n' >> "$WORK/lesson.flang"
  section "$lesson" хвост >> "$WORK/lesson.flang"

  if ! LC_ALL=C.UTF-8 "$BINARY" check "$WORK/lesson.flang" > "$WORK/check.out" 2>&1; then
    say "$(phrase 'компилятор не принял ответ:' 'the compiler did not accept the answer:')"
    sed "s|$WORK/lesson.flang|$(phrase 'ваш ответ' 'your answer')|g" "$WORK/check.out"
    return 1
  fi

  want=$(section "$lesson" примеров | head -1 | tr -dc '0-9')
  [ -n "$want" ] || want=0
  if [ "$want" -gt 0 ]; then
    LC_ALL=C.UTF-8 "$BINARY" test "$WORK/lesson.flang" > "$WORK/test.out" 2>&1
    got=$(sed -n 's/.*примеров \([0-9]*\),.*/\1/p' "$WORK/test.out" | head -1)
    [ -n "$got" ] || got=0
    if [ "$got" -lt "$want" ]; then
      say "$(phrase "компилятор насчитал примеров: $got, а урок просит хотя бы $want" \
                    "the compiler counted $got example(s); the lesson asks for at least $want")"
      return 1
    fi
  fi

  expect=$(section "$lesson" ждём | head -1)
  value=$(LC_ALL=C.UTF-8 "$BINARY" run "$WORK/lesson.flang" --function '«Проверка урока»' 2>&1)
  if [ "$value" != "$expect" ]; then
    say "$(phrase "проверка урока ждала $expect, а вышло:" "the lesson check expected $expect, and got:")"
    printf '%s\n' "$value" | sed "s|$WORK/lesson.flang|$(phrase 'ваш ответ' 'your answer')|g"
    return 1
  fi

  report_line=$(section "$lesson" отчёт | head -1)
  if [ -n "$report_line" ]; then
    LC_ALL=C.UTF-8 "$BINARY" check "$WORK/lesson.flang" --proof > "$WORK/proof.out" 2>&1
    if ! grep -q -- "$report_line" "$WORK/proof.out"; then
      say "$(phrase "в отчёте о доказательствах нет строки «$report_line». Отчёт говорит:" \
                    "the proof report has no line «$report_line». It says:")"
      sed -n '/^итог:/,$p' "$WORK/proof.out" | sed "s|$WORK/lesson.flang|$(phrase 'ваш ответ' 'your answer')|g"
      return 1
    fi
  fi

  target=$(section "$lesson" печать | head -1 | tr -d ' ')
  if [ -n "$target" ]; then
    rm -rf "$WORK/print"
    if ! LC_ALL=C.UTF-8 "$BINARY" emit "$WORK/lesson.flang" --target "$target" --out "$WORK/print" > "$WORK/emit.out" 2>&1; then
      say "$(phrase "печать в «$target» не удалась:" "printing to «$target» failed:")"
      sed "s|$WORK/lesson.flang|$(phrase 'ваш ответ' 'your answer')|g" "$WORK/emit.out"
      return 1
    fi
    say "$(phrase "напечатано в «$target»: $(head -1 "$WORK/emit.out")" "printed to «$target»: $(head -1 "$WORK/emit.out")")"
  fi
  return 0
}

template() { section "$1" шаблон; }
blanks_in() {
  template "$1" | grep -c '___'
}
blank_kind() {
  template "$1" | grep '___' | sed -n "$2p" | grep -E -q '^[[:space:]]*___[[:space:]]*$' && echo block || echo inline
}
blank_line() {
  template "$1" | grep '___' | sed -n "$2p"
}
blank_function() {
  template "$1" | awk -v n="$2" '
    /функция[ \t]+(«[^»]*»|"[^"]*")/ { f = $0; sub(/.*функция[ \t]+/, "", f); sub(/[ \t].*$/, "", f); gsub(/["«»]/, "", f) }
    /^[^ \t]/ && !/функция/ { f = "" }
    /___/ { k++; if (k == n) { print f; exit } }'
}
show_template() {
  template "$1" | awk '{ while (index($0, "___") > 0) { k++; sub(/___/, "\001" k "\002") } ; print }' \
    | sed 's/^/    /' | highlight | sed "s/$(printf '\001')/${BOLD}⟨/g; s/$(printf '\002')/⟩${PLAIN}/g"
}
assemble() {
  template "$1" | awk -v work="$WORK" '
    /^[[:space:]]*___[[:space:]]*$/ {
      k++; indent = $0; sub(/___.*$/, "", indent)
      f = work "/blank." k
      while ((getline s < f) > 0) {
        if (s == "") print s; else print indent s
      }
      close(f); next
    }
    /___/ {
      k++; f = work "/blank." k; s = ""
      if ((getline s < f) <= 0) s = ""
      close(f); sub(/___/, s); print; next
    }
    { print }'
}
fill_from_lesson() {
  lesson=$1
  count=$(blanks_in "$lesson")
  section "$lesson" впиши > "$WORK/fill"
  n=1; s=1
  while [ "$n" -le "$count" ]; do
    if [ "$(blank_kind "$lesson" "$n")" = inline ]; then
      sed -n "${s}p" "$WORK/fill" > "$WORK/blank.$n"; s=$((s + 1))
    else
      awk -v s="$s" 'NR >= s { if ($0 == ".") { print NR > "/dev/stderr"; exit } print }' "$WORK/fill" \
        > "$WORK/blank.$n" 2> "$WORK/fill.end"
      s=$(($(cat "$WORK/fill.end" 2>/dev/null || echo "$s") + 1))
    fi
    n=$((n + 1))
  done
}

say ""
say "${BOLD}$(phrase "flangtutor — проводник по языку flang" "flangtutor — a guided tour of flang")${PLAIN}"
say "$(phrase "уроков $TOTAL; место запоминается, продолжить можно в любой день." \
              "$TOTAL lessons; your place is kept, come back any day.")"
if [ -n "$NO_LESSONS_IN" ]; then
  say "$(phrase "уроков на «$NO_LESSONS_IN» пока нет — веду по-английски." \
                "no lessons in «$NO_LESSONS_IN» yet — going on in English.")"
fi
[ -n "$PLACE" ] || say "$(phrase "место не запоминается: FLANG_TUTOR_STATE выключил запись." \
                                 "your place is not being kept: FLANG_TUTOR_STATE turned it off.")"

LAST=$TOTAL
[ "$ONLY" = да ] && LAST=$START

dim() { say "${DIM}$*${PLAIN}"; }
hint() {
  section "$1" "подсказки-$OUTPUT_LANG" | sed -n "$2p"
}
prompt() {
  if [ "$3" = inline ]; then
    printf '%s⟨%s⟩ %s%s » ' "$BOLD" "$1" "$2" "$PLAIN"
  elif [ "$4" = да ]; then
    printf '%s⟨%s⟩ %s%s %s(%s)%s\n  » ' "$BOLD" "$1" "$2" "$PLAIN" "$DIM" \
      "$(phrase 'строк может быть несколько; пустая строка или точка — конец' 'several lines are fine; an empty line or a dot ends it')" "$PLAIN"
  else
    printf '  » %s(%s)%s ' "$DIM" "$(phrase 'пустая строка или точка — конец' 'empty line or dot ends it')" "$PLAIN"
  fi
}
dot_command() {
  case $1 in
    .ответ|.answer)
      say ""; dim "$(phrase 'разбор урока — заполненный ответ:' 'a worked answer — the template filled in:')"
      fill_from_lesson "$LESSON"; assemble "$LESSON" | sed 's/^/    /' | highlight; say ""
      return 0 ;;
    .шаблон|.template)
      say ""; show_template "$LESSON"; say ""
      return 0 ;;
    .бросить|.quit|.выход|.exit)
      say "$(phrase "остановились на уроке $NUMBER. Продолжить: ./flangtutor" \
                    "stopped at lesson $NUMBER. Continue with: ./flangtutor")"
      exit 0 ;;
  esac
  return 1
}
input_ended() {
  say "$(phrase "ввод кончился, а урок $NUMBER не пройден." "input ended, and lesson $NUMBER is not done.")" >&2
  exit 1
}

react() {
  line=$1; fn=$2
  if ! looks_like_flang "$line"; then
    dim "  $(phrase "не понял: ни одного слова языка. Это не строка программы, в ответ она не идёт. Вопрос? .ответ покажет разбор урока." \
                    "not understood: not a single word of the language. It is not a line of a program, so it is left out. A question? .answer shows a worked answer.")"
    return 1
  fi
  if [ -n "$fn" ] && printf '%s\n' "$line" | grep -q "^[[:space:]]*[«\"']${fn}[»\"']"; then
    dim "  $(phrase "это вызов самой «$fn» внутри её тела — так функция звала бы сама себя без конца, а вторым телом быть не может. Вызов «$fn» делает «Проверка урока», и её проводник дописывает сам:" \
                    "this calls «$fn» from inside its own body — the function would call itself forever, and a second body is not allowed. «Проверка урока» makes the call, and the tutor appends it itself:")"
    section "$LESSON" хвост | sed 's/^/      /' | highlight
    dim "  $(phrase "строка в ответ не пошла." "the line was left out.")"
    return 1
  fi
  dim "  $(phrase 'понял:' 'read:') $(what_was_read "$line")"
  return 0
}

NUMBER=$START
while [ "$NUMBER" -le "$LAST" ]; do
  LESSON=$(lesson_file "$NUMBER")
  BLANKS=$(blanks_in "$LESSON")
  say ""
  say "${BOLD}$(phrase "урок $NUMBER из $TOTAL" "lesson $NUMBER of $TOTAL") · $(section "$LESSON" "имя-$OUTPUT_LANG")${PLAIN}"
  say ""
  section "$LESSON" "текст-$OUTPUT_LANG" | highlight_lesson
  say ""
  dim "$(phrase "Шаблон ответа — впишите пропуски:" "The answer template — fill in the blanks:")"
  show_template "$LESSON"
  say ""
  dim "$(phrase ".ответ — заполненный разбор; .шаблон — шаблон снова; .бросить — выйти, место запомнится." \
                ".answer — a filled-in answer; .template — the template again; .quit — leave, your place is kept.")"

  SOLVED=нет
  while [ "$SOLVED" = нет ]; do
    N=1
    while [ "$N" -le "$BLANKS" ]; do
      KIND=$(blank_kind "$LESSON" "$N")
      HINT=$(hint "$LESSON" "$N")
      FN=$(blank_function "$LESSON" "$N")
      : > "$WORK/blank.$N"
      FIRST=да
      DONE=нет
      prompt "$N" "$HINT" "$KIND" "$FIRST"
      while [ "$DONE" = нет ]; do
        IFS= read -r LINE || { [ -n "$LINE" ] || input_ended; }
        if dot_command "$LINE"; then prompt "$N" "$HINT" "$KIND" "$FIRST"; continue; fi
        case $LINE in
          .|.готово|.done) LINE= ;;
        esac
        if [ -z "$(printf '%s' "$LINE" | tr -d '[:space:]')" ]; then
          if [ -s "$WORK/blank.$N" ]; then DONE=да
          else dim "  $(phrase 'пропуск пуст — впишите хоть строку.' 'the blank is empty — type at least one line.')"; prompt "$N" "$HINT" "$KIND" "$FIRST"
          fi
          continue
        fi
        if [ "$KIND" = inline ] && expects_name "$(blank_line "$LESSON" "$N")"; then
          GUILLEMETED=$(in_guillemets "$LINE")
          if [ "$GUILLEMETED" != "$LINE" ]; then
            dim "  $(phrase "имя пишется в кавычках — принял как $GUILLEMETED (ёлочки «…» и прямые \"…\" для компилятора одно и то же)." \
                            "a name goes in quotes — took it as $GUILLEMETED (« » and straight \" \" are the same to the compiler).")"
            LINE=$GUILLEMETED
          fi
        fi
        if react "$LINE" "$FN"; then
          printf '%s\n' "$LINE" >> "$WORK/blank.$N"
          FIRST=нет
          [ "$KIND" = inline ] && DONE=да
        fi
        [ "$DONE" = нет ] && prompt "$N" "$HINT" "$KIND" "$FIRST"
      done
      N=$((N + 1))
    done

    assemble "$LESSON" > "$WORK/answer.flang"
    say ""
    dim "$(phrase "ваш ответ целиком, как его прочитал проводник:" "your whole answer, as the tutor read it:")"
    sed 's/^/    /' "$WORK/answer.flang" | highlight
    say ""

    if judge "$LESSON" "$WORK/answer.flang"; then
      SOLVED=да
    else
      say "$(phrase "попробуйте ещё раз — пропуски спрашиваются заново." "try again — the blanks are asked once more.")"
    fi
  done

  say "${BOLD}$(phrase "урок $NUMBER пройден: ответ проверил сам компилятор." \
                       "lesson $NUMBER done: the compiler itself checked the answer.")${PLAIN}"
  write_place "$NUMBER"
  NUMBER=$((NUMBER + 1))
done

say ""
if [ "$LAST" -lt "$TOTAL" ]; then
  say "$(phrase "дальше урок $((LAST + 1)) из $TOTAL: ./flangtutor" \
                "next is lesson $((LAST + 1)) of $TOTAL: ./flangtutor")"
  exit 0
fi
say "${BOLD}$(phrase "все $TOTAL уроков пройдены." "all $TOTAL lessons are done.")${PLAIN}"
say "$(phrase "дальше: flang repl — набирать язык руками; подробный курс — https://digitable-lol.github.io/flang/" \
              "next: flang repl to type the language by hand; a longer course — https://digitable-lol.github.io/flang/en/")"
exit 0
