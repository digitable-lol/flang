# Слова, которых мало, чтобы счесть строку программой: союзы, предлоги и
# частицы, которые есть в любой русской или английской фразе.
LYOGKIE='|и|с|в|к|у|по|от|не|то|как|из|только|где|да|нет|это|после|затем|сначала|любое|ничто|a|an|of|to|at|by|as|in|into|onto|is|or|and|not|no|yes|true|false|first|next|null|any|'

# ── подсветка и суд строки: один разборщик на три дела ──────────────────────
# Разборщик на awk идёт по строке слева направо: имя в ёлочках, строка в
# кавычках, число, слово. Слово сверяется с таблицей фразами до четырёх слов —
# так же, как склеивает лексер. Ни `\b`, ни классов с кириллицей внутри: они
# ломаются в awk, читающем байтами (mawk, awk на BSD), а этот файл едет и туда.
#   rezhim=krasit  красить всё;   rezhim=kod  красить только строки с отступом
#   в четыре пробела (код в тексте урока);   rezhim=sud  выйти нулём, если в
#   строке есть хоть что-то от языка: ёлочки, кавычки, число, скобка или
#   слово таблицы, кроме лёгких;   rezhim=chto  сказать одной строкой, что
#   в ней прочитано — слова языка, имена, числа, строки.
# shellcheck disable=SC2016
RAZBOR_AWK='
BEGIN {
  n = split(slova, arr, "|")
  for (i = 1; i <= n; i++) if (arr[i] != "") kw[arr[i]] = 1
  n = split(lyogkie, arr, "|")
  for (i = 1; i <= n; i++) if (arr[i] != "") lyog[arr[i]] = 1
  yazyk = 0
  m_slova = ""; m_imena = ""; m_chisla = ""; m_stroki = ""
}
function zapomnit(tok, kod) {
  if (kod == "k") m_slova = m_slova (m_slova == "" ? "" : ", ") tok
  if (kod == "n") m_imena = m_imena (m_imena == "" ? "" : ", ") tok
  if (kod == "c") m_chisla = m_chisla (m_chisla == "" ? "" : ", ") tok
  if (kod == "s") m_stroki = m_stroki (m_stroki == "" ? "" : ", ") tok
}
function kraska(tok, kod) {
  zapomnit(tok, kod)
  if (rezhim == "sud" || rezhim == "chto") return tok
  if (kod == "k") return KS tok GOLO
  if (kod == "n") return KI tok GOLO
  if (kod == "s") return KT tok GOLO
  if (kod == "c") return KC tok GOLO
  return tok
}
{
  s = $0; out = ""
  if (rezhim == "kod" && substr(s, 1, 4) != "    ") { print s; next }
  while (length(s) > 0) {
    c = substr(s, 1, 1)
    if (index(s, "«") == 1) {
      j = index(s, "»"); if (j == 0) j = length(s)
      out = out kraska(substr(s, 1, j), "n"); s = substr(s, j + 1); yazyk = 1; continue
    }
    if (c == "\"") {
      j = index(substr(s, 2), "\""); if (j == 0) j = length(s); else j = j + 1
      out = out kraska(substr(s, 1, j), "s"); s = substr(s, j + 1); yazyk = 1; continue
    }
    if (c ~ /[0-9]/) {
      match(s, /^[0-9]+(\.[0-9]+)?/)
      out = out kraska(substr(s, 1, RLENGTH), "c"); s = substr(s, RLENGTH + 1); yazyk = 1; continue
    }
    if (c ~ /[][()]/) yazyk = 1
    if (c ~ /[ \t()\[\],:]/) { out = out c; s = substr(s, 2); continue }
    if (match(s, /^[^ \t()\[\],:"]+/) == 0) { out = out c; s = substr(s, 2); continue }
    w1 = substr(s, 1, RLENGTH); rest = substr(s, RLENGTH + 1)
    best = 0; phrase = w1; plen = RLENGTH; r = rest
    for (k = 1; k <= 4; k++) {
      if (phrase in kw) { best = plen; bestph = phrase }
      if (match(r, /^ +[^ \t()\[\],:"]+/) == 0) break
      if (index(substr(r, RSTART, RLENGTH), "«") > 0) break
      phrase = phrase substr(r, 1, RLENGTH); plen += RLENGTH; r = substr(r, RLENGTH + 1)
    }
    if (best > 0) {
      if (!(bestph in lyog)) yazyk = 1
      out = out kraska(substr(s, 1, best), "k"); s = substr(s, best + 1)
    } else { out = out w1; s = rest }
  }
  if (rezhim != "sud" && rezhim != "chto") print out
}
END {
  if (rezhim == "sud") exit (yazyk ? 0 : 1)
  if (rezhim == "chto") {
    itog = ""
    if (m_slova != "") itog = itog (itog == "" ? "" : "; ") L_SLOVA " " m_slova
    if (m_imena != "") itog = itog (itog == "" ? "" : "; ") L_IMENA " " m_imena
    if (m_chisla != "") itog = itog (itog == "" ? "" : "; ") L_CHISLA " " m_chisla
    if (m_stroki != "") itog = itog (itog == "" ? "" : "; ") L_STROKI " " m_stroki
    print itog
  }
}
'
razobrat() { # режим → фильтр stdin → stdout
  awk -v rezhim="$1" -v slova="$SLOVA" -v lyogkie="$LYOGKIE" \
      -v KS="$K_SLOVO" -v KI="$K_IMYA" -v KC="$K_CHISLO" -v KT="$K_STROKA" -v GOLO="$GOLYY" \
      -v L_SLOVA="$(ryadom 'слова языка:' 'language words:')" -v L_IMENA="$(ryadom 'имена:' 'names:')" \
      -v L_CHISLA="$(ryadom 'числа:' 'numbers:')" -v L_STROKI="$(ryadom 'строки:' 'strings:')" \
      "$RAZBOR_AWK"
}
chto_prochitano() { # строка → одной строкой, что в ней прочитано
  printf '%s\n' "$1" | razobrat chto
}
podsvetit() { # код целиком
  if [ -n "$K_SLOVO" ]; then razobrat krasit; else cat; fi
}
podsvetit_urok() { # текст урока: красятся только строки кода (отступ в четыре пробела)
  if [ -n "$K_SLOVO" ]; then razobrat kod; else cat; fi
}
pohozhe_na_flang() { # строка → 0, если в ней есть хоть что-то от языка
  printf '%s\n' "$1" | razobrat sud
}

# ── имя без кавычек в пропуске после «модуль», «функция», «тип» ─────────────
# Компилятор принял бы и так, но в шаблоне имя стоит в кавычках везде, и
# ответ показывается человеку целиком — пусть и его имя стоит как у всех.
v_yolochki() { # строка → та же в ёлочках, если кавычек нет
  case $1 in
    «*|\"*|\'*) printf '%s\n' "$1" ;;
    *) printf '«%s»\n' "$1" ;;
  esac
}
zhdyot_imya() { # строка шаблона с пропуском → 0, если перед пропуском слово, за которым идёт имя
  printf '%s\n' "$1" | grep -E -q '(^|[[:space:]])(модуль|функция|тип|объект|запись|теорема|пример|обеспечивает|требует|module|function|type|object|record|theorem|example|ensures|requires)[[:space:]]+___'
}

# ── уроки ───────────────────────────────────────────────────────────────────
[ -d "$UROKI" ] || { skazat "$(ryadom "нет каталога уроков: $UROKI" "no lesson directory: $UROKI")" >&2; exit 3; }
SPISOK=$(/bin/ls "$UROKI" | grep '\.урок$' | sort)
[ -n "$SPISOK" ] || { skazat "$(ryadom "в $UROKI нет ни одного урока" "no lessons in $UROKI")" >&2; exit 3; }
VSEGO=$(printf '%s\n' "$SPISOK" | wc -l | tr -d ' ')

razdel() { # файл, метка → строки раздела
  awk -v m="=$2=" '$0 == m { v = 1; next } /^=[^=]*=$/ { v = 0 } v { print }' "$1"
}
urok_fajl() { # номер → путь
  printf '%s\n' "$SPISOK" | sed -n "$1p" | sed "s|^|$UROKI/|"
}

# ── где помнится место: тот же уклад, что у истории оболочки ────────────────
# `FLANG_TUTOR_STATE` называет свой файл; «нет», «no», «0» и пустое значение
# выключают запись вовсе. Умолчание — XDG_STATE_HOME, иначе ~/.local/state.
MESTO=
if [ -n "${FLANG_TUTOR_STATE+есть}" ]; then
  case ${FLANG_TUTOR_STATE} in
    ''|нет|no|0) MESTO= ;;
    *) MESTO=$FLANG_TUTOR_STATE ;;
  esac
elif [ -n "${XDG_STATE_HOME:-}" ]; then
  MESTO=$XDG_STATE_HOME/flang/tutor
elif [ -n "${HOME:-}" ]; then
  MESTO=$HOME/.local/state/flang/tutor
fi

prochitat_mesto() {
  [ -n "$MESTO" ] && [ -f "$MESTO" ] || { echo 0; return; }
  z=$(head -1 "$MESTO" 2>/dev/null | tr -dc '0-9')
  [ -n "$z" ] || z=0
  echo "$z"
}
zapisat_mesto() { # номер пройденного
  [ -n "$MESTO" ] || return 0
  mkdir -p "$(dirname "$MESTO")" 2>/dev/null || return 0
  printf '%s\n' "$1" > "$MESTO" 2>/dev/null || return 0
}

if [ "$REZHIM" = spisok ]; then
  proydeno=$(prochitat_mesto)
  n=1
  while [ "$n" -le "$VSEGO" ]; do
    f=$(urok_fajl "$n")
    otmetka=
    [ "$n" -le "$proydeno" ] && otmetka=" · $(ryadom 'пройден' 'done')"
    printf '%s %s · %s%s\n' "$(ryadom урок lesson)" "$n" "$(razdel "$f" "имя-$YAZYK")" "$otmetka"
    n=$((n + 1))
  done
  if [ "$proydeno" -ge "$VSEGO" ]; then
    skazat "$(ryadom "пройдены все $VSEGO; заново: ./flangtutor --сначала" "all $VSEGO done; start over: ./flangtutor --restart")"
  elif [ "$proydeno" -gt 0 ]; then
    skazat "$(ryadom "пройдено $proydeno из $VSEGO; дальше урок $((proydeno + 1)): ./flangtutor" \
                     "$proydeno of $VSEGO done; next is lesson $((proydeno + 1)): ./flangtutor")"
  fi
  exit 0
fi

[ -x "$BIN" ] || {
  skazat "$(ryadom "нет двоичного $BIN — судить ответы нечем. Соберите: make -C bootstrap" \
                   "no binary at $BIN — nothing to judge answers with. Build it: make -C bootstrap")" >&2
  exit 3
}

[ "$REZHIM" = snachala ] && zapisat_mesto 0
if [ -z "$NACHAT" ]; then
  NACHAT=$(($(prochitat_mesto) + 1))
fi
case $NACHAT in
  ''|*[!0-9]*) skazat "flangtutor: номер урока — число, а не «$NACHAT»" >&2; exit 2 ;;
esac
[ "$NACHAT" -ge 1 ] || NACHAT=1
if [ "$NACHAT" -gt "$VSEGO" ]; then
  skazat "$(ryadom "все $VSEGO уроков уже пройдены. Начать заново: ./flangtutor --сначала" \
                   "all $VSEGO lessons are already done. Start over: ./flangtutor --restart")"
  exit 0
fi

RAB=${FLANG_TMP:-${TMPDIR:-/tmp}}/flangtutor.$$
mkdir -p "$RAB" || { skazat "$(ryadom "негде разложить ответ: $RAB" "nowhere to put the answer: $RAB")" >&2; exit 3; }
trap 'rm -rf "$RAB"' EXIT INT TERM

# ── что говорит компилятор об ответе ────────────────────────────────────────
# Возвращает 0, если ответ сошёлся; иначе печатает, ЧТО именно не сошлось,
# словами компилятора, а не своими.
sudit() { # файл урока, файл ответа
  u=$1; otvet=$2
  cat "$otvet" > "$RAB/urok.flang"
  printf '\n' >> "$RAB/urok.flang"
  razdel "$u" хвост >> "$RAB/urok.flang"

  if ! LC_ALL=C.UTF-8 "$BIN" check "$RAB/urok.flang" > "$RAB/check.out" 2>&1; then
    skazat "$(ryadom 'компилятор не принял ответ:' 'the compiler did not accept the answer:')"
    sed "s|$RAB/urok.flang|$(ryadom 'ваш ответ' 'your answer')|g" "$RAB/check.out"
    return 1
  fi

  nado=$(razdel "$u" примеров | head -1 | tr -dc '0-9')
  [ -n "$nado" ] || nado=0
  if [ "$nado" -gt 0 ]; then
    LC_ALL=C.UTF-8 "$BIN" test "$RAB/urok.flang" > "$RAB/test.out" 2>&1
    est=$(sed -n 's/.*примеров \([0-9]*\),.*/\1/p' "$RAB/test.out" | head -1)
    [ -n "$est" ] || est=0
    if [ "$est" -lt "$nado" ]; then
      skazat "$(ryadom "компилятор насчитал примеров: $est, а урок просит хотя бы $nado" \
                       "the compiler counted $est example(s); the lesson asks for at least $nado")"
      return 1
    fi
  fi

  zhdem=$(razdel "$u" ждём | head -1)
  vyshlo=$(LC_ALL=C.UTF-8 "$BIN" run "$RAB/urok.flang" --function '«Проверка урока»' 2>&1)
  if [ "$vyshlo" != "$zhdem" ]; then
    skazat "$(ryadom "проверка урока ждала $zhdem, а вышло:" "the lesson check expected $zhdem, and got:")"
    printf '%s\n' "$vyshlo" | sed "s|$RAB/urok.flang|$(ryadom 'ваш ответ' 'your answer')|g"
    return 1
  fi

  otchet=$(razdel "$u" отчёт | head -1)
  if [ -n "$otchet" ]; then
    LC_ALL=C.UTF-8 "$BIN" check "$RAB/urok.flang" --proof > "$RAB/proof.out" 2>&1
    if ! grep -q -- "$otchet" "$RAB/proof.out"; then
      skazat "$(ryadom "в отчёте о доказательствах нет строки «$otchet». Отчёт говорит:" \
                       "the proof report has no line «$otchet». It says:")"
      sed -n '/^итог:/,$p' "$RAB/proof.out" | sed "s|$RAB/urok.flang|$(ryadom 'ваш ответ' 'your answer')|g"
      return 1
    fi
  fi

  # Урок о печати в другой язык: ответ обязан ещё и напечататься в названную
  # цель. Судит `flang emit` — он сам проверяет программу перед печатью.
  cel=$(razdel "$u" печать | head -1 | tr -d ' ')
  if [ -n "$cel" ]; then
    rm -rf "$RAB/pechat"
    if ! LC_ALL=C.UTF-8 "$BIN" emit "$RAB/urok.flang" --target "$cel" --out "$RAB/pechat" > "$RAB/emit.out" 2>&1; then
      skazat "$(ryadom "печать в «$cel» не удалась:" "printing to «$cel» failed:")"
      sed "s|$RAB/urok.flang|$(ryadom 'ваш ответ' 'your answer')|g" "$RAB/emit.out"
      return 1
    fi
    skazat "$(ryadom "напечатано в «$cel»: $(head -1 "$RAB/emit.out")" "printed to «$cel»: $(head -1 "$RAB/emit.out")")"
  fi
  return 0
}

# ── шаблон урока и его пропуски ─────────────────────────────────────────────
# Пропуск — `___` в шаблоне. Один на строке (после отступа) — пропуск в
# несколько строк; внутри строки — пропуск в одну строку, `___` заменяется
# набранным. Нумеруются по порядку появления. Ответ человека к пропуску N
# лежит в $RAB/propusk.N; программа собирается из шаблона и этих файлов.
# Отступ строки пропуска ДОБАВЛЯЕТСЯ к каждой набранной строке: человек
# набирает блок так, как он выглядел бы с нулевого столбца, вложенное — на
# два пробела глубже. Так копия из текста урока ложится без правки.
shablon() { razdel "$1" шаблон; }
propuskov() { # файл урока → сколько пропусков
  shablon "$1" | grep -c '___'
}
vid_propuska() { # файл урока, номер → stroki | vstavka
  shablon "$1" | grep '___' | sed -n "$2p" | grep -E -q '^[[:space:]]*___[[:space:]]*$' && echo stroki || echo vstavka
}
stroka_propuska() { # файл урока, номер → строка шаблона с этим пропуском
  shablon "$1" | grep '___' | sed -n "$2p"
}
funkciya_propuska() { # файл урока, номер → имя функции, в теле которой стоит пропуск (если стоит)
  shablon "$1" | awk -v n="$2" '
    /функция[ \t]+(«[^»]*»|"[^"]*")/ { f = $0; sub(/.*функция[ \t]+/, "", f); sub(/[ \t].*$/, "", f); gsub(/["«»]/, "", f) }
    /^[^ \t]/ && !/функция/ { f = "" }
    /___/ { k++; if (k == n) { print f; exit } }'
}
pokazat_shablon() { # файл урока → шаблон на экран, пропуски пронумерованы
  shablon "$1" | awk '{ while (index($0, "___") > 0) { k++; sub(/___/, "\001" k "\002") } ; print }' \
    | sed 's/^/    /' | podsvetit | sed "s/$(printf '\001')/${ZHIRNYY}⟨/g; s/$(printf '\002')/⟩${GOLYY}/g"
}
sobrat() { # файл урока → программа из шаблона и заполненных пропусков, в stdout
  shablon "$1" | awk -v rab="$RAB" '
    /^[[:space:]]*___[[:space:]]*$/ {
      k++; otstup = $0; sub(/___.*$/, "", otstup)
      f = rab "/propusk." k
      while ((getline s < f) > 0) {
        if (s == "") print s; else print otstup s
      }
      close(f); next
    }
    /___/ {
      k++; f = rab "/propusk." k; s = ""
      if ((getline s < f) <= 0) s = ""
      close(f); sub(/___/, s); print; next
    }
    { print }'
}
zapolnit_iz_uroka() { # файл урока → пропуски из раздела «впиши» (разбор урока)
  u=$1
  vsego=$(propuskov "$u")
  razdel "$u" впиши > "$RAB/vpishi"
  n=1; s=1
  while [ "$n" -le "$vsego" ]; do
    if [ "$(vid_propuska "$u" "$n")" = vstavka ]; then
      sed -n "${s}p" "$RAB/vpishi" > "$RAB/propusk.$n"; s=$((s + 1))
    else
      awk -v s="$s" 'NR >= s { if ($0 == ".") { print NR > "/dev/stderr"; exit } print }' "$RAB/vpishi" \
        > "$RAB/propusk.$n" 2> "$RAB/vpishi.konec"
      s=$(($(cat "$RAB/vpishi.konec" 2>/dev/null || echo "$s") + 1))
    fi
    n=$((n + 1))
  done
}

# ── работа ──────────────────────────────────────────────────────────────────
skazat ""
skazat "${ZHIRNYY}$(ryadom "flangtutor — проводник по языку flang" "flangtutor — a guided tour of flang")${GOLYY}"
skazat "$(ryadom "уроков $VSEGO; место запоминается, продолжить можно в любой день." \
                 "$VSEGO lessons; your place is kept, come back any day.")"
if [ -n "$NET_UROKOV_NA" ]; then
  skazat "$(ryadom "уроков на «$NET_UROKOV_NA» пока нет — веду по-английски." \
                   "no lessons in «$NET_UROKOV_NA» yet — going on in English.")"
fi
[ -n "$MESTO" ] || skazat "$(ryadom "место не запоминается: FLANG_TUTOR_STATE выключил запись." \
                                    "your place is not being kept: FLANG_TUTOR_STATE turned it off.")"

KONEC_NA=$VSEGO
[ "$TOLKO" = да ] && KONEC_NA=$NACHAT

tusklo() { skazat "${TUSKLYY}$*${GOLYY}"; }
podskazka() { # файл урока, номер пропуска → подсказка на выбранном языке
  razdel "$1" "подсказки-$YAZYK" | sed -n "$2p"
}
priglashenie() { # номер, подсказка, вид, первая ли строка
  if [ "$3" = vstavka ]; then
    printf '%s⟨%s⟩ %s%s » ' "$ZHIRNYY" "$1" "$2" "$GOLYY"
  elif [ "$4" = да ]; then
    printf '%s⟨%s⟩ %s%s %s(%s)%s\n  » ' "$ZHIRNYY" "$1" "$2" "$GOLYY" "$TUSKLYY" \
      "$(ryadom 'строк может быть несколько; пустая строка или точка — конец' 'several lines are fine; an empty line or a dot ends it')" "$GOLYY"
  else
    printf '  » %s(%s)%s ' "$TUSKLYY" "$(ryadom 'пустая строка или точка — конец' 'empty line or dot ends it')" "$GOLYY"
  fi
}
vyyti_ili_dalshe() { # команда из точки → 0, если это была команда
  case $1 in
    .ответ|.answer)
      skazat ""; tusklo "$(ryadom 'разбор урока — заполненный ответ:' 'a worked answer — the template filled in:')"
      zapolnit_iz_uroka "$U"; sobrat "$U" | sed 's/^/    /' | podsvetit; skazat ""
      return 0 ;;
    .шаблон|.template)
      skazat ""; pokazat_shablon "$U"; skazat ""
      return 0 ;;
    .бросить|.quit|.выход|.exit)
      skazat "$(ryadom "остановились на уроке $NOMER. Продолжить: ./flangtutor" \
                       "stopped at lesson $NOMER. Continue with: ./flangtutor")"
      exit 0 ;;
  esac
  return 1
}
vvod_konchilsya() {
  skazat "$(ryadom "ввод кончился, а урок $NOMER не пройден." "input ended, and lesson $NOMER is not done.")" >&2
  exit 1
}

# Реакция на одну набранную строку: 0 — строка принята, иначе нет.
# Что понято, говорится словами разборщика; что не так — по трём приметам.
reakciya() { # строка, функция пропуска
  st=$1; fn=$2
  if ! pohozhe_na_flang "$st"; then
    tusklo "  $(ryadom "не понял: ни одного слова языка. Это не строка программы, в ответ она не идёт. Вопрос? .ответ покажет разбор урока." \
                       "not understood: not a single word of the language. It is not a line of a program, so it is left out. A question? .answer shows a worked answer.")"
    return 1
  fi
  if [ -n "$fn" ] && printf '%s\n' "$st" | grep -q "^[[:space:]]*[«\"']${fn}[»\"']"; then
    tusklo "  $(ryadom "это вызов самой «$fn» внутри её тела — так функция звала бы сама себя без конца, а вторым телом быть не может. Вызов «$fn» делает «Проверка урока», и её проводник дописывает сам:" \
                       "this calls «$fn» from inside its own body — the function would call itself forever, and a second body is not allowed. «Проверка урока» makes the call, and the tutor appends it itself:")"
    razdel "$U" хвост | sed 's/^/      /' | podsvetit
    tusklo "  $(ryadom "строка в ответ не пошла." "the line was left out.")"
    return 1
  fi
  tusklo "  $(ryadom 'понял:' 'read:') $(chto_prochitano "$st")"
  return 0
}

NOMER=$NACHAT
while [ "$NOMER" -le "$KONEC_NA" ]; do
  U=$(urok_fajl "$NOMER")
  PROPUSKOV=$(propuskov "$U")
  skazat ""
  skazat "${ZHIRNYY}$(ryadom "урок $NOMER из $VSEGO" "lesson $NOMER of $VSEGO") · $(razdel "$U" "имя-$YAZYK")${GOLYY}"
  skazat ""
  razdel "$U" "текст-$YAZYK" | podsvetit_urok
  skazat ""
  tusklo "$(ryadom "Шаблон ответа — впишите пропуски:" "The answer template — fill in the blanks:")"
  pokazat_shablon "$U"
  skazat ""
  tusklo "$(ryadom ".ответ — заполненный разбор; .шаблон — шаблон снова; .бросить — выйти, место запомнится." \
                   ".answer — a filled-in answer; .template — the template again; .quit — leave, your place is kept.")"

  SOSHLOS=нет
  while [ "$SOSHLOS" = нет ]; do
    N=1
    while [ "$N" -le "$PROPUSKOV" ]; do
      VID=$(vid_propuska "$U" "$N")
      PODSKAZKA=$(podskazka "$U" "$N")
      FN=$(funkciya_propuska "$U" "$N")
      : > "$RAB/propusk.$N"
      PERVAYA=да
      GOTOV=нет
      priglashenie "$N" "$PODSKAZKA" "$VID" "$PERVAYA"
      while [ "$GOTOV" = нет ]; do
        IFS= read -r STROKA || { [ -n "$STROKA" ] || vvod_konchilsya; }
        if vyyti_ili_dalshe "$STROKA"; then priglashenie "$N" "$PODSKAZKA" "$VID" "$PERVAYA"; continue; fi
        case $STROKA in
          .|.готово|.done) STROKA= ;;
        esac
        if [ -z "$(printf '%s' "$STROKA" | tr -d '[:space:]')" ]; then
          if [ -s "$RAB/propusk.$N" ]; then GOTOV=да
          else tusklo "  $(ryadom 'пропуск пуст — впишите хоть строку.' 'the blank is empty — type at least one line.')"; priglashenie "$N" "$PODSKAZKA" "$VID" "$PERVAYA"
          fi
          continue
        fi
        if [ "$VID" = vstavka ] && zhdyot_imya "$(stroka_propuska "$U" "$N")"; then
          NOVAYA=$(v_yolochki "$STROKA")
          if [ "$NOVAYA" != "$STROKA" ]; then
            tusklo "  $(ryadom "имя пишется в кавычках — принял как $NOVAYA (ёлочки «…» и прямые \"…\" для компилятора одно и то же)." \
                               "a name goes in quotes — took it as $NOVAYA (« » and straight \" \" are the same to the compiler).")"
            STROKA=$NOVAYA
          fi
        fi
        if reakciya "$STROKA" "$FN"; then
          printf '%s\n' "$STROKA" >> "$RAB/propusk.$N"
          PERVAYA=нет
          [ "$VID" = vstavka ] && GOTOV=да
        fi
        [ "$GOTOV" = нет ] && priglashenie "$N" "$PODSKAZKA" "$VID" "$PERVAYA"
      done
      N=$((N + 1))
    done

    sobrat "$U" > "$RAB/otvet.flang"
    skazat ""
    tusklo "$(ryadom "ваш ответ целиком, как его прочитал проводник:" "your whole answer, as the tutor read it:")"
    sed 's/^/    /' "$RAB/otvet.flang" | podsvetit
    skazat ""

    if sudit "$U" "$RAB/otvet.flang"; then
      SOSHLOS=да
    else
      skazat "$(ryadom "попробуйте ещё раз — пропуски спрашиваются заново." "try again — the blanks are asked once more.")"
    fi
  done

  skazat "${ZHIRNYY}$(ryadom "урок $NOMER пройден: ответ проверил сам компилятор." \
                              "lesson $NOMER done: the compiler itself checked the answer.")${GOLYY}"
  zapisat_mesto "$NOMER"
  NOMER=$((NOMER + 1))
done

skazat ""
if [ "$KONEC_NA" -lt "$VSEGO" ]; then
  skazat "$(ryadom "дальше урок $((KONEC_NA + 1)) из $VSEGO: ./flangtutor" \
                   "next is lesson $((KONEC_NA + 1)) of $VSEGO: ./flangtutor")"
  exit 0
fi
skazat "${ZHIRNYY}$(ryadom "все $VSEGO уроков пройдены." "all $VSEGO lessons are done.")${GOLYY}"
skazat "$(ryadom "дальше: flang repl — набирать язык руками; подробный курс — https://digitable-lol.github.io/flang/" \
                 "next: flang repl to type the language by hand; a longer course — https://digitable-lol.github.io/flang/en/")"
exit 0
