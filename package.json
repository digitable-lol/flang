{
  "name": "@digitable/fts",
  "version": "0.4.0",
  "description": "Formal Type Surface: executable specifications that generate utilities, tests, and machine-checkable evidence.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "bin": {
    "fts": "./dist/src/cli.js",
    "fts-mcp": "./dist/src/mcp.js",
    "ftsc": "./tools/ftsc/bin/ftsc.mjs",
    "ftsvm": "./tools/ftsvm/bin/ftsvm.mjs",
    "ftspec": "./tools/ftspec/bin/ftspec.mjs"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js"
    },
    "./schema": "./schema/document.schema.json",
    "./proof-schema": "./schema/proof-certificate.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "docs",
    "schema",
    "examples",
    "tools",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:core && npm run test:tools",
    "test:source": "node --experimental-strip-types --test test/**/*.test.ts",
    "test:core": "npm run build && node --test dist/test/*.test.js",
    "test:tools": "node --test tools/*/test/*.test.mjs",
    "test:tools:core": "node --test tools/ftsc/test/core.test.mjs tools/ftsc/test/self-check.test.mjs tools/ftsc/test/toolchain-guard.test.mjs tools/ftspec/test/*.test.mjs tools/ftsvm/test/*.test.mjs",
    "test:backends": "npm run build && node --test tools/ftsc/test/emit-*.test.mjs",
    "test:fast": "npm run test:core && npm run test:tools:core",
    "test:ftsc": "npm run build && node --test tools/ftsc/test/*.test.mjs",
    "test:ftsvm": "npm run build && node --test tools/ftsvm/test/*.test.mjs",
    "test:ftspec": "npm run build && node --test tools/ftspec/test/*.test.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:quick": "npm run build && node scripts/benchmark.mjs --quick",
    "benchmark:ftsvm": "npm run build && node tools/ftsvm/bin/ftsvm.mjs bench",
    "prepublishOnly": "npm test",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "domain-specific-language",
    "russian-language",
    "formal-methods",
    "proof-carrying-data",
    "category-theory",
    "mcp",
    "ai-agents"
  ]
}
