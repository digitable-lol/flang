{
  "name": "@digitable/fts",
  "version": "0.3.0",
  "description": "Formal Type Surface: executable specifications that generate utilities, tests, and machine-checkable evidence.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "bin": {
    "fts": "./dist/src/cli.js",
    "fts-mcp": "./dist/src/mcp.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js"
    },
    "./schema": "./schema/document.schema.json",
    "./proof-schema": "./schema/proof-certificate.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "docs",
    "schema",
    "examples",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:source": "node --experimental-strip-types --test test/**/*.test.ts",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:quick": "npm run build && node scripts/benchmark.mjs --quick",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "domain-specific-language",
    "russian-language",
    "formal-methods",
    "proof-carrying-data",
    "category-theory",
    "mcp",
    "ai-agents"
  ]
}
