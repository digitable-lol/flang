{
  "name": "@digitable-lol/flang",
  "version": "0.5.0",
  "description": "flang: проверяемый язык с тотальными и обычными функциями, ядром доказательств на нуле аксиом и печатью в C, Go, Rust, Python, Java, C#, Elixir и JavaScript.",
  "type": "module",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitable-lol/flang.git"
  },
  "homepage": "https://github.com/digitable-lol/flang#readme",
  "bugs": {
    "url": "https://github.com/digitable-lol/flang/issues"
  },
  "bin": {
    "flang": "./packaging/flang-zapusk.mjs",
    "flang-lsp": "./flang/bin/flang-lsp.mjs"
  },
  "files": [
    "flang/bin",
    "flang/src",
    "flang/core",
    "flang/stdlib",
    "flang/examples",
    "flang/cat",
    "flang/conc",
    "flang/proof",
    "flang/SPEC.md",
    "flang/core/SPEC.md",
    "bootstrap",
    "packaging/flang.1",
    "packaging/postinstall.mjs",
    "packaging/flang-zapusk.mjs",
    "packaging/sverka-ustanovok.flang",
    "README.md",
    "README.ru.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "changelog.json",
    "LICENSE",
    "LICENSE-RU.md",
    "!**/test",
    "!**/*.test.mjs"
  ],
  "scripts": {
    "postinstall": "node packaging/postinstall.mjs",
    "license:check": "node scripts/check-licensing.mjs",
    "claims:check": "node flang/scripts/claim-guard.mjs",
    "counts:check": "node flang/scripts/count-guard.mjs",
    "spec:check": "node fspec/guard.mjs",
    "codes:check": "node flang/scripts/code-guard.mjs",
    "memory:check": "node flang/scripts/memory-guard.mjs",
    "emit:check": "node flang/scripts/emit-guard.mjs",
    "comparison:check": "node flang/scripts/comparison-guard.mjs",
    "tmp:check": "node flang/scripts/tempdir-guard.mjs",
    "occupied:check": "node flang/scripts/target-occupied-guard.mjs",
    "proof:ledger": "node flang/scripts/proof-ledger.mjs",
    "proof:search": "node flang/scripts/proof-search.mjs",
    "word:occupancy": "node flang/scripts/word-occupancy.mjs",
    "names:check": "node flang/scripts/name-guard.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "changelog:check": "node scripts/build-changelog.mjs --check && node scripts/build-changelog.mjs --self-test",
    "changelog:page": "node scripts/build-changelog-page.mjs",
    "changelog:page:check": "node scripts/build-changelog-page.mjs --check",
    "releases:page": "node scripts/build-releases-page.mjs",
    "releases:page:check": "node scripts/build-releases-page.mjs --check",
    "links:check": "node scripts/link-guard.mjs",
    "site": "node docs/site/build.mjs",
    "site:check": "node docs/site/build.mjs --check",
    "bootstrap": "node scripts/bootstrap-c.mjs",
    "bootstrap:check": "node scripts/bootstrap-c.mjs --check",
    "preflight": "node scripts/preflight.mjs",
    "pretest": "node scripts/preflight.mjs",
    "test": "node --test --test-timeout=1800000 flang/test/*.test.mjs",
    "test:remote": "bash scripts/test-remote.sh",
    "pretest:backends": "node scripts/preflight.mjs",
    "test:backends": "node --test --test-timeout=1800000 flang/test/emit-*.test.mjs flang/test/self-emit-*.test.mjs",
    "glossary": "node docs/site/glossary.mjs",
    "glossary:check": "node docs/site/glossary.mjs --check",
    "surfaces:run": "node docs/site/surfaces-run.mjs",
    "surfaces:check": "node docs/site/surfaces-run.mjs --check",
    "numbers": "node docs/site/site-numbers.mjs --write",
    "numbers:check": "node docs/site/site-numbers.mjs --check",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "flang",
    "programming-language",
    "totality-checking",
    "formal-methods",
    "proof-carrying-data",
    "category-theory",
    "russian-language",
    "ai-agents"
  ]
}
