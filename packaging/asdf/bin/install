#!/usr/bin/env bash
# Сборка и установка.
#
# Флаги сборки не смягчаются: -Werror -pedantic — часть контракта бэкенда,
# напечатанный код обязан собираться без единого предупреждения. Ослабить их
# здесь значило бы скрыть от себя же, что печать испортилась.
set -euo pipefail

: "${ASDF_INSTALL_TYPE:?}"
: "${ASDF_INSTALL_VERSION:?}"
: "${ASDF_INSTALL_PATH:?}"
: "${ASDF_DOWNLOAD_PATH:?}"

if [ "$ASDF_INSTALL_TYPE" != "version" ]; then
  echo "плагин ставит только выпущенные версии: из ветки собрать нельзя," >&2
  echo "потому что в репозитории компилятор лежит исходником на самом flang," >&2
  echo "и чтобы получить из него первый бинарник, нужен Node." >&2
  exit 1
fi

build="$(mktemp -d)"
trap 'rm -rf "$build"' EXIT
cp -R "${ASDF_DOWNLOAD_PATH}/." "$build"

jobs="${ASDF_CONCURRENCY:-1}"
make -C "$build" -j "$jobs" CFLAGS="-std=c99 -Wall -Wextra -Werror -pedantic -O2"

# У программы одно имя — `flang`, и с 0.5.1 его даёт уже сама сборка: `make`
# кладёт рядом `flang`, а не `flang_cli`. Прежнее имя принимается тоже, потому
# что архив релиза несёт СВОЙ Makefile: плагин обязан ставить и архив, собранный
# до переименования.
# Имя переменной английское, а не русское: POSIX-shell берёт в имена только
# латиницу и подчёркивание, и `собрано=…` он читает как команду. Поймано прогоном.
built="${build}/flang"
[ -x "$built" ] || built="${build}/flang_cli"

mkdir -p "${ASDF_INSTALL_PATH}/bin" "${ASDF_INSTALL_PATH}/lib" "${ASDF_INSTALL_PATH}/include"
install -m 0755 "$built" "${ASDF_INSTALL_PATH}/bin/flang"
# Библиотека зовётся по имени модуля компилятора, а имя это менялось: до 0.5.2
# модуль звался «Компилятор flang» и печать давала `libkompilyator_flang.a`,
# с 0.5.2 он «Compiler flang» и печать даёт `libcompiler_flang.a` (транслит в
# имени файла — нарушение docs/guide/naming.ru.md, и чинился он в имени модуля).
# Плагин ставит выпущенные версии, а среди них есть и те и другие, поэтому
# берётся ЛЮБОЙ архив, какой собрал make: имя ищется, а не пишется.
# Заголовки ставятся звёздочкой и потому переименования не заметили вовсе.
for archive in "${build}"/lib*.a; do
  [ -f "$archive" ] || continue
  install -m 0644 "$archive" "${ASDF_INSTALL_PATH}/lib/"
done
install -m 0644 "${build}"/*.h "${ASDF_INSTALL_PATH}/include/"

# Проверяем не «запустился», а «понял язык»: подаём модуль и требуем, чтобы
# компилятор насчитал в нём ровно одну связанную функцию. Битая установка
# обязана падать здесь, а не у человека при первом запуске.
probe='{"fn":"Число связанных функций","args":[{"l":[{"r":[["путь",{"s":"проба.flang"}],["текст",{"s":"модуль «Проба»\n\nтотальная функция «Два»\n  возвращает число\n  2\n"}]]}]},{"s":"проба.flang"}]}'
answer="$(printf '%s\n' "$probe" | "${ASDF_INSTALL_PATH}/bin/flang")"
case "$answer" in
  *'"ok":true'*'"n":"1"'*) : ;;
  *) echo "собранный компилятор ответил не то: ${answer}" >&2; exit 1 ;;
esac

# И человеческий вход — отдельной пробой, потому что он отдельная дорога.
# Проверяется ровно то, что человек наберёт первым: `flang --help` и
# `flang --version`. До 0.5.1 первый отвечал «непонятный ключ» на стороне Node,
# и разойтись эти две стороны могут снова.
if ! "${ASDF_INSTALL_PATH}/bin/flang" --version | grep -q "flang ${ASDF_INSTALL_VERSION}"; then
  echo "flang --version назвал не ту версию" >&2
  exit 1
fi
if ! "${ASDF_INSTALL_PATH}/bin/flang" --help | grep -q "flang check"; then
  echo "flang --help не напечатал справку" >&2
  exit 1
fi

echo "flang ${ASDF_INSTALL_VERSION} установлен: flang --help, flang — оболочка"
