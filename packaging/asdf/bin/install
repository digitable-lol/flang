#!/usr/bin/env bash
# Сборка и установка.
#
# Флаги сборки не смягчаются: -Werror -pedantic — часть контракта бэкенда,
# напечатанный код обязан собираться без единого предупреждения. Ослабить их
# здесь значило бы скрыть от себя же, что печать испортилась.
set -euo pipefail

: "${ASDF_INSTALL_TYPE:?}"
: "${ASDF_INSTALL_VERSION:?}"
: "${ASDF_INSTALL_PATH:?}"
: "${ASDF_DOWNLOAD_PATH:?}"

if [ "$ASDF_INSTALL_TYPE" != "version" ]; then
  echo "плагин ставит только выпущенные версии: из ветки собрать нельзя," >&2
  echo "потому что в репозитории компилятор лежит исходником на самом flang," >&2
  echo "и чтобы получить из него первый бинарник, нужен Node." >&2
  exit 1
fi

build="$(mktemp -d)"
trap 'rm -rf "$build"' EXIT
cp -R "${ASDF_DOWNLOAD_PATH}/." "$build"

jobs="${ASDF_CONCURRENCY:-1}"
make -C "$build" -j "$jobs" CFLAGS="-std=c99 -Wall -Wextra -Werror -pedantic -O2"

# У программы одно имя — `flang`, и с 0.5.1 его даёт уже сама сборка: `make`
# кладёт рядом `flang`, а не `flang_cli`. Прежнее имя принимается тоже, потому
# что архив релиза несёт СВОЙ Makefile: плагин обязан ставить и архив, собранный
# до переименования.
# Имя переменной английское, а не русское: POSIX-shell берёт в имена только
# латиницу и подчёркивание, и `собрано=…` он читает как команду. Поймано прогоном.
built="${build}/flang"
[ -x "$built" ] || built="${build}/flang_cli"

mkdir -p "${ASDF_INSTALL_PATH}/bin" "${ASDF_INSTALL_PATH}/lib" "${ASDF_INSTALL_PATH}/include"
install -m 0755 "$built" "${ASDF_INSTALL_PATH}/bin/flang"
# Библиотека зовётся по имени модуля компилятора, а имя это менялось: до 0.5.2
# модуль звался «Компилятор flang» и печать давала `libkompilyator_flang.a`,
# с 0.5.2 он «Compiler flang» и печать даёт `libcompiler_flang.a` (транслит в
# имени файла — нарушение docs/guide/naming.ru.md, и чинился он в имени модуля).
# Плагин ставит выпущенные версии, а среди них есть и те и другие, поэтому
# берётся ЛЮБОЙ архив, какой собрал make: имя ищется, а не пишется.
# Заголовки ставятся звёздочкой и потому переименования не заметили вовсе.
for archive in "${build}"/lib*.a; do
  [ -f "$archive" ] || continue
  install -m 0644 "$archive" "${ASDF_INSTALL_PATH}/lib/"
done
install -m 0644 "${build}"/*.h "${ASDF_INSTALL_PATH}/include/"

# ИСХОДНИКИ РАНТАЙМА ВСЕХ ДЕВЯТИ ЦЕЛЕЙ — без них `flang emit --target <цель>` не
# работает у поставившего вовсе. Печать кладёт файлы рантайма в вывод ДОСЛОВНО,
# то есть читает их с диска, и ищет в `share/flang/<цель>` рядом с бинарником
# (`emit_runtime_dir` в flang/src/emit/c/flang_repl.c).
#
# ДО 5 СЕНТЯБРЯ 2026 СТАВИЛАСЬ ОДНА ЦЕЛЬ ИЗ ДЕВЯТИ: плагин клал `runtime-c` в
# `share/flang/c`, и `--target js`, `--target go` и шесть остальных отвечали
# поставившему «не найдены исходники рантайма», хотя обещаны и в `man`, и в
# обоих README, и в справке двоичного (задача 7261).
#
# Верхние файлы архива для этого НЕ ГОДЯТСЯ, хотя имена те же: наверху лежат
# напечатанные копии — с шапкой «Сгенерировано flang» в первой строке, — и
# печать их отвергает по делу. Рукописные оригиналы едут каталогом
# `runtime/<цель>/`; имя названо в scripts/release-in-c.flang.
#
# КОПИРУЕТСЯ КОРЕНЬ ЦЕЛИКОМ, А НЕ ПОЦЕЛЬНО: у восьми целей поиск рантайма
# смотрит в каталог ЦЕЛИ (`share/flang/go`), а у `cpp` — в КОРЕНЬ
# `share/flang`, потому что три файла из четырёх он берёт из `c/`, и только
# своё «лицо» `cpp/flang_cpp.hpp` — из `cpp/` (задача 8460).
#
# Оба условия — не осторожность, а совместимость: плагин ставит и выпущенные
# версии, а в архивах 0.5.3—0.7.11 лежит `runtime-c` с одной целью, в архивах до
# 0.5.3 нет и его.
if [ -d "${build}/runtime" ]; then
  mkdir -p "${ASDF_INSTALL_PATH}/share/flang"
  cp -R "${build}"/runtime/* "${ASDF_INSTALL_PATH}/share/flang/"
  find "${ASDF_INSTALL_PATH}/share/flang" -type f -exec chmod 0644 {} +
  find "${ASDF_INSTALL_PATH}/share/flang" -type d -exec chmod 0755 {} +
elif [ -d "${build}/runtime-c" ]; then
  mkdir -p "${ASDF_INSTALL_PATH}/share/flang/c"
  install -m 0644 "${build}"/runtime-c/* "${ASDF_INSTALL_PATH}/share/flang/c/"
fi

# Проверяем не «запустился», а «понял язык»: подаём модуль и требуем, чтобы
# компилятор насчитал в нём ровно одну связанную функцию. Битая установка
# обязана падать здесь, а не у человека при первом запуске.
probe='{"fn":"Число связанных функций","args":[{"l":[{"r":[["путь",{"s":"проба.flang"}],["текст",{"s":"модуль «Проба»\n\nтотальная функция «Два»\n  возвращает число\n  2\n"}]]}]},{"s":"проба.flang"}]}'
answer="$(printf '%s\n' "$probe" | "${ASDF_INSTALL_PATH}/bin/flang")"
case "$answer" in
  *'"ok":true'*'"n":"1"'*) : ;;
  *) echo "собранный компилятор ответил не то: ${answer}" >&2; exit 1 ;;
esac

# И человеческий вход — отдельной пробой, потому что он отдельная дорога.
# Проверяется ровно то, что человек наберёт первым: `flang --help` и
# `flang --version`. До 0.5.1 первый отвечал «непонятный ключ» на стороне Node,
# и разойтись эти две стороны могут снова.
if ! "${ASDF_INSTALL_PATH}/bin/flang" --version | grep -q "flang ${ASDF_INSTALL_VERSION}"; then
  echo "flang --version назвал не ту версию" >&2
  exit 1
fi
if ! "${ASDF_INSTALL_PATH}/bin/flang" --help | grep -q "flang check"; then
  echo "flang --help не напечатал справку" >&2
  exit 1
fi

# И ПЕЧАТЬ — то, ради чего половина ставит язык, и ровно то, что не работало
# ни у одного поставившего. Проверяется только если рантайм в архиве был: на
# версиях до 0.5.3 его нет, и требовать от них печати значило бы отказать в
# установке тому, кто ставит старую версию нарочно.
if [ -d "${ASDF_INSTALL_PATH}/share/flang/c" ]; then
  probe_dir="$(mktemp -d)"
  printf 'модуль «Проба»\n\nтотальная функция «Два»\n  возвращает число\n  2\n' > "${probe_dir}/проба.flang"
  if ! "${ASDF_INSTALL_PATH}/bin/flang" emit "${probe_dir}/проба.flang" --target c --out "${probe_dir}/нет-такого/каталога" 2>&1; then
    echo "установленный flang не печатает в C: рантайм в share/flang/c не подошёл" >&2
    rm -rf "$probe_dir"
    exit 1
  fi
  if [ ! -f "${probe_dir}/нет-такого/каталога/flang_runtime.c" ]; then
    echo "flang emit отчитался успехом, но файлов не положил" >&2
    rm -rf "$probe_dir"
    exit 1
  fi

  # ВСЕ ОСТАЛЬНЫЕ ЦЕЛИ — и в них весь смысл этой проверки. Пока щупалась одна
  # цель, восемь остальных отваливались молча: плагин ставил рантайм одного `c`,
  # а проба была зелена. Потом целей стало две, `c` и `js`, — и семь оставшихся
  # по-прежнему могли отвалиться, не покраснев.
  #
  # СПИСОК ЦЕЛЕЙ СПРАШИВАЕТСЯ У ПОСТАВЛЕННОГО ДВОИЧНОГО, а не выписывается
  # здесь: он называет их сам (`EMIT_TARGETS_WORDS` в flang_repl.c) и печатает в
  # справке. Выписанная копия отстала бы молча при десятой цели — плагин ставил
  # бы её, проба бы её не щупала, и всё повторилось бы.
  #
  # ОТБОР ВЕДЁТСЯ ПО ASCII, хотя строка справки русская: `grep` по `--target` и
  # по палке берёт ровно поле `c|cpp|go|…`, и работать это обязано в любой
  # локали, какая окажется у ставящего. Кириллический образец здесь зависел бы
  # от локали, а её плагин не выбирает.
  #
  # УСЛОВИЕ СМОТРИТ НА АРХИВ, А НЕ НА УСТАНОВКУ, и разница здесь решает всё.
  # Спроси мы `[ -d "${ASDF_INSTALL_PATH}/share/flang/js" ]` — проба молча
  # пропускала бы ровно тот случай, ради которого заведена: рантайм не лёг,
  # каталога нет, условие ложно, проверка не звучит, установка зелена. Проверено
  # прогоном: с таким условием снятый `share/flang/js` дал зелёный ответ.
  # Архив же знает правду: есть в нём `runtime/` — значит цели обещаны все
  # девять, и не лечь они не имеют права. Старые архивы (0.5.3—0.7.11 с
  # `runtime-c`) сюда не заходят вовсе, и отказать в их установке проба не может.
  #
  # Имена переменных латиницей — по той же причине, что и `built` выше: русское
  # имя оболочка читает командой, а не присваиванием.
  if [ -d "${build}/runtime" ]; then
    targets="$("${ASDF_INSTALL_PATH}/bin/flang" --help | grep -- '--target' | tr ' ' '\n' | grep '|' | tr '|' ' ')"
    n_targets="$(printf '%s\n' $targets | grep -c .)"
    # ДЛИНА СПИСКА ПРОВЕРЯЕТСЯ ДО ЦИКЛА: справка, из которой ничего не
    # вычиталось, дала бы список ПУСТОЙ, цикл не выполнился бы ни разу, и проба
    # зазеленела бы, не пощупав ничего. Ровно тот способ соврать, ради которого
    # эта проверка и переписана.
    if [ "$n_targets" -lt 9 ]; then
      echo "flang --help назвал целей печати: ${n_targets}, а их девять — справка разошлась с пробой" >&2
      rm -rf "$probe_dir"
      exit 1
    fi
    for cel in $targets; do
      if ! "${ASDF_INSTALL_PATH}/bin/flang" emit "${probe_dir}/проба.flang" --target "$cel" --out "${probe_dir}/нет-такого/$cel" 2>&1; then
        echo "установленный flang не печатает в ${cel}: рантайма нет в share/flang/${cel}" >&2
        rm -rf "$probe_dir"
        exit 1
      fi
      # Не «код ноль», а «файлы легли»: печать, отчитавшаяся успехом и не
      # положившая ничего, — это отказ, который поставивший увидит первым.
      if [ -z "$(ls -A "${probe_dir}/нет-такого/$cel" 2>/dev/null)" ]; then
        echo "flang emit --target ${cel} отчитался успехом, но файлов не положил" >&2
        rm -rf "$probe_dir"
        exit 1
      fi
    done
    # Раскладка целиком: у каждой названной цели свой каталог под общим корнем.
    # Число проверялось и прежде, но ЧИСЛО НЕ ЕСТЬ СОСТАВ: девять каталогов с
    # чужими именами дали бы то же самое. Корень нужен цели `cpp` — она
    # отсчитывает пути от него, а не от своего каталога.
    for cel in $targets; do
      if [ ! -d "${ASDF_INSTALL_PATH}/share/flang/$cel" ]; then
        echo "в share/flang нет каталога цели ${cel}, а двоичный в неё печатает" >&2
        rm -rf "$probe_dir"
        exit 1
      fi
    done
    legli=$(find "${ASDF_INSTALL_PATH}/share/flang" -mindepth 1 -maxdepth 1 -type d | wc -l)
    if [ "$legli" -ne "$n_targets" ]; then
      echo "в share/flang легло каталогов целей: ${legli}, а печать обещает ${n_targets}" >&2
      rm -rf "$probe_dir"
      exit 1
    fi
  fi
  rm -rf "$probe_dir"
fi

echo "flang ${ASDF_INSTALL_VERSION} установлен: flang --help, flang — оболочка"
