#!/usr/bin/env bash
# Версии flang — те релизы на GitHub, у которых ЕСТЬ архив.
#
# Спрашиваем ИМЕННО релизы, а не теги: тег может стоять на коммите, для которого
# архива нет, и тогда установка упадёт уже после того, как человек выбрал
# версию. Список, из которого нельзя поставить, хуже короткого.
#
# Но релиза мало, и это измерено. 18 августа 2026: v0.4.8 — настоящий релиз,
# аннотированный тег владельца, 129 коммитов после v0.4.7, прямой предок v0.5.0,
# — и НИ ОДНОГО вложения. Отбор по тегам его не ловил, потому что релиз есть;
# «asdf list-all flang» предлагал 0.4.8, а «asdf install flang 0.4.8» падал с 404
# на скачивании. Совет в сообщении об ошибке при этом кольцевой: он отсылает к
# этому самому списку, который 0.4.8 и предложил.
#
# Отсюда правило: версия попадает в список тогда и только тогда, когда у релиза
# есть архив, который скачает bin/download. Проверяем не «релиз существует», а
# «архив отдаётся», — то есть ровно то условие, от которого зависит установка.
#
# Берём для этого поле browser_download_url: оно есть только у настоящего
# вложения, и в нём уже записан тот самый адрес, который bin/download соберёт из
# версии. Совпадение проверяется буквой в букву, без доверия к тому, что мы
# «наверное, соберём такой же».
#
# jq намеренно не нужен. README плагина обещает: на машине нужны компилятор C и
# make, больше ничего. Затащить сюда jq значило бы сделать README ложью — а
# плагин ставят как раз затем, чтобы не тащить чужих зависимостей.
#
# Имена переменных латиницей намеренно. Оболочка требует ASCII в именах, а
# кириллическое имя она читает как команду и отвечает «command not found» —
# ошибка на ровном месте, которая уже случалась в этом проекте (в workflow
# публикации). Комментарии и сообщения при этом остаются русскими: их читает
# человек, а не оболочка.
set -euo pipefail

repo="digitable-lol/flang"
# Адрес можно подменить — этим пользуется flang/test/asdf-list-all.test.mjs,
# чтобы прогнать отбор на заготовленном ответе без сети. curl понимает file://,
# поэтому подмена не требует ни сервера, ни заглушки самого скрипта: проверяется
# тот же код, который поедет пользователю.
query="${FLANG_RELEASES_URL:-https://api.github.com/repos/${repo}/releases?per_page=100}"

# Токен не обязателен, но без него GitHub даёт 60 запросов в час на адрес.
headers=(-sSL)
if [ -n "${GITHUB_API_TOKEN:-}" ]; then
  headers+=(-H "Authorization: token ${GITHUB_API_TOKEN}")
fi

curl "${headers[@]}" "$query" \
  | grep -o '"browser_download_url": *"[^"]*/download/v[0-9][^"/]*/flang-[0-9][^"/]*-c\.tar\.gz"' \
  | sed 's|.*/download/v\([^"/]*\)/flang-\([^"/]*\)-c\.tar\.gz"|\1 \2|' \
  | awk '$1 == $2 { print $1 }' \
  | sort -u \
  | sort -t. -k1,1n -k2,2n -k3,3n \
  | tr '\n' ' '
echo
