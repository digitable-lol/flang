#!/usr/bin/env bash
# Версии flang — релизы на GitHub.
#
# Спрашиваем ИМЕННО релизы, а не теги: тег может стоять на коммите, для которого
# архива нет, и тогда установка упадёт уже после того, как человек выбрал
# версию. Список, из которого нельзя поставить, хуже короткого.
#
# Имена переменных латиницей намеренно. Оболочка требует ASCII в именах, а
# кириллическое имя она читает как команду и отвечает «command not found» —
# ошибка на ровном месте, которая уже случалась в этом проекте (в workflow
# публикации). Комментарии и сообщения при этом остаются русскими: их читает
# человек, а не оболочка.
set -euo pipefail

repo="digitable-lol/flang"
query="https://api.github.com/repos/${repo}/releases?per_page=100"

# Токен не обязателен, но без него GitHub даёт 60 запросов в час на адрес.
headers=(-sSL)
if [ -n "${GITHUB_API_TOKEN:-}" ]; then
  headers+=(-H "Authorization: token ${GITHUB_API_TOKEN}")
fi

curl "${headers[@]}" "$query" \
  | grep -o '"tag_name": *"v[^"]*"' \
  | sed 's/.*"v\([^"]*\)".*/\1/' \
  | sort -t. -k1,1n -k2,2n -k3,3n \
  | tr '\n' ' '
echo
