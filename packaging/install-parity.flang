модуль «Сверка двух установок»

// ЧТО ЭТО. Программа, которая берёт ДВЕ установки flang и гоняет их по одному и
// тому же списку вызовов, сверяя код возврата, вывод и поток ошибок. Ответ —
// одно число: сколько вызовов разошлись.
//
// ЗАЧЕМ. Человек, поставивший язык через brew, и человек, поставивший через npm,
// получали разные программы. За один вечер владелец нашёл четыре расхождения в
// одной команде `emit`. «Пакет собрался» этого не ловит вовсе; ловит только
// прогон обеих установок на одном корпусе.
//
// ПОЧЕМУ НА FLANG, А НЕ НА JAVASCRIPT. Здесь ничего не мешает: запуск процесса —
// обычное поручение языка («Запустить процесс»), а сравнение трёх строк — обычная
// чистая функция. Программа ничего не выполняет сама: каждая строка ниже строит
// ЗНАЧЕНИЕ, описывающее действие, и потому проверяется обычным примером. Обе
// установки читают эту программу одинаково — сверено побайтово.
//
// КАК ЗАПУСКАТЬ:
//
//   flang io packaging/install-parity.flang --max-orders 4000
//
// Рядом обязан лежать файл `sverka-nastroyka.txt` — шесть строк:
//
//   1  чем звать первую установку          /usr/local/bin/flang
//   2  что дописать первой перед доводами  (пусто, если ничего)
//   3  чем звать вторую установку          /usr/bin/node
//   4  что дописать второй перед доводами  /путь/flang/bin/flang.mjs
//   5  корень корпуса                      каталог, где лежит flang/stdlib
//   6  рабочий каталог                     куда можно писать
//
// Вторая строка нужна затем, что одну установку зовут прямо, а другую — через
// Node с путём к входному файлу. Без неё пришлось бы городить обёртку на
// оболочке, а это ровно тот javascript-по-соседству, которого здесь избегают.
//
// ОТВЕТ. Число расхождений. Ноль означает, что две установки — это один
// компилятор. Всё, что больше нуля, названо поимённо в журнале поручений.

// ── корпус ───────────────────────────────────────────────────────────────────
//
// Правило корпуса взято из разбора `docs/zettel/spravka-bliznetsa-otstayot-tam-
// gde-korpus-idyot-s-klyuchom.md`: у КАЖДОЙ команды обязан быть голый вызов, без
// единого ключа. На чужом ключе одна сторона отказывает раньше, чем доходит до
// имени команды, и расхождение в самой команде остаётся невидимым.
//
// «Голый» здесь означает «без единого ключа», но С ФАЙЛОМ. Совсем без доводов
// звать нельзя: реализация на Node без файла идёт читать стандартный ввод и
// висит до тридцатисекундного срока хозяина — сверка повисла бы, а не
// покраснела. Измерено: на вызове `["check"]` план сдавался с
// FLANG_IO_TIMEOUT. По той же причине не зовётся `repl`: он открывает оболочку.
//
// «КОРЕНЬ» и «РАБОЧИЙ» — места подстановки; их заменяет «Подставить».
тотальная функция «Корпус»
  возвращает список (список строки)
  обеспечивает «длина постоянного списка — Корпус» (длина результат) равен 60
  [
    ["--version"],
    ["--help"],

    ["check", "--help"],
    ["test", "--help"],
    ["run", "--help"],
    ["emit", "--help"],
    ["ast", "--help"],
    ["facts", "--help"],
    ["io", "--help"],
    ["lock", "--help"],
    ["package", "--help"],
    ["repl", "--help"],

    ["ЭТОЙ-КОМАНДЫ-НЕТ"],
    ["check", "РАБОЧИЙ/net-takogo.flang"],
    ["test", "РАБОЧИЙ/net-takogo.flang"],
    ["run", "РАБОЧИЙ/net-takogo.flang"],
    ["emit", "РАБОЧИЙ/net-takogo.flang"],
    ["ast", "РАБОЧИЙ/net-takogo.flang"],
    ["facts", "РАБОЧИЙ/net-takogo.flang"],
    ["io", "РАБОЧИЙ/net-takogo.flang"],
    ["lock", "РАБОЧИЙ/net-takogo.flang"],
    ["package", "РАБОЧИЙ/net-takogo.flang"],

    ["check", "КОРЕНЬ/flang/stdlib/lists.flang"],
    ["check", "КОРЕНЬ/flang/stdlib/strings.flang"],
    ["check", "КОРЕНЬ/flang/stdlib/optional.flang"],
    ["check", "КОРЕНЬ/flang/stdlib/logic.flang"],
    ["check", "КОРЕНЬ/flang/stdlib/lists.flang", "--proof"],
    ["check", "КОРЕНЬ/flang/stdlib/optional.flang", "--proof"],
    ["check", "КОРЕНЬ/flang/stdlib/logic.flang", "--proof"],

    ["test", "КОРЕНЬ/flang/stdlib/lists.flang"],
    ["test", "КОРЕНЬ/flang/stdlib/strings.flang"],
    ["test", "КОРЕНЬ/flang/stdlib/optional.flang"],

    ["ast", "КОРЕНЬ/flang/stdlib/optional.flang"],
    ["ast", "КОРЕНЬ/flang/stdlib/logic.flang"],

    ["lock", "КОРЕНЬ/flang/stdlib/optional.flang"],
    ["lock", "КОРЕНЬ/flang/stdlib/logic.flang"],

    ["package", "КОРЕНЬ/flang/stdlib/optional.flang"],

    ["run", "КОРЕНЬ/flang/stdlib/logic.flang", "--function", "«Не»"],
    ["run", "КОРЕНЬ/flang/stdlib/logic.flang", "--function", "«Не»", "--args", "{\"значение\":true}"],
    ["run", "КОРЕНЬ/flang/stdlib/lists.flang", "--function", "«Длина»", "--args", "{\"элементы\":[1,2,3]}"],
    ["run", "КОРЕНЬ/flang/stdlib/lists.flang", "--function", "«Нет такой»", "--args", "{}"],

    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "c"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "c", "--out", "РАБОЧИЙ/vyvod-novyy"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "cpp"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "js"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "go"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "rust"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "python"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "java"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "csharp"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "elixir"],
    ["emit", "КОРЕНЬ/flang/stdlib/logic.flang", "--target", "нетакой"],

    ["check", "РАБОЧИЙ/neproshedshiy.flang"],
    ["test", "РАБОЧИЙ/neproshedshiy.flang"],
    ["check", "РАБОЧИЙ/krivoy.flang"],
    ["test", "РАБОЧИЙ/krivoy.flang"],
    ["ast", "РАБОЧИЙ/krivoy.flang"],

    ["check", "КОРЕНЬ/flang/stdlib/lists.flang", "--ключа-такого-нет"],
    ["check", "КОРЕНЬ/flang/stdlib/lists.flang", "--proof", "--json"]
  ]

// Размер корпуса стоит отдельной функцией с примером, а не комментарием: у
// самого корпуса примера быть не может (ожидаемым значением пришлось бы выписать
// весь список целиком), и без этой строки корпус мог бы усохнуть незамеченным.
тотальная функция «Сколько вызовов»
  возвращает число
  обеспечивает «вызовов в корпусе шестьдесят» результат равен 60
  пример «в корпусе шестьдесят вызовов»
    ожидается 60
  длина «Корпус»

// Программа, которая проверку проходит, а один пример не сдаёт. Ради неё в
// корпусе стоят `check` и `test`: владелец назвал расхождение «`flang test` у
// одного печатает полученное значение, у другого молчит», и увидеть его можно
// только на непрошедшем примере.
тотальная функция «Непрошедший исходник»
  возвращает строка
  обеспечивает «непрошедший исходник: в постоянной стоит слово» результат содержит "«Непрошедший»"
  обеспечивает «непрошедший исходник: длина постоянной» (длина результат) равен 158
  пример «первая строка называет модуль»
    ожидается "модуль «Непрошедший»\n\nтотальная функция «Удвоить»\n  принимает н: число\n  возвращает число\n  пример «два»\n    дано н равно 2\n    ожидается 5\n  н умножить на 2\n"
  "модуль «Непрошедший»\n\nтотальная функция «Удвоить»\n  принимает н: число\n  возвращает число\n  пример «два»\n    дано н равно 2\n    ожидается 5\n  н умножить на 2\n"

// Программа, которая не проходит типы. Ради неё в корпусе стоит `check`: тексты
// отказов — второе из четырёх названных владельцем расхождений.
тотальная функция «Кривой исходник»
  возвращает строка
  обеспечивает «кривой исходник: в постоянной стоит слово» результат содержит "возвращает"
  обеспечивает «кривой исходник: длина постоянной» (длина результат) равен 133
  пример «первая строка называет модуль»
    ожидается "модуль «Кривой»\n\nтотальная функция «Ф»\n  принимает н: число\n  возвращает строка\n  пример «н»\n    дано н равно 0\n    ожидается \"\"\n  н\n"
  "модуль «Кривой»\n\nтотальная функция «Ф»\n  принимает н: число\n  возвращает строка\n  пример «н»\n    дано н равно 0\n    ожидается \"\"\n  н\n"

// ── настройка ────────────────────────────────────────────────────────────────

тотальная функция «Строки настройки»
  принимает вход: строка
  возвращает список строки
  пример «шесть строк разбираются по переводу строки»
    дано вход равно "а\nб\nв\nг\nд\nе"
    ожидается ["а", "б", "в", "г", "д", "е"]
  разделить вход по "\n"

тотальная функция «Поле настройки»
  принимает вход: строка, номер: число
  возвращает строка
  обеспечивает «за концом настройки — пустая строка» если номер больше (длина («Строки настройки» от вход)) то результат равен "" иначе да
  обеспечивает «в пределах настройки поле берётся из её строк» если не (номер больше (длина («Строки настройки» от вход))) то результат равен (элемент номер в («Строки настройки» от вход)) иначе да
  пример «первое поле — чем звать первую установку»
    дано вход равно "flang\n\nnode\ncli.mjs\n/корень\n/работа"
    дано номер равно 1
    ожидается "flang"
  пример «второе поле пустое, если приставки нет»
    дано вход равно "flang\n\nnode\ncli.mjs\n/корень\n/работа"
    дано номер равно 2
    ожидается ""
  пример «за концом настройки — пустая строка, а не отказ»
    дано вход равно "flang"
    дано номер равно 4
    ожидается ""
  пусть строки равно «Строки настройки» от вход
  если номер больше (длина строки)
    то ""
    иначе элемент номер в строки

// ── подстановка мест ─────────────────────────────────────────────────────────

тотальная функция «Подставить»
  принимает образец: строка, корень: строка, рабочий: строка
  возвращает строка
  пример «корень встаёт на место»
    дано образец равно "КОРЕНЬ/flang/stdlib/lists.flang"
    дано корень равно "/дерево"
    дано рабочий равно "/работа"
    ожидается "/дерево/flang/stdlib/lists.flang"
  пример «рабочий каталог встаёт на место»
    дано образец равно "РАБОЧИЙ/vyvod"
    дано корень равно "/дерево"
    дано рабочий равно "/работа"
    ожидается "/работа/vyvod"
  пример «строка без мест подстановки остаётся собой»
    дано образец равно "--proof"
    дано корень равно "/дерево"
    дано рабочий равно "/работа"
    ожидается "--proof"
  соединить (разделить (соединить (разделить образец по "КОРЕНЬ") по корень) по "РАБОЧИЙ") по рабочий

тотальная функция «Доводы»
  принимает вызов: список строки, приставка: строка, корень: строка, рабочий: строка
  возвращает список строки
  обеспечивает «пустая приставка ничего не добавляет» если (длина приставка) равен 0 то результат равен (отобразить вызов как кусок → «Подставить» от кусок и корень и рабочий) иначе да
  обеспечивает «непустая приставка встаёт первой» если не ((длина приставка) равен 0) то результат равен (приписать приставка к (отобразить вызов как кусок → «Подставить» от кусок и корень и рабочий)) иначе да
  пример «пустая приставка ничего не добавляет»
    дано вызов равно ["check", "КОРЕНЬ/а.flang"]
    дано приставка равно ""
    дано корень равно "/дерево"
    дано рабочий равно "/работа"
    ожидается ["check", "/дерево/а.flang"]
  пример «приставка встаёт первой»
    дано вызов равно ["check", "КОРЕНЬ/а.flang"]
    дано приставка равно "/пакет/flang/bin/flang.mjs"
    дано корень равно "/дерево"
    дано рабочий равно "/работа"
    ожидается ["/пакет/flang/bin/flang.mjs", "check", "/дерево/а.flang"]
  пусть готовые равно отобразить вызов как кусок → «Подставить» от кусок и корень и рабочий
  если (длина приставка) равен 0
    то готовые
    иначе приписать приставка к готовые

// ── сравнение ────────────────────────────────────────────────────────────────

тотальная функция «Разошлись»
  принимает код: число, вывод: строка, ошибки: строка, «второй код»: число, «второй вывод»: строка, «вторые ошибки»: строка
  возвращает признак
  обеспечивает «первая ветвь — Разошлись» если не (код равен «второй код») то (результат равен (да)) иначе да
  обеспечивает «второй ярус ряда иначе — Разошлись» если не (не (код равен «второй код»)) то (если не (вывод равно «второй вывод») то (результат равен (да)) иначе да) иначе да
  обеспечивает «разошлись: первая ветвь» если не (код равен «второй код») то результат равен да иначе да
  обеспечивает «третий ярус ряда иначе — Разошлись» если не (не (код равен «второй код»)) то (если не (не (вывод равно «второй вывод»)) то (результат равен (не (ошибки равно «вторые ошибки»))) иначе да) иначе да
  пример «всё совпало — расхождения нет»
    дано код равно 0
    дано вывод равно "а"
    дано ошибки равно ""
    дано «второй код» равно 0
    дано «второй вывод» равно "а"
    дано «вторые ошибки» равно ""
    ожидается нет
  пример «разошёлся код возврата»
    дано код равно 0
    дано вывод равно "а"
    дано ошибки равно ""
    дано «второй код» равно 1
    дано «второй вывод» равно "а"
    дано «вторые ошибки» равно ""
    ожидается да
  пример «разошёлся вывод»
    дано код равно 0
    дано вывод равно "а"
    дано ошибки равно ""
    дано «второй код» равно 0
    дано «второй вывод» равно "б"
    дано «вторые ошибки» равно ""
    ожидается да
  пример «разошёлся поток ошибок»
    дано код равно 0
    дано вывод равно "а"
    дано ошибки равно ""
    дано «второй код» равно 0
    дано «второй вывод» равно "а"
    дано «вторые ошибки» равно "беда"
    ожидается да
  если не (код равен «второй код»)
    то да
    иначе если не (вывод равно «второй вывод»)
      то да
      иначе не (ошибки равно «вторые ошибки»)

тотальная функция «Строка расхождения»
  принимает вызов: список строки, код: число, вывод: строка, ошибки: строка, «второй код»: число, «второй вывод»: строка, «вторые ошибки»: строка
  возвращает строка
  пример «строка называет вызов и обе стороны»
    дано вызов равно ["check", "а.flang"]
    дано код равно 0
    дано вывод равно "аб"
    дано ошибки равно ""
    дано «второй код» равно 1
    дано «второй вывод» равно "в"
    дано «вторые ошибки» равно "гд"
    ожидается "РАСХОЖДЕНИЕ | check а.flang | код 0 против 1 | вывод 2 против 1 | ошибки 0 против 2"
  соединить ["РАСХОЖДЕНИЕ | ", (соединить вызов по " "), " | код ", (к строке код), " против ", (к строке «второй код»), " | вывод ", (к строке (длина вывод)), " против ", (к строке (длина «второй вывод»)), " | ошибки ", (к строке (длина ошибки)), " против ", (к строке (длина «вторые ошибки»))] по ""

тотальная функция «Строка итога»
  принимает расхождений: число
  возвращает строка
  пример «итог называет оба числа»
    дано расхождений равно 4
    ожидается "ИТОГ | вызовов 60 | расхождений 4"
  соединить ["ИТОГ | вызовов ", (к строке («Сколько вызовов»)), " | расхождений ", (к строке расхождений)] по ""

// ── состояние плана ──────────────────────────────────────────────────────────
//
// Продолжение записано значением, а не замыканием: замыканий в языке нет, и
// «что делать дальше» здесь названо вариантом. Настройка едет строкой через все
// состояния — так плану не нужен ни один изменяемый ящик.
тип «Ход»
  вариант «Читаем настройку»
  вариант «Кладём непрошедший»
  вариант «Кладём кривой» содержит вход: строка
  вариант «Зовём первого» содержит вход: строка, номер: число, расхождений: число
  вариант «Зовём второго» содержит вход: строка, номер: число, расхождений: число
  вариант «Сравниваем» содержит вход: строка, номер: число, расхождений: число, код: число, вывод: строка, ошибки: строка
  вариант «Кончаем» содержит расхождений: число

тотальная функция «Начать»
  возвращает «Ход»
  обеспечивает «ход начинается вариантом Читаем настройку» результат равен (вариант «Читаем настройку»)
  пример «план начинается с чтения настройки»
    ожидается вариант «Читаем настройку»
  вариант «Читаем настройку»

// Позвать первую установку на вызове с номером — или, если корпус кончился,
// напечатать итог и остановиться.
тотальная функция «Позвать первого»
  принимает вход: строка, номер: число, расхождений: число
  возвращает «Продолжение»
  обеспечивает «первая ветвь — Позвать первого» если номер больше («Сколько вызовов») то (результат равен (вариант «Сделать» с поручение равным (вариант «Показать» с место равным "stdout" и текст равным («Строка итога» от расхождений)) и потом равным (вариант «Кончаем» с расхождений равным расхождений))) иначе да
  обеспечивает «позвать первого: первая ветвь» если номер больше («Сколько вызовов») то результат равен (вариант «Сделать» с поручение равным (вариант «Показать» с место равным "stdout" и текст равным («Строка итога» от расхождений)) и потом равным (вариант «Кончаем» с расхождений равным расхождений)) иначе да
  обеспечивает «вызов из корпуса уходит первой установке» если не (номер больше («Сколько вызовов»)) то результат равен (вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Поле настройки» от вход и 1) и аргументы равным («Доводы» от (элемент номер в «Корпус») и («Поле настройки» от вход и 2) и («Поле настройки» от вход и 5) и («Поле настройки» от вход и 6))) и потом равным (вариант «Зовём второго» с вход равным вход и номер равным номер и расхождений равным расхождений)) иначе да
  пример «корпус кончился — печатается итог»
    дано вход равно "flang\n\nnode\nб.mjs\n/д\n/р"
    дано номер равно 61
    дано расхождений равно 0
    ожидается вариант «Сделать» с поручение равным (вариант «Показать» с место равным "stdout" и текст равным "ИТОГ | вызовов 60 | расхождений 0") и потом равным (вариант «Кончаем» с расхождений равным 0)
  пример «первый вызов уходит первой установке»
    дано вход равно "flang\n\nnode\nб.mjs\n/д\n/р"
    дано номер равно 1
    дано расхождений равно 0
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "flang" и аргументы равным ["--version"]) и потом равным (вариант «Зовём второго» с вход равным "flang\n\nnode\nб.mjs\n/д\n/р" и номер равным 1 и расхождений равным 0)
  если номер больше («Сколько вызовов»)
    то вариант «Сделать» с поручение равным (вариант «Показать» с место равным "stdout" и текст равным («Строка итога» от расхождений)) и потом равным (вариант «Кончаем» с расхождений равным расхождений)
    иначе вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Поле настройки» от вход и 1) и аргументы равным («Доводы» от (элемент номер в «Корпус») и («Поле настройки» от вход и 2) и («Поле настройки» от вход и 5) и («Поле настройки» от вход и 6))) и потом равным (вариант «Зовём второго» с вход равным вход и номер равным номер и расхождений равным расхождений)

// Первая установка ответила — тот же вызов уходит второй, а её ответ едет в
// состоянии до сравнения.
тотальная функция «Позвать второго»
  принимает вход: строка, номер: число, расхождений: число, отклик: «Отклик»
  возвращает «Продолжение»
  обеспечивает «ответ первой установки едет в состоянии до сравнения» если отклик равен (вариант «Процесс завершён» с код равным 0 и вывод равным "" и ошибки равным "") то результат равен (вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Поле настройки» от вход и 3) и аргументы равным («Доводы» от (элемент номер в «Корпус») и («Поле настройки» от вход и 4) и («Поле настройки» от вход и 5) и («Поле настройки» от вход и 6))) и потом равным (вариант «Сравниваем» с вход равным вход и номер равным номер и расхождений равным расхождений и код равным 0 и вывод равным "" и ошибки равным "")) иначе да
  пример «ответ первой установки едет дальше в состоянии»
    дано вход равно "flang\n\nnode\nб.mjs\n/д\n/р"
    дано номер равно 1
    дано расхождений равно 0
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "0.5.0\n" и ошибки равным ""
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "node" и аргументы равным ["б.mjs", "--version"]) и потом равным (вариант «Сравниваем» с вход равным "flang\n\nnode\nб.mjs\n/д\n/р" и номер равным 1 и расхождений равным 0 и код равным 0 и вывод равным "0.5.0\n" и ошибки равным "")
  пример «первая установка убита — план сдаётся, а не считает это совпадением»
    дано вход равно "flang\n\nnode\nб.mjs\n/д\n/р"
    дано номер равно 1
    дано расхождений равно 0
    дано отклик равно вариант «Процесс убит» с сигнал равным "SIGKILL" и вывод равным "" и ошибки равным ""
    ожидается вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "первая установка не завершилась сама на вызове 1"
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Поле настройки» от вход и 3) и аргументы равным («Доводы» от (элемент номер в «Корпус») и («Поле настройки» от вход и 4) и («Поле настройки» от вход и 5) и («Поле настройки» от вход и 6))) и потом равным (вариант «Сравниваем» с вход равным вход и номер равным номер и расхождений равным расхождений и код равным код и вывод равным вывод и ошибки равным ошибки)
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным (соединить ["первая установка не завершилась сама на вызове ", (к строке номер)] по "")

// Обе ответили. Разошлись — печатается строка про этот вызов и счётчик растёт;
// совпали — сразу следующий вызов, без лишнего поручения.
тотальная функция «Сравнить»
  принимает вход: строка, номер: число, расхождений: число, код: число, вывод: строка, ошибки: строка, отклик: «Отклик»
  возвращает «Продолжение»
  пример «совпало — сразу следующий вызов»
    дано вход равно "flang\n\nnode\nб.mjs\n/д\n/р"
    дано номер равно 1
    дано расхождений равно 0
    дано код равно 0
    дано вывод равно "0.5.0\n"
    дано ошибки равно ""
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "0.5.0\n" и ошибки равным ""
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "flang" и аргументы равным ["--help"]) и потом равным (вариант «Зовём второго» с вход равным "flang\n\nnode\nб.mjs\n/д\n/р" и номер равным 2 и расхождений равным 0)
  пример «разошлось — печатается строка и счётчик растёт»
    дано вход равно "flang\n\nnode\nб.mjs\n/д\n/р"
    дано номер равно 1
    дано расхождений равно 0
    дано код равно 0
    дано вывод равно "flang 0.5.0\n"
    дано ошибки равно ""
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "0.5.0\n" и ошибки равным ""
    ожидается вариант «Сделать» с поручение равным (вариант «Показать» с место равным "stdout" и текст равным "РАСХОЖДЕНИЕ | --version | код 0 против 0 | вывод 12 против 6 | ошибки 0 против 0") и потом равным (вариант «Зовём первого» с вход равным "flang\n\nnode\nб.mjs\n/д\n/р" и номер равным 2 и расхождений равным 1)
  пример «вторая установка убита — план сдаётся»
    дано вход равно "flang\n\nnode\nб.mjs\n/д\n/р"
    дано номер равно 1
    дано расхождений равно 0
    дано код равно 0
    дано вывод равно ""
    дано ошибки равно ""
    дано отклик равно вариант «Процесс убит» с сигнал равным "SIGKILL" и вывод равным "" и ошибки равным ""
    ожидается вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "вторая установка не завершилась сама на вызове 1"
  разбор отклик
    случай вариант «Процесс завершён» с код как «второй код» и вывод как «второй вывод» и ошибки как «вторые ошибки»
      то если «Разошлись» от код и вывод и ошибки и «второй код» и «второй вывод» и «вторые ошибки»
          то вариант «Сделать» с поручение равным (вариант «Показать» с место равным "stdout" и текст равным («Строка расхождения» от (элемент номер в «Корпус») и код и вывод и ошибки и «второй код» и «второй вывод» и «вторые ошибки»)) и потом равным (вариант «Зовём первого» с вход равным вход и номер равным (номер плюс 1) и расхождений равным (расхождений плюс 1))
          иначе «Позвать первого» от вход и (номер плюс 1) и расхождений
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным (соединить ["вторая установка не завершилась сама на вызове ", (к строке номер)] по "")

тотальная функция «После настройки»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  обеспечивает «сбой хозяина едет провалом, код в код» если отклик равен (вариант «Сбой» с код равным "FLANG_IO_READ" и сообщение равным "нет такого") то результат равен (вариант «Провал» с код равным "FLANG_IO_READ" и сообщение равным "нет такого") иначе да
  пример «прочитанная настройка едет дальше, а рядом кладётся непрошедшая программа»
    дано отклик равно вариант «Прочитано» с содержимое равным "flang\n\nnode\nб.mjs\n/д\n/р"
    ожидается вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным "/р/neproshedshiy.flang" и содержимое равным "модуль «Непрошедший»\n\nтотальная функция «Удвоить»\n  принимает н: число\n  возвращает число\n  пример «два»\n    дано н равно 2\n    ожидается 5\n  н умножить на 2\n") и потом равным (вариант «Кладём кривой» с вход равным "flang\n\nnode\nб.mjs\n/д\n/р")
  пример «настройки нет — план сдаётся с кодом хозяина»
    дано отклик равно вариант «Сбой» с код равным "FLANG_IO_READ" и сообщение равным "нет такого файла"
    ожидается вариант «Провал» с код равным "FLANG_IO_READ" и сообщение равным "нет такого файла"
  разбор отклик
    случай вариант «Прочитано» с содержимое как содержимое
      то вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным (соединить [(«Поле настройки» от содержимое и 6), "/neproshedshiy.flang"] по "") и содержимое равным «Непрошедший исходник») и потом равным (вариант «Кладём кривой» с вход равным содержимое)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали содержимое настройки"

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  обеспечивает «ход вида Читаем настройку уходит своей ветвью» если ход равен (вариант «Читаем настройку») то (результат равен (вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "sverka-nastroyka.txt") и потом равным (вариант «Кладём непрошедший»))) иначе да
  обеспечивает «ход вида Кладём непрошедший уходит своей ветвью» если ход равен (вариант «Кладём непрошедший») то (результат равен («После настройки» от отклик)) иначе да
  обеспечивает «ход вида Зовём первого уходит своей ветвью» если ход равен (вариант «Зовём первого» с вход равным "" и номер равным 1 и расхождений равным 0) то (результат равен («Позвать первого» от "" и 1 и 0)) иначе да
  обеспечивает «ход вида Зовём второго уходит своей ветвью» если ход равен (вариант «Зовём второго» с вход равным "" и номер равным 1 и расхождений равным 0) то (результат равен («Позвать второго» от "" и 1 и 0 и отклик)) иначе да
  обеспечивает «ход вида Кончаем отдаёт число расхождений» если ход равен (вариант «Кончаем» с расхождений равным 3) то (результат равен (вариант «Конец работы» с значение равным 3)) иначе да
  пример «первым делом читается настройка»
    дано ход равно вариант «Читаем настройку»
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "sverka-nastroyka.txt") и потом равным (вариант «Кладём непрошедший»)
  пример «после непрошедшей кладётся кривая»
    дано ход равно вариант «Кладём кривой» с вход равным "flang\n\nnode\nб.mjs\n/д\n/р"
    дано отклик равно вариант «Записано» с сколько равным 10
    ожидается вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным "/р/krivoy.flang" и содержимое равным "модуль «Кривой»\n\nтотальная функция «Ф»\n  принимает н: число\n  возвращает строка\n  пример «н»\n    дано н равно 0\n    ожидается \"\"\n  н\n") и потом равным (вариант «Зовём первого» с вход равным "flang\n\nnode\nб.mjs\n/д\n/р" и номер равным 1 и расхождений равным 0)
  пример «в конце план отдаёт число расхождений»
    дано ход равно вариант «Кончаем» с расхождений равным 3
    дано отклик равно вариант «Показано»
    ожидается вариант «Конец работы» с значение равным 3
  разбор ход
    случай вариант «Читаем настройку»
      то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "sverka-nastroyka.txt") и потом равным (вариант «Кладём непрошедший»)
    случай вариант «Кладём непрошедший»
      то «После настройки» от отклик
    случай вариант «Кладём кривой» с вход как вход
      то вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным (соединить [(«Поле настройки» от вход и 6), "/krivoy.flang"] по "") и содержимое равным «Кривой исходник») и потом равным (вариант «Зовём первого» с вход равным вход и номер равным 1 и расхождений равным 0)
    случай вариант «Зовём первого» с вход как вход и номер как номер и расхождений как расхождений
      то «Позвать первого» от вход и номер и расхождений
    случай вариант «Зовём второго» с вход как вход и номер как номер и расхождений как расхождений
      то «Позвать второго» от вход и номер и расхождений и отклик
    случай вариант «Сравниваем» с вход как вход и номер как номер и расхождений как расхождений и код как код и вывод как вывод и ошибки как ошибки
      то «Сравнить» от вход и номер и расхождений и код и вывод и ошибки и отклик
    случай вариант «Кончаем» с расхождений как расхождений
      то вариант «Конец работы» с значение равным расхождений

план «Сверка»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
