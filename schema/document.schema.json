{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fts-lang.dev/schema/document.schema.json",
  "title": "FTS document",
  "description": "Canonical JSON representation of a Formal Type Surface document.",
  "type": "object",
  "required": ["category", "structures", "functors", "proposition", "ts_compat"],
  "properties": {
    "category": { "$ref": "#/$defs/identifier" },
    "structures": {
      "type": "array",
      "items": { "$ref": "#/$defs/structure" }
    },
    "functors": {
      "type": "array",
      "items": { "$ref": "#/$defs/functor" }
    },
    "proposition": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/proposition" }
      ]
    },
    "ts_compat": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "utilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/utility" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001F\\u007F]).+$"
    },
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "structure": {
      "type": "object",
      "required": ["name", "fields"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "ts_compat": { "type": "string" }
      },
      "additionalProperties": false
    },
    "functor": {
      "type": "object",
      "required": ["name", "domain", "codomain"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "domain": { "type": "string", "minLength": 1 },
        "codomain": { "type": "string", "minLength": 1 },
        "law": { "type": "string" }
      },
      "additionalProperties": false
    },
    "utilityOperand": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "value" },
            "value": { "type": ["string", "number", "boolean", "null"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "field"],
          "properties": {
            "kind": { "const": "field" },
            "field": { "$ref": "#/$defs/identifier" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "percent", "field"],
          "properties": {
            "kind": { "const": "percent" },
            "percent": { "type": "number" },
            "field": { "$ref": "#/$defs/identifier" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "result" } },
          "additionalProperties": false
        }
      ]
    },
    "utilityCondition": {
      "type": "object",
      "required": ["field", "operator", "value"],
      "properties": {
        "field": { "$ref": "#/$defs/identifier" },
        "operator": { "enum": ["eq", "neq", "gte", "lte", "gt", "lt"] },
        "value": { "$ref": "#/$defs/utilityOperand" }
      },
      "additionalProperties": false
    },
    "utilityRule": {
      "type": "object",
      "required": ["name", "when", "action"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "when": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/utilityCondition" }
        },
        "action": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["set", "add"] },
            "value": { "$ref": "#/$defs/utilityOperand" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "utilityProperty": {
      "type": "object",
      "required": ["name", "operator", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "operator": { "enum": ["eq", "neq", "gte", "lte", "gt", "lt"] },
        "value": { "$ref": "#/$defs/utilityOperand" }
      },
      "additionalProperties": false
    },
    "utilityExample": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "input": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "expected": { "type": ["string", "number", "boolean", "null"] }
      },
      "additionalProperties": false
    },
    "utility": {
      "type": "object",
      "required": ["name", "input", "output", "initial", "rules", "properties", "examples"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "input": { "$ref": "#/$defs/identifier" },
        "output": { "type": "string", "minLength": 1 },
        "initial": { "type": ["string", "number", "boolean", "null"] },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/utilityRule" }
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/utilityProperty" }
        },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/utilityExample" }
        }
      },
      "additionalProperties": false
    },
    "pathSegment": {
      "oneOf": [
        { "type": "string" },
        { "type": "integer", "minimum": 0 },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      ]
    },
    "witness": {
      "type": "object",
      "required": ["kind", "structure", "field"],
      "properties": {
        "kind": { "const": "witness" },
        "structure": { "$ref": "#/$defs/identifier" },
        "field": { "$ref": "#/$defs/identifier" },
        "selector": { "type": "object" },
        "value": true,
        "path": {
          "type": "array",
          "items": { "$ref": "#/$defs/pathSegment" }
        },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "apply": {
      "type": "object",
      "required": ["kind", "functor", "arg"],
      "properties": {
        "kind": { "const": "apply" },
        "functor": { "$ref": "#/$defs/identifier" },
        "arg": { "$ref": "#/$defs/proposition" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "compose": {
      "type": "object",
      "required": ["kind", "functors", "arg"],
      "properties": {
        "kind": { "const": "compose" },
        "functors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "arg": { "$ref": "#/$defs/proposition" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "proposition": {
      "oneOf": [
        { "$ref": "#/$defs/witness" },
        { "$ref": "#/$defs/apply" },
        { "$ref": "#/$defs/compose" }
      ]
    }
  }
}
