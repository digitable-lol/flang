модуль «Behavior table»
  использует «Rules» из "rules.fscript"
  использует «Reading» из "reading.fscript"
  использует «Lists» только «Соединить списки»

объект «Parameter»
  «name»: строка
  «type»: строка

объект «Shape»
  «found»: признак
  «generic»: признак
  «name»: строка
  «parameters»: список «Parameter»
  «returns»: строка
  «requires»: список строки
  «ensures»: число
  «given»: список «Parameter»
  «block»: строка

объект «Domain»
  «values»: список строки
  «complete»: признак
  «cut»: признак

объект «Case»
  «name»: строка
  «fields»: список «Parameter»

объект «Declaration»
  «kind»: строка
  «name»: строка
  «cases»: список «Case»

объект «Table»
  «function»: строка
  «file»: строка
  «names»: список строки
  «complete»: признак
  «size»: число
  «rows»: список список строки
  «outcomes»: список строки
  «problem»: строка

объект «Flip»
  «input»: строка
  «before»: строка
  «after»: строка

объект «Change»
  «before»: «Table»
  «after»: «Table»
  «flipped»: список «Flip»
  «appeared»: список «Flip»
  «vanished»: список «Flip»
  «same»: число

тотальная функция «Default limit»
  возвращает число
  пример «Two hundred and fifty-six rows by default»
    ожидается 256
  256

тотальная функция «Part»
  принимает position: число, text: строка, mark: строка
  возвращает строка
  пример «The text before the mark»
    дано position равно 1
    дано text равно "роль: «Роль»"
    дано mark равно ": "
    ожидается "роль"
  пример «A missing part is empty»
    дано position равно 2
    дано text равно "роль"
    дано mark равно ": "
    ожидается ""
  пусть parts равно (разделить text по mark)
  если (position меньше 1) или (position больше (длина parts))
    то ""
    иначе элемент position в parts

тотальная функция «Rest after»
  принимает text: строка, mark: строка
  возвращает строка
  пример «Everything after the first mark»
    дано text равно "a: b: c"
    дано mark равно ": "
    ожидается "b: c"
  пример «No mark gives nothing»
    дано text равно "abc"
    дано mark равно ": "
    ожидается ""
  соединить (хвост (разделить text по mark)) по mark

тотальная функция «Marks»
  принимает text: строка, mark: строка
  возвращает число
  пример «Two opening parentheses»
    дано text равно "(а (б))"
    дано mark равно "("
    ожидается 2
  (длина (разделить text по mark)) минус 1

тотальная функция «Balanced»
  принимает text: строка
  возвращает признак
  пример «A closed value»
    дано text равно "[(вариант А), 2]"
    ожидается да
  пример «A value that goes on to the next line»
    дано text равно "вариант А)"
    ожидается нет
  ((«Marks» от text и "(") равен («Marks» от text и ")")) и притом ((«Marks» от text и "[") равен («Marks» от text
    и "]"))

тотальная функция «Without guillemets»
  принимает name: строка
  возвращает строка
  пример «A name in guillemets»
    дано name равно "«в архиве»"
    ожидается "в архиве"
  пример «A plain name stays»
    дано name равно "роль"
    ожидается "роль"
  если (name начинается с "«") и притом («Ends with» от name и "»")
    то подстрока name с 2 по ((длина name) минус 1)
    иначе name

тотальная функция «In guillemets»
  принимает name: строка
  возвращает строка
  пример «A bare name gets guillemets»
    дано name равно "Можно читать отчёт"
    ожидается "«Можно читать отчёт»"
  пример «A name in guillemets keeps them»
    дано name равно "«Можно читать отчёт»"
    ожидается "«Можно читать отчёт»"
  соединить ["«", («Without guillemets» от name), "»"] по ""

тотальная функция «Bare type»
  принимает written: строка
  возвращает строка
  пример «Parentheses around a type go»
    дано written равно "(признак)"
    ожидается "признак"
  пример «A type without parentheses stays»
    дано written равно "список «Роль»"
    ожидается "список «Роль»"
  если (written начинается с "(") и притом («Ends with» от written и ")")
    то подстрока written с 2 по ((длина written) минус 1)
    иначе written

тотальная функция «Opens block»
  принимает line: строка, heads: список строки
  возвращает признак
  пример «The heading of a total function»
    дано line равно "тотальная функция «Ф»"
    дано heads равно ["функция «Ф»", "тотальная функция «Ф»"]
    ожидается да
  пример «A longer name is another function»
    дано line равно "тотальная функция «Ф два»"
    дано heads равно ["функция «Ф»", "тотальная функция «Ф»"]
    ожидается нет
  не (пусто (отфильтровать heads где head → (line равен head) или (line начинается с (соединить [head, " "] по ""))))

объект «Gathering»
  «taking»: признак
  «done»: признак
  «taken»: список строки

тотальная функция «Gathering step»
  принимает progress: «Gathering», line: строка, heads: список строки
  возвращает «Gathering»
  пример «A line at the first column closes the block»
    дано progress равно запись «Gathering» с «taking» равным да и «done» равным нет и «taken» равным ["тип «Т»"]
    дано line равно "объект «О»"
    дано heads равно ["тип «Т»"]
    ожидается запись «Gathering» с «taking» равным нет и «done» равным да и «taken» равным ["тип «Т»"]
  пусть closing равно (не (пусто line)) и притом (не (line начинается с " "))
  «Chosen» от [(«When» от (progress.«done») и progress),
    («When» от ((progress.«taking») и притом closing) и (запись «Gathering» с «taking» равным нет и «done» равным да
      и «taken» равным (progress.«taken»))),
    («When» от (progress.«taking») и (запись «Gathering» с «taking» равным да и «done» равным нет
      и «taken» равным (добавить line к (progress.«taken»)))),
    («When» от («Opens block» от line и heads) и (запись «Gathering» с «taking» равным да и «done» равным нет
      и «taken» равным [line]))] и progress

тотальная функция «Top block»
  принимает lines: список строки, heads: список строки
  возвращает список строки
  пример «The block runs to the next line at the first column»
    дано lines равно ["модуль «М»", "", "тип «Т»", "  вариант А", "", "объект «О»", "  «п»: число"]
    дано heads равно ["тип «Т»"]
    ожидается ["тип «Т»", "  вариант А", ""]
  пример «No such block»
    дано lines равно ["модуль «М»"]
    дано heads равно ["тип «Т»"]
    ожидается пустой список
  (свёртка lines начиная с (запись «Gathering» с «taking» равным нет и «done» равным нет
    и «taken» равным (пустой список)) как progress и line → «Gathering step» от progress и line и heads).«taken»

тотальная функция «Function heads»
  принимает name: строка
  возвращает список строки
  пример «Both headings of a function»
    дано name равно "Ф"
    ожидается ["функция «Ф»", "тотальная функция «Ф»"]
  [(соединить ["функция ", («In guillemets» от name)] по ""), (соединить ["тотальная функция ",
    («In guillemets» от name)] по "")]

тотальная функция «Parameters»
  принимает text: строка
  возвращает список «Parameter»
  пример «Two parameters»
    дано text равно "роль: «Роль», «в архиве»: признак"
    ожидается ([запись «Parameter» с «name» равным "роль" и «type» равным "«Роль»",
      запись «Parameter» с «name» равным "«в архиве»" и «type» равным "признак"])
  пример «No parameters»
    дано text равно ""
    ожидается пустой список
  (отобразить (отфильтровать (разделить text по ", ") где piece → piece содержит ": ")
    как piece → запись «Parameter» с «name» равным («Part» от 1 и piece и ": ")
    и «type» равным («Bare type» от («Rest after» от piece и ": ")))

тотальная функция «Requirement»
  принимает text: строка
  возвращает строка
  пример «A named requirement loses its name»
    дано text равно "«положительно» н больше 0"
    ожидается "н больше 0"
  пример «An unnamed requirement stays»
    дано text равно "н больше 0"
    ожидается "н больше 0"
  если text начинается с "«"
    то «Rest after» от text и "» "
    иначе text

тотальная функция «Example value»
  принимает line: строка
  возвращает «Parameter»
  пример «A given of an example»
    дано line равно "    дано роль равно вариант Владелец"
    ожидается запись «Parameter» с «name» равным "роль" и «type» равным "вариант Владелец"
  пусть rest равно («After» от "    дано " и line)
  запись «Parameter» с «name» равным («Part» от 1 и rest и " равно ") и «type» равным («Rest after» от rest
    и " равно ")

тотальная функция «Givens»
  принимает lines: список строки
  возвращает список «Parameter»
  пример «Only closed values on one line are taken»
    дано lines равно ["    дано сумма равно 5000", "    дано сумма равно 1)", "    ожидается да"]
    ожидается [запись «Parameter» с «name» равным "сумма" и «type» равным "5000"]
  (отфильтровать (отобразить (отфильтровать lines где line → line начинается с "    дано ")
    как line → «Example value» от line) где entry → («Balanced» от (entry.«type»))
    и притом (не (пусто (entry.«type»))))

тотальная функция «Shape of»
  принимает source: строка, name: строка
  возвращает «Shape»
  пусть block равно («Top block» от (разделить source по "\n") и («Function heads» от name))
  пусть head равно («First line» от (соединить block по "\n"))
  пусть exact равно не (пусто (отфильтровать («Function heads» от name) где h → head равен h))
  (запись «Shape» с «found» равным (не (пусто block)) и «generic» равным ((не (пусто block)) и притом (не exact))
    и «name» равным («Without guillemets» от name)
    и «parameters» равным («Parameters» от («After» от "  принимает " и («Beginning with» от "  принимает " и block)))
    и «returns» равным («Bare type» от («After» от "  возвращает " и («Beginning with» от "  возвращает " и block)))
    и «requires» равным (отобразить (отфильтровать block где line → line начинается с "  требует ") как line →
      «Requirement» от («After» от "  требует " и line))
    и «ensures» равным (длина (отфильтровать block где line → line начинается с "  обеспечивает "))
    и «given» равным («Givens» от block) и «block» равным (соединить block по "\n"))

тотальная функция «Case of»
  принимает line: строка
  возвращает «Case»
  пример «A case without fields»
    дано line равно "  вариант Владелец"
    ожидается запись «Case» с «name» равным "Владелец" и «fields» равным пустой список
  пример «A case with fields»
    дано line равно "  вариант Нельзя содержит причина: строка"
    ожидается (запись «Case» с «name» равным "Нельзя"
      и «fields» равным [запись «Parameter» с «name» равным "причина" и «type» равным "строка"])
  пусть rest равно («After» от "  вариант " и line)
  запись «Case» с «name» равным («Part» от 1 и rest
    и " содержит ") и «fields» равным («Parameters» от («Rest after» от rest и " содержит "))

тотальная функция «Declaration of»
  принимает source: строка, written: строка
  возвращает «Declaration»
  пусть block равно («Top block» от (разделить source по "\n") и [(соединить ["тип ", written] по ""),
    (соединить ["объект ", written] по "")])
  пусть head равно («First line» от (соединить block по "\n"))
  пусть inner равно (отфильтровать block где line → line начинается с "  ")
  «Chosen» от [
    («When» от (head равен (соединить ["тип ", written] по "")) и (запись «Declaration» с «kind» равным "variant"
      и «name» равным written
      и «cases» равным (отобразить (отфильтровать inner где line → line начинается с "  вариант ")
        как line → «Case of» от line))),
    («When» от (head равен (соединить ["объект ", written] по "")) и (запись «Declaration» с «kind» равным "record"
      и «name» равным written
      и «cases» равным [запись «Case» с «name» равным "" и «fields» равным («Parameters» от
        (соединить (отобразить inner как line → «After» от "  " и line) по ", "))]))] и (запись «Declaration» с
        «kind» равным "" и «name» равным written и «cases» равным (пустой список))

тотальная функция «Domain of values»
  принимает values: список строки, complete: признак
  возвращает «Domain»
  пример «A finite domain»
    дано values равно ["да", "нет"]
    дано complete равно да
    ожидается запись «Domain» с «values» равным ["да", "нет"] и «complete» равным да и «cut» равным нет
  запись «Domain» с «values» равным values и «complete» равным complete и «cut» равным нет

тотальная функция «Scalar domain»
  принимает written: строка
  возвращает «Domain»
  обеспечивает «only a sign is complete among scalars» (результат.«complete») равен (written равен "признак")
  пример «A sign is enumerated whole»
    дано written равно "признак"
    ожидается запись «Domain» с «values» равным ["да", "нет"] и «complete» равным да и «cut» равным нет
  пример «A number is sampled at its edges»
    дано written равно "число"
    ожидается запись «Domain» с «values» равным ["-1", "0", "1"] и «complete» равным нет и «cut» равным нет
  пример «A natural number has no negative edge»
    дано written равно "нат"
    ожидается запись «Domain» с «values» равным ["0", "1", "2"] и «complete» равным нет и «cut» равным нет
  пример «A named type is not a scalar»
    дано written равно "«Роль»"
    ожидается запись «Domain» с «values» равным пустой список и «complete» равным нет и «cut» равным нет
  (запись «Domain» с «values» равным («Scalar values» от written) и «complete» равным (written равен "признак")
    и «cut» равным нет)

тотальная функция «Scalar values»
  принимает written: строка
  возвращает список строки
  пример «A sign has two values»
    дано written равно "признак"
    ожидается ["да", "нет"]
  «Chosen» от [(«When» от (written равен "признак") и ["да", "нет"]),
    («When» от ((written равен "нат") или (written равен "неотрицательное")) и ["0", "1", "2"]),
    («When» от ((written равен "число") или (written равен "целое")) и ["-1", "0", "1"]),
    («When» от (written равен "строка") и ["\"\"", "\"а\""]),
    («When» от (written начинается с "список") и ["пустой список"])] и (пустой список)

тотальная функция «Is scalar»
  принимает written: строка
  возвращает признак
  пример «A named type is not a scalar»
    дано written равно "«Роль»"
    ожидается нет
  пример «A list is a scalar here»
    дано written равно "список «Роль»"
    ожидается да
  не (written начинается с "«")

тотальная функция «At most» от «А»
  принимает items: список «А», cap: число
  возвращает список «А»
  обеспечивает «never longer than the cap» (длина результат) не больше (длина items)
  пример «Two of three»
    дано items равно ["а", "б", "в"]
    дано cap равно 2
    ожидается ["а", "б"]
  (свёртка items начиная с (пустой список) как kept
    и one → если (длина kept) меньше cap то (добавить one к kept) иначе kept)

тотальная функция «Product size»
  принимает lists: список список строки
  возвращает число
  пример «Four roles by two signs»
    дано lists равно [["а", "б", "в", "г"], ["да", "нет"]]
    ожидается 8
  свёртка lists начиная с 1 как size и values → size умножить на (длина values)

тотальная функция «Product»
  принимает lists: список список строки, cap: число
  возвращает список список строки
  пример «Every combination in order»
    дано lists равно [["а", "б"], ["да", "нет"]]
    дано cap равно 10
    ожидается [["а", "да"], ["а", "нет"], ["б", "да"], ["б", "нет"]]
  пример «No lists give one empty row»
    дано lists равно пустой список
    дано cap равно 10
    ожидается [пустой список]
  пример «The cap cuts the rows»
    дано lists равно [["а", "б"], ["да", "нет"]]
    дано cap равно 3
    ожидается [["а", "да"], ["а", "нет"], ["б", "да"]]
  (свёртка lists начиная с [пустой список] как rows
    и values → «At most» от (свёртка rows начиная с (пустой список) как grown и row → «Соединить списки» от grown
    и (отобразить values как value → добавить value к row)) и cap)

тотальная функция «Wrapped»
  принимает value: строка
  возвращает строка
  пример «A value goes into parentheses»
    дано value равно "вариант Админ"
    ожидается "(вариант Админ)"
  соединить ["(", value, ")"] по ""

тотальная функция «Wrapped if needed»
  принимает value: строка
  возвращает строка
  пример «A single word stays bare»
    дано value равно "-1"
    ожидается "-1"
  пример «A phrase goes into parentheses»
    дано value равно "вариант Лист"
    ожидается "(вариант Лист)"
  если value содержит " " то («Wrapped» от value) иначе value

тотальная функция «Built value»
  принимает declaration: «Declaration», alternative: «Case», values: список строки
  возвращает строка
  пример «A case without fields»
    дано declaration равно (запись «Declaration» с «kind» равным "variant" и «name» равным "«Роль»"
      и «cases» равным пустой список)
    дано alternative равно запись «Case» с «name» равным "Админ" и «fields» равным пустой список
    дано values равно пустой список
    ожидается "вариант Админ"
  пример «A case with a member»
    дано declaration равно (запись «Declaration» с «kind» равным "variant" и «name» равным "«Исход»"
      и «cases» равным пустой список)
    дано alternative равно (запись «Case» с «name» равным "Нельзя"
      и «fields» равным [запись «Parameter» с «name» равным "причина" и «type» равным "строка"])
    дано values равно ["\"\""]
    ожидается "вариант Нельзя с причина равным \"\""
  пример «A record»
    дано declaration равно (запись «Declaration» с «kind» равным "record" и «name» равным "«Точка»"
      и «cases» равным пустой список)
    дано alternative равно (запись «Case» с «name» равным ""
      и «fields» равным [запись «Parameter» с «name» равным "«x»" и «type» равным "число"])
    дано values равно ["0"]
    ожидается "запись «Точка» с «x» равным 0"
  пусть pairs равно (свёртка (alternative.«fields») начиная с (пустой список) как made
    и member → добавить (соединить [(member.«name»), " равным ",
    («Wrapped if needed» от (элемент ((длина made) плюс 1) в values))] по "") к made)
  пусть head равно (если (declaration.«kind») равен "record" то (соединить ["запись ",
    (declaration.«name»)] по "") иначе (соединить ["вариант ", (alternative.«name»)] по ""))
  если пусто pairs
    то head
    иначе соединить [head, " с ", (соединить pairs по " и ")] по ""

тотальная функция «Built»
  принимает declaration: «Declaration», fields: список список «Domain», cap: число
  возвращает «Domain»
  пусть numbered равно (свёртка (declaration.«cases») начиная с (пустой список) как made
    и alternative → добавить (запись «Domain» с «values» равным (отобразить
      («Product» от (отобразить (элемент ((длина made) плюс 1) в fields) как domain → domain.«values»)
      и cap) как row → «Built value» от declaration и alternative и row) и «complete» равным (пусто (отфильтровать
      (элемент ((длина made) плюс 1) в fields) где domain → не (domain.«complete»)))
      и «cut» равным (((«Product size» от (отобразить (элемент ((длина made) плюс 1) в fields)
      как domain → domain.«values»)) больше cap)
      или (не (пусто (отфильтровать (элемент ((длина made) плюс 1) в fields) где domain → domain.«cut»))))) к made)
  (запись «Domain» с «values» равным («At most» от («Gathered words» от
    (отобразить numbered как domain → domain.«values»)) и cap)
    и «complete» равным ((не ((declaration.«kind») равен "")) и притом (пусто (отфильтровать numbered где domain
    → не (domain.«complete»)))) и «cut» равным ((не (пусто (отфильтровать numbered
    где domain → domain.«cut»))) или ((свёртка numbered начиная с 0 как total
    и domain → total плюс (длина (domain.«values»))) больше cap)))

тотальная функция «Leaf domain»
  принимает source: строка, written: строка, cap: число
  возвращает «Domain»
  пусть declaration равно («Declaration of» от source и written)
  если «Is scalar» от written
    то «Scalar domain» от written
    иначе («Built» от declaration
      и (отобразить (declaration.«cases») как alternative → отобразить (alternative.«fields»)
        как member → «Scalar domain» от (member.«type»)) и cap)

тотальная функция «Middle domain»
  принимает source: строка, written: строка, cap: число
  возвращает «Domain»
  пусть declaration равно («Declaration of» от source и written)
  если «Is scalar» от written
    то «Scalar domain» от written
    иначе («Built» от declaration
      и (отобразить (declaration.«cases») как alternative → отобразить (alternative.«fields»)
        как member → «Leaf domain» от source и (member.«type») и cap) и cap)

тотальная функция «Type domain»
  принимает source: строка, written: строка, cap: число
  возвращает «Domain»
  пусть declaration равно («Declaration of» от source и written)
  если «Is scalar» от written
    то «Scalar domain» от written
    иначе («Built» от declaration
      и (отобразить (declaration.«cases») как alternative → отобразить (alternative.«fields»)
        как member → «Middle domain» от source и (member.«type») и cap) и cap)

тотальная функция «With samples»
  принимает domain: «Domain», samples: список строки
  возвращает «Domain»
  пример «A complete domain takes no samples»
    дано domain равно запись «Domain» с «values» равным ["да", "нет"] и «complete» равным да и «cut» равным нет
    дано samples равно ["да"]
    ожидается запись «Domain» с «values» равным ["да", "нет"] и «complete» равным да и «cut» равным нет
  пример «A sample domain grows by new values only»
    дано domain равно запись «Domain» с «values» равным ["0", "1"] и «complete» равным нет и «cut» равным нет
    дано samples равно ["1", "5000"]
    ожидается запись «Domain» с «values» равным ["0", "1", "5000"] и «complete» равным нет и «cut» равным нет
  если domain.«complete»
    то domain
    иначе (запись «Domain» с «values» равным (свёртка samples начиная с (domain.«values») как kept
      и sample → если пусто (отфильтровать kept где value → value равен sample) то
        (добавить sample к kept) иначе kept) и «complete» равным нет и «cut» равным (domain.«cut»))

объект «Inputs»
  «names»: список строки
  «rows»: список список строки
  «complete»: признак
  «size»: число
  «problem»: строка

тотальная функция «Samples of»
  принимает name: строка, givens: список «Parameter»
  возвращает список строки
  пример «The values the examples give to one input»
    дано name равно "сумма"
    дано givens равно ([запись «Parameter» с «name» равным "сумма" и «type» равным "5000",
      запись «Parameter» с «name» равным "постоянный" и «type» равным "да"])
    ожидается ["5000"]
  отобразить (отфильтровать givens где entry → (entry.«name») равен name) как entry → entry.«type»

тотальная функция «Borrowed givens»
  принимает own: «Shape», other: «Shape»
  возвращает список «Parameter»
  пример «A renamed input of the same type borrows the values of the other version»
    дано own равно (запись «Shape» с «found» равным да и «generic» равным нет и «name» равным "Ф"
      и «parameters» равным [запись «Parameter» с «name» равным "к" и «type» равным "число"]
      и «returns» равным "признак" и «requires» равным пустой список и «ensures» равным 0
      и «given» равным пустой список и «block» равным "")
    дано other равно (запись «Shape» с «found» равным да и «generic» равным нет и «name» равным "Ф"
      и «parameters» равным [запись «Parameter» с «name» равным "н" и «type» равным "число"]
      и «returns» равным "признак" и «requires» равным пустой список и «ensures» равным 0
      и «given» равным [запись «Parameter» с «name» равным "н" и «type» равным "7"] и «block» равным "")
    ожидается [запись «Parameter» с «name» равным "к" и «type» равным "7"]
  пусть theirs равно (other.«parameters»)
  пусть mine равно (own.«parameters»)
  («Соединить списки» от (own.«given») и («Gathered givens» от (свёртка mine начиная с (пустой список) как made
    и parameter → добавить (если ((длина made) меньше (длина theirs))
    и притом (((элемент ((длина made) плюс 1) в theirs).«type») равен
      (parameter.«type»)) то (отобразить («Samples of» от ((элемент ((длина made) плюс 1) в theirs).«name»)
      и (other.«given»)) как value → запись «Parameter» с «name» равным (parameter.«name»)
      и «type» равным value) иначе (пустой список)) к made)))

тотальная функция «Gathered givens»
  принимает parts: список список «Parameter»
  возвращает список «Parameter»
  пример «Parts follow one another»
    дано parts равно [[запись «Parameter» с «name» равным "а" и «type» равным "1"], пустой список]
    ожидается [запись «Parameter» с «name» равным "а" и «type» равным "1"]
  (свёртка parts начиная с (пустой список) как gathered и part → свёртка part начиная с gathered как grown
    и one → добавить one к grown)

тотальная функция «Inputs of»
  принимает source: строка, shape: «Shape», givens: список «Parameter», limit: число
  возвращает «Inputs»
  пусть domains равно (отобразить (shape.«parameters») как parameter → «With samples» от («Type domain» от source
    и (parameter.«type») и (limit плюс 1)) и («Samples of» от (parameter.«name») и givens))
  пусть lists равно (отобразить domains как domain → domain.«values»)
  пусть size равно («Product size» от lists)
  пусть labelled равно (свёртка domains начиная с (пустой список) как made
    и domain → добавить (запись «Parameter» с «name» равным ((элемент
      ((длина made) плюс 1) в (shape.«parameters»)).«name») и «type» равным (если пусто (domain.«values») то
      ((элемент ((длина made) плюс 1) в (shape.«parameters»)).«type») иначе "")) к made)
  пусть empty равно (отфильтровать labelled где x → не (пусто (x.«type»)))
  пусть missing равно (свёртка empty начиная с (запись «Parameter» с «name» равным ""
    и «type» равным "") как earliest и one →
    если пусто (earliest.«name») то one иначе earliest)
  пусть problem равно («Chosen» от [(«When» от (не (shape.«found»)) и (соединить ["функции ",
    («In guillemets» от (shape.«name»)), " в файле нет"] по "")),
    («When» от (shape.«generic») и (соединить [(«In guillemets» от (shape.«name»)),
      " — обобщённая функция: таблица по параметру типа не строится"] по "")),
    («When» от (не (пусто empty)) и (соединить ["вход «", («Without guillemets» от (missing.«name»)),
      "» нечем заполнить: тип ", (missing.«type»), " объявлен не в этом файле, а примеров с ним нет"] по "")),
    («When» от (size больше limit) и (соединить ["строк было бы ", (к строке size), " при пределе ",
      (к строке limit), "; поднимите предел ключом --limit"] по ""))] и "")
  (запись «Inputs» с «names» равным (отобразить (shape.«parameters»)
    как parameter → «Without guillemets» от (parameter.«name»))
    и «rows» равным (если пусто problem то («Product» от lists и limit) иначе (пустой список))
    и «complete» равным (пусто (отфильтровать domains где domain → (не (domain.«complete»)) или (domain.«cut»)))
    и «size» равным size и «problem» равным problem)

тотальная функция «Call»
  принимает name: строка, row: список строки
  возвращает строка
  пример «A call with two inputs»
    дано name равно "Можно читать отчёт"
    дано row равно ["вариант Админ", "да"]
    ожидается "(«Можно читать отчёт» от (вариант Админ) и (да))"
  пример «A call without inputs»
    дано name равно "Ф"
    дано row равно пустой список
    ожидается "(«Ф»)"
  если пусто row
    то соединить ["(", («In guillemets» от name), ")"] по ""
    иначе (соединить ["(", («In guillemets» от name), " от ",
      (соединить (отобразить row как value → «Wrapped» от value) по " и "), ")"] по "")

тотальная функция «Probe name»
  возвращает строка
  пример «The appended function»
    ожидается "Behavior probe"
  "Behavior probe"

тотальная функция «Gate name»
  возвращает строка
  пример «The appended guard of the requirements»
    ожидается "Behavior probe gates"
  "Behavior probe gates"

тотальная функция «Probe source»
  принимает source: строка, shape: «Shape», rows: список список строки
  возвращает строка
  пусть calls равно (соединить (отобразить rows как row → «Call» от (shape.«name») и row) по ",\n    ")
  пусть gates равно (соединить (отобразить rows как row → «Call» от "Behavior probe gate" и row) по ",\n    ")
  пусть parameters равно (соединить (отобразить (shape.«parameters») как parameter → соединить [(parameter.«name»),
    ": ", (parameter.«type»)] по "") по ", ")
  пусть condition равно (соединить (отобразить (shape.«requires») как requirement
    → «Wrapped» от requirement) по " и притом ")
  пусть probe равно (соединить ["\n\nтотальная функция «Behavior probe»\n  возвращает список (", (shape.«returns»),
    ")\n  [", calls, "]\n"] по "")
  пусть gate равно (соединить ["\nтотальная функция «Behavior probe gate»\n  принимает ", parameters,
    "\n  возвращает признак\n  ", condition,
    "\n\nтотальная функция «Behavior probe gates»\n  возвращает список (признак)\n  [", gates, "]\n"] по "")
  соединить [source, probe, (если пусто (shape.«requires») то "" иначе gate)] по ""

объект «Scan»
  «depth»: число
  «quoted»: признак
  «escaped»: признак

тотальная функция «Scan step»
  принимает scan: «Scan», sign: строка
  возвращает «Scan»
  пример «An opening brace goes one level down»
    дано scan равно запись «Scan» с «depth» равным 0 и «quoted» равным нет и «escaped» равным нет
    дано sign равно "{"
    ожидается запись «Scan» с «depth» равным 1 и «quoted» равным нет и «escaped» равным нет
  пример «A brace inside a string is text»
    дано scan равно запись «Scan» с «depth» равным 1 и «quoted» равным да и «escaped» равным нет
    дано sign равно "}"
    ожидается запись «Scan» с «depth» равным 1 и «quoted» равным да и «escaped» равным нет
  пусть depth равно (scan.«depth»)
  пусть quoted равно (scan.«quoted»)
  «Chosen» от [(«When» от (scan.«escaped») и (запись «Scan» с «depth» равным depth и «quoted» равным quoted
    и «escaped» равным нет)),
    («When» от (quoted и притом (sign равен "\\")) и (запись «Scan» с «depth» равным depth и «quoted» равным да
      и «escaped» равным да)),
    («When» от (sign равен "\"") и (запись «Scan» с «depth» равным depth и «quoted» равным (не quoted)
      и «escaped» равным нет)),
    («When» от quoted и scan),
    («When» от ((sign равен "{") или (sign равен "[")) и (запись «Scan» с «depth» равным (depth плюс 1)
      и «quoted» равным нет и «escaped» равным нет)),
    («When» от ((sign равен "}") или (sign равен "]")) и (запись «Scan» с «depth» равным (depth минус 1)
      и «quoted» равным нет и «escaped» равным нет))] и scan

объект «Splitting»
  «scan»: «Scan»
  «pending»: список строки
  «items»: список строки

тотальная функция «Splitting step»
  принимает splitting: «Splitting», piece: строка
  возвращает «Splitting»
  пусть scan равно (свёртка (разложить piece на символы) начиная с (splitting.«scan») как now
    и sign → «Scan step» от now и sign)
  пусть pending равно (добавить piece к (splitting.«pending»))
  если ((scan.«depth») равен 0) и притом (не (scan.«quoted»))
    то (запись «Splitting» с «scan» равным scan и «pending» равным (пустой список)
      и «items» равным (добавить (соединить pending по ",") к (splitting.«items»)))
    иначе запись «Splitting» с «scan» равным scan и «pending» равным pending и «items» равным (splitting.«items»)

тотальная функция «Json items»
  принимает text: строка
  возвращает список строки
  пример «Top-level items of an array»
    дано text равно "[true,{\"вариант\":\"Нельзя\",\"причина\":\"а, б\"},[1,2]]"
    ожидается ["true", "{\"вариант\":\"Нельзя\",\"причина\":\"а, б\"}", "[1,2]"]
  пример «An empty array»
    дано text равно "[]"
    ожидается пустой список
  пусть line равно («Beginning with» от "[" и (разделить text по "\n"))
  пусть inner равно (если (длина line) меньше 2 то "" иначе (подстрока line с 2 по ((длина line) минус 1)))
  если пусто inner
    то пустой список
    иначе ((свёртка (разделить inner по ",") начиная с (запись «Splitting» с «scan» равным
      (запись «Scan» с «depth» равным 0 и «quoted» равным нет и «escaped» равным нет)
      и «pending» равным (пустой список) и «items» равным (пустой список)) как splitting
      и piece → «Splitting step» от splitting и piece).«items»)

тотальная функция «Outcome words»
  принимает json: строка
  возвращает строка
  пример «Truth is yes»
    дано json равно "true"
    ожидается "да"
  пример «A bare case is its name»
    дано json равно "{\"вариант\":\"Разрешено\"}"
    ожидается "Разрешено"
  пример «A case with fields keeps them»
    дано json равно "{\"вариант\":\"Запрещено\",\"причина\":\"нет прав\"}"
    ожидается "Запрещено {\"причина\":\"нет прав\"}"
  пример «A number stays»
    дано json равно "-1.5"
    ожидается "-1.5"
  пусть prefix равно "{\"вариант\":\""
  пусть name равно («Part» от 1 и («After» от prefix и json) и "\"")
  пусть rest равно («After» от (соединить [prefix, name, "\""] по "") и json)
  «Chosen» от [(«When» от (json равен "true") и "да"), («When» от (json равен "false") и "нет"),
    («When» от ((json начинается с prefix) и притом (rest равен "}")) и name),
    («When» от (json начинается с prefix) и (соединить [name, " {", («After» от "," и rest)] по ""))] и json

тотальная функция «Gated»
  принимает outcomes: список строки, gates: список строки
  возвращает список строки
  пример «A row outside the requirement says so»
    дано outcomes равно ["1", "-1.5"]
    дано gates равно ["true", "false"]
    ожидается ["1", "вне требования"]
  пример «No gates leave the outcomes»
    дано outcomes равно ["да"]
    дано gates равно пустой список
    ожидается ["да"]
  если пусто gates
    то outcomes
    иначе (свёртка outcomes начиная с (пустой список) как made
      и outcome → добавить
        (если (элемент ((длина made) плюс 1) в gates) равен "true" то outcome иначе "вне требования") к made)

тотальная функция «Table of»
  принимает file: строка, shape: «Shape», inputs: «Inputs», outcomes: список строки, failure: строка
  возвращает «Table»
  пусть problem равно («Chosen» от [(«When» от (не (пусто (inputs.«problem»))) и (inputs.«problem»)),
    («When» от (не (пусто failure)) и (соединить ["пробный прогон не удался: ", failure] по "")),
    («When» от (не ((длина outcomes) равен (длина (inputs.«rows»)))) и
      (соединить ["исходов ", (к строке (длина outcomes)), " на ", (к строке (длина (inputs.«rows»))),
        " входов"] по ""))] и "")
  (запись «Table» с «function» равным (shape.«name») и «file» равным file и «names» равным (inputs.«names»)
    и «complete» равным (inputs.«complete») и «size» равным (длина (inputs.«rows»))
    и «rows» равным (если пусто problem то (inputs.«rows») иначе (пустой список))
    и «outcomes» равным (если пусто problem то outcomes иначе (пустой список)) и «problem» равным problem)

тотальная функция «Table at»
  принимает tables: список «Table», position: число
  возвращает «Table»
  пусть blank равно (запись «Table» с «function» равным "" и «file» равным "" и «names» равным (пустой список)
    и «complete» равным нет
    и «size» равным 0 и «rows» равным (пустой список) и «outcomes» равным (пустой список)
      и «problem» равным "таблицы нет")
  если (position меньше 1) или (position больше (длина tables)) то blank иначе (элемент position в tables)

тотальная функция «Shown»
  принимает value: строка
  возвращает строка
  пример «A case shows its name»
    дано value равно "вариант Владелец"
    ожидается "Владелец"
  пример «A case with a field shows the field»
    дано value равно "вариант Обычная с сумма равным -1"
    ожидается "Обычная с сумма = -1"
  «Bare type» от (свёртка [["вариант ", ""], ["запись ", ""], [" равным ", " = "]] начиная с value как shown и pair →
    соединить (разделить shown по (элемент 1 в pair)) по (элемент 2 в pair))

тотальная функция «Input words»
  принимает names: список строки, row: список строки
  возвращает строка
  пример «Names and values of one row»
    дано names равно ["роль", "архивный"]
    дано row равно ["вариант Админ", "да"]
    ожидается "роль = Админ, архивный = да"
  пример «A row without inputs»
    дано names равно пустой список
    дано row равно пустой список
    ожидается "без входов"
  если пусто row
    то "без входов"
    иначе соединить (свёртка row начиная с (пустой список) как made и value →
      добавить (соединить [(если (длина made) меньше (длина names) то (элемент
        ((длина made) плюс 1) в names) иначе "?"), " = ", («Shown» от value)] по "") к made) по ", "

тотальная функция «Padded»
  принимает text: строка, width: число
  возвращает строка
  пример «Spaces up to the width»
    дано text равно "аб"
    дано width равно 4
    ожидается "аб  "
  пусть spaces равно (соединить ["                                        ",
    "                                        "] по "")
  пусть missing равно (width минус (длина text))
  если missing меньше 1
    то text
    иначе соединить [text, (подстрока spaces с 1 по (если missing больше 80 то 80 иначе missing))] по ""

тотальная функция «Width»
  принимает texts: список строки
  возвращает число
  пример «The longest text»
    дано texts равно ["а", "абв"]
    ожидается 3
  свёртка texts начиная с 0 как widest и text → если (длина text) больше widest то (длина text) иначе widest

тотальная функция «Kind words»
  принимает table: «Table»
  возвращает строка
  пример «A complete table»
    дано table равно (запись «Table» с «function» равным "Ф" и «file» равным "ф.flang" и «names» равным пустой список
      и «complete» равным да и «size» равным 8 и «rows» равным пустой список и «outcomes» равным пустой список
      и «problem» равным "")
    ожидается "полная таблица, строк 8: перебраны все входы"
  если table.«complete»
    то соединить ["полная таблица, строк ", (к строке (table.«size»)), ": перебраны все входы"] по ""
    иначе соединить ["выборка, строк ", (к строке (table.«size»)), ": варианты и признаки перебраны целиком,",
      " числа, строки и списки взяты граничными значениями и значениями из примеров"] по ""

тотальная функция «Table lines»
  принимает table: «Table»
  возвращает список строки
  пусть inputs равно (отобразить (table.«rows») как row → «Input words» от (table.«names») и row)
  пусть width равно («Width» от inputs)
  пусть heading равно (соединить [(«In guillemets» от (table.«function»)), " · ", (table.«file»)] по "")
  если пусто (table.«problem»)
    то «Соединить списки» от [heading, («Kind words» от table)] и (свёртка inputs начиная с (пустой список) как made
      и input →
      добавить (соединить ["  ", («Padded» от input и width), "  →  ",
        (элемент ((длина made) плюс 1) в (table.«outcomes»))] по "") к made)
    иначе [heading, (соединить ["таблица не построена: ", (table.«problem»)] по "")]

тотальная функция «Key»
  принимает row: список строки
  возвращает строка
  пример «Values joined»
    дано row равно ["вариант Админ", "да"]
    ожидается "вариант Админ | да"
  соединить row по " | "

тотальная функция «Outcome at»
  принимает table: «Table», key: строка
  возвращает список строки
  пусть found равно (свёртка (table.«rows») начиная с (пустой список) как made и row →
    добавить (если («Key» от row) равен key то [(элемент ((длина made) плюс 1) в (table.«outcomes»))] иначе
      (пустой список)) к made)
  (свёртка found начиная с (пустой список) как all и part → свёртка part начиная с all как grown
    и one → добавить one к grown)

тотальная функция «Compare»
  принимает earlier: «Table», later: «Table»
  возвращает «Change»
  пусть flips равно (свёртка (later.«rows») начиная с (пустой список) как made и row →
    добавить (запись «Flip» с «input» равным («Input words» от (later.«names») и row)
      и «before» равным (соединить («Outcome at» от earlier и («Key» от row)) по "")
      и «after» равным (элемент ((длина made) плюс 1) в (later.«outcomes»))) к made)
  пусть known равно (отобразить (later.«rows») как row → «Key» от row)
  пусть gone равно (отфильтровать (earlier.«rows») где row → пусто (отфильтровать known
    где key → key равен («Key» от row)))
  (запись «Change» с «before» равным earlier и «after» равным later
    и «flipped» равным (отфильтровать flips где flip → (не (пусто (flip.«before»)))
      и притом (не ((flip.«before») равен (flip.«after»))))
    и «appeared» равным (отфильтровать flips где flip → пусто (flip.«before»))
    и «vanished» равным (отобразить gone как row → запись «Flip» с «input» равным («Input words» от (earlier.«names»)
      и row)
      и «before» равным (соединить («Outcome at» от earlier и («Key» от row)) по "") и «after» равным "")
    и «same» равным (длина (отфильтровать flips где flip → (flip.«before») равен (flip.«after»))))

тотальная функция «Flip lines»
  принимает title: строка, flips: список «Flip», shown: строка
  возвращает список строки
  пример «Nothing to show is one line»
    дано title равно "перевернулось строк"
    дано flips равно пустой список
    дано shown равно "both"
    ожидается ["перевернулось строк: 0"]
  пусть width равно («Width» от (отобразить flips как flip → flip.«input»))
  приписать (соединить [title, ": ", (к строке (длина flips))] по "") к (отобразить flips как flip →
    соединить ["  ", («Padded» от (flip.«input») и width), "  ", («Chosen» от [(«When» от (shown равен "before")
      и (flip.«before»)),
      («When» от (shown равен "after") и (flip.«after»))] и (соединить [(flip.«before»), "  →  ",
        (flip.«after»)] по ""))] по "")

тотальная функция «Change lines»
  принимает change: «Change»
  возвращает список строки
  пусть earlier равно (change.«before»)
  пусть later равно (change.«after»)
  пусть heading равно [(соединить ["поведение ", («In guillemets» от (later.«function»))] по ""),
    (соединить ["  было:  ", (earlier.«file»), " — ",
      (если пусто (earlier.«problem») то («Kind words» от earlier) иначе (соединить ["не построена: ",
      (earlier.«problem»)] по ""))] по ""),
    (соединить ["  стало: ", (later.«file»), " — ",
      (если пусто (later.«problem») то («Kind words» от later) иначе (соединить ["не построена: ",
      (later.«problem»)] по ""))] по "")]
  пусть quiet равно (пусто (change.«flipped»)) и притом ((пусто (change.«appeared»))
    и притом (пусто (change.«vanished»)))
  («Chosen» от [(«When» от (не ((пусто (earlier.«problem»)) и притом (пусто (later.«problem»)))) и heading),
    («When» от quiet и («Соединить списки» от heading и [(соединить ["поведение не изменилось: совпали все строки, ",
      (к строке (change.«same»))] по "")]))]
    и («Gathered words» от [heading, («Flip lines» от "перевернулось строк" и (change.«flipped») и "both"),
      («Flip lines» от "появилось строк" и (change.«appeared») и "after"), («Flip lines» от "исчезло строк"
        и (change.«vanished») и "before"),
      [(соединить ["совпало строк: ", (к строке (change.«same»))] по "")]]))

тотальная функция «Json text»
  принимает text: строка
  возвращает строка
  пример «Quotes and line ends are escaped»
    дано text равно "а \"б\"\nв"
    ожидается "\"а \\\"б\\\"\\nв\""
  (соединить ["\"",
    (соединить (разделить
      (соединить (разделить (соединить (разделить text по "\\") по "\\\\") по "\"") по "\\\"") по "\n") по "\\n"),
      "\""] по "")

тотальная функция «Json flag»
  принимает flag: признак
  возвращает строка
  пример «Truth»
    дано flag равно да
    ожидается "true"
  если flag то "true" иначе "false"

тотальная функция «Table json»
  принимает table: «Table»
  возвращает строка
  пусть rows равно (свёртка (table.«rows») начиная с (пустой список) как made и row →
    добавить (соединить ["{\"input\":", («Json text» от («Input words» от (table.«names») и row)), ",\"outcome\":",
      («Json text» от (элемент ((длина made) плюс 1) в (table.«outcomes»))), "}"] по "") к made)
  соединить ["{\"function\":", («Json text» от (table.«function»)), ",\"file\":", («Json text» от (table.«file»)),
    ",\"complete\":", («Json flag» от (table.«complete»)), ",\"rows\":", (к строке (table.«size»)),
    ",\"problem\":", («Json text» от (table.«problem»)), ",\"table\":[", (соединить rows по ","), "]}"] по ""

тотальная функция «Flips json»
  принимает flips: список «Flip»
  возвращает строка
  пример «One flip»
    дано flips равно [запись «Flip» с «input» равным "роль = Админ" и «before» равным "нет" и «after» равным "да"]
    ожидается "[{\"input\":\"роль = Админ\",\"before\":\"нет\",\"after\":\"да\"}]"
  соединить ["[", (соединить (отобразить flips как flip → соединить ["{\"input\":", («Json text» от (flip.«input»)),
    ",\"before\":", («Json text» от (flip.«before»)), ",\"after\":", («Json text» от (flip.«after»)),
      "}"] по "") по ","), "]"] по ""

тотальная функция «Change json»
  принимает change: «Change»
  возвращает строка
  соединить ["{\"function\":", («Json text» от ((change.«after»).«function»)), ",\"before\":", («Table json» от
    (change.«before»)),
    ",\"after\":", («Table json» от (change.«after»)), ",\"flipped\":", («Flips json» от (change.«flipped»)),
    ",\"appeared\":", («Flips json» от (change.«appeared»)), ",\"vanished\":", («Flips json» от (change.«vanished»)),
    ",\"same\":", (к строке (change.«same»)), "}"] по ""

тотальная функция «Function names»
  принимает source: строка
  возвращает список строки
  пример «Names of the functions at the first column»
    дано source равно "модуль «М»\n\nтотальная функция «Ф»\n  возвращает число\n  1\n\nфункция «Г» от «А»\n  1\n"
    ожидается ["Ф", "Г"]
  (отобразить (отфильтровать (разделить source по "\n") где line → (line начинается с "функция «")
    или (line начинается с "тотальная функция «")) как line →
    «Part» от 1 и («Rest after» от line и "«") и "»")

тотальная функция «Is rule»
  принимает source: строка, shape: «Shape»
  возвращает признак
  (shape.«found») и притом ((не (shape.«generic»)) и притом (((shape.«ensures») больше 0) и притом
    (((shape.«returns») равен "признак") или ((«Declaration of» от source
      и (shape.«returns»)).«kind») равен "variant")))

тотальная функция «Trimmed block»
  принимает block: строка
  возвращает строка
  пример «Blank lines do not count»
    дано block равно "функция «Ф»\n  1\n\n"
    ожидается "функция «Ф»\n  1"
  соединить (отфильтровать (разделить block по "\n") где line → не (пусто line)) по "\n"
