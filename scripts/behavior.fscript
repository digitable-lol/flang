модуль «Behavior»
  использует «Rules» из "rules.fscript"
  использует «Inquiry» из "inquiry.fscript"
  использует «Reading» из "reading.fscript"
  использует «Behavior table» из "behavior-table.fscript"
  использует «Lists» только «Соединить списки»

объект «Version»
  «key»: строка
  «label»: строка
  «source»: строка
  «shape»: «Shape»
  «inputs»: «Inputs»
  «probe»: строка

объект «Job»
  «path»: строка
  «versions»: список «Version»

тотальная функция «Root»
  возвращает строка
  пример «The root of the tree is one level up»
    ожидается ".."
  ".."

тотальная функция «Usage»
  возвращает строка
  пример «How to call it»
    ожидается "звать: bootstrap/flang run-script behavior <файл> «Функция» [ключи]"
  "звать: bootstrap/flang run-script behavior <файл> «Функция» [ключи]"

тотальная функция «Valued flags»
  возвращает список строки
  пример «Flags that take the next argument»
    ожидается ["--limit", "--предел", "--against", "--против", "--old-name", "--прежнее-имя", "--out", "--в-файл"]
  ["--limit", "--предел", "--against", "--против", "--old-name", "--прежнее-имя", "--out", "--в-файл"]

тотальная функция «Option»
  принимает arguments: список строки, names: список строки
  возвращает строка
  пример «The value after the flag»
    дано arguments равно ["отчёт.flang", "Ф", "--против", "HEAD~1"]
    дано names равно ["--against", "--против"]
    ожидается "HEAD~1"
  пример «No flag gives nothing»
    дано arguments равно ["отчёт.flang", "Ф"]
    дано names равно ["--against", "--против"]
    ожидается ""
  (свёртка arguments начиная с (запись «Parameter» с «name» равным "" и «type» равным "") как found и word →
    «Chosen» от [(«When» от ((found.«name») равен "taking") и (запись «Parameter» с «name» равным "done"
      и «type» равным word)),
      («When» от (((found.«name») равен "") и притом (не (пусто (отфильтровать names где flag → flag равен word))))
        и (запись «Parameter» с «name» равным "taking" и «type» равным ""))] и found).«type»

тотальная функция «Has flag»
  принимает arguments: список строки, flag: строка
  возвращает признак
  пример «The flag is there»
    дано arguments равно ["отчёт.flang", "--json"]
    дано flag равно "--json"
    ожидается да
  не (пусто (отфильтровать arguments где word → word равен flag))

тотальная функция «Positionals»
  принимает arguments: список строки
  возвращает список строки
  пример «Flags and their values are not positional»
    дано arguments равно ["отчёт.flang", "--limit", "9", "Ф", "--json", "прежний.flang"]
    ожидается ["отчёт.flang", "Ф", "прежний.flang"]
  «Lines» от ((свёртка arguments начиная с (запись «Parameter» с «name» равным "" и «type» равным "") как kept
    и word →
    «Chosen» от [(«When» от ((kept.«name») равен "skip") и (запись «Parameter» с «name» равным ""
      и «type» равным (kept.«type»))),
      («When» от (не (пусто (отфильтровать («Valued flags») где flag → flag равен word))) и
        (запись «Parameter» с «name» равным "skip" и «type» равным (kept.«type»))),
      («When» от (word начинается с "--") и kept)]
      и (запись «Parameter» с «name» равным "" и «type» равным (соединить [(kept.«type»), word, "\n"] по ""))).«type»)

тотальная функция «Limit»
  принимает arguments: список строки
  возвращает число
  пример «The default limit»
    дано arguments равно пустой список
    ожидается 256
  пример «A given limit»
    дано arguments равно ["--limit", "4"]
    ожидается 4
  пусть written равно («Option» от arguments и ["--limit", "--предел"])
  если «Digits» от written то к числу written иначе («Default limit»)

тотальная функция «Absolute»
  принимает directory: строка, path: строка
  возвращает строка
  пример «A relative path joins the directory»
    дано directory равно "/srv/flang"
    дано path равно "docs/отчёт.flang"
    ожидается "/srv/flang/docs/отчёт.flang"
  пример «An absolute path stays»
    дано directory равно "/srv/flang"
    дано path равно "/tmp/отчёт.flang"
    ожидается "/tmp/отчёт.flang"
  если path начинается с "/" то path иначе (соединить [directory, "/", path] по "")

тотальная функция «Directory of»
  принимает path: строка
  возвращает строка
  пример «The directory of a file»
    дано path равно "/srv/flang/docs/отчёт.flang"
    ожидается "/srv/flang/docs"
  пусть parts равно (разделить path по "/")
  соединить (свёртка parts начиная с (пустой список) как kept
    и part → если (длина kept) меньше ((длина parts) минус 1) то (добавить part к kept) иначе kept) по "/"

тотальная функция «Base of»
  принимает path: строка
  возвращает строка
  пример «The name of a file»
    дано path равно "/srv/flang/docs/отчёт.flang"
    ожидается "отчёт.flang"
  свёртка (разделить path по "/") начиная с "" как last и part → part

тотальная функция «Probe path»
  принимает path: строка, key: строка
  возвращает строка
  пример «The probe lies next to its source»
    дано path равно "/srv/flang/docs/отчёт.flang"
    дано key равно "new"
    ожидается "/srv/flang/docs/.behavior-probe-new-отчёт.flang"
  соединить [(«Directory of» от path), "/.behavior-probe-", key, "-", («Base of» от path)] по ""

тотальная функция «Version made»
  принимает key: строка, tag: строка, text: строка, name: строка, other: строка, twin: строка, path: строка, cap: число
  возвращает «Version»
  пример «A missing function leaves the version without rows»
    дано key равно "new"
    дано tag равно "а.flang"
    дано text равно "модуль «М»\n"
    дано name равно "Ф"
    дано other равно "модуль «М»\n"
    дано twin равно "Ф"
    дано path равно "/srv/а.flang"
    дано cap равно 256
    ожидается (запись «Version» с «key» равным "new" и «label» равным "а.flang" и «source» равным "модуль «М»\n"
      и «shape» равным (запись «Shape» с «found» равным нет и «generic» равным нет и «name» равным "Ф"
      и «parameters» равным (пустой список) и «returns» равным "" и «requires» равным (пустой список)
      и «ensures» равным 0 и «given» равным (пустой список) и «block» равным "")
      и «inputs» равным (запись «Inputs» с «names» равным (пустой список) и «rows» равным (пустой список)
      и «complete» равным да и «size» равным 1 и «problem» равным "функции «Ф» в файле нет")
      и «probe» равным "/srv/.behavior-probe-new-а.flang")
  пусть blocks равно («Blocks» от text)
  пусть shape равно («Shape in» от blocks и name)
  пусть theirs равно («Shape of» от other и twin)
  (запись «Version» с «key» равным key и «label» равным tag и «source» равным text и «shape» равным shape
    и «inputs» равным («Inputs of» от blocks и shape и («Borrowed givens» от shape и theirs) и cap)
    и «probe» равным («Probe path» от path и key))

тотальная функция «Mode»
  принимает answers: список «Answer»
  возвращает строка
  пример «The mode the plan began with»
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--json"]),
      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается "table"
  «First line» от (соединить («Given of» от "mode" и answers) по "\n")

объект «Joining»
  «open»: признак
  «done»: список строки
  «current»: строка

тотальная функция «Joining step»
  принимает joining: «Joining», word: строка
  возвращает «Joining»
  пример «A word inside guillemets joins the open name»
    дано joining равно запись «Joining» с «open» равным да и «done» равным ["а.flang"] и «current» равным "«Можно"
    дано word равно "читать»"
    ожидается запись «Joining» с «open» равным нет и «done» равным ["а.flang", "«Можно читать»"] и «current» равным ""
  пусть closes равно («Ends with» от word и "»")
  пусть joined равно (соединить [(joining.«current»), " ", word] по "")
  («Chosen» от [(«When» от ((joining.«open») и притом closes) и (запись «Joining» с «open» равным нет
    и «done» равным (добавить joined к (joining.«done»)) и «current» равным "")),
    («When» от (joining.«open») и (запись «Joining» с «open» равным да и «done» равным (joining.«done»)
      и «current» равным joined)),
    («When» от ((word начинается с "«") и притом (не closes)) и (запись «Joining» с «open» равным да
      и «done» равным (joining.«done») и «current» равным word))]
    и (запись «Joining» с «open» равным нет и «done» равным (добавить word к (joining.«done»)) и «current» равным ""))

тотальная функция «Rejoined»
  принимает words: список строки
  возвращает список строки
  пример «A name in guillemets cut at spaces is whole again»
    дано words равно ["а.flang", "«Можно", "читать", "отчёт»", "--json"]
    ожидается ["а.flang", "«Можно читать отчёт»", "--json"]
  пусть joined равно (свёртка words начиная с (запись «Joining» с «open» равным нет и «done» равным (пустой список)
    и «current» равным "") как joining и word → «Joining step» от joining и word)
  если joined.«open» то (добавить (joined.«current») к (joined.«done»)) иначе (joined.«done»)

тотальная функция «Arguments of»
  принимает answers: список «Answer»
  возвращает список строки
  пример «The arguments of the plan»
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--json"]),
      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается ["а.flang", "«Ф»", "--json"]
  «Rejoined» от («Given of» от "arguments" и answers)

тотальная функция «Root path»
  принимает answers: список «Answer»
  возвращает строка
  пример «The root as the shell printed it»
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--json"]),
      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается "/srv/дерево"
  «First line» от («Output of» от "root" и answers)

тотальная функция «Argument at»
  принимает position: число, answers: список «Answer»
  возвращает строка
  пример «The function is the second argument»
    дано position равно 2
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--json"]),
      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается "«Ф»"
  пусть words равно («Positionals» от («Arguments of» от answers))
  если (position меньше 1) или (position больше (длина words)) то "" иначе (элемент position в words)

тотальная функция «Against»
  принимает answers: список «Answer»
  возвращает строка
  пример «A revision to compare with»
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--против", "HEAD"]),
