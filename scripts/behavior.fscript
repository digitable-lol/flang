    дано name равно "discount.flang"
    ожидается "docs/examples/behavior/discount.flang"
  соединить ["docs/examples/behavior/", name] по ""

тотальная функция «Probe files»
  возвращает список строки
  пример «Four files of the guide»
    ожидается (["report-access-before.flang", "report-access-after.flang", "report-access-refactored.flang",
      "discount.flang"])
  ["report-access-before.flang", "report-access-after.flang", "report-access-refactored.flang", "discount.flang"]

тотальная функция «Probe cases»
  возвращает список «Probe case»
  обеспечивает «six probes» (длина результат) равен 6
  пример «The six probes»
    ожидается [(запись «Probe case» с «name» равным "refactoring" и «file» равным "report-access-refactored.flang"
      и «function» равным "Читает ли отчёт" и «former» равным "report-access-before.flang"
      и «former function» равным "Можно читать отчёт" и «limit» равным 256
      и «expected» равным ["flipped:[],appeared:[],vanished:[],same:8"]
      и «words» равным "переименование и новое тело при том же поведении дают пустой дифф"), (запись
      «Probe case» с «name» равным "flip" и «file» равным "report-access-after.flang"
      и «function» равным "Можно читать отчёт" и «former» равным "report-access-before.flang"
      и «former function» равным "Можно читать отчёт" и «limit» равным 256
      и «expected» равным ["{input:роль = Заблокированный, архивный = нет,before:нет,after:да}", "same:5"]
      и «words» равным "согласованная правка кода и постусловия видна перевернувшимися строками"), (запись
      «Probe case» с «name» равным "complete" и «file» равным "report-access-before.flang"
      и «function» равным "Можно читать отчёт" и «former» равным "" и «former function» равным ""
      и «limit» равным 256 и «expected» равным ["complete:true,rows:8"]
      и «words» равным "роль и признак перебраны целиком: восемь строк, таблица полная"), (запись
      «Probe case» с «name» равным "number" и «file» равным "discount.flang" и «function» равным "Скидка положена"
      и «former» равным "" и «former function» равным "" и «limit» равным 256 и «expected» равным ["complete:false"]
      и «words» равным "число на входе даёт выборку, а не полную таблицу"), (запись
      «Probe case» с «name» равным "forgery" и «file» равным "discount.flang" и «function» равным "Скидка по виду"
      и «former» равным "" и «former function» равным "" и «limit» равным 256 и «expected» равным ["complete:false"]
      и «words» равным "число внутри варианта не делает таблицу полной"), (запись
      «Probe case» с «name» равным "limit" и «file» равным "report-access-before.flang"
      и «function» равным "Можно читать отчёт" и «former» равным "" и «former function» равным "" и «limit» равным 4
      и «expected» равным ["строк было бы 8 при пределе 4"]
      и «words» равным "предел строк назван числом, таблица не урезана молча")]
  [(запись «Probe case» с «name» равным "refactoring" и «file» равным "report-access-refactored.flang"
    и «function» равным "Читает ли отчёт"
      и «former» равным "report-access-before.flang" и «former function» равным "Можно читать отчёт"
        и «limit» равным 256
      и «expected» равным ["flipped:[],appeared:[],vanished:[],same:8"]
      и «words» равным "переименование и новое тело при том же поведении дают пустой дифф"),
   (запись «Probe case» с «name» равным "flip" и «file» равным "report-access-after.flang"
     и «function» равным "Можно читать отчёт"
      и «former» равным "report-access-before.flang" и «former function» равным "Можно читать отчёт"
        и «limit» равным 256
      и «expected» равным ["{input:роль = Заблокированный, архивный = нет,before:нет,after:да}", "same:5"]
      и «words» равным "согласованная правка кода и постусловия видна перевернувшимися строками"),
   (запись «Probe case» с «name» равным "complete" и «file» равным "report-access-before.flang"
     и «function» равным "Можно читать отчёт"
      и «former» равным "" и «former function» равным "" и «limit» равным 256
        и «expected» равным ["complete:true,rows:8"]
      и «words» равным "роль и признак перебраны целиком: восемь строк, таблица полная"),
   (запись «Probe case» с «name» равным "number" и «file» равным "discount.flang"
     и «function» равным "Скидка положена"
      и «former» равным "" и «former function» равным "" и «limit» равным 256 и «expected» равным ["complete:false"]
      и «words» равным "число на входе даёт выборку, а не полную таблицу"),
   (запись «Probe case» с «name» равным "forgery" и «file» равным "discount.flang"
     и «function» равным "Скидка по виду"
      и «former» равным "" и «former function» равным "" и «limit» равным 256 и «expected» равным ["complete:false"]
      и «words» равным "число внутри варианта не делает таблицу полной"),
   (запись «Probe case» с «name» равным "limit" и «file» равным "report-access-before.flang"
     и «function» равным "Можно читать отчёт"
      и «former» равным "" и «former function» равным "" и «limit» равным 4
        и «expected» равным ["строк было бы 8 при пределе 4"]
      и «words» равным "предел строк назван числом, таблица не урезана молча")]

тотальная функция «Probe questions»
  принимает answers: список «Answer»
  возвращает список «Question»
  пример «The files of the probes are read»
    дано answers равно [запись «Answer» с «name» равным "root" и «reply» равным (вариант
      «Процесс завершён» с код равным 0 и вывод равным "/srv/дерево\n" и ошибки равным "")]
    ожидается ([(запись «Question» с «name» равным "file:report-access-before.flang"
      и «order» равным
      (вариант «Прочитать файл» с путь равным "/srv/дерево/docs/examples/behavior/report-access-before.flang")),
      (запись «Question» с «name» равным "file:report-access-after.flang"
      и «order» равным
      (вариант «Прочитать файл» с путь равным "/srv/дерево/docs/examples/behavior/report-access-after.flang")),
      (запись «Question» с «name» равным "file:report-access-refactored.flang"
      и «order» равным
      (вариант «Прочитать файл» с путь равным "/srv/дерево/docs/examples/behavior/report-access-refactored.flang")),
      (запись «Question» с «name» равным "file:discount.flang"
      и «order» равным (вариант «Прочитать файл» с путь равным "/srv/дерево/docs/examples/behavior/discount.flang"))])
  отобразить («Probe files») как name → «Read» от (соединить ["file:",
    name] по "") и (соединить [(«Root path» от answers), "/", («Example» от name)] по "")

тотальная функция «Probe job»
  принимает probe: «Probe case», answers: список «Answer»
  возвращает «Job»
  пример «A probe without a former file has one version»
    дано probe равно (запись «Probe case» с «name» равным "limit" и «file» равным "report-access-before.flang"
      и «function» равным "Ф" и «former» равным "" и «former function» равным "" и «limit» равным 4
      и «expected» равным ["строк было бы"] и «words» равным "предел")
    дано answers равно пустой список
    ожидается запись «Job» с «path» равным "limit" и «versions» равным [(запись «Version» с «key» равным "p-limit"
      и «label» равным "docs/examples/behavior/report-access-before.flang" и «source» равным ""
      и «shape» равным (запись «Shape» с «found» равным нет и «generic» равным нет и «name» равным "Ф"
      и «parameters» равным (пустой список) и «returns» равным "" и «requires» равным (пустой список)
      и «ensures» равным 0 и «given» равным (пустой список) и «block» равным "")
      и «inputs» равным (запись «Inputs» с «names» равным (пустой список) и «rows» равным (пустой список)
      и «complete» равным да и «size» равным 1 и «problem» равным "функции «Ф» в файле нет")
      и «probe» равным "/docs/examples/behavior/.behavior-probe-p-limit-report-access-before.flang")]
  пусть path равно (соединить [(«Root path» от answers), "/", («Example» от (probe.«file»))] по "")
  пусть newer равно («Output of» от (соединить ["file:", (probe.«file»)] по "") и answers)
  пусть older равно («Output of» от (соединить ["file:", (probe.«former»)] по "") и answers)
  пусть key равно (соединить ["p-", (probe.«name»)] по "")
  если пусто (probe.«former»)
    то запись «Job» с «path» равным (probe.«name») и «versions» равным [(«Version made» от key
      и («Example» от (probe.«file»)) и newer и (probe.«function») и newer
      и (probe.«function») и path и (probe.«limit»))]
    иначе запись «Job» с «path» равным (probe.«name») и «versions» равным [
      («Version made» от (соединить [key, "-old"] по "") и («Example» от (probe.«former»)) и older
        и (probe.«former function») и newer и (probe.«function») и path и (probe.«limit»)),
      («Version made» от (соединить [key, "-new"] по "") и («Example» от (probe.«file»)) и newer и (probe.«function»)
        и older и (probe.«former function») и path и (probe.«limit»))]

тотальная функция «Job json»
  принимает job: «Job», answers: список «Answer»
  возвращает список строки
  пример «A job whose function is missing»
    дано job равно запись «Job» с «path» равным "а.flang" и «versions» равным [(запись «Version» с «key» равным "new"
      и «label» равным "а.flang" и «source» равным "модуль «М»\n"
      и «shape» равным (запись «Shape» с «found» равным нет и «generic» равным нет и «name» равным "Ф"
      и «parameters» равным пустой список и «returns» равным "" и «requires» равным пустой список
      и «ensures» равным 0 и «given» равным пустой список и «block» равным "")
      и «inputs» равным (запись «Inputs» с «names» равным пустой список и «rows» равным пустой список
      и «complete» равным да и «size» равным 1 и «problem» равным "функции «Ф» в файле нет")
      и «probe» равным "/srv/.behavior-probe-new-а.flang")]
    дано answers равно пустой список
    ожидается (["{\"function\":\"Ф\",\"file\":\"а.flang\",", "\"complete\":true,", "\"rows\":0,",
      "\"problem\":\"функции «Ф» в файле нет\",", "\"table\":[", "]}"])
  пусть tables равно (отобразить (job.«versions») как version → «Version table» от version и answers)
  если (длина tables) больше 1
    то «Change json» от («Compare» от («Table at» от tables и 1) и («Table at» от tables и 2))
    иначе «Table json» от («Table at» от tables и 1)

тотальная функция «Probe holds»
  принимает probe: «Probe case», answers: список «Answer»
  возвращает признак
  пример «The limit probe holds on a table it could not build»
    дано probe равно (запись «Probe case» с «name» равным "limit" и «file» равным "report-access-before.flang"
      и «function» равным "Ф" и «former» равным "" и «former function» равным "" и «limit» равным 4
      и «expected» равным ["строк было бы"] и «words» равным "предел")
    дано answers равно пустой список
    ожидается нет
  пусть said равно (соединить («Job json» от («Probe job» от probe и answers) и answers) по "")
  пусть plain равно (соединить (разделить (соединить (разделить said по "\"") по "") по "\n") по "")
  пусто (отфильтровать (probe.«expected») где hoped → не (plain содержит hoped))

тотальная функция «Probes verdict»
  принимает answers: список «Answer»
  возвращает «Продолжение»
  пример «Without files every probe is wrong»
    дано answers равно пустой список
    ожидается вариант Провал с код равным "FLANG_BEHAVIOR_PROBE" и сообщение равным "пробы таблицы поведения
  НЕВЕРНО  refactoring: переименование и новое тело при том же поведении дают пустой дифф
  НЕВЕРНО  flip: согласованная правка кода и постусловия видна перевернувшимися строками
  НЕВЕРНО  complete: роль и признак перебраны целиком: восемь строк, таблица полная
  НЕВЕРНО  number: число на входе даёт выборку, а не полную таблицу
  НЕВЕРНО  forgery: число внутри варианта не делает таблицу полной
  НЕВЕРНО  limit: предел строк назван числом, таблица не урезана молча"
  пусть lines равно (отобразить («Probe cases») как probe →
    соединить [(если «Probe holds» от probe и answers то "  верно    " иначе "  НЕВЕРНО  "), (probe.«name»), ": ",
      (probe.«words»)] по "")
  пусть wrong равно (отфильтровать («Probe cases») где probe → не («Probe holds» от probe и answers))
  пусть text равно (соединить (приписать "пробы таблицы поведения" к lines) по "\n")
  если пусто wrong
    то вариант «Конец работы» с значение равным text
    иначе вариант «Провал» с код равным "FLANG_BEHAVIOR_PROBE" и сообщение равным text

тотальная функция «Tables said»
  принимает tables: список «Table», json: признак
  возвращает строка
  пример «Nothing to say without tables»
    дано tables равно пустой список
    дано json равно нет
    ожидается ""
  пусть opening равно («Table at» от tables и 1)
  («Chosen» от [(«When» от (пусто tables) и ""),
    («When» от ((длина tables) равен 1) и (соединить (если json то («Table json» от opening) иначе
      («Table lines» от opening)) по "\n")),
    («When» от json и (соединить («Change json» от («Compare» от opening и («Table at» от tables и 2))) по "\n"))]
    и (соединить («Change lines» от («Compare» от opening и («Table at» от tables и 2))) по "\n"))

тотальная функция «Table verdict»
  принимает answers: список «Answer»
  возвращает «Продолжение»
  пример «Without a function there is nothing to build»
    дано answers равно [запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang"])]
    ожидается (вариант Провал с код равным "FLANG_BEHAVIOR_USAGE"
      и сообщение равным "звать: bootstrap/flang run-script behavior <файл> «Функция» [ключи]")
  пусть tables равно (отобразить («Versions» от answers) как version → «Version table» от version и answers)
  пусть json равно («Has flag» от («Arguments of» от answers) и "--json")
  пусть usage равно (вариант «Провал» с код равным "FLANG_BEHAVIOR_USAGE" и сообщение равным («Usage»))
  пусть unread равно (соединить ["файл не прочитан: ", («Argument at» от 1 и answers), " — ",
    («Errors of» от "new" и answers)] по "")
  пусть formerly равно (соединить ["прежняя версия не прочитана: ", («Former label» от answers), " — ",
    («Errors of» от "old" и answers)] по "")
  («Chosen» от [(«When» от (пусто («Argument at» от 2 и answers)) и usage),
    («When» от (не ((«Exit code of» от "new" и answers) равен 0))
      и (вариант «Провал» с код равным "FLANG_BEHAVIOR_SOURCE" и сообщение равным unread)),
    («When» от ((«Compared» от answers) и притом (не ((«Exit code of» от "old" и answers) равен 0)))
      и (вариант «Провал» с код равным "FLANG_BEHAVIOR_SOURCE" и сообщение равным formerly)),
    («When» от (не (пусто tables)) и (вариант «Конец работы» с значение равным («Tables said» от tables и json)))]
    и usage)

тотальная функция «Acknowledged»
  принимает log: строка
  возвращает список строки
  пример «A trailer names the file whose rules change on purpose»
    дано log равно "feat(access): owners read archived reports\n\nBehavior-change: docs/a.flang\n"
    ожидается ["docs/a.flang"]
  (отобразить (отфильтровать («Lines» от log) где line → line начинается с "Behavior-change: ")
    как line → «Without blanks» от («After» от "Behavior-change: " и line))

тотальная функция «Job change»
  принимает job: «Job», answers: список «Answer»
  возвращает «Change»
  пример «A review job that could not be built changes nothing»
    дано job равно запись «Job» с «path» равным "а.flang" и «versions» равным [(запись «Version» с «key» равным "new"
      и «label» равным "а.flang" и «source» равным "модуль «М»\n"
      и «shape» равным (запись «Shape» с «found» равным нет и «generic» равным нет и «name» равным "Ф"
      и «parameters» равным пустой список и «returns» равным "" и «requires» равным пустой список
      и «ensures» равным 0 и «given» равным пустой список и «block» равным "")
      и «inputs» равным (запись «Inputs» с «names» равным пустой список и «rows» равным пустой список
      и «complete» равным да и «size» равным 1 и «problem» равным "функции «Ф» в файле нет")
      и «probe» равным "/srv/.behavior-probe-new-а.flang"), (запись «Version» с «key» равным "new"
      и «label» равным "а.flang" и «source» равным "модуль «М»\n"
      и «shape» равным (запись «Shape» с «found» равным нет и «generic» равным нет и «name» равным "Ф"
      и «parameters» равным пустой список и «returns» равным "" и «requires» равным пустой список
      и «ensures» равным 0 и «given» равным пустой список и «block» равным "")
      и «inputs» равным (запись «Inputs» с «names» равным пустой список и «rows» равным пустой список
      и «complete» равным да и «size» равным 1 и «problem» равным "функции «Ф» в файле нет")
      и «probe» равным "/srv/.behavior-probe-new-а.flang")]
    дано answers равно пустой список
    ожидается (запись «Change» с «before» равным (запись «Table» с «function» равным "Ф" и «file» равным "а.flang"
      и «names» равным (пустой список) и «complete» равным да и «size» равным 0 и «rows» равным (пустой список)
      и «outcomes» равным (пустой список) и «problem» равным "функции «Ф» в файле нет")
      и «after» равным (запись «Table» с «function» равным "Ф" и «file» равным "а.flang"
      и «names» равным (пустой список) и «complete» равным да и «size» равным 0 и «rows» равным (пустой список)
      и «outcomes» равным (пустой список) и «problem» равным "функции «Ф» в файле нет")
      и «flipped» равным (пустой список) и «appeared» равным (пустой список) и «vanished» равным (пустой список)
      и «same» равным 0)
  «Compare» от («Version table» от (элемент 1 в (job.«versions»))
    и answers) и («Version table» от (элемент 2 в (job.«versions»)) и answers)

тотальная функция «Flipped»
  принимает change: «Change»
  возвращает признак
  пример «A flipped row counts»
    дано change равно (запись «Change» с «before» равным (запись «Table» с «function» равным "Ф" и «file» равным "ф"
      и «names» равным ["а"] и «complete» равным да и «size» равным 1 и «rows» равным [["да"]]
      и «outcomes» равным ["нет"] и «problem» равным "") и «after» равным (запись «Table» с «function» равным "Ф"
      и «file» равным "ф" и «names» равным ["а"] и «complete» равным да и «size» равным 1 и «rows» равным [["да"]]
      и «outcomes» равным ["да"] и «problem» равным "")
      и «flipped» равным [запись «Flip» с «input» равным "а = да" и «before» равным "нет" и «after» равным "да"]
      и «appeared» равным пустой список и «vanished» равным пустой список и «same» равным 0)
    ожидается да
  (не (пусто (change.«flipped»))) или (не (пусто (change.«vanished»)))

тотальная функция «Review verdict»
  принимает answers: список «Answer»
  возвращает «Продолжение»
  пример «No changed rules»
    дано answers равно [запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["review"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["gh/dev"]), запись «Answer» с «name» равным "root" и «reply» равным (вариант
      «Процесс завершён» с код равным 0 и вывод равным "/srv/дерево\n"
      и ошибки равным ""), запись «Answer» с «name» равным "changed" и «reply» равным (вариант
      «Процесс завершён» с код равным 0 и вывод равным "а.flang\n" и ошибки равным "")]
    ожидается (вариант
      «Конец работы» с значение равным "поведение правил против gh/dev: правил с изменённым текстом 0, просчитано 0")
  пусть jobs равно («Review jobs» от answers)
  пусть marked равно («Acknowledged» от («Output of» от "log" и answers))
  пусть unmarked равно (отфильтровать jobs где job → («Flipped» от («Job change» от job и answers))
    и притом (пусто (отфильтровать marked где path → path равен (job.«path»))))
  пусть heading равно (соединить ["поведение правил против ", («Review base» от answers),
    ": правил с изменённым текстом ", (к строке (длина («Rule places» от answers))),
    ", просчитано ", (к строке (длина jobs))] по "")
  пусть body равно (свёртка jobs начиная с [heading] как told и job → «Соединить списки» от told
    и (приписать "" к («Change lines» от («Job change» от job и answers))))
  пусть text равно (если «Has flag» от («Arguments of» от answers) и "--markdown"
    то соединить ["### Таблица поведения правил", "", "```text", (соединить body по "\n"), "```"] по "\n"
    иначе соединить body по "\n")
  «Chosen» от [(«When» от (пусто («Review base» от answers)) и (вариант «Провал» с код равным "FLANG_BEHAVIOR_USAGE"
    и сообщение равным
      (соединить ["звать: bootstrap/flang run-script behavior:review [<база>] [--markdown] [--out <файл>];",
        " без базы — ветка dev удалённого"] по ""))),
    («When» от (не ((«Exit code of» от "changed" и answers) равен 0))
      и (вариант «Провал» с код равным "FLANG_BEHAVIOR_SOURCE" и сообщение равным
      (соединить ["список изменённых файлов не получен: ", («Errors of» от "changed" и answers)] по ""))),
    («When» от (не (пусто unmarked)) и (вариант «Провал» с код равным "FLANG_BEHAVIOR_FLIPPED"
      и сообщение равным (соединить [text, "",
      (соединить ["ПОВЕДЕНИЕ ПЕРЕВЕРНУЛОСЬ без отметки в файлах: ",
        (соединить (отобразить unmarked как job → job.«path») по ", ")] по ""),
      "Посмотрите перевернувшиеся строки выше. Если перемена задумана, допишите в сообщение коммита строку",
      "Behavior-change: <путь файла> — по одной на файл."] по "\n")))] и (вариант
        «Конец работы» с значение равным text)

тотальная функция «Verdict»
  принимает answers: список «Answer»
  возвращает «Продолжение»
  пример «A plan without arguments explains how to call it»
    дано answers равно [запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"])]
    ожидается (вариант Провал с код равным "FLANG_BEHAVIOR_USAGE"
      и сообщение равным "звать: bootstrap/flang run-script behavior <файл> «Функция» [ключи]")
  разбор («Kind of» от answers)
    случай «Table kind»
      то «Table verdict» от answers
    случай «Review kind»
      то «Review verdict» от answers
    случай «Probes kind»
      то «Probes verdict» от answers

тотальная функция «Said»
  принимает continuation: «Продолжение»
  возвращает строка
  пример «A finished plan says its text»
    дано continuation равно вариант «Конец работы» с значение равным "таблица"
    ожидается "таблица"
  пример «A plan that gave up says its message»
    дано continuation равно вариант «Провал» с код равным "FLANG_BEHAVIOR_USAGE" и сообщение равным "звать так"
    ожидается "звать так"
  разбор continuation
    случай вариант «Конец работы» с значение как text
      то text
    случай вариант «Провал» с код как code и сообщение как text
      то text
    случай любое
      то ""

тотальная функция «Print path»
  принимает answers: список «Answer»
  возвращает строка
  пример «Without --out the report goes to the output»
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--json"]),
      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается "/dev/stdout"
  пусть out равно («Option» от («Arguments of» от answers) и ["--out", "--в-файл"])
  если пусто out то "/dev/stdout" иначе («Absolute» от («Setting of» от "pwd" и («Root path» от answers) и answers)
    и out)

тотальная функция «Verdict words»
  принимает continuation: «Продолжение»
  возвращает список строки
  пример «A plan that gave up keeps its code»
    дано continuation равно вариант «Провал» с код равным "FLANG_BEHAVIOR_FLIPPED" и сообщение равным "дифф"
    ожидается ["FLANG_BEHAVIOR_FLIPPED", "дифф"]
  пример «A finished plan has no code»
    дано continuation равно вариант «Конец работы» с значение равным "таблица"
    ожидается ["", "таблица"]
  разбор continuation
    случай вариант «Провал» с код как code и сообщение как text
      то [code, text]
    случай любое
      то ["", («Said» от continuation)]

тотальная функция «Kept verdict»
  принимает words: список строки
  возвращает «Продолжение»
  пример «A kept success stays a success»
    дано words равно ["", "таблица"]
    ожидается вариант «Конец работы» с значение равным "таблица"
  пример «A kept failure fails again»
    дано words равно ["FLANG_BEHAVIOR_FLIPPED", "дифф"]
    ожидается вариант «Провал» с код равным "FLANG_BEHAVIOR_FLIPPED" и сообщение равным "дифф"
  пусть code равно (если пусто words то "" иначе (элемент 1 в words))
  пусть text равно (соединить (хвост words) по "\n")
  если пусто code
    то вариант «Конец работы» с значение равным text
    иначе вариант «Провал» с код равным code и сообщение равным text

тотальная функция «Finish»
  принимает stages: число, answers: список «Answer»
  возвращает «Продолжение»
  пример «A kept verdict ends the plan»
    дано stages равно 0
    дано answers равно [запись «Answer» с «name» равным "verdict" и «reply» равным (вариант
      «Доводы» с доводы равным ["", "таблица"])]
    ожидается вариант «Конец работы» с значение равным "таблица"
  если «Answered» от "verdict" и answers
    то «Kept verdict» от («Given of» от "verdict" и answers)
    иначе «Print verdict» от stages и answers и («Verdict words» от («Verdict» от answers))

тотальная функция «Print verdict»
  принимает stages: число, answers: список «Answer», words: список строки
  возвращает «Продолжение»
  пример «The report is written and the verdict kept»
    дано stages равно 0
    дано answers равно пустой список
    дано words равно ["", "таблица"]
    ожидается вариант Сделать с поручение равным (вариант «Записать файл» с путь равным "/dev/stdout"
      и содержимое равным "таблица\n") и потом равным (запись «Inquiry» с «asked» равным "print"
      и «queue» равным (пустой список) и «stages» равным 0
      и «answers» равным [(запись «Answer» с «name» равным "verdict"
      и «reply» равным (вариант Доводы с доводы равным ["", "таблица"]))])
  пусть kept равно (добавить (запись «Answer» с «name» равным "verdict"
    и «reply» равным (вариант «Доводы» с доводы равным words)) к answers)
  пусть text равно (соединить [(соединить (хвост words) по "\n"), "\n"] по "")
  «Ask» от («Write» от "print" и («Print path» от answers) и text) и (пустой список) и stages и kept

тотальная функция «Proceed»
  принимает queue: список «Question», stages: число, answers: список «Answer»
  возвращает «Продолжение»
  пример «A question in the queue is asked»
    дано queue равно [запись «Question» с «name» равным "root" и «order» равным (вариант «Прочитать доводы»)]
    дано stages равно 6
    дано answers равно пустой список
    ожидается вариант Сделать с поручение равным (вариант «Прочитать доводы») и потом равным (запись
      «Inquiry» с «asked» равным "root" и «queue» равным (пустой список) и «stages» равным 6
      и «answers» равным (пустой список))
  разбор queue
    случай голова и хвост
      то «Ask» от (голова) и (хвост) и stages и answers
    случай пусто
      то если stages не больше 0
        то «Finish» от stages и answers
        иначе «Proceed» от («Stage» от (stages минус 1) и answers) и (stages минус 1) и answers

тотальная функция «Begin in mode»
  принимает mode: строка
  возвращает «Inquiry»
  пример «The mode is the first answer»
    дано mode равно "table"
    ожидается (запись «Inquiry» с «asked» равным "" и «queue» равным (пустой список) и «stages» равным 7
      и «answers» равным [(запись «Answer» с «name» равным "mode"
      и «reply» равным (вариант Доводы с доводы равным ["table"]))])
  запись «Inquiry» с «asked» равным "" и «queue» равным пустой список и «stages» равным 7 и «answers» равным [
    запись «Answer» с «name» равным "mode" и «reply» равным (вариант «Доводы» с доводы равным [mode])]

тотальная функция «Begin table»
  возвращает «Inquiry»
  пример «A table begins with its mode»
    ожидается (запись «Inquiry» с «asked» равным "" и «queue» равным (пустой список) и «stages» равным 7
      и «answers» равным [(запись «Answer» с «name» равным "mode"
      и «reply» равным (вариант Доводы с доводы равным ["table"]))])
  «Begin in mode» от "table"

тотальная функция «Begin review»
  возвращает «Inquiry»
  пример «A review begins with its mode»
    ожидается (запись «Inquiry» с «asked» равным "" и «queue» равным (пустой список) и «stages» равным 7
      и «answers» равным [(запись «Answer» с «name» равным "mode"
      и «reply» равным (вариант Доводы с доводы равным ["review"]))])
  «Begin in mode» от "review"

тотальная функция «Begin probes»
  возвращает «Inquiry»
  пример «Probes begin with their mode»
    ожидается (запись «Inquiry» с «asked» равным "" и «queue» равным (пустой список) и «stages» равным 7
      и «answers» равным [(запись «Answer» с «name» равным "mode"
      и «reply» равным (вариант Доводы с доводы равным ["probes"]))])
  «Begin in mode» от "probes"

тотальная функция «Next»
  принимает inquiry: «Inquiry», reply: «Отклик»
  возвращает «Продолжение»
  пример «The start asks for the arguments»
    дано inquiry равно (запись «Inquiry» с «asked» равным "" и «queue» равным пустой список и «stages» равным 7
      и «answers» равным [запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"])])
    дано reply равно вариант «Пока ничего»
    ожидается вариант Сделать с поручение равным (вариант «Прочитать доводы») и потом равным (запись
      «Inquiry» с «asked» равным "arguments" и «queue» равным [(запись «Question» с «name» равным "pwd"
      и «order» равным (вариант «Прочитать переменную среды» с имя равным "PWD")),
      (запись «Question» с «name» равным "root" и «order» равным (вариант «Запустить процесс» с программа равным "sh"
      и аргументы равным ["-c", "cd \"$0\" && exec \"$@\"", "..", "pwd", "-P"])),
      (запись «Question» с «name» равным "trunk"
      и «order» равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c",
      "cd \"$0\" && exec \"$@\"", "..", "git", "for-each-ref", "--format=%(refname:short)", "refs/remotes/*/dev"]))]
      и «stages» равным 6 и «answers» равным [(запись «Answer» с «name» равным "mode"
      и «reply» равным (вариант Доводы с доводы равным ["table"]))])
  пусть heard равно («Heard» от inquiry и reply)
  («Proceed» от (inquiry.«queue») и (inquiry.«stages»)
    и (если (пусто (inquiry.«queue»)) и притом ((inquiry.«stages») больше 0)
      то («Remembered» от ((inquiry.«stages») минус 1) и heard) иначе heard))

план «Behavior»
  состояние «Inquiry»
  начинает с «Begin table»
  обрабатывает «Next»

план «Review»
  состояние «Inquiry»
  начинает с «Begin review»
  обрабатывает «Next»

план «Probes»
  состояние «Inquiry»
  начинает с «Begin probes»
  обрабатывает «Next»
