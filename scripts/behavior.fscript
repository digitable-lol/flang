тотальная функция «Review job»
  принимает answers: список «Answer», root: строка, place: «Rule place», number: строка
  возвращает «Job»
  пример «A review job compares the base with the branch»
    дано answers равно [запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["review"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["gh/dev"]), запись «Answer» с «name» равным "root" и «reply» равным (вариант
      «Процесс завершён» с код равным 0 и вывод равным "/srv/дерево\n"
      и ошибки равным ""), запись «Answer» с «name» равным "changed" и «reply» равным (вариант
      «Процесс завершён» с код равным 0 и вывод равным "а.flang\n" и ошибки равным "")]
    дано root равно "/srv/дерево"
    дано place равно запись «Rule place» с «path» равным "а.flang" и «name» равным "Ф"
    дано number равно "0"
    ожидается запись «Job» с «path» равным "а.flang" и «versions» равным [(запись «Version» с «key» равным "r0-old"
      и «label» равным "а.flang @ gh/dev" и «source» равным "" и «shape» равным (запись «Shape» с «found» равным нет
      и «generic» равным нет и «name» равным "Ф" и «parameters» равным (пустой список) и «returns» равным ""
      и «requires» равным (пустой список) и «ensures» равным 0 и «given» равным (пустой список) и «block» равным "")
      и «inputs» равным (запись «Inputs» с «names» равным (пустой список) и «rows» равным (пустой список)
      и «complete» равным да и «size» равным 1 и «problem» равным "функции «Ф» в файле нет")
      и «probe» равным "/srv/дерево/.behavior-probe-r0-old-а.flang"), (запись «Version» с «key» равным "r0-new"
      и «label» равным "а.flang" и «source» равным "" и «shape» равным (запись «Shape» с «found» равным нет
      и «generic» равным нет и «name» равным "Ф" и «parameters» равным (пустой список) и «returns» равным ""
      и «requires» равным (пустой список) и «ensures» равным 0 и «given» равным (пустой список) и «block» равным "")
      и «inputs» равным (запись «Inputs» с «names» равным (пустой список) и «rows» равным (пустой список)
      и «complete» равным да и «size» равным 1 и «problem» равным "функции «Ф» в файле нет")
      и «probe» равным "/srv/дерево/.behavior-probe-r0-new-а.flang")]
  пусть older равно («Output of» от (соединить ["old:", (place.«path»)] по "") и answers)
  пусть newer равно («Output of» от (соединить ["new:", (place.«path»)] по "") и answers)
  пусть path равно (соединить [root, "/", (place.«path»)] по "")
  пусть name равно (place.«name»)
  пусть limit равно («Default limit»)
  запись «Job» с «path» равным (place.«path») и «versions» равным [
    («Version made» от (соединить ["r", number, "-old"] по "") и (соединить [(place.«path»), " @ ",
      («Review base» от answers)] по "") и older и name и newer и name и path и limit),
    («Version made» от (соединить ["r", number, "-new"] по "") и (place.«path») и newer и name и older и name и path
