      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается [(запись «Version» с «key» равным "new" и «label» равным "а.flang" и «source» равным ""
      и «shape» равным (запись «Shape» с «found» равным нет и «generic» равным нет и «name» равным "Ф"
      и «parameters» равным (пустой список) и «returns» равным "" и «requires» равным (пустой список)
      и «ensures» равным 0 и «given» равным (пустой список) и «block» равным "")
      и «inputs» равным (запись «Inputs» с «names» равным (пустой список) и «rows» равным (пустой список)
      и «complete» равным да и «size» равным 1 и «problem» равным "функции «Ф» в файле нет")
      и «probe» равным "/srv/дерево/.behavior-probe-new-а.flang")]
  свёртка («Jobs» от answers) начиная с (пустой список) как all и job → «Соединить списки» от all и (job.«versions»)

тотальная функция «Probing»
  принимает answers: список «Answer»
  возвращает список «Version»
  пример «A version without rows is not probed»
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--json"]),
      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается пустой список
  отфильтровать («Versions» от answers) где version → пусто ((version.«inputs»).«problem»)

тотальная функция «Setup»
  возвращает список «Question»
  пример «The first questions»
    ожидается [(запись «Question» с «name» равным "arguments" и «order» равным (вариант «Прочитать доводы»)), (запись
      «Question» с «name» равным "pwd"
      и «order» равным (вариант «Прочитать переменную среды» с имя равным "PWD")), (запись
      «Question» с «name» равным "root" и «order» равным (вариант «Запустить процесс» с программа равным "sh"
      и аргументы равным ["-c", "cd \"$0\" && exec \"$@\"", "..", "pwd",
      "-P"])), (запись «Question» с «name» равным "trunk"
      и «order» равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c",
      "cd \"$0\" && exec \"$@\"", "..", "git", "for-each-ref", "--format=%(refname:short)", "refs/remotes/*/dev"]))]
  [(«Arguments» от "arguments"), («Environment» от "pwd" и "PWD"), («Run from» от "root" и («Root») и "pwd" и ["-P"]),
    («Run from» от "trunk" и («Root») и "git" и ["for-each-ref", "--format=%(refname:short)", "refs/remotes/*/dev"])]

тотальная функция «Sources»
  принимает answers: список «Answer»
  возвращает список «Question»
  пример «A table reads its file»
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--json"]),
      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается [(запись «Question» с «name» равным "new"
      и «order» равным (вариант «Прочитать файл» с путь равным "/srv/дерево/а.flang"))]
  пусть path равно («Target path» от answers)
  пусть formerly равно (если пусто («Against» от answers)
    то [(«Read» от "old" и («Former path» от answers))]
    иначе [(«Run from» от "old" и («Directory of» от path) и "git" и ["show", (соединить [(«Against» от answers),
      ":./", («Base of» от path)] по "")])])
  «Chosen» от [(«When» от (((«Mode» от answers) равен "table") и притом (пусто («Argument at» от 2 и answers)))
    и (пустой список)),
    («When» от ((«Mode» от answers) равен "table") и («Соединить списки» от [(«Read» от "new" и path)]
      и (если «Compared» от answers то formerly иначе (пустой список)))),
    («When» от (((«Mode» от answers) равен "review") и притом (не (пусто («Review base» от answers)))) и [
      («Run from» от "changed" и («Root») и "git" и ["diff", "--name-only", "--diff-filter=M",
        (соединить [(«Review base» от answers), "...HEAD"] по ""), "--", "*.flang", "*.fscript"]),
      («Run from» от "log" и («Root») и "git" и ["log", "--format=%B", (соединить [(«Review base» от answers),
        "..HEAD"] по "")])]),
    («When» от ((«Mode» от answers) равен "probes") и («Probe questions» от answers))] и (пустой список)

тотальная функция «Changed sources»
  принимает answers: список «Answer»
  возвращает список «Question»
  пример «A table reads no changed files»
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--json"]),
      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается пустой список
  если («Mode» от answers) равен "review"
    то («Gathered questions» от (отобразить («Changed paths» от answers) как path → «Source pair» от answers и path))
    иначе пустой список

тотальная функция «Gathered questions»
  принимает parts: список список «Question»
  возвращает список «Question»
  пример «No parts ask nothing»
    дано parts равно пустой список
    ожидается пустой список
  свёртка parts начиная с (пустой список) как asked и part → «Соединить списки» от asked и part

тотальная функция «Source pair»
  принимает answers: список «Answer», path: строка
  возвращает список «Question»
  пример «Both versions of a changed file»
    дано answers равно [запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["review"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["gh/dev"]), запись «Answer» с «name» равным "root" и «reply» равным (вариант
      «Процесс завершён» с код равным 0 и вывод равным "/srv/дерево\n"
      и ошибки равным ""), запись «Answer» с «name» равным "changed" и «reply» равным (вариант
      «Процесс завершён» с код равным 0 и вывод равным "а.flang\n" и ошибки равным "")]
    дано path равно "а.flang"
    ожидается [(запись «Question» с «name» равным "new:а.flang"
      и «order» равным (вариант «Прочитать файл» с путь равным "/srv/дерево/а.flang")), (запись
      «Question» с «name» равным "old:а.flang" и «order» равным (вариант «Запустить процесс» с программа равным "sh"
      и аргументы равным ["-c", "cd \"$0\" && exec \"$@\"", "..", "git", "show", "gh/dev:а.flang"]))]
  [(«Read» от (соединить ["new:", path] по "") и (соединить [(«Root path» от answers), "/", path] по "")),
    («Run from» от (соединить ["old:", path] по "") и («Root») и "git" и ["show",
      (соединить [(«Review base» от answers), ":", path] по "")])]

тотальная функция «Probe writes»
  принимает answers: список «Answer»
  возвращает список «Question»
  пример «Nothing to write without rows»
    дано answers равно ([запись «Answer» с «name» равным "mode" и «reply» равным (вариант
      «Доводы» с доводы равным ["table"]), запись «Answer» с «name» равным "arguments" и «reply» равным (вариант
      «Доводы» с доводы равным ["а.flang", "«Ф»", "--json"]),
      запись «Answer» с «name» равным "pwd" и «reply» равным (вариант
      «Значение среды» с значение равным "/srv/дерево"),
      запись «Answer» с «name» равным "root" и «reply» равным (вариант «Процесс завершён» с код равным 0
      и вывод равным "/srv/дерево\n" и ошибки равным "")])
    ожидается пустой список
