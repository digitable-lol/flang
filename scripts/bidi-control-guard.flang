// ── План ───────────────────────────────────────────────────────────────────

объект «Дело»
  «беды»: список строки
  «файлов»: число
  «целей»: число

тип «Ход»
  вариант «Ждём каталог»
  вариант «Ждём запись пробы»
  вариант «Ждём проверку пробы»
  вариант «Ждём печать» содержит дело: «Дело», цель: строка, осталось: список строки
  вариант «Ждём список файлов» содержит дело: «Дело», цель: строка, осталось: список строки
  вариант «Ждём файл» содержит дело: «Дело», цель: строка, счёт: «Счёт», очередь: список строки, осталось: список строки
  вариант «Ждём уборку» содержит дело: «Дело»

тотальная функция «Начать»
  возвращает «Ход»
  обеспечивает «ход начинается вариантом Ждём каталог» результат равен (вариант «Ждём каталог»)
  пример «Первым делом заводится каталог проб»
    ожидается вариант «Ждём каталог»
  вариант «Ждём каталог»

тотальная функция «Запустить»
  принимает программа: строка, аргументы: список строки, потом: «Ход»
  возвращает «Продолжение»
  вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным программа и аргументы равным аргументы) и потом равным потом

тотальная функция «Нечем смотреть»
  принимает что: строка
  возвращает «Продолжение»
  вариант «Провал» с код равным "FLANG_BIDI_NECHEM_SMOTRET" и сообщение равным (соединить [что, " — смотреть нечем, и это не приговор целям печати"] по "")

тотальная функция «Итог»
  принимает дело: «Дело»
  возвращает «Продолжение»
  пример «Сырых нет — план доходит до конца»
    дано дело равно запись «Дело» с «беды» равным пустой список и «файлов» равным 45 и «целей» равным 9
    ожидается вариант «Конец работы» с значение равным "двунаправленные: целей 9, файлов 45, сырых управляющих 0"
  разбор (дело.«беды»)
    случай пусто
      то вариант «Конец работы» с значение равным (соединить ["двунаправленные: целей ", (к строке (дело.«целей»)), ", файлов ", (к строке (дело.«файлов»)), ", сырых управляющих 0"] по "")
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_BIDI_SYROY" и сообщение равным (соединить (приписать (соединить ["двунаправленные ОТКАЗЫВАЮТ, мест ", (к строке (длина (дело.«беды»))), " при ", (к строке (дело.«файлов»)), " файлах ", (к строке (дело.«целей»)), " целей. Экранировать обязан и строковый литерал, и весь остальной вывод: имя модуля уезжает в комментарий шапки, а комментарий читают первым:"] по "") к (дело.«беды»)) по "\n  · ")

тотальная функция «Пойти по целям»
  принимает дело: «Дело», очередь: список строки
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то «Запустить» от "rm" и ["-rf", («Каталог проб»)] и (вариант «Ждём уборку» с дело равным дело)
    случай голова и хвост
      то «Запустить» от («Двоичный») и ["emit", («Файл пробы»), "--target", голова, "--out", («Куда печатать» от голова)] и (вариант «Ждём печать» с дело равным дело и цель равным голова и осталось равным хвост)

тотальная функция «Пойти по файлам»
  принимает дело: «Дело», цель: строка, счёт: «Счёт», очередь: список строки, осталось: список строки
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то «Пойти по целям» от (запись «Дело» с «беды» равным («Беды цели» от (дело.«беды») и цель и счёт) и «файлов» равным ((дело.«файлов») плюс (счёт.«файлов»)) и «целей» равным ((дело.«целей») плюс 1)) и осталось
    случай голова и хвост
      то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным голова) и потом равным (вариант «Ждём файл» с дело равным дело и цель равным цель и счёт равным счёт и очередь равным очередь и осталось равным осталось)

тотальная функция «Непустые»
  принимает строки: список строки
  возвращает список строки
  пример «Пустые строки выброшены»
    дано строки равно ["раз", "", "два"]
    ожидается ["раз", "два"]
  отфильтровать строки где строчка → не (строчка равен "")

тотальная функция «После каталога»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  обеспечивает «отклик вида Пока ничего уходит своей ветвью» если отклик равен (вариант «Пока ничего») то (результат равен («Запустить» от "mkdir" и ["-p", («Каталог проб»)] и (вариант «Ждём каталог»))) иначе да
  пример «Первый шаг — завести каталог проб»
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "mkdir" и аргументы равным ["-p", "../tmp/dvunapravlennye"]) и потом равным (вариант «Ждём каталог»)
  разбор отклик
    случай вариант «Пока ничего»
      то «Запустить» от "mkdir" и ["-p", («Каталог проб»)] и (вариант «Ждём каталог»)
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то если не (код равен 0)
        то «Нечем смотреть» от "каталог проб не заведён"
        иначе вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным («Файл пробы») и содержимое равным («Текст пробы»)) и потом равным (вариант «Ждём запись пробы»)
    случай любое
      то «Нечем смотреть» от "mkdir не запустился"

тотальная функция «После записи пробы»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Записано» с сколько как сколько
      то «Запустить» от («Двоичный») и ["check", («Файл пробы»)] и (вариант «Ждём проверку пробы»)
    случай любое
      то «Нечем смотреть» от "проба не записана"

тотальная функция «После проверки пробы»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то если не (код равен 0)
        то «Нечем смотреть» от (соединить ["проба сама не проходит проверку (код ", (к строке код), "): ", ошибки] по "")
        иначе «Пойти по целям» от (запись «Дело» с «беды» равным пустой список и «файлов» равным 0 и «целей» равным 0) и («Цели»)
    случай любое
      то «Нечем смотреть» от "двоичный не ответил на проверку пробы; собрать: make -C bootstrap"

тотальная функция «После печати»
  принимает дело: «Дело», цель: строка, осталось: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то если не (код равен 0)
        то «Нечем смотреть» от (соединить ["цель «", цель, "» не напечатала пробу (код ", (к строке код), "): ", ошибки] по "")
        иначе «Запустить» от "find" и [(«Куда печатать» от цель), "-type", "f"] и (вариант «Ждём список файлов» с дело равным дело и цель равным цель и осталось равным осталось)
    случай любое
      то «Нечем смотреть» от (соединить ["печать цели «", цель, "» не запустилась"] по "")

тотальная функция «После списка файлов»
  принимает дело: «Дело», цель: строка, осталось: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то если не (код равен 0)
        то «Нечем смотреть» от (соединить ["find не нашёл каталога печати цели «", цель, "»"] по "")
        иначе «Пойти по файлам» от дело и цель и («Пустой счёт») и («Непустые» от (разделить вывод по "\n")) и осталось
    случай любое
      то «Нечем смотреть» от "find не запустился"

тотальная функция «После файла»
  принимает дело: «Дело», цель: строка, счёт: «Счёт», очередь: список строки, осталось: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то «Пойти по файлам» от дело и цель и счёт и (пустой список) и осталось
    случай голова и хвост
      то разбор отклик
        случай вариант «Прочитано» с содержимое как содержимое
          то «Пойти по файлам» от дело и цель и («Учесть файл» от счёт и голова и содержимое) и хвост и осталось
        случай любое
          то «Нечем смотреть» от (соединить ["напечатанный файл не прочитан: ", голова] по "")

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  обеспечивает «ход вида Ждём каталог уходит своей ветвью» если ход равен (вариант «Ждём каталог») то (результат равен («После каталога» от отклик)) иначе да
  обеспечивает «ход вида Ждём запись пробы уходит своей ветвью» если ход равен (вариант «Ждём запись пробы») то (результат равен («После записи пробы» от отклик)) иначе да
  обеспечивает «ход вида Ждём проверку пробы уходит своей ветвью» если ход равен (вариант «Ждём проверку пробы») то (результат равен («После проверки пробы» от отклик)) иначе да
  разбор ход
    случай вариант «Ждём каталог»
      то «После каталога» от отклик
    случай вариант «Ждём запись пробы»
      то «После записи пробы» от отклик
    случай вариант «Ждём проверку пробы»
      то «После проверки пробы» от отклик
    случай вариант «Ждём печать» с дело как дело и цель как цель и осталось как осталось
      то «После печати» от дело и цель и осталось и отклик
    случай вариант «Ждём список файлов» с дело как дело и цель как цель и осталось как осталось
      то «После списка файлов» от дело и цель и осталось и отклик
    случай вариант «Ждём файл» с дело как дело и цель как цель и счёт как счёт и очередь как очередь и осталось как осталось
      то «После файла» от дело и цель и счёт и очередь и осталось и отклик
    случай вариант «Ждём уборку» с дело как дело
      то «Итог» от дело

план «Двунаправленные не печатаются сырыми»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
