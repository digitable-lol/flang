модуль «Печать журнала изменений»
  использует «Журнал изменений»

// Печатает `CHANGELOG.md` из тегов и коммитов.
//
//   bootstrap/flang io scripts/build-changelog.flang
//
// Весь разбор и всю печать считает `changelog.flang` — чистыми функциями, из
// вывода `git for-each-ref` и `git log`. Здесь остался только план: у кого
// спросить, куда положить и что сказать, если хозяин отказал. Раньше это была
// `scripts/build-changelog.mjs` на JavaScript.
//
// ПОЧЕМУ ЖУРНАЛ БЕРЁТСЯ КУСКАМИ. Хозяин отдаёт плану не больше 1 МиБ вывода
// процесса (`FLANG_IO_SPAWN`), а `git log --name-only` по всей истории даёт
// 6,7 МБ, и даже один диапазон `v0.4.8..v0.5.0` — 2,1 МБ. Поэтому каждый
// диапазон читается окнами по 60 коммитов ключами `--skip` и `--max-count`.
// Порядок git при этом не меняется, и склеенные окна дают ровно тот же список,
// что и один вызов: это проверено сверкой с прежним скриптом побайтово.

тип «Ход»
  вариант «Ждём теги»
  вариант «Ждём коммиты» содержит готовые: список «Релиз», осталось: список «Тег», текущий: «Тег», предыдущий: строка, итог: «Итог разбора», пропуск: число
  вариант «Ждём свежие» содержит релизы: список «Релиз», предыдущий: строка, итог: «Итог разбора», пропуск: число
  вариант «Ждём пакет» содержит релизы: список «Релиз», свежие: «Итог разбора»
  вариант «Ждём запись» содержит сколько: число, последний: строка

тотальная функция «Начать»
  возвращает «Ход»
  пример «план начинается с вопроса к git»
    ожидается вариант «Ждём теги»
  вариант «Ждём теги»

тотальная функция «Окно»
  возвращает число
  60

тотальная функция «Образец лога»
  возвращает строка
  соединить ["--format=", («Разделитель записи»), "%H", («Разделитель поля»), "%aI", («Разделитель поля»), "%s", («Разделитель поля»), "%b", («Конец тела»)] по ""

тотальная функция «Образец тегов»
  возвращает строка
  соединить ["--format=", («Разделитель записи»), "%(refname:short)", («Разделитель поля»), "%(creatordate:iso-strict)", («Разделитель поля»), "%(objectname)", («Разделитель поля»), "%(*objectname)", («Разделитель поля»), "%(contents:subject)", («Разделитель поля»), "%(contents:body)", («Конец тела»)] по ""

тотальная функция «Доводы тегов»
  возвращает список строки
  ["-C", "..", "-c", "core.quotepath=false", "for-each-ref", («Образец тегов»), "refs/tags"]

// Диапазон коммитов релиза: от прежнего тега до нынешнего, а у самого первого
// — вся история до него.
тотальная функция «Диапазон»
  принимает предыдущий: строка, нынешний: строка
  возвращает строка
  пример «между тегами»
    дано предыдущий равно "v0.4.0"
    дано нынешний равно "v0.4.1"
    ожидается "v0.4.0..v0.4.1"
  пример «у первого тега прежнего нет»
    дано предыдущий равно ""
    дано нынешний равно "v0.4.0"
    ожидается "v0.4.0"
  если (длина предыдущий) равен 0
    то нынешний
    иначе соединить [предыдущий, "..", нынешний] по ""

тотальная функция «Доводы лога»
  принимает диапазон: строка, пропуск: число
  возвращает список строки
  пример «окно со сдвигом»
    дано диапазон равно "v0.4.0..v0.4.1"
    дано пропуск равно 60
    ожидается ["-C", "..", "-c", "core.quotepath=false", "log", "--no-merges", "--name-only", "--format=\u0001%H\u0002%aI\u0002%s\u0002%b\u0003", "--skip=60", "--max-count=60", "v0.4.0..v0.4.1"]
  ["-C", "..", "-c", "core.quotepath=false", "log", "--no-merges", "--name-only", («Образец лога»), (соединить ["--skip=", (к строке пропуск)] по ""), (соединить ["--max-count=", (к строке («Окно»))] по ""), диапазон]

тотальная функция «Спросить лог»
  принимает диапазон: строка, пропуск: число, потом: «Ход»
  возвращает «Продолжение»
  вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "git" и аргументы равным («Доводы лога» от диапазон и пропуск)) и потом равным потом

// Следующий тег или, если теги кончились, хвост после последнего.
тотальная функция «Дальше по тегам»
  принимает готовые: список «Релиз», осталось: список «Тег», предыдущий: строка, неизвестные: список строки
  возвращает «Продолжение»
  разбор осталось
    случай пусто
      то «Спросить лог» от («Диапазон конца» от предыдущий) и 0 и (вариант «Ждём свежие» с релизы равным готовые и предыдущий равным предыдущий и итог равным («Итог с корнями» от неизвестные) и пропуск равным 0)
    случай голова и хвост
      то «Спросить лог» от («Диапазон» от предыдущий и (голова.«имя»)) и 0 и (вариант «Ждём коммиты» с готовые равным готовые и осталось равным хвост и текущий равным голова и предыдущий равным предыдущий и итог равным («Итог с корнями» от неизвестные) и пропуск равным 0)

тотальная функция «Диапазон конца»
  принимает предыдущий: строка
  возвращает строка
  пример «после последнего тега»
    дано предыдущий равно "v0.6.2"
    ожидается "v0.6.2..HEAD"
  пример «тегов нет вовсе»
    дано предыдущий равно ""
    ожидается "HEAD"
  если (длина предыдущий) равен 0
    то "HEAD"
    иначе соединить [предыдущий, "..HEAD"] по ""

тотальная функция «Путь журнала»
  возвращает строка
  "../CHANGELOG.md"

тотальная функция «Путь пакета»
  возвращает строка
  "../package.json"

тотальная функция «Слово итога»
  принимает сколько: число, последний: строка
  возвращает строка
  пример «сказано числом»
    дано сколько равно 14
    дано последний равно "0.6.2"
    ожидается "журнал напечатан: релизов 14, последний 0.6.2"
  соединить ["журнал напечатан: релизов ", (к строке сколько), ", последний ", последний] по ""

тотальная функция «Беда процесса»
  принимает что: строка, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то вариант «Провал» с код равным "FLANG_ZHURNAL_GIT" и сообщение равным (соединить [что, ": git ответил кодом ", (к строке код), ": ", ошибки, " — смотреть нечем, и это не приговор журналу"] по "")
    случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
      то вариант «Провал» с код равным "FLANG_ZHURNAL_GIT" и сообщение равным (соединить [что, ": git убит сигналом ", сигнал, " — смотреть нечем"] по "")
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_ZHURNAL_GIT" и сообщение равным (соединить [что, ": git не запустился: ", код, " / ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным (соединить [что, ": ждали ответа от git"] по "")

тотальная функция «После окна коммитов»
  принимает готовые: список «Релиз», осталось: список «Тег», текущий: «Тег», предыдущий: строка, итог: «Итог разбора», пропуск: число, вывод: строка
  возвращает «Продолжение»
  пусть окно равно («Разобрать лог» от вывод)
  пусть дальше равно («Досыпать разбор» от итог и окно)
  пусть следующий равно (пропуск плюс («Окно»))
  если (длина окно) меньше («Окно»)
    то «Дальше по тегам» от («Вставить релиз» от готовые и («Релиз из тега» от текущий и дальше)) и осталось и (текущий.«имя») и (дальше.«неизвестные»)
    иначе «Спросить лог» от («Диапазон» от предыдущий и (текущий.«имя»)) и следующий и (вариант «Ждём коммиты» с готовые равным готовые и осталось равным осталось и текущий равным текущий и предыдущий равным предыдущий и итог равным дальше и пропуск равным следующий)

тотальная функция «После окна свежих»
  принимает релизы: список «Релиз», предыдущий: строка, итог: «Итог разбора», пропуск: число, вывод: строка
  возвращает «Продолжение»
  пусть окно равно («Разобрать лог» от вывод)
  пусть дальше равно («Досыпать разбор» от итог и окно)
  пусть следующий равно (пропуск плюс («Окно»))
  если (длина окно) меньше («Окно»)
    то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным («Путь пакета»)) и потом равным (вариант «Ждём пакет» с релизы равным релизы и свежие равным дальше)
    иначе «Спросить лог» от («Диапазон конца» от предыдущий) и следующий и (вариант «Ждём свежие» с релизы равным релизы и предыдущий равным предыдущий и итог равным дальше и пропуск равным следующий)

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём теги»
      то разбор отклик
        случай вариант «Пока ничего»
          то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "git" и аргументы равным («Доводы тегов»)) и потом равным (вариант «Ждём теги»)
        случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
          то если не (код равен 0)
            то «Беда процесса» от "теги" и отклик
            иначе «Дальше по тегам» от пустой список и («Разобрать теги» от вывод) и "" и пустой список
        случай любое
          то «Беда процесса» от "теги" и отклик
    случай вариант «Ждём коммиты» с готовые как готовые и осталось как осталось и текущий как текущий и предыдущий как предыдущий и итог как итог и пропуск как пропуск
      то разбор отклик
        случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
          то если не (код равен 0)
            то «Беда процесса» от "коммиты релиза" и отклик
            иначе «После окна коммитов» от готовые и осталось и текущий и предыдущий и итог и пропуск и вывод
        случай любое
          то «Беда процесса» от "коммиты релиза" и отклик
    случай вариант «Ждём свежие» с релизы как релизы и предыдущий как предыдущий и итог как итог и пропуск как пропуск
      то разбор отклик
        случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
          то если не (код равен 0)
            то «Беда процесса» от "невыпущенные коммиты" и отклик
            иначе «После окна свежих» от релизы и предыдущий и итог и пропуск и вывод
        случай любое
          то «Беда процесса» от "невыпущенные коммиты" и отклик
    случай вариант «Ждём пакет» с релизы как релизы и свежие как свежие
      то разбор отклик
        случай вариант «Прочитано» с содержимое как содержимое
          то «Писать журнал» от («Собрать журнал» от релизы и свежие и («Версия пакета» от содержимое))
        случай любое
          то вариант «Провал» с код равным "FLANG_ZHURNAL_NET_PAKETA" и сообщение равным "package.json не прочитан — объявленную версию сверить не с чем"
    случай вариант «Ждём запись» с сколько как сколько и последний как последний
      то разбор отклик
        случай вариант «Записано» с сколько как записано
          то вариант «Конец работы» с значение равным («Слово итога» от сколько и последний)
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным код и сообщение равным сообщение
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали подтверждение записи"

тотальная функция «Писать журнал»
  принимает журнал: «Журнал»
  возвращает «Продолжение»
  вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным («Путь журнала») и содержимое равным («Печать markdown» от журнал)) и потом равным (вариант «Ждём запись» с сколько равным (длина (журнал.«релизы»)) и последний равным (журнал.«последний»))

план «Напечатать журнал изменений»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
