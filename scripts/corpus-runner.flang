тотальная функция «Двоичный»
  возвращает строка
  обеспечивает «двоичный дословно» результат равен "../bootstrap/flang"
  пример «Двоичный лежит на шаг выше»
    ожидается "../bootstrap/flang"
  "../bootstrap/flang"

тотальная функция «Файл ведомости»
  возвращает строка
  обеспечивает «путь дословно» результат равен "../flang/проверки/прогонщик-корпуса.flang"
  пример «Ведомость прогонщика лежит среди проверок»
    ожидается "../flang/проверки/прогонщик-корпуса.flang"
  "../flang/проверки/прогонщик-корпуса.flang"

тотальная функция «Фикстуры»
  возвращает строка
  обеспечивает «каталог дословно» результат равен "../flang/test/fixtures/korpus"
  пример «Корпус из двух файлов, у одного пример заведомо ложен»
    ожидается "../flang/test/fixtures/korpus"
  "../flang/test/fixtures/korpus"

объект «Дело»
  «исходы»: список «Исход»
  «имена»: список строки

тип «Шаг»
  вариант «Версия»
  вариант «Ведомость»
  вариант «Файл ведомости»
  вариант «Каталог»
  вариант «Свод»
  вариант «Маска»
  вариант «Строкой»
  вариант «Носители»
  вариант «Конец»

тип «Ход»
  вариант «Ждём» содержит шаг: «Шаг», дело: «Дело»

тотальная функция «Начать»
  возвращает «Ход»
  обеспечивает «первым делом версия» результат равен (вариант «Ждём» с шаг равным (вариант «Версия») и дело равным (запись «Дело» с «исходы» равным пустой список и «имена» равным пустой список))
  пример «Первым делом спрашивается версия: нет двоичного — смотреть нечем»
    ожидается вариант «Ждём» с шаг равным (вариант «Версия») и дело равным (запись «Дело» с «исходы» равным пустой список и «имена» равным пустой список)
  вариант «Ждём» с шаг равным (вариант «Версия») и дело равным (запись «Дело» с «исходы» равным пустой список и «имена» равным пустой список)

тотальная функция «Имя шага»
  принимает шаг: «Шаг»
  возвращает строка
  обеспечивает «имя шага версия» (не (шаг равен (вариант «Версия»))) или (результат равен "версия двоичного")
  обеспечивает «имя шага ведомость» (не (шаг равен (вариант «Ведомость»))) или (результат равен "ведомость прогонщика")
  обеспечивает «имя шага файл ведомости» (не (шаг равен (вариант «Файл ведомости»))) или (результат равен "файл ведомости")
  обеспечивает «имя шага каталог» (не (шаг равен (вариант «Каталог»))) или (результат равен "каталог")
  обеспечивает «имя шага свод» (не (шаг равен (вариант «Свод»))) или (результат равен "свод каталога")
  обеспечивает «имя шага маска» (не (шаг равен (вариант «Маска»))) или (результат равен "маска")
  обеспечивает «имя шага строкой» (не (шаг равен (вариант «Строкой»))) или (результат равен "ведомость каталога")
  обеспечивает «имя шага носители» (не (шаг равен (вариант «Носители»))) или (результат равен "носители")
  обеспечивает «имя шага конец» (не (шаг равен (вариант «Конец»))) или (результат равен "конец")
  разбор шаг
    случай вариант «Версия»
      то "версия двоичного"
    случай вариант «Ведомость»
      то "ведомость прогонщика"
    случай вариант «Файл ведомости»
      то "файл ведомости"
    случай вариант «Каталог»
      то "каталог"
    случай вариант «Свод»
      то "свод каталога"
    случай вариант «Маска»
      то "маска"
    случай вариант «Строкой»
      то "ведомость каталога"
    случай вариант «Носители»
      то "носители"
    случай вариант «Конец»
      то "конец"

тотальная функция «Доводы шага»
  принимает шаг: «Шаг»
  возвращает список строки
  обеспечивает «доводы шага версия» (не (шаг равен (вариант «Версия»))) или (результат равен ["--version"])
  обеспечивает «доводы шага ведомость» (не (шаг равен (вариант «Ведомость»))) или (результат равен ["run", («Файл ведомости»), "--function", "Ведомость прогонщика корпуса"])
  обеспечивает «доводы шага каталог» (не (шаг равен (вариант «Каталог»))) или (результат равен ["test", («Фикстуры»)])
  обеспечивает «доводы шага свод» (не (шаг равен (вариант «Свод»))) или (результат равен ["test", («Фикстуры»), "--json"])
  обеспечивает «доводы шага маска» (не (шаг равен (вариант «Маска»))) или (результат равен ["test", (соединить [«Фикстуры», "/ch*.flang"] по ""), "--json"])
  обеспечивает «доводы шага строкой» (не (шаг равен (вариант «Строкой»))) или (результат равен ["test", («Фикстуры»), "--ledger"])
  обеспечивает «доводы шага носители» (не (шаг равен (вариант «Носители»))) или (результат равен ["test", "../flang/self/carriers.flang", "--ledger"])
  обеспечивает «у конца доводов нет» (не (шаг равен (вариант «Конец»))) или ((длина результат) равен 0)
  разбор шаг
    случай вариант «Версия»
      то ["--version"]
    случай вариант «Ведомость»
      то ["run", («Файл ведомости»), "--function", "Ведомость прогонщика корпуса"]
    случай вариант «Каталог»
      то ["test", («Фикстуры»)]
    случай вариант «Свод»
      то ["test", («Фикстуры»), "--json"]
    случай вариант «Маска»
      то ["test", (соединить [«Фикстуры», "/ch*.flang"] по ""), "--json"]
    случай вариант «Строкой»
      то ["test", («Фикстуры»), "--ledger"]
    случай вариант «Носители»
      то ["test", "../flang/self/carriers.flang", "--ledger"]
    случай любое
      то пустой список

тотальная функция «Следующий»
  принимает шаг: «Шаг»
  возвращает «Шаг»
  обеспечивает «за версия» (не (шаг равен (вариант «Версия»))) или (результат равен (вариант «Ведомость»))
  обеспечивает «за ведомость» (не (шаг равен (вариант «Ведомость»))) или (результат равен (вариант «Файл ведомости»))
  обеспечивает «за файл ведомости» (не (шаг равен (вариант «Файл ведомости»))) или (результат равен (вариант «Каталог»))
  обеспечивает «за каталог» (не (шаг равен (вариант «Каталог»))) или (результат равен (вариант «Свод»))
  обеспечивает «за свод» (не (шаг равен (вариант «Свод»))) или (результат равен (вариант «Маска»))
  обеспечивает «за маска» (не (шаг равен (вариант «Маска»))) или (результат равен (вариант «Строкой»))
  обеспечивает «за строкой» (не (шаг равен (вариант «Строкой»))) или (результат равен (вариант «Конец»))
  обеспечивает «за носители» (не (шаг равен (вариант «Носители»))) или (результат равен (вариант «Конец»))
  обеспечивает «за конец» (не (шаг равен (вариант «Конец»))) или (результат равен (вариант «Конец»))
  разбор шаг
    случай вариант «Версия»
      то вариант «Ведомость»
    случай вариант «Ведомость»
      то вариант «Файл ведомости»
    случай вариант «Файл ведомости»
      то вариант «Каталог»
    случай вариант «Каталог»
      то вариант «Свод»
    случай вариант «Свод»
      то вариант «Маска»
    случай вариант «Маска»
      то вариант «Строкой»
    случай вариант «Строкой»
      то вариант «Конец»
    случай вариант «Носители»
      то вариант «Конец»
    случай любое
      то вариант «Конец»

тотальная функция «Итог»
  принимает дело: «Дело»
  возвращает «Продолжение»
  «Сказать» от («Судить» от (дело.«исходы») и (дело.«имена»)) и (длина (дело.«имена»))

тотальная функция «Сказать»
  принимает беды: список строки, утверждений: число
  возвращает «Продолжение»
  пример «Бед нет»
    дано беды равно пустой список
    дано утверждений равно 28
    ожидается вариант «Конец работы» с значение равным "прогонщик корпуса: утверждений ведомости 28, все сошлись; каталог, маска и ведомость строкой судят как обещано"
  разбор беды
    случай пусто
      то вариант «Конец работы» с значение равным (соединить ["прогонщик корпуса: утверждений ведомости ", (к строке утверждений), ", все сошлись; каталог, маска и ведомость строкой судят как обещано"] по "")
    случай голова и хвост
      то вариант «Провал» с код равным "FLANG_KORPUS_RAZOSHYOLSYA" и сообщение равным (соединить (приписать (соединить ["прогонщик корпуса ОТКАЗЫВАЕТ, расхождений ", (к строке (длина беды)), ":"] по "") к беды) по "\n  · ")

тотальная функция «Пойти»
  принимает шаг: «Шаг», дело: «Дело»
  возвращает «Продолжение»
  обеспечивает «конец — итог» (не (шаг равен (вариант «Конец»))) или (результат равен («Итог» от дело))
  обеспечивает «файл ведомости — прочитать» (не (шаг равен (вариант «Файл ведомости»))) или (результат равен (вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным («Файл ведомости»)) и потом равным (вариант «Ждём» с шаг равным шаг и дело равным дело)))
  разбор шаг
    случай вариант «Конец»
      то «Итог» от дело
    случай вариант «Файл ведомости»
      то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным («Файл ведомости»)) и потом равным (вариант «Ждём» с шаг равным шаг и дело равным дело)
    случай любое
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным («Двоичный») и аргументы равным («Доводы шага» от шаг)) и потом равным (вариант «Ждём» с шаг равным шаг и дело равным дело)

тотальная функция «Записать»
  принимает дело: «Дело», имя: строка, код: число, вывод: строка, ошибки: строка
  возвращает «Дело»
  обеспечивает «имена не тронуты» (результат.«имена») равен (дело.«имена»)
  обеспечивает «исходов на один больше» (длина (результат.«исходы»)) равен ((длина (дело.«исходы»)) плюс 1)
  запись «Дело» с «исходы» равным (добавить (запись «Исход» с «имя» равным имя и «код» равным код и «вывод» равным вывод и «ошибки» равным ошибки) к (дело.«исходы»)) и «имена» равным (дело.«имена»)

тотальная функция «После шага»
  принимает шаг: «Шаг», дело: «Дело», отклик: «Отклик»
  возвращает «Продолжение»
  обеспечивает «пока ничего — пойти» (не (отклик равен (вариант «Пока ничего»))) или (результат равен («Пойти» от шаг и дело))
  разбор отклик
    случай вариант «Пока ничего»
      то «Пойти» от шаг и дело
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то «После ответа» от шаг и дело и код и вывод и ошибки
    случай вариант «Прочитано» с содержимое как текст
      то «Пойти» от («Следующий» от шаг) и (запись «Дело» с «исходы» равным (дело.«исходы») и «имена» равным («Имена ведомости» от текст))
    случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
      то вариант «Провал» с код равным "FLANG_KORPUS_NECHEM_SMOTRET" и сообщение равным (соединить ["двоичный убит сигналом ", сигнал, " на шаге «", («Имя шага» от шаг), "» — смотреть нечем"] по "")
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_KORPUS_NECHEM_SMOTRET" и сообщение равным (соединить ["шаг «", («Имя шага» от шаг), "» не состоялся (", код, "): ", сообщение, " — смотреть нечем; собрать: make -C bootstrap"] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным (соединить ["ждали ответ на шаге «", («Имя шага» от шаг), "»"] по "")

тотальная функция «После ответа»
  принимает шаг: «Шаг», дело: «Дело», код: число, вывод: строка, ошибки: строка
  возвращает «Продолжение»
  разбор шаг
    случай вариант «Версия»
      то если не (код равен 0)
        то вариант «Провал» с код равным "FLANG_KORPUS_NECHEM_SMOTRET" и сообщение равным (соединить ["двоичный ../bootstrap/flang ответил на «--version» кодом ", (к строке код), ": ", ошибки, " — смотреть нечем, и это не приговор прогонщику; собрать: make -C bootstrap"] по "")
        иначе «Пойти» от («Следующий» от шаг) и дело
    случай любое
      то «Пойти» от («Следующий» от шаг) и («Записать» от дело и («Имя шага» от шаг) и код и вывод и ошибки)

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём» с шаг как шаг и дело как дело
      то «После шага» от шаг и дело и отклик

план «Прогонщик берёт корпус, а не один файл»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
