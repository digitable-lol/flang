модуль «Правила VS Code»
  использует «Слова языка»

тотальная функция «Опасные знаки шаблона»
  возвращает список строки
  обеспечивает «длина постоянного списка — Опасные знаки шаблона» (длина результат) равен 15
  пример «Пятнадцать знаков, значащих в шаблоне Oniguruma и в строке JSON»
    ожидается ["\\", "\"", "*", ".", "[", "]", "^", "$", "|", "(", ")", "{", "}", "?", "+"]
  ["\\", "\"", "*", ".", "[", "]", "^", "$", "|", "(", ")", "{", "}", "?", "+"]

тотальная функция «Фраза опасна для шаблона»
  принимает фраза: строка
  возвращает признак
  пример «Обычное слово безопасно»
    дано фраза равно "если"
    ожидается нет
  пример «Скобка ломает шаблон VS Code»
    дано фраза равно "а(б"
    ожидается да
  пример «Точка ломает шаблон и здесь»
    дано фраза равно "а.б"
    ожидается да
  свёртка «Опасные знаки шаблона» начиная с нет как акк и знак
    если акк то да иначе (фраза содержит знак)

тотальная функция «Опасные фразы шаблона»
  возвращает список строки
  отфильтровать «Все фразы» где фраза → «Фраза опасна для шаблона» от фраза

тотальная функция «Ветви слов»
  возвращает строка
  обеспечивает «ветви разделены чередованием Oniguruma, а не пробелом» результат содержит "|"
  обеспечивает «слово языка попало в ветви» результат содержит "если"
  соединить «Фразы по убыванию длины» по "|"

тотальная функция «Начало»
  возвращает строка
  обеспечивает «грамматика запрещает правку руками» результат содержит "ЭТОТ ФАЙЛ НАПЕЧАТАН, А НЕ НАПИСАН"
  обеспечивает «грамматика называет, чем перепечатать» результат содержит "flang io scripts/editors/vscode-highlighting.fscript"
  обеспечивает «грамматика называет себя источником flang» результат содержит "source.flang"
  обеспечивает «имя в ёлочках красится своим видом, а не ключевым словом» результат содержит "entity.name.type.flang"
  соединить [
    "{\n",
    "  \"information_for_contributors\": [\n",
    "    \"ЭТОТ ФАЙЛ НАПЕЧАТАН, А НЕ НАПИСАН. Правка руками пропадёт при следующей перепечатке, и заметить пропажу будет некому.\",\n",
    "    \"откуда слова:  «Куски таблицы» в flang/self/lexer.flang — та самая таблица, которой язык читает свои файлы\",\n",
    "    \"чем напечатан: scripts/editors/vscode-highlighting.fscript\",\n",
    "    \"перепечатать:  flang io scripts/editors/vscode-highlighting.fscript\",\n",
    "    \"сверить:       flang io scripts/editors/vscode-highlight-check.fscript\",\n",
    "    \"Понятий ", (к строке «Сколько понятий»), ", фраз ", (к строке «Сколько фраз»), ".\",\n",
    "    \"Красятся все четыре поверхности записи сразу — русская, английская, эсперанто и китайская, — потому что так делает сам лексер: ключевым слово у него становится по плоской таблице, где поверхности лежат вперемешку.\",\n",
    "    \"Видов ровно пять, и каждый отвечает виду токена лексера: ключевое слово, имя в ёлочках, строка, число, комментарий. Шестого нет.\"\n",
    "  ],\n",
    "  \"name\": \"flang\",\n",
    "  \"scopeName\": \"source.flang\",\n",
    "  \"patterns\": [\n",
    "    { \"include\": \"#comment\" },\n",
    "    { \"include\": \"#name\" },\n",
    "    { \"include\": \"#string\" },\n",
    "    { \"include\": \"#number\" },\n",
    "    { \"include\": \"#keyword\" }\n",
    "  ],\n",
    "  \"repository\": {\n",
    "    \"comment\": {\n",
    "      \"patterns\": [\n",
    "        { \"name\": \"comment.line.double-slash.flang\", \"match\": \"//.*$\" },\n",
    "        { \"name\": \"comment.block.flang\", \"begin\": \"/\\\\*\", \"end\": \"\\\\*/\" }\n",
    "      ]\n",
    "    },\n",
    "    \"name\": {\n",
    "      \"name\": \"entity.name.type.flang\",\n",
    "      \"begin\": \"«\",\n",
    "      \"end\": \"»|$\",\n",
    "      \"beginCaptures\": { \"0\": { \"name\": \"punctuation.definition.name.begin.flang\" } },\n",
    "      \"endCaptures\": { \"0\": { \"name\": \"punctuation.definition.name.end.flang\" } }\n",
    "    },\n",
    "    \"string\": {\n",
    "      \"patterns\": [\n",
    "        {\n",
    "          \"name\": \"string.quoted.double.flang\",\n",
    "          \"begin\": \"\\\"\",\n",
    "          \"end\": \"\\\"|$\",\n",
    "          \"patterns\": [ { \"name\": \"constant.character.escape.flang\", \"match\": \"\\\\\\\\.\" } ]\n",
    "        },\n",
    "        {\n",
    "          \"name\": \"string.quoted.single.flang\",\n",
    "          \"begin\": \"'\",\n",
    "          \"end\": \"'|$\",\n",
    "          \"patterns\": [ { \"name\": \"constant.character.escape.flang\", \"match\": \"\\\\\\\\.\" } ]\n",
    "        }\n",
    "      ]\n",
    "    },\n",
    "    \"number\": {\n",
    "      \"name\": \"constant.numeric.flang\",\n",
    "      \"match\": \"(?<![\\\\p{L}\\\\p{N}_])-?\\\\d+(?:\\\\.\\\\d+)?(?:[eE][-+]?\\\\d+)?(?![\\\\p{L}\\\\p{N}_])\"\n",
    "    },\n",
    "    \"keyword\": {\n",
    "      \"name\": \"keyword.control.flang\",\n",
    "      \"match\": \"(?<![\\\\p{L}\\\\p{N}_])(?:"
  ] по ""

тотальная функция «Конец»
  возвращает строка
  обеспечивает «грамматика закрывает объект JSON» результат содержит "}"
  соединить [
    ")(?![\\\\p{L}\\\\p{N}_])\"\n",
    "    }\n",
    "  }\n",
    "}\n"
  ] по ""

тотальная функция «Файл грамматики»
  возвращает строка
  обеспечивает «напечатанная грамматика начинается своим началом» результат начинается с «Начало»
  обеспечивает «в напечатанной грамматике стоит запрет правки руками» результат содержит "ЭТОТ ФАЙЛ НАПЕЧАТАН, А НЕ НАПИСАН"
  обеспечивает «в напечатанной грамматике есть правило ключевых слов» результат содержит "keyword.control.flang"
  обеспечивает «в напечатанной грамматике названы все пять видов» результат содержит "comment.block.flang"
  соединить [«Начало», «Ветви слов», «Конец»] по ""
