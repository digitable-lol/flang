модуль «Печать пакета»

// SPDX-FileCopyrightText: 2026 Digitable (Marat Zimnurov)
// SPDX-License-Identifier: BSD-2-Clause
//
// package.json ПЕЧАТАЕТСЯ ОТСЮДА, а не лежит написанным руками.
//
//   bootstrap/flang io scripts/emit-package.flang
//   bootstrap/flang io scripts/emit-package.flang --plan 'Пакет сходится'
//
// Первый план перезаписывает `package.json`; второй сверяет записанное с
// напечатанным ЗНАК В ЗНАК и отказывает кодом 1, если они разошлись.
//
// npm из дерева убран 3 сентября 2026, и вместе с ним ушли из объявления `bin`,
// `files`, `scripts` и весь `package-lock.json`. Осталось одно: место, где
// живёт ВЕРСИЯ, и три её читателя, ни один из которых к npm отношения не имеет:
// сборка сайта (`docs/site/site-numbers.mjs`), сторож формулы Homebrew
// (`scripts/homebrew-formula-guard.flang`) и работа выпуска `release.yml`.
// Что именно снято и почему каждое — `tasks/8649-npm-leaves-the-tree.md`.
//
// Поле `"private": true` — замок: `npm publish` на таком файле отказывает сам,
// не спрашивая ни токена, ни сети.

// ── объявление пакета: один источник ───────────────────────────────────────

тотальная функция «Имя пакета»
  возвращает строка
  пример «Имя пакета списано из тела знак в знак»
    ожидается "@digitable-lol/flang"
  "@digitable-lol/flang"

// ОДИН ИСТОЧНИК ВЕРСИИ. Правка здесь и только здесь.
тотальная функция «Версия»
  возвращает строка
  пример «Версия списана из тела знак в знак»
    ожидается "0.7.10"
  "0.7.10"

тотальная функция «Описание»
  возвращает строка
  "flang: проверяемый язык с тотальными и обычными функциями, ядром доказательств на нуле аксиом и печатью в C, C++, Go, Rust, Python, Java, C#, Elixir и JavaScript."

тотальная функция «Лицензия»
  возвращает строка
  "BSD-2-Clause"

тотальная функция «Адрес склада»
  возвращает строка
  "git+https://github.com/digitable-lol/flang.git"

тотальная функция «Домашняя страница»
  возвращает строка
  "https://github.com/digitable-lol/flang#readme"

тотальная функция «Адрес бед»
  возвращает строка
  "https://github.com/digitable-lol/flang/issues"

// `engines` не про npm: этим числом объявлена та версия Node, на которой
// работают оставшиеся в дереве `.mjs` — набор проверок, сборка сайта и печать
// журнала. `flang/test/glob.mjs` читает его прозой в своей шапке.
тотальная функция «Узел не старше»
  возвращает строка
  ">=20"

тотальная функция «Слова»
  возвращает список строки
  обеспечивает «слов восемь» (длина результат) равен 8
  ["flang", "programming-language", "totality-checking", "formal-methods", "proof-carrying-data", "category-theory", "russian-language", "ai-agents"]

// ── печать JSON ────────────────────────────────────────────────────────────
//
// Печатается ровно тот вид, в каком `package.json` лежал: два пробела отступа,
// вложенный объект — четыре. Сверка требует совпадения ЗНАК В ЗНАК, поэтому
// вид тут не украшение, а часть договора. На него опирается и выпуск:
// `.github/workflows/release.yml` вычитывает версию строкой
// `sed -n 's/^  "version": "\([^"]*\)",$/\1/p'` — без Node.

тотальная функция «В кавычках»
  принимает текст: строка
  возвращает строка
  пример «Обычная строка»
    дано текст равно "flang"
    ожидается "\"flang\""
  пример «Кавычка внутри экранируется»
    дано текст равно "a\"b"
    ожидается "\"a\\\"b\""
  пример «Обратная косая экранируется»
    дано текст равно "a\\b"
    ожидается "\"a\\\\b\""
  соединить ["\"", (соединить (разделить (соединить (разделить текст по "\\") по "\\\\") по "\"") по "\\\""), "\""] по ""

тотальная функция «Массив»
  принимает отступ: строка, пункты: список строки
  возвращает строка
  пример «Пункты идут через запятую и перевод строки»
    дано отступ равно "  "
    дано пункты равно ["раз", "два"]
    ожидается "  \"раз\",\n  \"два\""
  соединить (отобразить пункты как пункт → (соединить [отступ, («В кавычках» от пункт)] по "")) по ",\n"

тотальная функция «Напечатанный пакет»
  возвращает строка
  соединить [
    "{\n",
    "  \"name\": ", («В кавычках» от («Имя пакета»)), ",\n",
    "  \"private\": true,\n",
    "  \"version\": ", («В кавычках» от («Версия»)), ",\n",
    "  \"description\": ", («В кавычках» от («Описание»)), ",\n",
    "  \"type\": \"module\",\n",
    "  \"license\": ", («В кавычках» от («Лицензия»)), ",\n",
    "  \"repository\": {\n",
    "    \"type\": \"git\",\n",
    "    \"url\": ", («В кавычках» от («Адрес склада»)), "\n",
    "  },\n",
    "  \"homepage\": ", («В кавычках» от («Домашняя страница»)), ",\n",
    "  \"bugs\": {\n",
    "    \"url\": ", («В кавычках» от («Адрес бед»)), "\n",
    "  },\n",
    "  \"engines\": {\n",
    "    \"node\": ", («В кавычках» от («Узел не старше»)), "\n",
    "  },\n",
    "  \"keywords\": [\n", («Массив» от "    " и («Слова»)), "\n",
    "  ]\n",
    "}\n"
  ] по ""

// ── планы ──────────────────────────────────────────────────────────────────
//
// Ходов стало три вместо восьми: описи дерева больше нет, сверять `files` не с
// чем, и замок не печатается. Остались «спросить файл» и «ответить».

тип «Ход»
  вариант «Начало» содержит печатать: признак
  вариант «Ждём запись пакета»
  вариант «Ждём прежний пакет»

тотальная функция «Начать»
  возвращает «Ход»
  обеспечивает «печать начинается с начала» результат равен (вариант «Начало» с печатать равным да)
  пример «Печать начинается с начала»
    ожидается вариант «Начало» с печатать равным да
  вариант «Начало» с печатать равным да

тотальная функция «Начать сверку»
  возвращает «Ход»
  обеспечивает «сверка начинается с начала» результат равен (вариант «Начало» с печатать равным нет)
  пример «Сверка начинается с начала»
    ожидается вариант «Начало» с печатать равным нет
  вариант «Начало» с печатать равным нет

тотальная функция «Путь пакета»
  возвращает строка
  пример «Пакет лежит в корне дерева, а план — в scripts»
    ожидается "../package.json"
  "../package.json"

тотальная функция «Первый шаг»
  принимает печатать: признак
  возвращает «Продолжение»
  // Ветвь печати примером не задать: `содержимое` там — вызов «Напечатанный
  // пакет», а примеры принимают только литералы. Держит её постусловие ниже.
  обеспечивает «печать идёт записью, а не чтением» если печатать то (результат равен (вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным («Путь пакета») и содержимое равным («Напечатанный пакет»)) и потом равным (вариант «Ждём запись пакета»))) иначе да
  пример «Сверка сразу читает файл»
    дано печатать равно нет
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "../package.json") и потом равным (вариант «Ждём прежний пакет»)
  если печатать
    то вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным («Путь пакета») и содержимое равным («Напечатанный пакет»)) и потом равным (вариант «Ждём запись пакета»)
    иначе вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным («Путь пакета»)) и потом равным (вариант «Ждём прежний пакет»)

тотальная функция «Сверить пакет»
  принимает записано: строка
  возвращает «Продолжение»
  если записано равен ""
    то вариант «Провал» с код равным "FLANG_PAKET_NECHEM_SMOTRET" и сообщение равным "package.json пуст — смотреть нечем"
    иначе если записано равен («Напечатанный пакет»)
      то вариант «Конец работы» с значение равным (соединить ["пакет: чисто — package.json сходится с объявлением знак в знак, версия ", («Версия»), ", публикации нет: private true, ни bin, ни files, ни scripts"] по "")
      иначе вариант «Провал» с код равным "FLANG_PAKET_USTAREL" и сообщение равным "package.json разошёлся с объявлением пакета. Объявление правили, пакет не перепечатали. Напечатайте: bootstrap/flang io scripts/emit-package.flang"

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Начало» с печатать как печатать
      то разбор отклик
        случай вариант «Пока ничего»
          то «Первый шаг» от печатать
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "первым откликом ждали «Пока ничего»"
    случай вариант «Ждём запись пакета»
      то разбор отклик
        случай вариант «Записано» с сколько как сколько
          то вариант «Конец работы» с значение равным (соединить ["package.json напечатан: версия ", («Версия»), ", знаков ", (к строке сколько)] по "")
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным "FLANG_PAKET_NE_ZAPISAN" и сообщение равным (соединить ["package.json не записан (", код, "): ", сообщение] по "")
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали отметку о записи package.json"
    случай вариант «Ждём прежний пакет»
      то разбор отклик
        случай вариант «Прочитано» с содержимое как текст
          то «Сверить пакет» от текст
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Провал» с код равным "FLANG_PAKET_NECHEM_SMOTRET" и сообщение равным (соединить ["package.json не прочитан (", код, "): ", сообщение] по "")
        случай любое
          то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали текст package.json"

план «Напечатать пакет»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»

план «Пакет сходится»
  состояние «Ход»
  начинает с «Начать сверку»
  обрабатывает «Дальше»
