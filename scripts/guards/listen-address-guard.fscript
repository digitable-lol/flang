модуль «Listen address guard»

примечание "АДРЕС ПРИВЯЗКИ «Принять соединение» (issue 475)."
примечание "  bootstrap/flang run-script listen-address:check"
примечание "Двоичный (FLANG_BINARY, иначе bootstrap/flang) трижды открывает порт планом «Listen» этого файла:"
примечание "  · без FLANG_LISTEN_ADDRESS порт слушается на 127.0.0.1 и только там;"
примечание "  · с FLANG_LISTEN_ADDRESS=0.0.0.0 — на всех адресах, наружу открывают только так;"
примечание "  · с негодным адресом поручение отказывает и называет переменную, порт не открыт вовсе."
примечание "Что слушается, читает ss -ltnH; слушателя будит соединение этого же плана на 127.0.0.1."
примечание "  bootstrap/flang run-script listen-address:forgery"
примечание "    подлог: первый слушатель пущен на 0.0.0.0, сторож обязан покраснеть."
примечание "Двоичный 0.7.31 и раньше привязывал сокет к INADDR_ANY — на нём первый случай красен."

тип «Ход пробы адреса»
  вариант «Начало» содержит подлог: признак
  вариант «Ждём двоичный» содержит подлог: признак
  вариант «Пущен» содержит подлог: признак, binary: строка, номер: число, беды: список строки
  вариант «Смотрим» содержит подлог: признак, binary: строка, номер: число, беды: список строки
  вариант «Будим» содержит подлог: признак, binary: строка, номер: число, беды: список строки
  вариант «Негодный» содержит подлог: признак, binary: строка, беды: список строки

тотальная функция «Порт»
  возвращает число
  пример «порт пробы назван номером задачи»
    ожидается 18475
  18475

тотальная функция «Двоичный по умолчанию»
  возвращает строка
  пример «путь от каталога сторожей»
    ожидается "../../bootstrap/flang"
  "../../bootstrap/flang"

тотальная функция «Адрес случая»
  принимает подлог: признак, номер: число
  возвращает строка
  пример «первый случай — без переменной»
    дано подлог равно нет
    дано номер равно 0
    ожидается ""
  пример «второй случай — все адреса»
    дано подлог равно нет
    дано номер равно 1
    ожидается "0.0.0.0"
  пример «подлог: первый слушатель открыт наружу, как у двоичного 0.7.31»
    дано подлог равно да
    дано номер равно 0
    ожидается "0.0.0.0"
  если (номер равен 0) и притом (не подлог) то "" иначе "0.0.0.0"

тотальная функция «Ждём слушателя»
  принимает номер: число
  возвращает строка
  пример «без переменной слушают loopback»
    дано номер равно 0
    ожидается "127.0.0.1:18475"
  пример «с 0.0.0.0 слушают все адреса»
    дано номер равно 1
    ожидается "0.0.0.0:18475"
  соединить [(если номер равен 0 то "127.0.0.1" иначе "0.0.0.0"), ":", (к строке («Порт»))] по ""

тотальная функция «Команда пуска»
  возвращает строка
  соединить [
    "while ss -ltnH \"sport = :$2\" | grep -q .; do sleep 0.1; done; ",
    "if [ -n \"$1\" ]; then export FLANG_LISTEN_ADDRESS=\"$1\"; else unset FLANG_LISTEN_ADDRESS; fi; ",
    "\"$0\" io listen-address-guard.fscript --plan Listen --timeout 20000 >/dev/null 2>&1 &"] по ""

тотальная функция «Команда взгляда»
  возвращает строка
  соединить [
    "i=0; while [ $i -lt 50 ]; do o=$(ss -ltnH \"sport = :$0\"); ",
    "if [ -n \"$o\" ]; then echo \"$o\"; exit 0; fi; sleep 0.1; i=$((i+1)); done; exit 1"] по ""

тотальная функция «Команда негодного»
  возвращает строка
  соединить [
    "FLANG_LISTEN_ADDRESS=nowhere timeout 5 \"$0\" io listen-address-guard.fscript --plan Listen 2>&1; ",
    "echo \"rc=$?\"; ss -ltnH \"sport = :$1\""] по ""

тотальная функция «Пустить»
  принимает подлог: признак, binary: строка, номер: число, беды: список строки
  возвращает «Продолжение»
  (вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh"
    и аргументы равным ["-c", («Команда пуска»), binary, («Адрес случая» от подлог и номер), (к строке («Порт»))])
    и потом равным (вариант «Пущен» с подлог равным подлог и binary равным binary и номер равным номер
      и беды равным беды))

тотальная функция «Беда слушателя»
  принимает номер: число, вывод: строка
  возвращает список строки
  пример «слушают где надо — беды нет»
    дано номер равно 0
    дано вывод равно "LISTEN 0 16 127.0.0.1:18475 0.0.0.0:*\n"
    ожидается пустой список
  пример «без переменной слушают все адреса — беда»
    дано номер равно 0
    дано вывод равно "LISTEN 0 16 0.0.0.0:18475 0.0.0.0:*\n"
    ожидается ["без FLANG_LISTEN_ADDRESS ждали 127.0.0.1:18475, а слушают: LISTEN 0 16 0.0.0.0:18475 0.0.0.0:*\n"]
  если вывод содержит («Ждём слушателя» от номер)
    то пустой список
    иначе [(соединить [(если номер равен 0 то "без FLANG_LISTEN_ADDRESS" иначе "с FLANG_LISTEN_ADDRESS=0.0.0.0"),
      " ждали ", («Ждём слушателя» от номер), ", а слушают: ", вывод] по "")]

тотальная функция «Беда негодного»
  принимает вывод: строка
  возвращает список строки
  пример «отказ назвал переменную, порт не открыт»
    дано вывод равно "FLANG_IO_NET: адрес привязки «nowhere» из FLANG_LISTEN_ADDRESS не годится\nrc=1\n"
    ожидается пустой список
  пример «негодный адрес молча принят — беда»
    дано вывод равно "rc=0\nLISTEN 0 16 0.0.0.0:18475 0.0.0.0:*\n"
    ожидается ["негодный FLANG_LISTEN_ADDRESS не отказан: rc=0\nLISTEN 0 16 0.0.0.0:18475 0.0.0.0:*\n"]
  пусть назван равно вывод содержит "FLANG_LISTEN_ADDRESS"
  пусть открыт равно (вывод содержит "rc=0") или (вывод содержит "LISTEN ")
  если назван и притом (не открыт)
    то пустой список
    иначе [(соединить ["негодный FLANG_LISTEN_ADDRESS не отказан: ", вывод] по "")]

тотальная функция «Итог»
  принимает беды: список строки
  возвращает «Продолжение»
  пример «без бед — конец работы»
    дано беды равно пустой список
    ожидается вариант «Конец работы» с значение равным "адрес привязки: 3 случая из 3"
  если пусто беды
    то вариант «Конец работы» с значение равным "адрес привязки: 3 случая из 3"
    иначе вариант «Провал» с код равным "FLANG_LISTEN_ADDRESS_PROBE" и сообщение равным (соединить
      (приписать "адрес привязки «Принять соединение»:" к беды) по "\n  · ")

тотальная функция «Итог подлога»
  принимает беды: список строки
  возвращает «Продолжение»
  пример «подлог пойман — конец работы»
    дано беды равно ["б"]
    ожидается вариант «Конец работы» с значение равным "подлог адреса привязки пойман: бед 1"
  если пусто беды
    то вариант «Провал» с код равным "FLANG_LISTEN_ADDRESS_PROBE" и сообщение равным (соединить [
      "подлог: первый слушатель открыт на 0.0.0.0,", " а сторож промолчал — проверять им нечего"] по "")
    иначе вариант «Конец работы» с значение равным (соединить ["подлог адреса привязки пойман: бед ",
      (к строке (длина беды))] по "")

тотальная функция «Next»
  принимает ход: «Ход пробы адреса», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Начало» с подлог как подлог
      то (вариант «Сделать» с поручение равным (вариант «Прочитать переменную среды» с имя равным "FLANG_BINARY")
        и потом равным (вариант «Ждём двоичный» с подлог равным подлог))
    случай вариант «Ждём двоичный» с подлог как подлог
      то «После двоичного» от подлог и отклик
    случай вариант «Пущен» с подлог как подлог и binary как binary и номер как номер и беды как беды
      то (вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh"
        и аргументы равным ["-c", («Команда взгляда»), (к строке («Порт»))])
        и потом равным (вариант «Смотрим» с подлог равным подлог и binary равным binary и номер равным номер
          и беды равным беды))
    случай вариант «Смотрим» с подлог как подлог и binary как binary и номер как номер и беды как беды
      то «После взгляда» от подлог и binary и номер и беды и отклик
    случай вариант «Будим» с подлог как подлог и binary как binary и номер как номер и беды как беды
      то «После побудки» от подлог и binary и номер и беды и отклик
    случай вариант «Негодный» с подлог как подлог и binary как binary и беды как беды
      то «После негодного» от подлог и беды и отклик

тотальная функция «После двоичного»
  принимает подлог: признак, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Значение среды» с значение как binary
      то «Пустить» от подлог и (если binary равен "" то («Двоичный по умолчанию») иначе binary) и 0 и пустой список
    случай любое
      то «Пустить» от подлог и («Двоичный по умолчанию») и 0 и пустой список

тотальная функция «Вывод процесса»
  принимает отклик: «Отклик»
  возвращает строка
  пример «не процесс — вывода нет»
    дано отклик равно вариант «Пока ничего»
    ожидается ""
  разбор отклик
    случай вариант «Процесс завершён» с вывод как вывод
      то вывод
    случай любое
      то ""

тотальная функция «Процесс ли»
  принимает отклик: «Отклик»
  возвращает признак
  пример «пока ничего — не процесс»
    дано отклик равно вариант «Пока ничего»
    ожидается нет
  разбор отклик
    случай вариант «Процесс завершён» с код как код
      то да
    случай любое
      то нет

тотальная функция «Беды побудки»
  принимает номер: число, отклик: «Отклик»
  возвращает список строки
  пример «соединение не открылось — беда»
    дано номер равно 0
    дано отклик равно вариант «Пока ничего»
    ожидается ["случай 0: на 127.0.0.1 соединение не открылось"]
  разбор отклик
    случай вариант «Соединение открыто» с соединение как связь
      то пустой список
    случай любое
      то [(соединить ["случай ", (к строке номер), ": на 127.0.0.1 соединение не открылось"] по "")]

тотальная функция «После взгляда»
  принимает подлог: признак, binary: строка, номер: число, беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  пусть вывод равно («Вывод процесса» от отклик)
  пусть ещё равно (если вывод равен "" то [(соединить ["случай ", (к строке номер),
    ": слушатель не поднялся за 5 секунд"] по "")] иначе («Беда слушателя» от номер и вывод))
  (вариант «Сделать» с поручение равным (вариант «Открыть соединение» с адрес равным "127.0.0.1"
    и порт равным («Порт»))
    и потом равным (вариант «Будим» с подлог равным подлог и binary равным binary и номер равным номер
      и беды равным (свёртка ещё начиная с беды как акк и б → добавить б к акк)))

тотальная функция «После побудки»
  принимает подлог: признак, binary: строка, номер: число, беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  пусть ещё равно («Беды побудки» от номер и отклик)
  пусть все равно (свёртка ещё начиная с беды как акк и б → добавить б к акк)
  если номер равен 0
    то «Пустить» от подлог и binary и 1 и все
    иначе (вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh"
      и аргументы равным ["-c", («Команда негодного»), binary, (к строке («Порт»))])
      и потом равным (вариант «Негодный» с подлог равным подлог и binary равным binary и беды равным все))

тотальная функция «После негодного»
  принимает подлог: признак, беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  пусть ещё равно (если «Процесс ли» от отклик то «Беда негодного» от («Вывод процесса» от отклик)
    иначе ["негодный адрес: процесс не завершился"])
  пусть все равно (свёртка ещё начиная с беды как акк и б → добавить б к акк)
  если подлог то «Итог подлога» от все иначе «Итог» от все

тотальная функция «Start»
  возвращает «Ход пробы адреса»
  пример «проба начинается с поиска двоичного»
    ожидается вариант «Начало» с подлог равным нет
  вариант «Начало» с подлог равным нет

тотальная функция «Start forgery»
  возвращает «Ход пробы адреса»
  пример «подлог начинается так же, с флагом»
    ожидается вариант «Начало» с подлог равным да
  вариант «Начало» с подлог равным да

тип «Шаг слушателя»
  вариант «Слушаем»
  вариант «Приняли»

тотальная функция «Listen start»
  возвращает «Шаг слушателя»
  пример «слушатель начинает с поручения»
    ожидается вариант «Слушаем»
  вариант «Слушаем»

тотальная функция «Listen next»
  принимает шаг: «Шаг слушателя», отклик: «Отклик»
  возвращает «Продолжение»
  разбор шаг
    случай «Слушаем»
      то (вариант «Сделать» с поручение равным (вариант «Принять соединение» с порт равным («Порт»))
        и потом равным (вариант «Приняли»))
    случай «Приняли»
      то «После приёма» от отклик

тотальная функция «После приёма»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Конец работы» с значение равным "принято"

план «Check»
  состояние «Ход пробы адреса»
  начинает с «Start»
  обрабатывает «Next»

план «Forgery»
  состояние «Ход пробы адреса»
  начинает с «Start forgery»
  обрабатывает «Next»

план «Listen»
  состояние «Шаг слушателя»
  начинает с «Listen start»
  обрабатывает «Listen next»
