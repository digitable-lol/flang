модуль «No comments guard»

// SPDX-FileCopyrightText: 2026 Digitable (Marat Zimnurov)
// SPDX-License-Identifier: BSD-2-Clause
//
// Комментариев в .flang не прибавляется — храповик по файлу долга
// scripts/ledgers/no-comments-debt.tsv (файл<TAB>число[<TAB>причина]); число
// поднимают только рукой и только с причиной, «Снять» умеет лишь уменьшать.
//
//   bootstrap/flang io scripts/guards/no-comments-guard.fscript --plan Проверка   не прибавилось ли
//   bootstrap/flang io scripts/guards/no-comments-guard.fscript --plan Снять      переписать долг ПОСЛЕ чистки
//   bootstrap/flang io scripts/guards/no-comments-guard.fscript --plan Подлог     сторож краснеет на подлоге долга
//
// Коды: 0 — не прибавилось (или долг переписан вниз); 1 — прибавилось, файлы
// названы с числами; 3 — не проверено: файла долга нет либо .flang в дереве не найдено.
// Почему храповик, а не запрет, и где его граница — docs/guide/how-to-write-flang.ru.md.

объект «Счёт»
  «путь»: строка
  «строк»: число
  «причина»: строка

тип «Режим»
  вариант «Проверить»
  вариант «Снять долг»
  вариант «Подложить»

тип «Ход»
  вариант «Начали» содержит режим: «Режим»
  вариант «Ждём счёт» содержит режим: «Режим»
  вариант «Ждём долг» содержит режим: «Режим», нынче: список «Счёт»
  вариант «Ждём запись» содержит было: число, стало: число, файлов: число, впервые: признак

тотальная функция «Файл долга»
  возвращает строка
  пример «Путь долга считается от каталога сторожа»
    ожидается "../../scripts/ledgers/no-comments-debt.tsv"
  "../../scripts/ledgers/no-comments-debt.tsv"

тотальная функция «Команда счёта»
  возвращает список строки
  обеспечивает «счёт идёт по отслеживаемым файлам, а не по каталогу» (элемент 2 в результат) содержит "git -c core.quotepath=false ls-files"
  обеспечивает «считаются строки, начинающиеся с //» (элемент 2 в результат) содержит "'^[[:space:]]*//'"
  пример «Одна команда оболочки: список файлов от git, счёт от grep»
    ожидается ["-c", "cd ../.. && git -c core.quotepath=false ls-files -z '*.flang' '*.fscript' | LC_ALL=C.UTF-8 xargs -0 -r /usr/bin/grep -aHc '^[[:space:]]*//'"]
  ["-c", "cd ../.. && git -c core.quotepath=false ls-files -z '*.flang' '*.fscript' | LC_ALL=C.UTF-8 xargs -0 -r /usr/bin/grep -aHc '^[[:space:]]*//'"]

тотальная функция «Число из»
  принимает кусок: строка
  возвращает число
  пример «Число»
    дано кусок равно "29"
    ожидается 29
  пример «Не число — ноль»
    дано кусок равно "строка"
    ожидается 0
  пример «Пусто — ноль»
    дано кусок равно ""
    ожидается 0
  разбор (к числу или беда кусок)
    случай вариант «Разобрано» с значение как н
      то н
    случай вариант «Не разобрано» с код как код и сообщение как весть
      то 0

тотальная функция «Строки»
  принимает текст: строка
  возвращает список строки
  обеспечивает «отбор непустых строк список не удлиняет» (длина результат) не больше (длина (разделить текст по "\n"))
  пример «Пустые строки не считаются»
    дано текст равно "раз\n\nдва\n"
    ожидается ["раз", "два"]
  отфильтровать (разделить текст по "\n") где строчка → не (строчка равен "")

тотальная функция «Пустой счёт»
  возвращает «Счёт»
  пример «Пустой счёт — без пути и без строк»
    ожидается запись «Счёт» с «путь» равным "" и «строк» равным 0 и «причина» равным ""
  запись «Счёт» с «путь» равным "" и «строк» равным 0 и «причина» равным ""

тотальная функция «Счёт из строки grep»
  принимает линия: строка
  возвращает «Счёт»
  обеспечивает «путь короче строки» (длина (результат.«путь»)) меньше (длина линия) или ((результат.«путь») равен "")
  пример «Путь и число»
    дано линия равно "flang/stdlib/lists.flang:12"
    ожидается запись «Счёт» с «путь» равным "flang/stdlib/lists.flang" и «строк» равным 12 и «причина» равным ""
  пример «Двоеточие в пути не путает: число стоит после последнего»
    дано линия равно "docs/a:b.flang:3"
    ожидается запись «Счёт» с «путь» равным "docs/a:b.flang" и «строк» равным 3 и «причина» равным ""
  пример «Строка без двоеточия — пустой счёт»
    дано линия равно "мусор"
    ожидается запись «Счёт» с «путь» равным "" и «строк» равным 0 и «причина» равным ""
  пример «Двоеточие первым знаком — пустой счёт»
    дано линия равно ":5"
    ожидается запись «Счёт» с «путь» равным "" и «строк» равным 0 и «причина» равным ""
  пусть куски равно (разделить линия по ":")
  если (длина куски) меньше 2
    то «Пустой счёт»
    иначе если ((длина линия) минус ((длина (элемент (длина куски) в куски)) плюс 1)) меньше 1
      то «Пустой счёт»
      иначе запись «Счёт» с «путь» равным (подстрока линия с 1 по ((длина линия) минус ((длина (элемент (длина куски) в куски)) плюс 1))) и «строк» равным («Число из» от (элемент (длина куски) в куски)) и «причина» равным ""

тотальная функция «Счёты из вывода»
  принимает вывод: строка
  возвращает список «Счёт»
  обеспечивает «счётов не больше, чем строк вывода» (длина результат) не больше (длина («Строки» от вывод))
  пример «Каждая строка вывода — счёт по файлу, нули остаются»
    дано вывод равно "a.flang:2\nb.flang:0\n"
    ожидается [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 2 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 0 и «причина» равным ""]
  пример «Строка не по образцу выбрасывается»
    дано вывод равно "мусор\na.flang:1\n"
    ожидается [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 1 и «причина» равным ""]
  отфильтровать (отобразить («Строки» от вывод) как линия → («Счёт из строки grep» от линия)) где счёт → не ((счёт.«путь») равен "")

тотальная функция «С комментариями»
  принимает счёты: список «Счёт»
  возвращает список «Счёт»
  обеспечивает «отбор список не удлиняет» (длина результат) не больше (длина счёты)
  пример «Файлы без единой строки // в долг не попадают»
    дано счёты равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 2 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 0 и «причина» равным ""]
    ожидается [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 2 и «причина» равным ""]
  отфильтровать счёты где счёт → (счёт.«строк») больше 0

тотальная функция «Строка долга»
  принимает линия: строка
  возвращает «Счёт»
  пример «Две колонки»
    дано линия равно "a.flang\t5"
    ожидается запись «Счёт» с «путь» равным "a.flang" и «строк» равным 5 и «причина» равным ""
  пример «Три колонки — причина сохраняется»
    дано линия равно "a.flang\t5\tпод flang/proof — правка после перепечатки"
    ожидается запись «Счёт» с «путь» равным "a.flang" и «строк» равным 5 и «причина» равным "под flang/proof — правка после перепечатки"
  пример «Одна колонка — пустой счёт»
    дано линия равно "мусор"
    ожидается запись «Счёт» с «путь» равным "" и «строк» равным 0 и «причина» равным ""
  пусть куски равно (разделить линия по "\t")
  если (длина куски) меньше 2
    то «Пустой счёт»
    иначе запись «Счёт» с «путь» равным (элемент 1 в куски) и «строк» равным («Число из» от (элемент 2 в куски)) и «причина» равным (если (длина куски) не меньше 3 то (элемент 3 в куски) иначе "")

тотальная функция «Долг из текста»
  принимает текст: строка
  возвращает список «Счёт»
  обеспечивает «записей не больше, чем строк» (длина результат) не больше (длина («Строки» от текст))
  пример «Каждая строка ведомости — запись, мусор выброшен»
    дано текст равно "a.flang\t5\nмусор\nb.flang\t1\tпричина\n"
    ожидается [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 5 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 1 и «причина» равным "причина"]
  отфильтровать (отобразить («Строки» от текст) как линия → («Строка долга» от линия)) где з → не ((з.«путь») равен "")

тотальная функция «Текст долга»
  принимает долг: список «Счёт»
  возвращает строка
  пример «Каждая запись — строка ведомости»
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 5 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 1 и «причина» равным "почему"]
    ожидается "a.flang\t5\nb.flang\t1\tпочему\n"
  соединить (отобразить долг как з → («Строка нового долга» от з и (з.«причина»))) по ""

тотальная функция «Шапка долга»
  принимает текст: строка
  возвращает строка
  обеспечивает «шапка не длиннее исходного текста» (длина результат) не больше (длина текст)
  пример «Строки с решёткой переживают переписку долга»
    дано текст равно "# ЧТО: долг\n# ЗАЧЕМ: счёт\na.flang\t5\n"
    ожидается "# ЧТО: долг\n# ЗАЧЕМ: счёт\n"
  пример «Шапки нет — пустая строка»
    дано текст равно "a.flang\t5\n"
    ожидается ""
  соединить (отобразить (отфильтровать («Строки» от текст) где линия → ((подстрока линия с 1 по 1) равен "#")) как линия → (соединить [линия, "\n"] по "")) по ""

тотальная функция «Строка о»
  принимает путь: строка, текст: строка
  возвращает строка
  пример «Строка находится по пути — от начала строки до табуляции»
    дано путь равно "b.flang"
    дано текст равно "a.flang\t5\nb.flang\t1\tпочему\nc.flang\t2\n"
    ожидается "1\tпочему"
  пример «Первая строка ведомости тоже находится»
    дано путь равно "a.flang"
    дано текст равно "a.flang\t5\nb.flang\t1\n"
    ожидается "5"
  пример «Путь, которого в ведомости нет, — пусто»
    дано путь равно "c.flang"
    дано текст равно "a.flang\t5\nb.flang\t1\n"
    ожидается ""
  пример «Путь, кончающийся так же, как чужой, не путается: ищется от начала строки»
    дано путь равно "b.flang"
    дано текст равно "ab.flang\t5\n"
    ожидается ""
  пусть куски равно (разделить (соединить ["\n", текст] по "") по (соединить ["\n", путь, "\t"] по ""))
  если (длина куски) меньше 2
    то ""
    иначе элемент 1 в (разделить (элемент 2 в куски) по "\n")

тотальная функция «Было по»
  принимает путь: строка, текст: строка
  возвращает число
  пример «Число из найденной строки»
    дано путь равно "b.flang"
    дано текст равно "a.flang\t5\nb.flang\t1\tпочему\n"
    ожидается 1
  пример «Пути нет — ноль»
    дано путь равно "c.flang"
    дано текст равно "a.flang\t5\n"
    ожидается 0
  «Число из» от (элемент 1 в (разделить («Строка о» от путь и текст) по "\t"))

тотальная функция «Причина по»
  принимает путь: строка, текст: строка
  возвращает строка
  пример «Причина — третья колонка»
    дано путь равно "b.flang"
    дано текст равно "a.flang\t5\nb.flang\t1\tпочему\n"
    ожидается "почему"
  пример «Без третьей колонки — пусто»
    дано путь равно "a.flang"
    дано текст равно "a.flang\t5\nb.flang\t1\tпочему\n"
    ожидается ""
  пусть куски равно (разделить («Строка о» от путь и текст) по "\t")
  если (длина куски) меньше 2 то "" иначе (элемент 2 в куски)

тотальная функция «Сумма»
  принимает счёты: список «Счёт»
  возвращает число
  пример «Сумма строк по всем файлам»
    дано счёты равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 5 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 1 и «причина» равным ""]
    ожидается 6
  пример «Пустой список — ноль»
    дано счёты равно пустой список
    ожидается 0
  свёртка счёты начиная с 0 как акк и счёт → акк плюс (счёт.«строк»)

тотальная функция «Строка роста»
  принимает счёт: «Счёт», было: число
  возвращает строка
  обеспечивает «строка называет путь» результат содержит (счёт.«путь»)
  пример «Было, стало и разница»
    дано счёт равно запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""
    дано было равно 2
    ожидается "  a.flang: было 2, стало 3 (+1)"
  соединить ["  ", (счёт.«путь»), ": было ", (к строке было), ", стало ", (к строке (счёт.«строк»)), " (+", (к строке ((счёт.«строк») минус было)), ")"] по ""

тотальная функция «Рост»
  принимает нынче: список «Счёт», текст: строка
  возвращает список строки
  обеспечивает «строк роста не больше, чем файлов нынче» (длина результат) не больше (длина нынче)
  пример «Файл, где стало больше, назван с числами; где не больше — нет»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 1 и «причина» равным ""]
    дано текст равно "a.flang\t2\nb.flang\t1\n"
    ожидается ["  a.flang: было 2, стало 3 (+1)"]
  пример «Файла в долге нет — рост с нуля»
    дано нынче равно [запись «Счёт» с «путь» равным "c.flang" и «строк» равным 4 и «причина» равным ""]
    дано текст равно "a.flang\t2\n"
    ожидается ["  c.flang: было 0, стало 4 (+4)"]
  пример «Сумма упала, а в одном файле выросло — рост всё равно виден»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 1 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 2 и «причина» равным ""]
    дано текст равно "a.flang\t9\nb.flang\t1\n"
    ожидается ["  b.flang: было 1, стало 2 (+1)"]
  отобразить (отфильтровать нынче где счёт → (счёт.«строк») больше («Было по» от (счёт.«путь») и текст)) как счёт → («Строка роста» от счёт и («Было по» от (счёт.«путь») и текст))

тотальная функция «Правило»
  возвращает строка
  пример «Правило списано знак в знак»
    ожидается "В .flang комментариев не пишут: объясняйте именем, типом, «обеспечивает» и «примером».\nЗамеры, даты и «почему так решили» — в docs/ и docs/tasks/. Правило: .claude/skills/flang-code."
  "В .flang комментариев не пишут: объясняйте именем, типом, «обеспечивает» и «примером».\nЗамеры, даты и «почему так решили» — в docs/ и docs/tasks/. Правило: .claude/skills/flang-code."

тотальная функция «Вердикт проверки»
  принимает нынче: список «Счёт», долг: список «Счёт»
  возвращает «Продолжение»
  пример «Не прибавилось — конец работы с числами»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 1 и «причина» равным ""]
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 1 и «причина» равным ""]
    ожидается вариант «Конец работы» с значение равным "комментариев не прибавилось: строк 4 в 2 файлах (долг был 4)"
  пример «Убыло — конец работы с подсказкой снять долг»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 2 и «причина» равным ""]
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    ожидается вариант «Конец работы» с значение равным "комментариев не прибавилось: строк 2 в 1 файлах (долг был 3)\n  убрано с прошлого снятия: 1 — снимите долг: --plan Снять"
  пример «Прибавилось — провал, файлы названы с числами»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 2 и «причина» равным ""]
    ожидается вариант «Провал» с код равным "FLANG_KOMMENTARIEV_PRIBAVILOS" и сообщение равным "КОММЕНТАРИЕВ ПРИБАВИЛОСЬ — в 1 файлах:\n  a.flang: было 2, стало 3 (+1)\n\nВ .flang комментариев не пишут: объясняйте именем, типом, «обеспечивает» и «примером».\nЗамеры, даты и «почему так решили» — в docs/ и docs/tasks/. Правило: .claude/skills/flang-code."
  пусть рост равно («Рост» от нынче и («Текст долга» от долг))
  пусть сейчас равно («Сумма» от нынче)
  пусть было равно («Сумма» от долг)
  если (длина рост) больше 0
    то вариант «Провал» с код равным "FLANG_KOMMENTARIEV_PRIBAVILOS" и сообщение равным (соединить ["КОММЕНТАРИЕВ ПРИБАВИЛОСЬ — в ", (к строке (длина рост)), " файлах:\n", (соединить рост по "\n"), "\n\n", («Правило»)] по "")
    иначе вариант «Конец работы» с значение равным (соединить ["комментариев не прибавилось: строк ", (к строке сейчас), " в ", (к строке (длина нынче)), " файлах (долг был ", (к строке было), ")", (если сейчас меньше было то (соединить ["\n  убрано с прошлого снятия: ", (к строке (было минус сейчас)), " — снимите долг: --plan Снять"] по "") иначе "")] по "")

тотальная функция «Строка нового долга»
  принимает счёт: «Счёт», причина: строка
  возвращает строка
  обеспечивает «строка кончается переводом» результат содержит "\n"
  пример «Без причины — две колонки»
    дано счёт равно запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""
    дано причина равно ""
    ожидается "a.flang\t3\n"
  пример «С причиной — три колонки»
    дано счёт равно запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""
    дано причина равно "под flang/proof"
    ожидается "a.flang\t3\tпод flang/proof\n"
  соединить [(счёт.«путь»), "\t", (к строке (счёт.«строк»)), (если причина равен "" то "" иначе (соединить ["\t", причина] по "")), "\n"] по ""

тотальная функция «Текст нового долга»
  принимает нынче: список «Счёт», долг: список «Счёт»
  возвращает строка
  пример «Число берётся нынешнее, причина — из прежнего долга»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 1 и «причина» равным ""]
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 5 и «причина» равным "под flang/proof"]
    ожидается "a.flang\t3\tпод flang/proof\nb.flang\t1\n"
  пусть текст равно («Текст долга» от долг)
  соединить (отобразить нынче как счёт → («Строка нового долга» от счёт и («Причина по» от (счёт.«путь») и текст))) по ""

тотальная функция «Снятие»
  принимает нынче: список «Счёт», долг: список «Счёт», шапка: строка
  возвращает «Продолжение»
  пример «Прибавка есть — снять нельзя»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 2 и «причина» равным ""]
    дано шапка равно ""
    ожидается вариант «Провал» с код равным "FLANG_KOMMENTARIEV_SNYAT_NELZYA" и сообщение равным "СНЯТЬ НЕЛЬЗЯ: комментариев прибавилось в 1 файлах — храповик крутится только вниз.\n  a.flang: было 2, стало 3 (+1)\nСначала уберите прибавку, потом снимайте долг."
  пример «Прибавки нет — долг переписывается нынешними числами»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 2 и «причина» равным ""]
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    дано шапка равно ""
    ожидается вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным "../../scripts/ledgers/no-comments-debt.tsv" и содержимое равным "a.flang\t2\n") и потом равным (вариант «Ждём запись» с было равным 3 и стало равным 2 и файлов равным 1 и впервые равным нет)
  пусть рост равно («Рост» от нынче и («Текст долга» от долг))
  если (длина рост) больше 0
    то вариант «Провал» с код равным "FLANG_KOMMENTARIEV_SNYAT_NELZYA" и сообщение равным (соединить ["СНЯТЬ НЕЛЬЗЯ: комментариев прибавилось в ", (к строке (длина рост)), " файлах — храповик крутится только вниз.\n", (соединить рост по "\n"), "\nСначала уберите прибавку, потом снимайте долг."] по "")
    иначе вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным («Файл долга») и содержимое равным (соединить [шапка, («Текст нового долга» от нынче и долг)] по "")) и потом равным (вариант «Ждём запись» с было равным («Сумма» от долг) и стало равным («Сумма» от нынче) и файлов равным (длина нынче) и впервые равным нет)

тотальная функция «Подложный долг»
  принимает нынче: список «Счёт», долг: список «Счёт»
  возвращает список «Счёт»
  пример «Первому файлу долг занижен на единицу — дерево выглядит выросшим»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным "", запись «Счёт» с «путь» равным "b.flang" и «строк» равным 1 и «причина» равным ""]
    ожидается [запись «Счёт» с «путь» равным "b.flang" и «строк» равным 1 и «причина» равным "", запись «Счёт» с «путь» равным "a.flang" и «строк» равным 2 и «причина» равным "подлог"]
  пример «Считать нечего — долг как есть»
    дано нынче равно пустой список
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    ожидается [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
  разбор нынче
    случай пусто
      то долг
    случай голова и хвост
      то добавить (запись «Счёт» с «путь» равным (голова.«путь») и «строк» равным ((голова.«строк») минус 1) и «причина» равным "подлог") к (отфильтровать долг где з → не ((з.«путь») равен (голова.«путь»)))

тотальная функция «Вердикт подлога»
  принимает нынче: список «Счёт», долг: список «Счёт»
  возвращает «Продолжение»
  пример «Сторож красен на подложенном долге и называет файл — подлог пойман»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    ожидается вариант «Конец работы» с значение равным "подлог пойман: долг по a.flang подложен на 1 вниз (было 2, стало 3) — сторож красен (код 1) и назвал файл"
  разбор нынче
    случай пусто
      то вариант «Не проверено» с код равным "FLANG_KOMMENTARII_NECHEM_SCHITAT" и сообщение равным "подложить нечего: ни одного .flang со строкой // не найдено"
    случай голова и хвост
      то разбор («Вердикт проверки» от нынче и («Подложный долг» от нынче и долг))
        случай вариант «Провал» с код как код и сообщение как сообщение
          то если сообщение содержит (голова.«путь»)
            то вариант «Конец работы» с значение равным (соединить ["подлог пойман: долг по ", (голова.«путь»), " подложен на 1 вниз (было ", (к строке ((голова.«строк») минус 1)), ", стало ", (к строке (голова.«строк»)), ") — сторож красен (код 1) и назвал файл"] по "")
            иначе вариант «Провал» с код равным "FLANG_KOMMENTARII_PODLOG" и сообщение равным (соединить ["ПОДЛОГ НЕ ПОЙМАН: сторож красен, но подложенный файл ", (голова.«путь»), " не назвал:\n", сообщение] по "")
        случай любое
          то вариант «Провал» с код равным "FLANG_KOMMENTARII_PODLOG" и сообщение равным (соединить ["ПОДЛОГ НЕ ПОЙМАН — сторож промолчал на долге, подложенном на 1 вниз для ", (голова.«путь»), ": проверять им нечего"] по "")

тотальная функция «Без долга»
  принимает режим: «Режим», нынче: список «Счёт», код: строка, сообщение: строка
  возвращает «Продолжение»
  пример «Проверка без файла долга — не проверено, и сказано, как снять впервые»
    дано режим равно вариант «Проверить»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    дано код равно "FLANG_IO_NOT_FOUND"
    дано сообщение равно "нет файла"
    ожидается вариант «Не проверено» с код равным "FLANG_KOMMENTARII_NET_DOLGA" и сообщение равным "НЕ ПРОВЕРЕНО: файла долга нет — scripts/ledgers/no-comments-debt.tsv (FLANG_IO_NOT_FOUND: нет файла)\nСнять впервые: bootstrap/flang io scripts/guards/no-comments-guard.fscript --plan Снять"
  пример «Снятие без файла долга — долг снимается впервые»
    дано режим равно вариант «Снять долг»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    дано код равно "FLANG_IO_NOT_FOUND"
    дано сообщение равно "нет файла"
    ожидается вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным "../../scripts/ledgers/no-comments-debt.tsv" и содержимое равным "a.flang\t3\n") и потом равным (вариант «Ждём запись» с было равным 0 и стало равным 3 и файлов равным 1 и впервые равным да)
  разбор режим
    случай вариант «Снять долг»
      то вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным («Файл долга») и содержимое равным («Текст нового долга» от нынче и (пустой список))) и потом равным (вариант «Ждём запись» с было равным 0 и стало равным («Сумма» от нынче) и файлов равным (длина нынче) и впервые равным да)
    случай любое
      то вариант «Не проверено» с код равным "FLANG_KOMMENTARII_NET_DOLGA" и сообщение равным (соединить ["НЕ ПРОВЕРЕНО: файла долга нет — scripts/ledgers/no-comments-debt.tsv (", код, ": ", сообщение, ")\nСнять впервые: bootstrap/flang io scripts/guards/no-comments-guard.fscript --plan Снять"] по "")

тотальная функция «После долга»
  принимает режим: «Режим», нынче: список «Счёт», долг: список «Счёт», шапка: строка
  возвращает «Продолжение»
  пример «Режим проверки судит»
    дано режим равно вариант «Проверить»
    дано нынче равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    дано долг равно [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""]
    дано шапка равно ""
    ожидается вариант «Конец работы» с значение равным "комментариев не прибавилось: строк 3 в 1 файлах (долг был 3)"
  разбор режим
    случай вариант «Проверить»
      то «Вердикт проверки» от нынче и долг
    случай вариант «Снять долг»
      то «Снятие» от нынче и долг и шапка
    случай вариант «Подложить»
      то «Вердикт подлога» от нынче и долг

тотальная функция «После записи»
  принимает было: число, стало: число, файлов: число, впервые: признак
  возвращает «Продолжение»
  пример «Впервые»
    дано было равно 0
    дано стало равно 3
    дано файлов равно 1
    дано впервые равно да
    ожидается вариант «Конец работы» с значение равным "долг снят впервые: строк 3 в 1 файлах"
  пример «Вниз»
    дано было равно 5
    дано стало равно 3
    дано файлов равно 1
    дано впервые равно нет
    ожидается вариант «Конец работы» с значение равным "долг переписан вниз: было 5, стало 3 (убрано 2)"
  если впервые
    то вариант «Конец работы» с значение равным (соединить ["долг снят впервые: строк ", (к строке стало), " в ", (к строке файлов), " файлах"] по "")
    иначе вариант «Конец работы» с значение равным (соединить ["долг переписан вниз: было ", (к строке было), ", стало ", (к строке стало), " (убрано ", (к строке (было минус стало)), ")"] по "")

тотальная функция «После счёта»
  принимает режим: «Режим», код: число, вывод: строка, ошибки: строка
  возвращает «Продолжение»
  пример «Счёт есть — читается долг»
    дано режим равно вариант «Проверить»
    дано код равно 0
    дано вывод равно "a.flang:3\nb.flang:0\n"
    дано ошибки равно ""
    ожидается вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "../../scripts/ledgers/no-comments-debt.tsv") и потом равным (вариант «Ждём долг» с режим равным (вариант «Проверить») и нынче равным [запись «Счёт» с «путь» равным "a.flang" и «строк» равным 3 и «причина» равным ""])
  пример «Ни одного файла — не проверено, и это названо»
    дано режим равно вариант «Проверить»
    дано код равно 0
    дано вывод равно ""
    дано ошибки равно ""
    ожидается вариант «Не проверено» с код равным "FLANG_KOMMENTARII_NECHEM_SCHITAT" и сообщение равным "НЕ ПРОВЕРЕНО: отслеживаемых .flang не нашлось — считать нечего.\nЭто НЕ «комментариев нет»: пустой список и порядок неотличимы, если молчать. (код 0, ошибки: )"
  пусть все равно («Счёты из вывода» от вывод)
  если (длина все) равен 0
    то вариант «Не проверено» с код равным "FLANG_KOMMENTARII_NECHEM_SCHITAT" и сообщение равным (соединить ["НЕ ПРОВЕРЕНО: отслеживаемых .flang не нашлось — считать нечего.\nЭто НЕ «комментариев нет»: пустой список и порядок неотличимы, если молчать. (код ", (к строке код), ", ошибки: ", ошибки, ")"] по "")
    иначе вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным («Файл долга»)) и потом равным (вариант «Ждём долг» с режим равным режим и нынче равным («С комментариями» от все))

тотальная функция «Начать»
  принимает режим: «Режим»
  возвращает «Ход»
  пример «План начинается с начала в своём режиме»
    дано режим равно вариант «Подложить»
    ожидается вариант «Начали» с режим равным (вариант «Подложить»)
  вариант «Начали» с режим равным режим

тотальная функция «Начать проверку»
  возвращает «Ход»
  пример «Проверка»
    ожидается вариант «Начали» с режим равным (вариант «Проверить»)
  «Начать» от (вариант «Проверить»)

тотальная функция «Начать снятие»
  возвращает «Ход»
  пример «Снятие»
    ожидается вариант «Начали» с режим равным (вариант «Снять долг»)
  «Начать» от (вариант «Снять долг»)

тотальная функция «Начать подлог»
  возвращает «Ход»
  пример «Подлог»
    ожидается вариант «Начали» с режим равным (вариант «Подложить»)
  «Начать» от (вариант «Подложить»)

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  пример «Первый шаг — счёт одним процессом»
    дано ход равно вариант «Начали» с режим равным (вариант «Проверить»)
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["-c", "cd ../.. && git -c core.quotepath=false ls-files -z '*.flang' '*.fscript' | LC_ALL=C.UTF-8 xargs -0 -r /usr/bin/grep -aHc '^[[:space:]]*//'"]) и потом равным (вариант «Ждём счёт» с режим равным (вариант «Проверить»))
  разбор ход
    случай вариант «Начали» с режим как режим
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным («Команда счёта»)) и потом равным (вариант «Ждём счёт» с режим равным режим)
    случай вариант «Ждём счёт» с режим как режим
      то разбор отклик
        случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
          то «После счёта» от режим и код и вывод и ошибки
        случай вариант «Процесс убит» с сигнал как сигнал и вывод как вывод и ошибки как ошибки
          то вариант «Не проверено» с код равным "FLANG_KOMMENTARII_NECHEM_SCHITAT" и сообщение равным (соединить ["НЕ ПРОВЕРЕНО: счёт убит сигналом ", сигнал, ": ", ошибки] по "")
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Не проверено» с код равным "FLANG_KOMMENTARII_NECHEM_SCHITAT" и сообщение равным (соединить ["НЕ ПРОВЕРЕНО: sh не запустился (", код, "): ", сообщение] по "")
        случай любое
          то вариант «Не проверено» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответ счёта"
    случай вариант «Ждём долг» с режим как режим и нынче как нынче
      то разбор отклик
        случай вариант «Прочитано» с содержимое как текст
          то «После долга» от режим и нынче и («Долг из текста» от текст) и («Шапка долга» от текст)
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то «Без долга» от режим и нынче и код и сообщение
        случай любое
          то вариант «Не проверено» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали текст долга"
    случай вариант «Ждём запись» с было как было и стало как стало и файлов как файлов и впервые как впервые
      то разбор отклик
        случай вариант «Записано» с сколько как сколько
          то «После записи» от было и стало и файлов и впервые
        случай вариант «Сбой» с код как код и сообщение как сообщение
          то вариант «Не проверено» с код равным "FLANG_KOMMENTARII_DOLG_NE_PEREPISAN" и сообщение равным (соединить ["НЕ ПРОВЕРЕНО: долг не переписан (", код, "): ", сообщение] по "")
        случай любое
          то вариант «Не проверено» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответ на запись долга"

план «Проверка»
  состояние «Ход»
  начинает с «Начать проверку»
  обрабатывает «Дальше»

план «Снять»
  состояние «Ход»
  начинает с «Начать снятие»
  обрабатывает «Дальше»

план «Подлог»
  состояние «Ход»
  начинает с «Начать подлог»
  обрабатывает «Дальше»
