#
# Таблица «идентификатор C → русское объявление» из напечатанного заголовка.
#
# Соответствие пишет сам flang: над каждым объявлением в `.h` стоит его имя из
# исходника — «Функция flang «Слить просьбы».», «Запись FTS «Токен»: …»,
# «Сумма типов FTS «Скаляр»: «Скаляр строка» | …». Значит таблицу не надо
# считать транслитерацией заново: её уже посчитали и напечатали.
#
# Зовётся так:  awk -v pref=compiler_flang -f scripts/names-in-c.awk файл.h
# Отдаёт по строке:  идентификатор \t род \t имя \t владелец
# У варианта владелец — имя суммы, у остальных «-».

BEGIN { kind = ""; name = ""; owner = ""; nvar = 0; vi = 0 }

# «Запись FTS «Токен»: «вид», «значение», …»
/Запись FTS «/ {
  kind = "запись"; name = perv($0); nvar = 0; next
}

# «Сумма типов FTS «Скаляр»: «Скаляр строка» | «Скаляр число» | …»
/Сумма типов FTS «/ {
  kind = "вариант"; owner = perv($0); vi = 0
  # Разделитель — регулярка, поэтому вертикальная черта экранируется: без
  # этого split режет по пробелам, и «Есть узел» становится «Есть».
  nvar = split(hvost($0), vars, / \| /)
  for (i = 1; i <= nvar; i++) vars[i] = golo(vars[i])
  next
}

# «Функция flang «Слить просьбы».»
/Функция flang «/ {
  kind = "функция"; name = perv($0); nvar = 0; next
}

$0 ~ ("^fl_status " pref "_") {
  ident = $2
  sub("^" pref "_", "", ident)
  sub(/\(.*$/, "", ident)
  if (kind == "вариант") {
    # Фабрики вариантов идут подряд и в том же порядке, в каком сумма их
    # перечислила: печатает их один цикл по `sum.variants`.
    vi++
    if (vi <= nvar) print ident "\t" kind "\t" vars[vi] "\t" owner
    if (vi >= nvar) kind = ""
    next
  }
  if (kind == "") next   # «_call» и «_enter»: имени в исходнике у них нет
  print ident "\t" kind "\t" name "\t-"
  kind = ""
}

# Первое имя в ёлочках в строке.
#
# Режется регулярками, а не `substr` по смещению: у awk RSTART и RLENGTH
# считают байты, а substr — символы, и на кириллице эти две меры расходятся.
# Мерено: «Токен» так превращался в «оке».
function perv(s) {
  if (s !~ /«/) return ""
  sub(/^[^«]*«/, "", s)
  sub(/».*$/, "", s)
  return s
}

# Всё после первого «имя»: — перечень вариантов суммы.
function hvost(s) {
  if (s !~ /»: /) return ""
  sub(/^[^«]*«[^»]*»: /, "", s)
  sub(/ *\*\/ *$/, "", s)
  sub(/\.$/, "", s)
  return s
}

# «Скаляр строка» → Скаляр строка
function golo(s) {
  sub(/^«/, "", s); sub(/»$/, "", s)
  return s
}
