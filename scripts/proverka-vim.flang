модуль «Проверка подсветки Vim»
  использует «Правила Vim»

// Сверка напечатанных правил с таблицей языка — НАСТОЯЩИМ редактором.
//
// Зачем не глазами. Правила Vim умеют съесть слово молча: `syn keyword`
// разбирает хвост своей строки как ключи, и `contains` — настоящая фраза
// английской поверхности — обрывает список, унося всё, что стояло после неё.
// Ни ошибки, ни предупреждения. Это не выдумка: так и было в первом наброске,
// и увидеть это можно было только спросив у редактора про каждую фразу.
//
// Что делает план:
//   1. читает `editors/vim/syntax/flang.vim` из дерева и сверяет его с тем,
//      что печатается из таблицы СЕЙЧАС, — «забыли перепечатать» не пройдёт;
//   2. печатает файл со всеми фразами таблицы, по одной на строку;
//   3. открывает его настоящим Vim и настоящим Neovim, без окна и человека;
//   4. каждый редактор отвечает, сколько фраз покрашено ключевым словом;
//   5. переводит четыре файла дерева в HTML командой `:TOhtml` и считает
//      раскрашенное по видам — на всех четырёх поверхностях записи;
//   6. хоть одна непокрашенная — план сдаётся кодом, а не пишет «вроде всё».
//
// Запуск:  flang io scripts/proverka-vim.flang

тотальная функция «Куда слова»
  возвращает строка
  "../editors/vim/proverka/slova.txt"

// Расширение НЕ `.flang` нарочно: файл — список слов, а не программа, и
// `flang check` его отверг бы. Поэтому тип файла в редакторе назначается
// ключом, а сам разбор расширения проверяется отдельно — на настоящих файлах
// дерева.
тотальная функция «Доводы редактора»
  принимает тихо: список строки
  возвращает список строки
  свёртка [
    "--cmd", "set rtp^=../editors/vim",
    "--cmd", "filetype plugin on",
    "--cmd", "syntax on",
    "-c", "set filetype=flang",
    "-c", "source ../editors/vim/proverka/frazy.vim",
    "-c", "call FlangFrazy()",
    "-c", "qa!",
    "../editors/vim/proverka/slova.txt"
  ] начиная с тихо как акк и довод
    добавить довод к акк

тотальная функция «Доводы Vim»
  возвращает список строки
  «Доводы редактора» от ["-Nu", "NONE", "-es", "--cmd", "set nocompatible"]

тотальная функция «Доводы Neovim»
  возвращает список строки
  «Доводы редактора» от ["--headless", "-u", "NONE"]

тотальная функция «Ответ хорош»
  принимает ответ: строка
  возвращает признак
  пример «Ноль непокрашенных — хорошо»
    дано ответ равно "фраз проверено: 629\nне покрашено: 0"
    ожидается да
  пример «Одна непокрашенная — плохо»
    дано ответ равно "не покрашено: 1"
    ожидается нет
  ответ содержит "не покрашено: 0"

// ── подсветка на настоящих файлах дерева ───────────────────────────────────
//
// Проверка сильнее, чем «что-то раскрасилось». Три файла — английский,
// китайский и эсперантский «Факториал» — это ОДНА И ТА ЖЕ программа, записанная
// слово в слово на трёх поверхностях (`flang/test/surfaces.test.mjs` требует
// совпадения синтаксических деревьев). Значит и кусков ключевых слов в них
// обязано быть поровну. Разъедься подсветка на одной поверхности — числа
// разойдутся, и это видно без глаз.

тотальная функция «Строка про»
  принимает вывод: строка, часть: строка
  возвращает строка
  пример «Находит свою строку»
    дано вывод равно "а | один\nб | два"
    дано часть равно "два"
    ожидается "б | два"
  пример «Нет такой строки»
    дано вывод равно "а | один"
    дано часть равно "три"
    ожидается ""
  свёртка (разделить вывод по "\n") начиная с "" как акк и стр
    если акк не равен ""
      то акк
      иначе (если стр содержит часть то стр иначе "")

тотальная функция «Кусков вида»
  принимает строка: строка, вид: строка
  возвращает строка
  пример «Считает куски после имени вида»
    дано строка равно "русская | ф | Statement 1122, Constant 350"
    дано вид равно "Statement "
    ожидается "1122"
  пример «Вида нет — пусто»
    дано строка равно "русская | ф | Comment 5"
    дано вид равно "Statement "
    ожидается ""
  если строка содержит вид
    то голова (разделить (голова (хвост (разделить строка по вид))) по ",")
    иначе ""

тотальная функция «Близнецы покрашены одинаково»
  принимает вывод: строка
  возвращает признак
  пусть анг равно «Кусков вида» от («Строка про» от вывод и "factorial-english") и "Statement "
  пусть кит равно «Кусков вида» от («Строка про» от вывод и "factorial.zh") и "Statement "
  пусть эсп равно «Кусков вида» от («Строка про» от вывод и "factorial.eo") и "Statement "
  (анг не равен "") и притом ((анг равен кит) и притом (анг равен эсп))

тотальная функция «Русский файл покрашен»
  принимает вывод: строка
  возвращает признак
  пусть строка равно «Строка про» от вывод и "stdlib/lists.flang"
  ((«Кусков вида» от строка и "Statement ") не равен "") и притом (((«Кусков вида» от строка и "Identifier ") не равен "") и притом ((«Кусков вида» от строка и "Comment ") не равен ""))

тип «Ход»
  вариант «Читаем правила»
  вариант «Правила прочитаны»
  вариант «Пишем слова»
  вариант «Слова записаны»
  вариант «Vim ответил»
  вариант «Neovim ответил» содержит сказано: строка
  вариант «Дерево проверено» содержит сказано: строка

тотальная функция «Начать»
  возвращает «Ход»
  пример «План начинается с чтения того, что лежит в дереве»
    ожидается вариант «Читаем правила»
  вариант «Читаем правила»

тотальная функция «Где правила»
  возвращает строка
  "../editors/vim/syntax/flang.vim"

тотальная функция «Дальше по свежести»
  принимает содержимое: строка
  возвращает «Продолжение»
  если содержимое равен «Файл подсветки»
    то вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным «Куда слова» и содержимое равным «Слова файлом») и потом равным (вариант «Слова записаны»)
    иначе вариант «Провал» с код равным "FLANG_VIM_USTARELI" и сообщение равным "editors/vim/syntax/flang.vim отстал от таблицы языка: перепечатайте — flang io scripts/podsvetka-vim.flang"

// Свежи ли правила в дереве. Строка из дерева сравнивается с той, которую
// печатает `pravila-vim.flang` сейчас: разошлись — значит таблицу пополнили, а
// правила перепечатать забыли, и подсветка отстала от языка молча.
тотальная функция «После чтения правил»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Прочитано» с содержимое как содержимое
      то «Дальше по свежести» от содержимое
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали содержимое файла правил"

тотальная функция «Слова файлом»
  возвращает строка
  соединить «Все фразы» по "\n"

тотальная функция «Ответ процесса»
  принимает отклик: «Отклик»
  возвращает строка
  пример «Отчёт редактора приходит потоком ошибок»
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "" и ошибки равным "не покрашено: 0"
    ожидается "не покрашено: 0"
  пример «Не процесс — пусто»
    дано отклик равно вариант «Пока ничего»
    ожидается ""
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то соединить [вывод, ошибки] по ""
    случай любое
      то ""

тотальная функция «После записи слов»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Записано» с сколько как сколько
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "vim" и аргументы равным «Доводы Vim») и потом равным (вариант «Vim ответил»)
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным сообщение
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали подтверждение записи"

тотальная функция «После Vim»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  пусть сказано равно «Ответ процесса» от отклик
  если «Ответ хорош» от сказано
    то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "nvim" и аргументы равным «Доводы Neovim») и потом равным (вариант «Neovim ответил» с сказано равным сказано)
    иначе вариант «Провал» с код равным "FLANG_VIM_PROPUSK" и сообщение равным (соединить ["Vim покрасил не все фразы таблицы:\n", сказано] по "")

тотальная функция «После Neovim»
  принимает прежнее: строка, отклик: «Отклик»
  возвращает «Продолжение»
  пусть сказано равно «Ответ процесса» от отклик
  если «Ответ хорош» от сказано
    то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "sh" и аргументы равным ["../editors/vim/proverka/tohtml.sh"]) и потом равным (вариант «Дерево проверено» с сказано равным (соединить [прежнее, "\n", сказано] по ""))
    иначе вариант «Провал» с код равным "FLANG_NVIM_PROPUSK" и сообщение равным (соединить ["Neovim покрасил не все фразы таблицы:\n", сказано] по "")

тотальная функция «После дерева»
  принимает прежнее: строка, отклик: «Отклик»
  возвращает «Продолжение»
  пусть сказано равно «Ответ процесса» от отклик
  если («Русский файл покрашен» от сказано) и притом («Близнецы покрашены одинаково» от сказано)
    то вариант «Конец работы» с значение равным (соединить ["\n", прежнее, "\n", сказано] по "")
    иначе вариант «Провал» с код равным "FLANG_VIM_DEREVO" и сообщение равным (соединить ["подсветка на файлах дерева разошлась:\n", сказано] по "")

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Читаем правила»
      то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным «Где правила») и потом равным (вариант «Правила прочитаны»)
    случай вариант «Правила прочитаны»
      то «После чтения правил» от отклик
    случай вариант «Пишем слова»
      то вариант «Сделать» с поручение равным (вариант «Записать файл» с путь равным «Куда слова» и содержимое равным «Слова файлом») и потом равным (вариант «Слова записаны»)
    случай вариант «Слова записаны»
      то «После записи слов» от отклик
    случай вариант «Vim ответил»
      то «После Vim» от отклик
    случай вариант «Neovim ответил» с сказано как сказано
      то «После Neovim» от сказано и отклик
    случай вариант «Дерево проверено» с сказано как сказано
      то «После дерева» от сказано и отклик

план «Сверить подсветку с таблицей»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
