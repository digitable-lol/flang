    ожидается ["  git -C packaging/homebrew-tap commit -am \'flang 0.7.21: url, sha256, version\' && git -C packaging/homebrew-tap push origin main", "  git add packaging/homebrew-tap   # указатель сабмодуля — в тот же коммит выпуска", "Пока указатель не поднят, «формула:проверка» и release.yml КРАСНЫ — это и есть защита от забытого крана.", "", "Плагин asdf (сабмодуль packaging/asdf-plugin) — числа версии в нём нет, поднимать нечего; сверка файлов:"]
  [(соединить ["  git -C packaging/homebrew-tap commit -am \'flang ", свод.«новая», ": url, sha256, version\' && git -C packaging/homebrew-tap push origin main"] по ""), "  git add packaging/homebrew-tap   # указатель сабмодуля — в тот же коммит выпуска", "Пока указатель не поднят, «формула:проверка» и release.yml КРАСНЫ — это и есть защита от забытого крана.", "", (соединить ["Плагин asdf (сабмодуль ", («Путь плагина»), ") — числа версии в нём нет, поднимать нечего; сверка файлов:"] по "")]

