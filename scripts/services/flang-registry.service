# Служба реестра имён пакетов flang — единица systemd --user.
# Ставится планом scripts/services/registry-deploy.fscript, который подставляет
# @HOME_DIR@ и @PORT@; руками не править — следующая установка перепишет.
#
# Почему --trust: доказательства и примеры проверяются при установке
# (flang check, flang test — скрипт установки не кладёт двоичное, если они
# красные); перезапуск службы их не повторяет, иначе каждый подъём стоил бы
# полторы минуты и два гигабайта. Почему --in-dir: поручения плана не выходят
# за каталог службы, что бы ни пришло в пути запроса. Почему --max-orders:
# у хозяина предел поручений за прогон по умолчанию 10 000 — это около двух
# тысяч запросов, а служба живёт месяцами.
#
# Хозяин `flang io` слушает 0.0.0.0: адреса привязки у поручения «Принять
# соединение» нет, а IPAddressDeny/IPAddressAllow и PrivateNetwork в
# пользовательской единице не действуют (systemd: «unit configures an IP
# firewall, but not running as root»; проверено 24 и 25.10.2026 — порт отвечал
# по внешнему адресу машины). Поэтому служба живёт в своём сетевом пространстве
# под pasta: снаружи её порт виден только как 127.0.0.1:@PORT@ машины, внешний
# адрес отвечает отказом соединения. sh между pasta и flang нужен надзору:
# pasta отдаёт код выхода ребёнка, но гибель ребёнка от сигнала превращает в 0,
# а sh — в 128+сигнал, и Restart=on-failure срабатывает.
# --host-lo-to-ns-lo: с выпуска 0.7.32 хозяин слушает 127.0.0.1 своего
# пространства (FLANG_LISTEN_ADDRESS не задан), а pasta без этого ключа
# передаёт соединение с петли машины на внешний адрес пространства — там
# никто не слушает, и соединение сбрасывается. С ключом оно приходит на
# петлю пространства; хозяину до 0.7.32, слушающему 0.0.0.0, ключ не мешает.
# См. docs/services-in-production.md.

[Unit]
Description=flang registry: name ledger of packages over HTTP
After=network.target

[Service]
WorkingDirectory=@HOME_DIR@/service
ExecStart=/usr/bin/pasta --config-net --host-lo-to-ns-lo -t 127.0.0.1/@PORT@ -u none -T none -U none -f -q -- /bin/sh -c '"$$@"; exit $$?' run @HOME_DIR@/bin/flang io @HOME_DIR@/service/serve.flang --trust --in-dir --max-orders 1000000000 -- @PORT@
Restart=on-failure
RestartSec=5
MemoryMax=4G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
