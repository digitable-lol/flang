  («Сделать» от (вариант «Запустить процесс» с программа равным "git"
    и аргументы равным ["-C", "../..", "ls-files", "--", "README.md", "DESCRIPTION.md", "docs"])
    и (вариант «Ждём перечень» с корень равным корень))

тотальная функция «Прочитать страницу»
  принимает работа: «Работа», страницы: список строки
  возвращает «Продолжение»
  пример «пустой перечень — провал, а не молчаливый успех»
    дано работа равно (запись «Работа» с «корень» равным "/t" и «блоки» равным пустой список и «словарь» равным ""
      и «страниц» равным 0)
    дано страницы равно пустой список
    ожидается вариант «Провал» с код равным "PAGE_EXAMPLES_NO_PAGES" и сообщение равным "в дереве нет ни одной страницы"
  пример «страница читается от корня дерева»
    дано работа равно (запись «Работа» с «корень» равным "/t" и «блоки» равным пустой список и «словарь» равным ""
      и «страниц» равным 0)
    дано страницы равно ["а.md"]
    ожидается ((вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным "../../а.md")
      и потом равным (вариант «Читаем» с работа равным ((запись «Работа» с «корень» равным "/t"
      и «блоки» равным пустой список и «словарь» равным "" и
        «страниц» равным 0)) и имя равным "а.md" и остальные равным пустой список)))
  если пусто страницы
    то вариант «Провал» с код равным "PAGE_EXAMPLES_NO_PAGES" и сообщение равным "в дереве нет ни одной страницы"
    иначе («Сделать» от (вариант «Прочитать файл» с путь равным (соединить ["../../", (голова страницы)] по ""))
      и (вариант «Читаем» с работа равным работа и имя равным (голова страницы) и остальные равным (хвост страницы)))

