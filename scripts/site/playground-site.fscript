      и остальные равным (хвост страницы)))

тотальная функция «После страницы»
  принимает работа: «Работа», имя: строка, остальные: список строки, содержимое: строка
  возвращает «Продолжение»
  пусть ограды равно («Ограды страницы» от содержимое)
  пусть блоки равно («Блоки flang» от ограды)
  пусть пары равно («Пары страницы» от имя и ограды)
  пусть отрывков равно (длина (отфильтровать блоки где блок → (блок.«вид») равен "отрывок"))
  («Прочитать страницу» от («Работа из» от (работа.«корень») и ((работа.«страниц») плюс 1)
    и ((работа.«отрывков») плюс отрывков) и ((работа.«без пары») плюс (пары.«без пары»))
    и («Соединить списки» от (работа.«дела»)
      и («Соединить списки» от («Дела проверки» от имя и блоки и (работа.«долги»))
      и (пары.«дела»))) и (работа.«долги»)) и остальные)

тотальная функция «Файл дела»
  принимает работа: «Работа», очередь: список «Дело»
  возвращает строка
  соединить [(работа.«корень»), "/", (к строке (длина очередь)), ".flang"] по ""

тотальная функция «Вердикт»
  принимает работа: «Работа», итог: «Итог»
  возвращает «Продолжение»
  если пусто (работа.«дела»)
    то (вариант «Провал» с код равным "PLAYGROUND_SITE_NO_PROGRAMS"
      и сообщение равным "на страницах нет ни одной целой программы flang")
    иначе если пусто (итог.«провалы»)
      то вариант «Конец работы» с значение равным («Отчёт» от работа и итог)
      иначе вариант «Провал» с код равным "PLAYGROUND_SITE_RED" и сообщение равным («Отчёт» от работа и итог)

тотальная функция «Записать дело»
  принимает работа: «Работа», очередь: список «Дело», итог: «Итог»
  возвращает «Продолжение»
  если пусто очередь
    то «Вердикт» от работа и итог
    иначе («Сделать» от (вариант «Записать файл» с путь равным («Файл дела» от работа и очередь)
      и содержимое равным (соединить [((голова очередь).«текст»), "\n"] по ""))
      и (вариант «Пишем» с работа равным работа и очередь равным очередь и итог равным итог))

тотальная функция «Прогнать дело»
  принимает работа: «Работа», очередь: список «Дело», итог: «Итог»
  возвращает «Продолжение»
  («Сделать» от (вариант «Запустить процесс» с программа равным "timeout"
    и аргументы равным («Соединить списки» от [(«Срок прогона»), "node", "--liftoff-only", («Хозяин»),
      («Каталог песочницы»)]
      и («Соединить списки» от ((голова очередь).«ключи») и ["--файл", («Файл дела» от работа и очередь)])))
    и (вариант «Гоним» с работа равным работа и очередь равным очередь и итог равным итог))

тотальная функция «После прогона»
  принимает работа: «Работа», очередь: список «Дело», итог: «Итог», отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то («Записать дело» от работа и (хвост очередь)
        и («Учесть» от итог и (голова очередь) и («Беда дела» от (голова очередь) и код и вывод)))
    случай любое
      то «Провал ответа» от "прогон блока в песочнице" и отклик

тотальная функция «После выбора»
  принимает корень: строка, долги: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Значение среды» с значение как значение
      то «Прочитать страницу» от («Работа из» от корень и 0 и 0 и 0 и пустой список и долги) и [значение]
    случай любое
      то («Сделать» от (вариант «Запустить процесс» с программа равным "git"
        и аргументы равным ["-C", "../..", "ls-files", "--", "docs/site/*.md", "docs/guide/*.md"])
        и (вариант «Ждём перечень» с корень равным корень и долги равным долги))

тотальная функция «После перечня»
  принимает корень: строка, долги: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  пример «пустой перечень — провал»
    дано корень равно "/t"
    дано долги равно пустой список
    дано отклик равно вариант «Процесс завершён» с код равным 0 и вывод равным "" и ошибки равным ""
    ожидается (вариант «Провал» с код равным "PLAYGROUND_SITE_NO_PROGRAMS"
      и сообщение равным "на страницах нет ни одной целой программы flang")
  разбор отклик
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то («Прочитать страницу» от («Работа из» от корень и 0 и 0 и 0 и пустой список и долги)
        и (отфильтровать (разделить вывод по "\n") где путь → «Это страница» от путь))
    случай любое
      то «Провал ответа» от "перечень страниц" и отклик

тотальная функция «После среды»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Значение среды» с значение как значение
      то «Каталог по корню» от значение
    случай любое
      то «Каталог по корню» от "/tmp"

тотальная функция «После каталога»
  принимает отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Заведено» с путь как путь
      то («Сделать» от (вариант «Прочитать файл» с путь равным "playground-site-known.txt")
        и (вариант «Ждём ведомость» с корень равным путь))
    случай любое
      то «Провал ответа» от "временный каталог" и отклик

тотальная функция «После ведомости»
  принимает корень: строка, отклик: «Отклик»
  возвращает «Продолжение»
  пример «ведомость без строк даёт пустой список долгов»
    дано корень равно "/t"
    дано отклик равно вариант «Прочитано» с содержимое равным "# заметка\n\n"
    ожидается (вариант «Сделать» с поручение равным (вариант «Прочитать переменную среды» с
      имя равным "FLANG_PLAYGROUND_SITE_ONLY") и потом равным (вариант «Ждём выбор» с корень равным "/t"
      и долги равным пустой список))
  разбор отклик
    случай вариант «Прочитано» с содержимое как содержимое
      то («Сделать» от (вариант «Прочитать переменную среды» с имя равным "FLANG_PLAYGROUND_SITE_ONLY")
        и (вариант «Ждём выбор» с корень равным корень и долги равным (отфильтровать (разделить содержимое по "\n")
        где строчка → (строчка содержит " | ") и притом (не (строчка начинается с "#")))))
    случай любое
      то «Провал ответа» от "ведомость известных расхождений" и отклик

тотальная функция «После чтения»
  принимает работа: «Работа», имя: строка, остальные: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Прочитано» с содержимое как содержимое
      то «После страницы» от работа и имя и остальные и содержимое
    случай любое
      то «Провал ответа» от имя и отклик

тотальная функция «После записи»
  принимает работа: «Работа», очередь: список «Дело», итог: «Итог», отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Записано» с сколько как сколько
      то «Прогнать дело» от работа и очередь и итог
    случай любое
      то «Провал ответа» от "запись блока" и отклик

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Начало»
      то «Сделать» от (вариант «Прочитать переменную среды» с имя равным "FLANG_TMP") и (вариант «Ждём среду»)
    случай вариант «Ждём среду»
      то «После среды» от отклик
    случай вариант «Ждём каталог»
      то «После каталога» от отклик
    случай вариант «Ждём ведомость» с корень как корень
      то «После ведомости» от корень и отклик
    случай вариант «Ждём выбор» с корень как корень и долги как долги
      то «После выбора» от корень и долги и отклик
    случай вариант «Ждём перечень» с корень как корень и долги как долги
      то «После перечня» от корень и долги и отклик
    случай вариант «Читаем» с работа как работа и имя как имя и остальные как остальные
      то «После чтения» от работа и имя и остальные и отклик
    случай вариант «Пишем» с работа как работа и очередь как очередь и итог как итог
      то «После записи» от работа и очередь и итог и отклик
    случай вариант «Гоним» с работа как работа и очередь как очередь и итог как итог
      то «После прогона» от работа и очередь и итог и отклик

план «Check»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
