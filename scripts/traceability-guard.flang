  обеспечивает «разрывов не больше, чем функций» (длина результат) не больше (длина (набор.«функции»))
  пример «В пустом наборе разрывов нет»
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    ожидается пустой список
  отфильтровать (набор.«функции») где определение → пусто («Требования функции» от набор и определение)

тотальная функция «Свидетельства без кода»
  принимает набор: «Набор»
  возвращает список «Свидетельство»
  обеспечивает «без кода не больше, чем свидетельств» (длина результат) не больше (длина (набор.«свидетельства»))
  пример «В пустом наборе всё сходится»
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    ожидается пустой список
  отфильтровать (набор.«свидетельства») где свидетельство → не («Код есть» от набор и свидетельство)

тотальная функция «Место требования»
  принимает требование: «Требование»
  возвращает строка
  обеспечивает «место называет файл» результат содержит (требование.«файл»)
  пример «Файл, строка, функция, имя»
    дано требование равно запись «Требование» с «файл» равным "а.flang" и «функция» равным "Сумма" и «имя» равным "а" и «строка» равным 2
    ожидается "      а.flang:2 функция «Сумма» — «а»"
  соединить ["      ", (требование.«файл»), ":", (к строке (требование.«строка»)), " функция «", (требование.«функция»), "» — «", (требование.«имя»), "»"] по ""

тотальная функция «Место функции»
  принимает определение: «Функция»
  возвращает строка
  обеспечивает «место называет файл» результат содержит (определение.«файл»)
  пример «Файл, строка, имя»
    дано определение равно запись «Функция» с «файл» равным "а.flang" и «имя» равным "Сумма" и «строка» равным 1
    ожидается "      а.flang:1 функция «Сумма»"
  соединить ["      ", (определение.«файл»), ":", (к строке (определение.«строка»)), " функция «", (определение.«имя»), "»"] по ""

тотальная функция «Место свидетельства»
  принимает свидетельство: «Свидетельство»
  возвращает строка
  обеспечивает «место называет запись» результат содержит (свидетельство.«запись»)
  пример «Запись, исходник, функция, имя»
    дано свидетельство равно запись «Свидетельство» с «запись» равным "а.запись" и «исходник» равным "а.flang" и «функция» равным "Сумма" и «имя» равным "а" и «строка» равным 2 и «вердикт» равным "доказано"
    ожидается "      а.запись → а.flang:2 функция «Сумма» — «а»: в коде такого требования нет"
  соединить ["      ", (свидетельство.«запись»), " → ", (свидетельство.«исходник»), ":", (к строке (свидетельство.«строка»)), " функция «", (свидетельство.«функция»), "» — «", (свидетельство.«имя»), "»: в коде такого требования нет"] по ""

тотальная функция «Первые пять»
  принимает строки: список строки
  возвращает список строки
  обеспечивает «не больше пяти» (длина результат) не больше 5
  пример «Из шести остаются пять»
    дано строки равно ["1", "2", "3", "4", "5", "6"]
    ожидается ["1", "2", "3", "4", "5"]
  «Взять первые» от строки и 5

тотальная функция «Слово о долге»
  принимает имя: строка, налицо: число, записано: число
  возвращает строка
  обеспечивает «слово называет число» результат содержит (к строке налицо)
  пример «Сходится»
    дано имя равно "код → требование"
    дано налицо равно 72
    дано записано равно 72
    ожидается "  долг «код → требование»: 72, в scripts/traceability-debt.tsv записано 72 — сходится"
  пример «Вырос»
    дано имя равно "код → требование"
    дано налицо равно 73
    дано записано равно 72
    ожидается "  долг «код → требование»: 73, в scripts/traceability-debt.tsv записано 72 — ВЫРОС, новый разрыв надо закрыть"
  пример «Упал»
    дано имя равно "код → требование"
    дано налицо равно 70
    дано записано равно 72
    ожидается "  долг «код → требование»: 70, в scripts/traceability-debt.tsv записано 72 — УПАЛ, впишите 70, чтобы потолок не поднялся обратно"
  пусть начало равно (соединить ["  долг «", имя, "»: ", (к строке налицо), ", в scripts/traceability-debt.tsv записано ", (к строке записано)] по "")
  если налицо равен записано
    то соединить [начало, " — сходится"] по ""
    иначе если налицо больше записано
      то соединить [начало, " — ВЫРОС, новый разрыв надо закрыть"] по ""
      иначе соединить [начало, " — УПАЛ, впишите ", (к строке налицо), ", чтобы потолок не поднялся обратно"] по ""

тотальная функция «Перепись»
  принимает набор: «Набор»
  возвращает список строки
  обеспечивает «перепись не пуста» (длина результат) больше 0
  пример «Пустой набор»
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    ожидается ["прослеживаемость: исходников 0, записей 0, функций 0", "  постусловий 0: с примером 0, в записи 0, из них доказано 0", "  требование → проверка: без примера 0, без записи 0, в записи без вердикта «доказано» 0", "  разрывов требование → проверка (ни примера, ни доказательства): 0", "  разрывов код → требование (функций без постусловия): 0", "  запись → код: свидетельств, у которых в коде нет требования: 0"]
  пусть требования равно (набор.«требования»)
  пусть примерные равно (отфильтровать требования где требование → «Пример есть» от набор и требование)
  пусть записанные равно (отфильтровать требования где требование → не (пусто («Свидетельства о» от набор и требование)))
  пусть доказанные равно (отфильтровать требования где требование → «Доказано» от набор и требование)
  пусть разрывы равно («Разрывы требований» от набор)
  пусть непокрытые равно («Функции без требования» от набор)
  пусть висячие равно («Свидетельства без кода» от набор)
  «Соединить списки» от [(соединить ["прослеживаемость: исходников ", (к строке (длина (набор.«исходники»))), ", записей ", (к строке (набор.«записей»)), ", функций ", (к строке (длина (набор.«функции»)))] по ""), (соединить ["  постусловий ", (к строке (длина требования)), ": с примером ", (к строке (длина примерные)), ", в записи ", (к строке (длина записанные)), ", из них доказано ", (к строке (длина доказанные))] по ""), (соединить ["  требование → проверка: без примера ", (к строке ((длина требования) минус (длина примерные))), ", без записи ", (к строке ((длина требования) минус (длина записанные))), ", в записи без вердикта «доказано» ", (к строке ((длина записанные) минус (длина доказанные)))] по ""), (соединить ["  разрывов требование → проверка (ни примера, ни доказательства): ", (к строке (длина разрывы))] по "")] и («Соединить списки» от («Первые пять» от (отобразить разрывы как требование → «Место требования» от требование)) и («Соединить списки» от (приписать (соединить ["  разрывов код → требование (функций без постусловия): ", (к строке (длина непокрытые))] по "") к («Первые пять» от (отобразить непокрытые как определение → «Место функции» от определение))) и (приписать (соединить ["  запись → код: свидетельств, у которых в коде нет требования: ", (к строке (длина висячие))] по "") к (отобразить висячие как свидетельство → «Место свидетельства» от свидетельство))))

тотальная функция «Приговор переписи»
  принимает набор: «Набор», подлог: признак
  возвращает «Продолжение»
  пусть строки равно («Перепись» от набор)
  пусть висячие равно («Свидетельства без кода» от набор)
  пусть разрывов равно (длина («Разрывы требований» от набор))
  пусть непокрытые равно (длина («Функции без требования» от набор))
  пусть долги равно [(«Слово о долге» от "требование → проверка" и разрывов и (набор.«долг требований»)), («Слово о долге» от "код → требование" и непокрытые и (набор.«долг кода»))]
  пусть отчёт равно (соединить («Соединить списки» от строки и долги) по "\n")
  если не (пусто висячие)
    то если подлог
      то вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_RAZRYV" и сообщение равным (соединить [отчёт, "\nподлог пойман: из ", («Файл подлога»), " спрятана строка «", («Спрятанное требование»), "», а запись доказательства это требование по-прежнему называет"] по "")
      иначе вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_RAZRYV" и сообщение равным (соединить [отчёт, "\nзапись доказательства называет требование, которого в коде нет: цепочка порвана"] по "")
    иначе если подлог
      то вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_PODLOG" и сообщение равным (соединить [отчёт, "\nПОДЛОГ НЕ ПОЙМАН — проверка сломана"] по "")
      иначе если (разрывов равен (набор.«долг требований»)) и притом (непокрытые равен (набор.«долг кода»))
        то вариант «Конец работы» с значение равным отчёт
        иначе вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_DOLG" и сообщение равным (соединить [отчёт, "\nчисло разрывов разошлось с записанным долгом"] по "")

тотальная функция «Имена примеров»
  принимает набор: «Набор», требование: «Требование»
  возвращает строка
  обеспечивает «слово не пусто» не (пусто результат)
  пример «Примеров нет»
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    дано требование равно запись «Требование» с «файл» равным "а.flang" и «функция» равным "Сумма" и «имя» равным "а" и «строка» равным 2
    ожидается "ПРИМЕРА НЕТ"
  пусть примеры равно (отфильтровать (набор.«примеры») где образец → ((образец.«файл») равен (требование.«файл»)) и притом ((образец.«функция») равен (требование.«функция»)))
  если пусто примеры
    то "ПРИМЕРА НЕТ"
    иначе соединить (отобразить примеры как образец → (соединить ["«", (образец.«имя»), "»"] по "")) по ", "

тотальная функция «Слово о записи»
  принимает набор: «Набор», требование: «Требование»
  возвращает строка
  обеспечивает «слово не пусто» не (пусто результат)
  пример «Записи нет»
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    дано требование равно запись «Требование» с «файл» равным "а.flang" и «функция» равным "Сумма" и «имя» равным "а" и «строка» равным 2
    ожидается "ЗАПИСИ НЕТ"
  пусть свидетельства равно («Свидетельства о» от набор и требование)
  если пусто свидетельства
    то "ЗАПИСИ НЕТ"
    иначе соединить (отобразить свидетельства как свидетельство → (соединить [(свидетельство.«запись»), " — вердикт ", (свидетельство.«вердикт»)] по "")) по "; "

тотальная функция «Цепочка требования»
  принимает набор: «Набор», требование: «Требование»
  возвращает список строки
  обеспечивает «цепочка — четыре строки» (длина результат) равен 4
  пример «Требование без примера и записи»
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    дано требование равно запись «Требование» с «файл» равным "а.flang" и «функция» равным "Сумма" и «имя» равным "а" и «строка» равным 2
    ожидается ["требование «а»", "  код:     а.flang:2, функция «Сумма»", "  примеры: ПРИМЕРА НЕТ", "  запись:  ЗАПИСИ НЕТ"]
  [(соединить ["требование «", (требование.«имя»), "»"] по ""), (соединить ["  код:     ", (требование.«файл»), ":", (к строке (требование.«строка»)), ", функция «", (требование.«функция»), "»"] по ""), (соединить ["  примеры: ", («Имена примеров» от набор и требование)] по ""), (соединить ["  запись:  ", («Слово о записи» от набор и требование)] по "")]

тотальная функция «Цепочки»
  принимает набор: «Набор», требования: список «Требование»
  возвращает список строки
  обеспечивает «по четыре строки на требование» (длина результат) равен ((длина требования) умножить на 4)
  пример «Ни одного требования — ни одной строки»
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    дано требования равно пустой список
    ожидается пустой список
  свёртка требования начиная с (пустой список) как итог и требование → «Соединить списки» от итог и («Цепочка требования» от набор и требование)

тотальная функция «Приговор требованию»
  принимает набор: «Набор», запрос: строка
  возвращает «Продолжение»
  пусть найденные равно (отфильтровать (набор.«требования») где требование → (требование.«имя») равен запрос)
  пусть разрывы равно (отфильтровать найденные где требование → (не («Пример есть» от набор и требование)) и притом (не («Доказано» от набор и требование)))
  если пусто найденные
    то вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_NET_TREBOVANIYA" и сообщение равным (соединить ["требование «", запрос, "» не найдено ни в одном исходнике набора: ", (к строке (длина (набор.«требования»))), " постусловий в ", (к строке (длина (набор.«исходники»))), " исходниках"] по "")
    иначе если пусто разрывы
      то вариант «Конец работы» с значение равным (соединить («Цепочки» от набор и найденные) по "\n")
      иначе вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_RAZRYV" и сообщение равным (соединить («Соединить списки» от («Цепочки» от набор и найденные) и [(соединить ["РАЗРЫВ: у требования «", запрос, "» нет ни примера, ни доказанной записи"] по "")]) по "\n")

тотальная функция «Функция по строке»
  принимает набор: «Набор», файл: строка, номер: число
  возвращает «Функция»
  обеспечивает «строка функции не дальше искомой» (результат.«строка») не больше номер
  пример «Берётся последняя функция, открытая до строки»
    дано набор равно запись «Набор» с «исходники» равным ["а.flang"] и «записей» равным 0 и «функции» равным [запись «Функция» с «файл» равным "а.flang" и «имя» равным "Сумма" и «строка» равным 1, запись «Функция» с «файл» равным "а.flang" и «имя» равным "Разность" и «строка» равным 4] и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    дано файл равно "а.flang"
    дано номер равно 5
    ожидается запись «Функция» с «файл» равным "а.flang" и «имя» равным "Разность" и «строка» равным 4
  пример «До первой функции — ничего»
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    дано файл равно "а.flang"
    дано номер равно 1
    ожидается запись «Функция» с «файл» равным "" и «имя» равным "" и «строка» равным 0
  свёртка (набор.«функции») начиная с (запись «Функция» с «файл» равным "" и «имя» равным "" и «строка» равным 0) как лучшая и определение
    если ((определение.«файл») равен файл) и притом (((определение.«строка») не больше номер) и притом ((определение.«строка») больше (лучшая.«строка»)))
      то определение
      иначе лучшая

тотальная функция «Файл запроса»
  принимает запрос: строка
  возвращает строка
  обеспечивает «файл не длиннее запроса» (длина результат) не больше (длина запрос)
  пример «Путь до двоеточия»
    дано запрос равно "flang/proof/map/abilities.flang:34"
    ожидается "flang/proof/map/abilities.flang"
  пример «Без двоеточия файла нет»
    дано запрос равно "abilities"
    ожидается ""
  пусть куски равно (разделить запрос по ":")
  если (длина куски) равен 2
    то элемент 1 в куски
    иначе ""

тотальная функция «Номер запроса»
  принимает запрос: строка
  возвращает число
  обеспечивает «кривой запрос даёт ноль» если пусто («Файл запроса» от запрос) то (результат равен 0) иначе да
  пример «Номер после двоеточия»
    дано запрос равно "flang/proof/map/abilities.flang:34"
    ожидается 34
  пример «Не число — ноль»
    дано запрос равно "abilities.flang:тридцать"
    ожидается 0
  пусть куски равно (разделить запрос по ":")
  если (длина куски) равен 2
    то «Число из» от (элемент 2 в куски)
    иначе 0

тотальная функция «Приговор строке»
  принимает набор: «Набор», запрос: строка
  возвращает «Продолжение»
  пусть файл равно («Файл запроса» от запрос)
  пусть номер равно («Номер запроса» от запрос)
  пусть определение равно («Функция по строке» от набор и файл и номер)
  пусть требования равно («Требования функции» от набор и определение)
  пусть шапка равно (соединить ["строка ", запрос, " лежит в функции «", (определение.«имя»), "» (объявлена в строке ", (к строке (определение.«строка»)), ")"] по "")
  если (пусто файл) или (номер равен 0)
    то вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_ZAPROS" и сообщение равным (соединить ["ждали «путь:строка», например flang/proof/map/abilities.flang:34, а получили «", запрос, "»"] по "")
    иначе если не ((набор.«исходники») содержит файл)
      то вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_ZAPROS" и сообщение равным (соединить ["файла «", файл, "» в наборе нет: набор — flang/proof/examples, flang/test/fixtures, flang/proof/map и исходники, названные записями"] по "")
      иначе если пусто (определение.«имя»)
        то вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_RAZRYV" и сообщение равным (соединить ["строка ", запрос, " стоит до первой функции файла — оправдать её нечем"] по "")
        иначе если пусто требования
          то вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_RAZRYV" и сообщение равным (соединить [шапка, "\nРАЗРЫВ: у функции «", (определение.«имя»), "» нет ни одного постусловия — код без требования"] по "")
          иначе вариант «Конец работы» с значение равным (соединить (приписать шапка к («Цепочки» от набор и требования)) по "\n")

тип «Режим»
  вариант «Перепись»
  вариант «Подлог»
  вариант «От требования» содержит запрос: строка
  вариант «От строки» содержит запрос: строка

тотальная функция «Подлог ли»
  принимает режим: «Режим»
  возвращает признак
  пример «Подлог»
    дано режим равно вариант «Подлог»
    ожидается да
  пример «Перепись»
    дано режим равно вариант «Перепись»
    ожидается нет
  разбор режим
    случай вариант «Подлог»
      то да
    случай любое
      то нет

тотальная функция «С запросом»
  принимает режим: «Режим», запрос: строка
  возвращает «Режим»
  пример «Запрос вкладывается в режим требования»
    дано режим равно вариант «От требования» с запрос равным ""
    дано запрос равно "У1"
    ожидается вариант «От требования» с запрос равным "У1"
  разбор режим
    случай вариант «От требования» с запрос как прежний
      то вариант «От требования» с запрос равным запрос
    случай вариант «От строки» с запрос как прежний
      то вариант «От строки» с запрос равным запрос
    случай любое
      то режим

тотальная функция «Судить»
  принимает режим: «Режим», набор: «Набор»
  возвращает «Продолжение»
  разбор режим
    случай вариант «Перепись»
      то «Приговор переписи» от набор и нет
    случай вариант «Подлог»
      то «Приговор переписи» от набор и да
    случай вариант «От требования» с запрос как запрос
      то «Приговор требованию» от набор и запрос
    случай вариант «От строки» с запрос как запрос
      то «Приговор строке» от набор и запрос

тотальная функция «Спрятанное требование»
  возвращает строка
  пример «Первое умение ядра»
    ожидается "обеспечивает «У1 сумма читается в обратном порядке»"
  "обеспечивает «У1 сумма читается в обратном порядке»"

тотальная функция «Файл подлога»
  возвращает строка
  пример «Карта умений ядра»
    ожидается "flang/proof/map/abilities.flang"
  "flang/proof/map/abilities.flang"

тотальная функция «Спрятать»
  принимает текст: строка
  возвращает строка
  обеспечивает «спрятанного в тексте не остаётся» не (результат содержит («Спрятанное требование»))
  пример «Требование вырезается, тело остаётся»
    дано текст равно "  обеспечивает «У1 сумма читается в обратном порядке» результат равен (б плюс а)"
    ожидается "   результат равен (б плюс а)"
  соединить (разделить текст по («Спрятанное требование»)) по ""

тотальная функция «Файл долга»
  возвращает строка
  пример «Файл с двумя числами»
    ожидается "scripts/traceability-debt.tsv"
  "scripts/traceability-debt.tsv"

тотальная функция «Каталоги набора»
  возвращает список строки
  обеспечивает «записи перечисляются первыми, чтобы названные ими исходники успели в очередь» (элемент 1 в результат) равен "flang/proof/чекер/пробы/записи/корпус"
  пример «Четыре каталога»
    ожидается ["flang/proof/чекер/пробы/записи/корпус", "flang/proof/examples", "flang/test/fixtures", "flang/proof/map"]
  ["flang/proof/чекер/пробы/записи/корпус", "flang/proof/examples", "flang/test/fixtures", "flang/proof/map"]

тотальная функция «Файлы каталога»
  принимает каталог: строка, имена: список строки
  возвращает список строки
  обеспечивает «файлов не больше, чем имён» (длина результат) не больше (длина имена)
  пример «Берутся исходники и записи, подкаталоги и проза — нет»
    дано каталог равно "flang/test/fixtures"
    дано имена равно ["korpus", "README.md", "а.flang", "б.запись"]
    ожидается ["flang/test/fixtures/а.flang", "flang/test/fixtures/б.запись"]
  отобразить (отфильтровать имена где имя → («Кончается на» от имя и ".flang") или («Кончается на» от имя и ".запись")) как имя → (соединить [каталог, "/", имя] по "")

тотальная функция «Путь для чтения»
  принимает файл: строка
  возвращает строка
  обеспечивает «путь ведёт на уровень выше» результат начинается с "../"
  пример «Корень дерева — на уровень выше каталога scripts»
    дано файл равно "flang/proof/map/abilities.flang"
    ожидается "../flang/proof/map/abilities.flang"
  соединить ["../", файл] по ""

тип «Ход»
  вариант «Ждём довод» содержит режим: «Режим»
  вариант «Ждём каталог» содержит режим: «Режим», каталог: строка, каталоги: список строки, файлы: список строки
  вариант «Ждём файл» содержит режим: «Режим», файл: строка, очередь: список строки, набор: «Набор»

тотальная функция «К каталогам»
  принимает режим: «Режим»
  возвращает «Ход»
  обеспечивает «первым делом читается файл долга» результат равен (вариант «Ждём каталог» с режим равным режим и каталог равным (элемент 1 в («Каталоги набора»)) и каталоги равным ["flang/proof/examples", "flang/test/fixtures", "flang/proof/map"] и файлы равным [(«Файл долга»)])
  пример «Перепись начинается с каталога записей»
    дано режим равно вариант «Перепись»
    ожидается вариант «Ждём каталог» с режим равным (вариант «Перепись») и каталог равным "flang/proof/чекер/пробы/записи/корпус" и каталоги равным ["flang/proof/examples", "flang/test/fixtures", "flang/proof/map"] и файлы равным ["scripts/traceability-debt.tsv"]
  вариант «Ждём каталог» с режим равным режим и каталог равным (элемент 1 в («Каталоги набора»)) и каталоги равным ["flang/proof/examples", "flang/test/fixtures", "flang/proof/map"] и файлы равным [(«Файл долга»)]

тотальная функция «Начать»
  возвращает «Ход»
  пример «Перепись»
    ожидается вариант «Ждём каталог» с режим равным (вариант «Перепись») и каталог равным "flang/proof/чекер/пробы/записи/корпус" и каталоги равным ["flang/proof/examples", "flang/test/fixtures", "flang/proof/map"] и файлы равным ["scripts/traceability-debt.tsv"]
  «К каталогам» от (вариант «Перепись»)

тотальная функция «Начать подлог»
  возвращает «Ход»
  пример «Подлог»
    ожидается вариант «Ждём каталог» с режим равным (вариант «Подлог») и каталог равным "flang/proof/чекер/пробы/записи/корпус" и каталоги равным ["flang/proof/examples", "flang/test/fixtures", "flang/proof/map"] и файлы равным ["scripts/traceability-debt.tsv"]
  «К каталогам» от (вариант «Подлог»)

тотальная функция «Начать от требования»
  возвращает «Ход»
  пример «Сначала спрашивается довод»
    ожидается вариант «Ждём довод» с режим равным (вариант «От требования» с запрос равным "")
  вариант «Ждём довод» с режим равным (вариант «От требования» с запрос равным "")

тотальная функция «Начать от строки»
  возвращает «Ход»
  пример «Сначала спрашивается довод»
    ожидается вариант «Ждём довод» с режим равным (вариант «От строки» с запрос равным "")
  вариант «Ждём довод» с режим равным (вариант «От строки» с запрос равным "")

тотальная функция «Шаг чтения»
  принимает режим: «Режим», очередь: список строки, набор: «Набор»
  возвращает «Продолжение»
  обеспечивает «очередь пуста — пора судить» если пусто очередь то результат равен («Судить» от режим и набор) иначе да
  разбор очередь
    случай пусто
      то «Судить» от режим и набор
    случай голова и хвост
      то вариант «Сделать» с поручение равным (вариант «Прочитать файл» с путь равным («Путь для чтения» от голова)) и потом равным (вариант «Ждём файл» с режим равным режим и файл равным голова и очередь равным хвост и набор равным набор)

тотальная функция «После довода»
  принимает режим: «Режим», отклик: «Отклик»
  возвращает «Продолжение»
  пример «Первым делом спрашивается переменная среды FLANG_TRACE»
    дано режим равно вариант «От требования» с запрос равным ""
    дано отклик равно вариант «Пока ничего»
    ожидается вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "printenv" и аргументы равным ["FLANG_TRACE"]) и потом равным (вариант «Ждём довод» с режим равным (вариант «От требования» с запрос равным ""))
  разбор отклик
    случай вариант «Пока ничего»
      то вариант «Сделать» с поручение равным (вариант «Запустить процесс» с программа равным "printenv" и аргументы равным ["FLANG_TRACE"]) и потом равным (вариант «Ждём довод» с режим равным режим)
    случай вариант «Процесс завершён» с код как код и вывод как вывод и ошибки как ошибки
      то если пусто («Первая строка вывода» от вывод)
        то вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_ZAPROS" и сообщение равным "что искать, не сказано: задайте переменную среды FLANG_TRACE — имя требования либо путь:строка"
        иначе вариант «Сделать» с поручение равным (вариант «Перечислить каталог» с путь равным («Путь для чтения» от (элемент 1 в («Каталоги набора»)))) и потом равным («К каталогам» от («С запросом» от режим и («Первая строка вывода» от вывод)))
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным (соединить ["printenv не запустился: ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным "ждали ответ printenv"

тотальная функция «После каталога»
  принимает режим: «Режим», каталог: строка, каталоги: список строки, файлы: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Пока ничего»
      то вариант «Сделать» с поручение равным (вариант «Перечислить каталог» с путь равным («Путь для чтения» от каталог)) и потом равным (вариант «Ждём каталог» с режим равным режим и каталог равным каталог и каталоги равным каталоги и файлы равным файлы)
    случай вариант «Перечислено» с имена как имена
      то разбор каталоги
        случай пусто
          то «Шаг чтения» от режим и («Соединить списки» от файлы и («Файлы каталога» от каталог и имена)) и («Пустой набор»)
        случай голова и хвост
          то вариант «Сделать» с поручение равным (вариант «Перечислить каталог» с путь равным («Путь для чтения» от голова)) и потом равным (вариант «Ждём каталог» с режим равным режим и каталог равным голова и каталоги равным хвост и файлы равным («Соединить списки» от файлы и («Файлы каталога» от каталог и имена)))
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным код и сообщение равным (соединить ["каталог ", каталог, " не перечислить: ", сообщение] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным (соединить ["ждали список каталога ", каталог] по "")

тотальная функция «Очередь с исходником записи»
  принимает очередь: список строки, набор: «Набор», исходник: строка
  возвращает список строки
  обеспечивает «очередь растёт не больше чем на один» (длина результат) не больше ((длина очередь) плюс 1)
  пример «Исходник вне набора дописывается в очередь»
    дано очередь равно ["flang/proof/map/abilities.flang"]
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    дано исходник равно "flang/proof/чекер/пробы/семьи/носитель/chislo-segment.flang"
    ожидается ["flang/proof/map/abilities.flang", "flang/proof/чекер/пробы/семьи/носитель/chislo-segment.flang"]
  пример «Исходник из очереди второй раз не читается»
    дано очередь равно ["flang/proof/map/abilities.flang"]
    дано набор равно запись «Набор» с «исходники» равным (пустой список) и «записей» равным 0 и «функции» равным (пустой список) и «требования» равным (пустой список) и «примеры» равным (пустой список) и «свидетельства» равным (пустой список) и «долг требований» равным -1 и «долг кода» равным -1
    дано исходник равно "flang/proof/map/abilities.flang"
    ожидается ["flang/proof/map/abilities.flang"]
  если (пусто исходник) или ((очередь содержит исходник) или ((набор.«исходники») содержит исходник))
    то очередь
    иначе добавить исходник к очередь

тотальная функция «После записи»
  принимает режим: «Режим», файл: строка, очередь: список строки, набор: «Набор», текст: строка
  возвращает «Продолжение»
  пусть чтение равно («Разобрать запись» от файл и текст)
  «Шаг чтения» от режим и («Очередь с исходником записи» от очередь и набор и (чтение.«исходник»)) и («С записью» от набор и чтение)

тотальная функция «После файла»
  принимает режим: «Режим», файл: строка, очередь: список строки, набор: «Набор», отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Прочитано» с содержимое как текст
      то если «Кончается на» от файл и ".tsv"
        то «Шаг чтения» от режим и очередь и («С долгом» от набор и текст)
        иначе если «Кончается на» от файл и ".запись"
          то «После записи» от режим и файл и очередь и набор и текст
          иначе если («Подлог ли» от режим) и притом (файл равен («Файл подлога»))
            то если текст содержит («Спрятанное требование»)
              то «Шаг чтения» от режим и очередь и («С исходником» от набор и («Разобрать исходник» от файл и («Спрятать» от текст)))
              иначе вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_PODLOG" и сообщение равным (соединить ["ПОДЛОГ НЕ СОБРАЛСЯ: в ", файл, " нет строки «", («Спрятанное требование»), "» — поправить подлог, проверка ни при чём"] по "")
            иначе «Шаг чтения» от режим и очередь и («С исходником» от набор и («Разобрать исходник» от файл и текст))
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то вариант «Провал» с код равным "FLANG_PROSLEZHIVAEMOST_RAZRYV" и сообщение равным (соединить [файл, ": не прочитать (", сообщение, ") — либо файл долга, либо исходник, названный записью доказательства: цепочка порвана"] по "")
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным (соединить [файл, ": ждали текст файла"] по "")

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Ждём довод» с режим как режим
      то «После довода» от режим и отклик
    случай вариант «Ждём каталог» с режим как режим и каталог как каталог и каталоги как каталоги и файлы как файлы
      то «После каталога» от режим и каталог и каталоги и файлы и отклик
    случай вариант «Ждём файл» с режим как режим и файл как файл и очередь как очередь и набор как набор
      то «После файла» от режим и файл и очередь и набор и отклик

план «Разрывы»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»

план «Подлог»
  состояние «Ход»
  начинает с «Начать подлог»
  обрабатывает «Дальше»

план «От требования»
  состояние «Ход»
  начинает с «Начать от требования»
  обрабатывает «Дальше»

план «От строки»
  состояние «Ход»
  начинает с «Начать от строки»
  обрабатывает «Дальше»
