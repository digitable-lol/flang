{
  "ir": 1,
  "project": "discount",
  "modules": [
    {
      "name": "Продажи",
      "category": "Продажи",
      "source": "examples/utilities/discount.fts",
      "imports": [],
      "exports": null,
      "document": {
        "category": "Продажи",
        "structures": [
          {
            "name": "Покупка",
            "fields": [
              {
                "name": "сумма",
                "type": "Деньги"
              },
              {
                "name": "постоянный клиент",
                "type": "Признак"
              }
            ]
          }
        ],
        "functors": [],
        "proposition": null,
        "ts_compat": {},
        "utilities": [
          {
            "name": "Рассчитать скидку",
            "input": "Покупка",
            "output": "Деньги",
            "initial": 0,
            "rules": [
              {
                "name": "Большая покупка",
                "when": [
                  {
                    "field": "сумма",
                    "operator": "gte",
                    "value": {
                      "kind": "value",
                      "value": 10000
                    }
                  }
                ],
                "action": {
                  "kind": "add",
                  "value": {
                    "kind": "percent",
                    "percent": 10,
                    "field": "сумма"
                  }
                }
              },
              {
                "name": "Постоянный клиент",
                "when": [
                  {
                    "field": "постоянный клиент",
                    "operator": "eq",
                    "value": {
                      "kind": "value",
                      "value": true
                    }
                  }
                ],
                "action": {
                  "kind": "add",
                  "value": {
                    "kind": "percent",
                    "percent": 5,
                    "field": "сумма"
                  }
                }
              }
            ],
            "properties": [
              {
                "name": "Скидка неотрицательна",
                "operator": "gte",
                "value": {
                  "kind": "value",
                  "value": 0
                }
              },
              {
                "name": "Скидка ограничена",
                "operator": "lte",
                "value": {
                  "kind": "percent",
                  "percent": 20,
                  "field": "сумма"
                }
              }
            ],
            "examples": [
              {
                "name": "Обычная покупка",
                "input": {
                  "сумма": 5000,
                  "постоянный клиент": false
                },
                "expected": 0
              },
              {
                "name": "Большая покупка",
                "input": {
                  "сумма": 20000,
                  "постоянный клиент": false
                },
                "expected": 2000
              },
              {
                "name": "Большая покупка постоянного клиента",
                "input": {
                  "сумма": 20000,
                  "постоянный клиент": true
                },
                "expected": 3000
              }
            ]
          }
        ]
      }
    }
  ],
  "functors": [],
  "order": [
    "Продажи"
  ]
}
