{
  "ir": 1,
  "project": "shop",
  "modules": [
    {
      "name": "Продажи",
      "category": "Продажи",
      "source": "tools/ftsc/examples/shop/sales/purchase.fts",
      "imports": [],
      "exports": {
        "structures": [
          "Покупка"
        ],
        "utilities": [
          "Рассчитать скидку"
        ]
      },
      "document": {
        "category": "Продажи",
        "structures": [
          {
            "name": "Покупка",
            "fields": [
              {
                "name": "сумма",
                "type": "Деньги"
              },
              {
                "name": "постоянный клиент",
                "type": "Признак"
              }
            ]
          }
        ],
        "functors": [],
        "proposition": null,
        "ts_compat": {},
        "utilities": [
          {
            "name": "Рассчитать скидку",
            "input": "Покупка",
            "output": "Деньги",
            "initial": 0,
            "rules": [
              {
                "name": "Большая покупка",
                "when": [
                  {
                    "field": "сумма",
                    "operator": "gte",
                    "value": {
                      "kind": "value",
                      "value": 10000
                    }
                  }
                ],
                "action": {
                  "kind": "add",
                  "value": {
                    "kind": "percent",
                    "percent": 10,
                    "field": "сумма"
                  }
                }
              },
              {
                "name": "Постоянный клиент",
                "when": [
                  {
                    "field": "постоянный клиент",
                    "operator": "eq",
                    "value": {
                      "kind": "value",
                      "value": true
                    }
                  }
                ],
                "action": {
                  "kind": "add",
                  "value": {
                    "kind": "percent",
                    "percent": 5,
                    "field": "сумма"
                  }
                }
              }
            ],
            "properties": [
              {
                "name": "Скидка ограничена",
                "operator": "lte",
                "value": {
                  "kind": "percent",
                  "percent": 20,
                  "field": "сумма"
                }
              }
            ],
            "examples": [
              {
                "name": "Обычная покупка",
                "input": {
                  "сумма": 5000,
                  "постоянный клиент": false
                },
                "expected": 0
              },
              {
                "name": "Большая покупка постоянного клиента",
                "input": {
                  "сумма": 20000,
                  "постоянный клиент": true
                },
                "expected": 3000
              }
            ]
          }
        ]
      }
    },
    {
      "name": "Биллинг",
      "category": "Биллинг",
      "source": "tools/ftsc/examples/shop/billing/invoice.fts",
      "imports": [],
      "exports": {
        "structures": [
          "Счёт"
        ],
        "utilities": [
          "Рассчитать НДС"
        ]
      },
      "document": {
        "category": "Биллинг",
        "structures": [
          {
            "name": "Счёт",
            "fields": [
              {
                "name": "сумма без НДС",
                "type": "Деньги"
              },
              {
                "name": "лояльный",
                "type": "Признак"
              }
            ]
          }
        ],
        "functors": [],
        "proposition": null,
        "ts_compat": {},
        "utilities": [
          {
            "name": "Рассчитать НДС",
            "input": "Счёт",
            "output": "Деньги",
            "initial": 0,
            "rules": [
              {
                "name": "Основная ставка",
                "when": [
                  {
                    "field": "сумма без НДС",
                    "operator": "gt",
                    "value": {
                      "kind": "value",
                      "value": 0
                    }
                  }
                ],
                "action": {
                  "kind": "add",
                  "value": {
                    "kind": "percent",
                    "percent": 20,
                    "field": "сумма без НДС"
                  }
                }
              }
            ],
            "properties": [
              {
                "name": "НДС не превышает четверти суммы",
                "operator": "lte",
                "value": {
                  "kind": "percent",
                  "percent": 25,
                  "field": "сумма без НДС"
                }
              }
            ],
            "examples": [
              {
                "name": "Счёт на десять тысяч",
                "input": {
                  "сумма без НДС": 10000,
                  "лояльный": false
                },
                "expected": 2000
              },
              {
                "name": "Пустой счёт",
                "input": {
                  "сумма без НДС": 0,
                  "лояльный": true
                },
                "expected": 0
              }
            ]
          }
        ]
      }
    }
  ],
  "functors": [
    {
      "name": "Заказ в счёт",
      "from": "Продажи",
      "to": "Биллинг",
      "objects": [
        {
          "from": "Покупка",
          "to": "Счёт",
          "fields": [
            {
              "from": "сумма",
              "to": "сумма без НДС"
            },
            {
              "from": "постоянный клиент",
              "to": "лояльный"
            }
          ]
        }
      ],
      "morphisms": []
    }
  ],
  "order": [
    "Продажи",
    "Биллинг"
  ]
}
