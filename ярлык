#
# Ярлыки на команды репозитория. Точка входа — здесь, а не в npm.
#
# ── Зачем ────────────────────────────────────────────────────────────────────
# Ярлык — это имя, за которым стоит строка команды. Строки эти лежали в
# `package.json`, и звать их приходилось через `npm run`. npm не делал при этом
# ничего сверх подстановки строки, но человек, пришедший за языком, видел npm и
# решал, что языку нужен Node. Не нужен: компилятор один, написан на flang,
# собирается одним `make`, и `./ярлык spec:check` работает на машине, где Node
# не установлен вовсе.
#
# Список ярлыков лежит в `ярлыки.flang` — это программа на flang, а не файл
# настроек: имена и строки проверены типами, у каждой разборной функции есть
# примеры, а план «Целость» ходит по дереву и проверяет, что каждый ярлык
# указывает на существующий файл. Здесь, в оболочке, списка НЕТ ни одной
# строкой — она только спрашивает двоичный и запускает ответ.
#
# ── Почему оболочка, а не сам flang ─────────────────────────────────────────
# Замерено на этом дереве, не прикинуто:
#
#   1. У `flang io` нет способа принять довод: ни `--args`, ни хвоста строки.
#      Единственный отбор — `--plan «Имя»`. Ярлык с доводами
#      (`word:occupancy это`) на плане не выражается вовсе.
#   2. Хозяин планов КОПИТ вывод потомка и отдаёт его в конце строкой JSON:
#      прогон на 3 секунды и 3 строки не показал ни одной, пока не кончился.
#      Набор проверок идёт часами — человек смотрел бы в пустой терминал.
#   3. Экрана у двоичного хозяина нет вовсе: «Показать» отвечает
#      FLANG_IO_NO_SCREEN. План не может напечатать ни строки от себя.
#   4. Код возврата потомка до хозяина не доезжает: «Провал» — это всегда 1.
#
# Ярлыку нужно ровно обратное: доводы, живой вывод и настоящий код возврата.
# Поэтому запускает оболочка, а решает — flang.
#
# Цель в `bootstrap/Makefile` не годится по другой причине, и она проверена
# прогоном: `bootstrap/Makefile` НАПЕЧАТАН компилятором и сверяется байт в байт
# (`sh scripts/raskrutka.sh --check`). Дописанная руками цель валит сверку и
# исчезает при первой перепечатке.
#
# ── Курица и яйцо, названная прямо ───────────────────────────────────────────
# Первый ярлык не может быть на flang: чтобы прочитать `ярлыки.flang`, нужен
# двоичный, а его ещё нет. Развязано это ровно одним местом — строкой BUILD
# ниже. Она же стоит в `ярлыки.flang`, и совпадение проверяется при каждом
# запуске, как только двоичный появился.
#
# Двоичного нет — собираем и говорим об этом, ровно как это делает
# scripts/raskrutka.sh: иначе первый ярлык на свежем клоне отвечал бы отказом
# вместо работы, а `npm test` в работе выпуска — тем более (там `bootstrap/flang`
# не собирает никто).
#
# ИМЕНА ЗДЕСЬ ЛАТИНИЦЕЙ, как и в scripts/raskrutka.sh: ни dash, ни bash не
# принимают кириллицу в именах переменных.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

BINARY=bootstrap/flang
TABLE=ярлыки.flang
BUILD='make -C bootstrap'

err() { printf '%s\n' "$*" >&2; }

cores() { (getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4) | tr -d ' '; }

# Ответ `flang run` — значение в виде JSON, то есть строка в кавычках. Снимаем
# кавычки и разворачиваем escape-последовательности. Кавычка и обратная косая
# внутри команды сломали бы это молча, поэтому такая строка отвергается вслух.
unjson() {
  raw=$1
  case $raw in
    '"'*'"') ;;
    *) err "двоичный ответил не строкой: $raw"; exit 3 ;;
  esac
  body=${raw#\"}
  body=${body%\"}
  case $body in
    *\\\"*|*\\\\*) err "в строке ярлыка есть кавычка или обратная косая — так писать нельзя"; exit 3 ;;
  esac
  printf '%b' "$body"
}

ask() {
  what=$1
  shift
  "$BINARY" run "$TABLE" --function "$what" "$@"
}

# Двоичный есть или будет: без него список ярлыков нечем прочитать.
ensure_binary() {
  [ -x "$BINARY" ] && return 0
  err "двоичного $BINARY нет — собираю из точки раскрутки: $BUILD"
  $BUILD -j"$(cores)" >&2
  [ -x "$BINARY" ] || { err "сборка прошла, а $BINARY так и нет"; exit 3; }
}

listing() {
  ensure_binary
  printf '%s\n\n' "ярлыки этого дерева (список — в $TABLE):"
  unjson "$(ask '«Перечень»')"
  printf '\n\n%s\n' "звать: ./ярлык <имя> [доводы…]"
}

name=${1:-}
[ $# -gt 0 ] && shift

# ── Ярлык без списка: сборка двоичного ───────────────────────────────────────
# Единственный ярлык, который оболочка знает сама, — иначе его нечем прочитать.
if [ "$name" = "сборка" ]; then
  say_drift=""
  if [ -x "$BINARY" ]; then
    known=$(unjson "$(ask '«Команда ярлыка»' --args '{"ярлык":"сборка"}')")
    [ "$known" = "$BUILD" ] || say_drift="ярлык «сборка» в $TABLE — «$known», а оболочка знает «$BUILD»: они разошлись"
  fi
  [ -z "$say_drift" ] || { err "$say_drift"; exit 3; }
  exec $BUILD -j"$(cores)" "$@"
fi

if [ -z "$name" ]; then
  listing
  exit 0
fi

case $name in
  --help|-h|help) listing; exit 0 ;;
  *\"*|*\\*) err "в имени ярлыка не бывает кавычек и обратных косых: $name"; exit 2 ;;
esac

ensure_binary

command_line=$(unjson "$(ask '«Команда ярлыка»' --args "{\"ярлык\":\"$name\"}")")

if [ -z "$command_line" ]; then
  err "ярлыка «$name» нет. Вот какие есть:"
  err ""
  listing >&2
  exit 2
fi

exec sh -c "$command_line \"\$@\"" "ярлык:$name" "$@"
