   запись «Ярлык» с «имя» равным "журнал:страница" и «команда» равным "node scripts/build-changelog-page.mjs" и «зачем» равным "напечатать страницу вливаний сайта",
   запись «Ярлык» с «имя» равным "журнал:страница:проверка" и «команда» равным "node scripts/build-changelog-page.mjs --check" и «зачем» равным "страница вливаний сверена с историей",
   запись «Ярлык» с «имя» равным "выпуски:страница" и «команда» равным "bootstrap/flang io scripts/releases-page.flang --max-steps 40000000" и «зачем» равным "напечатать страницу выпусков",
   запись «Ярлык» с «имя» равным "выпуски:страница:проверка" и «команда» равным "bootstrap/flang io scripts/releases-page-verify.flang --max-steps 40000000" и «зачем» равным "страница выпусков сверена с тегами",
   запись «Ярлык» с «имя» равным "раскрутка" и «команда» равным "sh scripts/raskrutka.sh" и «зачем» равным "перепечатать bootstrap/ из нынешних исходников",
   запись «Ярлык» с «имя» равным "раскрутка:проверка" и «команда» равным "sh scripts/raskrutka.sh --check" и «зачем» равным "сверить закоммиченную точку раскрутки с печатью, байт в байт",
   запись «Ярлык» с «имя» равным "точка:проверка" и «команда» равным "bootstrap/flang io scripts/bootstrap-point-by-binary.flang --timeout 2400000" и «зачем» равным "точку раскрутки печатает сам двоичный, и печатает то, что лежит в дереве",
   запись «Ярлык» с «имя» равным "строки:проверка" и «команда» равным "sh scripts/raskrutka.sh --stroki" и «зачем» равным "быстрая проверка: все строковые литералы рантайма закрыты",
   запись «Ярлык» с «имя» равным "сторожа:проверка" и «команда» равным "bootstrap/flang io flang/scripts/guards-start.flang" и «зачем» равным "каждый файл проверок дерева ЗАВОДИТСЯ; не завёлся — назван поимённо и дословно",
   запись «Ярлык» с «имя» равным "перечни:перепись" и «команда» равным "sh scripts/hand-written-lists.sh" и «зачем» равным "сколько перечней в дереве набрано руками и сколько из них разошлось с деревом — оба числа своим прогоном",
   запись «Ярлык» с «имя» равным "перечни:проверка" и «команда» равным "sh scripts/hand-written-lists.sh --check" и «зачем» равным "новое расхождение перечня с деревом красит; запись ведомости, переставшая быть расхождением, красит тоже",
   запись «Ярлык» с «имя» равным "что-мешает:проверка" и «команда» равным "sh scripts/what-blocks-inventory-guard.sh" и «зачем» равным "столбец «в стволе» таблицы «Где что лежит» сверен с деревом, а не написан руками",
   запись «Ярлык» с «имя» равным "критерий:счёт" и «команда» равным "sh scripts/criterion-score-guard.sh" и «зачем» равным "счёт «ВЗЯТО N ИЗ M» в документе-критерии пересчитан по его же таблице; путь к документу — доводом",
   запись «Ярлык» с «имя» равным "тесты" и «команда» равным "node --test --test-timeout=1800000 flang/test/*.test.mjs" и «зачем» равным "весь набор проверок; то же, что npm test",
   запись «Ярлык» с «имя» равным "тесты:по-ssh" и «команда» равным "bash scripts/test-remote.sh" и «зачем» равным "тот же набор на машине по ssh: FLANG_REMOTE=<алиас>"]

тотальная функция «Команда ярлыка»
  принимает ярлык: строка
  возвращает строка
  пример «Известное имя отдаёт свою строку»
    дано ярлык равно "спеки:проверка"
    ожидается "bootstrap/flang io fspec/guard.flang"
  пример «Неизвестное имя — пусто»
    дано ярлык равно "npm run build"
    ожидается ""
  свёртка («Все ярлыки») начиная с "" как акк и я
    если (я.«имя») равен ярлык то (я.«команда») иначе акк

тотальная функция «Ярлыки о доказательствах»
  возвращает список строки
  обеспечивает «их двадцать» (длина результат) равен 20
  ["умения:проверка", "умения:улики", "подделки:проверка", "запись:проверка",
   "сведение:проверка", "спеки:проверка", "спеки:подлог",
   "доказательства:ведомость", "доказательства:свод", "доказательства:пустота",
   "доказательства:20", "пустота:проверка", "пустота:перепись", "пустота:порча",
   "доказанное:проверка", "доказанное:порча", "слово:проверка", "слово:подлог",
   "сколько-верим", "поиск:различающий"]

тотальная функция «Судит о доказательствах»
  принимает ярлык: строка
  возвращает признак
  обеспечивает «названный судьёй ярлык существует» (не результат) или (не ((«Команда ярлыка» от ярлык) равен ""))
  пример «Ведомость доказательств судит о доказательствах»
    дано ярлык равно "доказательства:ведомость"
    ожидается да
  пример «Сторож ссылок — нет»
    дано ярлык равно "ссылки:проверка"
    ожидается нет
  пример «Сама раскрутка — нет: иначе перепечатку нечем проверить»
    дано ярлык равно "раскрутка:проверка"
    ожидается нет
  свёртка («Ярлыки о доказательствах») начиная с нет как акк и имя
    акк или (имя равен ярлык)

тотальная функция «Отступ»
  принимает имя: строка
  возвращает строка
  обеспечивает «длинное имя получает один пробел» если (длина имя) не меньше 27 то (результат равен " ") иначе да
  пример «Короткое имя дополняется до столбца»
    дано имя равно "сайт"
    ожидается "                       "
  пример «Имя длиннее столбца получает один пробел, а не отрицательную длину»
    дано имя равно "выпуски:страница:проверка.и.ещё.немного"
    ожидается " "
  если (длина имя) не меньше 27
    то " "
    иначе подстрока "                           " с 1 по (27 минус (длина имя))

тотальная функция «Перечень»
  возвращает строка
  соединить (отобразить («Все ярлыки») как я → (соединить [я.«имя», («Отступ» от (я.«имя»)), я.«зачем»] по "")) по "\n"

тотальная функция «Сколько ярлыков»
  возвращает нат
  обеспечивает «сколько ярлыков сто тридцать восемь» результат равен 138
  длина («Все ярлыки»)

тотальная функция «Кончается на»
  принимает текст: строка, хвостик: строка
  возвращает признак
  обеспечивает «конец требует хотя бы двух кусков» (не результат) или ((длина (разделить текст по хвостик)) не меньше 2)
  обеспечивает «конец требует пустого последнего куска» (не результат) или ((элемент (длина (разделить текст по хвостик)) в (разделить текст по хвостик)) равен "")
  пример «Программа на JavaScript»
    дано текст равно "scripts/link-guard.mjs"
    дано хвостик равно ".mjs"
    ожидается да
  пример «Слово внутри есть, а конец не тот»
    дано текст равно "scripts/link-guard.mjs.bak"
    дано хвостик равно ".mjs"
    ожидается нет
  пусть куски равно (разделить текст по хвостик)
  ((длина куски) не меньше 2) и притом ((элемент (длина куски) в куски) равен "")

тотальная функция «Слово о файле»
  принимает слово: строка
  возвращает признак
  обеспечивает «файл узнан только по трём окончаниям» (не результат) или ((«Кончается на» от слово и ".mjs") или («Кончается на» от слово и ".sh") или («Кончается на» от слово и ".flang"))
  обеспечивает «всякое из трёх окончаний узнано» (не ((«Кончается на» от слово и ".mjs") или («Кончается на» от слово и ".sh") или («Кончается на» от слово и ".flang"))) или результат
  пример «Путь к программе на JavaScript»
    дано слово равно "docs/site/build.mjs"
    ожидается да
  пример «Образец со звёздочкой — тоже файл, и его проверяют»
    дано слово равно "flang/test/*.test.mjs"
    ожидается да
  пример «Ключ — не файл»
    дано слово равно "--check"
    ожидается нет
  («Кончается на» от слово и ".mjs") или («Кончается на» от слово и ".sh") или («Кончается на» от слово и ".flang")

тотальная функция «Файл ярлыка»
  принимает команда: строка
  возвращает строка
  пример «Из команды берётся путь, а не имя программы и не ключи»
    дано команда равно "node docs/site/build.mjs --check"
    ожидается "docs/site/build.mjs"
  пример «Двойная команда — берётся первый файл»
    дано команда равно "node scripts/build-changelog.mjs --check && node scripts/build-changelog.mjs --self-test"
    ожидается "scripts/build-changelog.mjs"
  пример «Команда без файлов дерева»
    дано команда равно "make -C bootstrap"
    ожидается ""
  разбор (отфильтровать (разделить команда по " ") где слово → («Слово о файле» от слово))
    случай пусто
      то ""
    случай голова и хвост
      то голова

тотальная функция «Ярлыки с файлом»
  возвращает список «Ярлык»
  отфильтровать («Все ярлыки») где я → не ((«Файл ярлыка» от (я.«команда»)) равен "")

тотальная функция «Каталог пути»
  принимает путь: строка
  возвращает строка
  обеспечивает «путь без косой лежит в корне» если (длина (разделить путь по "/")) равен 1 то (результат равен ".") иначе да
  пример «Путь в двух каталогах»
    дано путь равно "flang/scripts/name-guard.mjs"
    ожидается "flang/scripts"
  пример «Файл корня»
    дано путь равно "ярлыки.flang"
    ожидается "."
  пусть куски равно (разделить путь по "/")
  если (длина куски) равен 1
    то "."
    иначе подстрока путь с 1 по ((длина путь) минус (длина (элемент (длина куски) в куски)) минус 1)

тотальная функция «Имя в пути»
  принимает путь: строка
  возвращает строка
  пример «Имя берётся после последней косой»
    дано путь равно "docs/site/build.mjs"
    ожидается "build.mjs"
  пример «Файл корня — сам себе имя»
    дано путь равно "ярлыки.flang"
    ожидается "ярлыки.flang"
  пусть куски равно (разделить путь по "/")
  элемент (длина куски) в куски

тотальная функция «Каталоги ярлыков»
  возвращает список строки
  свёртка («Ярлыки с файлом») начиная с (пустой список) как акк и я
    пусть каталог равно («Каталог пути» от («Файл ярлыка» от (я.«команда»)))
    если акк содержит каталог то акк иначе (добавить каталог к акк)

тотальная функция «Ярлыки каталога»
  принимает каталог: строка
  возвращает список «Ярлык»
  отфильтровать («Ярлыки с файлом») где я → ((«Каталог пути» от («Файл ярлыка» от (я.«команда»))) равен каталог)

тотальная функция «Имя файла ярлыка»
  принимает я: «Ярлык»
  возвращает строка
  пример «У ярлыка с образцом имя — сам образец»
    дано я равно запись «Ярлык» с «имя» равным "тесты" и «команда» равным "node --test flang/test/*.test.mjs" и «зачем» равным "весь набор"
    ожидается "*.test.mjs"
  «Имя в пути» от («Файл ярлыка» от (я.«команда»))

тотальная функция «Образец»
  принимает имя: строка
  возвращает признак
  обеспечивает «образец только со звёздочкой» (не результат) или (имя содержит "*")
  обеспечивает «звёздочка делает имя образцом» (не (имя содержит "*")) или результат
  пример «Звёздочка есть — образец»
    дано имя равно "*.test.mjs"
    ожидается да
  пример «Звёздочки нет — обычное имя»
    дано имя равно "build.mjs"
    ожидается нет
  имя содержит "*"

тотальная функция «Образец посилен»
  принимает имя: строка
  возвращает признак
  обеспечивает «посильный образец делится надвое» (не результат) или ((длина (разделить имя по "*")) равен 2)
  обеспечивает «посильный образец начинается звёздочкой» (не результат) или ((подстрока имя с 1 по 1) равен "*")
  пример «Звёздочка одна и первая»
    дано имя равно "*.test.mjs"
    ожидается да
  пример «Звёздочка не первая — такой вид не разбирается»
    дано имя равно "emit-*.test.mjs"
    ожидается нет
  пример «Две звёздочки — такой вид не разбирается»
    дано имя равно "*-*.mjs"
    ожидается нет
  ((длина (разделить имя по "*")) равен 2) и притом ((подстрока имя с 1 по 1) равен "*")

тотальная функция «Хвост образца»
  принимает имя: строка
  возвращает строка
  пример «После звёздочки — хвост»
    дано имя равно "*.test.mjs"
    ожидается ".test.mjs"
  пусть куски равно (разделить имя по "*")
  элемент (длина куски) в куски

тотальная функция «Есть подходящее»
  принимает имена: список строки, хвост: строка
  возвращает признак
  пример «Одно имя подходит»
    дано имена равно ["glob.mjs", "changelog.test.mjs"]
    дано хвост равно ".test.mjs"
    ожидается да
  пример «Ни одно не подходит»
    дано имена равно ["glob.mjs", "fixtures"]
    дано хвост равно ".test.mjs"
    ожидается нет
  свёртка имена начиная с нет как акк и имя
    акк или («Кончается на» от имя и хвост)

тотальная функция «Про пропажу»
  принимает я: «Ярлык»
  возвращает строка
  пример «Беда называет и ярлык, и файл»
    дано я равно запись «Ярлык» с «имя» равным "сайт" и «команда» равным "node docs/site/build.mjs" и «зачем» равным "собрать сайт"
    ожидается "сайт: команда называет docs/site/build.mjs, а такого файла в дереве нет"
  соединить [я.«имя», ": команда называет ", («Файл ярлыка» от (я.«команда»)), ", а такого файла в дереве нет"] по ""

тотальная функция «Про пустой образец»
  принимает я: «Ярлык»
  возвращает строка
  пример «Беда называет и ярлык, и образец, и чем это кончится»
    дано я равно запись «Ярлык» с «имя» равным "тесты" и «команда» равным "node --test flang/test/*.test.mjs" и «зачем» равным "весь набор"
    ожидается "тесты: команда называет образец flang/test/*.test.mjs, а под него в дереве не подходит ни один файл — прогон ответит «tests 0» и кодом 0"
  соединить [я.«имя», ": команда называет образец ", («Файл ярлыка» от (я.«команда»)), ", а под него в дереве не подходит ни один файл — прогон ответит «tests 0» и кодом 0"] по ""

тотальная функция «Про непонятный образец»
  принимает я: «Ярлык»
  возвращает строка
  пример «Беда называет вид образца, который не разбирается»
    дано я равно запись «Ярлык» с «имя» равным "тесты" и «команда» равным "node --test flang/test/emit-*.test.mjs" и «зачем» равным "весь набор"
    ожидается "тесты: образец flang/test/emit-*.test.mjs такого вида здесь не разбирается — звёздочка обязана быть одна и первой в имени; назовите файлы прямо"
  соединить [я.«имя», ": образец ", («Файл ярлыка» от (я.«команда»)), " такого вида здесь не разбирается — звёздочка обязана быть одна и первой в имени; назовите файлы прямо"] по ""

тотальная функция «Беда посильного образца»
  принимает я: «Ярлык», имена: список строки
  возвращает строка
  если («Есть подходящее» от имена и («Хвост образца» от («Имя файла ярлыка» от я)))
    то ""
    иначе («Про пустой образец» от я)

тотальная функция «Беда образца»
  принимает я: «Ярлык», имена: список строки
  возвращает строка
  обеспечивает «посильный образец судится отдельно» если («Образец посилен» от («Имя файла ярлыка» от я)) то (результат равен («Беда посильного образца» от я и имена)) иначе да
  если («Образец посилен» от («Имя файла ярлыка» от я))
    то («Беда посильного образца» от я и имена)
    иначе («Про непонятный образец» от я)

тотальная функция «Беда имени»
  принимает я: «Ярлык», имена: список строки
  возвращает строка
  если (имена содержит («Имя файла ярлыка» от я))
    то ""
    иначе («Про пропажу» от я)

тотальная функция «Беда ярлыка»
  принимает я: «Ярлык», имена: список строки
  возвращает строка
  обеспечивает «образец судится как образец» если («Образец» от («Имя файла ярлыка» от я)) то (результат равен («Беда образца» от я и имена)) иначе да
  если («Образец» от («Имя файла ярлыка» от я))
    то («Беда образца» от я и имена)
    иначе («Беда имени» от я и имена)

тотальная функция «Пропажи каталога»
  принимает каталог: строка, имена: список строки
  возвращает список строки
  отфильтровать (отобразить («Ярлыки каталога» от каталог) как я → («Беда ярлыка» от я и имена)) где беда → не (беда равен "")

тотальная функция «Сложить»
  принимает первые: список строки, вторые: список строки
  возвращает список строки
  пример «Два списка в один»
    дано первые равно ["раз"]
    дано вторые равно ["два", "три"]
    ожидается ["раз", "два", "три"]
  свёртка вторые начиная с первые как акк и хвостовое
    добавить хвостовое к акк

тип «Ход»
  вариант «Начали»
  вариант «Ждём список» содержит каталог: строка, осталось: список строки, беды: список строки

тотальная функция «Начать»
  возвращает «Ход»
  обеспечивает «план начинается с начала» результат равен (вариант «Начали»)
  пример «План начинается с начала»
    ожидается вариант «Начали»
  вариант «Начали»

тотальная функция «Сколько с именем»
  возвращает нат
  длина (отфильтровать («Ярлыки с файлом») где я → не («Образец» от («Имя файла ярлыка» от я)))

тотальная функция «Сколько с образцом»
  возвращает нат
  длина (отфильтровать («Ярлыки с файлом») где я → («Образец» от («Имя файла ярлыка» от я)))

тотальная функция «Сколько без файла»
  возвращает нат
  длина (отфильтровать («Все ярлыки») где я → ((«Файл ярлыка» от (я.«команда»)) равен ""))

тотальная функция «Судить»
  принимает беды: список строки, всего: нат, именем: нат, образцом: нат, безфайла: нат
  возвращает «Продолжение»
  пример «Бед нет — план кончается числами того, что посмотрел»
    дано беды равно пустой список
    дано всего равно 5
    дано именем равно 3
    дано образцом равно 1
    дано безфайла равно 1
    ожидается вариант «Конец работы» с значение равным "ярлыков 5; посмотрено 4: по имени файла 3, по образцу 1 — всё нашлось в дереве; команд без файла дерева 1 — у них смотреть нечего"
  разбор беды
    случай пусто
      то вариант «Конец работы» с значение равным (соединить ["ярлыков ", (к строке всего), "; посмотрено ", (к строке (именем плюс образцом)), ": по имени файла ", (к строке именем), ", по образцу ", (к строке образцом), " — всё нашлось в дереве; команд без файла дерева ", (к строке безфайла), " — у них смотреть нечего"] по "")
    случай голова и хвост
      то вариант «Провал» с код равным "ЯРЛЫК_БЕЗ_ФАЙЛА" и сообщение равным (соединить (приписать (соединить ["ярлыков без файла: ", (к строке (длина беды)), " (посмотрено ", (к строке (именем плюс образцом)), ": по имени ", (к строке именем), ", по образцу ", (к строке образцом), ")"] по "") к беды) по "\n")

тотальная функция «Пойти по каталогам»
  принимает очередь: список строки, беды: список строки
  возвращает «Продолжение»
  разбор очередь
    случай пусто
      то «Судить» от беды и («Сколько ярлыков») и («Сколько с именем») и («Сколько с образцом») и («Сколько без файла»)
    случай голова и хвост
      то вариант «Сделать» с поручение равным (вариант «Перечислить каталог» с путь равным голова) и потом равным (вариант «Ждём список» с каталог равным голова и осталось равным хвост и беды равным беды)

тотальная функция «После списка»
  принимает каталог: строка, осталось: список строки, беды: список строки, отклик: «Отклик»
  возвращает «Продолжение»
  разбор отклик
    случай вариант «Перечислено» с имена как имена
      то «Пойти по каталогам» от осталось и («Сложить» от беды и («Пропажи каталога» от каталог и имена))
    случай вариант «Сбой» с код как код и сообщение как сообщение
      то «Пойти по каталогам» от осталось и («Сложить» от беды и [соединить ["каталог ", каталог, " не перечислить — ", сообщение] по ""])
    случай любое
      то вариант «Провал» с код равным "FLANG_IO_ORDER" и сообщение равным (соединить ["ждали список каталога ", каталог] по "")

тотальная функция «Дальше»
  принимает ход: «Ход», отклик: «Отклик»
  возвращает «Продолжение»
  разбор ход
    случай вариант «Начали»
      то «Пойти по каталогам» от («Каталоги ярлыков») и (пустой список)
    случай вариант «Ждём список» с каталог как каталог и осталось как осталось и беды как беды
      то «После списка» от каталог и осталось и беды и отклик

план «Целость»
  состояние «Ход»
  начинает с «Начать»
  обрабатывает «Дальше»
