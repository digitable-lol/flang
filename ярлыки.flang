    дано я равно запись «Ярлык» с «имя» равным "сайт" и «команда» равным "node docs/site/build.mjs" и «зачем» равным "собрать сайт"
    ожидается "сайт: команда называет docs/site/build.mjs, а такого файла в дереве нет"
  соединить [я.«имя», ": команда называет ", («Файл ярлыка» от (я.«команда»)), ", а такого файла в дереве нет"] по ""

тотальная функция «Про пустой образец»
  принимает я: «Ярлык»
  возвращает строка
  пример «Беда называет и ярлык, и образец, и чем это кончится»
    дано я равно запись «Ярлык» с «имя» равным "тесты" и «команда» равным "node --test flang/test/*.test.mjs" и «зачем» равным "весь набор"
    ожидается "тесты: команда называет образец flang/test/*.test.mjs, а под него в дереве не подходит ни один файл — прогон ответит «tests 0» и кодом 0"
  соединить [я.«имя», ": команда называет образец ",
             («Файл ярлыка» от (я.«команда»)),
             ", а под него в дереве не подходит ни один файл — ",
             "прогон ответит «tests 0» и кодом 0"] по ""

тотальная функция «Про непонятный образец»
  принимает я: «Ярлык»
  возвращает строка
  пример «Беда называет вид образца, который не разбирается»
    дано я равно запись «Ярлык» с «имя» равным "тесты" и «команда» равным "node --test flang/test/emit-*.test.mjs" и «зачем» равным "весь набор"
    ожидается "тесты: образец flang/test/emit-*.test.mjs такого вида здесь не разбирается — звёздочка обязана быть одна и первой в имени; назовите файлы прямо"
  соединить [я.«имя», ": образец ", («Файл ярлыка» от (я.«команда»)),
             " такого вида здесь не разбирается — звёздочка обязана быть ",
             "одна и первой в имени; назовите файлы прямо"] по ""

тотальная функция «Беда посильного образца»
